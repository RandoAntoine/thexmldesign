<par def="21"><run><font size="9pt" color="red"/><field type="number" kind="computedfordisplay" name="Prop_CommRepresentantAvBoni_7"><numberformat format="fixed" digits="2" punctuated="true" parens="false" percent="false" bytes="false"/><code event="defaultvalue"><formula>Prop_CommRepresentantEQ_7 + Prop_CommRepresentantLG_7 + Prop_CommRepresentantSV_7</formula></code></field></run></par>
<pardef id="43" align="right" rightmargin="0.7875in" keepwithnext="true" keeptogether="true"><code event="hidewhen"><formula>Prop_TypeProposition &gt; "1" |
PNav_MenuOptionCourante = "8.01"</formula></code></pardef>
<par def="43"><run><font size="9pt"/></run><run><font size="9pt"/><field type="number" kind="computedfordisplay" name="Prop_PaiementNetMensuel_7"><numberformat format="fixed" digits="2" punctuated="true" parens="false" percent="false" bytes="false"/><code event="defaultvalue"><formula>@If(Comm_CalculBoniRep_1 = "3"; @If(@IsNull(Prop_ContratDureeMois_1); 0; @TextToNumber(Prop_ContratDureeMois_1)); Prop_PaiementNetMensuel_2)</formula></code></field></run><run><font size="9pt"/></run></par></tablecell>
<tablecell valign="center" borderwidth="0px" bgcolor="white">
<pardef id="44" align="right" rightmargin="0.7875in" keepwithnext="true" keeptogether="true"><code event="hidewhen"><formula>Prop_TypeProposition &gt; "1" |
PNav_MenuOptionCourante = "8.01"</formula></code></pardef>
<par def="44"><run><font size="9pt"/></run><run><font size="9pt"/><field type="number" kind="computedfordisplay" name="Prop_Boni_7"><numberformat format="fixed" digits="2" punctuated="true" parens="false" percent="false" bytes="false"/><code event="defaultvalue"><formula>REM {Prop_ClientPays = "US" | };
@If(Prop_DealerTrack = "1" | @IsNotMember(Prop_TypeProposition; "0" : "1") | Comm_CalculBoniRep_1 = "0"; @Return(0); "");

v_Contributions := @IfError(@DbLookup(""; SF_ServeurSDSBB : SF_FichierSDSBB; "V_Comm20"; Prop_CommissionsRepresentant; 9); 0);
@If(@Elements(v_Contributions) = 0; @Return(0); "");
v_Montants := @IfError(@DbLookup(""; SF_ServeurSDSBB : SF_FichierSDSBB; "V_Comm20"; Prop_CommissionsRepresentant; @If(Comm_CalculBoniRep_1 = "3"; 19; 10)); 0);
@If(@Elements(v_Montants) = 0; @Return(0); "");

REM {Montant supérieur à la dernière borne, retourner le dernier montant};
@If(Prop_PaiementNetMensuel_7 &gt; @Subset(v_Contributions; -1); @Return(@Subset(v_Montants; -1)); "");

REM {Boucle sur le tableau des contributions};
v_Indice := 1;
@While(v_Indice &lt; @Elements(v_Contributions) &amp; Prop_PaiementNetMensuel_7 &gt; @Subset(@Subset(v_Contributions; v_Indice); -1); v_Indice := v_Indice + 1);

REM {Extrait la valeur appropriée};
v_Boni := @If(v_Indice &gt; @Elements(v_Montants); @Subset(v_Montants; -1); @Subset(@Subset(v_Montants; v_Indice); -1));
@If(Comm_CalculBoniRep_1 = "3"; @Round(Prop_CommRepresentantAvBoni_7 * v_Boni; 0.01); v_Boni)</formula></code></field></run><run><font size="9pt"/></run></par></tablecell>
