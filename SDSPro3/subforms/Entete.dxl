<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="declarations"><lotusscript>Dim g_Isnewdoc As Integer

</lotusscript></code><code event="postopen"><lotusscript>Sub Postopen(Source As Notesuidocument)
	g_Isnewdoc = Source.Isnewdoc
End Sub
</lotusscript></code><code event="postsave"><lotusscript>Sub Postsave(Source As Notesuidocument)
	' Rafraichir le titre lorsqu'un document est sauvegardé pour la première fois.
	If g_Isnewdoc Then
		Call Source.Refresh
		g_Isnewdoc = False
	End If
End Sub</lotusscript></code>
