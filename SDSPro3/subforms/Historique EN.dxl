<globals><code event="options"><lotusscript>Option Public
Option Explicit

</lotusscript></code></globals><code event="postsave"><formula>@Command([RefreshHideFormulas])</formula></code><code event="declarations"><lotusscript>Dim gnsSFH As Notessession
</lotusscript></code><code event="querysave"><lotusscript>Sub Querysave(Source As Notesuidocument, Continue As Variant)
	If gnsSFH Is Nothing Then
		Set gnsSFH = New Notessession
	End If
	
	' Mise à jour de l'historique
	If Source.Isnewdoc Then
		Source.Document.HistoDC = Now
		Source.Document.HistoUC = gnsSFH.UserName
		Source.Document.HistoDM = ""
		Source.Document.HistoUM = ""
	Else
		If Source.Document.HistoDC(0) = "" Then
			Source.Document.HistoDC = Source.Document.Created
		End If
		Source.Document.HistoDM = Now
		Source.Document.HistoUM = gnsSFH.UserName
	End If
End Sub</lotusscript></code>
<body><richtext>
