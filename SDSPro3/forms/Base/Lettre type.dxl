v_Cle := SILT_Nom;
v_NomVue := "V_SILT1";

@If(v_Cle = NULL; @Return(@Failure("Le nom est obligatoire.")); "");
v_Lookup := @DbLookup("" : "NoCache"; ""; v_NomVue; v_Cle; 1; [ReturnDocumentUniqueID]);
@If(@IsError(v_Lookup); @Success; @Elements(v_Lookup) = 1 &amp; v_Lookup = @Text(@DocumentUniqueID); @Success; @Failure("La lettre type est déjà définie."))</formula></code></field></run><run><font size="8pt"/></run></par></tablecell></tablerow>
