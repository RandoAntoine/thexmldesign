</lotusscript></code><code event="click"><lotusscript>Sub Click(Source As Button)
	Dim nuiws As New NotesUIWorkspace
	Dim nd As NotesDocument
	Dim nd_Nothing As NotesDocument
	
	Set nd_Nothing = Nothing
	Set nd = nuiws.CurrentDocument.Document
	
	Call SICT_EnvoyerCourriel(nd_Nothing, xVar(nd, "SICT_Nom", ""), "FR", "", "", "", "", False, "")
End Sub</lotusscript></code><code event="hidewhen"><formula>@IsNotMember("[Serti]"; @UserRoles)</formula></code></action></actionbar>
