v_Lookup := @DbLookup("" : "NoCache"; ""; v_NomVue; v_Cle; v_NoColonneUNID);
@If(@IsError(v_Lookup); @Success; @Elements(v_Lookup) = 1 &amp; v_Lookup = @Text(@DocumentUniqueID); @Success; @Failure("La table est déjà définie."))</formula></code></field></run><run><font size="9pt"/></run></par></tablecell></tablerow>
