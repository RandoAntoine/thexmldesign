<tablecell borderwidth="0px" bgcolor="system">
<par def="6"><run><font size="9pt"/><field usenotesstyle="false" height="0.2347in" width="80%" borderstyle="single" type="text" kind="editable" name="DB_Nom"><code event="inputtranslation"><formula>@LowerCase(@Trim(@ThisValue))</formula></code><code event="inputvalidation"><formula>@If(@IsNull(@ThisValue); @Failure("Le nom est invalide.");
@If(@IsNull(@LeftBack(@ThisValue; " ")); @Failure("Le nom est invalide. Le nom doit avoir au minimum deux mots séparés par un espace."); @Success))</formula></code></field></run><run><font size="9pt"/></run></par></tablecell></tablerow>
