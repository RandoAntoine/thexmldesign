@If(@IsNull(@ThisValue);@Failure("Le courriel est obligatoire.");@If(AddrValide != "" &amp; @ThisValue != ""; @Failure("Le courriel est invalide."); @Success))</formula></code></field></run></par></tablecell></tablerow>
