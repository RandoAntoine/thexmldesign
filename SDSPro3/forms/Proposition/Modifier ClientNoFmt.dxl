End Sub</lotusscript></code></actionhotspot><run><font size="9pt"/> </run><actionhotspot hotspotstyle="none"><code event="click"><formula>@Command([ViewRefreshFields])</formula></code><picture width="20px" height="20px" align="top"><imageref name="hs_Rafraîchir.gif|hs_Rafraichir"/></picture><run><font size="9pt"/></run></actionhotspot><run><font size="9pt"/></run></par>
