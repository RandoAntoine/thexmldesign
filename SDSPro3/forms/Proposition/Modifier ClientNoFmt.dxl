<par def="12"><run><font size="9pt"/><field usenotesstyle="false" height="0.2340in" width="0.4722in" multiline="true" borderstyle="single" type="number" kind="editable" name="DB_ClientNo1"><numberformat format="fixed" punctuated="false" parens="false" percent="false" bytes="false"/><code event="inputvalidation"><formula>@If( !@IsNull(@ThisValue) &amp; @ThisValue &lt; 0; @Failure("La première partie du numéro de client est invalide."); @Success)</formula></code><code event="entering"><lotusscript>Sub Entering(Source As Field)
	
	Dim nuiws As New NotesUIWorkspace
	Dim nuid As NotesUIDocument
	
	Set nuid = nuiws.CurrentDocument
	Call nuid.SelectAll
	
End Sub</lotusscript></code></field></run><run><font size="9pt"/> </run><run><font size="9pt"/><field usenotesstyle="false" height="0.2340in" width="0.2757in" borderstyle="single" type="text" kind="editable" name="DB_ClientNo2"><code event="inputtranslation"><formula>@If(DB_ClientNo1= ""; ""; @Length(DB_ClientNo2) != 3; @Right("000" + DB_ClientNo2; 3); DB_ClientNo2)</formula></code><code event="inputvalidation"><formula>REM {***** Validations de base};
@If(DB_ClientNo1 = ""; @Return(@Success); !@Matches(DB_ClientNo2; "{0123456789}{0123456789}{0123456789}"); @Return(@Failure("La deuxième partie du numéro de client est invalide.")); "");

v_VueSICl := "V_Clie20";
v_CleSICl := @Text(DB_ClientNo1) + "-" + DB_ClientNo2;

REM {***** Vérifier l'existence du document};
@If(@IsError(@DbLookup("" : "NoCache"; SF_ServeurSICl : SF_FichierSICl; v_VueSICl; v_CleSICl; 1)); @Return(@Failure("Le client est inexistant.")); @Success)</formula></code><code event="entering"><lotusscript>Sub Entering(Source As Field)
	
	Dim nuiws As New NotesUIWorkspace
	Dim nuid As NotesUIDocument
	
	Set nuid = nuiws.CurrentDocument
	Call nuid.SelectAll
	
End Sub</lotusscript></code></field></run><run><font size="9pt"/>  </run><actionhotspot hotspotstyle="none"><run><font size="9pt"/></run><picture width="20px" height="20px" scaledheight="0.2083in" scaledwidth="0.2083in" align="top"><imageref name="hs_Loupe"/></picture><run><font size="9pt"/></run><code event="click"><lotusscript>Sub Click(Source As Button)
