<par def="11"><run><font size="9pt" color="red"/></run><button width="0.7875in" widthtype="fixed" wraptext="true" bgcolor="system" type="ok"><font size="9pt"/>Yes<code event="click"><lotusscript>Sub Click(Source As Button)
	Dim nuiws As New NotesUIWorkspace
	
	nuiws.CurrentDocument.Document.DB_RecalcTous = "1"
	Call nuiws.RefreshParentNote
	If DBRCou_Queryclose(nuiws.CurrentDocument) Then
		Call nuiws.CurrentDocument.Close
	End If
End Sub</lotusscript></code></button><run><font size="9pt"/></run></par></tablecell>
