<par def="12"><run><font size="9pt"/></run><run><font size="9pt"/><field usenotesstyle="false" height="0.2340in" width="2.8743in" borderstyle="single" type="text" kind="editable" name="Docu_Lien"><code event="inputvalidation"><formula>@If(@IsNull(@ThisValue); @Failure("The file path is mandatory."); @Success)</formula></code></field></run><run><font size="9pt"/> </run><actionhotspot hotspotstyle="none"><run><font size="9pt"/></run><picture width="20px" height="20px"><imageref><code event="value"><formula>@If(Docu_Format = "2"; ""; "hs_Loupe")</formula></code></imageref></picture><run><font size="9pt"/></run><code event="click"><lotusscript>Sub Click(Source As Button)
	Dim nuiws As New NotesUIWorkspace
	Dim a_Fichiers As Variant
	Dim v_Fichier As String
	Dim v As Variant
	Dim v_NomFichier As String
	
	v = Evaluate({@RegQueryValue("HKEY_CURRENT_USER"; "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Shell Folders"; "Desktop")})
	
	v_NomFichier = v(0)
	
	a_Fichiers = nuiws.OpenFileDialog(False, "Select a document", "", v_NomFichier)
	If Not Isempty(a_Fichiers) Then
		Call nuiws.CurrentDocument.FieldSetText("Docu_Lien", a_Fichiers(0))
	End If
End Sub</lotusscript></code></actionhotspot><run><font size="9pt"/></run></par></tablecell>
