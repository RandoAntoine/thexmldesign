<globals><code event="options"><lotusscript>Option Public
Use "SI_NUIV"
</lotusscript></code></globals><code event="postopen"><lotusscript>Sub Postopen(Source As Notesuidocument)
	
	Call SINUIV_Initialisations
	Call gnuiws_SINUIV.OpenFrameSet("FS_Prin")	
	
	' Fermer le document
	Call Source.Close
	
End Sub
</lotusscript></code><code event="queryclose"><lotusscript>Sub Queryclose(Source As Notesuidocument, Continue As Variant)
	
	' Sélectionner la propositon et l'ouvrir à partir du UI	
	Call SINUIV_OuvrirDocument("FS_Prin", Source, "V_Prop01", True)
	
End Sub
</lotusscript></code><code event="queryopen"><lotusscript>Sub Queryopen(Source As Notesuidocument, Mode As Integer, Isnewdoc As Variant, Continue As Variant)
	
