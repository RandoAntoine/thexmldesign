<par def="491"><run><font size="9pt"/><field type="number" kind="computedfordisplay" name="Prop_Mensualite_1"><numberformat format="fixed" digits="2" punctuated="true" parens="false" percent="false" bytes="false"/><code event="defaultvalue"><formula>v_Bornes := @GetProfileField("F_Prof"; "Prof_BorneTaux");
@If(@Elements(v_Bornes) = 0; @Return(0); "");

v_Taux := @GetProfileField("F_Prof"; "Prof_ListeTaux");
v_Facteur := @If(Prop_MontantFinancer_1 &lt;= v_Bornes[1]; v_Taux[1]; 0);

@For(n := 1; n &lt;= @Elements(v_Bornes) &amp; v_Facteur = 0; n := n + 1;
v_Facteur := @If(Prop_MontantFinancer_1 &lt;= v_Bornes[n]; v_Taux[n]; 0));

@Round(Prop_MontantFinancer_1 * @If(n = 0; 0; n &gt; @Elements(v_Bornes); v_Taux[@Elements(v_Bornes)]; v_Facteur) / 1000; 0.01)</formula></code></field></run><run><font size="9pt"/></run></par></tablecell>
