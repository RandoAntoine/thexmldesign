<action title="Accepter" showinmenu="false" hide="preview read previewedit"><imageref name="act_PouceHaut"/><code event="click"><lotusscript>Sub Click(Source As Button)
	
	Select Case xVar(gnd_SDSPM, "Prop_Statut", "")
		
	Case "20"		
		Call FPNav_acWorkflow("30")			
		
	Case  "30" 		
		Call FPNav_acWorkflow("40")
		
	Case  "40" 
		Call FPNav_acWorkflow("50")			
		
	Case Else
		Exit Sub		
		
	End Select
	
End Sub</lotusscript></code><code event="hidewhen"><formula>Prop_Statut &lt; "20" | Prop_Statut &gt;= "50" |
(Prop_Statut &lt;= "30" &amp; (@IsNotMember("[Directeur]"; @UserRoles) &amp; @IsNotMember("[Verificateur]"; @UserRoles) ) ) |
(Prop_Statut &gt;= "40" &amp; (@IsNotMember("[Technique]"; @UserRoles) ) ) |
!PNav_EditMode</formula></code></action>
