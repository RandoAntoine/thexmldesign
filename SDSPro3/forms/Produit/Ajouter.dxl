<par def="11"><run><font size="9pt"/><field usenotesstyle="false" height="0.2340in" width="1.5750in" multiline="true" borderstyle="single" lookupeachchar="false" lookupaddressonrefresh="false" type="keyword" kind="editable" name="Prod_Departement"><keywords helperbutton="false" columns="4" ui="combobox"><formula>v_NomTable := "SDS_Departements" + SF_Langue;

v_Valeurs := @DbLookup(""; SF_GDK; "V_Tabl20"; v_NomTable; 6);
@If(@IsError(v_Valeurs); ""; v_Valeurs)</formula></keywords><code event="inputvalidation"><formula>@If(Prod_ClasseProduit = "EQ" &amp; @IsNull(@ThisValue); @Failure("Le département est obligatoire."); @Success)</formula></code></field></run><run><font size="9pt"/></run></par>
<par def="11"><run><font size="9pt"/></run></par></tablecell></tablerow>
<tablerow>
<tablecell borderwidth="0px">
<par def="5"><run><font size="9pt"/>Quantité :</run></par></tablecell>
<tablecell borderwidth="0px">
<pardef id="12" align="right" hide="read print preview" keepwithnext="true" keeptogether="true"><code event="hidewhen"><formula>Prod_Quantite &gt; 0</formula></code></pardef>
<par def="12"><run><font size="9pt"/></run><picture width="12px" height="16px" scaledheight="0.1667in" scaledwidth="0.1250in"><imageref name="img_Obligatoire.gif|img_Obligatoire"/></picture><run><font size="9pt"/></run></par></tablecell>
<tablecell borderwidth="0px">
<par def="8"><run><font size="9pt"/><field defaultfocus="true" usenotesstyle="false" height="0.2340in" width="0.3938in" multiline="true" borderstyle="single" type="number" kind="editable" name="Prod_Quantite"><keywords helperbutton="false" recalconchange="true" columns="2" ui="radiobutton"/><numberformat format="fixed" punctuated="false" parens="false" percent="false" bytes="false"/><code event="defaultvalue"><formula>@IfError(@DbLookup(""; SF_ServeurSDSBB : SF_FichierSDSBB; "V_Prod20"; Prod_CleProduit; 9); -9)</formula></code><code event="inputtranslation"><formula>@Round(@ThisValue)</formula></code><code event="inputvalidation"><formula>@If(@IsNull(@ThisValue); @Failure("La quantité est obligatoire."); @ThisValue &lt; 0 &amp; @IsNotMember("[Admin]" : "[Directeur]"; @UserRoles); @Failure("La quantité est invalide."); @Success)</formula></code><code event="onfocus"><lotusscript>Sub Onfocus(Source As Field)
	Dim nuiws As New NotesUIWorkspace
	If nuiws.CurrentDocument.EditMode Then
		Call nuiws.CurrentDocument.Selectall
	End If
End Sub</lotusscript></code></field></run><run><font size="9pt"/></run></par></tablecell></tablerow></table>
<par def="4"><run><font size="9pt" color="red"/></run></par>
<table widthtype="fitmargins" leftmargin="0" refwidth="5.9056in"><tablecolumn width="100%"/><tablecolumn width="0.9840in"/><tablecolumn width="0.9840in"/>
<tablerow>
<tablecell borderwidth="0px">
<pardef id="14" keepwithnext="true" keeptogether="true"/>
<par def="14"><run><font size="9pt"/></run></par></tablecell>
<tablecell borderwidth="0px">
<pardef id="15" keepwithnext="true" keeptogether="true"/>
<par def="15"><run><font size="9pt"/></run><urllink showborder="false"><run><font size="9pt"/></run></urllink><run><font size="9pt"/></run><actionhotspot hotspotstyle="none"><run><font size="9pt"/></run><picture width="32px" height="32px"><imageref name="hs_Annuler.gif|hs_Annuler"/></picture><run><font size="9pt"/></run><code event="click"><lotusscript>Sub Click(Source As Button)
	Dim nuiws As New NotesUIWorkspace
	nuiws.CurrentDocument.Document.DB_Continue = ""
	'Call nuiws.RefreshParentNote
	Call nuiws.CurrentDocument.Close
End Sub</lotusscript></code></actionhotspot><run><font size="9pt"/></run></par></tablecell>
<tablecell borderwidth="0px">
<pardef id="16" keepwithnext="true" keeptogether="true"><code event="hidewhen"><formula>PostOpen = "1"</formula></code></pardef>
<par def="16"><run><font size="9pt"/></run><actionhotspot hotspotstyle="none"><picture width="32px" height="32px"><imageref name="hs_OK.gif|hs_OK"/></picture><run><font size="9pt"/></run><code event="click"><lotusscript>Sub Click(Source As Button)
	Dim nuiws As New NotesUIWorkspace
	
	If DB_Querysave(nuiws.CurrentDocument) Then
		nuiws.CurrentDocument.Document.DB_Continue = "1"
		Call nuiws.RefreshParentNote
		Call nuiws.CurrentDocument.Close
	Else
		Call nuiws.CurrentDocument.RefreshHideFormulas
	End If
FinSub:
	Exit Sub
End Sub</lotusscript></code></actionhotspot><run><font size="9pt"/></run></par></tablecell></tablerow></table>
<pardef id="17" leftmargin="0.0785in" rightmargin="3.7403in" keepwithnext="true" keeptogether="true"/>
