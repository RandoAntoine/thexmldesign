<par def="152"><run><font size="9pt"/></run><actionhotspot hotspotstyle="none"><picture width="24px" height="24px" scaledheight="0.3333in" scaledwidth="0.3333in"><imageref name="hs_Annuler.gif|hs_Annuler"/></picture><run><font size="9pt"/></run><code event="click"><lotusscript>Sub Click(Source As Button)
	Dim nuiws As New NotesUIWorkspace
	
	nuiws.CurrentDocument.Document.DB_Continue = ""
	Call nuiws.RefreshParentNote
	Call nuiws.CurrentDocument.Close
End Sub
</lotusscript></code></actionhotspot><run><font size="9pt"/></run></par></tablecell>
<tablecell borderwidth="0px">
<pardef id="153" align="center" keepwithnext="true" keeptogether="true"/>
<par def="153"><run><font size="9pt"/></run><actionhotspot hotspotstyle="none"><picture width="24px" height="24px" scaledheight="0.3333in" scaledwidth="0.3333in"><imageref name="hs_OK.gif|hs_OK"/></picture><run><font size="9pt"/></run><code event="click"><lotusscript>Sub Click(Source As Button)
	Dim nuiws As New NotesUIWorkspace
	
	nuiws.CurrentDocument.Document.DB_Continue = "1"
	Call nuiws.RefreshParentNote
	If DBPMan_Queryclose(nuiws.CurrentDocument) Then
		Call nuiws.CurrentDocument.Close
	End If
	
End Sub
</lotusscript></code></actionhotspot><run><font size="9pt"/></run></par></tablecell></tablerow></table>
