<pardef id="144" leftmargin="0.2167in" keepwithnext="true" keeptogether="true"><code event="hidewhen"><formula>!@IsNull(DB_Code1)</formula></code></pardef>
<par def="144"><run><font size="9pt" style="italic"/>Aucun produit disponible.</run></par>
<pardef id="145" leftmargin="0.2167in" keepwithnext="true" keeptogether="true"><code event="hidewhen"><formula>DB_NbProduits &lt;= 20</formula></code></pardef>
<par def="145"><run><font size="9pt" style="italic"/>Il y a plus de produits disponibles que d'espace pour les afficher.</run></par>
<pardef id="146" keepwithnext="true" keeptogether="true"><code event="hidewhen"><formula>DB_NbProduitsNS = 0</formula></code></pardef>
<par def="146"><run><font size="9pt"/></run></par>
<pardef id="147" leftmargin="0.0785in" keepwithnext="true" keeptogether="true"><code event="hidewhen"><formula>DB_NbProduitsNS != 1</formula></code></pardef>
<par def="147"><run><font size="8pt" style="bold" color="red"/>!!! Un produit n'est plus disponible et sera supprimé de la proposition :</run></par>
<pardef id="148" leftmargin="0.0785in" keepwithnext="true" keeptogether="true"><code event="hidewhen"><formula>DB_NbProduitsNS &lt; 2</formula></code></pardef>
<par def="148"><run><font size="8pt" style="bold" color="red"/>!!! </run><run><font size="8pt" style="bold" color="red"/><computedtext><code event="value"><formula>@Text(DB_NbProduitsNS)</formula></code></computedtext></run><run><font size="8pt" style="bold" color="red"/> produits ne sont plus disponibles et serons supprimés de la proposition :</run></par>
