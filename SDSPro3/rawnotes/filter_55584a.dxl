<item name="$ScriptLib" summary="false" sign="true"><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Option Declare
Use "wsc_LSXSD"

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Class Cl_Commande As PortTypeBase

'++LotusScript Development Environment:2:5:(Declarations):0:10
Class Cl_Commande As PortTypeBase
	
	Sub NEW
		
		Dim v_Utilisateur As String
		Dim v_MotDePasse As String
		Dim v_Serveur As String
		
		v_Utilisateur = xGDK_xVarProf("Prof_WS_Utilisateur", "")
		v_MotDePasse = xGDK_xVarProf("Prof_WS_MotDePasse", "")
		v_Serveur = xGDK_xVarNDB("SIFc", "NDB_Serveur", "", False)
		If v_Serveur &lt;&gt; "" Then
			If Instr(v_Serveur, "/") &gt; 0 Then
				v_Serveur = Strleft(v_Serveur, "/")
			End If
		End If
		
		Call Service.Initialize ("UrnDefaultNamespacecl_CommandeService", _
		"cl_CommandeService.Domino", "https://" &amp; v_Serveur &amp; ".serti.com:443/interne/si_facturation.nsf/wsp_SIFcCo?OpenWebService", _
		"Cl_Commande")
		Call Service.setCredentials( v_Utilisateur, v_MotDePasse)
		Call Service.SetSSLOptions(NOTES_SSL_ACCEPT_SITE_CERTS + NOTES_SSL_ACCEPT_EXPIRED_CERTS)
		Call Service.setTimeout(240000)
	End Sub
	
	
	Function CREERCOMMANDEXML(P_XML As String) As String
		Let CREERCOMMANDEXML = Service.Invoke("CREERCOMMANDEXML", P_XML)
	End Function
	
	Function CREERCOMMANDEXSD(P_XML As XSD_HEXBINARY) As String
		Let CREERCOMMANDEXSD = Service.Invoke("CREERCOMMANDEXSD", P_XML)
	End Function
	
	Function ANNULERCOMMANDE(P_NOCOMMANDE As String, P_COMMENTAIRE As String) As Integer
		Let ANNULERCOMMANDE = Service.Invoke("ANNULERCOMMANDE", P_NOCOMMANDE, P_COMMENTAIRE)
	End Function
	
End Class<break/></text></item>
