<item name="$ScriptLib" summary="false" sign="true"><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Option Declare
Use "wsc_LSXSD"
'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Class Cl_Proposition As PortTypeBase

'++LotusScript Development Environment:2:5:(Declarations):0:10

Class Cl_Proposition As PortTypeBase
	
	Sub NEW
		Dim v_Serveur As String
		Dim v_Fichier As String
		Dim v_Utilisateur As String
		Dim v_MotDePasse As String
		
		v_Utilisateur = xGDK_xVarProf("Prof_WS_Utilisateur", "")
		v_MotDePasse = xGDK_xVarProf("Prof_WS_MotDePasse", "")
		v_Serveur = Strleft( xGDK_xVarNDB( "SDSP3" , "NDB_Serveur" , "" , True),"/")
		v_Fichier =  Replace(xGDK_xVarNDB( "SDSP3" , "NDB_Fichier" , "" , True), "\", "/")
		
		Call Service.Initialize ("UrnDefaultNamespacecl_PropositionService", _
		"cl_PropositionService.Domino", "https://" &amp; v_Serveur &amp; ".serti.com:443/" &amp; v_Fichier &amp; "/wsp_SDSP3?OpenWebService", _
		"Cl_Proposition")
		
		
		Call Service.setCredentials( v_Utilisateur, v_MotDePasse )
		Call Service.SetSSLOptions(NOTES_SSL_ACCEPT_SITE_CERTS + NOTES_SSL_ACCEPT_EXPIRED_CERTS)
		Call Service.setTimeout(240000)		
		
	End Sub
	
	Function PROPOSITIONPAYESDSP3(P_NOPROPOSITION As String, P_STATUT As String, P_USERNAME As String, _
	P_DBUNID As String) As String
		Let PROPOSITIONPAYESDSP3 = Service.Invoke("PROPOSITIONPAYESDSP3", P_NOPROPOSITION, P_STATUT, P_USERNAME, P_DBUNID)
	End Function
	
	Function CHANGERSTATUTSDSP3(P_NOPROPOSITION As String, P_STATUT As String, P_USERNAME As String, _
	P_DBUNID As String) As String
		Let CHANGERSTATUTSDSP3 = Service.Invoke("CHANGERSTATUTSDSP3", P_NOPROPOSITION, P_STATUT, P_USERNAME, P_DBUNID)
	End Function
	
	Function DUPLIQUERPROPOSITIONSDSP3(P_NOPROPOSITION As String, P_DESCRIPTION As String, _
	P_DBUNID As String, P_USERNAME As String) As String
		Let DUPLIQUERPROPOSITIONSDSP3 = Service.Invoke("DUPLIQUERPROPOSITIONSDSP3", P_NOPROPOSITION, P_DESCRIPTION, P_DBUNID, P_USERNAME)
	End Function
	
	Function RECALCULERCOUTSSDSP3(P_NOPROPOSITION As String, P_RECALCTOUS As Boolean, _
	P_RECALCLISTE As Boolean, P_USERNAME As String) As Boolean
		Let RECALCULERCOUTSSDSP3 = Service.Invoke("RECALCULERCOUTSSDSP3", P_NOPROPOSITION, P_RECALCTOUS, P_RECALCLISTE, P_USERNAME)
	End Function
	
	Function MAJNOCLIENTSITESDSP3(P_NOSITE As String, P_NOCLIENTFMT As String, P_USERNAME As String) As Boolean
		Let MAJNOCLIENTSITESDSP3 = Service.Invoke("MAJNOCLIENTSITESDSP3", P_NOSITE, P_NOCLIENTFMT, P_USERNAME)
	End Function
	
	Function MAJNOCLIENTPROPOSITIONSDSP3(P_NOPROPOSITON As String, P_NOCLIENTFMT As String, _
	P_USERNAME As String) As Boolean
		Let MAJNOCLIENTPROPOSITIONSDSP3 = Service.Invoke("MAJNOCLIENTPROPOSITIONSDSP3", P_NOPROPOSITON, P_NOCLIENTFMT, P_USERNAME)
	End Function
	
	Function CREERBONCOMMANDESSDSP3(P_NOPROPOSITION As String, P_NOSITES As String, _
	P_USERNAME As String) As String
		Let CREERBONCOMMANDESSDSP3 = Service.Invoke("CREERBONCOMMANDESSDSP3", P_NOPROPOSITION, P_NOSITES, P_USERNAME)
	End Function
	
	Function CHANGERNOCLIENTSDSP3(P_NOPROPOSITION As String, P_NOCLIENTFMT As String, _
	P_USERNAME As String) As Boolean
		Let CHANGERNOCLIENTSDSP3 = Service.Invoke("CHANGERNOCLIENTSDSP3", P_NOPROPOSITION, P_NOCLIENTFMT, P_USERNAME)
	End Function
	
End Class
<break/></text></item>
