<item name="$TITLE" sign="true"><text>wsc_SDSP3_OneSpanSign</text></item>
<item name="$Flags"><text>s34Q</text></item>
<item name="$PublicAccess" sign="true"><text>1</text></item>
<item name="$FlagsExt" sign="true"><text>W</text></item>
<item name="$Comment" sign="true"><text>1.0 HTTPS</text></item>
<item name="$DesignerVersion" sign="true"><text>8.5.3</text></item>
<item name="$ScriptLib" summary="false" sign="true"><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Option Declare
Use "wsc_LSXSD"

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Class Cl_PropOneSpanSign As PortTypeBase

'++LotusScript Development Environment:2:5:(Declarations):0:10

Class Cl_PropOneSpanSign As PortTypeBase
	
	Sub NEW
		
		Dim v_Serveur As String
		Dim v_Fichier As String
		Dim v_Utilisateur As String
		Dim v_MotDePasse As String
		
		v_Utilisateur = xGDK_xVarProf("Prof_WS_Utilisateur", "")
		v_MotDePasse = xGDK_xVarProf("Prof_WS_MotDePasse", "")
		v_Serveur = Strleft( xGDK_xVarNDB( "SDSP3" , "NDB_Serveur" , "" , True),"/")
		v_Fichier =  Replace(xGDK_xVarNDB( "SDSP3" , "NDB_Fichier" , "" , True), "\", "/")
		
		Call Service.Initialize ("UrnDefaultNamespacecl_PropOneSpanSignService", _
		"cl_PropOneSpanSignService.Domino", "https://" &amp; v_Serveur &amp; ".serti.com:443/" &amp; v_Fichier &amp; "/wsp_SDSP3OSSg?OpenWebService", _
		"Cl_PropOneSpanSign")
		
		Call Service.setCredentials( v_Utilisateur, v_MotDePasse )
		Call Service.SetSSLOptions(NOTES_SSL_ACCEPT_SITE_CERTS + NOTES_SSL_ACCEPT_EXPIRED_CERTS)
		Call Service.setTimeout(240000)		
		
	End Sub
	
	Function ENVOYERNOTIFICATIONEVENEMENTSDSP3(P_NOPROPOSITION As String, P_TYPENOTIFICATION As String, _
	P_PACKAGEID As String, P_SESSIONUSERID As String) As Boolean
		Let ENVOYERNOTIFICATIONEVENEMENTSDSP3 = Service.Invoke("ENVOYERNOTIFICATIONEVENEMENTSDSP3", P_NOPROPOSITION, P_TYPENOTIFICATION, P_PACKAGEID, P_SESSIONUSERID)
	End Function
	
End Class<break/></text></item>
