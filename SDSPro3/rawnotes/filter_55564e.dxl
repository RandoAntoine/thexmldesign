<item name="$Comment" sign="true"><text>2.3 ** SIBDC2 HTTPS</text></item>
<item name="$DesignerVersion" sign="true"><text>8.5.3</text></item>
<item name="$ScriptLib" summary="false" sign="true"><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Option Declare
Use "wsc_LSXSD"
'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Class Cl_wsBonCommande As PortTypeBase

'++LotusScript Development Environment:2:5:(Declarations):0:10
Class Cl_wsBonCommande As PortTypeBase
	
	Sub NEW
		Dim v_Serveur As String
		Dim v_Fichier As String
		Dim v_Utilisateur As String
		Dim v_MotDePasse As String
		
		v_Utilisateur = xGDK_xVarProf("Prof_WS_Utilisateur", "")
		v_MotDePasse = xGDK_xVarProf("Prof_WS_MotDePasse", "")
		v_Serveur = Strleft( xGDK_xVarNDB( "SIBDC2" , "NDB_Serveur", "", True ), "/")
		v_Fichier =  Replace( xGDK_xVarNDB( "SIBDC2" , "NDB_Fichier", "", True ), "\", "/")
		
		Call Service.Initialize ("UrnDefaultNamespacecl_wsBonCommandeService", "cl_wsBonCommandeService.Domino", _
		"https://" &amp; v_Serveur &amp; ".serti.com:443/" &amp; v_Fichier &amp; "/wsp_BonCommande?OpenWebService", "Cl_wsBonCommande")
		
		Call Service.setCredentials( v_Utilisateur, v_MotDePasse)
		Call Service.SetSSLOptions(NOTES_SSL_ACCEPT_SITE_CERTS + NOTES_SSL_ACCEPT_EXPIRED_CERTS)
		Call Service.setTimeout(240000)	
	End Sub
	
	Function CREERBONCOMMANDE(P_ORIGINE As String, P_NOPROPOSITION As String, P_NOSITE As String, _
	P_USERNAME As String) As String
		Let CREERBONCOMMANDE = Service.Invoke("CREERBONCOMMANDE", P_ORIGINE, P_NOPROPOSITION, P_NOSITE, P_USERNAME)
	End Function
	
	Function ASSIGNERSTATUT(P_NOBONCOMMANDE As String, P_STATUT As String, P_COMMENTAIRE As String, _
	P_USERNAME As String) As Integer
		Let ASSIGNERSTATUT = Service.Invoke("ASSIGNERSTATUT", P_NOBONCOMMANDE, P_STATUT, P_COMMENTAIRE, P_USERNAME)
	End Function
	
	Function ASSIGNERAFFECTATION(P_NOBONCOMMANDE As String, P_STATUT As String, P_COMMENTAIRE As String, _
	P_USERNAME As String) As Integer
		Let ASSIGNERAFFECTATION = Service.Invoke("ASSIGNERAFFECTATION", P_NOBONCOMMANDE, P_STATUT, P_COMMENTAIRE, P_USERNAME)
	End Function
	
	Function ASSIGNERSTATUTTRAVAIL(P_NOBONCOMMANDE As String, P_STATUT As String, _
	P_USERNAME As String) As Integer
		Let ASSIGNERSTATUTTRAVAIL = Service.Invoke("ASSIGNERSTATUTTRAVAIL", P_NOBONCOMMANDE, P_STATUT, P_USERNAME)
	End Function
	
End Class<break/></text></item>
