<item name="$TITLE" sign="true"><text>wsc_SIPJ_Client</text></item>
<item name="$Flags"><text>s34Q</text></item>
<item name="$PublicAccess" sign="true"><text>1</text></item>
<item name="$FlagsExt" sign="true"><text>W</text></item>
<item name="$Comment" sign="true"><text>1.0 HTTPS</text></item>
<item name="$DesignerVersion" sign="true"><text>8.5.3</text></item>
<item name="$ScriptLib" summary="false" sign="true"><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Option Declare
Use "wsc_LSXSD"
'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Class Cl_SIPJ_Client As PortTypeBase

'++LotusScript Development Environment:2:5:(Declarations):0:10
Class Cl_SIPJ_Client As PortTypeBase
	
	Sub NEW
		
		Dim v_Utilisateur As String
		Dim v_MotDePasse As String
		Dim v_Serveur As String
		Dim v_Fichier As String
		
		v_Utilisateur = xGDK_xVarProf("Prof_WS_Utilisateur", "")
		v_MotDePasse = xGDK_xVarProf("Prof_WS_MotDePasse", "")
		v_Serveur = Strleft( xGDK_xVarNDB( "PJSDS" , "NDB_Serveur" , "" , True),"/")
		v_Fichier =  Replace(xGDK_xVarNDB( "PJSDS" , "NDB_Fichier" , "" , True), "\", "/")
		
		
		Call Service.Initialize ("UrnDefaultNamespacecl_SIPJ_ClientService", _
		"cl_SIPJ_ClientService.Domino", "https://" &amp; v_Serveur &amp; ".serti.com:443/" &amp; v_Fichier &amp; "/wsp_SIPJCl?OpenWebService", _
		"Cl_SIPJ_Client")
		Call Service.setCredentials( v_Utilisateur, v_MotDePasse)
		Call Service.SetSSLOptions(NOTES_SSL_ACCEPT_SITE_CERTS + NOTES_SSL_ACCEPT_EXPIRED_CERTS)
		Call Service.setTimeout(240000)
	End Sub
	
	
	
	Function MAJNOCLIENT(P_CLECLIENT As String, P_CLIENTNOFMT As String, P_USERNAME As String) As Integer
		Let MAJNOCLIENT = Service.Invoke("MAJNOCLIENT", P_CLECLIENT, P_CLIENTNOFMT, P_USERNAME)
	End Function
	
End Class<break/></text></item>
