<item name="$ScriptLib" summary="false" sign="true"><text>'++LotusScript Development Environment:2:5:(Options):0:74
Option Public
Use "wsc_LSXSD"

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Class Cl_wsBonTravail As PortTypeBase

'++LotusScript Development Environment:2:5:(Declarations):0:10

Class Cl_wsBonTravail As PortTypeBase
	
	Sub NEW
		Dim v_Serveur As String
		Dim v_Fichier As String		
		Dim v_Utilisateur As String
		Dim v_MotDePasse As String
		
		v_Utilisateur = xGDK_xVarProf("Prof_WS_Utilisateur", "")
		v_MotDePasse = xGDK_xVarProf("Prof_WS_MotDePasse", "")
		v_Serveur = Strleft( xGDK_xVarNDB( "SIBDT" , "NDB_Serveur" , "" , True),"/")
		v_Fichier =  Replace(xGDK_xVarNDB( "SIBDT" , "NDB_Fichier" , "" , True), "\", "/")
		
		Call Service.Initialize ("UrnDefaultNamespacecl_wsBonTravailService", "cl_wsBonTravailService.Domino", _
		"https://" &amp; v_Serveur &amp; ".serti.com:443/" &amp; v_Fichier &amp; "/wsp_BonTravail?OpenWebService", "Cl_wsBonTravail")
		
		Call Service.setCredentials( v_Utilisateur, v_MotDePasse )
		Call Service.SetSSLOptions(NOTES_SSL_ACCEPT_SITE_CERTS + NOTES_SSL_ACCEPT_EXPIRED_CERTS)
		Call Service.setTimeout(240000)
		
	End Sub
	
	Function TITREBD() As String
		Let TITREBD = Service.Invoke("TITREBD")
	End Function
	
	Function CREERBONTRAVAIL(P_ORIGINE As String, P_NOBONCOMMANDEFMT As String, P_USERNAME As String, _
	P_STATUT As String) As String
		Let CREERBONTRAVAIL = Service.Invoke("CREERBONTRAVAIL", P_ORIGINE, P_NOBONCOMMANDEFMT, P_USERNAME, P_STATUT)
	End Function
	
	Function CREERPRODUIT(P_NOTEIDBONTRAVAIL As String, P_CLEPRODUIT As String, P_QUANTITE As Integer, _
	P_TRIEPRODUIT As Integer, P_USERNAME As String) As String
		Let CREERPRODUIT = Service.Invoke("CREERPRODUIT", P_NOTEIDBONTRAVAIL, P_CLEPRODUIT, P_QUANTITE, P_TRIEPRODUIT, P_USERNAME)
	End Function
	
	Function ASSIGNERSTATUT(P_NOTEIDBONTRAVAIL As String, P_STATUT As String, P_COMMENTAIRE As String, _
	P_ACTION As String, P_AFFEINSTRUCTION As String, P_USERNAME As String) As Integer
		Let ASSIGNERSTATUT = Service.Invoke("ASSIGNERSTATUT", P_NOTEIDBONTRAVAIL, P_STATUT, P_COMMENTAIRE, P_ACTION, P_AFFEINSTRUCTION, P_USERNAME)
	End Function
	
	Function PROPAGERSTATUTBC(P_NOBONCOMMANDEFMT As String, P_STATUTBONCOMMANDE As String) As Integer
		Let PROPAGERSTATUTBC = Service.Invoke("PROPAGERSTATUTBC", P_NOBONCOMMANDEFMT, P_STATUTBONCOMMANDE)
	End Function
	
	Function CREERAFFECTATION(P_NOTEIDBONTRAVAIL As String, P_STATUTAFFEC As String, _
	P_NOEMPLOYE As String, P_GROUPE As String, P_CODEGROUPE As String, P_USERNAME As String) As String
		Let CREERAFFECTATION = Service.Invoke("CREERAFFECTATION", P_NOTEIDBONTRAVAIL, P_STATUTAFFEC, P_NOEMPLOYE, P_GROUPE, P_CODEGROUPE, P_USERNAME)
	End Function
	
	Function MAJAUTEURSAFFECTEBONTRAVAIL(P_NOTEIDBONTRAVAIL As String) As Boolean
		Let MAJAUTEURSAFFECTEBONTRAVAIL = Service.Invoke("MAJAUTEURSAFFECTEBONTRAVAIL", P_NOTEIDBONTRAVAIL)
	End Function
	
	Function AJOUTERHISTORIQUE(P_NOTEIDBONTRAVAIL As String, P_STATUT As String, P_COMMENTAIRE As String, _
	P_USERNAME As String, P_REBATIR As Boolean) As Boolean
		Let AJOUTERHISTORIQUE = Service.Invoke("AJOUTERHISTORIQUE", P_NOTEIDBONTRAVAIL, P_STATUT, P_COMMENTAIRE, P_USERNAME, P_REBATIR)
	End Function
	
	Function MAJAFFECTATIONSACTIVE(P_NOTEIDBONTRAVAIL As String) As Boolean
		Let MAJAFFECTATIONSACTIVE = Service.Invoke("MAJAFFECTATIONSACTIVE", P_NOTEIDBONTRAVAIL)
	End Function
	
End Class<break/></text></item>
