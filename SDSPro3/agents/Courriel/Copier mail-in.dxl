<trigger type="scheduled">
<schedule type="never" runlocation="specific" runserver="CN=Zulu/O=Serti Informatique"/></trigger><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_GestionErreurs"


</lotusscript></code><code event="declarations"><lotusscript>Dim gns_A As NotesSession
Dim gndb_A As NotesDatabase

' Traitement des erreurs
Const gc_TypeElement_A = "A"
Const gc_Element_A = "A_CpyMailIn"

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	On Error GoTo GererErreur
	
	Dim nd As NotesDocument
	Dim nd_Suivant As NotesDocument
	Dim v_Fichier As String
	Dim ndb_Courriel As NotesDatabase
	
	Dim v_Formule As String
	Dim ndc As NotesDocumentCollection
	
	Dim v_NbLus As Long
	Dim v_NbCopie As Long
	
	' Initialisation
	Call A_Initialisations
	
	Print "Début"
	
	v_Formule = |Form = "Memo" &amp; !@IsNull(Memo_EnvoyerCourriel)|
	Set ndc = gndb_A.Search(v_Formule, Nothing, 0)
	
	If ndc.Count = 0 Then
		Exit Sub
	End If
	
	Set nd_Suivant = ndc.GetFirstDocument
	
	Do Until nd_Suivant Is Nothing
		Set nd = nd_Suivant
		Set nd_Suivant = ndc.Getnextdocument(nd_Suivant)
		v_NbLus = v_NbLus + 1
		
		v_Fichier = xVar(nd, "Memo_Fichier", "")
		If v_Fichier &lt;&gt; "" then
			Set ndb_Courriel = gns_A.Getdatabase(xVar(nd, "Memo_Serveur", ""), v_Fichier, False) 
			If Not (ndb_Courriel Is Nothing) Then
				Call nd.Copytodatabase(ndb_Courriel)
				v_NbCopie = v_NbCopie + 1	
			End If
		End If
		
		nd.Memo_EnvoyerCourriel = ""
		Call nd.Save(True,False)
	Loop
	
	
	Print "Fin - " &amp; CStr(v_NbCopie) &amp; " courriels copiés"
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_A, gc_Element_A, GetThreadInfo(1), xVar(nd, "Memo_Serveur", "") &amp; " || " &amp; v_Fichier, False)
	Exit Sub
End Sub

</lotusscript></code><code event="A_Initialisations"><lotusscript>Sub A_Initialisations
	If gns_A Is Nothing Then
		Set gns_A = New NotesSession
		Set gndb_A = gns_A.CurrentDatabase
	End If
End Sub</lotusscript></code>
