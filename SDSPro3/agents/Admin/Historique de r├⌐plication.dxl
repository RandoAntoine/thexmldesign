<documentset type="modified"/><code event="options"><lotusscript>%REM
	Agent Création_Ouverture du doc historique de replication
	Created Jan 10, 2017 by Christian De-Nardi/Serti Informatique
	Description: Cet Agent est appelé par le OutLine "Menu Admin"
%END REM
Option Public
Option Declare

Use "SI_GestionErreurs"


</lotusscript></code><code event="declarations"><lotusscript>Dim gns_A As NotesSession
Dim gndb_A As NotesDatabase

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_A = "A"
Const gc_Element_A = "A_SIHR"

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	On Error GoTo GererErreur

	Dim nuiws As New NotesUIWorkspace
	Dim nuid As NotesUIDocument
	Dim nd_box As NotesDocument
	
	Dim v_DocID As Variant
	Dim nv As NotesView
	
	Call A_Initialisations
	
	Set nv = gndb_A.GetView("V_SIHR20")
	Call nv.Refresh()
	v_DocID = Evaluate(|@DbLookup("Notes" : "NoCache" ; "" ; "V_SIHR20" ; "SIHR_Profil"; 1; [ReturnDocumentUniqueID])|)
	If Not IsArray(v_DocID) Then
		Set nd_Box = New NotesDocument(gndb_A)
		If Not(nuiws.DialogBox( "DB_SIHR", True, True, False, False, False, False, "Paramètres de suppression de l'historique de réplication", nd_Box, True)) Then
			Exit Sub
		End If
		
	Else
		Set nd_Box = gndb_A.GetDocumentByUNID(CStr(v_DocID(0)))
		Print CStr(v_DocID(0))
		If Not(nuiws.DialogBox( "DB_SIHR", True, True, False, False, False, False, "Paramètres de suppression de l'historique de réplication", nd_Box, True)) Then
			Exit Sub
		End If
	End If
	
	Call nd_Box.save(True,False)
	
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_A, gc_Element_A, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="A_Initialisations"><lotusscript>Sub A_Initialisations
	If gns_A Is Nothing Then
		Set gns_A = New NotesSession
		Set gndb_A = gns_A.Currentdatabase
	End If
End Sub</lotusscript></code>
