<trigger type="scheduled">
<schedule type="never" runlocation="specific" runserver="CN=Zulu/O=Serti Informatique"/></trigger><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_GestionErreurs"


</lotusscript></code><code event="declarations"><lotusscript>' Traitement des erreurs
Const gc_TypeElement_A = "A"
Const gc_Element_A = "F_Edit"

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	On Error GoTo GererErreur
	
	Dim ns As New NotesSession
	Dim ndb As Notesdatabase
	Dim nd As NotesDocument
	Dim nuiws As New NotesUIWorkspace
	Dim v_DocId As string
	
	Set ndb = ns.Currentdatabase
	v_DocId = ns.Currentagent.ParameterDocId
	Set nd = ndb.Getdocumentbyid(v_DocId)
	
	Call nuiws.EditDocument(True, nd)
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_A, gc_Element_A, Getthreadinfo(1), v_DocId, False)
	Exit Sub
End Sub</lotusscript></code>
