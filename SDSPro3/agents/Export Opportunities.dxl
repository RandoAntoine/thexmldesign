<documentset type="runonce"/><code event="options"><lotusscript>Option Public
Option Declare

</lotusscript></code><code event="initialize"><lotusscript>
Sub Initialize
    Dim session As New NotesSession
    Dim db As NotesDatabase
    Dim view As NotesView
    Dim doc As NotesDocument
    Dim excelApp As Variant
    Dim workbook As Variant
    Dim worksheet As Variant
    Dim row As Long
    Dim col As Integer
    Dim columnCount As Integer
    
    ' --- Configuration ---
    Dim viewName As String
    viewName = "lkupProp"       ' Change this to your view name
    Dim outputFile As String
    outputFile = "C:\Temp\NotesViewExport.xlsx" ' Output Excel file
    
    ' --- Open database and view ---
    Set db = session.CurrentDatabase
    Set view = db.GetView(viewName)
    If view Is Nothing Then
        MsgBox "View not found: " &amp; viewName
        Exit Sub
    End If
    
    ' --- Start Excel ---
    Set excelApp = CreateObject("Excel.Application")
    excelApp.Visible = True
    Set workbook = excelApp.Workbooks.Add
    Set worksheet = workbook.Sheets(1)
    
    ' --- Get column titles from view ---
    Dim colTitles() As String
    columnCount = view.Columns.Count
    ReDim colTitles(1 To columnCount)
    
    For col = 1 To columnCount
        colTitles(col) = view.Columns(col - 1).Title
        worksheet.Cells(1, col).Value = colTitles(col)
    Next
    
    ' --- Export view data ---
    row = 2
    Set doc = view.GetFirstDocument
    While Not (doc Is Nothing)
        Dim nextDoc As NotesDocument
        Set nextDoc = view.GetNextDocument(doc)
        
        For col = 1 To columnCount
            Dim colValue As String
            colValue = doc.GetItemValue(view.Columns(col - 1).ItemName)(0)
            worksheet.Cells(row, col).Value = colValue
        Next
        
        row = row + 1
        Set doc = nextDoc
    Wend
    
    ' --- Autofit and Save ---
    worksheet.Columns.AutoFit
    workbook.SaveAs outputFile
    MsgBox "Export completed: " &amp; outputFile
    
    ' --- Cleanup ---
    'workbook.Close 
    'SaveChanges:=True
    excelApp.Quit
    Set worksheet = Nothing
    Set workbook = Nothing
    Set excelApp = Nothing
End Sub
</lotusscript></code>
