</lotusscript></code><code event="A_EnvoyerTransactionPut"><lotusscript>Function A_EnvoyerTransactionPut (p_CleIntegration As String, p_URL As String, p_Reponse As Integer, p_ReponseJSON As String) As Boolean
	'On Error GoTo GererErreur

	Dim objHttp As Variant
	Dim v_Reponse As String
	Dim v_JSON As String
	
	A_EnvoyerTransactionPut = False
	
	' --- instantiate an MSXML XMLHTTP object
	Set objHttp = CreateObject("Microsoft.XMLHTTP")
	
	v_JSON = |{"status": "EXPIRED"}|
	
	'v_JSON = "{\"status\": \"SENT\"}"
 	'v_json = |{\"status\": \"EXPIRED\"}|
	
	' --- open a PUT request and set the Content-type header 
	objHttp.open "PUT", p_url, False
	objHttp.setRequestHeader "Accept", "application/json"
	objHttp.setRequestHeader "Content-type", "application/json"
	objHttp.setRequestHeader "Authorization", "Basic " &amp; p_CleIntegration
	'objHttp.send (v_JSON)
	objHttp.send (|{"status": "EXPIRED"}|)
	
	%REM
			
	v_JSON = |{"status": "EXPIRED"}|
	
	' --- open a PUT request and set the Content-type header 
	objHttp.open "PUT", p_url, False
	objHttp.setRequestHeader "Accept", "application/json"
	objHttp.setRequestHeader "Content-type", "application/json"
	objHttp.setRequestHeader "Authorization", "Basic " &amp; p_CleIntegration
	objHttp.send (v_JSON)
	%END REM

	v_Reponse = objHTTP.Status
	p_ReponseJSON = objHttp.responseText
	Set objHttp = Nothing
	
	
	p_Reponse = CInt(v_Reponse)
	If p_Reponse &lt; 300 Then
		A_EnvoyerTransactionPut = True
	Else
		Call SIGE_TraiterErreurManuelle(gc_TypeElement_A, gc_Element_A, GetThreadInfo(1), 0, v_Reponse, p_ReponseJSON, False)
	End If
	
	
EnregistrerLog:
	Call SIGE_OuvrirLog(gc_TypeElement_A, gc_Element_A)
	Call SIGE_AjouterLog("-------------------------------------------------------------------------------", 0, 0, False)
	Call SIGE_AjouterLog("Requête : " &amp; p_url, 0, 0, False)
	Call SIGE_AjouterLog("Reponse : " &amp; CStr(p_Reponse), 0, 0, False)
	If p_Reponse &gt;= 300  Then		
		Call SIGE_AjouterLog("JSON    :", 0, 0, False)
		Call SIGE_AjouterLog(p_ReponseJSON, 0, 0, False)
	End If
	Call SIGE_AjouterLog("-------------------------------------------------------------------------------", 0, 0, False)
	Call SIGE_EnregistrerLog
	
	Exit Function
	
GererErreur:
	Set objHttp = Nothing
	Call SIGE_TraiterErreur(gc_TypeElement_A, gc_Element_A, GetThreadInfo(1), p_URL, False)
	GoTo EnregistrerLog
End Function

</lotusscript></code><code event="A_EnvoyerTransactionPut_SJOSS"><lotusscript>Function A_EnvoyerTransactionPut_SJOSS (p_CleIntegration As String, p_Url As String) As Boolean
	On Error GoTo GererErreur

	On Error GoTo GererErreur
	
	Dim v_JSON As String
	Dim v_Statut As String
	Dim v_StatutTran As String
	
	Dim js_SJOSS As JavaSession
	Dim jcl_SJOSS As JavaClass
	Dim jo_SJOSS As JavaObject
	
	Dim v_Resultat As String
	Dim v_Reponse As Integer
	Dim v_ReponseJSON As String	
	Dim njsonn As NotesJSONNavigator
	
	
	A_EnvoyerTransactionPut_SJOSS = False
	

	Call SLOSS_Initialisations
	
	'g_Url_SLOSS = "https://apps.e-signlive.ca/api"
	'v_Url = g_Url_SLOSS &amp; "/packages"
	
	Set js_SJOSS = New JavaSession()
	Set jcl_SJOSS = js_SJOSS.GetClass("pk_SJOSS.cl_SJOSS2")		
	Set jo_SJOSS = jcl_SJOSS.CreateObject

	
	v_JSON = |{"status": "EXPIRED"}|
	'v_json = |{\"status\": \"EXPIRED\"}|
	
	'If Not A_GenererJSON (v_JSON) Then
	'	v_Statut = "E82"				' Erreur génération du JSON
	'	Exit Function
	'End If	
	
	v_StatutTran = |"EXPIRED"|
	'\"SENT\"

	'v_Resultat = jo_SJOSS.EnvoyerTransactionPut (p_CleIntegration, p_URL, v_JSON, v_ReponseJSON, "")', a_Fichier(1) = ""
    v_Resultat = jo_SJOSS.EnvoyerTransactionPut (p_CleIntegration, p_URL, v_StatutTran, v_ReponseJSON, "")', a_Fichier(1) = ""
	
	
	Call SIGE_AjouterLog("JAVA Resultat : " &amp; v_Resultat, 0, 0, False)
	If v_Resultat = "" Or Left(v_Resultat, 3) = "ERR" Then
		Print "Erreur envoi de la transaction" 
		v_Statut = "E88"	
	Else 
		v_Reponse = CInt(StrLeft(v_Resultat, ";"))
		v_ReponseJSON = StrRight(v_Resultat, ";")


		If v_Reponse &lt; 300 Then
			A_EnvoyerTransactionPut_SJOSS = True
		Else
			Call SIGE_TraiterErreurManuelle(gc_TypeElement_A, gc_Element_A, GetThreadInfo(1), 0, Cstr(v_Reponse), v_ReponseJSON, False)
		End If

	End If

	Call SIGE_AjouterLog("-------------------------------------------------------------------------------", 0, 0, False)
	Call SIGE_AjouterLog("URL : " &amp; p_URL, 0, 0, False)
	Call SIGE_AjouterLog("Payload : " &amp; v_JSON, 0, 0, False)
	Call SIGE_AjouterLog("Reponse : " &amp; CStr(v_Reponse), 0, 0, False)
	If v_Reponse &gt;= 300 Then
		Call SIGE_AjouterLog("-------------------------------------------------------------------------------", 0, 0, False)
		Call SIGE_AjouterLog("JSON Reponse : ", 0, 0, False)
		Call SIGE_AjouterLog(v_ReponseJSON, 0, 0, False)
	End If
	Call SIGE_EnregistrerLog
	Exit Function
	
GererErreur:
	v_Statut = "E89"			' Erreur de programmation
	Call SIGE_TraiterErreur(gc_TypeElement_SLOSS, gc_Element_SLOSS, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="A_GenererJSON"><lotusscript>Function A_GenererJSON (p_JSON As String) As Boolean
	On Error GoTo GererErreur
	
	Dim v_JSON As String
	Dim jsonw As JSONWriter
	
	A_GenererJSON = False
	
	' Génération du JSON
	Set jsonw = New JSONWriter
	v_JSON = jsonw.BeginObject	' {

	v_JSON = v_JSON &amp; jsonw.Key("status")
	v_JSON = v_JSON &amp; jsonw.AppendValue("EXPIRED")
	
	v_JSON = v_JSON &amp; jsonw.EndObject	' }
	
	p_JSON = v_JSON
	
	A_GenererJSON = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SLOSS, gc_Element_SLOSS, GetThreadInfo(1), "Expeditaire : " &amp; v_JSON, False)
	Exit Function		
End Function
</lotusscript></code>
