<trigger type="actionsmenu"/>
<documentset type="runonce"/><code event="options"><lotusscript>Option Public
Option Declare
Use "A_Inst"

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	Dim nuiws As New NotesUIWorkspace
	Dim ns As New NotesSession
	Dim ndb As NotesDatabase
	
	Set ndb = ns.CurrentDatabase
	
	' L'agent ne peut être exécuté que sur un serveur
	' -----------------------------------------------
	If AInst_NdbSurServeur(False) Then
		
		' Demander confirmation
		' ---------------------
		If nuiws.Prompt(PROMPT_YESNO, xGDK_xMessage("SI", 10, "", ""), 	xGDK_xMessage("SI", 67, "", ndb.Title)) Then
			
			' Initialiser le GDK
			' ------------------
			If AInst_InitialiserGDKLocal Then
				
				' Créer une réplique locale de SI Représentants
				' ---------------------------------------------
				Call AInst_CreerRepliqueLocale("SIRR", 0)
				
				' Créer une réplique locale de SDS Base
				' -------------------------------------
				Call AInst_CreerRepliqueLocale("SDSBB", 0)
				
				' Créer une réplique locale de SDS Propositions
				' ---------------------------------------------
				Call AInst_CreerRepliqueLocale("SDSP3", 1)
				
				' Créer une réplique locale de SI Documents Ventes
				' ------------------------------------------------
				Call AInst_CreerRepliqueLocale("SIDV", 0)
				
				' Créer une réplique locale de Projeto SDS
				' ----------------------------------------
				'Call AInst_CreerRepliqueLocale("PJSDS", 0)
				
				' Créer une réplique locale de SI Contacts
				' ----------------------------------------
				Call AInst_CreerRepliqueLocale("SICo", 0)
				
				' Créer une réplique locale de SDS Contrat Service local
				' ------------------------------------------------------
				Call AInst_CreerRepliqueLocale("SDSCSL", 0)
				
				' Créer une réplique locale de SI Employes
				' ----------------------------------------
				Call AInst_CreerRepliqueLocale("SIEm", 0)
			End If
		End If
	End If
End Sub</lotusscript></code>
