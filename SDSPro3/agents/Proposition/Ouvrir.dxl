<documentset type="modified"/><code event="options"><lotusscript>Option Public
Option Explicit
Use "SDSP_PropositionUI"


</lotusscript></code><code event="declarations"><lotusscript>
' Traitement des erreurs
Const gc_TypeElement_A = "A"
Const gc_Element_A = "A_OPP"		' Inscrire l'alias de l'agent

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	On Error GoTo GererErreur

	Dim ns As New NotesSession
	Dim ndb As NotesDatabase
	Dim nd_Prop As NotesDocument
	Dim nd_PNav As NotesDocument
	Dim nuiws As New NotesUIWorkspace
	Dim v_DocId As String
	Dim v_EditMode As Boolean
	Dim v_Statut As String
	
	Set ndb = ns.Currentdatabase
	v_DocId = ns.Currentagent.ParameterDocId
	Set nd_Prop = ndb.Getdocumentbyid(v_DocId)

	Set nd_PNav = New NotesDocument(ndb)
	nd_PNav.Form = "F_PNav0.00"
	
	nd_PNav.PNav_Titre = Trim("C" &amp; CStr(xVar(nd_Prop, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(nd_Prop, "Prop_ClientNomInterne", xVar(nd_Prop, "Prop_ClientNom", "")))
	
	nd_PNav.Prop_NoProposition = xVar(nd_Prop, "Prop_NoProposition", "")
	nd_PNav.Prop_ClientNomInterne = xVar(nd_Prop, "Prop_ClientNomInterne", "")
	
	v_EditMode = False
	
	If SDSPP_AccesAuteur(nd_Prop) Then
		
		Select Case SDSPP_EstAuteur(nd_Prop)			
		Case 1:
			' si pas role [Admin] - lookup dans table des statut
			v_EditMode = SDSPP_EditMode(nd_Prop)		
		Case 2:
			' Si role [Admin]- toujours ouvrir en edit mode
			v_EditMode = True			
	End Select		
		
	End If
	
	If v_EditMode Then
		nd_PNav.PNav_EditMode = 1 
	Else
		nd_PNav.PNav_EditMode = 0
		nd_PNav.SaveOptions = "0"
	End If
	
	On Error Resume Next
	Call nuiws.EditDocument(True, nd_PNav)
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_A, gc_Element_A, Getthreadinfo(1), "", False)
	Exit Sub
End Sub</lotusscript></code>
