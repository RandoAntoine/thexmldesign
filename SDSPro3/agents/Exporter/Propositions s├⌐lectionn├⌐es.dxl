<trigger type="actionsmenu"/>
<documentset type="selected"/><code event="options"><lotusscript>Option Public
Option Declare
Use "SDSP_Exportations"


</lotusscript></code><code event="declarations"><lotusscript>Dim gns_A As NotesSession
Dim gndb_A As NotesDatabase

' Traitement des erreurs
Const gc_TypeElement_A = "A"
Const gc_Element_A = "A_ExpS"


</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	On Error GoTo GererErreur
	
	Dim ndc As NotesDocumentCollection
	Dim v_Resultat As Integer
	
	'Initialisations
	Print "Exportation des propositions - Début"
	Call A_Initialisations
	
	Set ndc = gndb_A.UnprocessedDocuments
	If ndc.Count = 0 Then
		Print "Aucun document sélectionné"
		Exit Sub
	End If

	Print "Exportation des propositions - " &amp; CStr(ndc.Count) &amp; " documents sélectionnés"
	v_Resultat = SDSPEx_ExporterPropositions(ndc, "")
	If v_Resultat = -265 Then
		Print "Exportation annulée."
	ElseIf v_Resultat &lt; 0 Then
		MessageBox "Une erreur s'est produite pendant l'exportation.", 16, "Exportation annulée"
	ElseIf v_Resultat &gt; 0 Then
		Print "Exportation terminée."
	Else
		Print "Aucune proposition sélectionnée.", 64, "Exportation annulée"
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_A, gc_Element_A, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="A_Initialisations"><lotusscript>Sub A_Initialisations
	If gns_A Is Nothing Then
		Set gns_A = New NotesSession
		Set gndb_A = gns_A.CurrentDatabase
	End If
End Sub

</lotusscript></code>
