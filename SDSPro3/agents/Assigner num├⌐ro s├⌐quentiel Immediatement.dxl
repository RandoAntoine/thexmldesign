</lotusscript></code><code event="declarations"><lotusscript>Dim gns_A As NotesSession
Dim gndb_A As NotesDatabase

' Traitement des erreurs
' -----------------------------------
Const gc_TypeElement_A = "A"
Const gc_Element_A = "A_ANSImed"

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	'==============================================================================
	' Le script assign le numéro séquentiel au propositions
	'==============================================================================
	On Error GoTo GererErreur
	
	Dim na As NotesAgent
		
	' Initialisations
	Print "Début - A_ANSImed"
	Call A_Initialisations
	
	Set na = gndb_A.GetAgent("A_ANSeq")	
	
	Call na.Runonserver
	
	Print "Fin - A_ANSImed"
		
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_A, gc_Element_A, GetThreadInfo(1), "", False)
	Exit Sub	
End Sub

</lotusscript></code><code event="A_Initialisations"><lotusscript>Sub A_Initialisations
	If gns_A Is Nothing Then
		Set gns_A = New NotesSession
		Set gndb_A = gns_A.Currentdatabase
	End If
End Sub</lotusscript></code>
