<documentset type="modified"/><code event="options"><lotusscript>Option Public
Use "SI_Extractions"
Use "SI_GestionErreurs"
Use "x_SDSC3"
Use "SI_Temp"

</lotusscript></code><code event="declarations"><lotusscript>Dim gns_A As NotesSession
Dim gndb_A As NotesDatabase

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_A = "A"
Const gc_Element_A = "A_StatSDSPC"

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
' ================================================================================
' L'agent maj. le statut de la proposition dans SDS Commissions
' Cette agent traite les demande de changement de statut commission fait à partir
' d'une réplique local
' ================================================================================
	On Error GoTo GererErreur
	
	Dim ndc As NotesDocumentCollection
	Dim nd_Prop As NotesDocument
	Dim nd_Suivant As NotesDocument
	
	Dim v_Formule As String
	
	Dim v_NbLus As Long
	Dim v_NbMaj As Long
	
	' Initialisation
	Call A_Initialisations
	
	Print "Début"
	
	v_Formule = |Form = "F_StatSDSPC"|
	Set ndc = gndb_A.Search(v_Formule, Nothing, 0)
	
	If ndc.Count = 0 Then
		Exit Sub
	End If
	
	
	Set nd_Suivant = ndc.GetFirstDocument
	
	Do Until nd_Suivant Is Nothing
		Set nd_Prop = nd_Suivant
		Set nd_Suivant = ndc.Getnextdocument(nd_Suivant)
		v_NbLus = v_NbLus + 1
		
		Call xSDSC3_Initialisation	
		
		Set nd_Temp = SITp_ndTemp("SDSC3.SDSC_ChangerStatut")
				
		nd_Temp.Form =  xVar(nd_Prop, "Form","")
		nd_Temp.Prop_NoProposition = xVar(nd_Prop, "Prop_NoProposition","")
		nd_Temp.Prop_Statut = xVar(nd_Prop, "Prop_Statut","") 
		nd_Temp.Prop_Commentaire = xVar(nd_Prop, "Prop_Commentaire","") 
		nd_Temp.Prop_UserName = xVar(nd_Prop, "Prop_UserName","") 

		Call nd_Temp.Save(True, False)
		
		Set na = gndb_xSDSC3.GetAgent("A_PropStat")
		Call na.run(nd_Temp.Noteid)
		
		v_NbMaj = v_NbMaj + 1
		Call nd_Prop.Remove(True)
						
	Loop
	
	Print "Fin " &amp; CStr(v_NbMaj) &amp; "/" &amp; CStr(v_NbLus) &amp; " changement de statut commissions effectués"	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_A, gc_Element_A, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="A_Initialisations"><lotusscript>Sub A_Initialisations
	If gns_A Is Nothing Then
		Set gns_A = New NotesSession
		Set gndb_A = gns_A.CurrentDatabase
	End If
End Sub</lotusscript></code>
