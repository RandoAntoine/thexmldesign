<trigger type="actionsmenu"/>
<documentset type="selected"/><code event="options"><lotusscript>Option Public
Option Explicit
Use "SI_NotesDocument"
Use "SL_Clipboard"


</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	On Error Goto GererErreur
	
	Dim nuiws As New NotesUIWorkspace
	Dim ns As New NotesSession
	Dim ndb As NotesDatabase
	Dim ndc As NotesDocumentCollection
	Dim nd As NotesDocument
	Dim v_URL As String
	
	Set ndb = ns.Currentdatabase
	Set ndc = ndb.UnprocessedDocuments
	If ndc.Count = 0 Then
		Print "Aucun document sélectionné."
		Exit Sub
	ElseIf ndc.Count &gt; 1 Then
		Print "Un seul document doit être sélectionné."
		Exit Sub
	End If

	Set nd = ndc.GetFirstDocument
	v_URL = SIND_NotesURL(nd)
	If v_URL = "" Then
		Print "Aucun document sélectionné."
		Exit Sub
	End If
	
	Call SLCl_AssignerTexteClipBoard(v_URL)
	
	Call nuiws.CurrentView.DeselectAll
	Print "L'URL du document a été copié dans le clipboard."
	Exit Sub
	
GererErreur:
	Call nuiws.Prompt(PROMPT_OK, GetThreadInfo(1), "Erreur " &amp; Cstr(Err()) &amp; " à la ligne " &amp; Cstr(Erl()) &amp; ": " &amp; Error())
	Exit Sub
End Sub</lotusscript></code>
