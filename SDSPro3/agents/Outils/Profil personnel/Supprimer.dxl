<trigger type="actionsmenu"/>
<documentset type="runonce"/><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Arrays"
Use "SI_Extractions"

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	Dim ns As New Notessession
	Dim ndb As Notesdatabase
	Dim nnc As NotesNoteCollection
	
	Dim v_Roles As Variant
	Dim v_NotesID As String
	Dim nd As Notesdocument
	Dim v_NbProfil As Long
	Dim v_aCle() As String
	Dim v_Continue As Integer
	
	Dim v_Selection As Variant
	Dim nuiws As New Notesuiworkspace
	
	' Doit avoir le rôle Admin pour utiliser cette action
	v_Roles = Evaluate(|@IsMember("[Admin]"; @UserRoles)|)
	If v_Roles(0) &lt;&gt; 1 Then
		Messagebox "Vous n'êtes pas autorisé à utiliser cette action.", 16, "Opération annulée"
		Exit Sub
	End If
	
	' Extraire les documents de profil
	Set ndb = ns.Currentdatabase
	Set nnc = ndb.CreateNoteCollection(False)
	nnc.SelectProfiles = True
	Call nnc.BuildCollection
	
	' Bâtir la liste des documents de profil
	v_NbProfil = -1
	v_NotesID = nnc.GetFirstNoteId
	Do Until v_NotesID = ""
		Set nd = ndb.GetDocumentByID(v_NotesID)
		v_NbProfil = v_NbProfil + 1
		Redim Preserve v_aCle(v_NbProfil) As String
		v_aCle(v_NbProfil) = xVar(nd, "$NAME", "") &amp; ":" &amp; v_NotesID
		v_Continue = True
		
		v_NotesID = nnc.GetNextNoteId(v_NotesID)
	Loop
	
	If v_Continue Then
		Call TrierArray(v_aCle)
		' Demander à l'utilisateur de sélectionner le profil à supprimer
		v_Selection = nuiws.Prompt(PROMPT_OKCANCELLIST, "Suppression d'un profil", _
		"Sélectionnez le document de profil à supprimer.", "", v_aCle)
		If v_Selection &lt;&gt; "" Then
			' Supprimer le document de profil
			v_NotesID = Strrightback(v_Selection, ":")
			Set nd = ndb.GetDocumentByID(v_NotesID)
			Call nd.Remove(True)
		End If
	Else
		Messagebox "Il n'y a aucun document de profil dans la base de documents.", 16, _
		"Opération annulée"
	End If
End Sub</lotusscript></code>
