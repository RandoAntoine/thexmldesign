<documentset type="modified"/><code event="options"><lotusscript>Option Public
Option Explicit
Use "SI_Extractions"
Use "SI_GestionErreurs"

</lotusscript></code><code event="declarations"><lotusscript>Dim gns_A As NotesSession
Dim gndb_A As NotesDatabase

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_A = "A"
Const gc_Element_A = "A_SuppDoc"

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	' ---------------------------------------------------
	' Cet agent supprime les documents temporaire
	' ---------------------------------------------------
	On Error Goto GererErreur
	
	Dim ndc As NotesDocumentCollection 
	Dim a_NomFormulaires As Variant
	Dim i As Integer
	Dim l_NbFormulairesSupr List As Integer
	Dim v_Log As String
	Dim v_NomFormulaire As String
			
	Call A_Initialisations

	Print "Début agent A_SuppDoc"
	Call SIGE_OuvrirLog(gc_TypeElement_A, gc_Element_A)
	
	a_NomFormulaires = Evaluate(|"F_PNav" : "F_PNav0.00" : "Memo" : "HTMLForm" : "DB_PropSg" : "DB_SIHi"|)
	
	For i = LBound(a_NomFormulaires) To UBound(a_NomFormulaires)
		v_NomFormulaire = a_NomFormulaires(i)
		
		If v_NomFormulaire = "Memo" Then
			Set ndc = gndb_A.Search(|Form = "| &amp; v_NomFormulaire &amp; |" &amp; @IsNull(Memo_EnvoyerCourriel)|, Nothing, 0)
		Else
			Set ndc = gndb_A.Search(|Form = "| &amp; v_NomFormulaire &amp; |"|, Nothing, 0)
		End If
				
		If ndc.Count &gt; 0 Then			
		ndc.RemoveAll(True)
						
			If Not IsElement(l_NbFormulairesSupr(v_NomFormulaire)) Then
				l_NbFormulairesSupr(v_NomFormulaire) = ndc.Count				
			End If			
		End If
			
	Next
					
		ForAll Form In l_NbFormulairesSupr
			If v_Log = "" Then				
				If CInt(Form) &gt; 0 Then
					v_Log =  CStr(Form) &amp; "..." &amp; ListTag(Form)			
				End If
			Else
				If CInt(Form) &gt; 0 Then
					v_Log = v_Log &amp; " / " &amp; CStr(Form) &amp; "..." &amp; ListTag(Form)			
				End If				
			End If				
		End ForAll
		
	If v_Log = "" Then	
		Call SIGE_AjouterLog("Fin agent A_SuppDoc - 0 documents supprimés.", 0, 0, False)
		Call SIGE_EnregistrerLog
		Print "Fin agent A_SuppDoc - 0 documents supprimés."
	Else
		Call SIGE_AjouterLog("Fin agent A_SuppDoc - documents supprimés: " &amp; v_log, 0, 0, False)
		Call SIGE_EnregistrerLog
		Print "Fin agent A_SuppDoc - documents supprimés: " &amp; v_log
	End If	
	
				
	Exit Sub
	
GererErreur:
	Print "Agent A_SuppDoc - Erreur " &amp; CStr(Err()) &amp; " à la ligne " &amp; CStr(Erl()) &amp; ": " &amp; Error()
	Call SIGE_AjouterLog("Agent A_SuppDoc - Erreur " &amp; CStr(Err()) &amp; " à la ligne " &amp; CStr(Erl()) &amp; ": " &amp; Error(), Err, 115, False)
	Call SIGE_EnregistrerLog
	Exit Sub
End Sub

</lotusscript></code><code event="A_Initialisations"><lotusscript>Sub A_Initialisations
	If gns_A Is Nothing Then
		Set gns_A = New NotesSession
		Set gndb_A = gns_A.CurrentDatabase
	End If
End Sub
</lotusscript></code>
