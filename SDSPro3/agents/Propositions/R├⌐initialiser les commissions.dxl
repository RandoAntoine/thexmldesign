<designchange><datetime>20250319T073748,60-05</datetime></designchange>
<trigger type="actionsmenu"/>
<documentset type="selected"/><code event="options"><lotusscript>Option Public
Option Explicit
Use "SDSP_Proposition"

</lotusscript></code><code event="declarations"><lotusscript>
' Traitement des erreurs
' -------------------------------
Const gc_TypeElement_A = "A"
Const gc_Element_A = "A_RCom"

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	Print "Début"
	
	Dim ns As Notessession
	Dim ndb As Notesdatabase
	Dim ndc As Notesdocumentcollection
	Dim nd_Suivant As Notesdocument
	Dim nd As NotesDocument
	Dim v_NoRepresentant As String
	Dim nd_Rep As NotesDocument
	
	Dim v_NbLus As Long
	Dim v_NbMaj As Long
	
	' Doit avoir le rôle Admin pour utiliser cette action
	Dim v_Roles As Variant
	v_Roles = Evaluate(|@IsMember("[Admin]"; @UserRoles)|)
	If v_Roles(0) &lt;&gt; 1 Then
		Messagebox "Vous n'êtes pas autorisé à utiliser cette action.", 16, "Opération annulée"
		Exit Sub
	End If
	
	Set ns = New Notessession
	Set ndb = ns.Currentdatabase
	Set ndc = ndb.UnprocessedDocuments
	If ndc.Count = 0 Then
		Print "Aucun document sélectionné."
		Exit sub
	End If
	
	Call xSIRR_Initialisations
	Call SDSPP_Initialisations
	Call SIGE_OuvrirLog("A", "Outils\Réinituialiser la sécurité")
	Call SIGE_AjouterLog(CStr(ndc.Count) &amp; " documents sélectionnés.", 0, 0, False)
	
	Set nd_Suivant = ndc.Getfirstdocument
	Do Until nd_Suivant Is Nothing
		Set nd = nd_Suivant
		Set nd_Suivant = ndc.Getnextdocument(nd_Suivant)
		v_NbLus = v_NbLus + 1
		
		'***** Insérer les instructions de correction içi *****
		If Left(xVar(nd, "Form", ""), 6) = "F_Prop" Then
			v_NoRepresentant = xVar(nd, "Prop_NoRepresentant", "")
			Set nd_Rep = xSIRR_xndRepr(v_NoRepresentant, True)
			If nd_Rep Is Nothing Then
				Call SIGE_AjouterLog("Erreur: Proposition " &amp; CStr(xVar(nd, "Prop_NbProposition", "")) &amp; " pas mise à jour.", 1, 0, False)
			Else
				If SDSPP_AssignerCommissions(nd) = 1 Then
					Call nd.Save(True, False)
					v_NbMaj = v_NbMaj + 1
					Call SIGE_AjouterLog("Proposition " &amp; CStr(xVar(nd, "Prop_NbProposition", "")) &amp; " mise à jour.", 0, 0, False)
				End If
			End If
		End If
		
		If (v_NbLus Mod 1000) = 0 Then
			Print Cstr(v_NbMaj) &amp; "/" &amp; Cstr(v_NbLus)
		End If
	Loop
	
	Call SIGE_AjouterLog("Fin " &amp; CStr(v_NbMaj) &amp; "/" &amp; CStr(v_NbLus), 0, 0, True)
	If v_NbMaj &gt; 0 Then
		Call SIGE_EnregistrerLog
	End If
End Sub</lotusscript></code>
