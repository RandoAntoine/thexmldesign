<designchange><datetime>20250319T073748,78-05</datetime></designchange>
<trigger type="actionsmenu"/>
<documentset type="selected"/><code event="options"><lotusscript>Option Public
Option Declare
Use "SDSP_Salesforce"


</lotusscript></code><code event="declarations"><lotusscript>
' Traitement des erreurs
Const gc_TypeElement_A = "A"
Const gc_Element_A = "A_SFSO1"


</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize
	On Error GoTo GererErreur
	
	Dim v_NomProfilAPI As String
	Dim cl_ConnexionAPI As SLSf_clConnexionAPI
	Dim v_Resultat As Integer
	Dim ns As New NotesSession
	Dim ndb As NotesDatabase
	Dim ndc As NotesDocumentCollection
	Dim nd_Prop As NotesDocument
	Dim v_NoProposition As String
	Dim v_NoOpportunite As String
	Dim l_NoOpportunite List As String
	
	Dim v_NbLus As Long
	Dim v_NbMaj As Long
	Dim v_NbErr As Long
	
	Set ndb = ns.Currentdatabase
	Set ndc = ndb.UnprocessedDocuments
	If ndc.Count = 0 Then
		Print "Aucun document sélectionné"
		Exit Sub
	ElseIf ndc.Count &gt; 1 Then
		Print "Un seul document doit être sélectionné"
		Exit Sub
	End If
	
	Call SIGE_OuvrirLog(gc_TypeElement_A, gc_Element_A)
	Print gc_Element_SLSf &amp; " - Début"
	g_LogAPI_SLSf = 1
	
	v_NomProfilAPI = SDSPSf_NomProfilSalesforceAPI
	If v_NomProfilAPI = "" Then
		Call SIGE_AjouterLog(|Erreur | &amp; CStr(v_Resultat) &amp; |: Le profil Salesforce n'est pas défini dans les paramètres de l'application."|, 1, 0, False)
		GoTo FinSub
	End If
	
	Set cl_ConnexionAPI = New SLSf_clConnexionAPI(v_NomProfilAPI)
	If cl_ConnexionAPI.Resultat &lt;&gt; 1 Then
		Call SIGE_AjouterLog(|Erreur | &amp; CStr(v_Resultat) &amp; |: Une erreur s'est produite lors de l'établissement de la connexion avec Salesforce.|, 1, 0, False)
		GoTo FinSub
	End If

	' Extraire la liste des propositions actives avec un no d'opportunité
	Set nd_Prop = ndc.Getfirstdocument
	Do Until nd_Prop Is Nothing
		v_NbLus = v_NbLus + 1
		
		v_NoProposition = xVar2(nd_Prop, "Prop_NbPropositionTXT", "Prop_NoProposition", "")
		v_NoOpportunite = xVar(nd_Prop, "Prop_NoOpportuniteSF", "")
		If v_NoOpportunite = "" Then
			Call SIGE_AjouterLog(|Erreur: La proposition | &amp; v_NoProposition &amp; | n'est lié à aucune opportunité.|, 1, 0, False)
			v_NbErr = v_NbErr + 1
		Else			
			
			' Vérifier s'il y a des doublons dans les no d'opportunité
			If IsElement(l_NoOpportunite(v_NoOpportunite)) Then
				Call SIGE_AjouterLog(|Erreur: L'opportunité | &amp; v_NoOpportunite &amp; | a déjà été synchronisée avec la proposition | &amp; l_NoOpportunite(v_NoOpportunite) &amp; _
				|. La proposition | &amp; v_NoProposition &amp; | est un doublon.|, 1, 0, False)
			Else
				l_NoOpportunite(v_NoOpportunite) = 	v_NoProposition

				v_Resultat = SDSPSf_MajOpportunite(nd_Prop, cl_ConnexionAPI)
				If v_Resultat &lt; 0 Then
					Call SIGE_AjouterLog(|Erreur | &amp; CStr(v_Resultat) &amp; |: Une erreur s'est produite lors de la synchronisation de la proposition | &amp; _
					| avec l'opportunité | &amp; v_NoOpportunite &amp; |.|, 1, 0, False)
					v_NbErr = v_NbErr + 1
				ElseIf v_Resultat &gt; 0 Then
					v_NbMaj = v_NbMaj + 1
				End If
			End If
		End If
		
		If (v_NbLus Mod 1000) = 0 Then
			Print gc_Element_SLSf &amp; " " &amp; CStr(v_NbMaj) &amp; |/| &amp; CStr(v_NbLus) &amp; | - Nb erreurs = | &amp; CStr(v_NbErr)
		End If
		
		Set nd_Prop = ndc.GetNextDocument(nd_Prop)
	Loop

	Call SIGE_AjouterLog(gc_Element_SLSf &amp; " - Fin " &amp; CStr(v_NbMaj) &amp; |/| &amp; CStr(v_NbLus) &amp; | - Nb erreurs = | &amp; CStr(v_NbErr), 0, 0, True)
	
FinSub:
	Call SIGE_EnregistrerLog
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SLSf, gc_Element_SLSf, GetThreadInfo(1), "", False)
	Exit Sub
End Sub</lotusscript></code>
