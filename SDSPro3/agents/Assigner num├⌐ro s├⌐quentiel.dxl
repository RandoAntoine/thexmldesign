<documentset type="all"/><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "SI_GestionErreurs"
Use "SI_CompteurSequentiel"
Use "SI_tNombre"
Use "SDSP_Proposition"

</lotusscript></code><code event="declarations"><lotusscript>Dim gns_A As notesSession
Dim gndb_A As notesDatabase

' Traitement des erreurs
' -----------------------------------
Const gc_TypeElement_A = "A"
Const gc_Element_A = "A_ANSeq"

</lotusscript></code><code event="initialize"><lotusscript>Sub Initialize	
'==============================================================================
' Le script assign le numéro séquentiel au propositions
'==============================================================================
	On Error Goto GererErreur
	
	Dim v_Formule As String
	Dim i As Integer
	Dim ndc As NotesDocumentCollection
	Dim nd_Suivant As Notesdocument	
	Dim nd As Notesdocument
	Dim v_NbProposition As Double
	
	Dim v_NbLus As Long
	Dim v_NbMaj As Long
	
	' Initialisations
	Print "Début"
	Call A_Initialisations
	
	v_Formule = {Form = "F_Prop" &amp; (@IsNull(Prop_NbPropositionTXT) | @Integer(Prop_NbProposition) &lt; 1)}
	Set ndc = gndb_A.Search(v_Formule, Nothing, 0)
	
	If ndc.Count = 0 Then
		Exit Sub
	End If
	
	'Call ndc.StampAll("Prop_NbProposition","") 'temp debug
	
 	' Boucler sur tous les candidats
	Set nd_Suivant = ndc.Getfirstdocument
	Do Until nd_Suivant Is Nothing
		Set nd = nd_Suivant
		Set nd_Suivant = ndc.Getnextdocument(nd_Suivant)
		v_NbLus = v_NbLus + 1		
		
		If Not nd.HasItem("$Conflict") Then	
			
		' Assignation du numéro de requête
			'If xVar(nd, "Prop_NbProposition", 0) = 0 Then
			
			%REM
			v_NbProposition = SICS_ValeurSuivante("Proposition")			
			If xVar(nd, "Prop_NbFoisReOuvert", 0) &gt; 0 Then
				nd.Prop_NbPropositionTXT = Replace(Cstr(xEvaluate(|@Text(|&amp; (v_NbProposition + (xVar(nd, "Prop_NbFoisReOuvert", 0)/100)) &amp; |; "F2")|, nd)), ",", ".")
			Else
				nd.Prop_NbPropositionTXT = Replace(Cstr(xEvaluate(|@Text(|&amp; v_NbProposition &amp; |; "F2")|, nd)), ",", ".")
			End If			
			nd.Prop_NbProposition = SItN_cdbl(xVar(nd, "Prop_NbPropositionTXT", "")) 			
			nd.Prop_NbPropositionPrefixe = "C"
			nd.Prop_NbPropositionFmt = xVar(nd, "NbPropositionPrefixe", "") &amp; Format(v_NbProposition, "000000")
			Call nd.save(True, False)
			%END REM
			
			If SDSPP_AssignerNbProposition(nd) Then
				Call nd.Save(True, False)	
				v_NbMaj = v_NbMaj + 1
			End If
						
			'End If
			
			If (v_NbLus Mod 1000) = 0 Then
				Print Cstr(v_NbMaj) &amp; "/" &amp; Cstr(v_NbLus)
			End If
			
		End If		
		
	Loop
	
	Print "Fin " &amp; Cstr(v_NbMaj) &amp; "/" &amp; Cstr(v_NbLus)
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_A, gc_Element_A, Getthreadinfo(1), "", False)
	Exit Sub
	
End Sub

</lotusscript></code><code event="A_Initialisations"><lotusscript>Sub A_Initialisations
	If gns_A Is Nothing Then
		Set gns_A = New Notessession
		Set gndb_A = gns_A.Currentdatabase
	End If
End Sub</lotusscript></code>
