ement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>' Sites
Option Public
Option Declare
Use "wsc_SDSP3"
Use "SDSP_MasquePNav"
Use "SDSP_Navigation"


</lotusscript></code><code event="declarations"><lotusscript>
Dim g_PosSite As Integer

Const gc_MaxNbSites = 40

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_FPNav = "SL"
Const gc_Element_FPNav = "F_PNav0.01"


</lotusscript></code><code event="FPNav_hsNomSiteNonModifiable"><lotusscript>Function FPNav_hsNomSiteNonModifiable(p_PosSite As String)
	' -------------------------------------------
	' Le script permet de modifier le nom du site
	' -------------------------------------------
	On Error Goto GererErreur
	
	' Rendre le prix non modifiable
	Call gnd_SDSPM.ReplaceItemValue("PNav_NomSiteModifie" &amp; p_PosSite, "0")
	Call gnd_SDSPM.ReplaceItemValue("PNav_NomSite" &amp; p_PosSite, xVar(gnd_SDSPM, "PNav_NomSiteListe" &amp; p_PosSite, ""))
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPN.Refresh
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_hsNomSiteModifiable"><lotusscript>Function FPNav_hsNomSiteModifiable(p_PosSite As String)
	' -------------------------------------------
	' Le script permet de modifier le nom du site
	' -------------------------------------------
	On Error Goto GererErreur
	
	' Rendre le prix non modifiable
	Call gnd_SDSPM.ReplaceItemValue( "PNav_NomSiteModifie" &amp; p_PosSite, "1")
	Call gnd_SDSPM.ReplaceItemValue( "PNav_NomSiteListe" &amp; p_PosSite, xVar(gnd_SDSPM, "PNav_NomSite" &amp; p_PosSite, ""))
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPN.Refresh
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_DocumentValide"><lotusscript>Function FPNav_DocumentValide(p_AfficherErreur As Boolean) As Boolean
	On Error Goto GererErreur
	
	Dim v_NbSites As Integer
	Dim i As Integer
	
	FPNav_DocumentValide = False
		
	If xVar(gnd_SDSPM, "Prop_DescProposition", "") = "" Then
		If p_AfficherErreur Then
			MessageBox xGDK_xMessage("SI", 23, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
			Call gnuid_SDSPN.GotoField("Prop_DescProposition")
		End If
		Exit Function
	End If
			
	v_NbSites = xVar(gnd_SDSPM, "Prop_NbSites", 0)
	
	' Valider qu'il y au plus qu'un site sur la proposition
	If v_NbSites &lt; 1 Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SDSPP", 88, "", ""), 16, xGDK_xMessage("SI", 1, "", "") &amp; " (2)"
			Call gnd_SDSPM.ReplaceItemValue("PNav_Erreur" &amp; Format(i, "000"), "1")
		End If
		Exit Function
	End If
	i = 2
	
	For i = 1 To v_NbSites
		
		Call gnd_SDSPM.ReplaceItemValue("PNav_Erreur" &amp; Format(i, "000"), "")
		
		If xVar(gnd_SDSPM, "PNav_NomSite" &amp; Format(i, "000"), "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SDSPP", 18, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (3)"
				Call gnd_SDSPM.ReplaceItemValue("PNav_Erreur" &amp; Format(i, "000"), "1")
				Call gnuid_SDSPN.GotoField("PNav_NomSite" &amp; Format(i, "000"))
			End If
			Exit Function
		End If
		
		' Nouveau client
		If xVar(gnd_SDSPM, "Prop_TypeProposition", "") = "0" Then
			
			If xVar(gnd_SDSPM, "PNav_ClientSDSWIN" &amp; Format(i, "000"), "") = "" And xVar(gnd_SDSPM, "PNav_ClientMerlin" &amp; Format(i, "000"), "") = "" Then
				If xVar(gnd_SDSPM, "PNav_SDS" &amp; Format(i, "000"), "") = "" And xVar(gnd_SDSPM, "PNav_SDSM" &amp; Format(i, "000"), "") = "" Then
					If p_AfficherErreur Then
						Messagebox xGDK_xMessage("SDSPP", 87, "", xVar(gnd_SDSPM, "PNav_NomSite" &amp; Format(i, "000"), "")), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (4)"
						Call gnd_SDSPM.ReplaceItemValue("PNav_Erreur" &amp; Format(i, "000"), "1")
					End If
					Exit Function
				End If
			End If
			
			If xVar(gnd_SDSPM, "PNav_ClientSDSWIN" &amp; Format(i, "000"), "") = "" And xVar(gnd_SDSPM, "PNav_ClientMerlin" &amp; Format(i, "000"), "") &lt;&gt; "" Then
				If xVar(gnd_SDSPM, "PNav_SDS" &amp; Format(i, "000"), "") = "" Then
					If p_AfficherErreur Then
						Messagebox xGDK_xMessage("SDSPP", 89, "", xVar(gnd_SDSPM, "PNav_NomSite" &amp; Format(i, "000"), "")), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (5)"
						Call gnd_SDSPM.ReplaceItemValue("PNav_Erreur" &amp; Format(i, "000"), "1")
					End If
					Exit Function
				End If
			End If
			
			If xVar(gnd_SDSPM, "PNav_SDSM" &amp; Format(i, "000"), "") &lt;&gt; "" And xVar(gnd_SDSPM, "PNav_VersionMerlin" &amp; Format(i, "000"), "") = "" Then
				If p_AfficherErreur Then
					Messagebox xGDK_xMessage("SDSPP", 93, "", xVar(gnd_SDSPM, "PNav_NomSite" &amp; Format(i, "000"), "")), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (6)"
					Call gnd_SDSPM.ReplaceItemValue("PNav_Erreur" &amp; Format(i, "000"), "1")
				End If
				Exit Function
			End If
			
		End If
		
		' Site additionel
		If xVar(gnd_SDSPM, "Prop_TypeProposition", "") = "1" Then
			
			If xVar(gnd_SDSPM, "PNav_ClientSDSWIN" &amp; Format(i, "000"), "") = "" And xVar(gnd_SDSPM, "PNav_ClientMerlin" &amp; Format(i, "000"), "") = "" Then
				If xVar(gnd_SDSPM, "PNav_SDS" &amp; Format(i, "000"), "") = "" And xVar(gnd_SDSPM, "PNav_SDSM" &amp; Format(i, "000"), "") = "" Then
					If p_AfficherErreur Then
						Messagebox xGDK_xMessage("SDSPP", 87, "", xVar(gnd_SDSPM, "PNav_NomSite" &amp; Format(i, "000"), "")), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (7)"
						Call gnd_SDSPM.ReplaceItemValue("PNav_Erreur" &amp; Format(i, "000"), "1")
					End If
					Exit Function
				End If
			End If
			
			If xVar(gnd_SDSPM, "PNav_SDSM" &amp; Format(i, "000"), "") &lt;&gt; "" And xVar(gnd_SDSPM, "PNav_VersionMerlin" &amp; Format(i, "000"), "") = "" Then
				If p_AfficherErreur Then
					Messagebox xGDK_xMessage("SDSPP", 93, "", xVar(gnd_SDSPM, "PNav_NomSite" &amp; Format(i, "000"), "")), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (8)"
					Call gnd_SDSPM.ReplaceItemValue("PNav_Erreur" &amp; Format(i, "000"), "1")
				End If
				Exit Function
			End If
			
		End If
		
		If xVar(gnd_SDSPM, "Prop_TypeProposition", "") &lt; "2" And xVarElem(gnd_SDSPM, "PNav_NoSite", (i -1), "") &lt;&gt; xVar(gnd_SDSPM, "Prop_NoSitePrincipal", "") Then
			
			If xVar(gnd_SDSPM, "PNav_Distance" &amp; Format(i, "000"), "") = "" Then
				If p_AfficherErreur Then
					Messagebox xGDK_xMessage("SDSPP", 18, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (9)"
					Call gnd_SDSPM.ReplaceItemValue("PNav_Erreur" &amp; Format(i, "000"), "1")
					Call gnuid_SDSPN.GotoField("PNav_Distance" &amp; Format(i, "000"))
				End If
				Exit Function
			End If
			
			If xVar(gnd_SDSPM, "PNav_Comm" &amp; Format(i, "000"), "") = "" Then
				If p_AfficherErreur Then
					Messagebox xGDK_xMessage("SDSPP", 18, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (10)"
					Call gnd_SDSPM.ReplaceItemValue("PNav_Erreur" &amp; Format(i, "000"), "1")
					Call gnuid_SDSPN.GotoField("PNav_Comm" &amp; Format(i, "000"))
				End If
				Exit Function
			End If
			
		End If
		
	Next
	
	
	FPNav_DocumentValide = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
	
End Function

</lotusscript></code><code event="FPNav_acImage"><lotusscript>Sub FPNav_acImage
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument("") Then
		Exit Sub
	End If
	
	Call SDSPM_acImage(gnd_Prop_SDSPM)
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

