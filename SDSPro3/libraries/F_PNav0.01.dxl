</lotusscript></code><code event="FPNav_hsSitePrincipal"><lotusscript>Sub FPNav_hsSitePrincipal(p_PosSite As String)
	' -----------------------------------------------
	' Le script permet d'identifier le site principal
	' -----------------------------------------------
	On Error Goto GererErreur
	
	Dim v_NoSitePrincipal As String
	Dim a_NoSite As Variant
	Dim v_PosSite As Variant
	Dim v_DistanceSite As String
	Dim v_CommSite As String
	
	a_NoSite = xVarArray(gnd_SDSPM, "PNav_NoSite")
	
	' Extraire info du site principal courrant
	v_NoSitePrincipal = xVar(gnd_SDSPM, "Prop_NoSitePrincipal", "")
	v_PosSite = ArrayGetIndex(a_NoSite, v_NoSitePrincipal)
	
	If Not IsNull(v_PosSite) Then
		
		v_DistanceSite = xVar(gnd_SDSPM, "PNav_Distance" &amp; Format((v_PosSite + 1),"000"), "")
		v_CommSite = xVar(gnd_SDSPM, "PNav_Comm" &amp; Format((v_PosSite + 1),"000"), "")
		
		If v_DistanceSite = "" Then
			Call gnd_SDSPM.ReplaceItemValue("PNav_Distance" &amp; Format((v_PosSite + 1),"000"), xVar(gnd_SDSPM, "PNav_Distance" &amp; p_PosSite, ""))
		End If
		If v_CommSite = "" Then
			Call gnd_SDSPM.ReplaceItemValue("PNav_Comm" &amp; Format((v_PosSite + 1),"000"), xVar(gnd_SDSPM, "PNav_Comm" &amp; p_PosSite, ""))
		End If
		
	End If
	
	Call gnd_SDSPM.ReplaceItemValue("Prop_NoSitePrincipal", xVarElem(gnd_SDSPM, "PNav_NoSite", (Cint(p_PosSite) -1), ""))
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_QueryOpen"><lotusscript>Sub FPNav_QueryOpen(pnuid_Source As Notesuidocument, p_Mode As Integer, p_Isnewdoc As Variant, _
p_Continue As Variant)
	On Error Goto GererErreur
	
	Dim nd_PNav As NotesDocument
	' Initialisations
	p_Continue = False
	
	Set nd_PNav = pnuid_Source.Document
	
	' Initialiser les champs du document de navigation
	If FPNav_DocumentExistant(nd_PNav) Then
		p_Continue = True
	End If
	' Effacer les champs RT des autres écrans
	If nd_PNav.Hasitem("Prop_DescDetaillee") Then
		Call nd_PNav.Removeitem("Prop_DescDetaillee")
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentExistant"><lotusscript>Function FPNav_DocumentExistant(pnd_PNav As NotesDocument) As Boolean
	On Error Goto GererErreur
	
	Dim nd_Site As NotesDocument
	
	Dim a_NoSite As Variant
	Dim v_PosSite As Integer
	Dim v_Serveur As String
	Dim v_Max As Integer
	Dim i As Variant
	Dim v_NomSite As String
	
	FPNav_DocumentExistant = False
	v_Max = 1
	
	' Extraire la proposition
	If Not SDSPM_InitProp(xVar(pnd_PNav, "Prop_NoProposition", "")) Then
		Exit Function
	End If
	
	pnd_PNav.Prop_Statut = xVar(gnd_Prop_SDSPM, "Prop_Statut", "10")
	Call pnd_PNav.ReplaceItemValue("Prop_StatutDesc" &amp; xLangue, _
	xVar(gnd_Prop_SDSPM, "Prop_StatutDesc" &amp; xLangue, ""))
		
	
	' Mettre à jour le document de navigation
	If xVar(pnd_PNav, "Prop_NbSites", 0) &gt; 0 Then
		a_NoSite = xVarArray(pnd_PNav, "PNav_NoSite")
		
		For v_PosSite = Lbound(a_NoSite) To Ubound(a_NoSite)
			' Extraire le site
			Set nd_Site = xSDSP3_xndSite(a_NoSite(v_PosSite), True)
			If nd_Site Is Nothing Then
				Messagebox xGDK_xMessage("SDSPP", 12, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
				Exit Function
			End If
			
			v_NomSite = xVar2(nd_Site, "Site_NomSiteAbrege", "Site_ClientNomInterne", "")
			
			Call pnd_PNav.ReplaceItemValue("PNav_NomSite" &amp; Format((v_PosSite + 1),"000"), _
			v_NomSite)
			Call pnd_PNav.ReplaceItemValue("PNav_VilleSite" &amp; Format((v_PosSite + 1),"000"), _
			xVar(nd_Site, "Site_ClientVille", ""))
			
			Call pnd_PNav.ReplaceItemValue("PNav_SiteClientNoFmt" &amp; Format((v_PosSite + 1),"000"), _
			xVar(nd_Site, "Site_ClientNoFmt", ""))
			
			Call pnd_PNav.ReplaceItemValue("PNav_SiteNoBonCommandeFmt" &amp; Format((v_PosSite + 1),"000"), _
			xVar(nd_Site, "Site_NoBonCommandeFmtSIBDC", ""))
			
			Call pnd_PNav.ReplaceItemValue("PNav_NomSiteModifie" &amp; Format((v_PosSite + 1),"000"), _
			xVar(nd_Site, "Site_NomSiteAbregeModifie", "0"))
						
			Call pnd_PNav.ReplaceItemValue("PNav_NomSiteListe" &amp; Format((v_PosSite + 1),"000"), _
			xVar(nd_Site, "Site_NomSiteAbregeListe", ""))
			
			If xVar(nd_Site, "Site_AjouterSDS", "") &lt;&gt; "" Then
				Call pnd_PNav.ReplaceItemValue("PNav_SDS" &amp; Format((v_PosSite + 1),"000"), Format((v_PosSite + 1),"000"))
			Else
				Call pnd_PNav.ReplaceItemValue("PNav_SDS" &amp; Format((v_PosSite + 1),"000"), "")
			End If
			
			If xVar(nd_Site, "Site_AjouterSDSM", "") &lt;&gt; "" Then
				Call pnd_PNav.ReplaceItemValue("PNav_SDSM" &amp; Format((v_PosSite + 1),"000"), Format((v_PosSite + 1),"000"))
			Else
				Call pnd_PNav.ReplaceItemValue("PNav_SDSM" &amp; Format((v_PosSite + 1),"000"), "")
			End If
			
			Call pnd_PNav.ReplaceItemValue("PNav_ClientSDSWIN" &amp; Format((v_PosSite + 1),"000"), _
			xVar(nd_Site, "Site_ClientSDSWIN", ""))
			
			Call pnd_PNav.ReplaceItemValue("PNav_ClientMerlin" &amp; Format((v_PosSite + 1),"000"), _
			xVar(nd_Site, "Site_ClientMerlin", ""))
			
			Call pnd_PNav.ReplaceItemValue("PNav_VersionMerlin" &amp; Format((v_PosSite + 1),"000"), _
			xVar(nd_Site, "Site_VersionMerlin", ""))
			
			Call pnd_PNav.ReplaceItemValue("PNav_Distance" &amp; Format((v_PosSite + 1),"000"), _
			xVar(nd_Site, "Site_Distance", ""))
			Call pnd_PNav.ReplaceItemValue("PNav_Comm" &amp; Format((v_PosSite + 1),"000"), _
			xVar(nd_Site, "Site_Comm", ""))
			
		Next
		
		v_Max = Ubound(a_NoSite) + 2
	End If
	
	For v_PosSite = v_Max To gc_MaxNbSites
		Call pnd_PNav.ReplaceItemValue("PNav_NomSite" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_VilleSite" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_SiteClientNoFmt" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_SiteNoBonCommandeFmt" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_NomSiteModifie" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_NomSiteListe" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_SDS" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_ClientSDSWIN" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_SDSM" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_ClientMerlin" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_VersionMerlin" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_Distance" &amp; Format(v_PosSite,"000"), "")
		Call pnd_PNav.ReplaceItemValue("PNav_Comm" &amp; Format(v_PosSite,"000"), "")
	Next
	
	pnd_PNav.Prop_PropositionImprimee = xVar(gnd_Prop_SDSPM, "Prop_PropositionImprimee", "")
	pnd_PNav.Prop_NoSitePrincipal = xVar(gnd_Prop_SDSPM, "Prop_NoSitePrincipal", "")
		
	Call pnd_PNav.ReplaceItemValue("Prop_OrigineSiegeSocial", xVar(gnd_Prop_SDSPM, "Prop_OrigineSiegeSocial", ""))
	Call pnd_PNav.ReplaceItemValue("Prop_ClientNoFmtSiegeSocial", xVar(gnd_Prop_SDSPM, "Prop_ClientNoFmtSiegeSocial", ""))
	Call pnd_PNav.ReplaceItemValue("Prop_ClientNoFmtSiegeSocialSF", xVar(gnd_Prop_SDSPM, "Prop_ClientNoFmtSiegeSocialSF", ""))
	Call pnd_PNav.ReplaceItemValue("Prop_ClientNom1SiegeSocial", xVar(gnd_Prop_SDSPM, "Prop_ClientNom1SiegeSocial", ""))
	Call pnd_PNav.ReplaceItemValue("Prop_ClientNom2SiegeSocial", xVar(gnd_Prop_SDSPM, "Prop_ClientNom2SiegeSocial", ""))
	Call pnd_PNav.ReplaceItemValue("Prop_ClientNomIntSiegeSocial", xVar(gnd_Prop_SDSPM, "Prop_ClientNomIntSiegeSocial", ""))
	
	pnd_PNav.Prop_NotesContrat = xVar(gnd_Prop_SDSPM, "Prop_NotesContrat", "")
	
	FPNav_DocumentExistant = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Function
End Function
</lotusscript></code>
<item name="$POID"><datetime>20250319T073729,79-05</datetime></item></scriptlibrary>

