</lotusscript></code><code event="FPNav_acWorkflow"><lotusscript>Sub FPNav_acWorkflow(p_Statut As String)
	On Error GoTo GererErreur
		
	If SDSPM_acWorkflow(p_Statut) Then
		
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		Call gnuiws_SDSPM.ViewRefresh
		
		' Ouvrir le masque	
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		
		gnd_SDSPM.PNav_Titre =  Trim("C" &amp; CStr(xVar(gnd_Prop_SDSPM, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(gnd_Prop_SDSPM, "Prop_ClientNomInterne", xVar(gnd_Prop_SDSPM, "Prop_ClientNom", "")))
		gnd_SDSPM.Titre =  Trim(xVar(gnd_SDSPM, "PNav_Titre", "") &amp; " - " &amp; xVar(gnd_SDSPM, "PNav_MenuDesc000", ""))
				
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbProposition", xVar(gnd_Prop_SDSPM, "Prop_NbProposition", 0))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionFmt", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionFmt", ""))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionPrefixe", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionPrefixe", ""))		
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
			
		Call gnuid_SDSPN.Refresh
	End If
		
	Exit Sub
		
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsSupprimerSite"><lotusscript>Sub FPNav_hsSupprimerSite(p_PosSite As String)
	On Error Goto GererErreur
	
	Dim v_NbSites As Integer
	Dim nd_Site As NotesDocument
	Dim i As Integer
	Dim v_NoSite As String
	Dim v_DernierSiteOuvert As Integer
	Dim v_MaxSiteOuvert As Integer
	Dim a_MenuItems As Variant
	Dim nv_Site21 As NotesView
	
	g_PosSite = Cint(p_PosSite)
	
	' Demander une confirmation
	If gnuiws_SDSPN.Prompt(PROMPT_YESNO, xGDK_xMessage("SDSPP", 16, "", ""), _
	xGDK_xMessage("SDSPP", 17, "", xVar(gnd_SDSPM, "PNav_NomSite" &amp; p_PosSite, ""))) &lt;&gt; 1 Then
		Print xGDK_xMessage("SI", 1, "", "")
		Exit Sub
	End If
	
	
	v_NbSites = xVar(gnd_SDSPM, "Prop_NbSites", 1)
	v_NoSite = xVarElem(gnd_SDSPM, "PNav_NoSite", Cint(p_PosSite) - 1, "")
	
%REM
	' Valider qu'il y a plus qu'un site sur la proposition
	If v_NbSites = 1 Then
		Messagebox xGDK_xMessage("SDSPP", 88, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Sub
	End If
%END REM
	
	' Sauvegarder
	If FPNav_SauvegarderDocument(False) Then
		
		' Extraire le site
		Set nd_Site = xSDSP3_xndSite(v_NoSite, True)
		If nd_Site Is Nothing Then
			Messagebox xGDK_xMessage("SDSPP", 12, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Sub
		End If
		
		' Supprimer le site
		
		' Si supression du dernier site
		If v_NbSites = 1 Then
			gnd_SDSPM.PNav_DernierSiteOuvert = 0
			gnd_SDSPM.PNav_MaxSiteOuvert = 0
			If Left(xVar(gnd_SDSPM, "PNav_MenuOptionMax", "") ,1) = "2" Then
				gnd_SDSPM.PNav_MenuOptionMax = "0.01"
			End If
		End If
		
		Call SDSPS_SupprimerSite(gnd_Prop_SDSPM, nd_Site, Getthreadinfo(1))
		
		Set nv_Site21 = gnd_SDSPM.ParentDatabase.GetView("V_Site21")
		Call nv_Site21.Refresh
		
		v_DernierSiteOuvert = xVar(gnd_SDSPM, "PNav_DernierSiteOuvert", 0)
		v_MaxSiteOuvert = xVar(gnd_SDSPM, "PNav_MaxSiteOuvert", 0)
		
		If v_DernierSiteOuvert &gt; 0 Then
			If Cint(p_PosSite) &lt;= v_DernierSiteOuvert Then
				gnd_SDSPM.PNav_DernierSiteOuvert = v_DernierSiteOuvert - 1
			End If
		End If
		
		If v_MaxSiteOuvert &gt; 0 Then
			If Cint(p_PosSite) &lt;= v_MaxSiteOuvert Then
				gnd_SDSPM.PNav_MaxSiteOuvert = v_MaxSiteOuvert - 1
			End If
		End If
		
		gnd_SDSPM.PNav_MenuOptionCourante = "0.01"
		
		Call SDSPN_MajSitesNav(gnd_SDSPM)
		
		' Mettre à jour le document courant
		Call FPNav_DocumentExistant(gnd_SDSPM)
		
		' Supression du site principal
		If v_NoSite = xVar(gnd_SDSPM, "Prop_NoSitePrincipal", "") Then
			gnd_SDSPM.Prop_NoSitePrincipal = xVarElem(gnd_SDSPM, "PNav_NoSite", 0, "")
		'Call gnd_SDSPM.ReplaceItemValue("PNav_Distance1", "")
		'Call gnd_SDSPM.ReplaceItemValue("PNav_Comm1" , "")
		End If
		
		Call gnuid_SDSPN.Refresh
		Call SDSPN_ConstruireMenu(gnd_SDSPM)
		
		' Ré-initialise PNav_MenuOptionMax
		a_MenuItems = xVarArray(gnd_SDSPM, "PNav_MenuItems")
		
		If v_NbSites &gt; 1 And Left(xVar(gnd_SDSPM, "PNav_MenuOptionMax",""),1) = "2" Then
			If Cint(p_PosSite) = v_NbSites Then
				gnd_SDSPM.PNav_MenuOptionMax = "2." &amp; Format(v_NbSites -2, "00") &amp; ".06"
			Else
				gnd_SDSPM.PNav_MenuOptionMax = "2." &amp; Format(v_NbSites -2, "00") &amp; "." &amp; StrRightBack(xVar(gnd_SDSPM, "PNav_MenuOptionMax",""), ".")
			End If
		End If
		
		' Call gnuid_SDSPN.Refresh
		Call gnuid_SDSPN.Save
		
	End If
	
	' Maj la proposition au besoin après supression du site
	If SDSPM_MajItem(gnd_Prop_SDSPM, "PNav_MaxSiteOuvert", "") Then
		Call gnd_Prop_SDSPM.Save(True, False)
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acSignerProposition"><lotusscript>Sub FPNav_acSignerProposition
	On Error Goto GererErreur
	
	If SDSPUI_acSignerProposition(gnd_Prop_SDSPM, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		
		Call gnuiws_SDSPM.ViewRefresh
		
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acRecalculerCouts"><lotusscript>Sub FPNav_acRecalculerCouts
