</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Mourad Zellouf/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Mourad Zellouf/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare

Use "SDSP_Document"
Use "SDSP_DocuSign"
Use "SDSP_OneSpanSign"
Use "SDSP_Produit"
Use "SI_Historique"
Use "SI_LettresTypes"
Use "SI_CourrielsTypes"
Use "SI_Signatures"
Use "SI_tDate"
Use "SI_MSPowerPoint"


</lotusscript></code><code event="declarations"><lotusscript>' Déclarations globales
' ---------------------
Dim gns_SDSI As NotesSession
Dim gndb_SDSI As NotesDatabase
Dim gnd_Prof_SDSI As NotesDocument
Dim gnuiws_SDSI As NotesUIWorkspace

' Variables globales liées à un contrat
' -------------------------------------
Dim g_Unique_SDSI As String
Dim g_NoProposition_SDSI As String
Dim g_NoRep_SDSI As String
Dim g_NbProposition_SDSI As String
Dim g_DossierTemp_SDSI As String
Dim g_LangueContrat_SDSI As String
Dim g_EscompteTotalLG_SDSI As Double
Dim g_EntretienTotalLG_SDSI As Double
Dim gl_MontantsSectionsLGSites_SDSI List As Variant

Dim g_NewLine_SDSI As String
Dim g_TypeInstallationSDS_SDSI As String
Const gc_SupprimerFichiers_SDSI = True
Const gc_Garantie = 60
Const gc_NbSectionsConvLG_SDSI = 4

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_SDSI = "SL"
Const gc_Element_SDSI = "SDSP_Impression"


</lotusscript></code><code event="SDSI_Initialisations"><lotusscript>Sub SDSI_Initialisations
	If gns_SDSI Is Nothing Then
		Set gns_SDSI = New NotesSession
		Set gndb_SDSI = gns_SDSI.Currentdatabase
		
		Set gnd_Prof_SDSI = gndb_SDSI.GetProfileDocument("F_Prof")
		
		If gnuiws_SDSI Is Nothing Then
			Set gnuiws_SDSI = New NotesUIWorkspace
		End If
		
		g_NewLine_SDSI = Chr(13) &amp; Chr(10)
		
	End If
End Sub

</lotusscript></code><code event="SDSI_CalculerMensualitesFN"><lotusscript>Function SDSI_CalculerMensualitesFN(pnd As NotesDocument, pa_PeriodeA() As Long, _
	pa_MensualitesEQ() As Double, pa_MensualitesLG() As Double, pa_MensualitesFN() As Double) As Integer
	' ------------------------------------------------------------
	' Le script permet d'ajouter une succursale à une proposition.
	' ------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim n As Long
	Dim v_Garantie As Long
	Dim i As Long
	Dim v_Mensualite As Double
	
	SDSI_CalculerMensualitesFN = False
	
	' Initialisations
	ReDim pa_MensualitesFN(UBound(pa_PeriodeA)) As Double
	For i = 0 To UBound(pa_PeriodeA)
		pa_MensualitesFN(0) = 0
	Next
	
	v_Mensualite = SDSI_MensualiteFinancement(SDSI_PrixTotal(pnd, 0, 0, 0, False) - _
	xVar(pnd, "Prop_EscompteMontant", 0) - xVar(pnd, "Prop_EscompteCorporatif", 0))
	
	If v_Mensualite &gt; 0 Then
		n = 0			
		' Si le client a une escompte sur le support
		v_Garantie = gc_Garantie
		If v_Garantie &gt; 0 Then
			' Rechercher l'élément ou il faut insérer la valeur
			While pa_PeriodeA(n) &lt; v_Garantie
				n = n + 1
			Wend
			
			' Insérer un nouvel élément
			If pa_PeriodeA(n) &lt;&gt; v_Garantie Then
				Call SDSI_InsererElementLong(pa_PeriodeA, n)
				Call SDSI_InsererElementDouble(pa_MensualitesEQ, n)
				Call SDSI_InsererElementDouble(pa_MensualitesLG, n)
				Call SDSI_InsererElementDouble(pa_MensualitesFN, n)
				
				pa_PeriodeA(n) = v_Garantie
			End If
		End If
		
		' Mettre à jour les mensualités
		For i = 0 To n
			pa_MensualitesFN(i) = v_Mensualite
		Next
	End If
	
	SDSI_CalculerMensualitesFN = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_AssemblerEquipement"><lotusscript>Function SDSI_AssemblerEquipement(pnd_Prop As NotesDocument, pnd_Site As NotesDocument, p_NoSite As Long, p_NbCategories As Long, _
	p_PrixTotal As Double) As Boolean
	' ------------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux équipements d'un site.
	' ------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_Langue As String
	Dim i As Long
	Dim v_NomSite As String
	
	SDSI_AssemblerEquipement = False
	
	v_NomSite = Ucase(xEvaluate(|@If(!@IsNull(Site_ClientNomInterne); Site_ClientNomInterne; @IsNull(Site_ClientNoFmt); Site_ClientNom; (Site_ClientNom1 : Site_ClientNom2))
|, pnd_Site))
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	
	If Not SILT_ExtraireLettreType("SDSI_EquiSite", v_Langue, False) Then
		Exit Function
	End If
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	' Ajouter les départements
	If p_NbCategories &gt; 0 Then
		For i = 1 To p_NbCategories
			Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\EquiDept" &amp; Cstr(i) &amp; ".docx", "[SDSI_EquiDept]",1)
		Next
		Call SIMW_SupprimerTexte("[SDSI_EquiDept]", 1)
	Else
		Call SIMW_SupprimerTexte("[SDSI_EquiDept]", 1)
	End If
	
	' Remplacer les valeurs de la succursale
	Call SIMW_TrouverRemplacer("[Site_ClientNom]", v_NomSite)
	
	Call SIMW_TrouverRemplacer("[Site_PrixTotalEQ]", SDSI_FormatDevise(p_PrixTotal, g_LangueContrat_SDSI))
	Call SIMW_TrouverRemplacer("[Prop_Devise]", xVar(pnd_Prop, "Prop_Devise", ""))
	
	' Sauvegarder le document Word
	If SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\EquiSite" &amp; Cstr(p_NoSite) &amp; ".docx", "") Then
		
		' Fermer le document Word
		If SIMW_FermerDocument Then
			SDSI_AssemblerEquipement = True
		End If
	End If
	
	If gc_SupprimerFichiers_SDSI Then
		If p_NbCategories &gt; 0 Then
			For i = 1 To p_NbCategories
				Kill g_DossierTemp_SDSI &amp; "\EquiDept" &amp; Cstr(i) &amp; ".docx"
			Next
		End If
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_InsererElementLong"><lotusscript>Sub SDSI_InsererElementLong(pa() As Long, p As Long)
	Dim i As Long
	Redim Preserve pa(Ubound(pa) + 1) As Long
	
	For i = (Ubound(pa) - 1) To p Step -1
		pa(i + 1) = pa(i)
	Next
End Sub

</lotusscript></code><code event="SDSI_ImprimerContrat"><lotusscript>Function SDSI_ImprimerContrat(pnd_Prop As NotesDocument, p_Unique As String, p_Imprimer As Boolean, p_GenererPDF As Boolean, p_CheminFichierPDF As String, p_NbOccurences As Integer) As Boolean
	' ---------------------------------------
	' Le script permet d'imprimer un contrat.
	' ---------------------------------------
	On Error Goto GererErreur
	
	Dim v_NbSite As Long
	Dim v_NomFichierDoc As String
	Dim v_Impression As String
	Dim v_NbFichiersPlanSite As Integer
	Dim v_NomFichierPDF As String
	
	If xVar(pnd_Prop, "Prop_NbProposition", 0) = 0 Then
		' Le No de proposition n'est pas assigné.
		Messagebox xGDK_xMessage("SDSPP", 129, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	v_Impression = xGDK_xMessage("SDSP", 102, "", xGDK_xMessage("SDSP", 103, "", ""))
	Print v_Impression
	
	' Initialisations
	SDSI_ImprimerContrat = False
	Call SDSI_Initialisations
	Call SILT_Initialisations
	g_NoProposition_SDSI = xVar(pnd_Prop, "Prop_NoProposition", "")
	g_NbProposition_SDSI = Cstr(xVar(pnd_Prop, "Prop_NbPropositionTXT", 0))
	g_LangueContrat_SDSI = xVar(pnd_Prop, "Prop_Langue", "FR")
	
	g_TypeInstallationSDS_SDSI = SDSI_TypeInstallationSDS(pnd_Prop)
	
	p_Unique = ""
	If Not SDSI_CreerDossier Then
		Exit Function
	End If
	
	' Démarer Word
	' ------------
	If SIMW_DemarrerWord(False) Then
		
		' Générer les sites
		' -----------------
		If SDSI_GenererSites(pnd_Prop, v_NbSite) Then
			
			' Générer les investissement
			' --------------------------
			If SDSI_GenererInvestissement(pnd_Prop) Then
				
				' Générer prix paiement
				If SDSI_GenererPrixPaiement(pnd_Prop) Then
					
					' Générer terme paielent
					If SDSI_GenererTermePaiement(pnd_Prop) Then
						
						' Générer les frais de logiciels
						' ------------------------------
						If SDSI_GenererFraisLogiciels(Pnd_Prop) Then
							
							' Générer les signatures
							' ------------------------------
							If SDSI_GenererSignature(pnd_Prop) Then
								
								' Générer date en vigueur du contrat
								' -----------------------------------
								If SDSI_GenererDateEnVigueur(pnd_Prop) Then
									
									' Générer totaux/escompte des logiciels de conversion
									' ------------------------------------------
									If SDSI_GenererTotauxLogiciels_Conv(pnd_Prop) Then
										
										' Générer le plan du site 
										'-------------------------								
										If SDSI_GenererPlanSite(pnd_Prop, "0", v_NbFichiersPlanSite) Then
											
											' Assembler le contrat
											' --------------------
											If SDSI_AssemblerContrat(pnd_Prop, v_NbSite, v_NomFichierDoc, v_NomFichierPDF, v_NbFichiersPlanSite) Then
												
												' Attacher le contrat à la proposition
												' ------------------------------------
												If SDSI_CreerDocument(pnd_Prop, v_NomFichierDoc, "C") Then
													
													' Imprimer le contrat
													' -------------------
													If p_Imprimer Then
														Print v_Impression &amp; " " &amp; xGDK_xMessage("SI", 186, "", "")
														If SIMW_ImprimerDocument(True) Then
															' Attendre la fin de l'impression
															Call SIMW_AttendreFinImpression
														End If
													End If
													
													If p_GenererPDF Then
														v_NomFichierPDF = SDSI_NomFichier(g_DossierTemp_SDSI, v_NomFichierPDF)
														If SIMW_EnregistrerDocumentPDF(False, v_NomFichierPDF) Then
															p_CheminFichierPDF = v_NomFichierPDF
														End If
														
														p_NbOccurences = CInt(SIMW_NbPages)
														
														Call SIMW_FermerWord
														SDSI_ImprimerContrat = True
														Exit Function
														
													End If
													
													' Fermer le document
													' ------------------
													Call SIMW_FermerDocument
													
													If gc_SupprimerFichiers_SDSI Then
														Kill g_DossierTemp_SDSI &amp; "\" &amp; v_NomFichierDoc
													End If
													p_Unique = g_Unique_SDSI
													
													' Mettre à jour l'historique de la proposition
													' ---------------------------------------------------------
													Call SIHi_Ajouter(pnd_Prop, "", "Action : " &amp; _
													"Impression du contrat  /  Contract printed (" &amp; p_Unique &amp; ")", "", True)
													
													SDSI_ImprimerContrat = True		
													
												End If
												
											End If
										End If
									End if
								End If
							End if
						End If
					End If
				End If
			End If
		End If
		
		
	End If
	
	' Fermer Word
	' -------------------
	Call SILT_TerminerTraitement
	
	' Détruire le dossier du contrat
	' ----------------------------------------
	If gc_SupprimerFichiers_SDSI Then
		On Error 75 Resume Next		' Path/file access error
		Rmdir g_DossierTemp_SDSI
	End If
	
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Call SIMW_FermerWord
	Exit Function
End Function

</lotusscript></code><code event="SDSI_Province"><lotusscript>Function SDSI_Province(pnd As NotesDocument, p_Prefixe As String, p_Prov As String) As String
	On Error Goto GererErreur
	
	Dim v_Province As String
	
	v_Province = xVar(pnd, p_Prefixe &amp; "_ClientProvince", "")
	If p_Prov = "E" Then
		v_Province = xVar(pnd, p_Prefixe &amp; "_ClientProvinceEnreg", v_Province)
	End If
	
	SDSI_Province = xGDK_xDescTabl(v_Province, "ISO3166-2" &amp; xVar(pnd, p_Prefixe &amp; "_ClientPays", "") &amp; _
	g_LangueContrat_SDSI, True)
	If SDSI_Province = "" Then
		SDSI_Province = v_Province
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererDateEnVigueur"><lotusscript>Function SDSI_GenererDateEnVigueur(pnd_Prop As NotesDocument) As Boolean
	On Error GoTo GererErreur
	
	Dim v_Langue As String
	Dim v_NomLettreType As String
	Dim v_DateDebutContrat As Variant
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	' Initialisations
	SDSI_GenererDateEnVigueur = False
	
	If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then 'Conversion	
		
		If g_TypeInstallationSDS_SDSI = "1" Then  		
			v_NomLettreType = "SDSI_ContConvEnVigueurM"
		Else
			v_NomLettreType = "SDSI_ContConvEnVigueurA"
		End If
		
		If Not SILT_ExtraireLettreType(v_NomLettreType, v_Langue, False) Then
			Exit Function
		End If
		
		' Ouvrir le document Word
		If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
			Exit Function
		End If
		
		v_DateDebutContrat = xVar(pnd_Prop, "Prop_DateDebutContrat", "")
		
		'Call SIMW_TrouverRemplacer("[Prop_DateDebutContrat]", v_DateDebutContrat)
		
		If v_DateDebutContrat  &lt;&gt; "" Then
			Call SIMW_TrouverRemplacer("[Prop_DateDebutContrat]", UCase(SItD_DateLongue(v_DateDebutContrat, v_Langue)))
		Else
			Call SIMW_TrouverRemplacer("[Prop_DateDebutContrat]", "")
		End If
		
		' Sauvegarder le document Word
		If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\" &amp;"DateEnVigueurConv.docx", "") Then
			Exit Function
		End If
		
		' Fermer le document Word
		If Not SIMW_FermerDocument Then
			Exit Function
		End If
		
	End If
	
	SDSI_GenererDateEnVigueur = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererInvestissement"><lotusscript>Function SDSI_GenererInvestissement(pnd_Prop As NotesDocument)
	' ------------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux investissement EQ &amp; SV
	' ------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_PrixTotalEQ As Double
	Dim v_PrixTotalSV As Double
	Dim v_MontantTotal As Double
	Dim v_Langue As String
	Dim v_Escompte As Double
	
	' Initialisations
	SDSI_GenererInvestissement = False
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	If Not SILT_ExtraireLettreType("SDSI_InvestEQSV", v_Langue, False) Then
		Exit Function
	End If
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	v_MontantTotal = SDSI_MontantTotal(pnd_Prop, v_PrixTotalEQ, v_PrixTotalSV)
	
	Call SIMW_TrouverRemplacer("[Prop_PrixTotalEQ]", SDSI_FormatDevise(v_PrixTotalEQ, g_LangueContrat_SDSI))
	Call SIMW_TrouverRemplacer("[Prop_PrixTotalSV]", SDSI_FormatDevise(v_PrixTotalSV, g_LangueContrat_SDSI))
	
	' Ajouter les totaux de la commande
	v_Escompte = (xVar(pnd_Prop, "Prop_EscompteMontant", 0) + xVar(pnd_Prop, "Prop_EscompteCorporatif", 0))
	
	If v_Escompte = 0 Then
		' supprimer les lignes du tableau
		Call g_WordDoc_SIMW.Tables(1).Rows(4).Delete ' TOTAL
		Call g_WordDoc_SIMW.Tables(1).Rows(4).Delete ' ESCOMTE
		Call g_WordDoc_SIMW.Tables(1).Rows(4).Delete ' ------------------
	Else
		Call SIMW_TrouverRemplacer("[Prop_MontantTotal]", SDSI_FormatDevise(v_MontantTotal, g_LangueContrat_SDSI))
		Call SIMW_TrouverRemplacer("[Prop_Escompte]", SDSI_FormatDevise(v_Escompte, g_LangueContrat_SDSI))
	End If
	
	Call SIMW_TrouverRemplacer("[Prop_MontantFinancer]", SDSI_FormatDevise(v_MontantTotal - v_Escompte, g_LangueContrat_SDSI))
	Call SIMW_TrouverRemplacer("[Prop_Devise]", xVar(pnd_Prop, "Prop_Devise", ""))
	
	' Sauvegarder le document Word
	If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\InvestEQSV.docx", "") Then
		Exit Function
	End If
	
	' Fermer le document Word
	If Not SIMW_FermerDocument Then
		Exit Function
	End If
	
	SDSI_GenererInvestissement = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
	
End Function

</lotusscript></code><code event="SDSI_GenererMontantsLogiciels_Conv"><lotusscript>Function SDSI_GenererMontantsLogiciels_Conv(pnd_Prop As NotesDocument) As Boolean
	' ------------------------------------------------------------------------------
	' Le script permet de générer les montants Word liés aux logiciels de conversion
	' d'un site.
	' ------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim v_Langue As String
	Dim v_Escompte As Double
	Dim a_MontantsSectionsLGSite As Variant
	Dim v_DateDebutContrat As Variant
	Dim v_MontantsCSAPrePaye As Double  ' Requête  46535
	
	' Initialisations
	SDSI_GenererMontantsLogiciels_Conv = False
	
	a_MontantsSectionsLGSite = xListElem(gl_MontantsSectionsLGSites_SDSI,xVarElem(pnd_Prop, "Prop_NoSites", 0 , ""), 0) 
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	v_Escompte = xVar(pnd_Prop, "Prop_EscompteMensualite", 0)
	
	If Not SILT_ExtraireLettreType("SDSI_TotalConvLG", v_Langue, False) Then
		Exit Function
	End If
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	
	'-----Requête  46535
	'v_MontantsCSAPrePaye  = a_MontantsSectionsLGSite(2)
	
	If xVar(pnd_Prop, "Prop_PrePayeZero", "") = "1" Then
		v_MontantsCSAPrePaye  = 0
	Else
		v_MontantsCSAPrePaye = a_MontantsSectionsLGSite(1)		
	End If
	'---- fin Requête  46535
	
	Call SIMW_TrouverRemplacer("[SDSI_MontantS2]", SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(1)), v_Langue))
	Call SIMW_TrouverRemplacer("[SDSI_MontantS1]", SDSI_FormatDevise(CDbl(v_MontantsCSAPrePaye), v_Langue))  'new line
	Call SIMW_TrouverRemplacer("[SDSI_MontantS3]", SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(2)), v_Langue))	
	Call SIMW_TrouverRemplacer("[SDSI_MontantS4]", SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(3) - v_Escompte), v_Langue))			
	'Call SIMW_TrouverRemplacer("[SDSI_EscompteS4]", SDSI_FormatDevise(v_Escompte, v_Langue))	
	Call SIMW_TrouverRemplacer("[SDSI_TotalS1]", SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(1) - CDbl(v_MontantsCSAPrePaye) + a_MontantsSectionsLGSite(2) + a_MontantsSectionsLGSite(3) - v_Escompte), v_Langue))
	Call SIMW_TrouverRemplacer("[SDSI_TotalS2]", SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(1) + a_MontantsSectionsLGSite(2) + (a_MontantsSectionsLGSite(3) - v_Escompte)), v_Langue))

	
	v_DateDebutContrat = xVar(pnd_Prop, "Prop_DateDebutContrat","")
	
	If g_TypeInstallationSDS_SDSI = "1" Then 
		If v_DateDebutContrat  &lt;&gt; "" Then
			Call SIMW_TrouverRemplacer("[DateDebutContratLongUC]", " (" &amp; UCase(SItD_DateLongue(v_DateDebutContrat, v_Langue)) &amp; ")")
		Else
			Call SIMW_TrouverRemplacer("[DateDebutContratLongUC]", "")
		End If
	Else
		Call SIMW_TrouverRemplacer("[DateDebutContratLongUC]", "")
	End If

	
	' Sauvegarder le document Word
	If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\MontantsConv.docx", "") Then
		Exit Function
	End If
	
	' Fermer le document Word
	If Not SIMW_FermerDocument Then
		Exit Function
	End If
	
	SDSI_GenererMontantsLogiciels_Conv = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererLogiciels_Conv"><lotusscript>Function SDSI_GenererLogiciels_Conv(pnd_Prop As NotesDocument, pnd_Site As NotesDocument, _
	p_NbSite As Long, pa_MontantsSectionsLG() As Double) As Boolean
	' ----------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux logiciels d'un site
	' pour une proposition de type 3 - Conversion à logiciel-service
	' ----------------------------------------------------------------------------
	On Error GoTo GererErreur

	Dim a_ndProduits() As NotesDocument
	Dim a_ProduitsSection As Variant
	Dim a_Sections() As Variant
	
	Dim nd_CateSDSBB As NotesDocument
	Dim nd_Prod As NotesDocument
	Dim nd_ProdSuivant As NotesDocument	
	Dim ndc_Produits As NotesDocumentCollection
	Dim nv As NotesView
	
	Dim i As Integer
	Dim j As Integer	
	Dim v_CleProduit As String
	Dim v_PremiereCategorie As Boolean
	Dim v_CategorieCourante As String
	Dim v_NouvelleCategorie As Boolean
	Dim v_Langue As String
	Dim v_WordTable As Variant
	Dim v_Ligne As Integer
	Dim v_NbCategories As Long	
	Dim v_MontantTotal As Double
	Dim v_DescProduit As String
	Dim v_NbSections As Integer
	Dim v_NoSection As Integer
	Dim v_NbUtilisateurs As Long	
	Dim v_NoSite As String
	Dim v_PrixNegatif As String
	
	' Initialisations
	SDSI_GenererLogiciels_Conv = False
	
	v_NbSections = gc_NbSectionsConvLG_SDSI	
	ReDim  a_Sections(v_NbSections -1) As Variant
	
	' Générer les logiciels par catégorie pour chaque section
	' ------------------------------------------------------
	Set nv = gndb_SDSI.GetView("v_Prod31" &amp; xLangue)	
	Call nv.Refresh
	
	v_NoSite = xVar(pnd_Site, "Site_NoSite", "")
	
	Set ndc_Produits = nv.GetAllDocumentsByKey(g_NoProposition_SDSI &amp; ";" &amp; v_NoSite &amp; ";LG", True)
	
	For j = 1 To v_NbSections
		
		If ndc_Produits.Count &gt; 0 Then
			ReDim a_ndProduits(ndc_Produits.Count -1)
			
			Set nd_ProdSuivant = ndc_Produits.GetFirstDocument
			
			Do Until nd_ProdSuivant Is Nothing
				Set nd_Prod = nd_ProdSuivant
				Set nd_ProdSuivant = ndc_Produits.GetNextDocument(nd_ProdSuivant)
				
				v_DescProduit = SDSI_DescProduitsSommLG(nd_Prod, v_NbUtilisateurs)
				
				Set nd_CateSDSBB = xSDSBB_xndCate(xVar(nd_Prod, "Prod_CategorieProduit", ""), True)
				
				If xVar(nd_Prod, "Prod_FraisEntretienTotal", 0) &lt; 0 Then
					v_PrixNegatif = "1"
				Else
					v_PrixNegatif = "0"
				End If
				
				v_CleProduit =  Format$(xVar(nd_CateSDSBB, "Cate_PropTri", 0), "00") &amp; ";" &amp; xVar(nd_CateSDSBB, "Cate_CodeCategorie", "00") &amp; _
				";" &amp; CStr(xSDSBB_xVarProd(xVar(nd_Prod, "Prod_CleProduit", ""), "Prod_PropTriImpression", 90, True)) &amp; _
				";" &amp; CStr(v_NbUtilisateurs) &amp; ";" &amp; v_DescProduit &amp; ";" &amp; v_PrixNegatif
				
				' Champ temporaire pour le trie
				nd_Prod.Tmp_CleTri = v_CleProduit
				
				Select Case j
					' Annuel ou Mensuel	
				Case Is &lt;= 2
					If xVar(nd_Prod, "Prod_TypeContratService_CS", "") = "0" Then
						Set a_ndProduits(i) = nd_Prod				
						i = i + 1
					End If											
					' Mensuel remporté	
				Case 3
					If xVar(nd_Prod, "Prod_TypeContratService_CS", "") = "1" Then
						Set a_ndProduits(i) = nd_Prod				
						i = i + 1
					End If
					' Ajouts
				Case 4
					If xVar(nd_Prod, "Prod_TypeContratService_CS", "") = "" Then
						Set a_ndProduits(i) = nd_Prod				
						i = i + 1
					End If
			End Select
				
			Loop
			
			If i &gt; 0 Then
				ReDim Preserve a_ndProduits(i -1)
			Else
				ReDim a_ndProduits(0)
			End If
			
			Call TrierArrayDocs(a_ndProduits, "Tmp_CleTri", "")		
			
		Else
			ReDim a_ndProduits(0)	
		End If
		
		a_Sections(j-1) = a_ndProduits
		i = 0
		
	Next
	
	'Construire un document par section
	'--------------------------------------
	For j = 0 To UBound(a_Sections)
		
		v_PremiereCategorie = True
		v_CategorieCourante= "QWERTY"
		v_NbCategories = 0
		v_MontantTotal = 0
		v_Ligne = 1
		v_NoSection = j + 1		
		a_ProduitsSection = a_Sections(j)
		
		
		
		For i = 0 To UBound(a_ProduitsSection)	
			
			Set nd_Prod = a_ProduitsSection(i)
			
			If Not nd_Prod Is Nothing Then
				
				If xVar(nd_Prod, "Prod_TypeDescendant","") &lt;&gt; "C" And xVar(nd_Prod,"Prod_ClasseProduit","") = "LG" Then
					
					If xVar(nd_Prod, "Prod_Quantite", 0) &lt;&gt; 0 Then
						' Changement de catégorie
						' -----------------------
						If xVar(nd_Prod, "Prod_CategorieProduit", "") &lt;&gt; v_CategorieCourante Then
							If Not v_PremiereCategorie Then
								Set v_WordTable = g_WordDoc_SIMW.Tables(1)
								Call v_WordTable.Rows(v_Ligne).Delete
								
								' Sauvegarder le document Word
								If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\LogiCat" &amp; _
								CStr(v_NbCategories) &amp; ".docx", "") Then
									Exit Function
								End If
								
								' Fermer le document Word
								If Not SIMW_FermerDocument Then
									Exit Function
								End If
								
								v_Ligne = 1
							Else
								v_PremiereCategorie = False
							End If
							
							v_NbCategories = v_NbCategories + 1
							v_CategorieCourante = xVar(nd_Prod, "Prod_CategorieProduit", "")
							
							' Extraire le document Word
							v_Langue = g_LangueContrat_SDSI
							If Not SILT_ExtraireLettreType("SDSI_LogiCat", v_Langue, False) Then
								Exit Function
							End If
							
							' Ouvrir le document Word
							If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
								Exit Function
							End If
							
							v_NouvelleCategorie = True
						End If
						
						' Ajouter le produit de logiciel
						' ------------------------------
						If Not SDSI_AjouterLogiciel(pnd_Prop, nd_Prod, v_NouvelleCategorie, v_MontantTotal, v_Ligne, v_NoSection) Then
							Exit Function
						End If
						
						v_NouvelleCategorie = False
						
					End If
				End If 
				
			End If
			
		Next
		
		' Si des départements ont été créés
		' ---------------------------------
		If v_NbCategories &gt; 0 Then
			Set v_WordTable = g_WordDoc_SIMW.Tables(1)
			Call v_WordTable.Rows(v_Ligne).Delete
			
			' Sauvegarder le document Word
			If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\LogiCat" &amp; CStr(v_NbCategories) &amp; ".docx", "") Then
				Exit Function
			End If
			
			' Fermer le document Word
			If Not SIMW_FermerDocument Then
				Exit Function
			End If
		End If
		
		' Assembler les Logiciels de la section
		' -------------------------------------
		If Not SDSI_AssemblerLogiciels_Conv(pnd_Prop, pnd_Site, v_NoSection, v_NbCategories) Then
			Exit Function
		End If
		
		pa_MontantsSectionsLG(j) = v_MontantTotal
		
	Next
	
	SDSI_GenererLogiciels_Conv = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererSignature"><lotusscript>Function SDSI_GenererSignature(pnd_Prop As NotesDocument) As Boolean
	' ----------------------------------------------------------------
	' Le script permet de générer le document Word liés à la signature
	' ----------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_Langue As String
	Dim v_TypeSignature As String
	
	SDSI_GenererSignature = False
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	If xVar(pnd_Prop, "Prop_ClientNomLegal", "") &lt;&gt; "" Then
		v_TypeSignature = "Signature"
	Else
		v_TypeSignature = "NoSignature"
	End If	
	
	' Signature Contrat
	' -----------------
	
	' Pas de signature
	If v_TypeSignature = "NoSignature" Then
		
		If Not SILT_ExtraireLettreType("SDSI_" &amp; v_TypeSignature, v_Langue, False) Then
			Exit Function
		End If
		
		' Ouvrir le document Word
		If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
			Exit Function
		End If
		
		If v_TypeSignature = "NoSignature" Then
			Call SIMW_TrouverRemplacer("[SDSI_NoSignature]", 	xGDK_xMessage("SDSPP", 67, v_Langue, ""))
		End If
		
		' Sauvegarder le document Word
		If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\" &amp; v_TypeSignature &amp; ".docx", "") Then
			Exit Function
		End If
		
		' Fermer le document Word
		If Not SIMW_FermerDocument Then
			Exit Function
		End If
		
	Else
		
		' Générer documents de signatures
		If v_TypeSignature = "Signature" Then
			
			
			' Extraire le document si signature signataire
			If Not SILT_ExtraireLettreType("SDSI_" &amp; v_TypeSignature &amp; "Signataire", v_Langue, False) Then
				Exit Function
			End If
			
			' Ouvrir le document Word
			If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
				Exit Function
			End If
			
			' Sauvegarder le document Word
			If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\" &amp; v_TypeSignature &amp; "Signataire" &amp; ".docx", "") Then
				Exit Function
			End If
			
			' Fermer le document Word
			If Not SIMW_FermerDocument Then
				Exit Function
			End If
			
			
			' Extraire le document si signature acceptance
			If Not SILT_ExtraireLettreType("SDSI_" &amp; v_TypeSignature &amp; "Acceptance", v_Langue, False) Then
				Exit Function
			End If
			
			' Ouvrir le document Word
			If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
				Exit Function
			End If
			
			' Sauvegarder le document Word
			If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\" &amp; v_TypeSignature &amp; "Acceptance" &amp; ".docx", "") Then
				Exit Function
			End If
			
			' Fermer le document Word
			If Not SIMW_FermerDocument Then
				Exit Function
			End If
			
		End If
		
	End If
	
	SDSI_GenererSignature = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_AjouterEquipement"><lotusscript>Function SDSI_AjouterEquipement(pnd_Prop As NotesDocument, pnd_Prod As NotesDocument, p_NouvelleCategorie As Boolean, p_PrixTotal As Double, _
	p_Ligne As Integer) As Boolean
	' ----------------------------------------------------------------------------------------------
	' Le script permet d'ajouter un équipement dans le document Word liés aux équipements d'un site.
	' ----------------------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_WordTable As Variant
	Dim v_WordRow As Variant
	
	SDSI_AjouterEquipement = False
	
	' Extraire la table des produits d'équipement
	' -------------------------------------------
	Set v_WordTable = g_WordDoc_SIMW.Tables(1)
	
	Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(p_Ligne))	
	
	' Ajouter l'information du produit sur la dernière ligne du tableau
	' -----------------------------------------------------------------
	'Print xVar(pnd_Prod, "Prod_CodeProduit", "")
	
	If p_NouvelleCategorie Then
		Call v_WordTable.Cell(p_Ligne,1).Range.InsertAfter(xGDK_xDescTabl(xVar(pnd_Prod, "Prod_Departement", ""), "SDS_Departements" &amp; g_LangueContrat_SDSI, True))
	End If
	
	Call v_WordTable.Cell(p_Ligne,2).Range.InsertAfter((xSDSBB_xVarProd(xVar(pnd_Prod, "Prod_CleProduit", ""), "Prod_DescContrat" &amp; _
	g_LangueContrat_SDSI, xVar(pnd_Prod, "Prod_DescProduit" &amp; g_LangueContrat_SDSI, ""), True)))
	Call v_WordTable.Cell(p_Ligne,3).Range.InsertAfter(Cstr(xVar(pnd_Prod, "Prod_Quantite", 0)))
	Call v_WordTable.Cell(p_Ligne,4).Range.InsertAfter(SDSI_FormatDevise(xVar(pnd_Prod, "Prod_PrixUnitaire", 0), g_LangueContrat_SDSI))
	Call v_WordTable.Cell(p_Ligne,5).Range.InsertAfter(SDSI_FormatDevise(xVar(pnd_Prod, "Prod_PrixTotal", 0), g_LangueContrat_SDSI))
	
	p_PrixTotal = p_PrixTotal + xVar(pnd_Prod, "Prod_PrixTotal", 0)
	
	p_Ligne = p_Ligne + 1
	SDSI_AjouterEquipement = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_EnvoyerBC"><lotusscript>Function SDSI_EnvoyerBC(pnd_Prop As NotesDocument, p_TypeCourriel As String, p_RepondreA As String, p_Choix As String) As Boolean
	On Error GoTo GererErreur
	
	Dim nd_Courriel As NotesDocument
	Dim ndb_Courriel As NotesDatabase
	Dim nd_NAB As NotesDocument	
	Dim nd_Empl As NotesDocument	
	Dim nrti As NotesRichTextItem
	Dim nrti_Signature As NotesRichTextItem
	Dim na As NotesAgent
	
	Dim v_CC As Variant
	Dim v_CCC As Variant
	Dim v_CheminFichierPDF As String
	Dim v_ClientNom As String
	Dim v_Impression As Boolean	
	Dim v_Langue As String
	Dim v_LangueCT As String
	Dim v_level As Integer	
	Dim v_MSG_Histo As String
	Dim v_NouvStatut As String
	
	Dim v_accPriv As Long
	Dim v_NoEmploye As String
	Dim v_NomItemSignature As String
	Dim v_NoRep As String
	Dim v_NomTablBCUsr As String
	Dim v_ndbCourriels As Variant
	Dim v_From As String
	Dim v_Principal As Variant
	Dim v_PrincipalChoix As String
	Dim v_RepondreAChoix As Variant
	Dim v_RepondreA_Nouv As String
	Dim v_Principal_Nouv As String	
	Dim v_ReplyTo As String	
	Dim v_SendTo As Variant
	Dim v_Serveur As String
	
	
	Call SDSI_Initialisations
	v_Langue = xLangue
	v_NouvStatut = "55"
	
	'v_NomTablBCUsr = "SLDS_BCUsr_" &amp; v_Langue  'remplacé par la ligne ci-dessous
	v_NomTablBCUsr = "SLOSS_BCUsr_" &amp; v_Langue   
	
	SDSI_EnvoyerBC = False
	
	' Sélectionner le Document à imprimer et envoyer
	v_Impression = SDSI_ImprimerBonCommande(pnd_Prop, xVar(pnd_Prop, "Cle", ""), False, True, v_CheminFichierPDF, p_Choix) 'passer p_modelecourriel comm eparametre d'entree
	If v_Impression Then
		pnd_Prop.temp_clientnom = xEvaluate(|@If(!@IsNull(Prop_ClientNomInterne); Prop_ClientNomInterne; @IsNull(Prop_ClientNoFmt); Prop_ClientNom; (Prop_ClientNom1 : Prop_ClientNom2))|, pnd_Prop)
		
		v_LangueCT = xVar(pnd_Prop, "Prop_Langue", "")		
		Set nd_Courriel = SICT_ConstruireMessage(pnd_Prop, p_TypeCourriel, v_LangueCT, xVar(pnd_Prop, "Prop_ContactCourriel", ""), "", "", 0, "fichier_attach")
		Set nrti = nd_Courriel.GetFirstItem("Body")
		
		If xVar(pnd_Prop, "Prop_NomRepresentant", "") = "" Then
			Call SItRT_Remplacer(nrti, "[prop_nomrepresentant]", "")
		End If
		
		' fichier_attach
		Call SItRT_RemplacerFichierAttach(nrti, "[fichier_attach]", v_CheminFichierPDF)
		
		' Ajouter la signature à la fin du Body (Sans Signet)
		Call SISg_ExtraireSignature(v_NoEmploye, nd_Empl, v_NomItemSignature)
		
		
		'-----Correctif 15 Mars 2023 MZE dans le cas ou Empl n'as pas de Signature Externe, nd_Empl Is Nothing
		If Not (nd_Empl Is Nothing) Then			
			
				Set nrti_Signature = nd_Empl.GetFirstItem(v_NomItemSignature)
				Call nrti.AppendRTItem(nrti_Signature)
				Call nrti.AddNewLine(2, False)
		End If		
		
		
		v_ClientNom = xVar(pnd_Prop, "temp_clientnom", "")
		If v_Langue = "EN" Then
			nd_Courriel.Titre = xVar(pnd_Prop, "Prop_NbPropositionPrefixe", "") &amp; CStr(xVar(pnd_Prop, "Prop_NbProposition", ""))  &amp; " - " &amp; v_ClientNom &amp; " - EMAIL Purchase Order"
		Else
			nd_Courriel.Titre = xVar(pnd_Prop, "Prop_NbPropositionPrefixe", "") &amp; CStr(xVar(pnd_Prop, "Prop_NbProposition", ""))  &amp; " - " &amp; v_ClientNom &amp; " - COURRIEL Bon de commande"
		End If
		
		v_RepondreAChoix = p_RepondreA
		
		nd_Courriel.Cour_NoProposition = CStr(xVar(pnd_Prop, "Prop_NbProposition", ""))
		nd_Courriel.Cour_ClientNoFmt = xVar(pnd_Prop, "Prop_ClientNoFmt", "")
		nd_Courriel.Cour_ClientNom = v_ClientNom
		nd_Courriel.Cour_Type = "BC"
		nd_Courriel.SI_DialogBox = "1"  ' cacher les bts save et X
		'nd_Courriel.Cour_ReplyToDesc = xDescTabl(v_RepondreAChoix, "SLDS_BCUsr", True)
		
		v_NoRep = SDSI_NoRepresentantSIRR
		
		If v_NoRep &gt; 0 Then
			nd_Courriel.Cour_NoRepresentant = v_NoRep	
			v_ReplyTo = ""
			nd_Courriel.Cour_ReplyToDesc = gns_SDSI.CommonUserName
		Else
			If v_RepondreAChoix = "00" Then
				v_ReplyTo = xNAB_xVarPerson(gns_SDSI.UserName, "InternetAddress", "", True)				
				If v_ReplyTo = "" Then
					v_ReplyTo = xNAB_xVarPersonCN(gns_SDSI.CommonUserName, "InternetAddress", "", True)	
				End If
				nd_Courriel.Cour_ReplyToDesc = gns_SDSI.CommonUserName
			Else				
				v_ReplyTo = xComplTabl(v_RepondreAChoix, v_NomTablBCUsr, "1", True)
				nd_Courriel.Cour_ReplyToDesc = xDescTabl(v_RepondreAChoix, v_NomTablBCUsr, True)
			End If
			
			nd_Courriel.ReplyTo = v_ReplyTo		
			v_PrincipalChoix = xVarPers("Pers_EnvoyerParChoix","00")		
			REM nd_Courriel.Cour_Principal = v_PrincipalChoix
		End If		
		
		'nd_Courriel.ReplyTo = v_ReplyTo		
		'v_PrincipalChoix = xVarPers("Pers_EnvoyerParChoix","0")		
		'nd_Courriel.Cour_Principal = v_PrincipalChoix
		
		
		nd_Courriel.Form = "Memo"
		
		' Il faut sauvegarder le doc pour que le champ RichText s'affiche correctement
		Call nd_Courriel.save(True,False) 
		
		If gnuiws_SDSI.DialogBox("DB_EnvoiOSSg", True, True, True, False, False, False, _
		xGDK_xMessage("SI", 189, "", ""), nd_Courriel, True, True, True) Then
			
			v_Principal_Nouv = xVar(nd_Courriel, "Cour_Principal", "00")
			
			If  v_Principal_Nouv &lt;&gt; "00" Then
				'nd_Courriel.Principal = xNAB_xVarMailIn(xVar(nd_Courriel, "Principal", ""),"InternetAddress", "", True)				
				Set nd_NAB = xNAB_xndPersonCN(xDescTabl(v_Principal_Nouv, v_NomTablBCUsr, True), True)	
				
				If Not nd_NAB Is Nothing Then
					v_Principal = xVarElem(nd_NAB, "FullName", 0, "")					
				Else
					v_Principal = xNAB_xVarMailIn(xVar(nd_Courriel, "Principal", ""),"FullName", "", True)	
				End If		
				
				REM nd_Courriel.Principal = v_Principal				
			End If
			
			nd_Courriel.BlindCopyTo = Evaluate(|@Unique(Cour_Bcc : BlindCopyTo) |, nd_Courriel)			
			Call nd_Courriel.Send(False)
			
			
			If v_Principal_Nouv = "00" Then	
				
				'Utilisateur
				'Set nd_NAB = xNAB_xndPerson(gns_SDSI.UserName, True)
				
				' Si pas de notes id
				'If nd_NAB Is Nothing Then
				'	Set nd_NAB = xNAB_xndPerson(gns_SDSI.CommonUserName, True)
				'End If	
				
				' Extraire la base de courriels de l'utilisateur					
				v_ndbCourriels = Evaluate(|@MailDbName|)
				If v_ndbCourriels(1) &lt;&gt; "" Then
					Set ndb_Courriel = gns_SICT.GetDatabase(v_ndbCourriels(0), v_ndbCourriels(1), False)						
				End If
				
				v_From = xEvaluate(|@NameLookup([Exhaustive];@UserName;"InternetAddress")|, Nothing)
				
			Else
				Set nd_NAB = xNAB_xndMailIn(xDescTabl(xVar(nd_Courriel, "Cour_Principal", ""), v_NomTablBCUsr, True), True)
				
				If nd_NAB Is Nothing Then				
					Set nd_NAB = xNAB_xndPersonCN(xDescTabl(xVar(nd_Courriel, "Cour_Principal", ""), v_NomTablBCUsr, True), True)					
				End If
				
				Set ndb_Courriel = gns_SDSI.Getdatabase(xVar(nd_NAB, "MailServer", ""), xVar(nd_NAB, "MailFile", ""), False) 
				'Set ndb_Courriel = gns_SDSI.Getdatabase(gns_SDSI.Currentdatabase.Server, xVar(nd_NAB, "MailFile", ""), False) 'remplacé par la ligne du dessus	
				v_From = xNAB_xVarMailIn(xDescTabl(v_Principal_Nouv, v_NomTablBCUsr, True), "InternetAddress", "", True)
			End If
			
			'Note : Courriel copié dans la vue envoyé du mail-in
			If Not ndb_Courriel Is Nothing Then
				
				v_level = ndb_Courriel.QueryAccess(gns_SDSI.UserName)
				v_accPriv = ndb_Courriel.QueryAccessPrivileges(gns_SDSI.UserName)
				v_Serveur = nd_Courriel.Parentdatabase.Server
				
				nd_Courriel.DeliveredDate = ""
				nd_Courriel.PostedDate = Now				
				nd_Courriel.From = v_From					
				nd_Courriel.Memo_Serveur = ndb_Courriel.Server
				nd_Courriel.Memo_Fichier = ndb_Courriel.Filepath
				nd_Courriel.Memo_Database = ndb_Courriel.Title
				nd_Courriel.NoAutoReply = "1"
				
				'Local
				If v_Serveur = "" Then
					nd_Courriel.Memo_EnvoyerCourriel = "1"
					Call nd_Courriel.save(True,False) 
				Else
					If (v_level &gt;= 3) And (v_accPriv And DBACL_CREATE_DOCUMENTS &gt; 0) Then
						If ndb_Courriel.IsOpen Then											
							Call nd_Courriel.save(True,False) 							
							If ndb_Courriel.IsOpen Then
								Call nd_Courriel.Copytodatabase(ndb_Courriel)
							End if															
						End If
					Else
						nd_Courriel.Memo_EnvoyerCourriel = "1"
						Call nd_Courriel.save(True,False) 
					End If
				End If
				
			End if
			
			
			If v_Langue = "EN" Then
				Print "The email has been sent"
			Else
				Print "Le Courriel a été envoyé"
			End If
			
			Call pnd_Prop.RemoveItem("temp_clientnom")
			
			' Mettre à jour l'historique de la proposition
			' --------------------------------------------
			v_MSG_Histo = "Action :  Envoie du bon de commande par courriel /  Purchase order sent by email "
			v_SendTo = xVar(nd_Courriel, "SendTo", "")
			If IsArray(v_SendTo) Then
				v_SendTo = Join(v_SendTo, ", ")
			End If
			If v_SendTo &lt;&gt; "" Then
				v_MSG_Histo = v_MSG_Histo &amp; Chr(10) &amp; "(A / To: " &amp; v_SendTo &amp; ")"
			End If
			
			v_CC = xVar(nd_Courriel, "CopyTo", "")
			If IsArray(v_CC) Then
				v_CC = Join(v_CC, ", ")
			End If
			If v_CC &lt;&gt; "" Then
				v_MSG_Histo = v_MSG_Histo &amp; Chr(10) &amp; "(CC: " &amp; v_CC &amp; ")"
			End If
			
			v_CCC = xVar(nd_Courriel, "BlindCopyTo", "")
			If IsArray(v_CCC) Then
				v_CCC = Join(v_CCC, ", ")
			End If
			If v_CCC &lt;&gt; "" Then
				v_MSG_Histo = v_MSG_Histo &amp; Chr(10) &amp; "(CCC / BCC: " &amp; v_CCC &amp; ")"
			End If
			
			' Req 49316
			
			'Statut Accepté-50 à En attente de signature-55
			If xVar(pnd_Prop, "Prop_Statut", "0") = "50" Then													
				
				' Assigner le nouveau statut
				' --------------------------
				pnd_Prop.Prop_Statut = v_NouvStatut
				pnd_Prop.Prop_StatutDate = Now
				pnd_Prop.Prop_StatutIcone = xIcnTabl(v_NouvStatut, "Prop_Statut_FR", True)
				pnd_Prop.Prop_StatutDescFR = xDescTabl(v_NouvStatut, "Prop_Statut_FR", True)
				pnd_Prop.Prop_StatutDescEN = xDescTabl(v_NouvStatut, "Prop_Statut_EN", True)
				
				pnd_Prop.HistoDM = Now
				pnd_Prop.HistoUM = gns_SDSI.UserName
				
				Call SIHi_Ajouter(pnd_Prop, v_NouvStatut &amp; "-" &amp; xDescTabl(v_NouvStatut, "Prop_Statut_" &amp; g_LangueContrat_SDSI, True), v_MSG_Histo, "", True)
			Else
				Call SIHi_Ajouter(pnd_Prop, "", v_MSG_Histo, "", True)
			End If
			
			
			SDSI_EnvoyerBC = True
			
			' Maj du ProfilPersonnel
			If v_PrincipalChoix &lt;&gt; v_Principal_Nouv Then
				Evaluate(|@SetProfileField("F_Pers"; "Pers_EnvoyerParChoix"; "| &amp; v_Principal_Nouv &amp; |"; @UserName);|)
			End If
			
		Else
			If v_Langue = "EN" Then
				Print "Email canceled."
			Else
				Print "Envoie du courriel annulé."
			End If
			Exit Function
		End If
	Else
		If v_Langue = "EN" Then
			Print "No print order available."
		Else
			Print "Pas d'impression de bon de commande disponible."
		End If
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_AssemblerLogiciels"><lotusscript>Function SDSI_AssemblerLogiciels(pnd_Prop As NotesDocument, pnd_Site As NotesDocument, p_NoSite As Long, p_NbCategories As Long, p_FraisMensuel As Double, p_TransfertMontantLG As Double) As Boolean
	' ----------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux logiciels d'un site.
	' ----------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_Langue As String
	Dim i As Long
	Dim v_NomSite As String
	
	SDSI_AssemblerLogiciels = False
	
	v_NomSite = Ucase(xEvaluate(|@If(!@IsNull(Site_ClientNomInterne); Site_ClientNomInterne; @IsNull(Site_ClientNoFmt); Site_ClientNom; (Site_ClientNom1 : Site_ClientNom2))
|, pnd_Site))
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	
	If Not SILT_ExtraireLettreType("SDSI_LogiSite", v_Langue, False) Then
		Exit Function
	End If		
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	' Maj. tableau sommaire	
	If p_TransfertMontantLG = 0 Then
		' supprimer les lignes du tableau
		Call g_WordDoc_SIMW.Tables(2).Rows(1).Delete ' Total
		Call g_WordDoc_SIMW.Tables(2).Rows(1).Delete ' Escompte
	Else
		Call SIMW_TrouverRemplacer("[Site_TotalMensuelLG]", SDSI_FormatDevise(p_FraisMensuel, g_LangueContrat_SDSI))
		Call SIMW_TrouverRemplacer("[Site_EscompteLG]", SDSI_FormatDevise(p_TransfertMontantLG, g_LangueContrat_SDSI))
	End If
	Call SIMW_TrouverRemplacer("[Site_EntretienTotalMensuelLG]", SDSI_FormatDevise((p_FraisMensuel - p_TransfertMontantLG), g_LangueContrat_SDSI))
	
	' Ajouter les départements
	If p_NbCategories &gt; 0 Then
		For i = 1 To p_NbCategories
			Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\LogiCat" &amp; Cstr(i) &amp; ".docx", "[SDSI_LogiCat]",1)
		Next
		Call SIMW_SupprimerTexte("[SDSI_LogiCat]", 1)
	Else
		Call SIMW_SupprimerTexte("[SDSI_LogiCat]", 1)
	End If
	
	' Remplacer les valeurs de la succursale
	Call SIMW_TrouverRemplacer("[Site_ClientNom]", v_NomSite)
	Call SIMW_TrouverRemplacer("[Prop_Devise]", xVar(pnd_Prop, "Prop_Devise", ""))
	
	' Sauvegarder le document Word
	If SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\LogiSite" &amp; Cstr(p_NoSite) &amp; ".docx", "") Then
		
		' Fermer le document Word
		If SIMW_FermerDocument Then
			SDSI_AssemblerLogiciels = True
		End If
	End If
	
	If gc_SupprimerFichiers_SDSI Then
		If p_NbCategories &gt; 0 Then
			For i = 1 To p_NbCategories
				Kill g_DossierTemp_SDSI &amp; "\LogiCat" &amp; Cstr(i) &amp; ".docx"
			Next
		End If
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
	
End Function

</lotusscript></code><code event="SDSI_ChoisirImprimerEnvoyerCT"><lotusscript>Function SDSI_ChoisirImprimerEnvoyerCT(pnd_Prop As NotesDocument, p_CourrielType As String) As String
	' ----------------------------------------------------------
	' 	Choix pour un contrat:
	' 	- il permet de choisir d'imprimer le contrat OU 
	' 		d'envoyer par DocuSign au client.
	'
	' Retourne: 
	'	- "C" Contrat: Imprimer seulement	
	'	- "OSS" Contrat : Envoyer OneSpanSign
	'	- ""  Choix annulé, erreur, non défini.
	' ----------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim nd_DB As NotesDocument
	
	Dim v_EnvoyerCouriel As String
	Dim v_ReponseQ As String	
	
	If xVar(pnd_Prop, "Prop_NbProposition", 0) = 0 Then
		' Le No de proposition n'est pas assigné.
		MessageBox xGDK_xMessage("SDSPP", 129, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	' Initialisations
	SDSI_ChoisirImprimerEnvoyerCT = ""
	Call SDSI_Initialisations
	Call SILT_Initialisations
	
	
	Set nd_DB = New NotesDocument(gndb_SDSI)
	nd_DB.SI_DialogBox = "1"  ' cacher les bts save et X
	
	
	nd_DB.DB_Type = "CT"
	nd_DB.DB_ClientNomLegal = xVar(pnd_Prop, "Prop_ClientNomLegal", "")
	
	If gnuiws_SDSI.DialogBox("DB_ImpEnvQOSSg", True, True, False, False, False, False, _
	xGDK_xMessage("SDSPP", 134, "", xGDK_xMessage("SDSPP", 170, "", "")), nd_DB, True, False, False) Then
		
		v_ReponseQ = xVar(nd_DB, "DB_QuestionChoix", "")
		p_CourrielType = xVar(nd_DB, "DB_ModeleCourriel", "") ' modele de courriel type selectionne	
		
		If v_ReponseQ = "01" Then
			'Enovoyer OneSpanSign								
			SDSI_ChoisirImprimerEnvoyerCT = "OSS"
			
		ElseIf v_ReponseQ = "02" Then
			'Enovoyer DocuSign								
			SDSI_ChoisirImprimerEnvoyerCT = "D"
			
		Else
			'Impression seulement
			SDSI_ChoisirImprimerEnvoyerCT = "C"
		End if
		
	End if
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_NoRepresentantSIRR"><lotusscript>Function SDSI_NoRepresentantSIRR As Integer
	On Error GoTo GererErreur
	
	Dim v_NoRep As String
	Dim nd_Rep As NotesDocument
	
	SDSI_NoRepresentantSIRR = 0
	
	If Left(g_NoRep_SDSI,1) = "R" Then	
		v_NoRep = Mid(g_NoRep_SDSI, 2, Len(g_NoRep_SDSI))
	Else
		v_NoRep = g_NoRep_SDSI
	End If
	
	Set nd_Rep = xSIRR_xndRepr(v_NoRep, False)
	
	If Not nd_Rep Is Nothing Then
		SDSI_NoRepresentantSIRR = v_NoRep
	End If	
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_CalculerMensualitesEQ"><lotusscript>Function SDSI_CalculerMensualitesEQ(pnd As NotesDocument, pa_PeriodeA() As Long, _
	pa_MensualitesEQ() As Double) As Integer
	'-------------------------------------------------------------
	' Le script permet d'ajouter une succursale à une proposition.
	'-------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim nv As NotesView
	Dim ndc As NotesDocumentCollection
	Dim nd_Suivant As NotesDocument
	Dim nd As NotesDocument
	Dim n As Long
	Dim v_Garantie As Long
	Dim i As Long
	Dim v_Frais As Double
	
	SDSI_CalculerMensualitesEQ = False
	
	' Initialisations	
	Set nv = gndb_SDSI.GetView("V_Prod24")
	Call nv.Refresh
	pa_MensualitesEQ(0) = 0
	
	' Boucler sur chaque document
	Set ndc = nv.GetAllDocumentsByKey(xVar(pnd, "Prop_NoProposition", "") &amp; ";EQ.", False)
	If ndc.Count &gt; 0 Then
		Set nd_Suivant = ndc.GetFirstDocument
		Do Until nd_Suivant Is Nothing
			Set nd = nd_Suivant
			Set nd_Suivant = ndc.GetNextDocument(nd_Suivant)
			n = 0
			
			' Si le produit a une période de garantie
			v_Garantie = xVar(nd, "Prod_Garantie", 0)
			If v_Garantie &gt; 0 Then
				' Rechercher l'élément ou il faut insérer la valeur
				While pa_PeriodeA(n) &lt; v_Garantie
					n = n + 1
				Wend
				
				' Insérer un nouvel élément
				If pa_PeriodeA(n) &lt;&gt; v_Garantie Then
					Call SDSI_InsererElementLong(pa_PeriodeA, n)
					Call SDSI_InsererElementDouble(pa_MensualitesEQ, n)
					
					pa_PeriodeA(n) = v_Garantie
				End If
				
				n = n + 1
			End If
			
			' Mettre à jour les mensualités
			For i = n To UBound(pa_MensualitesEQ)
				v_Frais = xVar(nd, "Prod_FraisEntretienAnnuels", 0)
				If v_Frais = 0 Then						' Temporaire
					v_Frais = xVar(nd, "Prod_FraisEntretien", 0) * 12
				End If
				pa_MensualitesEQ(i) = pa_MensualitesEQ(i) + ((xVar(nd, "Prod_Quantite", 0) * v_Frais) / 12)
			Next
		Loop
	End If
	
	SDSI_CalculerMensualitesEQ = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_CreerDocument"><lotusscript>Function SDSI_CreerDocument(pnd_Prop As NotesDocument, p_NomFichierDoc As String, p_Type As String) As Boolean
	'---------------------------------------------
	' Le script permet d'imprimer une proposition.
	'---------------------------------------------
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	
	SDSI_CreerDocument = False
	
	' ********************* Utiliser SDSI_Documents
	If p_Type = "B" Then
		Set nd = SDSPD_CreerDocument_SIDV(xVar(pnd_Prop, "Prop_NoProposition", ""), "1", g_DossierTemp_SDSI &amp; "\" &amp; p_NomFichierDoc,"", "")
	Elseif p_Type = "C" Then
		Set nd = SDSPD_CreerDocument_SIDV(xVar(pnd_Prop, "Prop_NoProposition", ""), "2", g_DossierTemp_SDSI &amp; "\" &amp; p_NomFichierDoc,"", "")
	Elseif p_Type = "S" Then
		Set nd = SDSPD_CreerDocument_SIDV(xVar(pnd_Prop, "Prop_NoProposition", ""), "5", g_DossierTemp_SDSI &amp; "\" &amp; p_NomFichierDoc,"", "")
	End If
	
	If Not nd Is Nothing Then
		SDSI_CreerDocument = True
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
	
End Function



</lotusscript></code><code event="SDSI_ChoisirImprimerEnvoyerBC"><lotusscript>Function SDSI_ChoisirImprimerEnvoyerBC(pnd_Prop As NotesDocument, p_CourrielType As String, p_RepondreA As String) As String
	' ----------------------------------------------------------
	' 	Choix pour un bon de commande:
	' 	- il permet de choisir d'imprimer le bon de commande OU 
	' 		d'envoyer le bon de commande par courriel au client.
	'
	' Retourne: 
	'	- "B" Bon de commande: Imprimer seulement
	'	- "E" Bon de commande : Envoyer par courriel
	'	- "OSS" Bon de commande : Envoyer OneSpanSign
	'	- ""  Choix annulé, erreur, non défini.
	' ----------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim nd_DB As NotesDocument
	
	Dim v_ReponseQ As String
	Dim v_RepondreA As Variant
	Dim v_RepondreADefaut As String
	Dim v_RepondreA_Nouv As String
	
	Dim v_NoRep As String
	
	' Initialisations
	SDSI_ChoisirImprimerEnvoyerBC = ""
	Call SDSI_Initialisations
	Call SILT_Initialisations
	
	' Validation
	If xVar(pnd_Prop, "Prop_NbProposition", 0) = 0 Then
		' Le No de proposition n'est pas assigné.
		MessageBox xGDK_xMessage("SDSPP", 129, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	v_NoRep = SDSI_NoRepresentantSIRR
	
	v_RepondreADefaut = xVarTabl("SLOSS_BCUsr_" &amp; xLangue, "Tabl_ValeurDefaut", "02", True)
	
	Set nd_DB = New NotesDocument(gndb_SDSI)
	nd_DB.SI_DialogBox = "1"  ' cacher les bts save et X
	
	v_RepondreA = p_RepondreA
	
	If v_NoRep &gt; 0 Then
		nd_DB.DB_NoRepresentant = v_NoRep
		nd_DB.ReplyTo = "00"
	Else		
		nd_DB.ReplyTo = v_RepondreA
	End If
	
	nd_DB.DB_Type = "BC"
	nd_DB.DB_ClientNomLegal = xVar(pnd_Prop, "Prop_ClientNomLegal", "")
	
	If gnuiws_SDSI.DialogBox("DB_ImpEnvQOSSg", True, True, False, False, False, False, _
	xGDK_xMessage("SDSPP", 134, "", xGDK_xMessage("SDSPP", 169, "", "")), nd_DB, True, False, False) Then
		
		v_ReponseQ = xVar(nd_DB, "DB_QuestionChoix", "")
		p_CourrielType = xVar(nd_DB, "DB_ModeleCourriel", "") ' modele de courriel type selectionne
		
		If v_ReponseQ = "01" Then
			
			'Envoyer par courriel
			v_RepondreA_Nouv = xVar(nd_DB, "ReplyTo", "00")
			
			If v_RepondreA &lt;&gt; v_RepondreA_Nouv Then											
				Evaluate(|@SetProfileField("F_Pers"; "Pers_RepondreAChoix"; "| &amp; v_RepondreA_Nouv &amp; |"; @UserName);|)
				p_RepondreA = v_RepondreA_Nouv
			End If
			
			SDSI_ChoisirImprimerEnvoyerBC = "E"
			
		ElseIf v_ReponseQ = "02" Then

			If v_NoRep &gt; 0 Then
				v_RepondreA_Nouv = xVar(nd_DB, "ReplyTo", v_RepondreADefaut)
				
				If v_RepondreA &lt;&gt; v_RepondreA_Nouv Then											
					Evaluate(|@SetProfileField("F_Pers"; "Pers_RepondreAChoix"; "| &amp; v_RepondreA_Nouv &amp; |"; @UserName);|)
					p_RepondreA = v_RepondreA_Nouv
				End If
			Else
				v_RepondreA_Nouv = xVar(nd_DB, "ReplyTo", "")
				
				If v_RepondreA &lt;&gt; v_RepondreA_Nouv Then											
					Evaluate(|@SetProfileField("F_Pers"; "Pers_RepondreAChoix"; "| &amp; v_RepondreA_Nouv &amp; |"; @UserName);|)
					p_RepondreA = v_RepondreA_Nouv
				End If
				
			End If

			'Enovoyer DocuSign
			SDSI_ChoisirImprimerEnvoyerBC = "OSS"
			
			
		ElseIf v_ReponseQ = "03" Then

			If v_NoRep &gt; 0 Then
				v_RepondreA_Nouv = xVar(nd_DB, "ReplyTo", v_RepondreADefaut)
				
				If v_RepondreA &lt;&gt; v_RepondreA_Nouv Then											
					Evaluate(|@SetProfileField("F_Pers"; "Pers_RepondreAChoix"; "| &amp; v_RepondreA_Nouv &amp; |"; @UserName);|)
					p_RepondreA = v_RepondreA_Nouv
				End If
			Else
				v_RepondreA_Nouv = xVar(nd_DB, "ReplyTo", "")
				
				If v_RepondreA &lt;&gt; v_RepondreA_Nouv Then											
					Evaluate(|@SetProfileField("F_Pers"; "Pers_RepondreAChoix"; "| &amp; v_RepondreA_Nouv &amp; |"; @UserName);|)
					p_RepondreA = v_RepondreA_Nouv
				End If
			End If

			'Enovoyer DocuSign
			SDSI_ChoisirImprimerEnvoyerBC = "D"
			
		Else
			'Impression seulement
			SDSI_ChoisirImprimerEnvoyerBC = "B"
		End If
		
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererTermePaiement"><lotusscript>Function SDSI_GenererTermePaiement(pnd_Prop As NotesDocument)
	' ------------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux terme de paiement
	' ------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim v_Langue As String
	Dim v_ContratDuree As Integer
	
	' Initialisations
	SDSI_GenererTermePaiement = False
	
	v_Langue = g_LangueContrat_SDSI	
	
	v_ContratDuree = xVar(pnd_Prop, "Prop_ContratDuree","1")
	
	' Créer le document Word
	If 	v_ContratDuree = 4 Or v_ContratDuree = 7 Or v_ContratDuree = 10 Or v_ContratDuree = 66 Or v_ContratDuree = 84 Then
		If Not SILT_ExtraireLettreType("SDSI_TermePaieFn", v_Langue, False) Then
			Exit Function
		End If
	Else
		If Not SILT_ExtraireLettreType("SDSI_TermePaie", v_Langue, False) Then
			Exit Function
		End If
	End If
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	' Sauvegarder le document Word
	If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\TermePaiement.docx", "") Then
		Exit Function
	End If
	
	' Fermer le document Word
	If Not SIMW_FermerDocument Then
		Exit Function
	End If
	
	SDSI_GenererTermePaiement = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_DescProduitsSommLG"><lotusscript>Function SDSI_DescProduitsSommLG(pnd_Prod As Notesdocument, p_NbUtilisateurs As Long) As String
	On Error Goto GererErreur
	
	Dim v_DescCourte As String
	Dim v_TexteSommaire As String
	Dim v_NbUtilisateurs As Long
	
	v_DescCourte = xSDSBB_xVarProd(xVar(pnd_Prod, "Prod_CleProduit", ""), "Prod_DescProduit" &amp; g_LangueContrat_SDSI, "", True) 
	v_TexteSommaire = xSDSBB_xVarProd(xVar(pnd_Prod, "Prod_CleProduitAH", ""), "Prod_PropSommaireTexte" &amp; g_LangueContrat_SDSI, "", True)
	
	v_NbUtilisateurs = 0
	
	If Instr(v_TexteSommaire, "¢NbUtilisateurs!") &gt; 0 Then
		
		v_NbUtilisateurs = xVar(pnd_Prod, "Prod_NbUtilisateursLicense", 0)
		v_TexteSommaire = Replace(v_TexteSommaire, "¢NbUtilisateurs!", Cstr(v_NbUtilisateurs))
		
	Elseif Instr(v_TexteSommaire, "&amp;L") &gt; 0 Then
		
		v_NbUtilisateurs = xVar(pnd_Prod, "Prod_NbUtilisateursLicense", 0)
		v_TexteSommaire = Replace(v_TexteSommaire, "&amp;L", Cstr(v_NbUtilisateurs))
		
	Elseif Instr(v_TexteSommaire, "¢L!") &gt; 0 Then
		
		v_NbUtilisateurs = xVar(pnd_Prod, "Prod_NbUtilisateursLicense", 0)
		v_TexteSommaire = Replace(v_TexteSommaire, "¢L!", Cstr(v_NbUtilisateurs))
		
	Elseif Instr(v_TexteSommaire, "&amp;U") &gt; 0 Then
		
		v_NbUtilisateurs = xVar(pnd_Prod, "Prod_NbUtilisateursCalcule", 0)
		v_TexteSommaire = Replace(v_TexteSommaire, "&amp;U", Cstr(v_NbUtilisateurs))
		
	Elseif Instr(v_TexteSommaire, "¢U!") &gt; 0 Then
		
		v_NbUtilisateurs = xVar(pnd_Prod, "Prod_NbUtilisateursCalcule", 0)
		v_TexteSommaire = Replace(v_TexteSommaire, "¢U!", Cstr(v_NbUtilisateurs))
		
	End If
	
	If v_TexteSommaire &lt;&gt; "" Then
		SDSI_DescProduitsSommLG = v_TexteSommaire
	Else
		SDSI_DescProduitsSommLG= v_DescCourte
	End If
	
	p_NbUtilisateurs = v_NbUtilisateurs
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function


</lotusscript></code><code event="SDSI_CopierCourrielOneSpanMailIn"><lotusscript>Function SDSI_CopierCourrielOneSpanMailIn(pnd_Prop As NotesDocument, pnd_Courriel) As Boolean
	On Error GoTo GererErreur
	
	Dim nd_CourrielMailIn As NotesDocument
	Dim nd_NAB As NotesDocument
	Dim ndb_Courriel As NotesDatabase
	Dim v_ReplyToDesc As String	
	Dim v_From As String
	Dim v_TitreMaiIn As String
	Dim v_ReplyTo As String
	Dim v_level As Integer	
	Dim v_accPriv As Long	
	Dim v_Serveur As String
	Dim v_CourrielRepresentant As String
	Dim v_Courriel As String
	Dim nrti As NotesRichTextItem
	
	SDSI_CopierCourrielOneSpanMailIn = False
	
	'Copier le courriel dans le mail-in		
	Set nd_CourrielMailIn = pnd_Courriel
	
	Set nrti = nd_CourrielMailIn.GetFirstItem("Body")
	
	'Pas de mail-in SDS Demo envoyer copie du courriel dans SDS PO		
	v_ReplyToDesc = xVar(nd_CourrielMailIn, "Cour_ReplyToDesc", "")
	
	If v_ReplyToDesc = "SDS Demo" Then
		v_TitreMaiIn = "SDS PO"
	Else						
		v_TitreMaiIn = v_ReplyToDesc
	End If	
	
	Set nd_NAB = xNAB_xndMailIn(v_TitreMaiIn, True)		
	'Set nd_NAB = xNAB_xndMailIn(xDescTabl(xVar(gnd_CourrielOSSg_SDSI, "Cour_Principal", ""), v_NomTablBCUsr, True), True)
	
	On Error 4060 Resume Next
	Set ndb_Courriel = gns_SDSI.Getdatabase(xVar(nd_NAB, "MailServer", ""), xVar(nd_NAB, "MailFile", ""), False) 
	'v_From = xNAB_xVarMailIn(xDescTabl(v_Principal_Nouv, v_NomTablBCUsr, True), "InternetAddress", "", True)
	
	If v_ReplyToDesc = "SDS Demo" Then
		v_From = v_ReplyTo
	Else
		v_From = xNAB_xVarMailIn(v_ReplyToDesc, "InternetAddress", "", True)
	End If
	
	nd_CourrielMailIn.DeliveredDate = ""
	nd_CourrielMailIn.PostedDate = Now				
	nd_CourrielMailIn.From = v_From
	nd_CourrielMailIn.NoAutoReply = "1"
	
	If Not ndb_Courriel Is Nothing Then
		If Not ndb_Courriel.IsOpen Then
			Set ndb_Courriel = Nothing
		End If
	End If
	
	'Note : Courriel copié dans la vue envoyé du mail-in
	If Not ndb_Courriel Is Nothing Then
		
		v_level = ndb_Courriel.QueryAccess(gns_SDSI.UserName)
		v_accPriv = ndb_Courriel.QueryAccessPrivileges(gns_SDSI.UserName)
		v_Serveur = nd_CourrielMailIn.Parentdatabase.Server
		
		nd_CourrielMailIn.Memo_Serveur = ndb_Courriel.Server
		nd_CourrielMailIn.Memo_Fichier = ndb_Courriel.Filepath
		nd_CourrielMailIn.Memo_Database = ndb_Courriel.Title
		
		'Local
		If v_Serveur = "" Then
			nd_CourrielMailIn.Memo_EnvoyerCourriel = "1"
			Call nd_CourrielMailIn.save(True,False) 
		Else
			If (v_level &gt;= 3) And (v_accPriv And DBACL_CREATE_DOCUMENTS &gt; 0) Then
				If ndb_Courriel.IsOpen Then											
					Call nd_CourrielMailIn.save(True,False) 							
					Call nd_CourrielMailIn.Copytodatabase(ndb_Courriel)																		
				End If
			Else
				nd_CourrielMailIn.Memo_EnvoyerCourriel = "1"
				Call nd_CourrielMailIn.save(True,False) 
			End If
		End If
		
	Else

		'SDS Transfers est Person document et non pas un Mail-in
		Set nd_NAB = xNAB_xndPersonCN(v_TitreMaiIn, True)
		
		If Not nd_NAB Is Nothing Then
			
			v_Courriel = xVar(nd_NAB, "MailAddress", "")  
			nd_CourrielMailIn.SendTo = v_Courriel
			Call nd_CourrielMailIn.Send(False)
			
		End If 		
		
		nd_CourrielMailIn.Memo_Serveur = xVar(nd_NAB, "MailServer", "")
		nd_CourrielMailIn.Memo_Fichier = xVar(nd_NAB, "MailFile", "")
		nd_CourrielMailIn.Memo_Database = v_TitreMaiIn
		
		nd_CourrielMailIn.Memo_EnvoyerCourriel = "1"
		Call nd_CourrielMailIn.save(True,False) 
	End If
	
	' Envoie copie du courriel au représentant
	v_CourrielRepresentant = xVar(pnd_Prop, "Prop_CourrielRepresentantCCOSSg", "")
	
	If v_CourrielRepresentant &lt;&gt; "" Then
		
		nd_CourrielMailIn.Principal = v_From
		
		If xGDK_TypeNDBCourante = "T" Then
			nd_CourrielMailIn.SendTo = gns_SDSI.UserName 
		Else
			nd_CourrielMailIn.SendTo = v_CourrielRepresentant
		End If
		
		Call nd_CourrielMailIn.Send(False)
	End If
	
	
	SDSI_CopierCourrielOneSpanMailIn = True
	
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_BCGenererServices"><lotusscript>Function SDSI_BCGenererServices(pnd_Prop As NotesDocument, pnv_Prod As NotesView, p_NoSite As String, p_Ligne As Integer, p_Total As Double) As Boolean
	' ------------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux services d'un site.
	' ------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim lnd_Services List As NotesDocumentCollection
	Dim lnd_TotauxCategorie List As Double
	Dim nd_Suivant As NotesDocument
	Dim nd As NotesDocument
	Dim ndc As NotesDocumentCollection
	Dim nv_Prod17 As NotesView	
	Dim v_CategorieCourante As String
	Dim v_CategorieSuivante As String
	Dim v_CategorieCouranteDesc As String
	Dim v_CategorieProduit As String
	Dim v_SectionCouranteDesc As String
	Dim v_DescContrat As String
	Dim v_NbSections As Long
	Dim v_NbServices As Long
	Dim v_SectionCourante As String
	Dim v_Section As String
	Dim v_Description As String
	Dim v_TotalCategorie As Double
	Dim v_PrixTotal As Double
	Dim v_WordTable As Variant
	Dim v_WordRow As Variant
	Dim v_NouvelleSection As Boolean
	Dim v_PosProduitImprime As Integer	
	
	' Initialisations
	SDSI_BCGenererServices = False
	v_CategorieCourante = ""
	
	ReDim a_ClesProduitsImprime(1000) As String
	v_PosProduitImprime = 0
	
	Set v_WordTable = g_WordDoc_SIMW.Tables(1)
	
	
	
	' Construire la liste services et liste des totaux par catégorie
	' -------------------------------------------------------------
	Set nv_Prod17 = gndb_SDSI.GetView("V_Prod17")
	Call nv_Prod17.Refresh
	
	
	Set nd_Suivant = nv_Prod17.Getdocumentbykey(p_NoSite, True)
	
	If Not (nd_Suivant Is Nothing) Then
		
		
		
		Do Until nd_Suivant Is Nothing
			Set nd = nd_Suivant
			Set nd_Suivant = nv_Prod17.Getnextdocument(nd_Suivant)
			
			v_CategorieCourante = xVar(nd, "Prod_CategorieProduit", "")	
			v_CategorieSuivante = xVar(nd_Suivant, "Prod_CategorieProduit", "")	
			v_SectionCourante = xVar(nd, "Prod_Section", "")
			
			If xVar(nd_Suivant, "Prod_NoSite", "") &lt;&gt; p_NoSite Then
				Set nd_Suivant = Nothing
				v_CategorieSuivante = ""
			End If
			
			If xVar(nd,"Prod_TypeDescendant", "") = "" THen
				
				If xVar(nd, "Prod_CategorieProduit", "") &lt;&gt; v_CategorieCourante Then
					v_CategorieCourante = xVar(nd, "Prod_CategorieProduit", "")
					v_TotalCategorie = xVar(nd, "Prod_PrixTotal", 0)
				Else
					v_TotalCategorie = v_TotalCategorie + xVar(nd, "Prod_PrixTotal", 0)
				End If	
				
				'If xVar(nd_Suivant, "Prod_NoSite", "") &lt;&gt; p_NoSite Then
				'	Set nd_Suivant = Nothing
				'	v_CategorieSuivante = ""
				'End If
				
				' Ajouter les totaux dans la liste
				'If v_CategorieCourante &lt;&gt; "" And v_TotalCategorie &gt; 0 Then
				If v_CategorieCourante &lt;&gt; "" Then
					If v_CategorieSuivante = "" Or v_CategorieSuivante &lt;&gt; v_CategorieCourante Then
						If Iselement(lnd_TotauxCategorie(v_CategorieCourante)) Then
							lnd_TotauxCategorie(v_CategorieCourante) = v_TotalCategorie + xVar(nd, "Prod_PrixTotal", 0)	
						Else
							lnd_TotauxCategorie(v_CategorieCourante) = v_TotalCategorie
						End If
						v_TotalCategorie = 0
					End If
				End If
				
				' Si quantié &gt; 0 &amp; le service n'est pas une dépense on ajouter dans la liste des services
				If xVar(nd, "Prod_Quantite", 0) &gt; 0 And xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropImpression", "0", True) &lt;&gt; "0" Then
					
					If xVar(nd, "Prod_TypeProduit", 0)&lt;&gt; "1" Then
						
						If Not Iselement(lnd_Services(v_SectionCourante)) Then
							Set ndc = gndb_SDSI.CreateDocumentCollection()
						Else
							Set ndc = lnd_Services(v_SectionCourante)
						End If
						
						If Not ndc.Contains(nd)Then
							Call ndc.addDocument(nd)
							Set lnd_Services(v_SectionCourante) = ndc
						End If
						
					End If
				End If
				
			Else
				If v_CategorieCourante &lt;&gt; "" Then
					If v_CategorieSuivante = "" Or v_CategorieSuivante &lt;&gt; v_CategorieCourante Then
						If IsElement(lnd_TotauxCategorie(v_CategorieCourante)) Then
							lnd_TotauxCategorie(v_CategorieCourante) = v_TotalCategorie + xVar(nd, "Prod_PrixTotal", 0)	
						Else
							lnd_TotauxCategorie(v_CategorieCourante) = v_TotalCategorie
						End If
						v_TotalCategorie = 0
					End If
				End If
				
			End if
		Loop
		
		
	End If
	
	' Boucler les produits par section
	Forall ndc_Section In lnd_Services
		
		v_NouvelleSection = True
		
		v_SectionCourante = Listtag(ndc_Section)
		v_SectionCouranteDesc = xSDSBB_xDescTabl(v_SectionCourante, "Cate_Section" &amp; _
		xVar(nd, "Prod_ClasseProduit", "") &amp;"_" &amp; g_LangueContrat_SDSI, True)
		
		v_NbServices = 0
		v_TotalCategorie = 0
		v_Description = ""
		
		If ndc_Section.Count &gt; 0 Then
			
			Set nd_Suivant = ndc_Section.GetFirstDocument
			
			Do Until nd_Suivant Is Nothing
				Set nd = nd_Suivant
				Set nd_Suivant = ndc_Section.Getnextdocument(nd)
				
				v_CategorieProduit = xVar(nd, "Prod_CategorieProduit", "")
				v_CategorieCourante = xVar(nd, "Prod_CategorieProduit", "")
				v_CategorieCouranteDesc = xSDSBB_xVarCate(xVar(nd, "Prod_CategorieProduit", ""), "Cate_DescCategorie" &amp; g_LangueContrat_SDSI, "", True)
				v_CategorieSuivante = xVar(nd_Suivant, "Prod_CategorieProduit", "")
				
				' Changement de Categorie
				' -----------------------
				If v_CategorieProduit &lt;&gt; v_CategorieCourante And Not nd_Suivant Is Nothing Then
					
					If v_Description &lt;&gt; "" Then
						p_Ligne = p_Ligne + 1
						Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(p_Ligne))
						Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter(v_Description)
						Call v_WordTable.Cell(p_Ligne, 2).Range.InsertAfter("1")
					End If
					
					If Iselement(lnd_TotauxCategorie(v_CategorieCourante)) Then
						v_TotalCategorie = lnd_TotauxCategorie(v_CategorieCourante)
					Else
						v_TotalCategorie = 0
					End If
					
					'If v_TotalCategorie  &gt; 0 And v_NbServices &gt; 0 Then
					If v_NbServices &gt; 0 Then
						Call v_WordTable.Cell(p_Ligne, 3).Range.InsertAfter(SDSI_FormatDevise(v_TotalCategorie, g_LangueContrat_SDSI))
						p_Total = p_Total + v_TotalCategorie
						
						v_TotalCategorie  = 0
						v_NbServices = 0
						v_Description = ""
					End If	
					
					v_CategorieCourante = v_CategorieProduit
					v_CategorieCouranteDesc = xSDSBB_xVarCate(xVar(nd, "Prod_CategorieProduit", ""), "Cate_DescCategorie" &amp; g_LangueContrat_SDSI, "", True)
					
				End If
				
				' Ajouter le produit service
				' --------------------------
				v_NbServices = v_NbServices + 1
				
				If v_NouvelleSection Then
					
					' Si desc. section est le même que desc. catégorie, ne pas imprimer desc. catégorie
					If v_CategorieCouranteDesc = v_SectionCouranteDesc Then
						v_Description = ""
						v_CategorieCouranteDesc = ""
					Else
						v_Description = v_CategorieCouranteDesc
					End If
					
					v_Description = v_SectionCouranteDesc
					p_Ligne = p_Ligne + 1
					Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(p_Ligne))
					Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter(v_Description)
					v_WordTable.Cell(p_Ligne, 1).Range.Bold = True
					v_NouvelleSection = False
					v_Description = ""
				End If
				
				v_DescContrat = (xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_DescContrat" &amp; _
				g_LangueContrat_SDSI, xVar(nd, "Prod_DescProduit" &amp; g_LangueContrat_SDSI, ""), True))
				
				If xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropImpression", "0", True) &lt;&gt; "0" Then
					
					If v_Description &lt;&gt; "" Then
						v_Description = v_Description &amp; g_NewLine_SDSI &amp; v_DescContrat &amp; _
						" [" &amp; xVar(nd, "Prod_CodeProduit", "") &amp; "] : " &amp; Cstr(xVar(nd, "Prod_Quantite", 0)) &amp; " " _
						&amp; (xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_Unite" &amp; _
						g_LangueContrat_SDSI, "", True))
					Else
						If v_CategorieCouranteDesc &lt;&gt; "" Then
							v_Description = v_CategorieCouranteDesc &amp; Chr(13) &amp; v_DescContrat &amp; _
							" [" &amp; xVar(nd, "Prod_CodeProduit", "") &amp; "] : " &amp; Cstr(xVar(nd, "Prod_Quantite", 0)) &amp; " " _
							&amp; (xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_Unite" &amp; _
							g_LangueContrat_SDSI, "", True))
						Else
							v_Description = v_DescContrat &amp; _
							" [" &amp; xVar(nd, "Prod_CodeProduit", "") &amp; "] : " &amp; Cstr(xVar(nd, "Prod_Quantite", 0)) &amp; " " _
							&amp; (xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_Unite" &amp; _
							g_LangueContrat_SDSI, "", True))
						End If
					End If
					
					
				End If
				
				If xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropImpression", "0", True) = "0" Then
					If v_Description &lt;&gt; "" Then
						v_Description = v_Description &amp; g_NewLine_SDSI &amp; v_DescContrat
					Else
						v_Description = v_DescContrat
					End If
				End If
				
				' Si dernier document dans la catégorie
				If nd_Suivant Is Nothing Or v_CategorieCourante &lt;&gt; v_CategorieSuivante Then
					If Iselement(lnd_TotauxCategorie(v_CategorieCourante)) Then
						v_TotalCategorie = lnd_TotauxCategorie(v_CategorieCourante)
					Else
						v_TotalCategorie = 0
					End If
					
					'If v_TotalCategorie  &gt; 0 And v_NbServices &gt; 0 Then
					If v_NbServices &gt; 0 Then
						p_Ligne = p_Ligne + 1
						
						If Not SDSI_BCAjouterService(p_Ligne, v_Description, v_TotalCategorie) Then
							Exit Function
						End If
						
						'If v_TotalCategorie &gt; 0 Then						
						p_Total = p_Total + v_TotalCategorie
						'End If
						
						' Ajouter les dépendants
						If Not SDSI_BCAjouterDependants(pnd_Prop, pnv_Prod, p_Ligne, p_NoSite, xVar(nd, "Prod_NoProduit", ""), v_PrixTotal, 0) Then
							Exit Function
						End If
						
						p_Total = p_Total + v_PrixTotal
						
						v_NbServices = 0
						v_TotalCategorie = 0
						v_Description = ""
					End If
					
					
				End If
				
			Loop
			
		End If
		
		v_NbSections = v_NbSections + 1
		
	End Forall
	

	SDSI_BCGenererServices = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_ImprimerProposition"><lotusscript>Function SDSI_ImprimerProposition(pnd_Prop As NotesDocument, p_Unique As String) As Boolean
	' --------------------------------------------
	' Le script permet d'imprimer une proposition.
	' --------------------------------------------
	On Error Goto GererErreur
	
	Dim v_Choix As String
	Dim v_Type As String
	Dim v_TypeDesc As String
	Dim v_Impression As Boolean
	Dim v_Envoyer As Boolean
	Dim v_ContratRequis As Boolean
	Dim v_CourrielType As String
	Dim v_Roles As Variant
	Dim v_RepondreA As String
	
	
	' Initialisations
	SDSI_ImprimerProposition = False
	Call SDSI_Initialisations
	Call SILT_Initialisations
	
	If xVar(pnd_Prop, "Prop_NbProposition", 0) &lt; 1 Then
		' Le No de proposition n'est pas assigné.
		Messagebox xGDK_xMessage("SDSPP", 129, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	
	g_NoProposition_SDSI = xVar(pnd_Prop, "Prop_NoProposition", "")
	g_NbProposition_SDSI = Cstr(xVar(pnd_Prop, "Prop_NbPropositionTXT", 0))
	g_LangueContrat_SDSI = xVar(pnd_Prop, "Prop_Langue", "FR")
	g_NoRep_SDSI = gns_SDSI.GetEnvironmentString("SDSPP_NoRep")
	
	
	If  xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then
		' Toujours imprimer une proposition SaaS sur un contrat
		v_ContratRequis = True
	Else
		v_ContratRequis = SDSI_ContratRequis(pnd_Prop)
	End if
	
	' Si type non défini, le déterminer en fonction des produits
	If v_ContratRequis Then	' Contrat requis
		v_Type = "C"				
	Else
		v_Type = "B"
	End If
	
	' Vérifier les rôles donnant les droits d'envoyer le document pour signature par OneSpanSign
	'v_Roles = Evaluate({@IsMember("[OneSpanSign]"; @UserRoles)})
	v_Roles = Evaluate({(@IsMember("[DocuSign]"; @UserRoles) | @IsMember("[OneSpanSign]"; @UserRoles))})
	v_RepondreA = xVarPers("Pers_RepondreAChoix","00")	
	
	' Imprimer un contrat ou un bon de commande
	Select Case v_Type
		Case "B":
			v_Choix = SDSI_ChoisirImprimerEnvoyerBC(pnd_Prop, v_CourrielType, v_RepondreA) 'Ajouter parametre pour modele de type courriel defini dans Admin
			
			If v_Choix = "E" Then
				
				If SDSI_EnvoyerBC(pnd_Prop, v_CourrielType, v_RepondreA, v_Choix) Then  ' BC envoyer par courriel, 'Ajouter parametre pour modele de type courriel defini dans Admin
					v_Impression = True
					v_Envoyer = True
				End If
				
			Elseif v_Choix = "OSS" Then

				If SDSI_EnvoyerOneSpanSign(pnd_Prop, v_Type, v_CourrielType, v_RepondreA, v_Choix) Then 
					v_Impression = True
					v_Envoyer = True
				End if	
				
			ElseIf v_Choix = "D" Then

				If SDSI_EnvoyerDocuSign(pnd_Prop, v_Type, v_CourrielType, v_RepondreA, v_Choix) Then 
					v_Impression = True
					v_Envoyer = True
				End If	
				
			Elseif v_Choix = "B" Then
				v_Impression = SDSI_ImprimerBonCommande(pnd_Prop, p_Unique, True, False, "", v_Choix) ' BC imprimer
			Else
				' Impression annulée.
				Print xGDK_xMessage("SI", 6, xLangue, "" )
				v_Impression = False
			End If
			
		Case "C":
			
			If v_Roles(0) = 1 Then
				' Demander à l'utilisateur si impression ou envoyer OneSpanSign
				v_Choix = SDSI_ChoisirImprimerEnvoyerCT(pnd_Prop, v_CourrielType) 'Ajouter parametre pour modele de type courriel defini dans Admin
			Else
				' Imprimer le contrat
				v_TypeDesc = LCase(xGDK_xMessage("SDSP", 103, "", ""))
				If gnuiws_SDSI.Prompt(PROMPT_YESNO, xGDK_xMessage("SDSP", 102, "", v_TypeDesc), _
				xGDK_xMessage("SDSP", 106, "", v_TypeDesc) &amp; " " &amp; xGDK_xMessage("SI", 185, "", v_TypeDesc)) &lt;&gt; 1 Then
					Exit Function
				Else
					v_Choix = "C"
				End If
			End If
			
			If v_Choix = "C" Then 								
				v_Impression = SDSI_ImprimerContrat(pnd_Prop, p_Unique, True, False, "", 1)		
				
				
			ElseIf v_Choix = "OSS" Then				
				If SDSI_EnvoyerOneSpanSign(pnd_Prop, v_Type, v_CourrielType, v_RepondreA, v_Choix) Then 
					v_Impression = True
					v_Envoyer = True
				End If	
				
			ElseIf v_Choix = "D" Then				
				If SDSI_EnvoyerDocuSign(pnd_Prop, v_Type, v_CourrielType, v_RepondreA, v_Choix) Then 
					v_Impression = True
					v_Envoyer = True
				End If
				
			End if
			
		Case Else
			v_Impression = False
	End Select
	
	If v_Impression Then
		
		' Maj de la proposition
		If xVar(pnd_Prop, "Prop_PropositionImprimee", "") &lt;&gt; "1" Then
			pnd_Prop.Prop_PropositionImprimee = "1"
			Call pnd_Prop.Save(True, False)
		End If
		
		If v_Envoyer Then
			pnd_Prop.Prop_PropositionEnvoyee = "1"
		End If
	End If
	
	
	SDSI_ImprimerProposition = v_Impression
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_BCAjouterDependants"><lotusscript>Function SDSI_BCAjouterDependants(pnd_Prop As NotesDocument, pnv_Prod As NotesView, p_Ligne As Integer,  p_NoSite As String, _
	p_NoProduitParent As String, p_Total As Double, p_FraisMensuelTotal As Double) As Boolean
	' ----------------------------------------------------------------------------------------------
	' Le script permet d'ajouter les dépendants d'un produit dans le document Word. 	
	' ----------------------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim ndc_ProdDependants As NotesDocumentCollection
	Dim nd_ProdDepe As NotesDocument	
	Dim nd_ProdDepeSuivant As NotesDocument	
	Dim v_DescContrat As String
	Dim v_Description As String
	Dim v_Frais As Double
	Dim v_Quantite As Integer
	Dim v_FraisMensuel As Double	
	Dim v_Cle As String
	Dim v_Continue As Boolean
	
	SDSI_BCAjouterDependants = False
	
	v_Cle = xVar(pnd_Prop, "Prop_NoProposition", "") + ";" + p_NoSite + ";" + p_NoProduitParent + ";" + "D"
	Set ndc_ProdDependants = pnv_Prod.Getalldocumentsbykey(v_Cle, True)
	If ndc_ProdDependants.Count &gt; 0 Then
		
		Set nd_ProdDepeSuivant = ndc_ProdDependants.GetFirstDocument
		Do Until nd_ProdDepeSuivant Is Nothing
			Set nd_ProdDepe = nd_ProdDepeSuivant
			Set nd_ProdDepeSuivant = ndc_ProdDependants.Getnextdocument(nd_ProdDepeSuivant)
			
			v_Quantite = xVar(nd_ProdDepe, "Prod_Quantite", 0)
			If v_Quantite &gt; 0 Then
				v_Continue = True
				
				Select Case xVar(nd_ProdDepe, "Prod_ClasseProduit", "")
				Case "EQ" :
					p_Ligne = p_Ligne + 1	
					If Not SDSI_BCAjouterEquipement(nd_ProdDepe, p_Ligne) Then
						Exit Function
					End If	
					
					p_Total = p_Total + (v_Quantite * xVar(nd_ProdDepe, "Prod_PrixUnitaire", 0))
					
				Case "LG" :
					p_Ligne = p_Ligne + 1	
					v_Description = SDSI_DescProduitsLG(pnd_Prop, nd_ProdDepe,0) &amp; " [" &amp; xVar(nd_ProdDepe, "Prod_CodeProduit", "") &amp; "]"	
					
					v_Frais = xVar(nd_ProdDepe, "Prod_FraisEntretienAnnuels", 0) * v_Quantite
					
					If v_Frais = 0 Then	
						v_Frais = (xVar(nd_ProdDepe, "Prod_FraisEntretien", 0) * 12) * v_Quantite
					End If
					
					If v_Frais &gt; 0 Then					
						'v_FraisMensuel = (v_Frais /12) / xVar(nd, "Prod_Quantite", 0) 
						v_FraisMensuel = SItN_Round(v_Frais/12, 2) / v_Quantite 
					Else				 
						v_FraisMensuel = xVar(nd_ProdDepe, "Prod_FraisEntretien", 0) / v_Quantite
					End If
					
					If Not SDSI_BCAjouterLogiciel(nd_ProdDepe, v_Description, p_Ligne, v_FraisMensuel) Then
						Exit Function
					End If
					
					p_FraisMensuelTotal = p_FraisMensuelTotal + (v_FraisMensuel * v_Quantite)
					
				Case "SV" :
					p_Ligne = p_Ligne + 1	
					v_DescContrat = (xSDSBB_xVarProd(xVar(nd_ProdDepe, "Prod_CleProduit", ""), "Prod_DescContrat" &amp; _
					g_LangueContrat_SDSI, xVar(nd_ProdDepe, "Prod_DescProduit" &amp; g_LangueContrat_SDSI, ""), True))

					v_Description = v_DescContrat &amp; _
					" [" &amp; xVar(nd_ProdDepe, "Prod_CodeProduit", "") &amp; "] : " &amp; CStr(xVar(nd_ProdDepe, "Prod_Quantite", 0)) &amp; " " _
					&amp; (xSDSBB_xVarProd(xVar(nd_ProdDepe, "Prod_CleProduit", ""), "Prod_Unite" &amp; _
					g_LangueContrat_SDSI, "", True))
					
					If Not SDSI_BCAjouterService(p_Ligne, v_Description, xVar(nd_ProdDepe, "Prod_PrixTotal", 0)) Then
						Exit Function
					End If
					
					p_Total = p_Total + xVar(nd_ProdDepe, "Prod_PrixTotal", 0)
					
				Case Else:
					v_Continue = False
			End Select
				
				' Ajouter les dépendants
				If v_Continue Then
					If Not SDSI_BCAjouterDependants(pnd_Prop, pnv_Prod, p_Ligne, p_NoSite, xVar(nd_ProdDepe, "Prod_NoProduit", ""), p_Total, p_FraisMensuelTotal) Then
						Exit Function
					End If
				End If
			End If
		Loop
	End If
	
	SDSI_BCAjouterDependants = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_EntretienMensuelTotal"><lotusscript>Function SDSI_EntretienMensuelTotal(pnd_Prop As NotesDocument, p_EntretienMensuelEQ As Double, _
	p_EntretienMensuelLG As Double) As Double
	On Error GoTo GererErreur
	' ----------------------------------------------------------------------------
	' Le script permet de déterminer l'entretien mensuel total d'une proposition.
	' Si les entretien mensuel EQ et LG ne sont pas requis, passer 0 en paramètre.
	' ----------------------------------------------------------------------------
	
	Dim v_Prop_EntretienAnnuelLG As Double
	Dim v_Prop_EntretienMensuelLG As Double
	Dim v_Prop_EntretienAnnuelEQ As Double
	Dim v_Prop_EntretienMensuelEQ As Double
	Dim v_TauxMaj As Double
	
	SDSI_EntretienMensuelTotal = 0
	
	v_Prop_EntretienAnnuelLG = xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod20"; "| &amp; _
	CStr(xVar(pnd_Prop, "Prop_NoProposition", "")) &amp; |"+ ";LG."; 8 ;[PartialMatch]); 0))|, Nothing)
	
	v_TauxMaj = xVarProf("Prof_LGMajoMens", 1)
	
	v_Prop_EntretienMensuelLG = (v_Prop_EntretienAnnuelLG * v_TauxMaj) / 12
	
	' Calculer entretien mensuel EQ
	v_Prop_EntretienAnnuelEQ = xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod20"; "| &amp; _
	CStr(xVar(pnd_Prop, "Prop_NoProposition", "")) &amp; |"+ ";EQ."; 8 ;[PartialMatch]); 0))|, Nothing)
	
	v_TauxMaj = xVarProf("Prof_EQMajoMens", 1)
	
	v_Prop_EntretienMensuelEQ = (v_Prop_EntretienAnnuelEQ * v_TauxMaj) / 12
	
	p_EntretienMensuelEQ = v_Prop_EntretienMensuelEQ
	p_EntretienMensuelLG = v_Prop_EntretienMensuelLG
	
	SDSI_EntretienMensuelTotal = (v_Prop_EntretienMensuelEQ + v_Prop_EntretienMensuelLG)
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererNotesSertiBC"><lotusscript>Function SDSI_GenererNotesSertiBC(pnd_Prop As NotesDocument, p_Choix As String, p_RepondreA As String) As Boolean
	' ------------------------------------------------
	' Le script permet de générer les notes Serti
	' ------------------------------------------------
	On Error GoTo GererErreur
	
	Dim v_Langue As String
	Dim v_NomLettreType As String
	Dim v_NomFichier As String
	Dim v_NotesContrat As String
	
	SDSI_GenererNotesSertiBC = False
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	Select Case p_Choix
			
		Case "B"
			If p_RepondreA = "01" Then			
				v_NomLettreType = "SDSI_BComNotesSDSTF"
				v_NomFichier = "SDSI_BComNotesOSSTF.docx"
			ElseIf p_RepondreA = "" Or p_RepondreA = "02" Then
				v_NomLettreType = "SDSI_BComNotesSDSPO"
				v_NomFichier = "SDSI_BComNotesOSSPO.docx"
			ElseIf p_RepondreA = "03" Then	
				v_NomLettreType = "SDSI_BComNotesSDSFO"
				v_NomFichier = "SDSI_BComNotesOSSFO.docx"
			End If
			
		Case "D"
			If p_RepondreA = "01" Then			
				v_NomLettreType = "SLDS_BComNotesSDSTF"
				v_NomFichier = "SLDS_BComNotesDSTF.docx"
			ElseIf p_RepondreA = "02" Then
				v_NomLettreType = "SLDS_BComNotesSDSPO"
				v_NomFichier = "SLDS_BComNotesDSPO.docx"
			ElseIf p_RepondreA = "03" Then	
				v_NomLettreType = "SLDS_BComNotesSDSFO"
				v_NomFichier = "SLDS_BComNotesDSFO.docx"
			End If
			
		Case "OSS"
			If p_RepondreA = "01" Then			
				v_NomLettreType = "SLOSS_BComNotesSDSTF"
				v_NomFichier = "SLOSS_BComNotesOSSTF.docx"
			ElseIf p_RepondreA = "02" Then
				v_NomLettreType = "SLOSS_BComNotesSDSPO"
				v_NomFichier = "SLOSS_BComNotesOSSPO.docx"
			ElseIf p_RepondreA = "03" Then	
				v_NomLettreType = "SLOSS_BComNotesSDSFO"
				v_NomFichier = "SLOSS_BComNotesOSFO.docx"
			ElseIf p_RepondreA = "04" Then   'MZE #59016	
				v_NomLettreType = "SLOSS_BComNotesSDSDP"
				v_NomFichier = "SLOSS_NotesBComOSSSDSDP.docx"	
			End If
			
		Case "E"
			If p_RepondreA = "00" Then
				v_NomLettreType = "SDSE_BComNotesSDSPO"
				v_NomFichier = "SDSE_BComNotesOSSPO.docx"
			ElseIf p_RepondreA = "01" Then			
				v_NomLettreType = "SDSE_BComNotesSDSTF"
				v_NomFichier = "SDSE_BComNotesOSSTF.docx"
			ElseIf p_RepondreA = "02" Then
				v_NomLettreType = "SDSE_BComNotesSDSPO"
				v_NomFichier = "SDSE_BComNotesOSSPO.docx"
			ElseIf p_RepondreA = "03" Then	
				v_NomLettreType = "SDSE_BComNotesSDSFO"
				v_NomFichier = "SDSE_BComNotesOSSFO.docx"
			ElseIf p_RepondreA = "04" Then	'MZE #59016	
				v_NomLettreType = "SDSE_BComNotesSDSDP"
				v_NomFichier = "SDSE_BComNotesOSSDP.docx"	
			End If
			
		Case Else
			SDSI_GenererNotesSertiBC = False
			Exit Function	
			
	End Select
	
	
	If Not SILT_ExtraireLettreType(v_NomLettreType, v_Langue, False) Then
		Exit Function
	End If
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	' Sauvegarder le document Word
	If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\BComNotesSerti.docx", "") Then
		Exit Function
	End If
	
	' Fermer le document Word
	If Not SIMW_FermerDocument Then
		Exit Function
	End If
	
	SDSI_GenererNotesSertiBC = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererPrixPaiement"><lotusscript>Function SDSI_GenererPrixPaiement(pnd_Prop As NotesDocument)
	' ------------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux prix de paiement
	' ------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim v_Langue As String
	Dim v_TypeContrat As String
	Dim v_Escompte As Double
	Dim v_MontantFinancer As Double
	Dim v_MontantFinancerMensuel As Double
	Dim v_MontantFinancer5Ans As Double
	Dim v_Taux As Double
	Dim v_TotalMensuelLG As Double
	Dim v_ContratDuree As Integer
	Dim v_TotalLGS1 As Double
	Dim v_TotalLGS2 As Double
	Dim v_EscompteMensualite As Double
	Dim a_MontantsSectionsLGSite As Variant
	Dim v_TauxContrat As Integer
	Dim v_PeriodeContrat As String
	
	
	' Initialisations
	SDSI_GenererPrixPaiement = False
	
	v_Langue = g_LangueContrat_SDSI	
	v_Escompte = (xVar(pnd_Prop, "Prop_EscompteMontant", 0) + xVar(pnd_Prop, "Prop_EscompteCorporatif", 0))
	
	v_TauxContrat = xVar(pnd_Prop, "Prop_TauxContrat", 0)
	v_PeriodeContrat = xSDSBB_xComplTabl(xVar(pnd_Prop, "Prop_ContratDuree","1"), "Prop_ContDuree_" &amp; v_Langue, "1",True)
	
	If v_PeriodeContrat = "" Then
		v_PeriodeContrat = "12"
	End If
	
	If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then 'Conversion
		v_TypeContrat = "SDSI_ContConv"
	Else
		v_TypeContrat = "SDSI_Cont"
	End If
	
	v_ContratDuree = xVar(pnd_Prop, "Prop_ContratDuree",1)
	
	' Créer le document Word
	If v_TypeContrat = "SDSI_ContConv" Then
		''	If Not SILT_ExtraireLettreType("SDSI_PrixPaieConv", v_Langue, False) Then
		''		Exit Function
		''	End If
		
		' 4= financement 5 ans, 7 = finacement 3 ans, 10 = financement  6 ans
		If 	v_ContratDuree = 4 Or v_ContratDuree = 7 Or v_ContratDuree = 10 Or v_ContratDuree = 66 Or v_ContratDuree = 84 Then
			
			If v_TauxContrat = 0 Then
				If Not SILT_ExtraireLettreType("SDSI_PrixPaieConvFn_0%", v_Langue, False) Then
					Exit Function
				End If
			Else
				If Not SILT_ExtraireLettreType("SDSI_PrixPaieConvFn_Standard", v_Langue, False) Then
					Exit Function
				End If
				
			End If
			
		Else

			If v_TauxContrat = 0 Then
				If Not SILT_ExtraireLettreType("SDSI_PrixPaieConv_0%", v_Langue, False) Then
					Exit Function
				End If
			Else
				If Not SILT_ExtraireLettreType("SDSI_PrixPaieConv_Standard", v_Langue, False) Then
					Exit Function
				End If
				
			End If

			
		End If
		
		
		
		
	Else
		' 4= financement 5 ans, 7 = finacement 3 ans, 10 = financement  6 ans
		If 	v_ContratDuree = 4 Or v_ContratDuree = 7  Or v_ContratDuree = 10 Or v_ContratDuree = 66 Or v_ContratDuree = 84 Then
			
			If v_TauxContrat = 0 Then
				If Not SILT_ExtraireLettreType("SDSI_PrixPaieFn_0%", v_Langue, False) Then
					Exit Function
				End If
			Else
				If Not SILT_ExtraireLettreType("SDSI_PrixPaieFn_Standard", v_Langue, False) Then
					Exit Function
				End If
				
			End If
			
		Else

			If v_TauxContrat = 0 Then
				If Not SILT_ExtraireLettreType("SDSI_PrixPaie_0%", v_Langue, False) Then
					Exit Function
				End If
			Else
				If Not SILT_ExtraireLettreType("SDSI_PrixPaie_Standard", v_Langue, False) Then
					Exit Function
				End If
				
			End If

			
		End If
	End If
	
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	' Call SIMW_TrouverRemplacer("[Prop_MontantFinancerTexte]", 
	' Call SIMW_TrouverRemplacer("[Prop_MontantFinancerCentsTexte]", 
	' Call SIMW_TrouverRemplacer("[Prop_MontantFinancer]",
	
	v_MontantFinancer = (SDSI_MontantTotal(pnd_Prop, 0, 0) - v_Escompte)	
	v_MontantFinancerMensuel = v_MontantFinancer / CInt(v_PeriodeContrat) '12
	v_MontantFinancer5Ans = SItN_Round(v_MontantFinancer / 60, 2)
	v_Taux = xVar(pnd_Prop, "Prop_TauxContrat", 0)
	
	Call SIMW_TrouverRemplacer("[Prop_MontantFinancer]", SDSI_FormatDevise(v_MontantFinancer, g_LangueContrat_SDSI))
	Call SIMW_TrouverRemplacer("[Prop_MontantFinancerTexte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_MontantFinancer)), v_Langue)))
	
	Call SIMW_TrouverRemplacer("[Prop_Taux]", CStr(v_Taux))
	REM Call SIMW_TrouverRemplacer("[Prop_TauxTexte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_Taux)), v_Langue))) '
	
	
	If v_Taux = 0 Then
		
		If v_Langue = "EN" Then	
			Call SIMW_TrouverRemplacer("[Prop_TauxTexte]", "ZERO")
		Else
			Call SIMW_TrouverRemplacer("[Prop_TauxTexte]", "ZÉRO")
		End If		
		Call SIMW_TrouverRemplacer("[Prop_TauxCentiemeTexte]", "")		
		
	Else

		Call SIMW_TrouverRemplacer("[Prop_TauxTexte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_Taux)), v_Langue)))

		If Fraction(v_Taux) = 0 Then
			Call SIMW_TrouverRemplacer("[Prop_TauxCentiemeTexte]", "")		
		Else
			If v_Langue = "EN" Then	
				Call SIMW_TrouverRemplacer("[Prop_TauxCentiemeTexte]", " and " &amp;UCase(SItN_NombreEnLettres(CLng((Fraction(v_Taux) * 100)), v_Langue)) &amp; " hundredths")
			Else
				Call SIMW_TrouverRemplacer("[Prop_TauxCentiemeTexte]", " et " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_Taux) * 100)), v_Langue)) &amp; " centième")
			End If
		End If

	End If
	
	If Fraction(v_MontantFinancer) = 0 Then
		Call SIMW_TrouverRemplacer("[Prop_MontantFinancerCentsTexte]", "")
	Else
		If v_Langue = "EN" Then
			Call SIMW_TrouverRemplacer("[Prop_MontantFinancerCentsTexte]", " and " &amp;UCase(SItN_NombreEnLettres(CLng((Fraction(v_MontantFinancer) * 100)), v_Langue)) &amp; " cents")
		Else
			Call SIMW_TrouverRemplacer("[Prop_MontantFinancerCentsTexte]", " et " &amp;UCase(SItN_NombreEnLettres(CLng((Fraction(v_MontantFinancer) * 100)), v_Langue)) &amp; " cents")	
		End If
		
	End If
	
	' 4= financement 5 ans, 7 = finacement 3 ans, 10 = financement  6 ans
	If 	v_ContratDuree = 4 Or v_ContratDuree = 7 Or v_ContratDuree = 10 Or v_ContratDuree = 66 Or v_ContratDuree = 84 Then
		
		'[Prop_PrixFinance]
		Call SIMW_TrouverRemplacer("[Prop_PrixFinance]", SDSI_FormatDevise(v_MontantFinancer5Ans, g_LangueContrat_SDSI))
		
		'[Prop_FinanceTexte]
		Call SIMW_TrouverRemplacer("[Prop_FinanceTexte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_MontantFinancer5Ans)), v_Langue)))
		'[Prop_PrixFinanceCentsTexte]
		If Fraction(v_MontantFinancer5Ans) = 0 Then
			Call SIMW_TrouverRemplacer("[Prop_PrixFinanceCentsTexte]", "")
		Else
			If v_Langue = "EN" Then
				Call SIMW_TrouverRemplacer("[Prop_PrixFinanceCentsTexte]", " and " &amp;UCase(SItN_NombreEnLettres(CLng((Fraction(v_MontantFinancer5Ans) * 100)), v_Langue)) &amp; " cents")
			Else
				Call SIMW_TrouverRemplacer("[Prop_PrixFinanceCentsTexte]", " et " &amp;UCase(SItN_NombreEnLettres(CLng((Fraction(v_MontantFinancer5Ans) * 100)), v_Langue)) &amp; " cents")	
			End If
			
		End If
		
		Call SIMW_TrouverRemplacer("[Prop_MontantFinancerMensuel]", SDSI_FormatDevise(v_MontantFinancerMensuel, g_LangueContrat_SDSI))
		Call SIMW_TrouverRemplacer("[Prop_MontantFinancerMensuelTexte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_MontantFinancerMensuel)), v_Langue)))
		
		If Fraction(v_MontantFinancerMensuel) = 0 Then
			Call SIMW_TrouverRemplacer("[Prop_MontantFinancerMensuelCentsTexte]", "")
		Else
			If v_Langue = "EN" Then
				Call SIMW_TrouverRemplacer("[Prop_MontantFinancerMensuelCentsTexte]", " and " &amp;UCase(SItN_NombreEnLettres(CLng((Fraction(v_MontantFinancerMensuel) * 100)), v_Langue)) &amp; " cents")
			Else
				Call SIMW_TrouverRemplacer("[Prop_MontantFinancerMensuelCentsTexte]", " et " &amp;UCase(SItN_NombreEnLettres(CLng((Fraction(v_MontantFinancerMensuel) * 100)), v_Langue)) &amp; " cents")	
			End If
			
		End If
		
	End If
	
	
	If v_TypeContrat &lt;&gt; "SDSI_ContConv" Then
		
		v_TotalMensuelLG = (g_EntretienTotalLG_SDSI - g_EscompteTotalLG_SDSI)
		
		Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLG]", SDSI_FormatDevise(v_TotalMensuelLG, v_Langue))	
		Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLGTexte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_TotalMensuelLG)), v_Langue)))
		
		If Fraction(v_TotalMensuelLG) = 0 Then
			Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLGCentsTexte]", "")
		Else
			If v_Langue = "EN" Then
				Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLGCentsTexte]", " and " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_TotalMensuelLG) * 100)), v_Langue)) &amp; " cents")
			Else
				Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLGCentsTexte]", " et " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_TotalMensuelLG) * 100)), v_Langue)) &amp; " cents")
			End If		
		End If
	End If
	
	If v_TypeContrat = "SDSI_ContConv" Then
		
		a_MontantsSectionsLGSite = xListElem(gl_MontantsSectionsLGSites_SDSI,xVarElem(pnd_Prop, "Prop_NoSites", 0 , ""), 0) 
		
		v_EscompteMensualite = xVar(pnd_Prop, "Prop_EscompteMensualite", 0)
		v_TotalLGS1 = CDbl(a_MontantsSectionsLGSite(2) + a_MontantsSectionsLGSite(3) - v_EscompteMensualite)	
		v_TotalLGS2 = CDbl(a_MontantsSectionsLGSite(1) + a_MontantsSectionsLGSite(2) + a_MontantsSectionsLGSite(3) - v_EscompteMensualite)
		
		Call SIMW_TrouverRemplacer("[Prop_TotalLGS1]", SDSI_FormatDevise(v_TotalLGS1, v_Langue))
		Call SIMW_TrouverRemplacer("[Prop_TotalLGS1Texte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_TotalLGS1)), v_Langue)))
		
		If Fraction(v_TotalLGS1) = 0 Then
			Call SIMW_TrouverRemplacer("[Prop_TotalLGS1CentsTexte]", "")
		Else
			If v_Langue = "EN" Then
				Call SIMW_TrouverRemplacer("[Prop_TotalLGS1CentsTexte]", " and " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_TotalLGS1) * 100)), v_Langue)) &amp; " cents")
			Else
				Call SIMW_TrouverRemplacer("[Prop_TotalLGS1CentsTexte]", " et " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_TotalLGS1) * 100)), v_Langue)) &amp; " cents")
			End If
		End If	
		
		Call SIMW_TrouverRemplacer("[Prop_TotalLGS2]", SDSI_FormatDevise(v_TotalLGS2, v_Langue))
		Call SIMW_TrouverRemplacer("[Prop_TotalLGS2Texte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_TotalLGS2)), v_Langue)))
		
		If Fraction(v_TotalLGS2) = 0 Then
			Call SIMW_TrouverRemplacer("[Prop_TotalLGS2CentsTexte]", "")
		Else
			If v_Langue = "EN" Then
				Call SIMW_TrouverRemplacer("[Prop_TotalLGS2CentsTexte]", " and " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_TotalLGS2) * 100)), v_Langue)) &amp; " cents")
			Else
				Call SIMW_TrouverRemplacer("[Prop_TotalLGS2CentsTexte]", " et " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_TotalLGS2) * 100)), v_Langue)) &amp; " cents")
			End If
		End If
		
		'''''''''''''''''''''TEST
		Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLG]", SDSI_FormatDevise(v_MontantFinancerMensuel,v_Langue))	
		Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLGTexte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_MontantFinancerMensuel)), v_Langue)))
		
		If Fraction(v_MontantFinancerMensuel) = 0 Then
			Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLGCentsTexte]", "")
		Else
			If v_Langue = "EN" Then
				Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLGCentsTexte]", " and " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_MontantFinancerMensuel) * 100)), v_Langue)) &amp; " cents")
			Else
				Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLGCentsTexte]", " et " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_MontantFinancerMensuel) * 100)), v_Langue)) &amp; " cents")
			End If		
		End If
		'''''''''''''''''''''''''''
		
	End If
	
	
	' Sauvegarder le document Word
	If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\PrixPaiement.docx", "") Then
		Exit Function
	End If
	
	' Fermer le document Word
	If Not SIMW_FermerDocument Then
		Exit Function
	End If
	
	SDSI_GenererPrixPaiement = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererEquipement"><lotusscript>Function SDSI_GenererEquipement(pnd_Prop As NotesDocument, pnd_Site As NotesDocument, p_NbSite As Long) As Boolean
	' ------------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux équipements d'un site.
	' ------------------------------------------------------------------------------
	On Error Goto GererErreur
	Dim nv As NotesView
	Dim v_NoSite As String
	Dim v_Cle As String
	Dim ndc As NotesDocumentCollection
	Dim nd_Suivant As Notesdocument
	Dim nd As NotesDocument
	Dim v_PremiereCategorie As Boolean
	Dim v_CategorieCourante As String
	Dim v_NouvelleCategorie As Boolean
	Dim v_NbCategories As Long
	Dim v_PrixTotal As Double
	Dim v_Langue As String
	Dim v_WordTable As Variant
	Dim v_Ligne As Integer
	
	' Initialisations
	SDSI_GenererEquipement = False
	v_PremiereCategorie = True
	v_CategorieCourante= "QWERTY"
	v_PrixTotal = 0
	v_Ligne = 1
	
	' Générer l'équipement par département
	' ------------------------------------
	Set nv = gndb_SDSI.GetView("v_Prod31" &amp; xLangue)
	Call nv.Refresh
	
	v_NoSite = xVar(pnd_Site, "Site_NoSite", "")
	Set nd_Suivant = nv.GetdocumentByKey((g_NoProposition_SDSI &amp; ";" &amp; v_NoSite &amp; ";EQ"), False)
	
	Do Until nd_Suivant Is Nothing
		Set nd = nd_Suivant
		Set nd_Suivant = nv.Getnextdocument(nd_Suivant)
		
		v_Cle = Cstr(xVar(nd_Suivant, "Prod_NoSite", "") &amp; ";" &amp; xVar(nd_Suivant,"Prod_ClasseProduit",""))
		If v_Cle &lt;&gt; (v_NoSite &amp; ";EQ") Then 
			Set nd_Suivant = Nothing
		End If
		
		If xVar(nd, "Prod_TypeDescendant","") &lt;&gt; "C" And xVar(nd,"Prod_ClasseProduit","") = "EQ" Then
			'If (xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropImpression", "0", True) &lt;&gt; "0" And xVar(nd, "Prod_Quantite", 0) &gt; 0) Then
			If xVar(nd, "Prod_Quantite", 0) &gt; 0 Then
				
				' Changement de département
				' -------------------------
				If xVar(nd, "Prod_Departement", "") &lt;&gt; v_CategorieCourante Then
					If Not v_PremiereCategorie Then
						
						Set v_WordTable = g_WordDoc_SIMW.Tables(1)
						Call v_WordTable.Rows(v_Ligne).Delete
						
						' Sauvegarder le document Word
						If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\EquiDept" &amp; _
						Cstr(v_NbCategories) &amp; ".docx", "") Then
							Exit Function
						End If
						
						' Fermer le document Word
						If Not SIMW_FermerDocument Then
							Exit Function
						End If
						
						v_Ligne = 1
					Else
						v_PremiereCategorie = False
					End If
					
					v_NbCategories = v_NbCategories + 1
					v_CategorieCourante= xVar(nd, "Prod_Departement", "")
					
					' Extraire le document Word
					v_Langue = g_LangueContrat_SDSI
					If Not SILT_ExtraireLettreType("SDSI_EquiDept", v_Langue, False) Then
						Exit Function
					End If
					
					' Ouvrir le document Word
					If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
						Exit Function
					End If
					
					v_NouvelleCategorie = True
				End If
				
				' Ajouter le produit d'équipement
				' -------------------------------
				If Not SDSI_AjouterEquipement(pnd_Prop, nd, v_NouvelleCategorie, v_PrixTotal, v_Ligne) Then
					Exit Function
				End If
				
				v_NouvelleCategorie = False
				
			End If
		End If 
	Loop
	
	
	' Si des départements ont été créés
	' ---------------------------------
	If v_NbCategories &gt; 0 Then
		Set v_WordTable = g_WordDoc_SIMW.Tables(1)
		Call v_WordTable.Rows(v_Ligne).Delete
		
		' Sauvegarder le document Word
		If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\EquiDept" &amp; Cstr(v_NbCategories) &amp; ".docx", "") Then
			Exit Function
		End If
		
		' Fermer le document Word
		If Not SIMW_FermerDocument Then
			Exit Function
		End If
		
	End If
	
	' Assembler les départements de la succursale
	' -------------------------------------------
	If Not SDSI_AssemblerEquipement(pnd_Prop, pnd_Site, p_NbSite, v_NbCategories, v_PrixTotal) Then
		Exit Function
	End If
	
	SDSI_GenererEquipement = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererMensualites"><lotusscript>Function SDSI_GenererMensualites(pnd_Prop As NotesDocument)
	' ------------------------------------------------------------------------------
	' Le script permet de générer les mensualités Word liés aux logiciels d'un site.
	' ------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_Langue As String
	Dim v_Escompte As Double
	
	' Initialisations
	SDSI_GenererMensualites = False
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	If Not SILT_ExtraireLettreType("SDSI_TotalMensuelLG", v_Langue, False) Then
		Exit Function
	End If
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	' Ajouter les totaux de la commande
	v_Escompte = xVar(pnd_Prop, "Prop_EscompteMensualite", 0)
	
	If v_Escompte = 0 Then
		' Supprimer les lignes du tableau
		Call g_WordDoc_SIMW.Tables(1).Rows(1).Delete ' TOTAL
		Call g_WordDoc_SIMW.Tables(1).Rows(1).Delete ' ESCOMPTE
		Call g_WordDoc_SIMW.Tables(1).Rows(1).Delete ' -------------------
	Else
		Call SIMW_TrouverRemplacer("[Prop_Escompte]", SDSI_FormatDevise(v_Escompte, g_LangueContrat_SDSI))
	End If
	
	Call SIMW_TrouverRemplacer("[Prop_Devise]", xVar(pnd_Prop, "Prop_Devise", ""))
	
	' Sauvegarder le document Word
	If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\Mens.docx", "") Then
		Exit Function
	End If
	
	' Fermer le document Word
	If Not SIMW_FermerDocument Then
		Exit Function
	End If
	
	SDSI_GenererMensualites = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_NomFichier"><lotusscript>Function SDSI_NomFichier(p_Dossier As String, p_NomFichierPDF As String) As String
	On Error GoTo GererErreur
	
	Dim v_NomFichierPDF As String
	Dim s As String
	Dim v_NomFichier As String
	Dim v_PrefixeFichier As string
	Dim i As Integer
	
	v_NomFichierPDF = p_Dossier &amp; "\" &amp; p_NomFichierPDF
	s = Dir$(v_NomFichierPDF)
	If s &lt;&gt; "" Then
		v_NomFichier = StrLeftBack(p_NomFichierPDF, ".")
		v_PrefixeFichier = StrRightBack(p_NomFichierPDF, ".")
		i = 1
		
		Do
			i = i + 1
			v_NomFichierPDF = p_Dossier &amp; "\" &amp; v_NomFichier &amp; " (" &amp; CStr(i) &amp; ")." &amp; v_PrefixeFichier
			s = Dir$(v_NomFichierPDF)
		Loop Until s = ""
	End If
	
	SDSI_NomFichier = v_NomFichierPDF
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), v_NomFichierPDF, False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererServices"><lotusscript>Function SDSI_GenererServices(pnd_Prop As NotesDocument, pnd_Site As NotesDocument, p_NbSite As Long) As Boolean
	' ---------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux services d'un site.
	' ---------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim nv As NotesView
	Dim ndc As NotesDocumentCollection
	Dim nd_Suivant As Notesdocument
	Dim nd As NotesDocument
	Dim nd_CateSDSBB As NotesDocument
	Dim a_ndProduits() As NotesDocument
	
	Dim v_NoSite As String
	Dim v_PremiereCategorie As Boolean
	Dim v_CategorieCourante As String
	Dim v_NouvelleCategorie As Boolean
	Dim v_Langue As String
	Dim v_Cle As String
	Dim lnd_Services List As Variant
	Dim a_Service() As String
	Dim v_LigneService As Variant
	Dim v_ProduitsFusion() As String
	Dim a_ProduitsFusionParent As Variant
	Dim a_ProduitsFusionner As Variant
	Dim v_CategorieProduit As String
	Dim v_DescProdAfficheContrat As String
	Dim v_Pos As Variant
	Dim v_NbCategories As Long
	Dim v_NbServices As Long
	Dim v_PrixTotal As Double
	Dim v_WordTable As Variant
	Dim v_Ligne As Integer
	Dim i As Integer
	
	' Initialisations
	SDSI_GenererServices = False
	v_PremiereCategorie = True
	v_CategorieCourante = "QWERTY"
	v_NbServices = 0
	v_PrixTotal = 0
	v_NbCategories = 0
	v_Ligne = 1
	
	a_ProduitsFusionParent = xVarTabl("Prod_FusionSV", "Tabl_Valeurs", "", True)
	a_ProduitsFusionner = xVarTabl("Prod_FusionSV", "Tabl_Complement1", "", True)
	
	' Générer les services par catégorie
	' ----------------------------------
	v_NoSite = xVar(pnd_Site, "Site_NoSite", "")
	Set nv = gndb_SDSI.GetView("v_Prod31" &amp; xLangue)
	Call nv.Refresh
	Set ndc = nv.GetAllDocumentsByKey(g_NoProposition_SDSI &amp; ";" &amp; v_NoSite &amp; ";SV", True)
	Set nd_Suivant = ndc.GetFirstDocument
	i = 0
	ReDim a_ndProduits(ndc.count)
	' Construire la liste des services
	Do Until nd_Suivant Is Nothing
		Set nd = nd_Suivant
		Set nd_Suivant = ndc.GetNextDocument(nd_Suivant)
		
		v_Cle = Cstr(xVar(nd_Suivant, "Prod_NoSite", "") &amp; ";" &amp; xVar(nd_Suivant,"Prod_ClasseProduit",""))
		If v_Cle &lt;&gt; (v_NoSite &amp; ";SV") Then
			Set nd_Suivant = Nothing
		End If
		
		v_CategorieProduit = xVar(nd, "Prod_CategorieProduit", "")
		Set nd_CateSDSBB = xSDSBB_xndCate(v_CategorieProduit, True)
		
		nd.Tmp_CleTri = Format$(xVar(nd_CateSDSBB, "Cate_PropTri", 0), "00") &amp; _
		";" &amp; xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_CategorieProduit", "", True) &amp;_
		";" &amp; Format$(xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropTriImpression", 90, True), "00") &amp;_
		";" &amp; xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_CodeProduit", "", True)
		
		Set a_ndProduits(i) = nd
		i = i + 1
	Loop
	
	If i &gt; 0 Then
		ReDim Preserve a_ndProduits(i -1)
		Call TrierArrayDocs(a_ndProduits, "Tmp_CleTri", "")
		
		For i = 0 To UBound(a_ndProduits)
			
			Set nd = a_ndProduits(i)
			
			If xVar(nd, "Prod_TypeDescendant","") &lt;&gt; "C" And xVar(nd,"Prod_ClasseProduit","") = "SV" Then
				If (xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropImpression", "0", True) &lt;&gt; "0" And xVar(nd, "Prod_Quantite", 0) &gt; 0) Then
					
					Set nd_CateSDSBB = xSDSBB_xndCate(xVar(nd, "Prod_CategorieProduit", ""), True)
					
					ReDim a_Service(6)
					a_Service(0) = xVar(nd, "Prod_CleProduit", "")
					a_Service(1) = xVar(nd, "Prod_CodeProduit", "")
					a_Service(2) = xVar(nd, "Prod_CategorieProduit", "")
					a_Service(3) = xVar(nd_CateSDSBB, "Cate_DescContrat" &amp; g_LangueContrat_SDSI, xVar(nd, "Prod_CategorieDesc" &amp; g_LangueContrat_SDSI, ""))
					v_Cle = xVar(nd,"Prod_CleProduit", "")
					
					v_DescProdAfficheContrat = xSDSBB_xVarProd(v_Cle, "Prod_DescContrat" &amp; g_LangueContrat_SDSI, _
					xSDSBB_xVarProd(v_Cle, "Prod_DescProduit" &amp; g_LangueContrat_SDSI, "", False), False)
					
					a_Service(4) = v_DescProdAfficheContrat						
					
					a_Service(5) = xVar(nd, "Prod_Quantite", 0)
					a_Service(6) = xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_Unite" &amp; g_LangueContrat_SDSI, "", True)
					
					' Vérifie si produit a fusionner
					v_Pos = ArrayGetIndex(a_ProduitsFusionner, a_Service(0))
					
					If Not IsNull(v_Pos) Then
						
						If IsElement(lnd_Services(a_ProduitsFusionParent(v_Pos)))Then
							
							' Fusionner le produit
							v_LigneService = lnd_Services(a_ProduitsFusionParent(v_Pos))
							
							If IsArray(v_LigneService) Then
								v_LigneService(4) = xSDSBB_xVarProd(v_LigneService(0) , "Prod_DescContrat" &amp; _
								g_LangueContrat_SDSI, xVar(nd, "Prod_DescProduit" &amp; g_LangueContrat_SDSI, ""), True)
								v_LigneService(5) = CStr(CInt(v_LigneService(5)) + CInt(a_Service(5)))
								lnd_Services(a_ProduitsFusionParent(v_Pos)) = v_LigneService
							End If
							
						Else						
							If Not IsElement(lnd_Services(a_Service(0)))Then
								lnd_Services(a_Service(0)) = a_Service
							End If
						End If
						
					Else
						' Pas de produit a fusionner
						If Not IsElement(lnd_Services(a_Service(0)))Then
							lnd_Services(a_Service(0)) = a_Service
						Else
							v_LigneService = lnd_Services(a_Service(0))
							v_LigneService(5) = CStr(CInt(v_LigneService(5) + CInt(a_Service(5))))
							lnd_Services(a_Service(0)) = v_LigneService	
						End If
					End If
					
				End If
				
			End If
			
			v_PrixTotal = v_PrixTotal + xVar(nd, "Prod_PrixTotal", 0)
			
		Next
	End If
	
	' Générer un document Word pour chaque catégorie service
	
	ForAll Service In lnd_Services
		
		' Changement de catégorie
		' -----------------------
		If Service(2) &lt;&gt; v_CategorieCourante Then
			If Not v_PremiereCategorie Then
				
				Set v_WordTable = g_WordDoc_SIMW.Tables(1)
				Call v_WordTable.Rows(v_Ligne).Delete
				
				' Sauvegarder le document Word
				If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\ServCat" &amp; _
				CStr(v_NbCategories) &amp; ".docx", "") Then
					Exit Function
				End If
				
				' Fermer le document Word
				If Not SIMW_FermerDocument Then
					Exit Function
				End If
				
				v_Ligne = 1
			Else
				v_PremiereCategorie = False
			End If
			
			v_NbCategories = v_NbCategories + 1
			v_CategorieCourante= Service(2)
			
			' Extraire le document Word
			v_Langue = g_LangueContrat_SDSI
			If Not SILT_ExtraireLettreType("SDSI_ServCat", v_Langue, False) Then
				Exit Function
			End If
			
			' Ouvrir le document Word
			If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
				Exit Function
			End If
			
			v_NouvelleCategorie = True
		End If
		
		' Ajouter le produit service
		' --------------------------
		v_NbServices = v_NbServices + 1
		
		If Not SDSI_AjouterService(Service, v_NouvelleCategorie, v_Ligne) Then
			Exit Function
		End If
		
		v_NouvelleCategorie = False
		
	End ForAll
	
	' Si des catégories ont été créés
	' -------------------------------
	If v_NbCategories &gt; 0 Then
		Set v_WordTable = g_WordDoc_SIMW.Tables(1)
		Call v_WordTable.Rows(v_Ligne).Delete
		
		' Sauvegarder le document Word
		If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\ServCat" &amp; CStr(v_NbCategories) &amp; ".docx", "") Then
			Exit Function
		End If
		
		' Fermer le document Word
		If Not SIMW_FermerDocument Then
			Exit Function
		End If
	End If
	
	If Not SDSI_AssemblerServices(pnd_Prop, pnd_Site, p_NbSite, v_NbCategories, v_PrixTotal) Then
		Exit Function
	End If
	
	SDSI_GenererServices = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_CreerDossier"><lotusscript>Function SDSI_CreerDossier As Boolean
	' --------------------------------------------
	' Le script permet d'imprimer une proposition.
	' --------------------------------------------
	On Error Goto GererErreur
	On Error 75 Resume Next
	
	Dim v_Unique As Variant
	
	' Initialisations
	SDSI_CreerDossier = False
	
	Mkdir Environ("Temp") &amp; "\sdsi"
	
	v_Unique = Evaluate("@Unique")
	g_Unique_SDSI = Right(v_Unique(0), 6)
	g_DossierTemp_SDSI = Environ("Temp") &amp; "\sdsi\" &amp; g_Unique_SDSI
	Mkdir g_DossierTemp_SDSI
	
	SDSI_CreerDossier = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function



</lotusscript></code><code event="SDSI_AssemblerLogiciels_Conv"><lotusscript>Function SDSI_AssemblerLogiciels_Conv(pnd_Prop As NotesDocument, pnd_Site As NotesDocument, p_noSection As Integer, p_NbCategories As Long) As Boolean
	' ----------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux logiciels d'une section.
	' ----------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim v_Langue As String
	Dim i As Long
	Dim j As integer
	Dim v_NomSite As String
	Dim v_NoSection As Integer
	
	SDSI_AssemblerLogiciels_Conv = False
	
	v_NomSite = UCase(xEvaluate(|@If(!@IsNull(Site_ClientNomInterne); Site_ClientNomInterne; @IsNull(Site_ClientNoFmt); Site_ClientNom; (Site_ClientNom1 : Site_ClientNom2))
|, pnd_Site))
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	If Not SILT_ExtraireLettreType("SDSI_LogiConv", v_Langue, False) Then
		Exit Function
	End If		
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	' Ajouter les départements
	If p_NbCategories &gt; 0 Then
		For i = 1 To p_NbCategories		
			Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\LogiCat" &amp; CStr(i) &amp; ".docx", "[SDSI_LogiCat]",1)
		Next	
		Call SIMW_SupprimerTexte("[SDSI_LogiCat]", 1)	
	Else	
		Call SIMW_SupprimerTexte("[SDSI_LogiCat]", 1)		
	End If
	
	' Sauvegarder le document Word
	If SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\LogiConv" &amp; CStr(p_NoSection) &amp; ".docx", "") Then
		
		' Fermer le document Word
		If SIMW_FermerDocument Then
			SDSI_AssemblerLogiciels_Conv = True
		End If
	End If
	
	If gc_SupprimerFichiers_SDSI Then
		If p_NbCategories &gt; 0 Then
			For i = 1 To p_NbCategories
				Kill g_DossierTemp_SDSI &amp; "\LogiCat" &amp; CStr(i) &amp; ".docx"
			Next
		End If
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
	
End Function

</lotusscript></code><code event="SDSI_GenererTotauxLogiciels_Conv"><lotusscript>Function SDSI_GenererTotauxLogiciels_Conv(pnd_Prop As NotesDocument) As Boolean
	On Error GoTo GererErreur
	
	Dim v_Langue As String
	Dim v_NomLettreType As String
	Dim v_Escompte As Double
	Dim a_MontantsSectionsLGSite As Variant
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	' Initialisations
	SDSI_GenererTotauxLogiciels_Conv = False
	
	If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then 'Conversion
		
		v_NomLettreType = "SDSI_LogiConvTotaux"
		v_Escompte = xVar(pnd_Prop, "Prop_EscompteMensualite", 0)
		
		a_MontantsSectionsLGSite = xListElem(gl_MontantsSectionsLGSites_SDSI,xVarElem(pnd_Prop, "Prop_NoSites", 0 , ""), 0) 
		
		If Not SILT_ExtraireLettreType(v_NomLettreType, v_Langue, False) Then
			Exit Function
		End If
		
		' Ouvrir le document Word
		If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
			Exit Function
		End If
		
		If v_Escompte = 0 Then
			
			Call SIMW_TrouverRemplacer("[SDSI_LogiConvSousTotal4]",SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(3)), g_LangueContrat_SDSI))
			Call SIMW_TrouverRemplacer("[SDSI_LogiConvTotal4]",SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(3) - v_Escompte), g_LangueContrat_SDSI))
			Call g_WordDoc_SIMW.Tables(1).Rows(1).Delete ' SOUS-TOTAL
			Call g_WordDoc_SIMW.Tables(1).Rows(1).Delete ' ---------	
			Call g_WordDoc_SIMW.Tables(1).Rows(1).Delete ' ESCOMPTE
		Else
			
			Call SIMW_TrouverRemplacer("[SDSI_LogiConvSousTotal4]",SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(3)), g_LangueContrat_SDSI))
			Call SIMW_TrouverRemplacer("[SDSI_LogiConvTotal4]",SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(3) - v_Escompte), g_LangueContrat_SDSI))
			
			Call SIMW_TrouverRemplacer("[Prop_EscompteMensualite]", SDSI_FormatDevise(v_Escompte, v_Langue))	
		End If
		
		' Sauvegarder le document Word
		If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\" &amp;"TotauxLogiConv.docx", "") Then
			Exit Function
		End If
		
		' Fermer le document Word
		If Not SIMW_FermerDocument Then
			Exit Function
		End If
		
	End If
	
	SDSI_GenererTotauxLogiciels_Conv= True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_ndClientOrigine"><lotusscript>Function SDSI_ndClientOrigine(pnd_Prop As NotesDocument, pnd As NotesDocument, p_Origine As String, p_Cache As Boolean) As Boolean
	On Error GoTo GererErreur
	
	Dim nd_Proj As NotesDocument
	Dim v_ClientNoFmt As String
	
	SDSI_ndClientOrigine = False
	Set pnd = Nothing
	
	If p_Origine = "SF" Then
		Exit Function
	End If

	If p_Origine = "SICl" Then
		v_ClientNoFmt = xVar(pnd_Prop, "Prop_ClientNoFmt", "")
		
		' Extraire le document SI Clients
		Set pnd = xSICl_xndClie(v_ClientNoFmt, False)
		
		If pnd Is Nothing Then
			MessageBox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If
	Else
		
		v_ClientNoFmt = xVar(pnd_Prop, "Prop_ClientNoFmt","")
		If v_ClientNoFmt &lt;&gt; "" Then
			Set pnd = xPJ_xndClieSI(p_Origine, v_ClientNoFmt, p_Cache)
			If pnd Is Nothing Then
				MessageBox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
				Exit Function
			End If
		Else
			' Selectionnez le doc de client
			Set pnd = xPJ_xndClie(p_Origine, xVar(pnd_Prop, "Prop_ClientCleSitePrinc", ""), p_Cache)
			
			If pnd Is Nothing Then ' utiliser par InitialiserAdresseClient
				Set nd_Proj = xPJ_xndProj(p_Origine, xVar(pnd_Prop, "Prop_NoProjet", ""), True)
				If nd_Proj Is Nothing Then
					' Le document de référence (client ou projet) est introuvable.
					MessageBox xGDK_xMessage("SDSPP", 4, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
					Exit Function
				End If
				Set pnd = xPJ_xndClie(p_Origine, xVar(nd_Proj, "Clie_NoClient", ""), p_Cache)
			End If
			
		End If
		
	End If
	
	SDSI_ndClientOrigine = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), xVar(pnd_Prop, "Cle", ""), False)
	Exit Function
End Function


</lotusscript></code><code event="SDSI_BCGenererEquipement"><lotusscript>Function SDSI_BCGenererEquipement(pnd_Prop As NotesDocument, pnv_Prod As NotesView, p_NoSite As String, p_Ligne As Integer, p_Total As Double) As Boolean
	' ------------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux équipements d'un site.
	' ------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim nv_Prod15 As NotesView
	Dim nd_Suivant As NotesDocument
	Dim nd As NotesDocument
	
	Dim v_WordTable As Variant
	Dim v_WordRow As Variant	
	Dim v_ClasseDesc As String	
	Dim v_PremierProduit As Boolean
	
	' Initialisations
	SDSI_BCGenererEquipement = False
	Set v_WordTable = g_WordDoc_SIMW.Tables(1)
	v_PremierProduit = True	
	
	
	' Générer l'équipement par département
	' ------------------------------------
	Set nv_Prod15 = gndb_SDSI.GetView("V_Prod15")
	Call nv_Prod15.Refresh
	
	Set nd_Suivant = nv_Prod15.Getdocumentbykey(p_NoSite, True)
	Do Until nd_Suivant Is Nothing
		Set nd = nd_Suivant
		Set nd_Suivant = nv_Prod15.Getnextdocument(nd_Suivant)
		If xVar(nd_Suivant, "Prod_NoSite", "") &lt;&gt; p_NoSite Then
			Set nd_Suivant = Nothing
		End If
		
		v_ClasseDesc = xVar(nd, "Prod_ClasseDesc" &amp; g_LangueContrat_SDSI, "")
		
		'If (xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropImpression", "0", True) &lt;&gt; "0" And xVar(nd, "Prod_Quantite", 0) &gt; 0) Then
		If xVar(nd, "Prod_Quantite", 0) &gt; 0 And xVar(nd,"Prod_TypeDescendant", "") = "" Then
			
			If v_PremierProduit Then
				'Ajouter la description
				p_Ligne = p_Ligne + 1
				Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(p_Ligne))
				Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter(v_ClasseDesc)
				v_WordTable.Cell(p_Ligne, 1).Range.Bold = True
				v_PremierProduit = False
			End If
			
			' Ajouter le produit d'équipement
			' -------------------------------
			p_Ligne = p_Ligne + 1
			
			' Ajouter l'équipement
			If Not SDSI_BCAjouterEquipement(nd, p_Ligne) Then
				Exit Function
			End If
			
			p_Total = p_Total + (xVar(nd, "Prod_Quantite", 0) * xVar(nd, "Prod_PrixUnitaire", 0))
			
			' Ajouter les dépendants
			If Not SDSI_BCAjouterDependants(pnd_Prop, pnv_Prod, p_Ligne, p_NoSite, xVar(nd, "Prod_NoProduit", ""), p_Total, 0) Then
				Exit Function
			End If
			
			
		End If
	Loop
	
	
	SDSI_BCGenererEquipement = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererLogiciels"><lotusscript>Function SDSI_GenererLogiciels(pnd_Prop As NotesDocument, pnd_Site As NotesDocument, p_NbSite As Long, p_FraisMensuelLG As Double, p_TransfertMontantLG As Double) As Boolean
	' ----------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux logiciels d'un site.
	' ----------------------------------------------------------------------------
	On Error Goto GererErreur
	Dim nv As NotesView
	Dim v_NoSite As String
	Dim v_Cle As String
	Dim ndc As NotesDocumentCollection
	Dim nd_Suivant As NotesDocument
	Dim nd As NotesDocument
	Dim v_PremiereCategorie As Boolean
	Dim v_CategorieCourante As String
	Dim v_NouvelleCategorie As Boolean
	Dim v_NbCategories As Long
	Dim v_FraisMensuel As Double
	Dim v_Langue As String
	Dim v_WordTable As Variant
	Dim v_Ligne As Integer
	Dim a_ndProduits() As NotesDocument
	Dim ndc_Produits As NotesDocumentCollection
	Dim nd_Prod As NotesDocument
	Dim nd_ProdSuivant As NotesDocument
	Dim v_CleProduit As String
	Dim v_DescProduit As String
	Dim i As Integer
	Dim v_NbUtilisateurs As Long
	Dim nd_CateSDSBB As NotesDocument
	
	' Initialisations
	SDSI_GenererLogiciels = False
	v_PremiereCategorie = True
	v_CategorieCourante= "QWERTY"
	v_FraisMensuel = 0
	v_Ligne = 1
	
	' Générer les logiciels par catégorie
	' -----------------------------------
	Set nv = gndb_SDSI.GetView("v_Prod31" &amp; xLangue)
	
	Call nv.Refresh
	
	v_NoSite = xVar(pnd_Site, "Site_NoSite", "")
	
	Set ndc_Produits = nv.GetAllDocumentsByKey(g_NoProposition_SDSI &amp; ";" &amp; v_NoSite &amp; ";LG", True)
	
	If ndc_Produits.Count &gt; 0 Then
		ReDim a_ndProduits(ndc_Produits.Count -1)
		
		Set nd_ProdSuivant = ndc_Produits.GetFirstDocument
		Do Until nd_ProdSuivant Is Nothing
			Set nd_Prod = nd_ProdSuivant
			Set nd_ProdSuivant = ndc_Produits.GetNextDocument(nd_ProdSuivant)
			
			v_DescProduit = SDSI_DescProduitsSommLG(nd_Prod, v_NbUtilisateurs)
			
			Set nd_CateSDSBB = xSDSBB_xndCate(xVar(nd_Prod, "Prod_CategorieProduit", ""), True)
			
			'Replace(CStr(xVar(nd_CateSDSBB, "Cate_PropTri", 0)), "0", "00")
			v_CleProduit =  Format$(xVar(nd_CateSDSBB, "Cate_PropTri", 0), "00") &amp; ";" &amp; xVar(nd_CateSDSBB, "Cate_CodeCategorie", "00") &amp; _
			";" &amp; Cstr(xSDSBB_xVarProd(xVar(nd_Prod, "Prod_CleProduit", ""), "Prod_PropTriImpression", 90, True)) &amp; ";" &amp; Cstr(v_NbUtilisateurs) &amp; ";" &amp; v_DescProduit
			
			' Champ temporaire pour le trie
			nd_Prod.Tmp_CleTri = v_CleProduit
			
			
			Set a_ndProduits(i) = nd_Prod
			
			i = i + 1
		Loop
		
		If i &gt; 0 Then
			ReDim Preserve a_ndProduits(i -1)
		End If
		
		Call TrierArrayDocs(a_ndProduits, "Tmp_CleTri", "")
		
		'	End If
		
		'	If ndc_Produits.Count &gt; 0 Then
		For i = 0 To Ubound(a_ndProduits)
			
			Set nd = a_ndProduits(i)
			
			If xVar(nd, "Prod_TypeDescendant","") &lt;&gt; "C" And xVar(nd,"Prod_ClasseProduit","") = "LG" Then
				'If (xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropImpression", "0", True) &lt;&gt; "0" And xVar(nd, "Prod_Quantite", 0) &gt; 0) Then
				If xVar(nd, "Prod_Quantite", 0) &lt;&gt; 0 Then
					
					' Changement de catégorie
					' -----------------------
					If xVar(nd, "Prod_CategorieProduit", "") &lt;&gt; v_CategorieCourante Then
						If Not v_PremiereCategorie Then
							Set v_WordTable = g_WordDoc_SIMW.Tables(1)
							Call v_WordTable.Rows(v_Ligne).Delete
							
							' Sauvegarder le document Word
							If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\LogiCat" &amp; _
							Cstr(v_NbCategories) &amp; ".docx", "") Then
								Exit Function
							End If
							
							' Fermer le document Word
							If Not SIMW_FermerDocument Then
								Exit Function
							End If
							
							v_Ligne = 1
						Else
							v_PremiereCategorie = False
						End If
						
						v_NbCategories = v_NbCategories + 1
						v_CategorieCourante = xVar(nd, "Prod_CategorieProduit", "")
						
						' Extraire le document Word
						v_Langue = g_LangueContrat_SDSI
						If Not SILT_ExtraireLettreType("SDSI_LogiCat", v_Langue, False) Then
							Exit Function
						End If
						
						' Ouvrir le document Word
						If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
							Exit Function
						End If
						
						v_NouvelleCategorie = True
					End If
					
					' Ajouter le produit de logiciel
					' ------------------------------
					If Not SDSI_AjouterLogiciel(pnd_Prop, nd, v_NouvelleCategorie, v_FraisMensuel, v_Ligne,0) Then
						Exit Function
					End If
					
					v_NouvelleCategorie = False
					
				End If
			End If 
			
		Next
	End If
	
	
	' Si des départements ont été créés
	' ---------------------------------
	If v_NbCategories &gt; 0 Then
		Set v_WordTable = g_WordDoc_SIMW.Tables(1)
		Call v_WordTable.Rows(v_Ligne).Delete
		
		' Sauvegarder le document Word
		If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\LogiCat" &amp; Cstr(v_NbCategories) &amp; ".docx", "") Then
			Exit Function
		End If
		
		' Fermer le document Word
		If Not SIMW_FermerDocument Then
			Exit Function
		End If
	End If
	
	' Assembler les Logiciels de la succursale
	' ----------------------------------------
	If Not SDSI_AssemblerLogiciels(pnd_Prop, pnd_Site, p_NbSite, v_NbCategories, v_FraisMensuel, p_TransfertMontantLG) Then
		Exit Function
	End If
	
	p_FraisMensuelLG = p_FraisMensuelLG + v_FraisMensuel
	
	SDSI_GenererLogiciels = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_BCGenererBonCommande"><lotusscript>Function SDSI_BCGenererBonCommande(pnd_Prop As NotesDocument, pnd_Site As NotesDocument, p_NotesBCom As Boolean, p_NotesSertiBCom As Boolean, _
	p_RepondreA As String) As Boolean
	' --------------------------------------------------------------
	' Le script permet de générer les documents Word liés à un site.
	' --------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim ndt As New NotesDateTime("")
	Dim nv_Prod As NotesView		
	Dim v_AdresseFact As String
	Dim v_NomClient As String	
	Dim v_NomLegal As String
	Dim v_ClientNoFmt As String
	Dim v_DestinataireFact As String	
	Dim v_Escompte As Double
	Dim v_EscompteMensualite As Double
	Dim v_EscomptePrixTotal As Double
	Dim v_Ligne As Integer	
	Dim v_NoSite As String
	Dim v_ReplyTo As String
	Dim v_Total As Double	
	
	
	' Initialisations
	SDSI_BCGenererBonCommande = False
	
	Set nv_Prod = gndb_SDSI.GetView("v_Prod34")
	
	v_NomClient = UCase(xEvaluate(|@If(!@IsNull(Site_ClientNomInterne); Site_ClientNomInterne; Site_ClientNom)|, pnd_Site))
	'v_NomLegal = xVar(pnd_Site, "Site_ClientNomLegal", xVar(pnd_Prop, "Prop_ClientNomLegal", ""))
	v_NomLegal = xVar(pnd_Prop, "Prop_ClientNomLegal", xVar(pnd_Site, "Site_ClientNomLegal", ""))
	
	' Adresse de facturation
	v_DestinataireFact = xVar(pnd_Prop, "Prop_ContactNom", "") &amp; _
	" " &amp; xVar(pnd_Prop, "Prop_ContactPrenom", "") &amp; g_NewLine_SDSI &amp; v_NomClient
	
	If v_NomLegal  &lt;&gt; "" Then
		v_AdresseFact = UCase(v_NomLegal) &amp; g_NewLine_SDSI &amp; xVar(pnd_Site, "Site_ClientAdresse1", "")
	Else
		v_AdresseFact = xVar(pnd_Site, "Site_ClientAdresse1", "")		
	End If
	
	If xVar(pnd_Site, "Site_ClientAdresse2", "") &lt;&gt; "" Then
		v_AdresseFact = v_AdresseFact &amp; g_NewLine_SDSI &amp; xVar(pnd_Site, "Site_ClientAdresse2", "")
	End If
	
	v_AdresseFact = v_AdresseFact &amp; g_NewLine_SDSI &amp; xVar(pnd_Site, "Site_ClientVille", "") &amp; " (" &amp; _
	SDSI_Province(pnd_Site, "Site", "") &amp; ")" &amp; g_NewLine_SDSI &amp; xVar(pnd_Site, "Site_ClientCodePostal", "")
	
	v_ClientNoFmt = xVar(pnd_Site, "Site_ClientNoFmt", " ")
	
	v_EscompteMensualite = xVar(pnd_Prop, "Prop_EscompteMensualite", 0)
	
	' Remplacer les informations du bon de commande
	' ---------------------------------------------
	Call SIMW_TrouverRemplacer("[DateContrat]", Format(Today, "Short date"))
	Call ndt.SetNow
	Call ndt.AdjustDay(30)
	Call ndt.SetAnyTime
	Call SIMW_TrouverRemplacer("[DateExpiration]", Format(ndt.LSLocalTime, "Short date"))
	
	If g_NbProposition_SDSI &lt;&gt; "" And g_NbProposition_SDSI &lt;&gt; "0" And Left(g_NbProposition_SDSI, 1) &lt;&gt; "." Then
		Call SIMW_TrouverRemplacer("[Prop_Unique]", g_Unique_SDSI &amp; " - " &amp; g_NbProposition_SDSI)
	Else
		Call SIMW_TrouverRemplacer("[Prop_Unique]", g_Unique_SDSI &amp; " - " &amp; g_NoProposition_SDSI)
	End If
	
	Call SIMW_TrouverRemplacer("[ClientNoFmt]", v_ClientNoFmt)
	
	If xVar(pnd_Prop, "Prop_NomContactSerti", "") = "" Then
		Call SIMW_TrouverRemplacer("[Prop_NomRepresentant]", xVar(pnd_Prop, "Prop_NomRepresentant", ""))
	Else
		Call SIMW_TrouverRemplacer("[Prop_NomRepresentant]", xVar(pnd_Prop, "Prop_NomContactSerti", ""))
	End If
	
	Call SIMW_TrouverRemplacer("[Prop_ContactNom]", xVar(pnd_Prop, "Prop_ContactNom", ""))
	Call SIMW_TrouverRemplacer("[Prop_ContactFonction]", xEvaluate( |@Replace(Prop_ContactFonction; @IfError(@DbLookup(""; @ServerName : "SI_GDK.nsf"; "V_Tabl20"; "Cont_FonctionsSDS| &amp; _
	g_LangueContrat_SDSI &amp; |"; 4); ""); @IfError(@DbLookup(""; @ServerName : "SI_GDK.nsf"; "V_Tabl20"; "Cont_FonctionsSDS| &amp; _
	g_LangueContrat_SDSI &amp; |"; 5); ""))|, pnd_Prop))
	
	Call SIMW_TrouverRemplacer("[DestinataireFacturation]", v_DestinataireFact)
	Call SIMW_TrouverRemplacer("[AdresseFacturation]", v_AdresseFact)
	
	Call SIMW_TrouverRemplacer("[Site_ContactTelephone]", xVar(pnd_Site, "Site_ContactTelephone", ""))
	Call SIMW_TrouverRemplacer("[Site_ContactCellulaire]", xVar(pnd_Site, "Site_ContactCellulaire", ""))
	
	Call SIMW_TrouverRemplacer("[Prop_ContactTelephone]", SDSI_ContactTelephoneImp(pnd_Prop, xVar(pnd_Prop, "Prop_NoContact", "")))	
	Call SIMW_TrouverRemplacer("[Prop_ContactCellulaire]", xVar(pnd_Prop, "Prop_ContactCellulaire", ""))
	
	Call SIMW_TrouverRemplacer("[Prop_Devise]", xVar(pnd_Prop, "Prop_Devise", ""))
	
	%REM
	If p_GenererPDF Then
		'Imprimer et envoyer
		v_ReplyTo = xVarPers("Pers_RepondreAChoix","00")			
		If v_ReplyTo = "00" Then
			'Call SIMW_TrouverRemplacer("[Pers_ReplyTo]", xNAB_xVarPerson(gns_SDSI.UserName, "InternetAddress", "", True))
			Call SIMW_TrouverRemplacer("[Pers_ReplyTo]", xEvaluate(|@NameLookup([Exhaustive];@UserName;"InternetAddress")|, Nothing))			
		Else			
			Call SIMW_TrouverRemplacer("[Pers_ReplyTo]", xComplTabl(v_ReplyTo, "SLDS_BCUsr", "1", True))			
		End If				
	Else 
		'Imprimer BC
		If p_RepondreA = "" Then		
			Call SIMW_TrouverRemplacer("[Pers_ReplyTo]", xComplTabl("02", "SLDS_BCUsr", "1", True))									
		End If
	End If
	%END REM
	
	' Notes bon de commande
	If p_NotesBCom Then
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\NotesBCom.docx", "[SDSI_NotesContrat]", 1)		
	Else
		Call SIMW_SupprimerLigne("[SDSI_NotesContrat]", 1)
	End If
	
	' Notes bon de commande Serti
	If p_NotesSertiBCom Then
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\BComNotesSerti.docx", "[SDSI_BComNotesSerti]", 1)		
	Else
		Call SIMW_SupprimerLigne("[SDSI_BComNotesSerti]", 1)
	End If
	
	' Mettre à jour les entêtes et pieds de page
	If g_NbProposition_SDSI &lt;&gt; "" And g_NbProposition_SDSI &lt;&gt; "0" And Left(g_NbProposition_SDSI, 1) &lt;&gt; "." Then
		Call g_WordDoc_SIMW.Sections(1).Footers(1).Range.Find.Execute("[Prop_Unique]", _
		False, False, False, False, False, True, 1, False, g_Unique_SDSI &amp; " - " &amp; g_NbProposition_SDSI, 2)
	Else
		Call g_WordDoc_SIMW.Sections(1).Footers(1).Range.Find.Execute("[Prop_Unique]", _
		False, False, False, False, False, True, 1, False, g_Unique_SDSI &amp; " - " &amp; g_NoProposition_SDSI, 2)
	End If
	
	' Générer le tableau
	' ------------------
	v_Ligne = 3
	v_NoSite = xVar(pnd_Site, "Site_NoSite", "")
	
	' Générer l'équipement
	If Not SDSI_BCGenererEquipement(pnd_Prop, nv_Prod, v_NoSite, v_Ligne, v_Total) Then
		Exit Function
	End If
	
	' Générer les logiciels
	If Not SDSI_BCGenererLogiciels(pnd_Prop, nv_Prod, v_NoSite, v_Ligne, v_Total, v_EscompteMensualite) Then
		Exit Function
	End If
	
	' Générer les services
	If Not SDSI_BCGenererServices(pnd_Prop, nv_Prod, v_NoSite, v_Ligne, v_Total) Then
		Exit Function
	End If
	
	Call g_WordDoc_SIMW.Tables(1).Rows(v_Ligne + 1).Delete
	
	' Ajouter les totaux de la commande
	v_Escompte = (xVar(pnd_Prop, "Prop_EscompteMontant", 0) + xVar(pnd_Prop, "Prop_EscompteCorporatif", 0))
	
	v_EscomptePrixTotal = v_Total - v_Escompte
	
	If v_Escompte = 0 And v_EscompteMensualite = 0 Then
		Call g_WordDoc_SIMW.Tables(1).Rows(v_Ligne+2).Delete
		If v_Total &gt; 0 Then
			Call g_WordDoc_SIMW.Tables(1).Cell(v_Ligne+2, 3).Range.InsertAfter(SDSI_FormatDevise(v_Total, g_LangueContrat_SDSI))
		End If
	Else
		If v_Escompte &gt; 0 Then
			Call g_WordDoc_SIMW.Tables(1).Cell(v_Ligne+2, 3).Range.InsertAfter(SDSI_FormatDevise(v_Escompte, g_LangueContrat_SDSI))
		End If
		
		If v_EscompteMensualite &gt; 0 Then
			Call g_WordDoc_SIMW.Tables(1).Cell(v_Ligne+2, 4).Range.InsertAfter(SDSI_FormatDevise(v_EscompteMensualite, g_LangueContrat_SDSI))
		End If
		
		If v_EscomptePrixTotal &gt; 0 Then
			Call g_WordDoc_SIMW.Tables(1).Cell(v_Ligne+3, 3).Range.InsertAfter(SDSI_FormatDevise(v_EscomptePrixTotal, g_LangueContrat_SDSI))
		End If
	End If
	
	Call SIMW_SupprimerPagesVideFinDocument
	
	SDSI_BCGenererBonCommande = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_BCAjouterLogiciel"><lotusscript>Function SDSI_BCAjouterLogiciel(pnd_Prod As NotesDocument, p_Description As String, p_Ligne As Integer, _
	p_FraisMensuel As Double) As Boolean
	' ----------------------------------------------------------------------------------------------
	' Le script permet d'ajouter un logiciel dans le document Word liés aux logiciels d'un site
	' lors de l'impression d'un bon de commande.
	' ----------------------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	SDSI_BCAjouterLogiciel = False
	
	Dim v_WordTable As Variant
	Dim v_WordRow As Variant
	
	Set v_WordTable = g_WordDoc_SIMW.Tables(1)
	Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(p_Ligne))
	
	Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter(p_Description)
	Call v_WordTable.Cell(p_Ligne, 2).Range.InsertAfter(xVar(pnd_Prod, "Prod_Quantite", 0))
	
	If xVar(pnd_Prod, "Prod_PrixUnitaire", 0) &gt; 0 Then
		Call v_WordTable.Cell(p_Ligne, 3).Range.InsertAfter(SDSI_FormatDevise(xVar(pnd_Prod, "Prod_PrixUnitaire", 0), g_LangueContrat_SDSI))
	End If
	
	If p_FraisMensuel &gt; 0 Then
		'				v_FraisMensuel = SItN_RoundUp(v_FraisMensuel)	'Ne pas arrondir les frais mensuel
		Call v_WordTable.Cell(p_Ligne,4).Range.InsertAfter(SDSI_FormatDevise(p_FraisMensuel, g_LangueContrat_SDSI))
	End If
	
	SDSI_BCAjouterLogiciel = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_FormatDevise"><lotusscript>Function SDSI_FormatDevise(p_Montant As Double, p_Langue As String) As String
	On Error Goto GererErreur
	
	Dim v_Montant As String
	
	v_Montant = SItN_Format(p_Montant, "Standard", p_Langue)
	
	If p_Langue = "FR" Then
		SDSI_FormatDevise = v_Montant &amp; " $"
	Else
		SDSI_FormatDevise = "$" &amp; v_Montant
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererCourrielDocuSign"><lotusscript>Function SDSI_GenererCourrielDocuSign(pnd_Prop As NotesDocument, p_TypeImpression As String, p_TypeCourriel As String, _
	p_RepondreA As String, p_CheminFichierPDF As String, pnd_CourrielMailIn As NotesDocument) As NotesDocument
	On Error GoTo GererErreur
	
	Dim nd_Courriel As NotesDocument
	Dim nd_Empl As NotesDocument
	Dim nd_CourrielMailIn As NotesDocument
	Dim nd_NAB As NotesDocument
	Dim ndb_Courriel As NotesDatabase
	Dim nrti As NotesRichTextItem
	Dim nrti_Signature As NotesRichTextItem
	
	Dim a_ContactCC As Variant
	Dim l_ItemsTypeDoc List As String
	Dim v_Langue As String
	Dim v_NoEmploye As String
	Dim v_ClientNom As String
	Dim v_NomItemSignature As String
	Dim v_NomTablBCUsr As String
	Dim v_RepondreAChoix As String
	Dim v_ReplyTo As String
	Dim v_From As String
	Dim v_ReplyToDesc As String	
	Dim v_level As Integer	
	Dim v_accPriv As Long	
	Dim v_Serveur As String
	Dim v_TitreMaiIn As String
	
	
	
	'Initialisations	
	Set SDSI_GenererCourrielDocuSign = Nothing
	
	pnd_Prop.temp_clientnom = xEvaluate(|@If(!@IsNull(Prop_ClientNomInterne); Prop_ClientNomInterne; Prop_ClientNom)|, pnd_Prop)
	
	v_Langue = xVar(pnd_Prop, "Prop_Langue", "")
	
	v_NomTablBCUsr = "SLDS_BCUsr_" &amp; v_Langue
	
	l_ItemsTypeDoc("B;FR") = "COURRIEL Bon de commande"
	l_ItemsTypeDoc("B;EN") = " EMAIL Purchase Order"
	l_ItemsTypeDoc("C;FR") = "COURRIEL Contrat"
	l_ItemsTypeDoc("C;EN") = "EMAIL Contract"
	
	Set nd_Courriel = SICT_ConstruireMessage(pnd_Prop, p_TypeCourriel, v_Langue, xVar(pnd_Prop, "Prop_ContactCourriel", ""), "", "", 0, "fichier_attach")
	
	nd_Courriel.Form = "Memo"	
	nd_Courriel.Cour_Type = "DS"
	nd_Courriel.SI_DialogBox = "1"  ' cacher les bts save et X	
	
	Set nrti = nd_Courriel.GetFirstItem("Body")
	
	If xVar(pnd_Prop, "Prop_NomRepresentant", "") = "" Then
		Call SItRT_Remplacer(nrti, "[prop_nomrepresentant]", "")
	End If
	
	' fichier_attach
	Call SItRT_RemplacerFichierAttach(nrti, "[fichier_attach]", p_CheminFichierPDF)
	
	' Ajouter la signature à la fin du Body (Sans Signet)
	Call SISg_ExtraireSignature(v_NoEmploye, nd_Empl, v_NomItemSignature)
	Set nrti_Signature = nd_Empl.GetFirstItem(v_NomItemSignature)
	Call nrti.AppendRTItem(nrti_Signature)
	Call nrti.AddNewLine(2, False)
	
	v_ClientNom = xVar(pnd_Prop, "temp_clientnom", "")
	
	nd_Courriel.Titre = xVar(pnd_Prop, "Prop_NbPropositionPrefixe", "") &amp; CStr(xVar(pnd_Prop, "Prop_NbProposition", ""))  &amp; " - " _
	&amp; v_ClientNom &amp; l_ItemsTypeDoc(p_TypeImpression &amp; ";" &amp; v_Langue)
	
	nd_Courriel.Cour_NoProposition = CStr(xVar(pnd_Prop, "Prop_NbProposition", ""))
	nd_Courriel.Cour_ClientNoFmt = xVar(pnd_Prop, "Prop_ClientNoFmt", "")
	nd_Courriel.Cour_ClientNom = v_ClientNom
	
	If p_TypeImpression = "C" Then
		' SDS Demo
		nd_Courriel.Cour_NoRepondreA = "04"
		v_ReplyTo = xComplTabl("04", "SLDS_CTUsr", "1", True) 	
		nd_Courriel.Cour_ReplyToDesc = xDescTabl("04", "SLDS_CTUsr", True)		
	Else
		v_RepondreAChoix = p_RepondreA	
		
		If v_RepondreAChoix = "00" Then
			v_ReplyTo = xNAB_xVarPerson(gns_SDSI.UserName, "InternetAddress", "", True)				
			If v_ReplyTo = "" Then
				v_ReplyTo = xNAB_xVarPersonCN(gns_SDSI.CommonUserName, "InternetAddress", "", True)	
			End If
		Else			
			v_ReplyTo = xComplTabl(v_RepondreAChoix, v_NomTablBCUsr, "1", True)								
		End If
		
		nd_Courriel.Cour_ReplyToDesc = xDescTabl(v_RepondreAChoix, v_NomTablBCUsr, True)	
	End If
	
	nd_Courriel.ReplyTo = v_ReplyTo
	
	a_ContactCC = Evaluate(|@Trim(@Sort(@Unique(Prop_ContactCourrielsCCDsg : Prop_ContactCourrielsManCCDsg)))|, pnd_Prop)
	
	If IsArray(a_ContactCC) Then
		nd_Courriel.CourCC_DocuSign = FullTrim(a_ContactCC)
	Else
		nd_Courriel.CourCC_DocuSign = a_ContactCC		
	End if
	
	
	' Il faut sauvegarder le doc pour que le champ RichText s'affiche correctement
	Call nd_Courriel.save(True,False) 
	
	If gnuiws_SDSI.DialogBox("DB_EnvoiDSg", True, True, True, False, False, False, _
	xGDK_xMessage("SI", 189, "", ""), nd_Courriel, True, True, True) Then
		
		'Copier le courriel dans le mail-in		
		Set nd_CourrielMailIn = New NotesDocument(gndb_SDSI)
		Call nd_Courriel.Copyallitems(nd_CourrielMailIn)
		
		'Pas de mail-in SDS Demo envoyer copie du courriel dans SDS PO		
		v_ReplyToDesc = xVar(nd_Courriel, "Cour_ReplyToDesc", "")
		
		If v_ReplyToDesc = "SDS Demo" Then
			v_TitreMaiIn = "SDS PO"
		Else						
			v_TitreMaiIn = v_ReplyToDesc
		End if	
		
		Set nd_NAB = xNAB_xndMailIn(v_TitreMaiIn, True)		
		'Set nd_NAB = xNAB_xndMailIn(xDescTabl(xVar(nd_Courriel, "Cour_Principal", ""), v_NomTablBCUsr, True), True)
		
		On Error 4060 Resume Next
		Set ndb_Courriel = gns_SDSI.Getdatabase(xVar(nd_NAB, "MailServer", ""), xVar(nd_NAB, "MailFile", ""), False) 
		'v_From = xNAB_xVarMailIn(xDescTabl(v_Principal_Nouv, v_NomTablBCUsr, True), "InternetAddress", "", True)
		
		If v_ReplyToDesc = "SDS Demo" Then
			v_From = v_ReplyTo
		Else
			v_From = xNAB_xVarMailIn(v_ReplyToDesc, "InternetAddress", "", True)
		End If
		
		nd_CourrielMailIn.DeliveredDate = ""
		nd_CourrielMailIn.PostedDate = Now				
		nd_CourrielMailIn.From = v_From
		nd_CourrielMailIn.NoAutoReply = "1"
		
		
		'Note : Courriel copié dans la vue envoyé du mail-in
		If Not ndb_Courriel Is Nothing Then
			
			v_level = ndb_Courriel.QueryAccess(gns_SDSI.UserName)
			v_accPriv = ndb_Courriel.QueryAccessPrivileges(gns_SDSI.UserName)
			v_Serveur = nd_CourrielMailIn.Parentdatabase.Server
			
			nd_CourrielMailIn.Memo_Serveur = ndb_Courriel.Server
			nd_CourrielMailIn.Memo_Fichier = ndb_Courriel.Filepath
			nd_CourrielMailIn.Memo_Database = ndb_Courriel.Title
			
			'Local
			If v_Serveur = "" Then
				nd_CourrielMailIn.Memo_EnvoyerCourriel = "1"
				Call nd_CourrielMailIn.save(True,False) 
			Else
				If (v_level &gt;= 3) And (v_accPriv And DBACL_CREATE_DOCUMENTS &gt; 0) Then
					If ndb_Courriel.IsOpen Then											
						Call nd_CourrielMailIn.save(True,False) 							
						If ndb_Courriel.IsOpen Then
							Call nd_CourrielMailIn.Copytodatabase(ndb_Courriel)
						End If															
					End If
				Else
					nd_CourrielMailIn.Memo_EnvoyerCourriel = "1"
					Call nd_CourrielMailIn.save(True,False) 
				End If
			End If
			
		Else
			nd_CourrielMailIn.Memo_Serveur = xVar(nd_NAB, "MailServer", "")
			nd_CourrielMailIn.Memo_Fichier = xVar(nd_NAB, "MailFile", "")
			nd_CourrielMailIn.Memo_Database = v_TitreMaiIn
			
			nd_CourrielMailIn.Memo_EnvoyerCourriel = "1"
			Call nd_CourrielMailIn.save(True,False) 
		End if
		
		If IsArray(nrti.EmbeddedObjects) Then
			ForAll neo In nrti.EmbeddedObjects
				If neo.Type = EMBED_ATTACHMENT Then
					Call neo.remove
				End If
			End forall
			Call nd_Courriel.save(True,False) 
		End if
		
		Set SDSI_GenererCourrielDocuSign = nd_Courriel
	End If
	
	Call pnd_Prop.RemoveItem("temp_clientnom")
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
	
End Function

</lotusscript></code><code event="SDSI_InsererElementDouble"><lotusscript>Sub SDSI_InsererElementDouble(pa() As Double, p As Long)
	Dim i As Long
	Redim Preserve pa(Ubound(pa) + 1) As Double
	
	For i = (Ubound(pa) - 1) To p Step -1
		pa(i + 1) = pa(i)
	Next
End Sub

</lotusscript></code><code event="SDSI_CoutTotal"><lotusscript>Function SDSI_CoutTotal(pnd_Prop As Notesdocument) As Double
	' ---------------------------------------------------------------
	' Le script permet de déterminer le coût total d'une proposition.
	' ---------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_NoProposition As String
	Dim v_CoutEQ As Variant
	Dim v_CoutLG As Variant
	Dim v_CoutSV As Variant
	
	' Initialisations
	SDSI_CoutTotal = 0
	
	v_NoProposition = xVar(pnd_Prop, "Prop_NoProposition", "")
	
	v_CoutEQ =xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "| &amp; _
	v_NoProposition &amp; |"+ ";EQ."; 7 ;[PartialMatch]); 0))|, Nothing)
	v_CoutLG =xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "| &amp; _
	v_NoProposition &amp; |"+ ";LG."; 7 ;[PartialMatch]); 0))|, Nothing)
	v_CoutSV =xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "| &amp; _
	v_NoProposition &amp; |"+ ";SV."; 7 ;[PartialMatch]); 0))|, Nothing)
	
	
	SDSI_CoutTotal = v_CoutEQ + v_CoutLG + v_CoutSV
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_AjouterLogiciel"><lotusscript>Function SDSI_AjouterLogiciel(pnd_Prop As NotesDocument, pnd_Prod As NotesDocument, p_NouvelleCategorie As Boolean, p_Frais As Double, _
	p_Ligne As Integer, p_NoSection As Integer) As Boolean
	' ------------------------------------------------------------------------------------------
	' Le script permet d'ajouter un logiciel dans le document Word liés aux logiciels d'un site.
	' ------------------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_WordTable As Variant
	Dim v_WordRow As Variant
	Dim v_Frais As Double
	Dim v_FraisAnnuels As Double
	Dim v_FraisMensuel As Double
	Dim v_DescriptionLG As String
	
	SDSI_AjouterLogiciel = False
	
	' Extraire la table des produits d'équipement
	' -------------------------------------------
	Set v_WordTable = g_WordDoc_SIMW.Tables(1)
	
	Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(p_Ligne))
	
	' Ajouter l'information du produit sur la dernière ligne du tableau
	' -----------------------------------------------------------------
	'Print xVar(pnd_Prod, "Prod_CodeProduit", "") ' debug
	
	If p_NouvelleCategorie Then
		Call v_WordTable.Cell(p_Ligne,1).Range.InsertAfter(Cstr(xVar(pnd_Prod, "Prod_CategorieDesc" &amp; g_LangueContrat_SDSI, "")))	
	End If
	
	v_DescriptionLG = SDSI_DescProduitsLG(pnd_Prop, pnd_Prod, 0)
	
	Call v_WordTable.Cell(p_Ligne,2).Range.InsertAfter(v_DescriptionLG)	
	
	
	v_FraisAnnuels = xVar(pnd_Prod, "Prod_FraisEntretienAnnuels", 0)
	
	'Si Conversion à logiciel-service
	'If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" And (p_NoSection = 1 Or p_NoSection = 3)  Then	
	If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" And p_NoSection = 1  Then	
		v_Frais = v_FraisAnnuels * xVar(pnd_Prod, "Prod_Quantite", 0)
	Else				
		If v_FraisAnnuels &gt; 0 Then			
			v_FraisMensuel = (v_FraisAnnuels /12) * xVar(pnd_Prod, "Prod_Quantite", 0)
			'v_FraisMensuel = SItN_Round(v_FraisAnnuels /12, 2) * xVar(pnd_Prod, "Prod_Quantite", 0)
		Else
			v_FraisMensuel = xVar(pnd_Prod, "Prod_FraisEntretien", 0) * xVar(pnd_Prod, "Prod_Quantite", 0) 
		End If
		
		v_Frais = v_FraisMensuel
	End If
	
	
	
	If xSDSBB_xVarProd(xVar(pnd_Prod, "Prod_CleProduit", ""), "Prod_NbUtilisateursObligatoire", "0", True) &lt;&gt; "0" Then
		If xVar(pnd_Prod, "Prod_Quantite", 0) &gt; 1 Or _
		(xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" And (xVar(pnd_Prod, "Prod_Quantite", 0) &lt; 0) Or _
		xVar(pnd_Prod, "Prod_Quantite", 0)&gt; 1) Then
			Call v_WordTable.Cell(p_Ligne,3).Range.InsertAfter(xVar(pnd_Prod, "Prod_Quantite", 0))
		End If
	End If
	
	If v_Frais = 0 Then
		Call v_WordTable.Cell(p_Ligne,4).Range.InsertAfter("--")
	Else		
		'Ne pas arrondir les frais	
		Call v_WordTable.Cell(p_Ligne,4).Range.InsertAfter(SDSI_FormatDevise(v_Frais, g_LangueContrat_SDSI))
	End If
	
	p_Frais = p_Frais + v_Frais
	
	p_Ligne = p_Ligne + 1
	SDSI_AjouterLogiciel = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_BCAjouterEquipement"><lotusscript>Function SDSI_BCAjouterEquipement(pnd_Prod As NotesDocument, p_Ligne As Integer) As Boolean
	' ----------------------------------------------------------------------------------------------
	' Le script permet d'ajouter un équipement dans le document Word liés aux équipements d'un site
	' lors de l'impression d'un bon de commande.
	' ----------------------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim v_WordTable As Variant
	Dim v_WordRow As Variant
	Dim v_Frais As Double
	Dim v_Garantie As Integer
	
	SDSI_BCAjouterEquipement = False
	
	' Extraire la table des produits d'équipement
	' -------------------------------------------
	Set v_WordTable = g_WordDoc_SIMW.Tables(1)	
	Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(p_Ligne))		
	
	Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter((xSDSBB_xVarProd(xVar(pnd_Prod, "Prod_CleProduit", ""), "Prod_DescContrat" &amp; _
	g_LangueContrat_SDSI, xVar(pnd_Prod, "Prod_DescProduit" &amp; g_LangueContrat_SDSI, ""), True)) &amp; " [" &amp; xVar(pnd_Prod, "Prod_CodeProduit", "") &amp; "]")
	Call v_WordTable.Cell(p_Ligne, 2).Range.InsertAfter(CStr(xVar(pnd_Prod, "Prod_Quantite", 0)))
	Call v_WordTable.Cell(p_Ligne, 3).Range.InsertAfter(SDSI_FormatDevise(xVar(pnd_Prod, "Prod_PrixUnitaire", 0), g_LangueContrat_SDSI))
	
	'Garantie (mois) et frais d'entretien
	v_Garantie = xVar(pnd_Prod, "Prod_Garantie", 0)
	v_Frais = xVar(pnd_Prod, "Prod_FraisEntretienAnnuels", 0) * xVar(pnd_Prod, "Prod_Quantite",0)
	If v_Frais = 0 Then					' Temporaire
		v_Frais = (xVar(pnd_Prod, "Prod_FraisEntretien", 0) * 12) * xVar(pnd_Prod, "Prod_Quantite",0)
	End If
	
	If v_Garantie &gt; 0 Or v_Frais &gt; 0 Then
		REM Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter(g_NewLine_SDSI)		' Ligne blanche
		If v_Garantie &gt; 0 Then
			Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter(g_NewLine_SDSI &amp; _
			xGDK_xMessage("SDSP", 90, g_LangueContrat_SDSI, v_Garantie))
		End If
		If v_Frais &gt; 0 Then
			Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter(g_NewLine_SDSI &amp; _
			xGDK_xMessage("SDSP", 89, g_LangueContrat_SDSI,SDSI_FormatDevise(v_Frais, g_LangueContrat_SDSI)))
			'p_TotalEntretien = p_TotalEntretien + v_Frais
		End If
	End If
	
	SDSI_BCAjouterEquipement = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererFraisLogiciels"><lotusscript>Function SDSI_GenererFraisLogiciels(pnd_Prop As NotesDocument) As Boolean
	On Error GoTo GererErreur
	
	If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then 'Conversion
		SDSI_GenererFraisLogiciels = SDSI_GenererMontantsLogiciels_Conv(pnd_Prop)
	Else
		SDSI_GenererFraisLogiciels = SDSI_GenererMensualites(pnd_Prop)
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function



</lotusscript></code><code event="SDSI_CalculerMensualitesLG"><lotusscript>Function SDSI_CalculerMensualitesLG(pnd As NotesDocument, pa_PeriodeA() As Long, _
	pa_MensualitesEQ() As Double, _
	pa_MensualitesLG() As Double) As Integer
	' ------------------------------------------------------------
	' Le script permet d'ajouter une succursale à une proposition.
	' ------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim nv As NotesView
	Dim ndc As NotesDocumentCollection
	Dim nd_Suivant As NotesDocument
	Dim nd As NotesDocument
	Dim n As Long
	Dim i As Long
	Dim v_Frais As Double
	Dim v_FraisTotal As Double
	
	SDSI_CalculerMensualitesLG = False
	
	' Initialisations	
	ReDim pa_MensualitesLG(UBound(pa_PeriodeA)) As Double
	For i = 0 To UBound(pa_PeriodeA)
		pa_MensualitesLG(0) = 0
	Next
	
	Set nv = gndb_SDSI.GetView("V_Prod24")
	Call nv.Refresh
	
	' Boucler sur chaque document
	Set ndc = nv.GetAllDocumentsByKey(xVar(pnd, "Prop_NoProposition", "") &amp; ";LG.", False)
	If ndc.Count &gt; 0 Then
		Set nd_Suivant = ndc.GetFirstDocument
		Do Until nd_Suivant Is Nothing
			Set nd = nd_Suivant
			Set nd_Suivant = ndc.GetNextDocument(nd_Suivant)
			n = 0
			
			v_FraisTotal = xVar(nd, "Prod_FraisEntretienTotal", 0)
			If v_FraisTotal = 0 Then
				v_FraisTotal = xVar(nd, "Prod_Quantite", 0) * xVar(nd, "Prod_FraisEntretienAnnuels", 0)
			End If
			
			If v_FraisTotal &gt; 0 Then
				
				v_Frais = xVar(nd, "Prod_FraisEntretienAnnuels", 0)
				
				If v_Frais = 0 Then				' Temporaire
					v_Frais = xVar(nd, "Prod_FraisEntretien", 0) * 12
				End If
				
				' Mettre à jour les mensualités
				For i = n To UBound(pa_PeriodeA)
					pa_MensualitesLG(i) = pa_MensualitesLG(i) + _
					((v_Frais * xVar(nd,"Prod_Quantite",0)) / 12)
				Next
				
			End If
		Loop
	End If
	
	SDSI_CalculerMensualitesLG = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_DeterminerBaseProjeto"><lotusscript>Function SDSI_DeterminerBaseProjeto(pnd As NotesDocument, p_Origine As String) As String
	On Error GoTo GererErreur
	
	If p_Origine = "SF" Then
		SDSI_DeterminerBaseProjeto = ""
	ElseIf p_Origine &lt;&gt; "SICl" Then
		SDSI_DeterminerBaseProjeto = p_Origine
	Else
		Select Case xSICl_xVarClie(xVar(pnd, "Prop_ClientNoFmt", ""), "Clie_ClientCategorie", "", True)
		Case "60"
			SDSI_DeterminerBaseProjeto = "PJSDS"
		Case "62"
			SDSI_DeterminerBaseProjeto = "PJUSA"
		Case Else
			SDSI_DeterminerBaseProjeto = "PJDIV"
	End Select
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_AssemblerServices"><lotusscript>Function SDSI_AssemblerServices(pnd_Prop As NotesDocument, pnd_Site As NotesDocument, p_NoSite As Long, _
	p_NbCategories As Long,p_PrixTotal As Double) As Boolean
	' ----------------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux services d'une succursale.
	' ----------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_Langue As String
	Dim v_NomSite As String
	Dim i As Integer
	
	SDSI_AssemblerServices = False
	
	v_NomSite = Ucase(xEvaluate(|@If(!@IsNull(Site_ClientNomInterne); Site_ClientNomInterne; @IsNull(Site_ClientNoFmt); Site_ClientNom; (Site_ClientNom1 : Site_ClientNom2))
|, pnd_Site))
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	
	If Not SILT_ExtraireLettreType("SDSI_ServSite", v_Langue, False) Then
		Exit Function
	End If
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	If p_NbCategories &gt; 0 Then
		For i = 1 To p_NbCategories
			If Not SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\ServCat" &amp; Cstr(i) &amp; ".docx", "[SDSI_ServCat]", 1) Then
				Exit Function
			End If
		Next
	End If
	
	Call SIMW_SupprimerTexte("[SDSI_ServCat]", 1)
	
	' Remplacer les valeurs de la succursale
	Call SIMW_TrouverRemplacer("[Site_ClientNom]", v_NomSite)
	Call SIMW_TrouverRemplacer("[Site_PrixTotalSV]", SDSI_FormatDevise(p_PrixTotal, g_LangueContrat_SDSI))	
	
	Call SIMW_TrouverRemplacer("[Prop_Devise]", xVar(pnd_Prop, "Prop_Devise", ""))
	
	' Sauvegarder le document Word
	If SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\ServSite" &amp; Cstr(p_NoSite) &amp; ".docx", "") Then
		' Fermer le document Word
		If SIMW_FermerDocument Then
			SDSI_AssemblerServices = True
		End If
	End If
	
	If gc_SupprimerFichiers_SDSI Then
		If p_NbCategories &gt; 0 Then
			For i = 1 To p_NbCategories
				Kill g_DossierTemp_SDSI &amp; "\ServCat" &amp; Cstr(i) &amp; ".docx"
			Next
		End If
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_DescProduitsLG"><lotusscript>Function SDSI_DescProduitsLG(pnd_Prop As NotesDocument, pnd_Prod As NotesDocument, p_NbUtilisateurs As Long) As String
	On Error Goto GererErreur
	
	Dim v_DescriptionLG As String
	Dim v_NbUtilisateurs As Long
	Dim v_DescUtilisateursNonDisponible As String
	
	v_DescriptionLG = ((xSDSBB_xVarProd(xVar(pnd_Prod, "Prod_CleProduitAH", ""), "Prod_DescContrat" &amp; _
	g_LangueContrat_SDSI, xVar(pnd_Prod, "Prod_DescProduit" &amp; g_LangueContrat_SDSI, ""), True)))
	
	If g_LangueContrat_SDSI = "FR" Then
		v_DescUtilisateursNonDisponible = "n/d"
	Else
		v_DescUtilisateursNonDisponible = "n/a"
	End If
	
	If Instr(v_DescriptionLG, "¢NbUtilisateurs!") &gt; 0 Then
		
		v_NbUtilisateurs = xVar(pnd_Prod, "Prod_NbUtilisateursLicense", "")
		
		If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3"  Then
			If xVar(pnd_Prod, "Prod_CleParent", "") = "" AND xVar(pnd_Prod, "Prod_NoContratFmt_CS", "") = "" Then
				v_DescriptionLG = Replace(v_DescriptionLG, "¢NbUtilisateurs!", CStr(v_NbUtilisateurs))
			Else
				v_DescriptionLG = Replace(v_DescriptionLG, "¢NbUtilisateurs!", v_DescUtilisateursNonDisponible)
			End If			
		Else
			v_DescriptionLG = Replace(v_DescriptionLG, "¢NbUtilisateurs!", CStr(v_NbUtilisateurs))
		End If
		
	Elseif Instr(v_DescriptionLG, "&amp;L") &gt; 0 Then
		
		v_NbUtilisateurs = xVar(pnd_Prod, "Prod_NbUtilisateursLicense", "")
		
		If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then
			If xVar(pnd_Prod, "Prod_CleParent", "") = "" And xVar(pnd_Prod, "Prod_NoContratFmt_CS", "") = "" Then
				v_DescriptionLG = Replace(v_DescriptionLG, "&amp;L", CStr(v_NbUtilisateurs))
			Else
				v_DescriptionLG = Replace(v_DescriptionLG, "&amp;L", v_DescUtilisateursNonDisponible)
			End If			
		Else
			v_DescriptionLG = Replace(v_DescriptionLG, "&amp;L", CStr(v_NbUtilisateurs))
		End If
		
	Elseif Instr(v_DescriptionLG, "¢L!") &gt; 0 Then
		
		v_NbUtilisateurs = xVar(pnd_Prod, "Prod_NbUtilisateursLicense", "")
		
		If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then
			If xVar(pnd_Prod, "Prod_CleParent", "") = "" And xVar(pnd_Prod, "Prod_NoContratFmt_CS", "") = "" Then
				v_DescriptionLG = Replace(v_DescriptionLG, "¢L!", CStr(v_NbUtilisateurs))
			Else
				v_DescriptionLG = Replace(v_DescriptionLG, "¢L!", v_DescUtilisateursNonDisponible)
			End If			
		Else
			v_DescriptionLG = Replace(v_DescriptionLG, "¢L!", CStr(v_NbUtilisateurs))
		End If
		
	Elseif Instr(v_DescriptionLG, "&amp;U") &gt; 0 Then
		v_NbUtilisateurs = xVar(pnd_Prod, "Prod_NbUtilisateursCalcule", "")
		
		If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then
			If xVar(pnd_Prod, "Prod_CleParent", "") = "" And xVar(pnd_Prod, "Prod_NoContratFmt_CS", "") = "" Then
				v_DescriptionLG = Replace(v_DescriptionLG, "&amp;U", CStr(v_NbUtilisateurs))
			Else
				v_DescriptionLG = Replace(v_DescriptionLG, "&amp;U", v_DescUtilisateursNonDisponible)
			End If			
		Else
			v_DescriptionLG = Replace(v_DescriptionLG, "&amp;U", CStr(v_NbUtilisateurs))
		End If
		
	Elseif Instr(v_DescriptionLG, "¢U!") &gt; 0 Then
		v_NbUtilisateurs = xVar(pnd_Prod, "Prod_NbUtilisateursCalcule", "")
		
		If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then
			If xVar(pnd_Prod, "Prod_CleParent", "") = "" And xVar(pnd_Prod, "Prod_NoContratFmt_CS", "") = "" Then
				v_DescriptionLG = Replace(v_DescriptionLG, "¢U!", CStr(v_NbUtilisateurs))
			Else
				v_DescriptionLG = Replace(v_DescriptionLG, "¢U!", v_DescUtilisateursNonDisponible)
			End If			
		Else
			v_DescriptionLG = Replace(v_DescriptionLG, "¢U!", CStr(v_NbUtilisateurs))
		End If
		
	End If
	
	SDSI_DescProduitsLG = v_DescriptionLG
	
	p_NbUtilisateurs = v_NbUtilisateurs
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_TypeInstallationSDS"><lotusscript>Function SDSI_TypeInstallationSDS(pnd_Prop As NotesDocument) As String
	' ---------------------------------------------------------------------------------------------------------------
	'	Ce script détermine si le client est Hébergé (Cloud) ou non.
	'
	'	Paramètre:
	'		pnd_Prop:	document de proposition
	'
	'	Valeur retournée:	1 - le client est hébergé (Cloud)
	'						"" ou "0" - le client n'est pas hébergé 
	'						9 - le client n'existe pas dans Projeto 
	' ---------------------------------------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim nd_Client As NotesDocument
	Dim nd_ClientSICl As NotesDocument	
	Dim nd_Projet As NotesDocument
	
	Dim v_Origine As String
	
	' Initialisation
	SDSI_TypeInstallationSDS = ""	
	v_Origine = xVar(pnd_Prop, "Prop_Origine", "")	'SICl, PJSDS ou PJUSA
	If v_Origine = "SF" Then
		SDSI_TypeInstallationSDS = "1"
		Exit Function
	End If
	
	' Si on est en Local, extraire le type d'installation SDS de Projeto
	If Len(pnd_Prop.ParentDatabase.Server) = 0 Then
		If v_Origine = "SICl" Then		
			If xVar(pnd_Prop, "Prop_ClientPays", "") &lt;&gt; "CA" Then
				Set nd_Client = xPJ_xndClieSI("PJUSA", xVar(pnd_Prop, "Prop_ClientNoFmt", ""), True)
			Else
				Set nd_Client = xPJ_xndClieSI("PJSDS", xVar(pnd_Prop, "Prop_ClientNoFmt", ""), True)
			End If	
			
			If Not nd_Client Is Nothing Then
				SDSI_TypeInstallationSDS = xVar(nd_Client, "Clie_TypeInstallationSDS", "")
			Else
				' Impossible de déterminer si le client est hébergé ou non
				SDSI_TypeInstallationSDS = "9"
			End If	
		Else
			Set nd_Projet = xPJ_xndProj(v_Origine, xVar(pnd_Prop, "Prop_NoProjet", ""), True)
			Set nd_Client = xPJ_xndClie(v_Origine, xVar(nd_Projet, "Clie_NoClient", ""), True)	
			If Not nd_Client Is Nothing Then			
				SDSI_TypeInstallationSDS = xVar(nd_Client, "Clie_TypeInstallationSDS", "")	
			End If
		End If	
	Else	
		' Sinon extraire le type d'installation SDS de SI Clients
		If SDSI_ndClientOrigine(pnd_Prop, nd_Client, v_Origine, True) Then		
			If v_Origine = "SICl" Then										' Client SI Clients
				SDSI_TypeInstallationSDS = xVar(nd_Client, "Clie_TypeInstallationSDS", "")
			Else	
				If xVar(nd_Client, "Clie_NoClientFmt", "") &lt;&gt; "" Then		' Client Projeto
					' Extraire le document de SI Clients
					Set nd_ClientSICl = xSICl_xndClie(xVar(nd_Client, "Clie_NoClientFmt", ""), False)
					SDSI_TypeInstallationSDS = xVar(nd_ClientSICl, "Clie_TypeInstallationSDS", "")	
				Else
					' Prospect Projeto   
				End If
			End If
		End If
	End If

	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_ContratRequis"><lotusscript>Function SDSI_ContratRequis(pnd_Prop As NotesDocument) As Boolean
	On Error GoTo GererErreur
	
	Dim nd_TpPp As NotesDocument
	Dim ni As NotesItem
	
	Dim a_ContratRequis As Variant
	Dim a_ClasseProduit As Variant
	Dim v_ContratValeur As Double
	
	Set nd_TpPp = xSDSBB_xndTpPp(xVar(pnd_Prop, "Prop_TypeProposition", "0"), True)
	Set ni = nd_TpPp.GetFirstItem("TpPp_PropOptions")
	If ni.Contains("CR") Then
		SDSI_ContratRequis = True
	Else
		SDSI_ContratRequis = False
		
		' Si on veut imprimer un bon de commande, vérifier qu'il n'y a pas
		' de produit necessitant un contrat.
		
		a_ContratRequis = Evaluate(|v_Tableau := @DbLookup("" : "NoCache"; ""; "V_Prod20"; "| &amp; _
		xVar(pnd_Prop, "Prop_NoProposition","") &amp; |"; 9 ;[PARTIALMATCH]); @If(@IsError(v_Tableau); 0; @Sum(v_Tableau))|)
		
		If a_ContratRequis(0) &gt; 0 Then				' Contrat requis
			SDSI_ContratRequis = True
		Else
			a_ClasseProduit = Evaluate(|v_Tableau := @DbLookup("" : "NoCache"; ""; "V_Prod20"; "| &amp; _
			xVar(pnd_Prop, "Prop_NoProposition","") &amp; |"; 13 ;[PARTIALMATCH]); @If(@IsError(v_Tableau); ""; @Trim(@Unique(@Sort(v_Tableau))))|)
			If UBound(a_ClasseProduit) &gt; 0 Or a_ClasseProduit(0) &lt;&gt; "SV" Then
				v_ContratValeur = xVar(gnd_Prof_SDSI, "Prof_ContratValeur", 999999)
				If SDSI_PrixTotal(pnd_Prop, 0, 0, 0, False) &gt;= v_ContratValeur Then
					SDSI_ContratRequis = True
				End If
			End If
		End If
		
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_ImprimerPropositionSommaire"><lotusscript>Function SDSI_ImprimerPropositionSommaire(pnd_Prop As NotesDocument, p_Unique As String) As Boolean
	' ---------------------------------------------------
	' Le script permet d'imprimer un proposition sommaire
	' ---------------------------------------------------
	On Error GoTo GererErreur
	
	Dim v_NbSite As Long
	Dim v_NomFichierDoc As String
	Dim v_NotesEqui As String
	Dim v_NbLicensesi5 As Long
	Dim v_Impression As String
	Dim v_NomClient As String
	Dim a_PeriodeA() As Long
	Dim a_MensualitesEQ() As Double
	Dim a_MensualitesLG() As Double
	Dim a_MensualitesEN() As Double
	Dim a_MensualitesFN() As Double
	Dim a_MensualitesPP() As Double
	Dim a_Periodes() As String
	Dim i As Integer
	Dim v_Mensualite60MoisPlus As String
	Dim v_Mensualites5Ans As Double
	
	Dim v_PrixTotalEQ As Double
	Dim v_PrixTotalLG As Double
	Dim v_PrixTotalSV As Double
	Dim v_PrixTotalPR As Double
	Dim v_MensualiteFN As Double
	Dim v_Prop_EntretienMensuelLG_1 As Double
	Dim v_Prop_EntretienAnnuelLG_1 As Double
	Dim v_TauxMaj As Double
	Dim v_Prop_EntretienAnnuelEQ_1 As Double
	
	Dim v_Prop_EscompteMensuel As Double
	Dim v_Prop_EscompteInvest As Double
	Dim v_Prop_EntretienMensuelLG As Double
	
	If xVar(pnd_Prop, "Prop_NbProposition", 0) = 0 Then
		' Le No de proposition n'est pas assigné.
		MessageBox xGDK_xMessage("SDSPP", 129, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	v_Impression = xGDK_xMessage("SDSPP", 56, "", xGDK_xMessage("SDSPP", 57, "", ""))
	Print v_Impression
	
	' Initialisations
	SDSI_ImprimerPropositionSommaire = False
	Call SDSI_Initialisations
	Call SILT_Initialisations
	
	g_NoProposition_SDSI = xVar(pnd_Prop, "Prop_NoProposition", "")
	g_NbProposition_SDSI = CStr(xVar(pnd_Prop, "Prop_NbProposition", 0))
	g_LangueContrat_SDSI = xVar(pnd_Prop, "Prop_Langue", "FR")
	
	
	'v_NomClient = Ucase(xEvaluate(|@If(!@IsNull(Prop_ClientNomInterne); Prop_ClientNomInterne; @IsNull(Prop_ClientNoFmt); Prop_ClientNom; (Prop_ClientNom1 : Prop_ClientNom2))
	'|, pnd_Prop))
	v_NomClient = UCase(xEvaluate(|@If(!@IsNull(Prop_ClientNomInterne);Prop_ClientNomInterne;Prop_ClientNom)|, pnd_Prop))
	
	p_Unique = ""
	If Not SDSI_CreerDossier Then
		Exit Function
	End If
	
	' Démarer Word
	' ------------
	If SIMW_DemarrerWord(False) Then
		
		' Générer équipments sommaire
		REM Call SDSI_GenererEquipementsSomm(pnd_Prop)
		' Généré logiciels sommaire
		Call SDSI_GenererLogicielsSomm(pnd_Prop)
		
		' Extraire le document Word
		If Not SILT_ExtraireLettreType("SDSI_SommAH", g_LangueContrat_SDSI, False) Then
			Exit Function
		End If
		
		' Ouvrir le document Word
		If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
			Exit Function
		End If
		
		Call SIMW_TrouverRemplacer("[Site_ClientNom]", v_NomClient)
		
		' Ajouter les équipments &amp; logiciels
		REM Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\EquiSomm.docx", "[SDSI_Equi]", 1)
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\LogiSomm.docx", "[SDSI_Logi]", 1)
		
		REM Call SIMW_SupprimerTexte("[SDSI_Equi]", 1)
		Call SIMW_SupprimerTexte("[SDSI_Logi]", 1)
		
		v_PrixTotalPR = SDSI_PrixTotal(pnd_Prop, v_PrixTotalEQ, v_PrixTotalLG, v_PrixTotalSV, False)
		
		v_Prop_EscompteInvest = xVar(pnd_Prop, "Prop_EscompteMontant", 0) + xVar(pnd_Prop, "Prop_EscompteCorporatif", 0)
		v_Prop_EscompteMensuel = xVar(pnd_Prop, "Prop_EscompteMensualite", 0)
		
		Call SIMW_TrouverRemplacer("[SDSI_EscompteInvest]", SDSI_FormatDevise(v_Prop_EscompteInvest, g_LangueContrat_SDSI))
		Call SIMW_TrouverRemplacer("[SDSI_EscomptePaiementMensuel]", SDSI_FormatDevise(v_Prop_EscompteMensuel, g_LangueContrat_SDSI))
		
		Call SIMW_TrouverRemplacer("[SDSI_EQPrixTotal]", SDSI_FormatDevise(v_PrixTotalEQ, g_LangueContrat_SDSI))
		Call SIMW_TrouverRemplacer("[SDSI_SVPrixTotal]", SDSI_FormatDevise(v_PrixTotalSV, g_LangueContrat_SDSI))
		Call SIMW_TrouverRemplacer("[SDSI_InvestTotal]", SDSI_FormatDevise((v_PrixTotalEQ + v_PrixTotalSV) - v_Prop_EscompteInvest, g_LangueContrat_SDSI))
		Call SDSI_EntretienMensuelTotal(pnd_Prop, 0, v_Prop_EntretienMensuelLG)
		Call SIMW_TrouverRemplacer("[SDSI_LGPrixTotal]", SDSI_FormatDevise(v_Prop_EntretienMensuelLG, g_LangueContrat_SDSI))
		
		v_MensualiteFN = SDSI_MensualiteFinancement(v_PrixTotalPR - xVar(pnd_Prop, "Prop_EscompteMontant", 0) - xVar(pnd_Prop, "Prop_EscompteCorporatif", 0))
		v_Mensualites5Ans = v_MensualiteFN + v_Prop_EntretienMensuelLG_1
		
		' Calculer les mensualités
		' ------------------------
		Call SDSI_CalculerMensualites(pnd_Prop, a_PeriodeA, a_MensualitesEQ, a_MensualitesLG, _
		a_MensualitesEN, a_MensualitesFN, a_MensualitesPP, a_Periodes)
		
		For i = 0 To UBound(a_PeriodeA)
			'	If a_PeriodeA(i) &lt; 60 Then
			'	v_Mensualite60Mois = SDSI_FormatDevise(a_MensualitesPP(i), g_LangueContrat_SDSI)
			'	End If
			If a_PeriodeA(i) &gt; 60 Then
				v_Mensualite60MoisPlus= SDSI_FormatDevise(a_MensualitesPP(i) - v_Prop_EscompteMensuel, g_LangueContrat_SDSI)
			End If
		Next
		
		Call SIMW_TrouverRemplacer("[SDSI_PaiementMensuel5Total]", v_Mensualite60MoisPlus)
		
		'Mettre à jour les entêtes
		On Error 213 GoTo skipSection
		For i = 1 To 99
			Call g_WordDoc_SIMW.Sections(i).Headers(1).Range.Find.Execute("[Prop_ClientNom]", _
			False, False, False, False, False, True, 1, False, v_NomClient, 2)
		Next
skipSection:
		
		' Sauvegarder le document Word
		' ----------------------------
		v_NomFichierDoc = "PropSomm_" &amp; g_Unique_SDSI &amp; ".docx"
		
		If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\" &amp; v_NomFichierDoc, "") Then
			Exit Function
		End If
		
		' Attacher le contrat à la proposition
		' ------------------------------------
		If SDSI_CreerDocument(pnd_Prop, v_NomFichierDoc, "S") Then
			
			' Imprimer le contrat
			' -------------------
			Print v_Impression &amp; " " &amp; xGDK_xMessage("SI", 186, "", "")
			If SIMW_ImprimerDocument(True) Then
				SDSI_ImprimerPropositionSommaire = True
				
				' Attendre la fin de l'impression
				Call SIMW_AttendreFinImpression
			End If
			
			' Fermer le document
			' ------------------
			Call SIMW_FermerDocument
			
			If gc_SupprimerFichiers_SDSI Then
				Kill g_DossierTemp_SDSI &amp; "\" &amp; v_NomFichierDoc
			End If
			p_Unique = g_Unique_SDSI
		End If
		
	End If
	
	' Fermer Word
	' -----------
	Call SILT_TerminerTraitement
	
	' Détruire le dossier du contrat
	' ------------------------------
	If gc_SupprimerFichiers_SDSI Then
		On Error 75 Resume Next		' Path/file access error
		RmDir g_DossierTemp_SDSI
	End If
	
	' Mettre à jour l'historique de la proposition
	' --------------------------------------------
	Call SIHi_Ajouter(pnd_Prop, "", "Action : " &amp; _
	"Impression du proposition sommaire  /  Contract windows sticker (" &amp; p_Unique &amp; ")", "", False)
	
	Call SIHi_BatirHistorique(pnd_Prop)
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Call SIMW_FermerWord
	Exit Function
End Function

</lotusscript></code><code event="SDSI_AjouterService"><lotusscript>Function SDSI_AjouterService(pa_Service As Variant, p_NouvelleCategorie As Boolean, p_Ligne As Integer) As Boolean
	' ----------------------------------------------------------------------------------------
	' Le script permet d'ajouter un service dans le document Word liés aux services d'un site.
	' ----------------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_WordTable As Variant
	Dim v_WordRow As Variant
	
	SDSI_AjouterService = False
	
	' Extraire la table des produits services
	' ---------------------------------------
	Set v_WordTable = g_WordDoc_SIMW.Tables(1)
	
	Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(p_Ligne))	
	
	If p_NouvelleCategorie = False Then
		pa_Service(3) = ""
	End If
	
	Call v_WordTable.Cell(p_Ligne,1).Range.InsertAfter(pa_Service(3))
	Call v_WordTable.Cell(p_Ligne,2).Range.InsertAfter(pa_Service(4))
	Call v_WordTable.Cell(p_Ligne,3).Range.InsertAfter(pa_Service(5))
	Call v_WordTable.Cell(p_Ligne,4).Range.InsertAfter(pa_Service(6))
	
	p_Ligne = p_Ligne + 1
	SDSI_AjouterService = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_AssemblerContrat"><lotusscript>Function SDSI_AssemblerContrat(pnd_Prop As Notesdocument, p_NbSite As Long, _
	p_NomFichierDoc As String, p_NomFichierPDF As String, p_NbFichiersPlanSite As Integer) As Boolean
	' -----------------------------------------------------------------
	' Le script permet d'assembler les documents généré dans le contrat
	' -----------------------------------------------------------------
	On Error Goto GererErreur
	On Error 75 Resume Next
	
	Dim v_Langue As String
	Dim v_NotesContrat As Boolean
	Dim i As Integer
	Dim j As integer
	Dim v_NomClient As String
	Dim a_AdresseClient(1 To 4) As String
	Dim a_MontantsSectionsLGSite As Variant
	REM Dim v_Escompte As Double
	REM Dim v_EscompteMensualite As Double
	Dim v_TotalMensuelLG As Double
	Dim v_TotalLGS1 As Double
	Dim v_TotalLGS2 As Double
	REM Dim v_MontantFinancer As Double
	Dim v_NbSectionsConvLG As Integer
	Dim v_TypeContrat As String		
	Dim v_DureeContrat As Long
	Dim v_Prop_DureeContrat As Integer
	Dim v_PeriodeContrat As Long	
	Dim v_Prop_ClientNoFmt As String
	Dim v_DateDebutContrat As Variant
	
	' Initialisations
	SDSI_AssemblerContrat = False
	
	v_Prop_ClientNoFmt = xVar(pnd_Prop, "Prop_ClientNoFmt","")
	v_NbSectionsConvLG = gc_NbSectionsConvLG_SDSI	
	
	v_Prop_DureeContrat = xVar(pnd_Prop, "Prop_ContratDuree","1")
	
	' Générer les notes du contrat
	v_NotesContrat = SDSI_GenererNotes(pnd_Prop, "C")
	
	' Créer le document Word
	' ----------------------
	v_Langue = g_LangueContrat_SDSI
	
	If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then 'Conversion
		v_TypeContrat = "SDSI_ContConv"
	Else
		v_TypeContrat = "SDSI_Cont"
	End If
	
	
	If Not SILT_ExtraireLettreType(v_TypeContrat &amp; xVar(pnd_Prop, "Prop_ClientProvince", ""), v_Langue, True) Then
		If Not SILT_ExtraireLettreType(v_TypeContrat, v_Langue, False) Then
			Exit Function
		End If
	End If
	
	' Ouvrir le document Word
	' -----------------------
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	' Ajouter les sites
	If p_NbSite &gt; 0 Then
		For i = 1 To p_NbSite
			Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\EquiSite" &amp; Cstr(i) &amp; ".docx", "[SDSI_Equi]", 1)
			Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\ServSite" &amp; Cstr(i) &amp; ".docx", "[SDSI_Serv]", 1)
			
			If v_TypeContrat = "SDSI_Cont" Then
				Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\LogiSite" &amp; CStr(i) &amp; ".docx", "[SDSI_Logi]", 1)				
			End If			
		Next
	End If
	
	' Ajouter les montants de conversion
	If v_TypeContrat = "SDSI_ContConv" Then
		a_MontantsSectionsLGSite = xListElem(gl_MontantsSectionsLGSites_SDSI,xVarElem(pnd_Prop, "Prop_NoSites", 0 , ""), 0) 
		For j = 1 To v_NbSectionsConvLG
			Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\LogiConv" &amp; CStr(j) &amp; ".docx", "[SDSI_LogiConv" &amp; CStr(j) &amp; "]", 1)	
			
			If j =  4 Then
				Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\TotauxLogiConv.docx", "[SDSI_TotauxLGConv]", 1)		
				'Call SIMW_TrouverRemplacer("[SDSI_LogiConvSousTotal" &amp; j &amp; "]",SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(j-1)), g_LangueContrat_SDSI))
				'Call SIMW_TrouverRemplacer("[SDSI_LogiConvTotal" &amp; j &amp; "]",SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(j-1) - xVar(pnd_Prop, "Prop_EscompteMensualite", 0)), g_LangueContrat_SDSI))
			Else
				Call SIMW_TrouverRemplacer("[SDSI_LogiConvTotal" &amp; j &amp; "]",SDSI_FormatDevise(CDbl(a_MontantsSectionsLGSite(j-1)), g_LangueContrat_SDSI))
			End If
			
			'Call SIMW_SupprimerTexte("[SDSI_LogiConv" &amp; CStr(j) &amp; "]", 1)
		Next
		
		REM	v_Escompte = (xVar(pnd_Prop, "Prop_EscompteMontant", 0) + xVar(pnd_Prop, "Prop_EscompteCorporatif", 0))
		REM rem rem rem v_EscompteMensualite = xVar(pnd_Prop, "Prop_EscompteMensualite", 0)
		REM v_TotalLGS1 = CDbl(a_MontantsSectionsLGSite(2) + a_MontantsSectionsLGSite(3) - v_EscompteMensualite)		
		
	%REM	
		 v_MontantFinancer = (SDSI_MontantTotal(pnd_Prop, 0, 0) - v_Escompte)	
				
		 Call SIMW_TrouverRemplacer("[Prop_MontantFinancer]", SDSI_FormatDevise(v_MontantFinancer, g_LangueContrat_SDSI))
		 Call SIMW_TrouverRemplacer("[Prop_MontantFinancerTexte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_MontantFinancer)), v_Langue)))
		
		If Fraction(v_MontantFinancer) = 0 Then
			Call SIMW_TrouverRemplacer("[Prop_MontantFinancerCentsTexte]", "")
		Else
			If v_Langue = "EN" Then
				Call SIMW_TrouverRemplacer("[Prop_MontantFinancerCentsTexte]", " and " &amp;UCase(SItN_NombreEnLettres(CLng((Fraction(v_MontantFinancer) * 100)), v_Langue)) &amp; " cents")
			Else
				Call SIMW_TrouverRemplacer("[Prop_MontantFinancerCentsTexte]", " et " &amp;UCase(SItN_NombreEnLettres(CLng((Fraction(v_MontantFinancer) * 100)), v_Langue)) &amp; " cents")	
			End If
			
		End If
	%END REM
		
		
		REM REM REM Call SIMW_TrouverRemplacer("[Prop_EscompteMensualite]", SDSI_FormatDevise(v_EscompteMensualite, v_Langue))						
		
	%REM
		Call SIMW_TrouverRemplacer("[Prop_TotalLGS1]", SDSI_FormatDevise(v_TotalLGS1, v_Langue))
		Call SIMW_TrouverRemplacer("[Prop_TotalLGS1Texte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_TotalLGS1)), v_Langue)))
		
		If Fraction(v_TotalLGS1) = 0 Then
			Call SIMW_TrouverRemplacer("[Prop_TotalLGS1CentsTexte]", "")
		Else
			If v_Langue = "EN" Then
				Call SIMW_TrouverRemplacer("[Prop_TotalLGS1CentsTexte]", " and " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_TotalLGS1) * 100)), v_Langue)) &amp; " cents")
			Else
				Call SIMW_TrouverRemplacer("[Prop_TotalLGS1CentsTexte]", " et " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_TotalLGS1) * 100)), v_Langue)) &amp; " cents")
			End If
		End if	
	%END REM
		
		
	%REM
		v_TotalLGS2 = CDbl(a_MontantsSectionsLGSite(1) + a_MontantsSectionsLGSite(2) + a_MontantsSectionsLGSite(3) - v_EscompteMensualite)
		
		Call SIMW_TrouverRemplacer("[Prop_TotalLGS2]", SDSI_FormatDevise(v_TotalLGS2, v_Langue))
		Call SIMW_TrouverRemplacer("[Prop_TotalLGS2Texte]", UCase(SItN_NombreEnLettres(CLng(Fix(v_TotalLGS2)), v_Langue)))
		
		If Fraction(v_TotalLGS2) = 0 Then
			Call SIMW_TrouverRemplacer("[Prop_TotalLGS2CentsTexte]", "")
		Else
			If v_Langue = "EN" Then
				Call SIMW_TrouverRemplacer("[Prop_TotalLGS2CentsTexte]", " and " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_TotalLGS2) * 100)), v_Langue)) &amp; " cents")
			Else
				Call SIMW_TrouverRemplacer("[Prop_TotalLGS2CentsTexte]", " et " &amp; UCase(SItN_NombreEnLettres(CLng((Fraction(v_TotalLGS2) * 100)), v_Langue)) &amp; " cents")
			End If
		End If	
	%END REM
		
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\DateEnVigueurConv.docx", "[Prop_ContratEnVigueur]", 1)		
		
	Else
		
		' 0 = 3 mois, 1 = 1 an , 2 = 3 ans, 3 = 5 ans
		If v_Prop_DureeContrat = 0 Then
			v_PeriodeContrat = 3
		ElseIf 	v_Prop_DureeContrat = 4 Then
			v_PeriodeContrat = 60	
		ElseIf 	v_Prop_DureeContrat = 7 Then
			v_PeriodeContrat = 36
		ElseIf v_Prop_DureeContrat = 10 Then
			v_PeriodeContrat = 72	
		ElseIf v_Prop_DureeContrat = 66 Then
			v_PeriodeContrat = 66
		ElseIf v_Prop_DureeContrat = 84 Then
			v_PeriodeContrat = 84
		Else
			v_PeriodeContrat = 12	
		End If		
		
		Call SIMW_TrouverRemplacer("[Prop_ContratPeriodeTexte]", UCase(SItN_NombreEnLettres(v_PeriodeContrat, v_Langue)))		
		Call SIMW_TrouverRemplacer("[Prop_ContratPeriodeNumero]", CStr(v_PeriodeContrat))		
		
		Call SIMW_TrouverRemplacer("[Prop_ContratDureeComplementDesc]", _
		(xSDSBB_xComplTabl(xVar(pnd_Prop, "Prop_ContratDuree","1"), "Prop_ContDuree_" &amp; v_Langue, "4",True) &amp; " " &amp; _
		xSDSBB_xComplTabl(xVar(pnd_Prop, "Prop_ContratDuree","1"), "Prop_ContDuree_" &amp; v_Langue, "2",True)) )
		
	End If
	
	v_TotalMensuelLG = (g_EntretienTotalLG_SDSI - g_EscompteTotalLG_SDSI)
	
	v_DureeContrat = CLng(xSDSBB_xComplTabl(xVar(pnd_Prop, "Prop_ContratDuree","1"), "Prop_ContDuree_" &amp; v_Langue, "1",True))
	
	Call SIMW_TrouverRemplacer("[Prop_ContratDureeTexte]", UCase(SItN_NombreEnLettres(v_DureeContrat, v_Langue)))		
	Call SIMW_TrouverRemplacer("[Prop_ContratDureeNumero]", CStr(v_DureeContrat))
	Call SIMW_TrouverRemplacer("[Prop_ContratDureeDesc]", xSDSBB_xComplTabl(xVar(pnd_Prop, "Prop_ContratDuree","1"), "Prop_ContDuree_" &amp; v_Langue, "2",True))
	'Call SIMW_TrouverRemplacer("[Prop_ContratDureeComplement] ", xSDSBB_xComplTabl(xVar(pnd_Prop, "Prop_ContratDuree","1"), "Prop_ContDuree_" &amp; v_Langue, "3",True))
	Call SIMW_TrouverRemplacer("[Prop_ContratDureeComplement]", UCase(SItN_NombreEnLettres(CInt(xSDSBB_xComplTabl(xVar(pnd_Prop, "Prop_ContratDuree","1"), "Prop_ContDuree_" &amp; v_Langue, "1",True)), v_Langue)))
	
	Call SIMW_SupprimerTexte("[SDSI_Equi]", 1)
	Call SIMW_SupprimerTexte("[SDSI_Serv]", 1)	
	Call SIMW_SupprimerTexte("[SDSI_Logi]", 1)
	
	If v_TypeContrat = "SDSI_Cont" Then
		' Ajouter mensualités
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\Mens.docx", "[SDSI_TotalMensuelLG]", 1)
		Call SIMW_TrouverRemplacer("[Prop_TotalMensuelLG]", SDSI_FormatDevise(v_TotalMensuelLG, v_Langue))
	Else
		' Ajouter montants de conversion
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\MontantsConv.docx", "[SDSI_TotalConvLG]", 1)
	End If
	
	
	
	' Ajouter investiments
	Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\InvestEQSV.docx", "[SDSI_InvestEQSV]", 1)
	
	'Remplacer les valeurs de la proposition
	If xVar(pnd_Prop, "Prop_ClientNomLegal", "") &lt;&gt; "" Then
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\SignatureSignataire.docx", "[SDSI_SignatureSignataire]", 1)
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\SignatureAcceptance.docx", "[SDSI_SignatureAcceptance]", 1)
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\SignatureAcceptance.docx", "[SDSI_SignatureAcceptanceA7]", 1)
	Else		
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\NoSignature.docx", "[SDSI_SignatureSignataire]", 1)
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\NoSignature.docx", "[SDSI_SignatureAcceptance]", 1)
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\NoSignature.docx", "[SDSI_SignatureAcceptanceA7]", 1)
	End If	
	Call SIMW_SupprimerTexte("[SDSI_SignatureSignataire]", 1)
	Call SIMW_SupprimerTexte("[SDSI_SignatureAcceptance]", 1)
	Call SIMW_SupprimerTexte("[SDSI_SignatureAcceptanceA7]", 1)
	
	Call SIMW_TrouverRemplacer("[TitreSignataire]", xVarProf("Prof_TitreSignataire" &amp; v_Langue, ""))
	Call SIMW_TrouverRemplacer("[Signataire]", xEvaluate(|@Name([CN]; "| &amp; xVarProf("Prof_Signataire", "") &amp; |")|, Nothing))
	
	v_DateDebutContrat = xVar(pnd_Prop, "Prop_DateDebutContrat", "")
	
	If v_TypeContrat = "SDSI_ContConv" Then		
		If v_DateDebutContrat &lt;&gt; "" Then					
			Call SIMW_TrouverRemplacer("[Prop_DateDebutContrat]", SItD_DateLongue(xVar(pnd_Prop, "Prop_DateDebutContrat", ""), v_Langue))
		Else
			Call SIMW_TrouverRemplacer("[Prop_DateDebutContrat]", "")
			
		End If
	End If
	
	If v_NotesContrat Then
		Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\NotesContrat.docx", "[SDSI_NotesContrat]", 1)
	End If
	Call SIMW_SupprimerTexte("[SDSI_NotesContrat]", 1)
	
	'v_NomClient = Ucase(xEvaluate(|@If(!@IsNull(Prop_ClientNomInterne); Prop_ClientNomInterne; @IsNull(Prop_ClientNoFmt); Prop_ClientNom; (Prop_ClientNom1 : Prop_ClientNom2))|, pnd_Prop))
	v_NomClient = Ucase(xEvaluate(|@If(!@IsNull(Prop_ClientNomInterne);Prop_ClientNomInterne;Prop_ClientNom)|, pnd_Prop))
	
	If xvar(pnd_Prop, "Prop_ClientNomLegal", "") &lt;&gt; "" Then
		v_NomClient = xVar(pnd_Prop, "Prop_ClientNomLegal", "") &amp; Chr(13) &amp; "O/A " &amp; v_NomClient
	End If
	
	Call SIMW_TrouverRemplacer("[Prop_ClientNom]", v_NomClient)
	Call SIMW_TrouverRemplacer("[Prop_ClientNomTo]", Replace(v_NomClient, Chr(13) , " "))
	
	If xVar(pnd_Prop, "Prop_ClientAdresse2", "") = "" Then
		Call SIMW_TrouverRemplacer("[Prop_ClientAdresse]", 	xVar(pnd_Prop, "Prop_ClientAdresse1", ""))
	Else		
		Call SIMW_TrouverRemplacer("[Prop_ClientAdresse]", xVar(pnd_Prop, "Prop_ClientAdresse1", "") &amp; " " &amp; xVar(pnd_Prop, "Prop_ClientAdresse2", ""))
	End If
	Call SIMW_TrouverRemplacer("[Prop_ClientVille]", xVar(pnd_Prop, "Prop_ClientVille", ""))
	Call SIMW_TrouverRemplacer("[Prop_ClientProvince]", SDSI_FmtProvince(pnd_Prop, "Prop", ""))
	Call SIMW_TrouverRemplacer("[Prop_ClientCodePostal]", xVar(pnd_Prop, "Prop_ClientCodePostal", ""))
	Call SIMW_TrouverRemplacer("[Prop_ContactNom]", xVar(pnd_Prop, "Prop_ContactNom", ""))
	Call SIMW_TrouverRemplacer("[Prop_ContactFonction]", xEvaluate( |@Replace(Prop_ContactFonction; @IfError(@DbLookup(""; @ServerName : "SI_GDK.nsf"; "V_Tabl20"; "Cont_FonctionsSDS| &amp; _
	g_LangueContrat_SDSI &amp; |"; 4); ""); @IfError(@DbLookup(""; @ServerName : "SI_GDK.nsf"; "V_Tabl20"; "Cont_FonctionsSDS| &amp; _
	g_LangueContrat_SDSI &amp; |"; 5); ""))|, pnd_Prop))
	
	Call SIMW_TrouverRemplacer("[Prop_ContactTitre]", "")
	Call SIMW_TrouverRemplacer("[Prop_ContactTelephone]", SDSI_ContactTelephoneImp(pnd_Prop, xVar(pnd_Prop, "Prop_NoContact", "")))
	
	Call SIMW_TrouverRemplacer("[Prop_ContactCellulaire]", xVar(pnd_Prop, "Prop_ContactCellulaire", ""))
	Call SDSI_ConstruireAdresse(pnd_Prop, a_AdresseClient)
	For i = 1 To 4
		Call SIMW_TrouverRemplacer("[Prop_ClientAdresseLigne" &amp; i &amp; "]", a_AdresseClient(i))
	Next
	
	Call SIMW_TrouverRemplacer("[Prop_NomRepresentant]", xVar(pnd_Prop, "Prop_NomRepresentant", ""))
	Call SIMW_TrouverRemplacer("[TitreRepresentant]", xSIRR_xVarRepr(Cstr(xVar(pnd_Prop, "Prop_NoRepresentant", "")), _
	"Repr_Titre" &amp; v_Langue, xGDK_xMessage("SI", 205, v_Langue, ""), True))
	
	Call SIMW_TrouverRemplacer("[DateContratLong]", SItD_DateLongue(Today, v_Langue))
	Call SIMW_TrouverRemplacer("[DateContratLongUC]", Ucase(SItD_DateLongue(Today, v_Langue)))
	Call SIMW_TrouverRemplacer("[Prop_Plateforme]", xVarImplode(pnd_Prop, "Temp_Plateforme", ", "))
	
	Call SIMW_TrouverRemplacer("[Prop_EntretienTotalMensuelLG]", SDSI_FormatDevise(g_EntretienTotalLG_SDSI, v_Langue))
	
	REM v_Escompte = (xVar(pnd_Prop, "Prop_EscompteMontant", 0) + xVar(pnd_Prop, "Prop_EscompteCorporatif", 0))
	
	Call SIMW_TrouverRemplacer("[Prop_EscompteTotalLG]", SDSI_FormatDevise(g_EscompteTotalLG_SDSI, v_Langue))

	Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\TermePaiement.docx", "[SDSI_TermePaie]", 1)
	Call SIMW_SupprimerTexte("[TermePaie]", 1)
	
	Call SIMW_InsererDocument(g_DossierTemp_SDSI &amp; "\PrixPaiement.docx", "[SDSI_PrixPaie]", 1)
	Call SIMW_SupprimerTexte("[PrixPaie]", 1)
	
	
	If p_NbFichiersPlanSite &gt; 0 Then
		For i = 1 To p_NbFichiersPlanSite
			'Print g_DossierTemp_SDSI &amp; "\PlanSiteImage" &amp; CStr(i) &amp; ".gif"
			Call SIMW_InsererImage(g_DossierTemp_SDSI &amp; "\PlanSiteImage" &amp; CStr(i) &amp; ".gif", "[Prop_PlanSite]",0, 450, 1.3, 1.3,True)			
		Next
	End If
	Call SIMW_SupprimerTexte("[Prop_PlanSite]", 1)	
	
	' Mettre à jour les entêtes et pieds de page
	On Error 213 Goto skipSection
	For i = 1 To 99
		Call g_WordDoc_SIMW.Sections(i).Headers(1).Range.Find.Execute("[Prop_ClientNom]", _
		False, False, False, False, False, True, 1, False, v_NomClient, 2)
		Call g_WordDoc_SIMW.Sections(i).Footers(1).Range.Find.Execute("[DateContratCourt]", _
		False, False, False, False, False, True, 1, False, Format(Today, "yyyy/mm/dd"), 2)
		
		If g_NbProposition_SDSI &lt;&gt; "" And g_NbProposition_SDSI &lt;&gt; "0" And Left(g_NbProposition_SDSI, 1) &lt;&gt; "." Then		
			If v_Prop_ClientNoFmt &lt;&gt; "" Then
				Call g_WordDoc_SIMW.Sections(i).Footers(1).Range.Find.Execute("[Prop_Unique]", _			
				False, False, False, False, False, True, 1, False, (g_Unique_SDSI &amp; " - " &amp; g_NbProposition_SDSI &amp; " - " &amp; v_Prop_ClientNoFmt), 2)
			Else
				Call g_WordDoc_SIMW.Sections(i).Footers(1).Range.Find.Execute("[Prop_Unique]", _			
				False, False, False, False, False, True, 1, False, (g_Unique_SDSI &amp; " - " &amp; g_NbProposition_SDSI ), 2)
			End If						
		Else		
			Call g_WordDoc_SIMW.Sections(i).Footers(1).Range.Find.Execute("[Prop_Unique]", _
			False, False, False, False, False, True, 1, False, g_Unique_SDSI &amp; " - " &amp; g_NoProposition_SDSI, 2)
		End If		
	Next
	
skipSection:
	' Mettre à jour la table des matières
	'Randy
'	g_WordDoc_SIMW.Fields.Update
'	g_WordDoc_SIMW.TablesOfContents(1).Update
	
	' Sauvegarder le document Word
	' ----------------------------
	'p_NomFichierDoc = "Contrat_" &amp; g_Unique_SDSI &amp; ".docx"
	p_NomFichierDoc = "Contrat_" &amp; g_Unique_SDSI &amp; "-" &amp; CStr(xVar(pnd_Prop, "Prop_NbProposition", "")) &amp; ".docx"
	p_NomFichierPDF = SLFWIN_NomFichierValide("C" &amp; CStr(xVar(pnd_Prop, "Prop_NbProposition", "")) &amp; "-" &amp; xVar(pnd_Prop, "Prop_ClientNom", "") &amp; ".pdf")
	
	If SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\" &amp; p_NomFichierDoc, "") Then
		SDSI_AssemblerContrat = True
	End If
	
	' Supprimer les fichiers de travail
	' ---------------------------------
	If gc_SupprimerFichiers_SDSI Then
		
		If p_NbSite &gt; 0 Then
			
			For i = 1 To p_NbSite
				Kill g_DossierTemp_SDSI &amp; "\EquiSite" &amp; Cstr(i) &amp; ".docx"
				Kill g_DossierTemp_SDSI &amp; "\ServSite" &amp; Cstr(i) &amp; ".docx"
				
				If v_TypeContrat = "SDSI_Cont" Then
					Kill g_DossierTemp_SDSI &amp; "\LogiSite" &amp; CStr(i) &amp; ".docx"
				End If				
			Next
			
			If v_TypeContrat = "SDSI_Cont" Then
				Kill g_DossierTemp_SDSI &amp; "\Mens.docx"
			Else
				Kill g_DossierTemp_SDSI &amp; "\MontantsConv.docx"
			End If
			
			Kill g_DossierTemp_SDSI &amp; "\PrixPaiement.docx"
			Kill g_DossierTemp_SDSI &amp; "\TermePaiement.docx"
			Kill g_DossierTemp_SDSI &amp; "\InvestEQSV.docx"
			
			If v_NotesContrat Then
				Kill g_DossierTemp_SDSI &amp; "\NotesContrat.docx"
			End If
			
			If xVar(pnd_Prop, "Prop_ClientNomLegal", "") = "" Then
				Kill g_DossierTemp_SDSI &amp; "\NoSignature.docx"
			Else
				Kill g_DossierTemp_SDSI &amp; "\SignatureSignataire.docx"
				Kill g_DossierTemp_SDSI &amp; "\SignatureAcceptance.docx"
			End If
			
		End If
		
		If v_TypeContrat = "SDSI_ContConv" Then
			If v_NbSectionsConvLG &gt; 0 Then
				For i = 1 To v_NbSectionsConvLG
					Kill g_DossierTemp_SDSI &amp; "\LogiConv" &amp; CStr(i) &amp; ".docx"
				Next
			End If
			Kill g_DossierTemp_SDSI &amp; "\DateEnVigueurConv.docx"
		End If
		
		If p_NbFichiersPlanSite &gt; 0 Then
			For i = 1 To p_NbFichiersPlanSite
				Kill g_DossierTemp_SDSI &amp; "\PlanSiteImage" &amp; CStr(i) &amp; ".gif"
			Next
		End If
		
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_BCGenererLogiciels"><lotusscript>Function SDSI_BCGenererLogiciels(pnd_Prop As NotesDocument, pnv_Prod As NotesView, p_NoSite As String, p_Ligne As Integer, p_Total As Double, p_EscompteMensualite As Variant) As Boolean
	' ------------------------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux logiciels d'un site.
	' ------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim nv_Prod16 As NotesView		
	Dim nd_Suivant As NotesDocument
	Dim nd As NotesDocument	
	
	Dim v_PremiereCategorie As Boolean
	Dim v_CategorieCourante As String
	Dim v_WordTable As Variant
	Dim v_WordRow As Variant	
	Dim v_NouvelleCategorie As Boolean
	Dim v_NbCategories As Long
	Dim v_Description As String
	Dim v_PrixTotal As Double
	Dim v_PrixTotalCat As Double
	Dim v_EntretienTotalCat As Double
	Dim v_FraisTotal As Double
	Dim v_Frais As Double
	Dim v_FraisMensuel As Double
	Dim v_FraisMensuelTotal As Double
	Dim v_QuantiteTotal As Integer
	Dim v_PosProduitImprime As Integer	
	Dim s As String
	
	
	' Initialisations
	SDSI_BCGenererLogiciels = False
	v_PremiereCategorie = True
	v_CategorieCourante = "QWERTY"
	
	ReDim a_ClesProduitsImprime(1000) As String
	v_PosProduitImprime = 0
	
	Set v_WordTable = g_WordDoc_SIMW.Tables(1)
	
	
	' Générer les logiciels par categorie
	' -----------------------------------
	Set nv_Prod16 = gndb_SDSI.GetView("V_Prod16")
	Call nv_Prod16.Refresh
	
	Set nd_Suivant = nv_Prod16.Getdocumentbykey(p_NoSite, False)
	
	Do Until nd_Suivant Is Nothing
		
		Set nd = nd_Suivant
		Set nd_Suivant = nv_Prod16.Getnextdocument(nd_Suivant)
		If xVar(nd_Suivant, "Prod_NoSite", "") &lt;&gt; p_NoSite Then
			Set nd_Suivant = Nothing
		End If
		
		
		If xVar(nd, "Prod_Quantite", 0) &lt;&gt; 0 And xVar(nd,"Prod_TypeDescendant", "") = "" Then
			'If (xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropImpression", "0", True) &lt;&gt; "0" And xVar(nd, "Prod_Quantite", 0) &gt; 0) Then
			
			' Changement de Categorie
			' -----------------------
			If xVar(nd, "Prod_CategorieProduit", "") &lt;&gt; v_CategorieCourante Then
				
				If Not v_PremiereCategorie Then
					p_Total = p_Total + v_PrixTotal
				Else
					v_PremiereCategorie = False
				End If
				
				v_NbCategories = v_NbCategories + 1
				v_CategorieCourante = xVar(nd, "Prod_CategorieProduit", "")
				v_Description = xSDSBB_xVarCate(v_CategorieCourante, "Cate_DescCategorie" &amp; _
				g_LangueContrat_SDSI, "", True)
				v_NouvelleCategorie = True
				v_PrixTotalCat = 0
				v_EntretienTotalCat = 0
				v_PrixTotal = 0
			End If
			
			' Ajouter le produit logiciel
			' ---------------------------
			If xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropImpression", "0", True) &lt;&gt; "0" Then
				
				s = SDSI_DescProduitsLG(pnd_Prop, nd,0)
				
				If v_NouvelleCategorie Then
					If v_Description &lt;&gt; "" Then
						
						'Ajouter la description de la catégorie
						p_Ligne = p_Ligne + 1			
						Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(p_Ligne))
						Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter(v_Description)
						v_WordTable.Cell(p_Ligne, 1).Range.Bold = True
						v_Description = ""						
						
						'''v_Description = v_Description &amp; s &amp; " [" &amp; xVar(nd, "Prod_CodeProduit", "") &amp; "]"
						v_Description = s &amp; " [" &amp; xVar(nd, "Prod_CodeProduit", "") &amp; "]"
					End If
				Else
					v_Description = s &amp; " [" &amp; xVar(nd, "Prod_CodeProduit", "") &amp; "]"
				End If
				
				v_Frais = xVar(nd, "Prod_FraisEntretienAnnuels", 0) * xVar(nd, "Prod_Quantite",0)
				
				If v_Frais = 0 Then	
					v_Frais = (xVar(nd, "Prod_FraisEntretien", 0) * 12) * xVar(nd, "Prod_Quantite",0)
				End If
				
				If v_Frais &gt; 0 Then					
					'v_FraisMensuel = (v_Frais /12) / xVar(nd, "Prod_Quantite", 0) 
					v_FraisMensuel = SItN_Round(v_Frais/12, 2) / xVar(nd, "Prod_Quantite", 0) 
				Else				 
					v_FraisMensuel = xVar(nd, "Prod_FraisEntretien", 0) / xVar(nd, "Prod_Quantite", 0) 
				End If
				
				'v_Description = v_Description &amp; g_NewLine_SDSI &amp; _
				'xGDK_xMessage("SDSPP", 99, g_LangueContrat_SDSI,SDSI_FormatDevise((v_Frais/12), g_LangueContrat_SDSI))
				
			End If
			
			v_PrixTotal = v_PrixTotal + xVar(nd, "Prod_PrixTotal", 0)
			v_QuantiteTotal = v_QuantiteTotal + xVar(nd, "Prod_Quantite", 0)
			
			p_Ligne = p_Ligne + 1			
			
			' Ajouter le logiciel
			If Not SDSI_BCAjouterLogiciel(nd, v_Description, p_Ligne, v_FraisMensuel) Then
				Exit Function
			End If
			
			v_FraisMensuelTotal = v_FraisMensuelTotal + (v_FraisMensuel * xVar(nd, "Prod_Quantite", 0))
			
			' Ajouter les dépendants
			If Not SDSI_BCAjouterDependants(pnd_Prop, pnv_Prod, p_Ligne, p_NoSite, xVar(nd, "Prod_NoProduit", ""), p_Total, v_FraisMensuelTotal) Then
				Exit function
			End If
			
			v_Description = ""						
			
			
			v_NouvelleCategorie = False
		End If
		
	Loop
	
	
	' Si des logiciels ont été créés
	' ------------------------------
	If v_NbCategories &gt; 0 Then
		
		Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter(v_Description)		
		g_WordDoc_SIMW.Tables(1).Cell(p_Ligne +4, 4).Range.InsertAfter(SDSI_FormatDevise(((v_FraisMensuelTotal)- p_EscompteMensualite), g_LangueContrat_SDSI))
		p_Total = p_Total + v_PrixTotal		
	End If
	
	SDSI_BCGenererLogiciels = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_ConstruireAdresse"><lotusscript>Function SDSI_ConstruireAdresse(pnd_Prop As Notesdocument, p_AdresseClient() As String)
	' -----------------------------------------------------------
	' Le script permet de construire l'adresse de la proposition.
	' -----------------------------------------------------------
	On Error Goto GererErreur
	
	Dim i As Integer
	Dim v_Province As String
	
	If xVar(pnd_Prop, "Prop_ClientAdresse1", "") &lt;&gt; "" Then
		i = i + 1
		p_AdresseClient(i) = xVar(pnd_Prop, "Prop_ClientAdresse1", "")
	End If
	If xVar(pnd_Prop, "Prop_ClientAdresse2", "") &lt;&gt; "" Then
		i = i + 1
		p_AdresseClient(i) = xVar(pnd_Prop, "Prop_ClientAdresse2", "")
	End If
	v_Province = SDSI_FmtProvince(pnd_Prop, "Prop", "")
	If xVar(pnd_Prop, "Prop_ClientVille", "") &lt;&gt; "" Or v_Province &lt;&gt; "" Then
		i = i + 1
		If xVar(pnd_Prop, "Prop_ClientVille", "") = "" Then
			p_AdresseClient(i) = xVar(pnd_Prop, "Prop_ClientProvince", "")
		Elseif v_Province = "" Then
			p_AdresseClient(i) = xVar(pnd_Prop, "Prop_ClientVille", "")
		Else
			p_AdresseClient(i) = xVar(pnd_Prop, "Prop_ClientVille", "") &amp; " (" &amp; v_Province &amp; ")"
		End If
	End If
	If xVar(pnd_Prop, "Prop_ClientCodePostal", "") &lt;&gt; "" Then
		i = i + 1
		p_AdresseClient(i) = xVar(pnd_Prop, "Prop_ClientCodePostal", "")
	End If
	
	' Compléter les champs d'adresse avec des valeurs nulles
	For i = i + 1 To 4
		p_AdresseClient(i) = ""
	Next
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_CalculerMensualites"><lotusscript>Sub SDSI_CalculerMensualites(pnd As NotesDocument, pa_PeriodeA() As Long, _
	pa_MensualitesEQ() As Double, pa_MensualitesLG() As Double, pa_MensualitesEN() As Double, _
	pa_MensualitesFN() As Double, pa_MensualitesPP() As Double, _
	pa_Periodes() As String)
	' ------------------------------------------------------------
	' Le script permet d'ajouter une succursale à une proposition.
	' ------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim i As Long
	Dim v As Long
	
	' Initialisations
	Call SDSI_Initialisations
	ReDim pa_PeriodeA(0) As Long
	ReDim pa_MensualitesEQ(0) As Double
	pa_PeriodeA(0) = 999
	
	' Calculer les mensualités des équipements
	' ----------------------------------------
	If Not SDSI_CalculerMensualitesEQ(pnd, pa_PeriodeA, pa_MensualitesEQ) Then
		Exit Sub
	End If
	
	' Calculer les mensualités des logiciels
	' --------------------------------------
	If Not SDSI_CalculerMensualitesLG(pnd, pa_PeriodeA, pa_MensualitesEQ, _
	pa_MensualitesLG) Then
		Exit Sub
	End If
	
	' Calculer les mensualités du financement
	' ---------------------------------------
	If Not SDSI_CalculerMensualitesFN(pnd, pa_PeriodeA, pa_MensualitesEQ, _
	pa_MensualitesLG, pa_MensualitesFN) Then
		Exit Sub
	End If
	
	
	' Calculer les variables des totaux
	' ---------------------------------
	ReDim pa_Periodes(UBound(pa_PeriodeA)) As String
	ReDim pa_MensualitesPP(UBound(pa_PeriodeA)) As Double
	ReDim pa_MensualitesEN(UBound(pa_PeriodeA)) As Double
	v = 1
	For i = 0 To UBound(pa_PeriodeA)
		pa_Periodes(i) = CStr(v) &amp; " - " &amp; CStr(pa_PeriodeA(i))
		'pa_MensualitesEN(i) = pa_MensualitesEQ(i) + pa_MensualitesSDS(i) + _
		pa_MensualitesEN(i) = pa_MensualitesEQ(i) + _
		pa_MensualitesLG(i)
		pa_MensualitesPP(i) = pa_MensualitesEN(i) + pa_MensualitesFN(i)
		If i &lt; UBound(pa_PeriodeA) Then
			v = pa_PeriodeA(i) + 1
		End If
	Next
	pa_Periodes(UBound(pa_PeriodeA)) = CStr(v) &amp; " +"
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="SDSI_GenererNotes"><lotusscript>Function SDSI_GenererNotes(pnd_Prop As NotesDocument, p_Type As String) As Boolean
	' ------------------------------------------------
	' Le script permet de générer les notes de contrat
	' ------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_Langue As String
	Dim v_NomLettreType As String
	Dim v_NomFichier As String
	Dim v_NotesContrat As String
	
	SDSI_GenererNotes = False
	
	v_NotesContrat = xVar(pnd_Prop, "Prop_NotesContrat", "")
	If Fulltrim(v_NotesContrat) = "" Then
		Exit Function
	End If
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	
	If p_Type = "C" Then
		v_NomLettreType = "SDSI_NotesContrat"
		v_NomFichier = "NotesContrat.docx"
	Elseif p_Type = "B" Then
		v_NomLettreType = "SDSI_NotesBCom"
		v_NomFichier = "NotesBCom.docx"
	End If
	
	If Not SILT_ExtraireLettreType(v_NomLettreType, v_Langue, False) Then
		Exit Function
	End If
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	Call SIMW_TrouverRemplacer("[SDSI_NotesContrat]", v_NotesContrat)
	
	' Sauvegarder le document Word
	If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\" &amp; v_NomFichier, "") Then
		Exit Function
	End If
	
	' Fermer le document Word
	If Not SIMW_FermerDocument Then
		Exit Function
	End If
	
	SDSI_GenererNotes = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_PrixTotal"><lotusscript>Function SDSI_PrixTotal(pnd_Prop As NotesDocument, p_PrixTotalEQ As Double, _
	p_PrixTotalLG As Double, p_PrixTotalSV As Double, p_ProdCommissionable As boolean) As Double
	' --------------------------------------------------------------------------
	' Le script permet de déterminer le prix total d'une proposition.
	' Si les prix totaux EQ, LG et SV ne sont pas requis, passer 0 en paramètre.
	' --------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_PrixEQ As Variant
	Dim v_PrixLG As Variant
	Dim v_PrixSV As Variant	
	Dim v_NoProp As String
	
	' Initialisations
	SDSI_PrixTotal = 0
	
	v_NoProp = xVar(pnd_Prop, "Prop_NoProposition", "")
	
	If p_ProdCommissionable = False Then
		
		v_PrixEQ = Evaluate({@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "} &amp; _
		(v_NoProp &amp; ";" &amp; "EQ.") &amp; {"; 5; [PARTIALMATCH]); 0))})
		v_PrixLG = Evaluate({@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "} &amp; _
		(v_NoProp &amp; ";" &amp; "LG.")  &amp; {"; 5; [PARTIALMATCH]); 0))})
		v_PrixSV = Evaluate({@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "} &amp; _
		(v_NoProp &amp; ";" &amp; "SV.") &amp; {"; 5; [PARTIALMATCH]); 0))})
		
	Else
		'******************************* Req 50970 MZE
		v_PrixEQ = Evaluate({@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod21"; "} &amp; _
		(v_NoProp &amp; ";" &amp; "EQ.") &amp; {"; 5; [PARTIALMATCH]); 0))})
		
		'v_PrixLG = Evaluate({@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod21"; "} &amp; _
		'(v_NoProp &amp; ";" &amp; "LG.")  &amp; {"; 5; [PARTIALMATCH]); 0))})
		
		v_PrixLG = Evaluate({@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod21"; "} &amp; _
		(v_NoProp &amp; ";" &amp; "LG.")  &amp; {"; 8; [PARTIALMATCH]); 0))})
		
		v_PrixSV = Evaluate({@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod21"; "} &amp; _
		(v_NoProp &amp; ";" &amp; "SV.") &amp; {"; 5; [PARTIALMATCH]); 0))})
		
	End If
	
	p_PrixTotalEQ = v_PrixEQ(0)
	p_PrixTotalLG = v_PrixLG(0)
	p_PrixTotalSV = v_PrixSV(0)
	SDSI_PrixTotal = v_PrixEQ(0) + v_PrixLG(0) + v_PrixSV(0)
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_CalculerSommaire"><lotusscript>Function SDSI_CalculerSommaire(pnd_Prop As NotesDocument) As Variant
	' --------------------------------------------------------------
	' Le script calcule les valeurs du sommaire de la proposition.
	' Parametres:		pnd_Prop: L'objet document de la proposition
	' --------------------------------------------------------------
	On Error Goto GererErreur
	Dim ndb As NotesDatabase
	Dim v_NoProposition As String
	Dim l_Sommaire List As Double
	
	Set ndb = pnd_Prop.ParentDatabase
	
	v_NoProposition = Cstr(xVar(pnd_Prop, "Prop_NoProposition", ""))
	
	l_Sommaire("PrixTotalEQ") = xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "| &amp; _
	v_NoProposition &amp; |"+ ";EQ."; 5 ;[PartialMatch]); 0))|, Nothing)	
	l_Sommaire("CoutTotalEQ") = xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "| &amp; _
	v_NoProposition &amp; |"+ ";EQ."; 7 ;[PartialMatch]); 0))|, Nothing)		
	l_Sommaire("PrixTotalSV") =xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "| &amp; _
	v_NoProposition &amp; |"+ ";SV."; 5 ;[PartialMatch]); 0))|, Nothing)
	l_Sommaire("CoutTotalSV") =xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "| &amp; _
	v_NoProposition &amp; |"+ ";SV."; 7 ;[PartialMatch]); 0))|, Nothing)
	
	l_Sommaire("ProfitPR") = (l_Sommaire("PrixTotalEQ") + l_Sommaire("PrixTotalSV")) - _
	(l_Sommaire("CoutTotalEQ") + l_Sommaire("CoutTotalSV"))
	
	l_Sommaire("ProfitNetPR") = l_Sommaire("ProfitPR") - xVar(pnd_Prop,"Prop_EscompteMontant",0) - xVar(pnd_Prop,"Prop_EscompteCorporatif",0)
	l_Sommaire("PrixTotalPR") = l_Sommaire("PrixTotalEQ") + l_Sommaire("PrixTotalSV")
	
	l_Sommaire("ProfitPR") = l_Sommaire("PrixTotalPR") - (l_Sommaire("CoutTotalEQ") + l_Sommaire("CoutTotalSV"))
	
	l_Sommaire("ProfitSV") = l_Sommaire("PrixTotalSV") - l_Sommaire("CoutTotalSV")
	
	'l_Sommaire("EntretienAnnuelEQ") = xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod20"; "| &amp; _
	'v_NoProposition &amp; |"+ ";EQ."; 8 ;[PartialMatch]); 0))|, Nothing)
	
	l_Sommaire("EntretienAnnuelLG") = xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod20"; "| &amp; _
	v_NoProposition &amp; |"+ ";LG."; 8 ;[PartialMatch]); 0))|, Nothing)
	
	l_Sommaire("TotalAjuste") = l_Sommaire("PrixTotalPR") - xVar(pnd_Prop,"Prop_EscompteMontant",0) - xVar(pnd_Prop,"Prop_EscompteCorporatif",0)
	
	SDSI_CalculerSommaire = l_Sommaire
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_EnvoyerDocuSign"><lotusscript>Function SDSI_EnvoyerDocuSign(pnd_Prop As NotesDocument, p_TypeImpression As String, p_TypeCourriel As String, p_RepondreA As String, p_Choix As String) As Boolean
	'******************************************
	'  *** REMPLACÉ PAR ONESPANSIGN
	'fonction à supprimer après test onespansign
	'*********************************************	
	On Error GoTo GererErreur
	On Error 75 Resume Next		' Path/file access error
	
	Dim nd_Courriel As NotesDocument
	Dim nd_CourrielMailIn As NotesDocument
	Dim nrti As NotesRichTextItem
	
	Dim a_PropContactNomsCCDsg As Variant
	Dim a_PropContactCourrielsCCDsg As Variant
	Dim i As integer
	Dim v_NoEmploye As String
	Dim v_Langue As String
	Dim v_NouvStatut As String	
	Dim v_Impression As Boolean	
	Dim v_CheminFichierPDF As String
	Dim v_MSG_Histo As String
	Dim v_Objet As String
	Dim v_Message As String
	Dim v_NoEnveloppe As Variant
	Dim v_Utilisateur As String
	Dim v_MotDePasse As String
	Dim v_RepondreA As String
	Dim v_SendTo As Variant
	Dim v_CopyTo As Variant
	Dim v_NomDestinataire As String
	Dim v_CourrielDestinataire As String
	Dim v_NomTablBCUsr As String
	
	Call SDSI_Initialisations
	
	v_Langue = g_LangueContrat_SDSI
	v_NouvStatut = "55"
	
	v_NomTablBCUsr = "SLDS_BCUsr_" &amp; v_Langue
	
	SDSI_EnvoyerDocuSign = False
	
	v_NoEmploye = CStr(xSIEm_xVarEmpl_Id(gns_SDSI.UserName, "Empl_NoEmploye", "", True))
	
	If p_TypeImpression = "B" Then
		v_Impression = SDSI_ImprimerBonCommande(pnd_Prop, xVar(pnd_Prop, "Cle", ""), False, True, v_CheminFichierPDF, p_Choix) 'passer p_modelecourriel comm eparametre d'entree
		
		If p_RepondreA &lt;&gt; "" Then
			v_RepondreA = p_RepondreA
		Else
			v_RepondreA = xVarTabl(v_NomTablBCUsr, "Tabl_ValeurDefaut", "", True) '02
		End If
		
		v_Utilisateur = xComplTabl(v_RepondreA, v_NomTablBCUsr, "1", True)	
		v_MotDePasse =  xComplTabl(v_RepondreA, v_NomTablBCUsr, "2", True)		
		
	ElseIf p_TypeImpression = "C" Then
		
		v_Impression = SDSI_ImprimerContrat(pnd_Prop, xVar(pnd_Prop, "Cle", ""), False, True, v_CheminFichierPDF, 0)
		
		v_RepondreA = xVarTabl("SLDS_CTUsr", "Tabl_ValeurDefaut", "", True)' 04
		
		v_Utilisateur = xComplTabl(v_RepondreA, "SLDS_CTUsr", "1", True)	
		v_MotDePasse =  xComplTabl(v_RepondreA, "SLDS_CTUsr", "2", True)
	Else
		v_Impression = False
	End If
	
	If v_Impression Then
		
		Set nd_Courriel = SDSI_GenererCourrielDocuSign(pnd_Prop, p_TypeImpression, p_TypeCourriel, v_RepondreA, v_CheminFichierPDF, nd_CourrielMailIn)
		
		If Not nd_Courriel Is Nothing Then
			
			v_Objet = xVar(nd_Courriel, "Subject", "")
			'v_Message = xVar(nd_Courriel, "Body", "")
			
			Set nrti = nd_Courriel.Getfirstitem("Body")
			v_Message = nrti.Text	
			
			If SDSPDSg_CreerEnveloppe(pnd_Prop, "PDSg_" &amp; v_NoEmploye, v_CheminFichierPDF, p_TypeImpression, v_Objet, v_Message, v_Utilisateur, v_MotDePasse, v_Langue) Then
				
				v_NoEnveloppe = xVar(pnd_Prop, "Prop_NoEnveloppe", "")
				
				' Mettre à jour l'historique de la proposition
				' --------------------------------------------
				If p_TypeImpression = "B" Then
					v_MSG_Histo = "Action :  Envoie du bon de commande avec DocuSign  /  Purchase order sent with DocuSign (" &amp; v_NoEnveloppe &amp; ")"
					
					v_NomDestinataire = xVar(gnd_Prof_SDSPDSg, "PDSg_NomDestinataireBC01", "")
					
					If Left(v_NomDestinataire, 1) = "$" Then
						v_NomDestinataire = SDSPDSg_RemplacerSignetDestinataire(pnd_Prop, v_NomDestinataire)
					End If
					
					v_CourrielDestinataire = xVar(gnd_Prof_SDSPDSg, "PDSg_CourrielDestinataireBC01", "")
					
					If Left(v_CourrielDestinataire, 1) = "$" Then
						v_CourrielDestinataire = SDSPDSg_RemplacerSignetDestinataire(pnd_Prop, v_CourrielDestinataire)
					End If
					
					
					v_SendTo = v_CourrielDestinataire  &amp; "  " &amp; Chr(34) &amp; v_NomDestinataire &amp; Chr(34)
					
				ElseIf p_TypeImpression = "C" Then

					v_MSG_Histo = "Action :  Envoie du contrat avec DocuSign  /  Contract sent with DocuSign (" &amp; v_NoEnveloppe &amp; ")"
					
					v_NomDestinataire = xVar(gnd_Prof_SDSPDSg, "PDSg_NomDestinataireCT01", "")
					
					If Left(v_NomDestinataire, 1) = "$" Then
						v_NomDestinataire = SDSPDSg_RemplacerSignetDestinataire(pnd_Prop, v_NomDestinataire)
					End If
					
					v_CourrielDestinataire = xVar(gnd_Prof_SDSPDSg, "PDSg_CourrielDestinataireCT01", "")
					
					If Left(v_CourrielDestinataire, 1) = "$" Then
						v_CourrielDestinataire = SDSPDSg_RemplacerSignetDestinataire(pnd_Prop, v_CourrielDestinataire)
					End If
					
					
					v_SendTo = v_CourrielDestinataire  &amp; "  " &amp; Chr(34) &amp; v_NomDestinataire &amp; Chr(34)
					
				End If
				
				' Copy to 								
				a_PropContactNomsCCDsg = Evaluate(|@Trim(Prop_ContactNomsCCDsg : Prop_ContactNomsManCCDsg)|, pnd_Prop)
				a_PropContactCourrielsCCDsg = Evaluate(|@Trim(Prop_ContactCourrielsCCDsg : Prop_ContactCourrielsManCCDsg)|, pnd_Prop)
				
				If IsArray(a_PropContactNomsCCDsg) And IsArray(a_PropContactCourrielsCCDsg) Then
					
					ReDim v_CopyTo(UBound(a_PropContactNomsCCDsg))
					
					For i = 0 To UBound(a_PropContactNomsCCDsg)
						v_CopyTo(i) = a_PropContactCourrielsCCDsg(i) &amp; "  " &amp; Chr(34) &amp; a_PropContactNomsCCDsg(i) &amp; Chr(34)
					Next
				ElseIf Not IsArray(a_PropContactNomsCCDsg) And Not IsArray(a_PropContactCourrielsCCDsg) Then
					v_CopyTo = a_PropContactCourrielsCCDsg &amp; "  " &amp; Chr(34) &amp; a_PropContactNomsCCDsg &amp; Chr(34)
				End If
				
				
				' Mettre à jour l'historique de la proposition
				' --------------------------------------------							
				If IsArray(v_SendTo) Then
					v_SendTo = Join(v_SendTo, ", ")
				End If
				If v_SendTo &lt;&gt; "" Then
					v_MSG_Histo = v_MSG_Histo &amp; Chr(10) &amp; "(A / To: " &amp; v_SendTo &amp; ")"
				End If
				
				If IsArray(v_CopyTo) Then
					v_CopyTo = Join(v_CopyTo, ", ")
				End If
				If v_CopyTo &lt;&gt; "" Then
					v_MSG_Histo = v_MSG_Histo &amp; Chr(10) &amp; "(CC: " &amp; v_CopyTo &amp; ")"
				End If
				
				'Statut Accepté-50 à En attente de signature-55
				If xVar(pnd_Prop, "Prop_Statut", "0") = "50" Then
					
					' Assigner le nouveau statut
					' --------------------------
					pnd_Prop.Prop_Statut = v_NouvStatut
					pnd_Prop.Prop_StatutDate = Now
					pnd_Prop.Prop_StatutIcone = xIcnTabl(v_NouvStatut, "Prop_Statut_FR", True)
					pnd_Prop.Prop_StatutDescFR = xDescTabl(v_NouvStatut, "Prop_Statut_FR", True)
					pnd_Prop.Prop_StatutDescEN = xDescTabl(v_NouvStatut, "Prop_Statut_EN", True)
					
					pnd_Prop.HistoDM = Now
					pnd_Prop.HistoUM = gns_SDSI.UserName
					
					Call SIHi_Ajouter(pnd_Prop, v_NouvStatut &amp; "-" &amp; xDescTabl(v_NouvStatut, "Prop_Statut_" &amp; g_LangueContrat_SDSI, True), v_MSG_Histo, "", True)				
				Else
					Call SIHi_Ajouter(pnd_Prop, "", v_MSG_Histo, "", True)								
				End If
				
			End If
		End If
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
	
End Function

</lotusscript></code><code event="SDSI_GenererSite"><lotusscript>Function SDSI_GenererSite(pnd_Prop As NotesDocument, pnd_Site As NotesDocument, p_NbSite As Long, p_TransfertMontantLG As Double, _
	pa_MontantsSectionsLG() As Double) As Boolean
	' --------------------------------------------------------------
	' Le script permet de générer les documents Word liés à un site.
	' --------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_EntretienTotalLG As Double
	
	' Initialisations
	SDSI_GenererSite = False
	
	' Générer l'équipement
	' --------------------
	If Not SDSI_GenererEquipement(pnd_Prop, pnd_Site, p_NbSite) Then
		Exit Function
	End If
	
	' Générer les logiciels
	' ---------------------
	
	'Conversion à logiciel-service
	If xVar(pnd_Prop, "Prop_TypeProposition", "") = "3" Then
		If Not SDSI_GenererLogiciels_Conv(pnd_Prop, pnd_Site, p_NbSite, pa_MontantsSectionsLG) Then
			Exit Function
		End if
	Else
		If Not SDSI_GenererLogiciels(pnd_Prop, pnd_Site, p_NbSite, v_EntretienTotalLG, p_TransfertMontantLG) Then
			Exit Function
		End If
	End If
	
	
	' Générer les services
	' --------------------
	If Not SDSI_GenererServices(pnd_Prop, pnd_Site, p_NbSite) Then
		Exit Function
	End If	
	
	' Incrémenter les variables globale pour les totaux sommaire
	g_EntretienTotalLG_SDSI = g_EntretienTotalLG_SDSI + v_EntretienTotalLG
	g_EscompteTotalLG_SDSI = g_EscompteTotalLG_SDSI + p_TransfertMontantLG
	
	SDSI_GenererSite = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_ContactTelephoneImp"><lotusscript>Function SDSI_ContactTelephoneImp(pnd As NotesDocument, p_ContactNo As String) As String
	On Error GoTo GererErreur
	%REM
	' ======= Voir si on veut les données(No Tél.) de Projeto ou ceux de la proposition
	
	Dim ndb_PJ As NotesDatabase
	Dim nv_ContactPJ As NotesView
	Dim nd_ContactPJ As NotesDocument
	Dim nd_ClientPJ As NotesDocument
	Dim nd_Proj As NotesDocument
	
	Dim v_Origine As String
	Dim v_BaseProj As String
	
	SDSI_ContactTelephoneImp = ""
	
	v_Origine = xVar(pnd, "Prop_Origine", "")
	v_BaseProj = SDSI_DeterminerBaseProjeto(pnd, v_Origine)

	Set ndb_PJ = xGDK_xndbNDB(v_BaseProj)
	Set nv_ContactPJ = ndb_PJ.GetView("v_Cont1")
	Set nd_ContactPJ = nv_ContactPJ.GetDocumentByKey(p_ContactNo, True)
	
	' Selectionnez le doc de client
	Set nd_ClientPJ = xPJ_xndClie(v_Origine, xVar(pnd, "Prop_ClientCleSitePrinc", ""), False)
	If nd_ClientPJ Is Nothing Then
		Set nd_Proj = xPJ_xndProj(v_Origine, xVar(pnd, "Prop_NoProjet", ""), True)
		If nd_Proj Is Nothing Then
			' Le document de référence (client ou projet) est introuvable.
			Call SIGE_AjouterLog("*** " &amp; xGDK_xMessage("SDSPP", 4, "", "") &amp; _
			" (NoProp: " &amp; xVar(pnd, "Prop_NoProposition", "") &amp; "  - NoCont: " &amp; p_ContactNo &amp; ") ***", 0, 110)
			
			Exit Function
		End If
		Set nd_ClientPJ = xPJ_xndClie(v_Origine, xVar(nd_Proj, "Clie_NoClient", ""), False)
	End If
	
	SDSI_ContactTelephoneImp = xVar(nd_ContactPJ, "Cont_TelephoneFmt", xVar(nd_ClientPJ, "Clie_Telephone", xVar(nd_ClientPJ, "Clie_Telephone2", "")))
	%END REM
	SDSI_ContactTelephoneImp = xVar(pnd, "Prop_ContactTelephone", xVar(pnd, "Prop_ClientTelephone", xVar(pnd, "Prop_ClientTelephone2", "")))
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererLogicielsSomm"><lotusscript>Function SDSI_GenererLogicielsSomm(pnd_Prop As NotesDocument) As Boolean
	
	Dim nv_Prod32 As NotesView
	Dim v_NoProposition As String
	Dim a_CleProduitsUnique As Variant
	Dim v_WordTable As Variant
	Dim v_WordRow As Variant
	Dim nd_Suivant As NotesDocument
	Dim nd As NotesDocument
	Dim v_Pos As Variant
	Dim v_TexteSommaire  As String
	Dim v_DescCourte As String
	Dim v_Langue As String
	Dim v_Ligne As Integer
	
	' Initialisations
	v_Ligne = 1	
	Set nv_Prod32 = gndb_SDSI.GetView("v_Prod32")
	Call nv_Prod32.Refresh
	v_NoProposition = xVar(pnd_Prop, "Prop_NoProposition", "") 
	a_CleProduitsUnique = Evaluate(|@Unique(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod32"; "| &amp; CStr(v_NoProposition &amp;";LG") &amp; |"; 4); ""))|)
	
	' Créer le document Word
	v_Langue = g_LangueContrat_SDSI
	If Not SILT_ExtraireLettreType("SDSI_LogiSomm", v_Langue, False) Then
		Exit Function
	End If
	
	' Ouvrir le document Word
	If Not SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
		Exit Function
	End If
	
	' Extraire la table des produits logiciels
	' ----------------------------------------
	Set v_WordTable = g_WordDoc_SIMW.Tables(1)
	
	Set nd_Suivant = nv_Prod32.GetDocumentByKey(CStr(v_NoProposition &amp;";LG"), True)
	
	Do Until nd_Suivant Is Nothing
		Set nd = nd_Suivant
		Set nd_Suivant = nv_Prod32.Getnextdocument(nd_Suivant)
		
		If xVar(nd_Suivant, "Prod_ClasseProduit", "") &lt;&gt; "LG" Then
			Set nd_Suivant = Nothing
		End If
		
		' Ajouter l'information du produit
		' --------------------------------
		v_Pos = ArrayGetIndex(a_CleProduitsUnique, xVar(nd, "Prod_CleProduit", ""))
		If Not IsNull(v_Pos) Then
			If  xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropSommaire", "0", True) = "1" Then
				Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(v_Ligne))
				v_TexteSommaire = xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_PropSommaireTexte" &amp; g_LangueContrat_SDSI, "", True) '&amp; g_NewLine_SDSI 
				
				If InStr(v_TexteSommaire, "¢NbUtilisateurs!") &gt; 0 Then
					v_TexteSommaire = Replace(v_TexteSommaire, "¢NbUtilisateurs!", CStr(xVar(nd, "Prod_NbUtilisateursLicense", "")))	
				ElseIf InStr(v_TexteSommaire, "¢NbUtilisateursSDS!") &gt; 0 Then
					v_TexteSommaire = Replace(v_TexteSommaire, "¢NbUtilisateursSDS!", CStr(xVar(nd, "Prod_NbUtilisateursLicense", "")))	
				ElseIf InStr(v_TexteSommaire, "¢NbUtilisateursSDSM!") &gt; 0 Then
					v_TexteSommaire = Replace(v_TexteSommaire, "¢NbUtilisateursSDSM!", CStr(xVar(nd, "Prod_NbUtilisateursLicense", "")))	
				ElseIf InStr(v_TexteSommaire, "&amp;L") &gt; 0 Then
					v_TexteSommaire = Replace(v_TexteSommaire, "&amp;L", CStr(xVar(nd, "Prod_NbUtilisateursLicense", "")))
				ElseIf InStr(v_TexteSommaire, "&amp;U") &gt; 0 Then
					v_TexteSommaire = Replace(v_TexteSommaire, "&amp;U", CStr(xVar(nd, "Prod_NbUtilisateursCalcule", "")))
				ElseIf InStr(v_TexteSommaire, "¢L!") &gt; 0 Then
					v_TexteSommaire = Replace(v_TexteSommaire, "¢L!", CStr(xVar(nd, "Prod_NbUtilisateursLicense", "")))
				ElseIf InStr(v_TexteSommaire, "¢U!") &gt; 0 Then
					v_TexteSommaire = Replace(v_TexteSommaire, "¢U!", CStr(xVar(nd, "Prod_NbUtilisateursCalcule", "")))
				End If
				
				
				v_DescCourte =  xSDSBB_xVarProd(xVar(nd, "Prod_CleProduit", ""), "Prod_DescProduit" &amp; g_LangueContrat_SDSI, "", True)
				
				If v_TexteSommaire &lt;&gt; "" Then
					Call v_WordTable.Cell(v_Ligne,1).Range.InsertAfter(v_TexteSommaire)
				Else
					Call v_WordTable.Cell(v_Ligne,1).Range.InsertAfter(v_DescCourte)
				End If
				
				v_Ligne = v_Ligne + 1
			End If
			a_CleProduitsUnique(v_Pos) = ""
		End If
		
	Loop
	
	
	' Sauvegarder le document Word
	If Not SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\LogiSomm.docx", "") Then
		Exit Function
	End If
	
	' Fermer le document Word
	If Not SIMW_FermerDocument Then
		Exit Function
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_FmtProvince"><lotusscript>Function SDSI_FmtProvince(pnd As Notesdocument, p_Prefixe As String, p_Prov As String) As String
	On Error Goto GererErreur
	
	Dim v_Province As String
	
	v_Province = xVar(pnd, p_Prefixe &amp; "_ClientProvince", "")
	If p_Prov = "E" Then
		v_Province = xVar(pnd, p_Prefixe &amp; "_ClientProvinceEnreg", v_Province)
	End If
	
	SDSI_FmtProvince = xGDK_xDescTabl(v_Province, "ISO3166-2" &amp; xVar(pnd, p_Prefixe &amp; "_ClientPays", "") &amp; _
	g_LangueContrat_SDSI, True)
	If SDSI_FmtProvince = "" Then
		SDSI_FmtProvince = v_Province
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_MensualiteFinancement"><lotusscript>Function SDSI_MensualiteFinancement(p_MontantFinancer As Double) As Double
	' --------------------------------------------------------------------------------
	' Le script permet de déterminer le coût mensuel de financement d'une proposition.
	' --------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim a_Bornes As Variant
	Dim a_Taux As Variant
	Dim i As Long
	
	' Initialisations
	' ---------------
	SDSI_MensualiteFinancement = 0
	'Call SDSI_Initialisations
	
	a_Bornes = xVarProf("Prof_BorneTaux", "")
	If IsArray(a_Bornes) Then
		a_Taux = xVarProf("Prof_ListeTaux", "")
		
		' Calcul de la mensualité
		' -----------------------
		For i = 0 To UBound(a_Bornes)
			If p_MontantFinancer &lt;= a_Bornes(i) Or i = UBound(a_Bornes) Then
				SDSI_MensualiteFinancement = Round(p_MontantFinancer * a_Taux(i) / 1000, 2)
				Exit Function
			End If
		Next
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererPlanSite"><lotusscript>Function SDSI_GenererPlanSite(pnd_Prop As NotesDocument, p_TypeDocument As String, p_NbFichiersPlanSite As Integer) As Boolean
	' ---------------------------------------------------------
	' Le script retourne le nom de fichier du dernier plan site
	' ----------------------------------------------------------
	On Error GoTo GererErreur
	
	SDSI_GenererPlanSite = False
	
	Dim a_Cle(1) As String
	Dim nv As NotesView
	Dim nd As NotesDocument
	Dim nrti As NotesRichTextItem	
	Dim neo As NotesEmbeddedObject
	Dim v_aneo As Variant
	Dim v_NomFichierDocu As String
	Dim v_DossierFichierPPT As String
	
	' Initialisations
	Call xSIDocV_Initialisations
	Set nv = gndb_xSIDocV.GetView("V_Docu22")
	a_Cle(0) = xVar(pnd_Prop, "Prop_NoProposition", "")
	a_Cle(1) = p_TypeDocument
	Set nd = nv.GetDocumentByKey(a_Cle, True)
	
	If Not nd Is Nothing Then
		
		v_NomFichierDocu = xVar(nd, "Docu_NomFichier", "")
		
		Set nrti = nd.Getfirstitem("Docu_Document")
		
		If nrti Is Nothing Then
			Exit Function
		ElseIf nrti.Type &lt;&gt; RICHTEXT Then
			Exit Function
		ElseIf IsArray(nrti.Embeddedobjects) = False Then
			Exit Function
		End If
		
		v_aneo = nrti.EmbeddedObjects
		
		ForAll neo2 In v_aneo
			Set neo = neo2
			If neo.Source = v_NomFichierDocu Then
				If Not SDSI_ExtraireDocument(v_aneo(LBound(v_aneo))) Then
					Exit Function
				End If
			End If
		End ForAll
		
		v_DossierFichierPPT = g_DossierTemp_SDSI &amp; "\" &amp; v_NomFichierDocu
		
		If SIMP_DemarrerPowerPoint Then
			If SIMP_OuvrirPresentation(v_DossierFichierPPT) Then
				If SIMP_EnregistrerPresentationGIF(g_DossierTemp_SDSI &amp; "\" &amp; "PlanSiteImage") Then
					
					p_NbFichiersPlanSite = g_NbDiapositiveExport
					If SIMP_FermerPowerPoint Then	
						
						Kill v_DossierFichierPPT	
						
					End If
				End If			
			End If
		End If	
		
	End if
	
	SDSI_GenererPlanSite = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_EnvoyerOneSpanSign"><lotusscript>Function SDSI_EnvoyerOneSpanSign(pnd_Prop As NotesDocument, p_TypeImpression As String, p_TypeCourriel As String, p_RepondreA As String, p_Choix As String) As Boolean
	On Error GoTo GererErreur
	On Error 75 Resume Next		' Path/file access error
	
	Dim nd_Courriel As NotesDocument	
	Dim nd_CourrielMailIn As NotesDocument	
	Dim nrti As NotesRichTextItem
	Dim nrti_OSsg As NotesRichTextItem	
	Dim a_PropContactNomsCCOSsg As Variant
	Dim a_PropContactCourrielsCCOSsg As Variant
	Dim i As Integer
	Dim v_NoEmploye As String
	Dim v_Langue As String
	Dim v_NouvStatut As String	
	Dim v_Impression As Boolean	
	Dim v_CheminFichierPDF As String
	Dim v_MSG_Histo As String
	Dim v_Objet As String
	Dim v_Message As String
	Dim v_NoEnveloppe As Variant
	Dim v_Profil As String
	Dim v_Utilisateur As String
	Dim v_MotDePasse As String
	Dim v_RepondreA As String
	Dim v_SendTo As Variant
	Dim v_CopyTo As Variant
	Dim v_PrenomDestinataire As String
	Dim v_NomDestinataire As Variant
	Dim v_CourrielDestinataire As Variant
	Dim v_NomTablBCUsr As String
	Dim v_NomTablCTUsr As String
	Dim v_CourrielExpediteur As String
	Dim v_NbOccurences As Integer
	Dim v_Nom As String
	Dim v_EnregistrerLog As Integer
	
	Call SDSI_Initialisations
	
	v_Langue = g_LangueContrat_SDSI
	v_NouvStatut = "55"
	
	v_NomTablBCUsr = "SLOSS_BCUsr_" &amp; v_Langue
	v_NomTablCTUsr = "SLOSS_CTUsr"
	
	v_Nom = xVar(pnd_Prop, "Prop_ClientNoFmt", "") &amp; "-" &amp; xVar(pnd_Prop, "Prop_ClientNom", xVar(pnd_Prop, "Prop_ClientNomInterne", "")) &amp; "-" &amp; _
	xVar(pnd_Prop, "Prop_NbPropositionTxt", "")
	
	SDSI_EnvoyerOneSpanSign = False
	v_EnregistrerLog = SIGE_OuvrirLog(gc_TypeElement_SDSI, gc_Element_SDSI)		'***************************************************************
	Call SIGE_AjouterLog(v_Nom, 0, 0, False)
	
	v_NoEmploye = CStr(xSIEm_xVarEmpl_Id(gns_SDSI.UserName, "Empl_NoEmploye", "", True))
	
	If p_TypeImpression = "B" Then
		Call SIGE_AjouterLog("** Impression sur un bon de commande", 0, 0, False)
		
		v_NbOccurences = 1
		
		v_Impression = SDSI_ImprimerBonCommande(pnd_Prop, xVar(pnd_Prop, "Cle", ""), False, True, v_CheminFichierPDF, p_Choix) 'passer p_modelecourriel comm eparametre d'entree
		
		If p_RepondreA &lt;&gt; "" Then
			v_RepondreA = p_RepondreA
		Else
			v_RepondreA = xVarTabl(v_NomTablBCUsr, "Tabl_ValeurDefaut", "", True) '02
		End If
		
		v_Utilisateur = xComplTabl(v_RepondreA, v_NomTablBCUsr, "1", True)	
		v_MotDePasse =  xComplTabl(v_RepondreA, v_NomTablBCUsr, "2", True)		
		
	ElseIf p_TypeImpression = "C" Then
		Call SIGE_AjouterLog("** Impression sur un contrat", 0, 0, False)
		
		v_Impression = SDSI_ImprimerContrat(pnd_Prop, xVar(pnd_Prop, "Cle", ""), False, True, v_CheminFichierPDF, v_NbOccurences)
		
		'Ne pas compter page couverture (page1) et tables de matières (page2)
		' Les signatures début sur page 3		
		'If v_NbOccurences &gt; 2 Then
		v_NbOccurences = v_NbOccurences  - 2
		'	v_NbOccurences = v_NbOccurences  - 1
		'Else
		'	v_NbOccurences = 0			
		'End If
		'v_NbOccurences = 1
		v_RepondreA = xVarTabl("SLOSS_CTUsr", "Tabl_ValeurDefaut", "", True)' 04
		
		v_Utilisateur = xComplTabl(v_RepondreA, v_NomTablCTUsr, "1", True)	
		v_MotDePasse =  xComplTabl(v_RepondreA, v_NomTablCTUsr, "2", True)
	Else
		Call SIGE_AjouterLog("** Aucune impression", 1, 0, False)
		
		v_Impression = False
	End If
	
	If v_Impression Then
		'Set nd_Courriel = SDSI_GenererCourrielOneSpanSign(pnd_Prop, p_TypeImpression, p_TypeCourriel, v_RepondreA, v_CheminFichierPDF, nd_CourrielMailIn)
		If SDSI_GenererCourrielOneSpanSign(pnd_Prop, p_TypeImpression, p_TypeCourriel, v_RepondreA, v_CheminFichierPDF, nd_CourrielMailIn) Then
			Call SIGE_AjouterLog("** Courriel OSS généré", 0, 0, False)
			
			'Call SDSI_CopierCourrielOneSpanMailIn(pnd_Prop, nd_CourrielMailIn)
			
			Set nrti = nd_CourrielMailIn.Getfirstitem("BodyTxt")
			v_Message = nrti.Text							
			v_Objet = xVar(nd_CourrielMailIn, "Subject", "")

			' ********************** PBE 2022-04-01 erreur 404 lorsqu'on utilise pas le profil ZULU
			If xGDK_TypeNDBCourante = "T" Then ' Test	
				v_Profil = "POSSg_ZULU"  
				'v_CourrielExpediteur = CStr(xSIEm_xVarEmpl_Id(gns_SDSI.UserName, "Empl_Courriel", "", True))
			Else
				v_Profil = "POSSg"
				'v_CourrielExpediteur = v_Utilisateur
			End If										
			Call SIGE_AjouterLog("Profil " &amp; v_Profil &amp; " utilisé", 0, 0, False)
			v_CourrielExpediteur = v_Utilisateur
			
			'#58282		MZE	
			v_NoEnveloppe = xVar(pnd_Prop, "Prop_NoEnveloppe", "")
			
			If v_NoEnveloppe &lt;&gt; "" Then
				
				'document deja envoyé a OneSpanSign pour signature, changer le statut de cette enveloppe pour EXPIRED.				
				'Call SDSPOSSg_ChangerStatutEnveloppe (v_NoEnveloppe, "EXPIRED", v_Profil)
				
				'	Call SDSPOSSg_ChangerStatutEnveloppe_SJOSS (v_NoEnveloppe, "DRAFT", v_Profil)
				'			If SDSPOSSg_ChangerStatutEnveloppe_SJOSS (pnd_Prop, v_NoEnveloppe, "SENT", v_Profil) Then
				Call SDSPOSSg_ChangerStatutEnveloppe_SJOSS (pnd_Prop, v_NoEnveloppe, "EXPIRED", v_Profil)
				'			End If
				
			End If
			
			Call SIGE_AjouterLog("** Création de l'enveloppe", 0, 0, False)
			If SDSPOSSg_CreerEnveloppe(pnd_Prop, v_Profil, v_CheminFichierPDF, p_TypeImpression, v_Objet, v_Message, v_Utilisateur, v_MotDePasse, v_NbOccurences, v_Langue, v_CourrielExpediteur, v_Nom) Then
				v_NoEnveloppe = xVar(pnd_Prop, "Prop_NoEnveloppe", "")
				Call SIGE_AjouterLog("Enveloppe " &amp; v_NoEnveloppe &amp; " créée", 0, 0, False)
				
				Call SDSI_CopierCourrielOneSpanMailIn(pnd_Prop, nd_CourrielMailIn)
				
				' Mettre à jour l'historique de la proposition
				' --------------------------------------------
				If p_TypeImpression = "B" Then			
					v_MSG_Histo = "Action :  Envoie du bon de commande avec OneSpan Sign  /  Purchase order sent with OneSpan Sign (" &amp; v_NoEnveloppe &amp; ")"
					
					v_NomDestinataire = xVar(gnd_Prof_SDSPOSSg, "POSSg_NomDestinataireBC01", "")
					
					If Left(v_NomDestinataire, 1) = "$" Then	
						Call SDSPOSSg_RemplacerSignetNomDestinataire(pnd_Prop, v_NomDestinataire, v_PrenomDestinataire)
					End If
					
					v_CourrielDestinataire = xVar(gnd_Prof_SDSPOSSg, "POSSg_CourrielDestinataireBC01", "")
					
					If Left(v_CourrielDestinataire, 1) = "$" Then
						v_CourrielDestinataire = SDSPOSSg_RemplacerSignetCourDestinataire(pnd_Prop, v_CourrielDestinataire)
					End If
					
					v_SendTo = v_CourrielDestinataire  &amp; "  " &amp; Chr(34) &amp; v_PrenomDestinataire &amp; " "  &amp; v_NomDestinataire &amp; Chr(34)
					
				ElseIf p_TypeImpression = "C" Then

					v_MSG_Histo = "Action :  Envoie du contrat avec OneSpan Sign  /  Contract sent with OneSpan Sign (" &amp; v_NoEnveloppe &amp; ")"
					
					v_NomDestinataire = xVar(gnd_Prof_SDSPOSSg, "POSSg_NomDestinataireCT01", "")
					
					If Left(v_NomDestinataire, 1) = "$" Then
						Call SDSPOSSg_RemplacerSignetNomDestinataire(pnd_Prop, v_NomDestinataire, v_PrenomDestinataire)
					End If
					
					v_CourrielDestinataire = xVar(gnd_Prof_SDSPOSSg, "POSSg_CourrielDestinataireCT01", "")
					
					If Left(v_CourrielDestinataire, 1) = "$" Then
						v_CourrielDestinataire = SDSPOSSg_RemplacerSignetCourDestinataire(pnd_Prop, v_CourrielDestinataire)
					End If					
					
					v_SendTo = v_CourrielDestinataire  &amp; "  " &amp; Chr(34) &amp; v_PrenomDestinataire &amp; " "  &amp; v_NomDestinataire &amp; Chr(34)
					
				End If
				
				' Copy to 								
				a_PropContactNomsCCOSsg = Evaluate(|@Trim(Prop_ContactNomsCCDsg : Prop_ContactNomsManCCDsg)|, pnd_Prop)
				a_PropContactCourrielsCCOSsg = Evaluate(|@Trim(Prop_ContactCourrielsCCDsg : Prop_ContactCourrielsManCCDsg)|, pnd_Prop)
				
				If IsArray(a_PropContactNomsCCOSsg) And IsArray(a_PropContactCourrielsCCOSsg) Then
					
					ReDim v_CopyTo(UBound(a_PropContactNomsCCOSsg))
					
					For i = 0 To UBound(a_PropContactNomsCCOSsg)
						v_CopyTo(i) = a_PropContactCourrielsCCOSsg(i) &amp; "  " &amp; Chr(34) &amp; a_PropContactNomsCCOSsg(i) &amp; Chr(34)
					Next
				ElseIf Not IsArray(a_PropContactNomsCCOSsg) And Not IsArray(a_PropContactCourrielsCCOSsg) Then
					v_CopyTo = a_PropContactCourrielsCCOSsg &amp; "  " &amp; Chr(34) &amp; a_PropContactNomsCCOSsg &amp; Chr(34)
				End If
				
				
				' Mettre à jour l'historique de la proposition
				' --------------------------------------------							
				If IsArray(v_SendTo) Then
					v_SendTo = Join(v_SendTo, ", ")
				End If
				If v_SendTo &lt;&gt; "" Then
					v_MSG_Histo = v_MSG_Histo &amp; Chr(10) &amp; "(A / To: " &amp; v_SendTo &amp; ")"
				End If
				
				If IsArray(v_CopyTo) Then
					v_CopyTo = Join(v_CopyTo, ", ")
				End If
				If v_CopyTo &lt;&gt; "" Then
					v_MSG_Histo = v_MSG_Histo &amp; Chr(10) &amp; "(CC: " &amp; v_CopyTo &amp; ")"
				End If
				
				'Statut Accepté-50 à En attente de signature-55
				If xVar(pnd_Prop, "Prop_Statut", "0") = "50" Then
					
					' Assigner le nouveau statut
					' --------------------------
					pnd_Prop.Prop_Statut = v_NouvStatut
					pnd_Prop.Prop_StatutDate = Now
					pnd_Prop.Prop_StatutIcone = xIcnTabl(v_NouvStatut, "Prop_Statut_FR", True)
					pnd_Prop.Prop_StatutDescFR = xDescTabl(v_NouvStatut, "Prop_Statut_FR", True)
					pnd_Prop.Prop_StatutDescEN = xDescTabl(v_NouvStatut, "Prop_Statut_EN", True)
					
					pnd_Prop.HistoDM = Now
					pnd_Prop.HistoUM = gns_SDSI.UserName
					
					Call SIHi_Ajouter(pnd_Prop, v_NouvStatut &amp; "-" &amp; xDescTabl(v_NouvStatut, "Prop_Statut_" &amp; g_LangueContrat_SDSI, True), v_MSG_Histo, "", True)				
				Else
					Call SIHi_Ajouter(pnd_Prop, "", v_MSG_Histo, "", True)								
				End If
			Else
				Messagebox xGDK_xMessage("SDSPP", 80, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
				Call SIGE_AjouterLog("*E* Échec de l'envoi de l'enveloppe à OSS", 1, 0, False)
			End If
		Else
			Call SIGE_AjouterLog("*E* Échec de la génération du courriel OSS", 1, 0, False)
		End If
	End If

	If v_EnregistrerLog Then
		Call SIGE_EnregistrerLog
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererCourrielOneSpanSign"><lotusscript>Function SDSI_GenererCourrielOneSpanSign(pnd_Prop As NotesDocument, p_TypeImpression As String, p_TypeCourriel As String, _
	p_RepondreA As String, p_CheminFichierPDF As String, pnd_CourrielMailIn As NotesDocument) As Boolean
	On Error GoTo GererErreur
	
	Dim nd_Courriel As NotesDocument
	Dim nd_Empl As NotesDocument
	Dim nd_CourrielMailIn As NotesDocument	
	Dim nrti As NotesRichTextItem
	Dim nrti_SendTo As NotesRichTextItem
	Dim nrti_CC As NotesRichTextItem	
	Dim nrti_Signature As NotesRichTextItem
	
	Dim a_ContactCC As Variant
	Dim l_ItemsTypeDoc List As String
	Dim v_Langue As String	
	Dim v_NoEmploye As String
	Dim v_ClientNom As String
	Dim v_NomItemSignature As String
	Dim v_NomTablBCUsr As String
	Dim v_RepondreAChoix As String
	Dim v_ReplyTo As String		

	
	'Initialisations	
	SDSI_GenererCourrielOneSpanSign = False
	
	pnd_Prop.temp_clientnom = xEvaluate(|@If(!@IsNull(Prop_ClientNomInterne); Prop_ClientNomInterne; Prop_ClientNom)|, pnd_Prop)
	
	a_ContactCC = Evaluate(|@Trim(@Sort(@Unique(Prop_ContactCourrielsCCDsg : Prop_ContactCourrielsManCCDsg : Prop_CourrielRepresentantCCOSSg)))|, pnd_Prop)
	
	If IsArray(a_ContactCC) Then
		pnd_Prop.Prop_CCOneSpanSign = FullTrim(a_ContactCC)		
	Else
		pnd_Prop.Prop_CCOneSpanSign = a_ContactCC				
	End If
	
	v_Langue = xVar(pnd_Prop, "Prop_Langue", "")	
	v_NomTablBCUsr = "SLOSS_BCUsr_" &amp; v_Langue
	
	l_ItemsTypeDoc("B;FR") = "COURRIEL Bon de commande"
	l_ItemsTypeDoc("B;EN") = " EMAIL Purchase Order"
	l_ItemsTypeDoc("C;FR") = "COURRIEL Contrat"
	l_ItemsTypeDoc("C;EN") = "EMAIL Contract"
	
	Set nd_Courriel = SICT_ConstruireMessage(pnd_Prop, p_TypeCourriel, v_Langue, xVar(pnd_Prop, "Prop_ContactCourriel", ""), "", "", 0, "fichier_attach")
	
	nd_Courriel.Form = "Memo"	
	nd_Courriel.Cour_Type = "OSS"
	nd_Courriel.SI_DialogBox = "1"  ' cacher les bts save et X	
	
	Set nrti = nd_Courriel.GetFirstItem("Body")
	
	If xVar(pnd_Prop, "Prop_NomRepresentant", "") = "" Then
		Call SItRT_Remplacer(nrti, "[prop_nomrepresentant]", "")
	End If
	
	' fichier_attach
	Call SItRT_RemplacerFichierAttach(nrti, "[fichier_attach]", p_CheminFichierPDF)
	
	' Ajouter la signature à la fin du Body (Sans Signet)
	Call SISg_ExtraireSignature(v_NoEmploye, nd_Empl, v_NomItemSignature)
	
	'-----Correctif 15 Mars 2023 MZE dans le cas ou Empl n'as pas de Signature Externe,  nd_Empl Is Nothing
	If Not (nd_Empl Is Nothing) Then					
			Set nrti_Signature = nd_Empl.GetFirstItem(v_NomItemSignature)
			Call nrti.AppendRTItem(nrti_Signature)
			Call nrti.AddNewLine(2, False)
		
	End If
			
	
	v_ClientNom = xVar(pnd_Prop, "temp_clientnom", "")
	
	nd_Courriel.Titre = xVar(pnd_Prop, "Prop_NbPropositionPrefixe", "") &amp; CStr(xVar(pnd_Prop, "Prop_NbProposition", ""))  &amp; " - " _
	&amp; v_ClientNom &amp; l_ItemsTypeDoc(p_TypeImpression &amp; ";" &amp; v_Langue)
	
	nd_Courriel.Cour_NoProposition = CStr(xVar(pnd_Prop, "Prop_NbProposition", ""))
	nd_Courriel.Cour_ClientNoFmt = xVar(pnd_Prop, "Prop_ClientNoFmt", "")
	nd_Courriel.Cour_ClientNom = v_ClientNom
	nd_Courriel.Cour_Langue = v_Langue
	
	If p_TypeImpression = "C" Then
		' SDS Demo
		nd_Courriel.Cour_NoRepondreA = "04"
		v_ReplyTo = xComplTabl("04", "SLOSS_CTUsr", "1", True) 	
		nd_Courriel.Cour_ReplyToDesc = xDescTabl("04", "SLDS_CTUsr", True)		
	Else
		v_RepondreAChoix = p_RepondreA	
		
		If v_RepondreAChoix = "00" Then
			v_ReplyTo = xNAB_xVarPerson(gns_SDSI.UserName, "InternetAddress", "", True)				
			If v_ReplyTo = "" Then
				v_ReplyTo = xNAB_xVarPersonCN(gns_SDSI.CommonUserName, "InternetAddress", "", True)	
			End If
		Else			
			v_ReplyTo = xComplTabl(v_RepondreAChoix, v_NomTablBCUsr, "1", True)								
		End If
		
		nd_Courriel.Cour_ReplyToDesc = xDescTabl(v_RepondreAChoix, v_NomTablBCUsr, True)	
	End If
	
	nd_Courriel.ReplyTo = v_ReplyTo		
	nd_Courriel.CourCC_OneSpanSign = xVar(pnd_Prop, "Prop_CCOneSpanSign", "")
	
	' Il faut sauvegarder le doc pour que le champ RichText s'affiche correctement
	Call nd_Courriel.save(True,False) 
	
	If gnuiws_SDSI.DialogBox("DB_EnvoiOSSg", True, True, True, False, False, False, _
	xGDK_xMessage("SI", 189, "", ""), nd_Courriel, True, True, True) Then
		
		Call nd_Courriel.save(True,False) 		
		
		Set nd_CourrielMailIn = New NotesDocument(gndb_SDSI)
		Call nd_Courriel.Copyallitems(nd_CourrielMailIn)
		Call nd_CourrielMailIn.Save(True, False)
		
		Call pnd_Prop.RemoveItem("temp_clientnom")
		Call pnd_Prop.RemoveItem("Prop_CCOneSpanSign")
		
		
		'Ajouter signataire et cc dans body du courriel			
		''''Set nrti = nd_CourrielMailIn.GetFirstItem("Body")
		Set nrti_SendTo = nd_CourrielMailIn.GetFirstItem("BodySendTo")		
		Call nrti_SendTo.AddNewLine(1, False)	
		
		Set nrti_CC = nd_CourrielMailIn.GetFirstItem("BodyCC")	
		Call nrti_CC.AddNewLine(3, False)
		
		Set nrti = nd_CourrielMailIn.GetFirstItem("Body")
		
		Call nrti_SendTo.Appendrtitem(nrti_CC)	
		Call nrti_SendTo.Appendrtitem(nrti)	
		
		Call nd_CourrielMailIn.RemoveItem("Body")	
		
		Set nrti_SendTo = nd_CourrielMailIn.GetFirstItem("BodySendTo") 
		Call nd_CourrielMailIn.CopyItem(nrti_SendTo, "BodyTxt")	
		Call nd_CourrielMailIn.CopyItem(nrti_SendTo, "Body")
		
		Set pnd_CourrielMailIn = nd_CourrielMailIn
		
		' Supprimer le fichier attaché
		Set nrti = nd_CourrielMailIn.GetFirstItem("BodyTxt")	
		If IsArray(nrti.EmbeddedObjects) Then
			ForAll neo In nrti.EmbeddedObjects
				If neo.Type = EMBED_ATTACHMENT Then
					Call neo.remove
				End If
			End ForAll		
		End If	
		
		Call nd_CourrielMailIn.save(True,False) 
		
		SDSI_GenererCourrielOneSpanSign = True
		
	End If	
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
	
End Function

</lotusscript></code><code event="SDSI_ImprimerBonCommande"><lotusscript>Function SDSI_ImprimerBonCommande(pnd_Prop As NotesDocument, p_Unique As String, p_Imprimer As Boolean, _
	p_GenererPDF As Boolean, p_CheminFichierPDF As String, p_Choix As String) As Boolean
	' -----------------------------------------------
	' Le script permet d'imprimer un bon de commande.
	' -----------------------------------------------
	On Error Goto GererErreur
	
	Dim nv_Site As NotesView
	Dim nd_Suivant As NotesDocument
	Dim nd_Site As NotesDocument
	
	Dim v_Impression As String
	Dim v_NotesBCom As Boolean
	Dim v_NotesSertiBCom As Boolean
	Dim v_Langue As String
	Dim v_NomFichierDoc As String
	Dim v_NomFichierPDF As String
	Dim v_RepondreA As String
	
	
	Dim i As Integer
	
	If xVar(pnd_Prop, "Prop_NbProposition", 0) = 0 Then
		' Le No de proposition n'est pas assigné.
		Messagebox xGDK_xMessage("SDSPP", 129, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	v_Impression = xGDK_xMessage("SDSP", 102, "", xGDK_xMessage("SDSP", 105, "", ""))
	Print v_Impression
	
	' Initialisations
	SDSI_ImprimerBonCommande = False
	p_Unique = ""
	Call SDSI_Initialisations
	Call SILT_Initialisations
	
	g_NoProposition_SDSI = xVar(pnd_Prop, "Prop_NoProposition", "")
	g_NbProposition_SDSI = Cstr(xVar(pnd_Prop, "Prop_NbPropositionTXT", 0))
	g_LangueContrat_SDSI = xVar(pnd_Prop, "Prop_Langue", "FR")
	
	' Créer le dossier de travail
	If Not SDSI_CreerDossier Then
		Exit Function
	End If
	
	If p_GenererPDF Then
		v_RepondreA = xVarPers("Pers_RepondreAChoix","00")	
	End If
	
	' Démarer Word
	' ------------
	If SIMW_DemarrerWord(False) Then
		
		' Générer les notes du bon de commande
		v_NotesBCom = SDSI_GenererNotes(pnd_Prop, "B")	
		
		v_NotesSertiBCom = SDSI_GenererNotesSertiBC(pnd_Prop, p_Choix, v_RepondreA)
		
		' Créer le document Word
		' ----------------------
		v_Langue = g_LangueContrat_SDSI
		
		If SILT_ExtraireLettreType("SDSI_BonCommande", v_Langue, False) Then
			
			' Générer un bon de commande par site
			' -----------------------------------
			Set nv_Site = gndb_SDSI.GetView("V_Site21")
			Call nv_Site.Refresh
			Set nd_Suivant = nv_Site.Getdocumentbykey(g_NoProposition_SDSI, True)
			
			i = 1
			
			Do Until nd_Suivant Is Nothing
				
				Set nd_Site = nd_Suivant
				Set nd_Suivant = nv_Site.Getnextdocument(nd_Suivant)
				
				If xVar(nd_Suivant, "Site_NoProposition", "") &lt;&gt; xVar(pnd_Prop, "Prop_NoProposition", "") Then
					Set nd_Suivant = Nothing
				End If
				
				If i &gt; 1 Then
					' Créer le dossier de travail
					If Not SDSI_CreerDossier Then
						Exit Function
					End If
					
					' Générer les notes du bon de commande
					v_NotesBCom = SDSI_GenererNotes(pnd_Prop, "B")
					Call SILT_ExtraireLettreType("SDSI_BonCommande", v_Langue, False)
				End If
				
				' Ouvrir le document Word
				' -----------------------
				If SIMW_OuvrirDocument(g_CheminAccesDocumentWord_SILT) Then
					' If SDSI_BCGenererBonCommande(pnd_Prop, nd_Site, v_NotesBCom , v_NotesSertiBCom, v_RepondreA, p_GenererPDF) Then
					If SDSI_BCGenererBonCommande(pnd_Prop, nd_Site, v_NotesBCom , v_NotesSertiBCom, v_RepondreA) Then
						
						REM v_NomFichierDoc = "BonCom_" &amp; g_Unique_SDSI &amp; ".docx"
						v_NomFichierDoc = "BonCom_" &amp; g_Unique_SDSI &amp; "-" &amp; CStr(xVar(pnd_Prop, "Prop_NbProposition", "")) &amp; ".docx"
						v_NomFichierPDF = SLFWIN_NomFichierValide("B" &amp; CStr(xVar(pnd_Prop, "Prop_NbProposition", "")) &amp; "-" &amp; xVar(pnd_Prop, "Prop_ClientNom", "") &amp; ".pdf")
						
						If SIMW_EnregistrerDocument(False, g_DossierTemp_SDSI &amp; "\" &amp; v_NomFichierDoc, "") Then
							
							' Attacher le bon de commande à la proposition
							' --------------------------------------------
							If SDSI_CreerDocument(pnd_Prop, v_NomFichierDoc, "B") Then
								
								' Imprimer le bon de commande
								' ---------------------------
								If p_Imprimer Then
									Print v_Impression &amp; " " &amp; xGDK_xMessage("SI", 186, "", "")
									If SIMW_ImprimerDocument(True) Then
										' Attendre la fin de l'impression
										Call SIMW_AttendreFinImpression
									End If
								End If
								
								If p_GenererPDF Then
									v_NomFichierPDF = SDSI_NomFichier(g_DossierTemp_SDSI, v_NomFichierPDF)
									If SIMW_EnregistrerDocumentPDF(False, v_NomFichierPDF) Then
										p_CheminFichierPDF = v_NomFichierPDF
									End If
									
									
									Call SIMW_FermerWord
									SDSI_ImprimerBonCommande = True
									Exit Function
									
								End If
								
								' Fermer le document
								' ------------------
								Call SIMW_FermerDocument
								
								If gc_SupprimerFichiers_SDSI Then
									Kill g_DossierTemp_SDSI &amp; "\" &amp; v_NomFichierDoc
								End If
								
								p_Unique = g_Unique_SDSI
								
								' Mettre à jour l'historique de la proposition
								' --------------------------------------------
								Call SIHi_Ajouter(pnd_Prop, "", "Action : " &amp; _
								"Impression du bon de commande  /  Purchase order printed (" &amp; p_Unique &amp; ")", "", True)
								
								SDSI_ImprimerBonCommande = True
								
							End If
							
						End If
					End If
					
				End If
				
				On Error 75 Resume Next		' Path/file access error
				If v_NotesBCom Then
					Kill g_DossierTemp_SDSI &amp; "\NotesBCom.docx"
				End If
				If v_NotesSertiBCom Then
					Kill  g_DossierTemp_SDSI &amp; "\BComNotesSerti.docx"
				End If
				Rmdir g_DossierTemp_SDSI
				
				i = i + 1
			Loop
			
			
		End If
	End If
	
	
	' Fermer Word
	' -----------
	Call SILT_TerminerTraitement
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Call SIMW_FermerWord
	Exit Function
End Function

</lotusscript></code><code event="SDSI_MontantTotal"><lotusscript>Function SDSI_MontantTotal(pnd_Prop As NotesDocument, p_PrixTotalEQ As Double, p_PrixTotalSV As Double) As Double
	' ----------------------------------------------------------------------
	' Le script permet de déterminer le prix total d'une proposition.
	' Si les prix totaux EQ et SV ne sont pas requis, passer 0 en paramètre.
	' ----------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim v_PrixEQ As Variant
	Dim v_PrixSV As Variant
	
	' Initialisations
	SDSI_MontantTotal = 0
	
	v_PrixEQ = Evaluate({@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "} &amp; _
	(xVar(pnd_Prop, "Prop_NoProposition", "") &amp; ";" &amp; "EQ.") &amp; {"; 5; [PARTIALMATCH]); 0))})
	v_PrixSV = Evaluate({@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod23"; "} &amp; _
	(xVar(pnd_Prop, "Prop_NoProposition", "") &amp; ";" &amp; "SV.") &amp; {"; 5; [PARTIALMATCH]); 0))})
	
	p_PrixTotalEQ = v_PrixEQ(0)
	p_PrixTotalSV = v_PrixSV(0)
	
	SDSI_MontantTotal = v_PrixEQ(0) + v_PrixSV(0)
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_GenererSites"><lotusscript>Function SDSI_GenererSites(pnd_Prop As NotesDocument, p_NbSite As Long) As Boolean
	' --------------------------------------------------------------
	' Le script permet de générer les documents Word liés aux sites.
	' --------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim a_NoSites As Variant
	
	Dim i As Integer
	Dim nd As notesdocument
	Dim v_Prop_EntretienMensuelLG As Double
	Dim v_Site_EntretienMensuelLG As Double
	Dim v_Escompte As Double
	Dim v_MontantRestantLG As Double
	Dim v_TransfertMontantLG As Double
	Dim v_MontantsSectionsLG(3) As Double
	
	' Initialisations
	SDSI_GenererSites = False
	
	p_NbSite = 0
	g_EntretienTotalLG_SDSI = 0
	g_EscompteTotalLG_SDSI = 0
	
	a_NoSites = xVarArray(pnd_Prop, "Prop_NoSites")
	
	v_Prop_EntretienMensuelLG = xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod20"; "| &amp; _
	Cstr(xVar(pnd_Prop, "Prop_NoProposition", "")) &amp; |"+ ";LG."; 8 ;[PartialMatch]) / 12; 0))|, Nothing)
	
	'v_Escompte = (xVar(pnd_Prop, "Prop_EscompteMontant", 0) + xVar(pnd_Prop, "Prop_EscompteCorporatif", 0))
	v_Escompte = xVar(pnd_Prop, "Prop_EscompteMensualite", 0)
	v_MontantRestantLG = v_Escompte
	
	' Boucler les sites
	If Isarray(a_NoSites) Then
		
		For i = Lbound(a_NoSites) To Ubound(a_NoSites)
			
			Set nd = XSDSP3_xndSite(a_NoSites(i), True)
			
			v_TransfertMontantLG = 0
			
			v_Site_EntretienMensuelLG= xEvaluate( |@Sum(@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod30"; "| &amp; _
			Cstr(xVar(nd, "Site_NoSite", "")) &amp; |"+ ";LG."; 8 ;[PartialMatch]) / 12; 0))|, Nothing)
			
			If v_Escompte &gt; 0 Then
				
				If i= Ubound(a_NoSites) Then 
					v_TransfertMontantLG = v_MontantRestantLG
				Else
					v_TransfertMontantLG = Round(v_Escompte * (v_Site_EntretienMensuelLG / v_Prop_EntretienMensuelLG), 2)
					v_MontantRestantLG = v_MontantRestantLG - v_TransfertMontantLG
				End If
				
			End If
			
			p_NbSite = p_NbSite + 1
			
			
			
			If Not SDSI_GenererSite(pnd_Prop, nd, p_NbSite, v_TransfertMontantLG, v_MontantsSectionsLG) Then
				Exit Function
			End If
			
			gl_MontantsSectionsLGSites_SDSI(a_NoSites(i)) = v_MontantsSectionsLG
			
			
		Next
		
	End If
	
	SDSI_GenererSites = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, Getthreadinfo(1), _
	xVar(pnd_Prop, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_BCAjouterService"><lotusscript>Function SDSI_BCAjouterService(p_Ligne As Integer, p_Description As String, p_Total As double) As Boolean
	' ----------------------------------------------------------------------------------------------
	' Le script permet d'ajouter un service dans le document Word liés aux services d'un site
	' lors de l'impression d'un bon de commande.
	' ----------------------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim v_WordTable As Variant
	Dim v_WordRow As Variant
	
	SDSI_BCAjouterService = False
	
	Set v_WordTable = g_WordDoc_SIMW.Tables(1)	
	Set v_WordRow = v_WordTable.Rows.Add(v_WordTable.Rows(p_Ligne))
	
	Call v_WordTable.Cell(p_Ligne, 1).Range.InsertAfter(p_Description)
	Call v_WordTable.Cell(p_Ligne, 2).Range.InsertAfter("1")
	Call v_WordTable.Cell(p_Ligne, 3).Range.InsertAfter(SDSI_FormatDevise(p_Total, g_LangueContrat_SDSI))
	
	SDSI_BCAjouterService = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SDSI_ExtraireDocument"><lotusscript>Function SDSI_ExtraireDocument(pneo As NotesEmbeddedObject) As Integer
	'------------------------------------------------------------------------------------------------------------------------------	
	' Le script permet de sauvegarder le document Word dans le dossier temporaire.
	'------------------------------------------------------------------------------------------------------------------------------	
	On Error GoTo GererErreur
	On Error 75 Resume Next		' Kill : Si le fichier n'existe pas --&gt; OK
	
	Dim v_CheminDocument As String
	
	SDSI_ExtraireDocument = False
	
	
	' Créer le dossier temporaire (au besoin)
	' ------------------------------------------------------------
	MkDir g_DossierTemp_SDSI
	
	' Générer le nouveau document Word
	' ----------------------------------------------------------
	v_CheminDocument = g_DossierTemp_SDSI &amp; "\" &amp; pneo.Source
	Kill v_CheminDocument
	Call pneo.Extractfile(v_CheminDocument)
	
	SDSI_ExtraireDocument = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSI, gc_Element_SDSI, GetThreadInfo(1), _
	v_CheminDocument, False)
	Exit Function
	
End Function</lotusscript></code>
