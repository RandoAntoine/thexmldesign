</lotusscript></code><code event="FPNav_QueryOpen"><lotusscript>Sub FPNav_QueryOpen(pnuid_Source As Notesuidocument, p_Mode As Integer, p_Isnewdoc As Variant, _
	p_Continue As Variant)
	On Error Goto GererErreur
	
	Dim nd_PNav As NotesDocument
	Dim nd_Client As NotesDocument
	Dim nd_ClientSICl As NotesDocument
	
	Dim v_Origine As String
	
	' Initialisations
	p_Continue = False
	Set nd_PNav = pnuid_Source.Document
	
	' Nouvelle proposition
	' --------------------
	If xVar(nd_PNav, "Prop_NoProposition", "") = "" Then
		If p_Mode &lt;&gt; 1 Then
			Exit Sub
		End If
		
		If Not SLSf_VersionNotesValide Then
			MessageBox xGDK_xMessage("SI", 272, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Sub
		End If
		
		nd_PNav.PNav_Titre = xGDK_xMessage("SDSPP", 5, "", "")
		
		Call FPNav_IniTypePropositionDisp(nd_PNav)
		nd_PNav.Prop_Statut = "10"
		p_Continue = True
		
		' Proposition existante
		' ---------------------
	Else

		If Not SLSf_VersionNotesValide Then
			nd_PNav.PNav_EditMode = 0
			nd_PNav.SaveOptions = "0"
		End If
		
		' Initialiser les champs du document de navigation
		If FPNav_DocumentExistant(nd_PNav) Then
			p_Continue = True
		End If
	End If
	
	' Déterminer si le client est Cloud (Hébergé) ou non
	nd_PNav.Prop_TypeInstallationSDS = FPNav_TypeInstallationSDS(nd_PNav)
	
	' Construire le menu
	nd_PNav.PNav_MenuItemCourant = "000"
	nd_PNav.PNav_MenuOptionCourante = "0.00"
	Call SDSPN_ConstruireMenu(nd_PNav)
	
	nd_PNav.Titre = Trim(xVar(nd_PNav, "PNav_Titre", "") &amp; " - " &amp; xVar(nd_PNav, "PNav_MenuDesc000", ""))
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentExistant"><lotusscript>Function FPNav_DocumentExistant(pnd_PNav As NotesDocument) As Boolean
	On Error GoTo GererErreur
	
	Dim nrti_PropDescDetaillee As NotesRichTextItem
	Dim nrti_PNavDescDetaillee As NotesRichTextItem
	Dim ni As NotesItem
	Dim a_NoBC As Variant
	
	Dim s As String
	Dim v_MenuOptionMax As String
	
	FPNav_DocumentExistant = False
	
	' Extraire la proposition
	If Not SDSPM_InitProp(xVar(pnd_PNav, "Prop_NoProposition", "")) Then
		Exit Function
	End If
	
	g_NoRep_FPNav = xVar(gnd_Prop_SDSPM, "Prop_NoRepresentant", "")
	
	' Mettre à jour le document de navigation
	s = xVar(gnd_Prop_SDSPM, "Prop_TypeProposition", "")
	pnd_PNav.Prop_TypeProposition = s
	Call pnd_PNav.ReplaceItemValue("Prop_TypePropositionDesc" &amp; xLangue, xSDSBB_xVarTpPp(s, _
	"TpPp_DescTypeProposition" &amp; xLangue, "", True))
	
	'Req #42249
	'pnd_PNav.Prop_Directeur = xVar(gnd_Prop_SDSPM, "Prop_Directeur", "")
	pnd_PNav.Prop_IdDirecteur = xVar(gnd_Prop_SDSPM, "Prop_IdDirecteur", "")
	pnd_PNav.Prop_NomDirecteur = xVar(gnd_Prop_SDSPM, "Prop_NomDirecteur", "")
	pnd_PNav.Prop_NoDirecteur = xVar(gnd_Prop_SDSPM, "Prop_NoDirecteur", "")
	
	pnd_PNav.Prop_NbProposition = xVar(gnd_Prop_SDSPM, "Prop_NbProposition", 0)
	pnd_PNav.Prop_NbPropositionTXT = xVar(gnd_Prop_SDSPM, "Prop_NbPropositionTXT", "")
	pnd_PNav.Prop_NbFoisReOuvert = xVar(gnd_Prop_SDSPM, "Prop_NbFoisReOuvert", "")
	pnd_PNav.Prop_NbPropositionPrefixe = xVar(gnd_Prop_SDSPM, "Prop_NbPropositionPrefixe", "")
	pnd_PNav.Prop_NbPropositionFmt = xVar(gnd_Prop_SDSPM, "Prop_NbPropositionFmt", "")
	pnd_PNav.Prop_TypeContratServiceSDS = xVar(gnd_Prop_SDSPM, "Prop_TypeContratServiceSDS", "")
	
	pnd_PNav.Prop_ClientCleSitePrinc = xVar(gnd_Prop_SDSPM, "Prop_ClientCleSitePrinc", "")
	pnd_PNav.Prop_ClientCleInitial = xVar(gnd_Prop_SDSPM, "Prop_ClientCleInitial", "")
	
	pnd_PNav.Prop_Statut = xVar(gnd_Prop_SDSPM, "Prop_Statut", "10")
	Call pnd_PNav.ReplaceItemValue("Prop_StatutDesc" &amp; xLangue, _
	xVar(gnd_Prop_SDSPM, "Prop_StatutDesc" &amp; xLangue, ""))
	'pnd_PNav.Prop_StatutDescEN = xVar(gnd_Prop_SDSPM, "Prop_StatutDescEN", "")
	pnd_PNav.Prop_DescProposition = xVar(gnd_Prop_SDSPM, "Prop_DescProposition", "")
	
	pnd_PNav.Prop_NoRepresentant = xVar(gnd_Prop_SDSPM, "Prop_NoRepresentant", "")
	pnd_PNav.Prop_NomRepresentant = xVar(gnd_Prop_SDSPM, "Prop_NomRepresentant", "")
	pnd_PNav.Prop_IdRepresentant = xVar(gnd_Prop_SDSPM, "Prop_IdRepresentant", "")
	pnd_PNav.Prop_NomDirecteur = xVar(gnd_Prop_SDSPM, "Prop_NoDirecteur", "")
	pnd_PNav.Prop_NomDirecteur = xVar(gnd_Prop_SDSPM, "Prop_NomDirecteur", "")
	pnd_PNav.Prop_IdDirecteur = xVar(gnd_Prop_SDSPM, "Prop_IdDirecteur", "")
	pnd_PNav.Prop_NoDirNational = xVar(gnd_Prop_SDSPM, "Prop_NoDirNational", "")
	pnd_PNav.Prop_NomDirNational = xVar(gnd_Prop_SDSPM, "Prop_NomDirNational", "")
	pnd_PNav.Prop_IdDirNational = xVar(gnd_Prop_SDSPM, "Prop_IdDirNational", "")
	pnd_PNav.Prop_NoDirMondial = xVar(gnd_Prop_SDSPM, "Prop_NoDirMondial", "")
	pnd_PNav.Prop_NomDirMondial = xVar(gnd_Prop_SDSPM, "Prop_NomDirMondial", "")
	pnd_PNav.Prop_IdDirMondial = xVar(gnd_Prop_SDSPM, "Prop_IdDirMondial", "")
	pnd_PNav.Prop_CommissionsRepresentant = xVar(gnd_Prop_SDSPM, "Prop_CommissionsRepresentant", "")
	pnd_PNav.Prop_CommissionsDirecteur = xVar(gnd_Prop_SDSPM, "Prop_CommissionsDirecteur", "") 
	pnd_PNav.Prop_CommissionsDirNational = xVar(gnd_Prop_SDSPM, "Prop_CommissionsDirNational", "") 
	pnd_PNav.Prop_CommissionsDirMondial = xVar(gnd_Prop_SDSPM, "Prop_CommissionsDirMondial", "") 
	pnd_PNav.Prop_DeviseRepresentant = xVar(gnd_Prop_SDSPM, "Prop_DeviseRepresentant", "") 
	pnd_PNav.Prop_DeviseDirecteur = xVar(gnd_Prop_SDSPM, "Prop_DeviseDirecteur", "") 
	pnd_PNav.Prop_DeviseDirNational = xVar(gnd_Prop_SDSPM, "Prop_DeviseDirNational", "") 
	pnd_PNav.Prop_DeviseDirMondial = xVar(gnd_Prop_SDSPM, "Prop_DeviseDirMondial", "") 
	pnd_PNav.Prop_NoEquipe = xVar(gnd_Prop_SDSPM, "Prop_NoEquipe", "")
	pnd_PNav.Prop_NomEquipe = xVar(gnd_Prop_SDSPM, "Prop_NomEquipe", "")
	pnd_PNav.Prop_NePasPartager = xVar(gnd_Prop_SDSPM, "Prop_NePasPartager", "")
	
	pnd_PNav.Prop_NoOpportuniteSF = xVar(gnd_Prop_SDSPM, "Prop_NoOpportuniteSF", "")
	pnd_PNav.Prop_ClientNoSF = xVar(gnd_Prop_SDSPM, "Prop_ClientNoSF", "")
	pnd_PNav.Prop_NoContactSF = xVar(gnd_Prop_SDSPM, "Prop_NoContactSF", "")
	
	pnd_PNav.Prop_ClientNoFmt = xVar(gnd_Prop_SDSPM, "Prop_ClientNoFmt", "")
	pnd_PNav.Prop_ClientNomInterne = xVar(gnd_Prop_SDSPM, "Prop_ClientNomInterne", "")
	pnd_PNav.Prop_NomInterneListe = xVar(gnd_Prop_SDSPM, "Prop_NomInterneListe", "")
	pnd_PNav.Prop_NomInterneModifie = xVar(gnd_Prop_SDSPM, "Prop_NomInterneModifie", "0")
	pnd_PNav.Prop_ClientNom = xVar(gnd_Prop_SDSPM, "Prop_ClientNom", "")
	pnd_PNav.Prop_NomClientListe = xVar(gnd_Prop_SDSPM, "Prop_NomClientListe", "")
	pnd_PNav.Prop_NomClientModifie = xVar(gnd_Prop_SDSPM, "Prop_NomClientModifie", "0")
	pnd_PNav.Prop_ClientNomLegal = xVar(gnd_Prop_SDSPM, "Prop_ClientNomLegal", "")
	pnd_PNav.Prop_NomLegalListe = xVar(gnd_Prop_SDSPM, "Prop_NomLegalListe", "")
	pnd_PNav.Prop_NomLegalModifie = xVar(gnd_Prop_SDSPM, "Prop_NomLegalModifie", "0")
	pnd_PNav.Prop_Langue = xVar(gnd_Prop_SDSPM, "Prop_Langue", "")
	pnd_PNav.Prop_ClientSDSWIN = xVar(gnd_Prop_SDSPM, "Prop_ClientSDSWIN", "")
	pnd_PNav.Prop_ClientMerlin = xVar(gnd_Prop_SDSPM, "Prop_ClientMerlin", "")
	
	pnd_PNav.Site_Banniere = xVarArray(gnd_Prop_SDSPM,"Site_Banniere")
	pnd_PNav.Site_BanniereDesc = xVarArray(gnd_Prop_SDSPM,"Site_BanniereDesc")
	pnd_PNav.Site_Plateforme = xVarArray(gnd_Prop_SDSPM, "Site_Plateforme")
	pnd_PNav.Prop_ProvenanceProspect = xVar(gnd_Prop_SDSPM, "Prop_ProvenanceProspect", "")
	pnd_PNav.Prop_ProvenanceProspectPrecision = xVar(gnd_Prop_SDSPM, "Prop_ProvenanceProspectPrecision", "")
	
	pnd_PNav.Prop_ClientAdresse1 = xVar(gnd_Prop_SDSPM, "Prop_ClientAdresse1", "")
	pnd_PNav.Prop_ClientAdresse2 = xVar(gnd_Prop_SDSPM, "Prop_ClientAdresse2", "")
	pnd_PNav.Prop_ClientVille = xVar(gnd_Prop_SDSPM, "Prop_ClientVille", "")
	pnd_PNav.Prop_ClientProvince = xVar(gnd_Prop_SDSPM, "Prop_ClientProvince", "")
	pnd_PNav.Prop_ClientPays = xVar(gnd_Prop_SDSPM, "Prop_ClientPays", "")
	pnd_PNav.Prop_ClientCodePostal = xVar(gnd_Prop_SDSPM, "Prop_ClientCodePostal", "")
	pnd_PNav.Prop_ClientTelephone = xVar(gnd_Prop_SDSPM, "Prop_ClientTelephone", "")
	pnd_PNav.Prop_ClientTelephone2 = xVar(gnd_Prop_SDSPM, "Prop_ClientTelephone2", "")
	pnd_PNav.Prop_ClientTelecopieur = xVar(gnd_Prop_SDSPM, "Prop_ClientTelecopieur", "")
	
	pnd_PNav.Prop_NoContact = xVar(gnd_Prop_SDSPM, "Prop_NoContact", "")
	pnd_PNav.Prop_ContactNom = xVar(gnd_Prop_SDSPM, "Prop_ContactNom", "")
	pnd_PNav.Prop_ContactFonction = xVar(gnd_Prop_SDSPM, "Prop_ContactFonction", "")
	pnd_PNav.Prop_ContactFonctionFR = xVar(gnd_Prop_SDSPM, "Prop_ContactFonctionFR", "")
	pnd_PNav.Prop_ContactFonctionEN = xVar(gnd_Prop_SDSPM, "Prop_ContactFonctionEN", "")
	pnd_PNav.Prop_ContactTitre = xVar(gnd_Prop_SDSPM, "Prop_ContactTitre", "")
	pnd_PNav.Prop_ContactTelephone = xVar(gnd_Prop_SDSPM, "Prop_ContactTelephone", "")
	pnd_PNav.Prop_ContactCellulaire = xVar(gnd_Prop_SDSPM, "Prop_ContactCellulaire", "")
	pnd_PNav.Prop_ContactCourriel = xVar(gnd_Prop_SDSPM, "Prop_ContactCourriel", "")
	
	pnd_PNav.Prop_NoContactsCCDsg = xVar(gnd_Prop_SDSPM, "Prop_NoContactsCCDsg", "")
	pnd_PNav.Prop_ContactNomsCCDsg = xVar(gnd_Prop_SDSPM, "Prop_ContactNomsCCDsg", "")
	pnd_PNav.Prop_NoClientContactsCCDsg = xVar(gnd_Prop_SDSPM, "Prop_NoClientContactsCCDsg", "")	
	pnd_PNav.Prop_ContactCourrielsCCDsg  = xVar(gnd_Prop_SDSPM, "Prop_ContactCourrielsCCDsg", "")
	pnd_PNav.Prop_NomClientContactsCCDsg  = xVar(gnd_Prop_SDSPM, "Prop_NomClientContactsCCDsg", "")	
	
	pnd_PNav.Prop_ContactNomsManCCDsg  = xVar(gnd_Prop_SDSPM, "Prop_ContactNomsManCCDsg", "")
	pnd_PNav.Prop_ContactCourrielsManCCDsg  = xVar(gnd_Prop_SDSPM, "Prop_ContactCourrielsManCCDsg", "")
	
	pnd_PNav.Prop_NoRepresentantCCOSSg  = xVar(gnd_Prop_SDSPM, "Prop_NoRepresentantCCOSSg", "")	
	pnd_PNav.Prop_NomRepresentantCCOSSg  = xVar(gnd_Prop_SDSPM, "Prop_NomRepresentantCCOSSg", "")
	pnd_PNav.Prop_CourrielRepresentantCCOSSg  = xVar(gnd_Prop_SDSPM, "Prop_CourrielRepresentantCCOSSg", "")
	
	pnd_PNav.Prop_Devise = xVar(gnd_Prop_SDSPM, "Prop_Devise", "")
	pnd_PNav.Prop_PourcentEscompteLG = xVar(gnd_Prop_SDSPM, "Prop_PourcentEscompteLG", "")
	pnd_PNav.Prop_NbSites = xVar(gnd_Prop_SDSPM, "Prop_NbSites", 0)
	pnd_PNav.Prop_NoSites = xVar(gnd_Prop_SDSPM, "Prop_NoSites", "")
	pnd_PNav.Prop_PropositionImprimee = xVar(gnd_Prop_SDSPM, "Prop_PropositionImprimee", "")
	pnd_PNav.Prop_NoSitePrincipal = xVar(gnd_Prop_SDSPM, "Prop_NoSitePrincipal", "")
	
	Pnd_PNav.Prop_NoBonCommandes = xVar(gnd_Prop_SDSPM, "Prop_NoBonCommandes", "")
	
	pnd_PNav.Prop_NotesContrat = xVar(gnd_Prop_SDSPM, "Prop_NotesContrat", "")
	
	pnd_PNav.Prop_OrigineSiegeSocial = xVar(gnd_Prop_SDSPM, "Prop_OrigineSiegeSocial", "")
	pnd_PNav.Prop_ClientNoFmtSiegeSocialSF = xVar(gnd_Prop_SDSPM, "Prop_ClientNoFmtSiegeSocialSF", "")
	pnd_PNav.Prop_ClientNoFmtSiegeSocial = xVar(gnd_Prop_SDSPM, "Prop_ClientNoFmtSiegeSocial", "")
	pnd_PNav.Prop_ClientNom1SiegeSocial = xVar(gnd_Prop_SDSPM, "Prop_ClientNom1SiegeSocial", "")
	pnd_PNav.Prop_ClientNomIntSiegeSocial = xVar(gnd_Prop_SDSPM, "Prop_ClientNomIntSiegeSocial", "")
	
	
	' Description détaillée (champ RichText)
	If pnd_PNav.Hasitem("Prop_DescDetaillee") Then
		Call pnd_PNav.Removeitem("Prop_DescDetaillee")
	End If
	If gnd_Prop_SDSPM.Hasitem("Prop_DescDetaillee") Then
		Set nrti_PropDescDetaillee = gnd_Prop_SDSPM.Getfirstitem("Prop_DescDetaillee")
		Call nrti_PropDescDetaillee.CopyItemToDocument(pnd_PNav, "Prop_DescDetaillee")
	Else
		Set nrti_PNavDescDetaillee = New NotesRichTextItem(pnd_PNav, "Prop_DescDetaillee")
	End If
	
	pnd_PNav.HistoUC = xVar(gnd_Prop_SDSPM, "HistoUC", "")
	
	Set ni = New NotesItem(pnd_PNav, "Auteur", xVar(gnd_Prop_SDSPM, "Auteur", ""), AUTHORS)
	Set ni = New NotesItem(pnd_PNav, "AuteurAdmin", xVar(gnd_Prop_SDSPM, "AuteurAdmin", ""), AUTHORS)
	
	If xVar(pnd_PNav, "PNav_DocumentOuvert", "") &lt;&gt; "1" Then
		' Extraire les sites
		Call SDSPN_MajSitesNav(pnd_PNav)
		Call SDSPN_ConstruireMenu(pnd_PNav)
		
		v_MenuOptionMax = xVar(gnd_Prop_SDSPM, "PNav_MenuOptionMax", "0.00")
		pnd_PNav.PNav_MenuOptionMax = v_MenuOptionMax 
		
		pnd_PNav.Prop_Cle = xVar(gnd_Prop_SDSPM, "Cle", "")
		pnd_PNav.Prop_Origine = xVar(gnd_Prop_SDSPM, "Prop_Origine", "")
		pnd_PNav.Prop_NoProjet = xVar(gnd_Prop_SDSPM, "Prop_NoProjet", "")
		
		pnd_PNav.PNav_DocumentOuvert = "1"
		If Left(v_MenuOptionMax, 1) &lt; "2" Then
			pnd_PNav.PNav_DernierSiteOuvert = 0
			pnd_PNav.PNav_MaxSiteOuvert = 0
		Else
			pnd_PNav.PNav_DernierSiteOuvert = 1
			
			If xVar(gnd_Prop_SDSPM, "PNav_MaxSiteOuvert", "") = "" Then
				If Left(v_MenuOptionMax, 1) = "2" Then
					pnd_PNav.PNav_MaxSiteOuvert = CInt(StrLeft(StrRight(v_MenuOptionMax, "."), ".")) + 1
				End If
			Else
				pnd_PNav.PNav_MaxSiteOuvert = xVar(gnd_Prop_SDSPM, "PNav_MaxSiteOuvert", 0)
			End If
			
		End If
	End If
	
	Call FPNav_InitialiserAdresseClient(pnd_PNav, True)
	Call FPNav_InitialiserContactClient(pnd_PNav, True)
	
	If xVar(gnd_Prop_SDSPM, "Prop_Origine", "") = "SF" Then
		Call FPNav_InitialiserContactCCClient_SF(pnd_PNav)
	Else
		Call FPNav_InitialiserContactCCClient(pnd_PNav, True)
	End If
	
	
	pnd_PNav.Prop_NotesContrat = xVar(gnd_Prop_SDSPM, "Prop_NotesContrat", "")
	
	a_NoBC = Evaluate(|@DbLookup("" : "NoCache"; ""; "V_Site21"; "| &amp; xVar(pnd_PNav, "Prop_NoProposition", "") &amp; |"; 10;[FailSilent])|)
	Call pnd_PNav.ReplaceItemValue("Prop_NoBonsCommandeFmtSIBDC_1", a_NoBC)
	
	' xVar(gnd_Prop_SDSPM, "Prop_ClientProvince", "") &lt;&gt; "QC"
	If xVar(gnd_Prop_SDSPM, "Prop_TypeProposition", "") = "3" And xVar(gnd_Prop_SDSPM, "Prop_ClientProvince", "") &lt;&gt; "QC" And xVar(gnd_Prop_SDSPM, "Prop_Langue", "") = "FR" Then
		
		'Afficher le message de changement de langue de visualisation
		MessageBox xGDK_xMessage("SDSPP", 177, "", ""), 8, xGDK_xMessage("SI", 8, "", "")		
	End If
	
	
	FPNav_DocumentExistant = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Prop_NoProposition", ""), False)
	Exit Function
	
End Function


</lotusscript></code><code event="FPNav_hsPlanPowerPoint"><lotusscript>Sub FPNav_hsPlanPowerPoint
	On Error Goto GererErreur
	
	Dim a_Fichiers As Variant
	Dim v_Fichier As String
	Dim v As Variant
	Dim v_NomFichier As String
	
	' Sélectionner le Document à attacher
	' -----------------------------------
	v = Evaluate({@RegQueryValue("HKEY_CURRENT_USER"; "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Shell Folders"; "Desktop")})
	v_NomFichier = v(0)
	
	a_Fichiers = gnuiws_SDSPN.OpenFileDialog(False, xGDK_xMessage("SDSPP", 81, "", ""), "", v_NomFichier)
	If Not Isempty(a_Fichiers) Then
		Call gnuiws_SDSPN.CurrentDocument.FieldSetText("PNav_PlanPowerPoint", a_Fichiers(0))
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acRafraichirInfoClient"><lotusscript>Sub FPNav_acRafraichirInfoClient
	On Error Goto GererErreur
	
	Call FPNav_InitialiserAdresseClient(gnd_SDSPM, False)
	Call FPNav_InitialiserContactClient(gnd_SDSPM, False)
	
	Call gnuid_SDSPM.Refresh
	Exit Sub
	
GererErreur:
