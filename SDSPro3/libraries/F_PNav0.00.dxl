	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsSelectionnerRepresentant"><lotusscript>Sub FPNav_hsSelectionnerRepresentant
	On Error GoTo GererErreur
	
	Dim ndc As NotesDocumentCollection
	Dim nd_Rep As NotesDocument
	Dim ni As NotesItem
	Dim nd_Equi As NotesDocument
	Dim v_NoEquipe As String
	Dim v_NoRepresentant As String
	Dim v_NoRepresentantCCOSSg As String	
	Dim v_CommissionsRepresentant As String
	Dim v_Maj As Boolean
	Dim v_Langue As String
	Dim v_StatutDesc As String
	Dim v_Statut As String
	Dim v_NomRepresentantPrec As String
	Dim v_NoDirecteur As String
	Dim nd_Dir As NotesDocument
	Dim v_Prof_DirCommissionsDir As String
	
	' Initialisations
	Call xSIRR_Initialisations
	
	If xVar(gnd_SDSPM, "Prop_NoProposition", "") = "" Then
		On Error 4411 GoTo FinSub
		Call gnuid_SDSPM.Save
	End If
	
	' Représentant précédent
	v_NomRepresentantPrec = xVar(gnd_SDSPM, "Prop_NomRepresentant" , "")
	
	' Si pas dans équipe, permet de choisir tous les reps.
	v_NoEquipe = "0"
	Set nd_Rep = xSIRR_xndRepr_Id(gns_SDSPM.UserName, "")
	If nd_Rep Is Nothing Then
	ElseIf xVarContient(nd_Rep, "Repr_SDSPropositions", "DIR") Then
	Else
		v_NoEquipe = xVar(nd_Rep, "Repr_NoEquipe", "0")
		If v_NoEquipe &lt;&gt; "0" Then
			Set nd_Equi = xSIRR_xndEqui(v_NoEquipe, True)
			If nd_Equi Is Nothing Then
				v_NoEquipe = "0"
			End If
		End If
	End If
	
	If v_NoEquipe = "0" Then
		Set ndc = gnuiws_SDSPN.PickListCollection(PICKLIST_CUSTOM, False, gndb_xSIRR.Server, gndb_xSIRR.Filepath, "V_Repr16", _
		xGDK_xMessage("SDSPP", 82, "", ""), xGDK_xMessage("SDSPP", 83, "", ""), "1")
		If ndc.Count &gt; 0 Then
			Set nd_Rep = ndc.GetFirstDocument
			v_NoEquipe = xVar(nd_Rep, "Repr_NoEquipe", "0")
			v_Maj = True
			
			Set nd_Equi = xSIRR_xndEqui(v_NoEquipe, True)
			If nd_Equi Is Nothing Then
				v_NoEquipe = 0
			End If
		Else
			Print xGDK_xMessage("SI", 1, "", "") &amp; " - " &amp; xGDK_xMessage("SI", 283, "", "")
			Exit Sub
		End If
	Else
		' Si dans équipe, permet de choisir seulements reps dans même équipe.
		Set ndc = gnuiws_SDSPM.PickListCollection(PICKLIST_CUSTOM, False, gndb_xSIRR.Server, gndb_xSIRR.FilePath, "V_Repr12", xGDK_xMessage("SDSPP", 84, "", ""), _
		xGDK_xMessage("SDSPP", 85, "", ""), v_NoEquipe)
		If ndc.Count &gt; 0 Then
			Set nd_Rep = ndc.GetFirstDocument
			v_Maj = True
		Else
			Print xGDK_xMessage("SI", 1, "", "") &amp; " - " &amp; xGDK_xMessage("SI", 283, "", "")
			Exit Sub
		End If
	End If
	
	If v_Maj Then
		v_Maj = False
		v_NoRepresentant = xVar(nd_Rep, "Repr_NoRepresentant", "")
		
		If 	v_NoRepresentant &lt;&gt; "" Then			
			If v_NoRepresentant &lt;&gt; xVar(gnd_SDSPM, "Prop_NoRepresentant", "") Then
				gnd_SDSPM.Prop_NoRepresentant = v_NoRepresentant
				gnd_SDSPM.Prop_NomRepresentant = xVar(nd_Rep, "Repr_NomRepresentant", "")
				gnd_SDSPM.Prop_IdRepresentant = xVar(nd_Rep, "Repr_NotesID", "")
				v_Maj = True
				If xVar(gnd_SDSPM, "Prop_NoOpportuniteSF" , "") = "" Then
					
					v_Statut = xVar(gnd_SDSPM, "Prop_Statut" , "")
					v_Langue = xSIRR_xVarRepr(xVar(gnd_SDSPM, "Prop_NoRepresentant", ""), "Repr_Langue", "FR", True)
					v_StatutDesc = xDescTabl(v_Statut, "Prop_Statut_" &amp; v_Langue, True)

					Call SIHi_Ajouter(gnd_Prop_SDSPM, v_Statut &amp; "-" &amp; v_StatutDesc, "Action : " &amp; _
					"Représentant remplaçé  /  Sales rep. replaced (" &amp; v_NomRepresentantPrec &amp; ")", "", False)
				End If
			End If
			
			If v_NoEquipe &lt;&gt; xVar(gnd_SDSPM, "Prop_NoEquipe", "") Then
				gnd_SDSPM.Prop_NoEquipe = v_NoEquipe
				gnd_SDSPM.Prop_NomEquipe = xVar(nd_Rep, "Repr_NomEquipe", "")
				v_Maj = True
			End If
		End If	
		
		' Assigner les directeurs et les tables des commissions	
		If SDSPP_AssignerCommissions(gnd_SDSPM) = 1 Then
			v_Maj = True
		End If
	%rem
		Set ni = xni(nd_Rep, "Repr_SDSPropositions", "")
		If ni.Contains("XC") Then
			v_Maj =SIIx_MajItem(gnd_SDSPM, "Prop_CommissionsRepresentant", "", False) Or v_Maj
			v_Maj =SIIx_MajItem(gnd_SDSPM, "Prop_CommissionsDirecteur", "", False) Or v_Maj 
		ElseIf ni.Contains("DIR") Then
			v_Maj =SIIx_MajItem(gnd_SDSPM, "Prop_CommissionsRepresentant", xSIRR_xVarComm_Repr(v_NoRepresentant, "1", "", xVar(gnd_SDSPM, "Prop_ClientPays", ""), xVar(gnd_SDSPM, _
			"Prop_ClientProvince", ""), "Comm_CodeCommissionsAH", ""), False) Or v_Maj
			v_Maj =SIIx_MajItem(gnd_SDSPM, "Prop_CommissionsDirecteur", "", False) Or v_Maj 
		Else
			' Le représentant doit avoir une table de commissions
			If v_NoEquipe = "0" Then
				v_CommissionsRepresentant = xSIRR_xVarComm_Repr(v_NoRepresentant, "1", "", xVar(gnd_SDSPM, "Prop_ClientPays", ""), xVar(gnd_SDSPM, _
				"Prop_ClientProvince", ""), "Comm_CodeCommissionsAH", "")
			Else
				v_CommissionsRepresentant = xSIRR_xVarComm_Equi(v_NoEquipe, "1", "", xVar(gnd_SDSPM, "Prop_ClientPays", ""), xVar(gnd_SDSPM, _
				"Prop_ClientProvince", ""), "Comm_CodeCommissionsAH", "")
			End If
			If v_CommissionsRepresentant &lt;&gt; "" Then
				v_Maj =SIIx_MajItem(gnd_SDSPM, "Prop_CommissionsRepresentant", v_CommissionsRepresentant, False) Or v_Maj
				v_NoDirecteur = xVar(gnd_SDSPM, "Prop_NoDirecteur", "")
				Set nd_Dir = xSIRR_xndRepr(v_NoDirecteur, True)
				v_Prof_DirCommissionsDir = xVarProf("Prof_DirCommissionsDir", "")
				v_Maj =SIIx_MajItem(gnd_SDSPM, "Prop_CommissionsDirecteur", xVar(nd_Dir, "Repr_DirCommissionsDir_AH", v_Prof_DirCommissionsDir), False) Or v_Maj 
			Else
				v_Maj =SIIx_MajItem(gnd_SDSPM, "Prop_CommissionsRepresentant", "", False) Or v_Maj
				v_Maj =SIIx_MajItem(gnd_SDSPM, "Prop_CommissionsDirecteur", "", False) Or v_Maj 
			End if
		End If
	%end rem
		
		v_NoRepresentantCCOSSg = xVar(gnd_SDSPM, "Prop_NoRepresentantCCOSSg", "")
		If v_NoRepresentantCCOSSg &lt;&gt; "" Then
			If v_NoRepresentantCCOSSg &lt;&gt; v_NoRepresentant Then
				v_Maj =SIIx_MajItem(gnd_SDSPM, "Prop_NomRepresentantCCOSSg", xVar(nd_Rep, "Repr_NomRepresentant", ""), False) Or v_Maj 
				v_Maj =SIIx_MajItem(gnd_SDSPM, "Prop_CourrielRepresentantCCOSSg", xVar(nd_Rep, "Repr_Courriel", ""), False) Or v_Maj 
			End If	
		End If
		
		If v_Maj Then
			' Modifier les accès (sécurité)
			' -----------------------------
			Call SDSPP_AssignerSecurite(gnd_Prop_SDSPM, False)
			
			' Mettre à jour l'historique de la proposition
			' --------------------------------------------
			If xVar(gnd_SDSPM, "Prop_NoOpportuniteSF" , "") = "" Then
				Call SIHi_BatirHistorique(gnd_Prop_SDSPM)
			End If
			
			
			g_NoRep_FPNav = xVar(gnd_SDSPM, "Prop_NoRepresentant", "")
		Else
			Print xGDK_xMessage("SDSPP", 204, "", "")
		End If
		
		Call gnuid_SDSPM.Refresh
	End If	
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_ExtraireOpportunite"><lotusscript>'===================================================================================================================================================
Function FPNav_ExtraireOpportunite(p_NoOpportunite As String, p_NoClientFmt As String) As Integer
	'---------------------------------------------------------------------	
	' Extraire l'opportunité et le compte de Salesforce
	'---------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim v_NomProfilSalesforceAPI As String
	Dim v_AccountId As String
	
	FPNav_ExtraireOpportunite = 0
	
	Set gcl_SessionSLSf_FSFPP = New SLSf_clSession
	Set gcl_SessionSLSf_FSFPP.Objects("Opportunity") = Nothing
	Set gcl_SessionSLSf_FSFPP.Objects("Account") = Nothing
	
	v_NomProfilSalesforceAPI = SDSPSf_NomProfilSalesforceAPI
	Set gcl_SessionSLSf_FSFPP.ConnexionAPI = New SLSf_clConnexionAPI(v_NomProfilSalesforceAPI)
	If gcl_SessionSLSf_FSFPP.ConnexionAPI.Resultat &lt; 0 Then
		FPNav_ExtraireOpportunite = gcl_SessionSLSf_FSFPP.ConnexionAPI.Resultat
		Exit Function
	End If
	
	If p_NoOpportunite = "" Then 
		Set gcl_SessionSLSf_FSFPP.Objects("Account") = New SLSf_clObject(gcl_SessionSLSf_FSFPP.ConnexionAPI, "Account", "SERTI_ID__c/" + p_NoClientFmt )
		FPNav_ExtraireOpportunite = gcl_SessionSLSf_FSFPP.Objects("Account").Resultat
		If gcl_SessionSLSf_FSFPP.Objects("Account").Resultat &lt; 0 Then
			Exit Function
		End If
	Else
		Set gcl_SessionSLSf_FSFPP.Objects("Opportunity") = New SLSf_clObject(gcl_SessionSLSf_FSFPP.ConnexionAPI, "Opportunity", p_NoOpportunite)
		FPNav_ExtraireOpportunite = gcl_SessionSLSf_FSFPP.Objects("Opportunity").Resultat
		If gcl_SessionSLSf_FSFPP.Objects("Opportunity").Resultat &lt; 0 Then
			MessageBox xGDK_xMessage("SDSPP", 196, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If
		
		v_AccountId = gcl_SessionSLSf_FSFPP.Objects("Opportunity").ExtraireValeur("AccountId", "")
		Set gcl_SessionSLSf_FSFPP.Objects("Account") = New SLSf_clObject(gcl_SessionSLSf_FSFPP.ConnexionAPI, "Account", v_AccountId)
	End If
	
	Exit Function
	
GererErreur:
	FPNav_ExtraireOpportunite = -9
	Call SIGE_TraiterErreur(gc_Element_FPNav, gc_Element_FPNav, GetThreadInfo(1), "", False)
	Exit Function
End Function


</lotusscript></code><code event="FPNav_InitialiserContactCCClient"><lotusscript>Sub FPNav_InitialiserContactCCClient(pnd_PNav As NotesDocument, p_Cache As Boolean)
	On Error GoTo GererErreur
	
	Dim nd_ContactPJ As NotesDocument
	
	Dim a_NomClientContacts As Variant
	Dim a_NoClientContacts As Variant
	Dim a_NoContacts As Variant
	Dim a_NomContacts As Variant
	Dim a_CourrielContacts As Variant	
	Dim i As Integer
	Dim v_NoContact As String
	Dim v_Origine As String
	Dim v_MajContactCC As Integer
	
	' Initialisations
	v_MajContactCC = 0
	
	a_NoContacts = xVarArray(pnd_PNav, "Prop_NoContactsCCDsg")	
	
	If Not IsArray(a_NoContacts) Then
		Exit sub
	End if
	
	v_Origine = xVar(pnd_PNav, "Prop_Origine", "")
	If v_Origine = "SF" Then
		Exit Sub
	End If	
	
	ReDim a_NomClientContacts(UBound(a_NoContacts))
	ReDim a_NoClientContacts(UBound(a_NoContacts))
	ReDim a_NomContacts(UBound(a_NoContacts))
	ReDim a_CourrielContacts(UBound(a_NoContacts))
	
	For i = 0 To UBound(a_NoContacts)
		
		v_NoContact = a_NoContacts(i)
		
		If v_Origine &lt;&gt; "SICl" Then
			Set nd_ContactPJ = xPJ_xndCont(v_Origine, v_NoContact, False)
			'Set nd_Proj = xPJ_xndProj(v_Origine, xVar(pnd_PNav, "Prop_NoProjet", ""), True)
			'Set nd_Clie = xPJ_xndClie(v_Origine, xVar(nd_Proj, "Clie_NoClient", ""), p_Cache)
		Else
			If pnd_PNav.Parentdatabase.Server &lt;&gt; "" Then
				Select Case xSICl_xVarClie(xVar(pnd_PNav, "Prop_ClientNoFmt", ""), "Clie_ClientCategorie", "", True)
				Case "60"
					v_Origine = "PJSDS"
				Case "62"
					v_Origine = "PJUSA"
				Case Else
					v_Origine = "PJDIV"
			End Select
				
				Set nd_ContactPJ = xPJ_xndCont(v_Origine, v_NoContact, False)			
			Else
				Exit Sub
			End If			
		End If
		
		If Not nd_ContactPJ Is Nothing Then	
			a_NomClientContacts(i) = xVar(nd_ContactPJ, "Clie_Nom", "- - -")	
			a_NoClientContacts(i) = xVar(nd_ContactPJ, "Clie_NoClientFmt", "- - -")	
			a_NomContacts(i) = xVar(nd_ContactPJ, "Cont_Contact", "- - -")		
			a_CourrielContacts(i) = xVar(nd_ContactPJ, "Cont_Courriel", "- - -")										
		End If
		
	Next
	
	pnd_PNav.Cont_NomClientContactsCCDsg = a_NomClientContacts
	pnd_PNav.Cont_NoClientContactsCCDsg = a_NoClientContacts
	pnd_PNav.Cont_ContactNomsCCDsg = a_NomContacts
	pnd_PNav.Cont_ContactCourrielsCCDsg = a_CourrielContacts
	
	If xVarImplode(pnd_PNav, "Prop_NoClientContactsCCDsg", ";") &lt;&gt; xVarImplode(pnd_PNav, "Cont_NoClientContactsCCDsg", ";") _
	Or xVarImplode(pnd_PNav, "Prop_NomClientContactsCCDsg", ";") &lt;&gt; xVarImplode(pnd_PNav, "Cont_NomClientContactsCCDsg", ";") _
	Or xVarImplode(pnd_PNav, "Prop_ContactNomsCCDsg", ";") &lt;&gt; xVarImplode(pnd_PNav, "Cont_ContactNomsCCDsg", ";") _
	Or xVarImplode(pnd_PNav, "Prop_ContactCourrielsCCDsg", ";") &lt;&gt; xVarImplode(pnd_PNav, "Cont_ContactCourrielsCCDsg", ";") Then
		v_MajContactCC = 1
	End If
	
	pnd_PNav.PNav_MajContactCC = v_MajContactCC
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acDupliquerProposition"><lotusscript>Sub FPNav_acDupliquerProposition
	On Error GoTo GererErreur
	
	Dim ndb As NotesDatabase
	Dim nd_Duplicata As NotesDocument
	Dim nd_DB As NotesDocument
	
	Dim v_UserName As String
	Dim v_Description As Variant
	Dim v_ID As String
	Dim v_DB_ID As String
	Dim v_EditMode As String
	Dim v_Commentaire As String
	Dim v_DBRecalcTous As Boolean
	Dim v_RecalcListe As Boolean
	
	On Error 4411 GoTo FinSub
	Call gnuid_SDSPM.Save
	
	' Demander la nouvelle description à l'utilisateur
	v_Description = gnuiws_SDSPM.Prompt(PROMPT_OKCANCELEDIT, _
	xGDK_xMessage("SDSPP", 46, "", ""), xGDK_xMessage("SDSPP", 47, "", ""), CStr(Today()))
	If v_Description = "" Then
		Exit Sub
	Else
		If v_Description = xVar(gnd_SDSPM,"Prop_DescProposition","") Then
			MessageBox xGDK_xMessage("SDSPP", 48, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		End If
	End If
	
	'Set ndb_Temp = xGDK_xndbNDB("SITp")
	'Set nd_DB = New NotesDocument(ndb_Temp)
	Set nd_DB = New NotesDocument(gndb_SDSPM)
	nd_DB.Form = "DB_SIHi"	
	nd_DB.SIHi_Obligatoire = True	' Image "&gt;" pour Commentaire obligatoire
	
	If Not gnuiws_SDSPN.DialogBox("DB_SIHi", True, True, False, False, False, False, _
	xGDK_xMessage("SI", 49, "", ""), nd_DB, True, False, False) Then
		Exit Sub
	End If
	
	v_Commentaire = xVar(nd_DB, "SIHi_Commentaire", "")
	v_UserName = gns_SDSPM.UserName
	v_EditMode = xVar(gnd_SDSPM, "PNav_EditMode", "")
	
	Call SDSPDp_DupliquerProposition(gnd_Prop_SDSPM,CStr(v_Description), nd_Duplicata, nd_DB, v_UserName)
	%REM
	If v_EditMode = "1" Then
		Call SDSPDp_DupliquerProposition(gnd_Prop_SDSPM,CStr(v_Description), nd_Duplicata, nd_DB, v_UserName)
	Else
		Set ndb = gns_SDSPM.CurrentDatabase
		If ndb.server = "" Then
			MessageBox xGDK_xMessage("SI", 44, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Sub
		End If
		Set ws_Proposition = New Cl_proposition
		Call nd_DB.save(True, False)
		v_DB_ID = nd_DB.Universalid
		v_ID = ws_Proposition.DupliquerPropositionSDSP3(xVar(gnd_SDSPM, "Prop_NoProposition", ""), CStr(v_Description), v_DB_ID, v_UserName)
		Set ndb = gns_SDSPM.CurrentDatabase
		Set nd_Duplicata = ndb.GetDocumentByUnid(v_ID)
	End If
	%END REM
	
	If Not nd_Duplicata Is Nothing Then
		Call SDSPM_acRecalculerCouts(nd_Duplicata, False, False)
		
	%REM
		If v_EditMode = "1" Then
			Call SDSPM_acRecalculerCouts(nd_Duplicata, False, False)
		Else 
			' Mode lecture
			Set nd_DB = New NotesDocument(gndb_SDSPM)
			nd_DB.DB_ChoixObligatoire = False
			
			If gnuiws_SDSPM.DialogBox( "DB_RCou" , True , True , True ,_
			False, False, False , xGDK_xMessage("SDSPP", 42, "", ""),_
			nd_DB , True , True , False ) Then
				
				' Recalculer couts/prix de tous les produits
				v_DBRecalcTous = CInt(xVar(nd_DB, "DB_RecalcTous",0))
				v_RecalcListe = v_DBRecalcTous
				
				If ws_Proposition.RecalculerCoutsSDSP3(xVar(gnd_SDSPM, "Prop_NoProposition", ""), False, False, v_UserName) Then
					MessageBox xGDK_xMessage("SDSPP", 44, "", "")
					Call gnuid_SDSPM.Refresh
				Else
					MessageBox xGDK_xMessage("SDSPP", 45, "", "")
				End If
			
			Else
				Print xGDK_xMessage("SI", 1, "", "")
				Exit Sub
			End If
			
		End If
	%END REM
		
		' Fermer la proposition
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPM.Close
		Call gnuiws_SDSPM.ViewRefresh
	Else
		Call gnuid_SDSPM.Refresh
	End If
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

	

</lotusscript></code><code event="FPNav_hsMajAdresseClient"><lotusscript>Sub FPNav_hsMajAdresseClient
	On Error GoTo GererErreur
	
	Dim nd_Proj As NotesDocument
	Dim nd_Clie As NotesDocument
	Dim ndc_Sites As NotesDocumentCollection
	Dim nd_Site As NotesDocument
	Dim nd_Suivant As NotesDocument
	
	Dim v_Origine As String
	Dim v_CleClient As String
	Dim v_MajSite As Boolean
	
	If Not FPNav_MajAdresseClient Then
		Exit Sub
	End If
	
	v_Origine = xVar(gnd_SDSPM, "Prop_Origine", "")
	If v_Origine = "SF" Then
		Exit Sub
	End If
	
	' Trouver le site qui est le même que le client
	If v_Origine &lt;&gt; "SICl" Then
		Set nd_Proj = xPJ_xndProj(v_Origine, xVar(gnd_SDSPM, "Prop_NoProjet", ""), True)
		
		If Not nd_Proj Is Nothing Then
			Set nd_Clie = xPJ_xndClie(v_Origine, xVar(nd_Proj, "Clie_NoClient", ""), True)
			v_CleClient = xVar(nd_Clie, "CleClient", "")
		End If
	Else
		Set nd_Clie = xSICl_xndClie(xVar(gnd_SDSPM, "Prop_ClientNoFmt", ""), False)
		v_CleClient = xVar(nd_Clie, "Clie_ClientNoFmt", "")
	End If
	
	Set ndc_Sites = xSDSP3_xndcSite(xVar(gnd_Prop_SDSPM, "Prop_NoProposition", ""))
	
	If ndc_Sites.Count &gt; 0 Then
		Set nd_Suivant = ndc_Sites.GetFirstDocument
		Do Until nd_Suivant Is Nothing
			Set nd_Site = nd_Suivant
			Set nd_Suivant = ndc_Sites.GetNextDocument(nd_Suivant)
			If xVar(nd_Site, "Site_OrigineCle", "") = v_CleClient Then
				v_MajSite = True
				Exit Do
			End If
		Loop
	End If
	
	If Not nd_Site Is Nothing And v_MajSite Then
		If xVar(gnd_SDSPM, "PNav_MajAdresse", "") = 1 Then
			Call FPNav_MajAdresseSiteClient(nd_Clie, nd_Site, v_Origine)
		End If
	End If
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPM.Refresh
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
	
End Sub

</lotusscript></code><code event="FPNav_acOuvrirBonTravail"><lotusscript>Sub FPNav_acOuvrirBonTravail
	On Error GoTo GererErreur
	
	Dim nd_BTra As NotesDocument
	Dim ndc_BTra As NotesDocumentCollection
	Dim nuid As NotesUIDocument
	Dim nv_BTra As NotesView	
	Dim v_NoProp As String
	Dim a_NoBCSites As Variant	
	Dim v_NbPropositionFmt As String
	
	'Initialisations
	Call xSIBDT_Initialisations
	
	Set nv_BTra = gndb_xSIBDT.GetView("v_BTra73")
	Call nv_BTra.Refresh
	
	
	'Verifier si Bon de commande existe	
	v_NoProp = xVar(gnd_SDSPM, "Prop_NoProposition", "")	
	a_NoBCSites = Evaluate(|@DbLookup("" : "NoCache"; ""; "V_Site21"; "| &amp; v_NoProp &amp; |"; 10;[FailSilent])|)
	
	If IsArray(a_NoBCSites) Then		
		
		v_NbPropositionFmt = xVar(gnd_SDSPM, "Prop_NbPropositionFmt", "")
		Set ndc_BTra = nv_BTra.GetAllDocumentsByKey(v_NbPropositionFmt, True)
		
		If ndc_Btra.Count = 0 Then
			MessageBox xGDK_xMessage("SI", 70, "", ""), 16, xGDK_xMessage("SI", 1, "", "")				
			Exit Sub
			
		ElseIf ndc_BTra.count = 1 Then
			
			Set nd_BTra = ndc_BTra.getfirstDocument
			
		Else 
			' Sélectionner un bon de travail
			Set nd_Btra = SISe_ndPickList(nv_BTra, xGDK_xMessage("SIBDT", 40, "", ""), v_NbPropositionFmt)				
			
		End If
		
		' Ouvrir le bon de travail		
		If Not nd_Btra Is Nothing Then
			Set nuid = gnuiws_SDSPN.EditDocument( False , nd_Btra)	
		End If		
		
		
	Else

		MessageBox xGDK_xMessage("SI", 70, "", ""), 16, xGDK_xMessage("SI", 1, "", "")				
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsNomLegalNonModifiable"><lotusscript>Function FPNav_hsNomLegalNonModifiable
	On Error Goto GererErreur
	
	Dim v_MajNomClient As Integer
	
	Call gnd_SDSPM.ReplaceItemValue( "Prop_NomLegalModifie", "0")
	Call gnd_SDSPM.ReplaceItemValue( "Prop_ClientNomLegal", xVar(gnd_SDSPM, "Prop_NomLegalListe", ""))
	
	v_MajNomClient = 0
	
	If xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") &lt;&gt; "" Then
		If xVar(gnd_SDSPM, "Prop_ClientNomInterne", "") = xVar(gnd_SDSPM, "Clie_ClientNomInterne", "") Then
			v_MajNomClient = 0
		Else
			v_MajNomClient = 1
		End If
	Else
		If xVar(gnd_SDSPM, "Prop_ClientNom", "") = xVar(gnd_SDSPM, "Clie_ClientNom", "") Then
			v_MajNomClient = 0
		Else
			v_MajNomClient = 1
		End If
	End If
	
	If v_MajNomClient = 0 Then
		If xVar(gnd_SDSPM, "Prop_ClientNomLegal", "") = xVar(gnd_SDSPM, "Clie_NomLegal", "") Then
			v_MajNomClient = 0
		Else
			v_MajNomClient = 1
		End If
	End If
	
	Call gnd_SDSPM.ReplaceItemValue( "PNav_MajNomClient", v_MajNomClient)
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPM.Refresh
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function


</lotusscript></code><code event="FPNav_hsOuvrirProjeto"><lotusscript>Sub FPNav_hsOuvrirProjeto
	
	On Error GoTo GererErreur
	
	Dim nd_CliePJ As NotesDocument
	Dim nd As NotesDocument
	
	Dim v_ClientNoFmt As String
	Dim v_NomBD As String
	Dim v_Origine As String
	
	
	v_ClientNoFmt = xVar(gnd_SDSPM, "Prop_ClientNoFmt","")
	v_Origine = xVar(gnd_SDSPM, "Prop_Origine","")
	If v_Origine = "SF" Then
	Else
		'___________________
		
		' Initialisations
		If v_Origine = "SICl" Then
			
			Select Case xSICl_xVarClie(v_ClientNoFmt, "Clie_ClientCategorie", "", True)
			Case "60"
				v_Origine = "PJSDS"
			Case "62"
				v_Origine = "PJUSA"
			Case Else
				v_Origine = "PJDIV"
		End Select
			
		End If
		

		
		' Selectionnez le doc du client           
		
		Set nd_CliePJ = xPJ_xndClieSI(v_Origine, v_ClientNoFmt, True)
		
		If Not nd_CliePJ Is Nothing Then
			Call gnuiws_SDSPM.EditDocument(False, nd_CliePJ)
			
		Else
			
			'client n'existe pas dans Projecto
			MessageBox xGDK_xMessage("SDSPP", 136 ,"", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
			
			
			
		End If
	End If
	

	
	Exit Sub
	
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
	
	
	
End Sub



</lotusscript></code><code event="FPNav_acCreerBonDeCommande"><lotusscript>Sub FPNav_acCreerBonDeCommande
	On Error Goto GererErreur
	
	Dim a_NoSites As String
	
	a_NoSites = xVarImplode(gnd_Prop_SDSPM, "Prop_NoSites", ";")
	
	If Not SDSPUI_acCreerBonDeCommande(gnd_Prop_SDSPM, a_NoSites, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
		Exit Sub
	End If
	
	Call gnuid_SDSPM.Refresh
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub



</lotusscript></code><code event="FPNav_hsSelectionnerContactKLSF"><lotusscript>Sub FPNav_hsSelectionnerContactKLSF
	On Error GoTo GererErreur
	
	Dim cl_ConnexionAPI As SLSf_clConnexionAPI
	Dim cl_Opportunity As SLSf_clObject
	Dim cl_Account As SLSf_clObject
	
	Dim v_Resultat As Integer
	Dim v_AccountId As String
	Dim v_ContenuesContacts As Variant	
	Dim v_contactID As String
	Dim v_ListContacts As Variant
	Dim v_Choix As Variant	
	Dim a_ClesContacts As Variant
	Dim a_ChoixContacts As Variant
	Dim a_TriCles As Variant
	Dim a_TriChoix As Variant

	Dim v_contactsCount As Long
	Dim v_PosChoix As Long
	
	Dim v_idChoix As String
	Dim v_ConnectID As String
	Dim v_NoOpportuniteSF As String
	Dim v_LigneChoixContact As String
	Dim v_ContactTitle As String
	
	Dim v_ContactItems As String
	Dim v_ContactOwn As String
	Dim v_ContactSign As String
	Dim v_ContactEmail As String
	
	Dim v_ID As String
	Dim a_Cles() As String
	Dim a_Choix() As String
	Dim v_Count As Long	
	Dim v_NoClientFmt As String	
	Dim v_FiltreSignataires As Boolean
	Dim v_SertiRole As String
	Dim v_AjoutListe As Boolean
	Dim v_Roles As Variant	
	Dim v_ListeContactsNbSignatory As Integer
	
	v_ListeContactsNbSignatory = 0
	v_Roles = Evaluate(|!@IsNotMember("[TousSignataires]" : "[Admin]"; @UserRoles)|)
	
	If v_Roles(0) = 1 Then
		v_FiltreSignataires = False
	Else
		v_FiltreSignataires = True
	End If		
	v_AjoutListe = False

	v_ConnectID = SDSPSf_NomProfilSalesforceAPI
	v_NoOpportuniteSF = xVar(gnd_SDSPM, "Prop_NoOpportuniteSF" , "")
	v_NoClientFmt = xVar(gnd_SDSPM, "Prop_ClientNoFmt" , "")
	
	' Extraire l'opportunité de Salesforce
	g_Resultat_FSFPP = FPNav_ExtraireOpportunite(v_NoOpportuniteSF, v_NoClientFmt)
	
	If g_Resultat_FSFPP &lt; 0 Then
		Print "69"
		Exit Sub
	Else
		
		
		Set cl_Account = gcl_SessionSLSf_FSFPP.Objects("Account")
		If cl_Account.Resultat = 1 Then				

			' Extraire les contacts
			v_Resultat = cl_Account.ExtraireEnfants("Contacts", "")
			
			If cl_Account.NbEnfants("Contacts") &gt; 0 Then
				
				v_contactsCount = -1
				ReDim a_ChoixContacts(v_Resultat-1) As String
				ReDim a_ClesContacts(v_Resultat-1) As String
				ReDim a_TriChoix(v_Resultat-1) As String
				ReDim a_TriCles(v_Resultat-1) As String
				
				v_ListContacts = cl_Account.Enfants("Contacts")
				
				ForAll contact In v_ListContacts
					v_SertiRole = contact.ExtraireValeur("SERTI_Role__c", "")
					v_ContactSign = contact.ExtraireValeur("Authorised_Signatory__c", "0")
					
					If v_SertiRole &lt;&gt; "" Then													
						If v_ContactSign = "True"  Then	
							v_ListeContactsNbSignatory = v_ListeContactsNbSignatory + 1
						End If
					End If							
					
				End ForAll		

				ForAll contact In v_ListContacts
					v_SertiRole = contact.ExtraireValeur("SERTI_Role__c", "")
					v_ContactSign = contact.ExtraireValeur("Authorised_Signatory__c", "0")
					
					If v_SertiRole &lt;&gt; "" Then	
						If Not v_FiltreSignataires Then	
							v_AjoutListe = True
						Else	
							If v_ListeContactsNbSignatory &gt; 0 Then
								If v_ContactSign = "True"  Then	
									v_AjoutListe = True
								End If
							Else
								v_AjoutListe = True
							End If
							
						End If	
					End If
					
					If 	v_AjoutListe Then					

						v_contactsCount = v_contactsCount + 1								
						v_ContactItems = ""
						v_contactID = contact.ExtraireValeur("Id", "") 				
						a_ClesContacts(v_contactsCount)  = contact.ExtraireValeur("Id", "") 						
						
						v_LigneChoixContact =  contact.ExtraireValeur("Name", "") 
						a_TriChoix(v_contactsCount)  = v_LigneChoixContact
						a_TriCles(v_contactsCount)  = v_LigneChoixContact
						
						v_ContactTitle = contact.ExtraireValeur("Title", "")
						If v_ContactTitle &lt;&gt; "" Then
							v_LigneChoixContact = v_LigneChoixContact &amp;  ", " &amp; v_ContactTitle
						End If	
						
						v_ContactOwn = contact.ExtraireValeur("Owner__c", "0")
						If v_ContactOwn = "True" Then
							If v_ContactItems = "" Then
								v_ContactItems = v_ContactItems &amp; "OWN" 
							End If							
						End If							
						
						v_ContactSign = contact.ExtraireValeur("Authorised_Signatory__c", "0")
						If v_ContactSign = "True" Then
							If v_ContactItems = "" Then
								v_ContactItems = v_ContactItems &amp; "SIGN" 
							Else
								v_ContactItems = v_ContactItems &amp; "+SIGN" 
							End If						
						End If	
						
						v_ContactEmail = contact.ExtraireValeur("Email", "")
						If v_ContactEmail &lt;&gt; "" Then							
							If v_ContactItems = "" Then
								v_ContactItems = v_ContactItems &amp; "EMAIL" 
							Else
								v_ContactItems = v_ContactItems &amp; "+EMAIL" 
							End If		
						End If
						
						If v_ContactItems &lt;&gt; "" Then
							v_ContactItems = " (" &amp; v_ContactItems &amp; ")"
						End If
						
						v_LigneChoixContact = v_LigneChoixContact &amp; v_ContactItems
						a_ChoixContacts(v_contactsCount)  = v_LigneChoixContact
					End If	
					v_AjoutListe = False
					
				End ForAll					
				
				If v_contactsCount &lt; 0 Then
					MessageBox xGDK_xMessage("SI", 271, "", "") &amp; Chr(10) &amp; Chr(10) &amp; xGDK_xMessage("SI", 270, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
					Exit Sub
				End If
				
				ReDim Preserve a_ChoixContacts(v_contactsCount) As String
				ReDim Preserve a_ClesContacts(v_contactsCount) As String
				ReDim Preserve a_TriChoix(v_contactsCount) As String
				ReDim Preserve a_TriCles(v_contactsCount) As String
				
				Call Trier2Arrays(a_TriCles, a_ClesContacts)
				Call Trier2Arrays(a_TriChoix, a_ChoixContacts)	

				v_Choix = gnuiws_SDSPM.Prompt (PROMPT_OKCANCELLIST, xGDK_xMessage("SI", 198, "", ""),xGDK_xMessage("SI", 86, "", "") &amp; Chr(10) &amp; _
				Chr(10) &amp; xGDK_xMessage("SI", 270, "", ""), "", a_ChoixContacts)
				
				If IsEmpty(v_Choix) Then
					Exit Sub
				End If
				
				v_PosChoix = ArrayGetIndex(a_ChoixContacts, v_Choix)
				v_idChoix = a_ClesContacts(v_PosChoix)
				
				Call FPNav_majContactKLSF( v_idChoix, cl_Account.Enfants("Contacts"), gnd_SDSPM ) 
				Call gnuid_SDSPM.Refresh
				
			Else
				
				MessageBox xGDK_xMessage("SI", 271, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
				Exit Sub
			End If
			
		Else
			v_Resultat = cl_ConnexionAPI.Resultat
			MessageBox xGDK_xMessage("SDSPP", 197, "", "CON"), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Sub
		End If			
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_hsFermer"><lotusscript>Sub FPNav_hsFermer
	On Error GoTo GererErreur
	
	' Sauvegarder le document courante
	g_AfficherErreurs_FPNav = ""
	On Error 4411 Goto FinSub
	Call gnuid_SDSPM.Save
	
	' Fermer le masque courant
	gnd_SDSPM.SaveOptions = "0"
	Call gnuid_SDSPN.Close
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_CreerProposition"><lotusscript>Function FPNav_CreerProposition(pnd_Clie As NotesDocument) As Boolean
	On Error GoTo GererErreur
	
	Dim nd_CliePrincipal As NotesDocument
	Dim nd_ClieSiegeSocial As NotesDocument
	Dim nd_Site As NotesDocument
	Dim ni As NotesItem
	
	Dim v_Langue As String
	Dim v_xLangue As String
	Dim v_Pays As String
	Dim v_Province As String
	Dim v_NbSites As Integer
	Dim v_Origine As String
	Dim v_OrigineSiegeSocial As String
	Dim v_DureeContrat As String
	Dim v_NomProfilSalesforceAPI As String
	Dim nd_ProfilSalesforceAPI As NotesDocument
	Dim s As String
	Dim i As Integer
	Dim v_ClientNoFmtSiegeSocial As String
	
	Dim cl_ConnexionAPI As SLSf_clConnexionAPI
	Dim cl_Account As SLSf_clObject
	Dim v_NoSiteSF As String
	Dim v_NomProfilAPI As String
	
	FPNav_CreerProposition = False

	' Vérifie que j'ai accès document profil
	If v_Origine ="SF" Then
		v_NomProfilSalesforceAPI = SDSPSf_NomProfilSalesforceAPI
		Set nd_ProfilSalesforceAPI = xKlSf_xndPSfAPI(v_NomProfilSalesforceAPI, True)
		If nd_ProfilSalesforceAPI Is Nothing Then
			MessageBox xGDK_xMessage("SDSPP", 197, "", "CON"), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If
	End If

	v_Pays = xVar(gnd_SDSPM, "Prop_ClientPays", "")
	v_Province = xVar(gnd_SDSPM, "Prop_ClientProvince", "")
	v_Origine = xVar(gnd_SDSPM, "Prop_Origine","")
	v_Langue = xVar(gnd_SDSPM, "Prop_Langue", "")
	v_xLangue = xLangue
	
	' Créer la proposition
	g_NoProposition_SDSPM = xUnique("") &amp; gns_SDSPM.GetEnvironmentString("SDSPP_NoRep")
	Set gnd_Prop_SDSPM = New NotesDocument(gndb_SDSPm)
	gnd_Prop_SDSPM.Form = "F_Prop"
	gnd_Prop_SDSPM.Cle = g_NoProposition_SDSPM
	gnd_Prop_SDSPM.Description = xVar(gnd_SDSPM, "Prop_ClientNomInterne", "")
	
	REM gnd_Prop_SDSPM.Prop_NbProposition = 0
	
	gnd_Prop_SDSPM.Prop_NoProposition = g_NoProposition_SDSPM
	gnd_Prop_SDSPM.Prop_Origine = v_Origine
	gnd_Prop_SDSPM.Prop_NoProjet = xVar(gnd_SDSPM, "Prop_NoProjet", "")
	gnd_Prop_SDSPM.Prop_ProvenanceProspect = xVar(gnd_SDSPM, "Prop_ProvenanceProspect", "")
	gnd_Prop_SDSPM.Prop_ProvenanceProspectPrecision = xVar(gnd_SDSPM, "Prop_ProvenanceProspectPrecision", "")
	
	' Assigner les champs lié au numéro de proposition si origine = SICl 
	If v_Origine = "SICl" Then
		Call SDSPP_AssignerNbProposition(gnd_Prop_SDSPM)
	End If
	
	s = xVar(gnd_SDSPM, "Prop_TypeProposition", "")
	gnd_Prop_SDSPM.Prop_TypeProposition = s
	gnd_Prop_SDSPM.Prop_TypePropositionDescFR = xSDSBB_xVarTpPp(s, "TpPp_DescTypePropositionFR", "", True)
	gnd_Prop_SDSPM.Prop_TypePropositionDescEN = xSDSBB_xVarTpPp(s, "TpPp_DescTypePropositionEN", "", True)
	gnd_Prop_SDSPM.Prop_TypeContratServiceSDS = xVar(gnd_SDSPM, "Prop_TypeContratServiceSDS", "")
	
	s = xVar(gnd_SDSPM, "Prop_Statut", "")
	gnd_Prop_SDSPM.Prop_Statut = s
	gnd_Prop_SDSPM.Prop_StatutIcone = xIcnTabl(s, "Prop_Statut_FR", True)
	gnd_Prop_SDSPM.Prop_StatutDescFR = xDescTabl(s, "Prop_Statut_FR", True)
	gnd_Prop_SDSPM.Prop_StatutDescEN = xDescTabl(s, "Prop_Statut_EN", True)
	gnd_Prop_SDSPM.Prop_DescProposition = xVar(gnd_SDSPM, "Prop_DescProposition", "")
	
	s = xVar(gnd_SDSPM, "Prop_NoRepresentant", "")
	If s &lt;&gt; "" Then
		gnd_Prop_SDSPM.Prop_NoRepresentant = s
		gnd_Prop_SDSPM.Prop_NomRepresentant = xSIRR_xVarRepr(s, "Repr_NomRepresentant", "", True)
		gnd_Prop_SDSPM.Prop_IdRepresentant = xSIRR_xVarRepr(s, "Repr_NotesID", "", True)
		
		s = xSIRR_xVarRepr(CInt(s), "Repr_NoEquipe", "", True)
		gnd_Prop_SDSPM.Prop_NoEquipe = s
		gnd_Prop_SDSPM.Prop_NomEquipe = xSIRR_xVarEqui(s, "Equi_NomEquipe", "", True)
	End If
	
	gnd_Prop_SDSPM.Prop_NePasPartager = xVar(gnd_SDSPM, "Prop_NePasPartager", "")
	
	gnd_Prop_SDSPM.Prop_NoOpportuniteSF = xVar(gnd_SDSPM, "Prop_NoOpportuniteSF", "")	
	gnd_Prop_SDSPM.Prop_ClientNoSF = xVar(gnd_SDSPM, "Prop_ClientNoSF", "")	
	gnd_Prop_SDSPM.Prop_NoContactSF = xVar(gnd_SDSPM, "Prop_NoContactSF", "")	
	
	gnd_Prop_SDSPM.Prop_ClientNoFmt = xVar(gnd_SDSPM, "Prop_ClientNoFmt", "")
	gnd_Prop_SDSPM.Prop_ClientNomInterne = xVar(gnd_SDSPM, "Prop_ClientNomInterne", "")
	gnd_Prop_SDSPM.Prop_ClientNom = xVar(gnd_SDSPM, "Prop_ClientNom", "")
	gnd_Prop_SDSPM.Prop_ClientNomLegal = xVar(gnd_SDSPM, "Prop_ClientNomLegal", "")
	gnd_Prop_SDSPM.Prop_Langue = v_Langue
	
	gnd_Prop_SDSPM.Prop_ClientCleSitePrinc = xVar(gnd_SDSPM, "Prop_ClientCleSitePrinc", "")
	gnd_Prop_SDSPM.Prop_ClientCleInitial = xVar(gnd_SDSPM, "Prop_ClientCleInitial", "")
	
	gnd_Prop_SDSPM.Prop_NomGroupeClient = xVar(gnd_SDSPM, "Prop_NomGroupeClient", "")
	gnd_Prop_SDSPM.Prop_VersionSDS = xVar(gnd_SDSPM, "Prop_VersionSDS", "")
	gnd_Prop_SDSPM.Prop_VersionOS = xVar(gnd_SDSPM, "Prop_VersionOS", "")
	
	gnd_Prop_SDSPM.Prop_ClientAdresse1 = xVar(gnd_SDSPM, "Prop_ClientAdresse1", "")
	gnd_Prop_SDSPM.Prop_ClientAdresse2 = xVar(gnd_SDSPM, "Prop_ClientAdresse2", "")
	gnd_Prop_SDSPM.Prop_ClientVille = xVar(gnd_SDSPM, "Prop_ClientVille", "")
	gnd_Prop_SDSPM.Prop_ClientProvince = v_Province
	gnd_Prop_SDSPM.Prop_ClientPays = v_Pays
	gnd_Prop_SDSPM.Prop_ClientCodePostal = xVar(gnd_SDSPM, "Prop_ClientCodePostal", "")
	gnd_Prop_SDSPM.Prop_ClientTelephone = xVar(gnd_SDSPM, "Prop_ClientTelephone", "")
	gnd_Prop_SDSPM.Prop_ClientTelephone2 = xVar(gnd_SDSPM, "Prop_ClientTelephone2", "")
	gnd_Prop_SDSPM.Prop_ClientTelecopieur = xVar(gnd_SDSPM, "Prop_ClientTelecopieur", "")
	
	gnd_Prop_SDSPM.Prop_NoContact = xVar(gnd_SDSPM, "Prop_NoContact", "")
	gnd_Prop_SDSPM.Prop_ContactNom = xVar(gnd_SDSPM, "Prop_ContactNom", "")
	gnd_Prop_SDSPM.Prop_ContactFonction = xVar(gnd_SDSPM, "Prop_ContactFonction", "")
	gnd_Prop_SDSPM.Prop_ContactFonctionFR = xVar(gnd_SDSPM, "Prop_ContactFonctionFR", "")
	gnd_Prop_SDSPM.Prop_ContactFonctionEN = xVar(gnd_SDSPM, "Prop_ContactFonctionEN", "")
	gnd_Prop_SDSPM.Prop_ContactTitre = xVar(gnd_SDSPM, "Prop_ContactTitre", "")
	gnd_Prop_SDSPM.Prop_ContactTelephone = xVar(gnd_SDSPM, "Prop_ContactTelephone", "")
	gnd_Prop_SDSPM.Prop_ContactCellulaire = xVar(gnd_SDSPM, "Prop_ContactCellulaire", "")
	gnd_Prop_SDSPM.Prop_ContactCourriel = xVar(gnd_SDSPM, "Prop_ContactCourriel", "")
	
	gnd_Prop_SDSPM.Prop_NoContactsCCDsg  = xVar(gnd_SDSPM, "Prop_NoContactsCCDsg", "")
	gnd_Prop_SDSPM.Prop_ContactNomsCCDsg  = xVar(gnd_SDSPM, "Prop_ContactNomsCCDsg", "")
	gnd_Prop_SDSPM.Prop_NoClientContactsCCDsg  = xVar(gnd_SDSPM, "Prop_NoClientContactsCCDsg", "")
	gnd_Prop_SDSPM.Prop_ContactCourrielsCCDsg  = xVar(gnd_SDSPM, "Prop_ContactCourrielsCCDsg", "")
	gnd_Prop_SDSPM.Prop_NomClientContactsCCDsg  = xVar(gnd_SDSPM, "Prop_NomClientContactsCCDsg", "")
	
	gnd_Prop_SDSPM.Prop_ContactNomsManCCDsg  = xVar(gnd_SDSPM, "Prop_ContactNomsManCCDsg", "")
	gnd_Prop_SDSPM.Prop_ContactCourrielsManCCDsg  = xVar(gnd_SDSPM, "Prop_ContactCourrielsManCCDsg", "")
	
	gnd_Prop_SDSPM.Prop_NoRepresentantCCOSSg  = xVar(gnd_SDSPM, "Prop_NoRepresentantCCOSSg", "")
	gnd_Prop_SDSPM.Prop_NomRepresentantCCOSSg  = xVar(gnd_SDSPM, "Prop_NomRepresentantCCOSSg", "")
	gnd_Prop_SDSPM.Prop_CourrielRepresentantCCOSSg  = xVar(gnd_SDSPM, "Prop_CourrielRepresentantCCOSSg", "")
	
	Call SDSPP_AssignerCommissions(gnd_Prop_SDSPM)
	
	' % escompte LG
	gnd_Prop_SDSPM.Prop_PourcentEscompteLG = xVarProf("Prof_PourcentEscompteLG", 20)
	
	gnd_Prop_SDSPM.Prop_Devise = xVar(gnd_SDSPM, "Prop_Devise", "")
	
	' taux contrat
	gnd_Prop_SDSPM.Prop_TauxContrat = xVarProf("Prof_TauxContrat", 5)
	
	' duréé contrat
	v_DureeContrat = xVarProf("Prop_ContratDuree", 1)	
	gnd_Prop_SDSPM.Prop_ContratDuree = v_DureeContrat	
	gnd_Prop_SDSPM.Prop_ContratDureeDescEN = xSDSBB_xDescTabl(v_DureeContrat, "Prop_ContDuree_EN", True)
	gnd_Prop_SDSPM.Prop_ContratDureeDescFR = xSDSBB_xDescTabl(v_DureeContrat, "Prop_ContDuree_FR", True)	
	
	If xVar(gnd_SDSPM, "Prop_TypeProposition", "") = "1" Then	
		If v_Origine = "SF" Then			
			v_NoSiteSF = SDSPM_SelectionnerValeurKLSF(	xGDK_xMessage("SDSPP", 70, "", "") ) 
			
			If v_NoSiteSF = "" Then
				Exit Function
			End If	
			
			v_NomProfilAPI = SDSPSf_NomProfilSalesforceAPI
			
			Set cl_ConnexionAPI = New SLSf_clConnexionAPI(v_NomProfilAPI)
			If cl_ConnexionAPI.Resultat = 1 Then				
				
				Set cl_Account = New SLSf_clObject(cl_ConnexionAPI, "Account", v_NoSiteSF)
				If cl_Account.Resultat = 1 Then						
					v_ClientNoFmtSiegeSocial = cl_Account.ExtraireValeur("SERTI_ID__c", "" )
					If v_ClientNoFmtSiegeSocial = "" Then
						v_ClientNoFmtSiegeSocial = v_NoSiteSF
					End If
					
					gnd_Prop_SDSPM.Prop_OrigineSiegeSocial =  v_Origine
					gnd_Prop_SDSPM.Prop_ClientNoFmtSiegeSocialSF = v_NoSiteSF
					gnd_Prop_SDSPM.Prop_ClientNoFmtSiegeSocial = v_ClientNoFmtSiegeSocial
					
					gnd_Prop_SDSPM.Prop_ClientNom1SiegeSocial = cl_Account.ExtraireValeur("Name", "")
					gnd_Prop_SDSPM.Prop_ClientNomIntSiegeSocial = cl_Account.ExtraireValeur("Legal_Name__c", "") 
					
				End If			
			End If			
		Else		

			Set nd_CliePrincipal = SDSPS_SelectionnerClient(gnd_SDSPM, v_OrigineSiegeSocial)		
			If nd_CliePrincipal Is Nothing Then				
				Exit Function
			Else
				gnd_Prop_SDSPM.Prop_OrigineSiegeSocial = v_OrigineSiegeSocial
				gnd_Prop_SDSPM.Prop_ClientNoFmtSiegeSocial = xVar(nd_ClieSiegeSocial, "Clie_NoClientFmt","")
				gnd_Prop_SDSPM.Prop_ClientNom1SiegeSocial = xVar(nd_ClieSiegeSocial, "Clie_ClientNom1", "")
				gnd_Prop_SDSPM.Prop_ClientNom2SiegeSocial = xVar(nd_ClieSiegeSocial, "Clie_ClientNom2", "")
				gnd_Prop_SDSPM.Prop_ClientNomIntSiegeSocial = xVar(nd_ClieSiegeSocial, "Clie_ClientNomInterne","")
				
			End If			
			
		End If ' FIN If v_Origine = "SF"
	End If
	
	
	' Si c'est un client SDS existant , conversion serveur hébergé ou changement propriétaire ne pas forcer l'utilisateur à passer à travers tous les écrans
	If xVar(gnd_SDSPM, "PNav_MenuOptionMax", "") = "" And xVar(gnd_SDSPM, "Prop_TypeProposition", "") &gt;= "2" Or _
	xVar(gnd_SDSPM, "Prop_TypeProposition", "") = "3" Then
		gnd_SDSPM.PNav_MenuOptionMax = "9"	' Ouvrir le menu
	Else
		gnd_Prop_SDSPM.PNav_MenuOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionMax", "0.00")
	End If
	
	' Il faut assigner la sécurité avant de sauvegarder
	' -------------------------------------------------
	Set ni = New NotesItem(gnd_Prop_SDSPM, "LecteurAdmin", "[LecteurToutes]", READERS)
	Set ni = New NotesItem(gnd_Prop_SDSPM, "AuteurAdmin", "[Admin]", AUTHORS)
	
	gnd_SDSPM.Prop_NoProposition = g_NoProposition_SDSPM
	FPNav_CreerProposition = True
	
	' Historique
	gnd_Prop_SDSPM.HistoDC = Now
	gnd_Prop_SDSPM.HistoUC = gns_SDSPm.UserName
	
	Call SDSPP_AssignerSecurite(gnd_Prop_SDSPM, False)
	
	' Crée le site
	' ------------
	If Not pnd_Clie Is Nothing Or v_Origine ="SF" Then
		Set nd_Site = SDSPS_CreerSite(gnd_Prop_SDSPM, pnd_Clie, "")	
		If nd_Site Is Nothing  Then
			MessageBox xGDK_xMessage("SDSPP", 198, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Else
			If xVar(gnd_SDSPM, "Prop_TypeProposition", "") &lt; "2" Then
				gnd_Prop_SDSPM.Prop_NoSitePrincipal = xVar(nd_Site, "Site_NoSite", "")				
			End If	
			gnd_Prop_SDSPM.Prop_NoSites = xVar(nd_Site, "Site_NoSite", "")		
		End If
	End If
	
	' Attacher le plan PowerPoint
	' ---------------------------
	If xVar(gnd_SDSPM, "PNav_PlanPowerPoint", "") &lt;&gt; "" Then
		Call SDSPD_CreerDocument_SIDV(g_NoProposition_SDSPM, "0", xVar(gnd_SDSPM, "PNav_PlanPowerPoint", ""), "", "")
	End If
	
	' Maj Salesforce
	If v_Origine = "SF" And xVarProf("Prof_DesactiverSalesforceAPI", "") &lt;&gt; "1" Then
		i = SDSPSf_MajOpportunite(gnd_Prop_SDSPM, Nothing)
		If i &lt; 0 Then
			Call SIGE_EnregistrerErreurManuelle(gc_TypeElement_FPNav, gc_Element_FPNav, "SDSPSf_MajOpportunite", 0, "Erreur lors de la maj de l'opportunité.", _
			g_NoProposition_SDSPM &amp; ";" &amp; xVar(gnd_Prop_SDSPM, "Prop_NoOpportuniteSF", "ERR") &amp; ";" &amp; CStr(i))
			MessageBox xGDK_xMessage("SDSPP", 199, "", "CON"), 64, xGDK_xMessage("SI", 1, "", "")
		End If
	End If
	
	Call SDSPN_MajSitesNav(gnd_SDSPM)
	
	' Mettre à jour le document de navigation
	Call gnd_SDSPM.ReplaceItemValue("Prop_TypePropositionDesc" &amp; v_xLangue, _
	xVar(gnd_Prop_SDSPM, "Prop_TypePropositionDesc" &amp; v_xLangue, ""))
	Call gnd_SDSPM.ReplaceItemValue("Prop_StatutDesc" &amp; v_xLangue, xVar(gnd_Prop_SDSPM, "Prop_StatutDesc" &amp; v_xLangue, ""))
	
	gnd_SDSPM.PNav_DernierSiteOuvert = 0
	gnd_SDSPM.PNav_MaxSiteOuvert = 0
	
	Call SDSPN_ConstruireMenu(gnd_SDSPM)
	gnd_SDSPM.Prop_Cle = xVar(gnd_Prop_SDSPM, "Cle", "")
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_Prop_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function


</lotusscript></code><code event="FPNav_MajContactCCClient"><lotusscript>Function FPNav_MajContactCCClient As Boolean
	On Error GoTo GererErreur
	
	gnd_SDSPM.Prop_NoClientContactsCCDsg = xVar(gnd_SDSPM, "Cont_NoClientContactsCCDsg", "- - -")
	gnd_SDSPM.Prop_NomClientContactsCCDsg = xVar(gnd_SDSPM, "Cont_NomClientContactsCCDsg", "- - -")
	gnd_SDSPM.Prop_ContactNomsCCDsg = xVar(gnd_SDSPM, "Cont_ContactNomsCCDsg", "- - -")
	gnd_SDSPM.Prop_ContactCourrielsCCDsg= xVar(gnd_SDSPM, "Cont_ContactCourrielsCCDsg", "- - -")
	
	gnd_SDSPM.PNav_MajContactCC = 0
	
	FPNav_MajContactCCClient = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_InitialiserAdresseClient"><lotusscript>Sub FPNav_InitialiserAdresseClient(pnd_PNav As NotesDocument, p_Cache As Boolean)
	On Error GoTo GererErreur
	
	Dim nd As NotesDocument
	
	Dim v_ClientNoFmt As String
	Dim v_MajAdresse As Integer
	Dim v_MajNomClient As Integer
	Dim v_Origine As String
	Dim v_Serveur As String
	
	Dim cl_Account As SLSf_clObject
	Dim v_Resultat As Integer	
	Dim v_NoOpportunite As String	
	
	v_Origine = xVar(pnd_PNav, "Prop_Origine", "")
	If v_Origine = "SF" And xVarProf("Prof_DesactiverSalesforceAPI", "") = "1" Then
		Exit Sub
	End If
	
	' Initialisations	
	v_MajAdresse = 0
	v_MajNomClient = 0
	
	v_ClientNoFmt = xVar(pnd_PNav, "Prop_ClientNoFmt", "")
	v_Serveur = pnd_PNav.Parentdatabase.Server
	If v_ClientNoFmt &lt;&gt; "" Or v_Origine &lt;&gt; "SF" Then	' SI CLients ou Projeto
		If FPNav_ndClientOrigine(pnd_PNav, nd, v_Origine, p_Cache) Then
			If v_Origine = "SICl" Then				' SI CLients
				pnd_PNav.Clie_NoClientFmt = xVar(nd, "Clie_ClientNoFmt", "")
				pnd_PNav.Clie_NomLegal = xVar(nd, "Clie_ClientNomLegal", "")
				pnd_PNav.Clie_ClientNom = xVar(nd, "Clie_ClientNomEntreprise", "")
				pnd_PNav.Clie_ClientNomInterne = xVar(nd, "Clie_ClientNomInterne", "")				
				pnd_PNav.Clie_ClientAdresse1 = xVar(nd, "Clie_ClientAdresse1", "")
				pnd_PNav.Clie_ClientAdresse2 = xVar(nd, "Clie_ClientAdresse2", "")
				pnd_PNav.Clie_ClientVille = xVar(nd, "Clie_ClientVille", "")
				pnd_PNav.Clie_ClientProvince = xVar(nd, "Clie_ClientProvince", "")
				pnd_PNav.Clie_ClientPays = xVar(nd, "Clie_ClientPays", "")
				pnd_PNav.Clie_ClientCodePostal = xVar(nd, "Clie_ClientCodePostal", "")
				pnd_PNav.Clie_ClientTelephone = xVar(nd, "Clie_ClientTelephone1", "")
				pnd_PNav.Clie_ClientTelephone2 = xVar(nd, "Clie_ClientTelephone2", "")
				pnd_PNav.Clie_ClientTelecopieur = xVar(nd, "Clie_ClientTelecopieur", "")
				
			Else	' Projeto
				pnd_PNav.Clie_NoClientFmt = xVar(nd, "Clie_NoClientFmt", "")
				pnd_PNav.Clie_NomLegal = xVar(nd, "Clie_NomLegal", "")
				pnd_PNav.Clie_ClientNom = xVar(nd, "Clie_Nom", "")
				pnd_PNav.Clie_ClientNomInterne = xVar(nd, "Clie_ClientNomInterne", "")				
				pnd_PNav.Clie_ClientAdresse1 = xVar(nd, "Clie_Adresse1", "")
				pnd_PNav.Clie_ClientAdresse2 = xVar(nd, "Clie_Adresse2", "")
				pnd_PNav.Clie_ClientVille = xVar(nd, "Clie_Ville", "")
				pnd_PNav.Clie_ClientProvince = xVar(nd, "Clie_Province", "")
				pnd_PNav.Clie_ClientPays = xVar(nd, "Clie_Pays", "")
				pnd_PNav.Clie_ClientCodePostal = xVar(nd, "Clie_CodePostal", "")
				pnd_PNav.Clie_ClientTelephone = xVar(nd, "Clie_Telephone", "")
				pnd_PNav.Clie_ClientTelephone2 = xVar(nd, "Clie_Telephone2", "")
				pnd_PNav.Clie_ClientTelecopieur = xVar(nd, "Clie_Telecopieur", "")
				
			End If
		End If
	Else		' Salesforce
		' Extraire l'opportunité de Salesforce
		v_NoOpportunite = xVar(pnd_PNav, "Prop_NoOpportuniteSF", "")
		g_Resultat_FSFPP = FPNav_ExtraireOpportunite(v_NoOpportunite, "")
		If g_Resultat_FSFPP &lt;= 0 Then
			Exit Sub
		Else
			Set cl_Account = gcl_SessionSLSf_FSFPP.Objects("Account")
			If cl_Account Is Nothing Then
				Exit Sub
			End If
		End If
		
		If gcl_SessionSLSf_FSFPP.Objects("Account").Resultat &gt; 0 Then
			v_ClientNoFmt = cl_Account.ExtraireValeur("SERTI_ID__c", "")
			pnd_PNav.Clie_NoClientFmt = v_ClientNoFmt
			pnd_PNav.Clie_NomLegal = cl_Account.ExtraireValeur("SERTI_Legal_Name__c", "")
			pnd_PNav.Clie_ClientNom = cl_Account.ExtraireValeur("Name", "")
			pnd_PNav.Clie_ClientNomInterne = xSICl_xVarClie(v_ClientNoFmt, "Clie_ClientNomInterne", "", True)
			
			pnd_PNav.Clie_ClientAdresse1 = cl_Account.ExtraireValeur("BillingStreet", "")
			pnd_PNav.Clie_ClientAdresse2 =  xVar(pnd_PNav, "Prop_ClientAdresse2" , "")
			pnd_PNav.Clie_ClientVille = cl_Account.ExtraireValeur("BillingCity", "")
			pnd_PNav.Clie_ClientProvince = cl_Account.ExtraireValeur("BillingStateCode", "")
			pnd_PNav.Clie_ClientPays = cl_Account.ExtraireValeur("BillingCountryCode", "")
			pnd_PNav.Clie_ClientCodePostal = cl_Account.ExtraireValeur("BillingPostalCode", "")
			pnd_PNav.Clie_ClientTelephone = cl_Account.ExtraireValeur("Phone", "")
			pnd_PNav.Clie_ClientTelephone2 = cl_Account.ExtraireValeur("Telephone_2__c", "")
			pnd_PNav.Clie_ClientTelecopieur = cl_Account.ExtraireValeur("Fax", "")
		End If

	End If
	
	%rem
		If v_Serveur = "" Then		
			If v_Origine &lt;&gt; "SICl" Then
				If FPNav_ndClientOrigine(pnd_PNav, nd, v_Origine, p_Cache) Then				
					pnd_PNav.Clie_NoClientFmt = xVar(nd, "Clie_NoClientFmt", "")				
					pnd_PNav.Clie_NomLegal = xVar(nd, "Clie_NomLegal", "")
					pnd_PNav.Clie_ClientNom = xVar(nd, "Clie_Nom", "")
					pnd_PNav.Clie_ClientNomInterne = xVar(nd, "Clie_ClientNomInterne", "")				
					pnd_PNav.Clie_ClientAdresse1 = xVar(nd, "Clie_Adresse1", "")
					pnd_PNav.Clie_ClientAdresse2 = xVar(nd, "Clie_Adresse2", "")
					pnd_PNav.Clie_ClientVille = xVar(nd, "Clie_Ville", "")
					pnd_PNav.Clie_ClientProvince = xVar(nd, "Clie_Province", "")
					pnd_PNav.Clie_ClientPays = xVar(nd, "Clie_Pays", "")
					pnd_PNav.Clie_ClientCodePostal = xVar(nd, "Clie_CodePostal", "")
					pnd_PNav.Clie_ClientTelephone = xVar(nd, "Clie_Telephone", "")
					pnd_PNav.Clie_ClientTelephone2 = xVar(nd, "Clie_Telephone2", "")
					pnd_PNav.Clie_ClientTelecopieur = xVar(nd, "Clie_Telecopieur", "")
				End If
			End If
		Else
			If v_Origine = "SF" Then
				' Extraire l'opportunité de Salesforce
				v_NoOpportunite = xVar(pnd_PNav, "Prop_NoOpportuniteSF" , "")
				g_Resultat_FSFPP = FPNav_ExtraireOpportunite(v_NoOpportunite,"")
				If g_Resultat_FSFPP &lt; 0 Then
					Exit Sub
				Else
					Set cl_Account = gcl_SessionSLSf_FSFPP.Objects("Account")
				End If
				
				pnd_PNav.Clie_NoClientFmt = cl_Account.ExtraireValeur("SERTI_ID__c", "")
				pnd_PNav.Clie_NomLegal = cl_Account.ExtraireValeur("SERTI_Legal_Name__c", "")
				pnd_PNav.Clie_ClientNom = cl_Account.ExtraireValeur("Name", "")
				pnd_PNav.Clie_ClientNomInterne = "NLA"
				
				pnd_PNav.Clie_ClientAdresse1 = cl_Account.ExtraireValeur("BillingStreet", "")
				pnd_PNav.Clie_ClientAdresse2 =  xVar(pnd_PNav, "Prop_ClientAdresse2" , "")
				pnd_PNav.Clie_ClientVille = cl_Account.ExtraireValeur("BillingCity", "")
				pnd_PNav.Clie_ClientProvince = cl_Account.ExtraireValeur("BillingStateCode", "")
				pnd_PNav.Clie_ClientPays = cl_Account.ExtraireValeur("BillingCountryCode", "")
				pnd_PNav.Clie_ClientCodePostal = cl_Account.ExtraireValeur("BillingPostalCode", "")
				pnd_PNav.Clie_ClientTelephone = cl_Account.ExtraireValeur("Phone", "")
				pnd_PNav.Clie_ClientTelephone2 = cl_Account.ExtraireValeur("Telephone_2__c", "")
				pnd_PNav.Clie_ClientTelecopieur = cl_Account.ExtraireValeur("Fax", "")			
				
			Else

				If FPNav_ndClientOrigine(pnd_PNav, nd, v_Origine, p_Cache) Then
					If v_Origine = "SICl" Then				
						pnd_PNav.Clie_NoClientFmt = xVar(nd, "Clie_ClientNoFmt", "")
						pnd_PNav.Clie_NomLegal = xVar(nd, "Clie_ClientNomLegal", "")
						pnd_PNav.Clie_ClientNom = xVar(nd, "Clie_ClientNomEntreprise", "")
						pnd_PNav.Clie_ClientNomInterne = xVar(nd, "Clie_ClientNomInterne", "")				
						pnd_PNav.Clie_ClientAdresse1 = xVar(nd, "Clie_ClientAdresse1", "")
						pnd_PNav.Clie_ClientAdresse2 = xVar(nd, "Clie_ClientAdresse2", "")
						pnd_PNav.Clie_ClientVille = xVar(nd, "Clie_ClientVille", "")
						pnd_PNav.Clie_ClientProvince = xVar(nd, "Clie_ClientProvince", "")
						pnd_PNav.Clie_ClientPays = xVar(nd, "Clie_ClientPays", "")
						pnd_PNav.Clie_ClientCodePostal = xVar(nd, "Clie_ClientCodePostal", "")
						pnd_PNav.Clie_ClientTelephone = xVar(nd, "Clie_ClientTelephone1", "")
						pnd_PNav.Clie_ClientTelephone2 = xVar(nd, "Clie_ClientTelephone2", "")
						pnd_PNav.Clie_ClientTelecopieur = xVar(nd, "Clie_ClientTelecopieur", "")
						
					Else
						pnd_PNav.Clie_NoClientFmt = xVar(nd, "Clie_NoClientFmt", "")
						pnd_PNav.Clie_NomLegal = xVar(nd, "Clie_NomLegal", "")
						pnd_PNav.Clie_ClientNom = xVar(nd, "Clie_Nom", "")
						pnd_PNav.Clie_ClientNomInterne = xVar(nd, "Clie_ClientNomInterne", "")				
						pnd_PNav.Clie_ClientAdresse1 = xVar(nd, "Clie_Adresse1", "")
						pnd_PNav.Clie_ClientAdresse2 = xVar(nd, "Clie_Adresse2", "")
						pnd_PNav.Clie_ClientVille = xVar(nd, "Clie_Ville", "")
						pnd_PNav.Clie_ClientProvince = xVar(nd, "Clie_Province", "")
						pnd_PNav.Clie_ClientPays = xVar(nd, "Clie_Pays", "")
						pnd_PNav.Clie_ClientCodePostal = xVar(nd, "Clie_CodePostal", "")
						pnd_PNav.Clie_ClientTelephone = xVar(nd, "Clie_Telephone", "")
						pnd_PNav.Clie_ClientTelephone2 = xVar(nd, "Clie_Telephone2", "")
						pnd_PNav.Clie_ClientTelecopieur = xVar(nd, "Clie_Telecopieur", "")
						
					End If
				End If
			End If
		End If
	%end rem
	
	If xVar(pnd_PNav, "Prop_ClientNom", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientNom", "") Or _
	xVar(pnd_PNav, "Prop_ClientNoFmt", "") &lt;&gt; xVar(pnd_PNav, "Clie_NoClientFmt", "") Or _
	(xVar(pnd_PNav, "Prop_ClientNoFmt", "") &lt;&gt; "" And xVar(pnd_PNav, "Prop_ClientNomInterne", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientNomInterne", "")) Or _
	xVar(pnd_PNav, "Prop_ClientNomLegal", "") &lt;&gt; xVar(pnd_PNav, "Clie_NomLegal", "") Then
		v_MajNomClient = 1
	End If
	
	' Validations
	If xVar(pnd_PNav, "Prop_ClientAdresse1", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientAdresse1", "") _
	Or xVar(pnd_PNav, "Prop_ClientAdresse2", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientAdresse2", "") _
	Or xVar(pnd_PNav, "Prop_ClientVille", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientVille", "") _
	Or xVar(pnd_PNav, "Prop_ClientProvince", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientProvince", "") _
	Or xVar(pnd_PNav, "Prop_ClientPays", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientPays", "") _
	Or xVar(pnd_PNav, "Prop_ClientCodePostal", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientCodePostal", "") _
	Or xVar(pnd_PNav, "Prop_ClientTelephone", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientTelephone", "") _
	Or xVar(pnd_PNav, "Prop_ClientTelephone2", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientTelephone2", "") _
	Or xVar(pnd_PNav, "Prop_ClientTelecopieur", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientTelecopieur", "") Then
		v_MajAdresse = 1
	End If
	
	pnd_PNav.PNav_MajAdresse = v_MajAdresse
	pnd_PNav.PNav_MajNomClient = v_MajNomClient
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_hsMajInfoClient"><lotusscript>Sub FPNav_hsMajInfoClient
	On Error GoTo GererErreur
	
	If xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") &lt;&gt; "" Then
		If xVar(gnd_SDSPM, "Clie_ClientNomInterne", "") = "" Then
			Messagebox xGDK_xMessage("SDSPP", 66, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Sub
		End If
	Else
		If xVar(gnd_SDSPM, "Clie_ClientNom", "") = "" Then
			Messagebox xGDK_xMessage("SDSPP", 66, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Sub
		End If
	End If
	
	' Validations
	If Not FPNav_MajAdresseClient Then
		Exit Sub
	End If
	
	If xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") &lt;&gt; "" Then
		gnd_SDSPM.Prop_ClientNomInterne = xVar(gnd_SDSPM, "Clie_ClientNomInterne", "")
	Else
		gnd_SDSPM.Prop_ClientNom = xVar(gnd_SDSPM, "Clie_ClientNom", "")
	End If
	
	gnd_SDSPM.Prop_ClientNomLegal = xVar(gnd_SDSPM, "Clie_NomLegal", "")
	gnd_SDSPM.Prop_ClientNoFmt = xVar(gnd_SDSPM, "Clie_NoClientFmt", "")
	
	gnd_SDSPM.PNav_Titre = Trim("C" &amp; _
	Cstr(xVar(gnd_SDSPM, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(gnd_SDSPM, "Prop_ClientNomInterne", xVar(gnd_SDSPM, "Prop_ClientNom", "")))
	gnd_SDSPM.Titre = Trim(xVar(gnd_SDSPM, "PNav_Titre", "") &amp; " - " &amp; xVar(gnd_SDSPM, "PNav_MenuDesc000", ""))
	
	If xVar(gnd_SDSPM, "Prop_ClientNomLegal", "") = xVar(gnd_SDSPM, "Clie_NomLegal", "") Then
		gnd_SDSPM.Prop_NomLegalModifie = "0"
	End If
	
	If xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") &lt;&gt; "" Then
		If xVar(gnd_SDSPM, "Prop_ClientNomInterne", "") = xVar(gnd_SDSPM, "Clie_ClientNomInterne", "") Then
			gnd_SDSPM.Prop_NomClientModifie = "0"
			gnd_SDSPM.Prop_NomInterneModifie = "0"
		End If
	Else
		If xVar(gnd_SDSPM, "Prop_ClientNom", "") = xVar(gnd_SDSPM, "Clie_ClientNom", "") Then
			gnd_SDSPM.Prop_NomClientModifie = "0"
		End If
	End If
	
	gnd_SDSPM.PNav_MajNomClient = 0
	
	' Maj info du site du client
	Call FPNav_MajInfoSiteClient(xVar(gnd_SDSPM, "Prop_Origine", ""), gnd_SDSPM)
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPM.Refresh
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub



</lotusscript></code><code event="FPNav_hsSelectionnerContact_GCli"><lotusscript>Sub FPNav_hsSelectionnerContact_GCli
	On Error GoTo GererErreur
	
	Dim v_Origine As String
	
	v_Origine = xVar(gnd_SDSPM, "Prop_Origine", "")
	If v_Origine &lt;&gt; "SF" then	
		Call FPNav_SelectionnerContact_PJ_GCli(v_Origine)
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentValide_Contact_SICo"><lotusscript>Function FPNav_DocumentValide_Contact_SICo(pnd_Cont As NotesDocument) As Boolean
	On Error GoTo GererErreur
	
	Dim a_NomItemsCont As Variant
	Dim i As Integer
	Dim l_ItemsCont List As String
	Dim v_Langue As String
	Dim v_NomItemsVide As String
	Dim v_ValeurItem As String
	Dim v(1) As Variant
	
	FPNav_DocumentValide_Contact_SICo = False
	
	v_Langue = xLangue
	a_NomItemsCont = Evaluate(|"ContactFonction" : "ContactCourriel"|)
	
	l_ItemsCont("Cont_ContactFonction;FR") = "Fonction"
	'l_ItemsCont("Cont_Titre;FR") = "Titre" Requ 38157 - Ne pas afficher le titre. Garder le code
	l_ItemsCont("Cont_ContactCourriel;FR") = "Courriel"
	l_ItemsCont("Cont_ContactFonction;EN") = "Position"
	'l_ItemsCont("Cont_Titre;EN") = "Title" Requ 38157 - Ne pas afficher le titre. Garder le code
	l_ItemsCont("Cont_ContactCourriel;EN") = "E-Mail"
	
	For i = 0 To UBound(a_NomItemsCont)
		v_ValeurItem = xVarElem(pnd_Cont, "Cont_" &amp; a_NomItemsCont(i), 0, "")
		If v_ValeurItem = "" Then
			If v_NomItemsVide = "" Then
				v_NomItemsVide = Chr(13) &amp; "- " &amp; l_ItemsCont("Cont_" &amp; a_NomItemsCont(i) &amp; ";" &amp; v_Langue)
			Else
				v_NomItemsVide = v_NomItemsVide &amp; Chr(13) &amp; "- " &amp; l_ItemsCont("Cont_" &amp; a_NomItemsCont(i) &amp; ";" &amp; v_Langue)
			End If
		End If
	Next
	
	If v_NomItemsVide &lt;&gt; "" Then
		v(0) = xVar(pnd_Cont, "Cont_Contact", "")
		v(1) = Chr(13) &amp; v_NomItemsVide
		MessageBox xGDK_xMessage("SDSPP", 32 ,"", v), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	FPNav_DocumentValide_Contact_SICo = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_SelectionnerContact_SICo"><lotusscript>Sub FPNav_SelectionnerContact_SICo
	' ---------------------------------------------------------------------------------
	' Le script sélectionne le contact dans SI Contacts
	' ---------------------------------------------------------------------------------
	
	On Error GoTo GererErreur
	
	Dim nd_Cont As NotesDocument
	Dim nd_Clie As NotesDocument
	
	Dim v_Origine As String	
	Dim v_CleClient As String
	Dim v_ClientNoFmt As String	
	Dim v_NomGroupeClient As String

	' Initialisations
	
	v_ClientNoFmt = xVar(gnd_SDSPM, "Prop_ClientNoFmt", "")	
	If v_ClientNoFmt = "" Then
		Exit Sub
	End If
	
	Set nd_Cont = SICo_ndSelectionnerContact(v_ClientNoFmt)
	If Not (nd_Cont Is Nothing) Then
		
		' Valider le contact sélectionné
		'Permettre de sélectionner un contact non signataire lorsque l'utilisateur a le rôle [TousSignataires] ou [Admin] ?
		If Not FPNav_DocumentValide_Contact_SICo(nd_Cont) Then
			Exit Sub
		End If
		
		gnd_SDSPM.Prop_NoContactSF = xVar(nd_Cont, "Cont_ContactReference", "")
		gnd_SDSPM.Prop_NoContact = xVar(nd_Cont, "Cont_NoContact", "")
		gnd_SDSPM.Prop_ContactNom = xVar(nd_Cont, "Cont_Contact", "")
		gnd_SDSPM.Prop_ContactTitre = xVar(nd_Cont, "Cont_ContactTitreProf", "")
		gnd_SDSPM.Prop_ContactFonction = xVar(nd_Cont, "Cont_ContactFonction", "")
		gnd_SDSPM.Prop_ContactFonctionFR = xVar(nd_Cont, "Cont_ContactFonctionFR", "")
		gnd_SDSPM.Prop_ContactFonctionEN = xVar(nd_Cont, "Cont_ContactFonctionEN", "")
		gnd_SDSPM.Prop_ContactTelephone = xVar(nd_Cont, "Cont_ContactTelephone1", "")
		gnd_SDSPM.Prop_ContactCellulaire = xVar(nd_Cont, "Cont_ContactCellulaire", "")
		gnd_SDSPM.Prop_ContactCourriel = xVar(nd_Cont, "Cont_ContactCourriel", "")
		
		gnd_SDSPM.Cont_Nom = xVar(nd_Cont, "Cont_Contact", "")
		gnd_SDSPM.Cont_Titre = xVar(nd_Cont, "Cont_ContactTitreProf", "")
		gnd_SDSPM.Cont_Fonction = xVar(nd_Cont, "Cont_ContactFonction", "")
		gnd_SDSPM.Cont_FonctionFR = xVar(nd_Cont, "Cont_ContactFonctionFR", "")
		gnd_SDSPM.Cont_FonctionEN = xVar(nd_Cont, "Cont_ContactFonctionEN", "")
		gnd_SDSPM.Cont_Telephone = xVar(nd_Cont, "Cont_ContactTelephone1", "") 'xVar(nd_Clie, "Clie_Telephone", xVar(nd_Clie, "Clie_Telephone2", "")))
		gnd_SDSPM.Cont_Cellulaire = xVar(nd_Cont, "Cont_ContactCellulaire", "")
		gnd_SDSPM.Cont_Courriel = xVar(nd_Cont, "Cont_ContactCourriel", "")
		
		gnd_SDSPM.PNav_MajContact = 0
		gnd_SDSPM.PNav_MajNomContact = 0

		Call gnuid_SDSPM.Refresh
		
	End If
	
	'	Call ns.SetEnvironmentVar ("PJ_ContactUNID", "")  'Req# 55273
	
	Exit Sub
	
GererErreur:
	'Reset gns_SIPJ.SetEnvironmentVar ("PJ_ContactUNID", "0")
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_acCopierAdresse"><lotusscript>Sub FPNav_acCopierAdresse
	' Le script permet de copier l'adresse du client dans le clipboard de windows
	On Error Goto GererErreur
	
	Dim v_Adresse As String
	Dim v_NomClient As String
	
	v_NomClient = Ucase(xEvaluate(|@If(!@IsNull(Prop_ClientNomInterne);Prop_ClientNomInterne;Prop_ClientNom)|, gnd_SDSPM))
	v_Adresse = xEvaluate(|@Implode("| &amp; v_NomClient &amp; |" : @Trim(Prop_ClientAdresse1: Prop_ClientAdresse2): Prop_ClientVille : Prop_ClientNomProvince_1 : Prop_ClientNomPays_1 : Prop_ClientCodePostal;@NewLine)|, gnd_SDSPM)
	
	If Not SLCl_AssignerTexteClipBoard(v_Adresse) Then
		Messagebox xGDK_xMessage("SDSPP", 60, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
	Else
		Messagebox xGDK_xMessage("SDSPP", 61, "", v_NomClient), 64, xGDK_xMessage("SI", 10, "", "")
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsPrecedent"><lotusscript>Sub FPNav_hsPrecedent
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	g_AfficherErreurs_FPNav = False 
	On Error 4411 Goto FinSub
	Call gnuid_SDSPM.Save
	
	' Ouvrir le masque précédent
	Call SDSPN_OuvrirMasquePrecedent
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_PostSave"><lotusscript>Sub FPNav_PostSave(pnuid_Source As NotesUIDocument)
	On Error Goto GererErreur
	
	' Sauvegarder l'étape courante
	Call FPNav_SauvegarderDescDetaillee
	
	g_AfficherErreurs_FPNav = ""
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), "", False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_DocumentValide_Contact"><lotusscript>Function FPNav_DocumentValide_Contact(pnd_Cont As NotesDocument, p_Origine As String) As Boolean
	On Error GoTo GererErreur
	
	FPNav_DocumentValide_Contact = False
	
	Dim nd As NotesDocument
	Dim nd_PropContact As NotesDocument
	
	Dim a_NomItemsCont As Variant
	Dim i As Integer
	Dim l_ItemsCont List As String
	Dim s As String
	Dim v_Langue As String
	Dim v_NomItemsVide As String
	Dim v_NoContact As String
	Dim v_Origine As String
	Dim v_ValeurItem As String
	Dim v(1) As Variant
	Dim v_Roles As Variant		
	
	
	v_Langue = xLangue
	v_NoContact = xVar(gnd_SDSPM, "Prop_NoContact", "")
	
	a_NomItemsCont = Evaluate(|"Fonction" : "Courriel"|)
	
	l_ItemsCont("Cont_Fonction;FR") = "Fonction"
	'l_ItemsCont("Cont_Titre;FR") = "Titre" Requ 38157 - Ne pas afficher le titre. Garder le code
	l_ItemsCont("Cont_Courriel;FR") = "Courriel"
	l_ItemsCont("Cont_Fonction;EN") = "Position"
	'l_ItemsCont("Cont_Titre;EN") = "Title" Requ 38157 - Ne pas afficher le titre. Garder le code
	l_ItemsCont("Cont_Courriel;EN") = "E-Mail"
	
	For i = 0 To UBound(a_NomItemsCont)
		v_ValeurItem = xVarElem(pnd_Cont, "Cont_" &amp; a_NomItemsCont(i), 0, "")
		If v_ValeurItem = "" Then
			If v_NomItemsVide = "" Then
				v_NomItemsVide = Chr(13) &amp; "- " &amp; l_ItemsCont("Cont_" &amp; a_NomItemsCont(i) &amp; ";" &amp; v_Langue)
			Else
				v_NomItemsVide = v_NomItemsVide &amp; Chr(13) &amp; "- " &amp; l_ItemsCont("Cont_" &amp; a_NomItemsCont(i) &amp; ";" &amp; v_Langue)
			End If
		End If
	Next
	
	If v_NomItemsVide &lt;&gt; "" Then
		v(0) = xVar(pnd_Cont, "Cont_Contact", "")
		v(1) = Chr(13) &amp; v_NomItemsVide
		MessageBox xGDK_xMessage("SDSPP", 32 ,"", v), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	' Si client projeto	
	If v_Origine &lt;&gt; "SF" Then	
		If p_Origine &lt;&gt; "SICl" And xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") &lt;&gt; "" Then
			
			If v_NoContact &lt;&gt; "" Then
				Set nd_PropContact = gndb_xPJ.Getdocumentbyunid(xVar(gnd_SDSPM, "Prop_NoContact", ""))
				
				v_Roles = Evaluate(|!@IsNotMember("[TousSignataires]" : "[Admin]"; @UserRoles)|)
				
				If xVar(nd_PropContact, "Cont_Signataire", "") = "1" Then
					If xVar(pnd_Cont, "Cont_Signataire", "") &lt;&gt; "1" And v_Roles (0) &lt;&gt; 1 Then
						' Si l'utilisateur n'a pas le rôle [TousSignataires] ou [Admin]
						' Le contact sélectionné n'est pas authorisé à signer des propositions.
						MessageBox xGDK_xMessage("SDSPP", 180 ,"", ""), 16, xGDK_xMessage("SI", 1, "", "")
						Exit Function
					End If
				End If		
			End If
		End If
	End If
	
	FPNav_DocumentValide_Contact = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_hsSelectionnerRepresentantCCOSSg"><lotusscript>Sub FPNav_hsSelectionnerRepresentantCCOSSg
	On Error GoTo GererErreur
	
	Dim v_NomRepresentant As String
	Dim v_NoRepresentant As String
	Dim v_CourrielRepresentant As String
	
	v_NoRepresentant = xVar(gnd_SDSPM, "Prop_NoRepresentant", "")
	
	If v_NoRepresentant &lt;&gt; "" Then
		v_NomRepresentant = xVar(gnd_SDSPM, "Prop_NomRepresentant", "")
		v_CourrielRepresentant = xSIRR_xVarRepr(v_NoRepresentant, "Repr_Courriel", "", True)			
	End If
	
	gnd_SDSPM.Prop_NoRepresentantCCOSSg = v_NoRepresentant
	gnd_SDSPM.Prop_NomRepresentantCCOSSg = v_NomRepresentant
	gnd_SDSPM.Prop_CourrielRepresentantCCOSSg = v_CourrielRepresentant
	
	Call gnuid_SDSPM.Refresh
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsNomClientModifiable"><lotusscript>Function FPNav_hsNomClientModifiable
	On Error GoTo GererErreur
	
	Call gnd_SDSPM.ReplaceItemValue( "Prop_NomClientModifie", "1")
	
	Call gnd_SDSPM.ReplaceItemValue( "Prop_NomClientListe", xVar(gnd_SDSPM, "Prop_ClientNom", ""))
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPM.Refresh
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acReouvrirProposition"><lotusscript>Sub FPNav_acReouvrirProposition
	On Error GoTo GererErreur
	
	If SDSPUI_acReOuvrirProposition(gnd_Prop_SDSPM, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		
		Call gnuiws_SDSPM.ViewRefresh
		
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_SauvegarderDescDetaillee"><lotusscript>Sub FPNav_SauvegarderDescDetaillee
	' ----------------------------------------------------------------------------------------
	' 	Ce script met à jour le champ Prop_DescDetaillee (RichText) dans la proposition.
	'
	' 	note: g_LongueurRT_FPNav prend sa valeur dans FPNav_PostOpen à l'affichage du document
	' ----------------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim nd_PNav As NotesDocument
	Dim nrti_PNavDescDetaillee As NotesRichTextItem
	Dim v_LongueurRT As Long
	Dim v_TexteRT As String
	Dim v_UnidPNav As String
	
	' Extraire le document affiché à l'écran
	v_UnidPNav = gnd_SDSPM.UniversalID
	Set nd_PNav = gndb_SDSPm.GetdocumentByUNID(v_UnidPNav)
	
	' Calculer la longueur du champ Description détaillée (RichText), et le contenu du texte 
	If nd_PNav.HasItem("Prop_DescDetaillee") Then
		Set nrti_PNavDescDetaillee = nd_PNav.GetFirstItem("Prop_DescDetaillee")
		v_LongueurRT = nrti_PNavDescDetaillee.ValueLength
		v_TexteRT = nrti_PNavDescDetaillee.Text
	Else
		v_LongueurRT = 0
		v_TexteRT = ""
	End If
	
	' Comparer le champ avec sa valeur à l'affichage du document 
	If v_LongueurRT &lt;&gt; g_LongueurRT_FPNav Or v_TexteRT &lt;&gt; g_TexteRT_FPNav Then	' Si la description détaillée a changé 
		Call gnd_Prop_SDSPM.RemoveItem("Prop_DescDetaillee")
		If v_LongueurRT &gt; 0 Then
			Call nrti_PNavDescDetaillee.CopyItemToDocument(gnd_Prop_SDSPM, "Prop_DescDetaillee")	' Mettre nvelle valeur dans la proposition
		End If
		
		gnd_Prop_SDSPM.HistoDM = Now
		gnd_Prop_SDSPM.HistoUM = gns_SDSPM.UserName
		Call gnd_Prop_SDSPM.Save(True, False)
		
		g_LongueurRT_FPNav = v_LongueurRT
		g_TexteRT_FPNav = v_TexteRT
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_MajContactClient"><lotusscript>Function FPNav_MajContactClient As Boolean
	On Error GoTo GererErreur
	
	Dim nd_Clie As NotesDocument
	
	Dim v_NoContact As String
	Dim v_Nom As String
	Dim v_Fonction As Variant
	Dim v_Cell As String
	Dim v_Courriel As String
	Dim v_Titre As String
	Dim v_Langue As String
	Dim a_NomItemsCont As Variant
	Dim l_ItemsCont List As String
	Dim v_NomItemsVide As String
	Dim i As Integer
	Dim v_ValeurItem As String
	Dim v(1) As Variant
	
	FPNav_MajContactClient = False
	v_Langue = xLangue
	
	a_NomItemsCont = Evaluate(|"Nom" : "Courriel" : "Fonction"|)
	
	l_ItemsCont("Cont_Nom;FR") = "Nom"
	l_ItemsCont("Cont_Nom;EN") = "Name"
	l_ItemsCont("Cont_Courriel;FR") = "Courriel"
	l_ItemsCont("Cont_Courriel;EN") = "EMail"
	l_ItemsCont("Cont_Fonction;FR") = "Fonction"
	l_ItemsCont("Cont_Fonction;EN") = "Position"
	
	v_NoContact = xVar(gnd_SDSPM, "Prop_NoContact", "")
	v_Nom = xVar(gnd_SDSPM, "Cont_Nom", "")
	v_Cell = xVar(gnd_SDSPM, "Cont_Cellulaire", "")
	v_Courriel = xVar(gnd_SDSPM, "Cont_Courriel", "")
	v_Fonction = xVar(gnd_SDSPM, "Cont_Fonction","")
	v_Titre = xVar(gnd_SDSPM, "Cont_Titre", "")
	
	For i = 0 To UBound(a_NomItemsCont)
		v_ValeurItem = xVarElem(gnd_SDSPM, "Cont_" &amp; a_NomItemsCont(i), 0, "")
		If v_ValeurItem = "" Then
			If v_NomItemsVide = "" Then
				v_NomItemsVide = Chr(13) &amp; "- " &amp; l_ItemsCont("Cont_" &amp; a_NomItemsCont(i) &amp; ";" &amp; v_Langue)
			Else
				v_NomItemsVide = v_NomItemsVide &amp; Chr(13) &amp; "- " &amp; l_ItemsCont("Cont_" &amp; a_NomItemsCont(i) &amp; ";" &amp; v_Langue)
			End If
		End If
	Next
	
	If v_NomItemsVide &lt;&gt; "" Then
		v(0) = v_Nom
		v(1) = Chr(13) &amp; v_NomItemsVide
		MessageBox xGDK_xMessage("SDSPP", 138 ,"", v), 16, xGDK_xMessage("SI", 1, "", "")
		Exit function
	End If
	
	gnd_SDSPM.Prop_NoContact = v_NoContact
	gnd_SDSPM.Prop_ContactNom = v_Nom
	gnd_SDSPM.Prop_ContactTitre = v_Titre
	
	gnd_SDSPM.Prop_ContactFonction = v_Fonction
	gnd_SDSPM.Prop_ContactFonctionFR = xVar(gnd_SDSPM, "Cont_FonctionFR", "")
	gnd_SDSPM.Prop_ContactFonctionEN = xVar(gnd_SDSPM, "Cont_FonctionEN", "")
	
	gnd_SDSPM.Prop_ContactTelephone = xVar(gnd_SDSPM, "Cont_Telephone", "")
	gnd_SDSPM.Prop_ContactCellulaire = v_Cell
	gnd_SDSPM.Prop_ContactCourriel = v_Courriel
	
	gnd_SDSPM.PNav_MajContact = 0
	gnd_SDSPM.PNav_MajNomContact = 0
	
	FPNav_MajContactClient = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code>
