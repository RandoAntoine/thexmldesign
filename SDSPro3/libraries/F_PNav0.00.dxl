</lotusscript></code><code event="FPNav_acSignerProposition"><lotusscript>Sub FPNav_acSignerProposition
	On Error GoTo GererErreur
	
	If SDSPUI_acSignerProposition(gnd_Prop_SDSPM, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") then
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		
		Call gnuiws_SDSPM.ViewRefresh
		
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acRecalculerCouts"><lotusscript>Sub FPNav_acRecalculerCouts
	' -------------------------------------------------
	' Le script permet au directeur de modifier le prix
	' -------------------------------------------------
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	g_AfficherErreurs_FPNav = ""
	On Error 4411 Goto FinSub
	Call gnuid_SDSPM.Save
	
	Call SDSPM_acRecalculerCouts(gnd_Prop_SDSPM, False, False)
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsOuvrirMasque"><lotusscript>Sub FPNav_hsOuvrirMasque(p_NoItem As String)
	On Error Goto GererErreur
	
	Dim v_MenuItemCourant As String
	Dim v_ValiderDocument As Boolean
	Dim a_MenuItems As Variant
	Dim v_NoItem As String
	Dim i As Variant
	
	v_MenuItemCourant = xVar(gnd_SDSPM, "PNav_MenuItemCourant", "")
	a_MenuItems = xVarArray(gnd_SDSPM, "PNav_MenuItems")
	
	v_ValiderDocument = False
	
	' Si clique sur menu item qui est lui même, ne rien faire
	If v_MenuItemCourant = p_NoItem Then
		Exit Sub
	End If
	
	If p_NoItem = "**" Then
		v_NoItem = xVar(gnd_SDSPM, "PNav_MenuOptionMax", "")
		If a_MenuItems(Cint(v_MenuItemCourant)) = v_NoItem Then
			Exit Sub
		End If
		i = Arraygetindex(a_MenuItems, xVar(gnd_SDSPM, "PNav_MenuOptionMax", "0.00"))
		If Not Isnull(i) Then
			v_NoItem = Cstr(i)
		End If
		
	Else
		v_NoItem = p_NoItem
	End If
	
	If Not Isnull(i) Then
		v_ValiderDocument = (xVar(gnd_SDSPM, "PNav_MenuProc" &amp; v_MenuItemCourant, "") = "1" And Cint(v_NoItem) &gt; Cint(v_MenuItemCourant))
	End If
	
	' Sauvegarder le document courante
	g_AfficherErreurs_FPNav = v_ValiderDocument
	On Error 4411 GoTo FinSub	
	Call gnuid_SDSPM.Save
	On Error 4411 GoTo GererErreur	
	
	' Construire le menu
	If Not Isnull(i) Then
		If (xVar(gnd_SDSPM, "PNav_MenuProc" &amp; v_MenuItemCourant, "") = "1" And Cint(v_NoItem) &lt; Cint(v_MenuItemCourant)) Then
			Call SDSPN_ConstruireMenu(gnd_SDSPM)
			Call gnuid_SDSPM.Refresh
		End If
	Else
		Call SDSPN_ConstruireMenu(gnd_SDSPM)
		Call gnuid_SDSPM.Refresh
	End If
	
	' Ouvrir le masque suivant
	Call SDSPN_OuvrirMasqueMenu(p_NoItem)
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_ndClient_PJ"><lotusscript>Function FPNav_ndClient_PJ(p_Origine As String) As NotesDocument
	On Error GoTo GererErreur
	
	Dim nd_Clie As NotesDocument
	Dim nd_Proj As NotesDocument	
	Dim v_ClientNoFmt As String
	
	Set FPNav_ndClient_PJ = Nothing
	If p_Origine = "SF" Then
		Exit Function
	End If
	
	Set nd_Proj = xPJ_xndProj(p_Origine, xVar(gnd_SDSPM, "Prop_NoProjet", ""), True)
	If nd_Proj Is Nothing Then
		' 4 - Le document de référence (client ou projet) est introuvable.
		MessageBox xGDK_xMessage("SDSPP", 4, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	v_ClientNoFmt = xVar(gnd_SDSPM, "Prop_ClientNoFmt", "")
	
	If v_ClientNoFmt &lt;&gt; "" Then
		Set nd_Clie = xPJ_xndClieSI(p_Origine, v_ClientNoFmt, True)
		
		If nd_Clie Is Nothing Then
			MessageBox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If
	Else
		Set nd_Clie = xPJ_xndClie(p_Origine, xVar(gnd_SDSPM, "Prop_ClientCleSitePrinc", ""), True)
		
		If nd_Clie Is Nothing Then 
			Set nd_Proj = xPJ_xndProj(p_Origine, xVar(gnd_SDSPM, "Prop_NoProjet", ""), True)
			If nd_Proj Is Nothing Then
				' Le document de référence (client ou projet) est introuvable.
				MessageBox xGDK_xMessage("SDSPP", 4, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
				Exit Function
			End If
			Set nd_Clie = xPJ_xndClie(p_Origine, xVar(nd_Proj, "Clie_NoClient", ""), True)
		End If
		
	End If
	
	
	Set FPNav_ndClient_PJ = nd_Clie
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_ndClientOrigine"><lotusscript>Function FPNav_ndClientOrigine(pnd_PNav As NotesDocument, pnd As NotesDocument, p_Origine As String, p_Cache As Boolean) As Boolean
	On Error GoTo GererErreur
	
	Dim nd_Proj As NotesDocument
	Dim v_ClientNoFmt As String
	
	FPNav_ndClientOrigine = False
	Set pnd = Nothing
	
	v_ClientNoFmt = xVar(pnd_PNav, "Prop_ClientNoFmt", "")
	If p_Origine = "SICl" Or v_ClientNoFmt &lt;&gt; "" Then
		
		' Extraire le document SI Clients
		Set pnd = xSICl_xndClie(v_ClientNoFmt, False)
		
		If pnd Is Nothing Then
			MessageBox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If
		
		p_Origine = "SICl"
	ElseIf p_Origine = "SF" Then

	Else	' Projeto
		
		v_ClientNoFmt = xVar(pnd_PNav, "Prop_ClientNoFmt","")
		If v_ClientNoFmt &lt;&gt; "" Then
			Set pnd = xPJ_xndClieSI(p_Origine, v_ClientNoFmt, p_Cache)
			If pnd Is Nothing Then
				MessageBox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
				Exit Function
			End If
		Else
			' Selectionnez le doc de client
			Set pnd = xPJ_xndClie(p_Origine, xVar(pnd_PNav, "Prop_ClientCleSitePrinc", ""), p_Cache)
			
			If pnd Is Nothing Then ' utiliser par InitialiserAdresseClient
				Set nd_Proj = xPJ_xndProj(p_Origine, xVar(pnd_PNav, "Prop_NoProjet", ""), True)
				If nd_Proj Is Nothing Then
					' Le document de référence (client ou projet) est introuvable.
					MessageBox xGDK_xMessage("SDSPP", 4, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
					Exit Function
				End If
				Set pnd = xPJ_xndClie(p_Origine, xVar(nd_Proj, "Clie_NoClient", ""), p_Cache)
			End If
			
		End If
		
	End If
	
	FPNav_ndClientOrigine = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Prop_NoProposition", ""), False)
	Exit Function
End Function


</lotusscript></code><code event="FPNav_TypeInstallationSDS"><lotusscript>Function FPNav_TypeInstallationSDS(pnd_PNav As NotesDocument) As String
	' ---------------------------------------------------------------------------------------------------------------
	'	Ce script détermine si le client est Hébergé (Cloud) ou non.
	'
	'	Paramètre:
	'		pnd_PNav:	document de navigation
	'
	'	Valeur retournée:	1 - le client est hébergé (Cloud)
	'						"" ou "0" - le client n'est pas hébergé 
	'						9 - le client n'existe pas dans Projeto 
	' ---------------------------------------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim nd_Client As NotesDocument
	Dim nd_ClientSICl As NotesDocument	
	Dim nd_Projet As NotesDocument
	
	Dim v_Origine As String
	
	' Initialisation
	FPNav_TypeInstallationSDS = ""	
	v_Origine = xVar(pnd_PNav, "Prop_Origine", "")	'SICl, PJSDS ou PJUSA
	If v_Origine = "SF" Then
		FPNav_TypeInstallationSDS = "1"
		Exit Function
	End If
	
	' Si on est en Local, extraire le type d'installation SDS de Projeto
	If Len(pnd_PNav.ParentDatabase.Server) = 0 Then
		If v_Origine = "SICl" Then		
			If xVar(pnd_PNav, "Prop_ClientPays", "") &lt;&gt; "CA" Then
				Set nd_Client = xPJ_xndClieSI("PJUSA", xVar(pnd_PNav, "Prop_ClientNoFmt", ""), True)
			Else
				Set nd_Client = xPJ_xndClieSI("PJSDS", xVar(pnd_PNav, "Prop_ClientNoFmt", ""), True)
			End If	
			
			If Not nd_Client Is Nothing Then
				FPNav_TypeInstallationSDS = xVar(nd_Client, "Clie_TypeInstallationSDS", "")
			Else
				' Impossible de déterminer si le client est hébergé ou non
				FPNav_TypeInstallationSDS = "9"
			End If	
		Else
			Set nd_Projet = xPJ_xndProj(v_Origine, xVar(pnd_PNav, "Prop_NoProjet", ""), True)
			Set nd_Client = xPJ_xndClie(v_Origine, xVar(nd_Projet, "Clie_NoClient", ""), True)	
			If Not nd_Client Is Nothing Then			
				FPNav_TypeInstallationSDS = xVar(nd_Client, "Clie_TypeInstallationSDS", "")	
			End If
		End If	
	Else	
		' Sinon extraire le type d'installation SDS de SI Clients
		If FPnav_ndClientOrigine(pnd_PNav, nd_Client, v_Origine, True) Then		
			If v_Origine = "SICl" Then										' Client SI Clients
				FPNav_TypeInstallationSDS = xVar(nd_Client, "Clie_TypeInstallationSDS", "")
			Else	
				If xVar(nd_Client, "Clie_NoClientFmt", "") &lt;&gt; "" Then		' Client Projeto
					' Extraire le document de SI Clients
					Set nd_ClientSICl = xSICl_xndClie(xVar(nd_Client, "Clie_NoClientFmt", ""), False)
					FPNav_TypeInstallationSDS = xVar(nd_ClientSICl, "Clie_TypeInstallationSDS", "")	
				Else
					' Prospect Projeto   
				End If
			End If
		End If
	End If

	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), "", False)
	Exit Function
End Function


</lotusscript></code><code event="FPNav_acOuvrirBonCommande"><lotusscript>Sub FPNav_acOuvrirBonCommande
	On Error GoTo GererErreur
	
	Dim nd_BCom As NotesDocument
	Dim ndc_BCom As NotesDocumentCollection
	Dim nuid As NotesUIDocument
	Dim nv_BCom As NotesView	
	Dim v_Query As String		
	Dim v_Cle As String
	
	'Initialisations
	Call xSIBDC2_Initialisations
	
	v_Cle = xVar(gnd_SDSPM, "Prop_NoProposition", 0)
	
	' Sélectionner le bon de commande
	' -------------------------------	
	Set ndc_BCom = xSIBDC2_xndcBCom(v_Cle)
	
	If ndc_BCom.Count = 0 Then
		
		MessageBox xGDK_xMessage("SI", 70, "", ""), 16, xGDK_xMessage("SI", 1, "", "")		
		Exit Sub
	ElseIf ndc_BCom.count = 1 Then
		
		Set nd_BCom = ndc_BCom.getfirstDocument
		
	Else		
		'Count plus que 1 afficher prompt
		Set nv_BCom = gndb_xSIBDC2.GetView("V_BCom20")	
		
		' 181: Sélectionnez un bon de commande dans la liste ci-dessous.
		v_Query = |FIELD BCom_OrigineCle CONTAINS "| &amp; v_Cle &amp; |"|
		Set nd_BCom = SISe_ndSelectionnerDocument(v_Query, "", SISe_NOPROMPT, nv_BCom,|BCom_NoBonCommandeFmt + 
	"  /  " + BCom_ClientNoFmt + " - " + @if(BCom_SaisirAdresse = "L";BCom_LivrNom1;BCom_ClientNomInterne)|, xGDK_xMessage("SDSPP", 181, "", ""), "", False)
		
	End If
	
	
	' Ouvrir le bon de commande
	If Not nd_BCom Is Nothing Then		
		Set nuid = gnuiws_SDSPN.EditDocument( False , nd_BCom)		
	End if
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acPayerProposition"><lotusscript>Sub FPNav_acPayerProposition
	On Error GoTo GererErreur
	
	If SDSPUI_acPayerProposition(gnd_Prop_SDSPM, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		
		Call gnuiws_SDSPM.ViewRefresh
		
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

