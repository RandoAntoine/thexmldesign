End Sub

</lotusscript></code><code event="FPNav_hsMajNoOpportuniteSF"><lotusscript>Sub FPNav_hsMajNoOpportuniteSF
	On Error GoTo GererErreur
	
	Dim cl_ConnexionAPI As SLSf_clConnexionAPI
	Dim cl_Opportunity As SLSf_clObject
	
	Dim v_Resultat As Integer	
	Dim v_NoOpportuniteSF As String
	Dim v_ConnectID As String
	
	
	' Initialisations
	v_NoOpportuniteSF = xVar(gnd_SDSPM, "Prop_NoOpportuniteSF", "")
	v_ConnectID = SDSPSf_NomProfilSalesforceAPI
	v_NoOpportuniteSF = xVar(gnd_SDSPM, "Prop_NoOpportuniteSF" , "")
	
	Set cl_ConnexionAPI = New SLSf_clConnexionAPI(v_ConnectID)
	If cl_ConnexionAPI.Resultat = 1 Then
		Set cl_Opportunity = New SLSf_clObject(cl_ConnexionAPI, "Opportunity", v_NoOpportuniteSF)
		If cl_Opportunity.Resultat = 1 Then			
			
			gnd_Prop_SDSPM.Prop_NoOpportuniteSF = v_NoOpportuniteSF
			gnd_Prop_SDSPM.Prop_Origine = "SF"
			Call gnd_Prop_SDSPM.Save(True, False)
			Call gnuid_SDSPM.Refresh
			
			v_Resultat = SDSPSf_MajOpportunite(gnd_Prop_SDSPM, cl_ConnexionAPI)	
			If v_Resultat &lt; 0 Then	
				Call SIGE_EnregistrerErreurManuelle(gc_TypeElement_FPNav, gc_Element_FPNav, "SDSPSf_MajOpportunite", 0, "Erreur lors de la maj de l'opportunité.", g_NoProposition_SDSPM &amp; ";" &amp; xVar(gnd_Prop_SDSPM, "Prop_NoOpportuniteSF", "ERR") &amp; ";" &amp; CStr(v_Resultat))
			End If
			
		Else
			'Message NoOpportunite erronee
			MessageBox xGDK_xMessage("SDSPP", 196, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Sub
			v_Resultat = cl_Opportunity.Resultat
		End If
		
	Else
		v_Resultat = cl_ConnexionAPI.Resultat
	End If
	

	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_ExtraireSignataire"><lotusscript>Sub FPNav_ExtraireSignataire( p_contacts As Variant, pnd_PNav As NotesDocument ) 
	On Error GoTo GererErreur
	
	Dim v_contactID As String
	Dim v_contactOpportunity As String
	
	v_contactOpportunity = xVar(pnd_PNav, "Prop_NoContactSF", "")

	ForAll contact In p_contacts
		If v_contactID = "" Then			
			v_contactID = 	contact.Contenu("Id")	
		Else
			If v_contactID =  v_contactOpportunity Then					
				v_contactID =  contact.Contenu("Id")	
				Exit ForAll	
			End If
		End If
		
		
	End ForAll
	
	If v_contactID &lt;&gt; "" Then
		
		pnd_PNav.Cont_Nom = p_contacts(v_contactID).Contenu("Name")
		pnd_PNav.Cont_Titre = p_contacts(v_contactID).Contenu("Salutation")
		pnd_PNav.Cont_Fonction = p_contacts(v_contactID).Contenu("Title")
		pnd_PNav.Cont_FonctionFR = p_contacts(v_contactID).Contenu("Title")
		pnd_PNav.Cont_FonctionEN = p_contacts(v_contactID).Contenu("Title")
		pnd_PNav.Cont_Telephone = p_contacts(v_contactID).Contenu("Phone")
		pnd_PNav.Cont_Cellulaire = p_contacts(v_contactID).Contenu("MobilePhone")	
		pnd_PNav.Cont_Courriel = p_contacts(v_contactID).Contenu("Email")	
		
	End If	
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_hsSuivant"><lotusscript>Sub FPNav_hsSuivant
