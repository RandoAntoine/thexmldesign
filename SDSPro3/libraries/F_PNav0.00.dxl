</lotusscript></code><code event="declarations"><lotusscript>' Déclarations globales
' ---------------------
Dim g_NoRep_FPNav As String
Dim g_LongueurRT_FPNav As Long
Dim g_TexteRT_FPNav As String
Dim gcl_SessionSLSf_FSFPP As SLSf_clSession
Dim g_Resultat_FSFPP As Integer
'Dim g_AfficherErreurs_FPNav As Variant

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_FPNav = "SL"
Const gc_Element_FPNav = "F_PNav0.00"


</lotusscript></code><code event="FPNav_DocumentValide"><lotusscript>Function FPNav_DocumentValide(p_AfficherErreur As Boolean) As Boolean
	On Error GoTo GererErreur
	
	Dim s As String
	Dim v_TypeProposition As String
	
	FPNav_DocumentValide = False
	
	If xVar(gnd_SDSPM, "Prop_TypeProposition", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 190, "", Lcase(xGDK_xMessage("SDSPP", 7, "", ""))), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoTop
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Prop_DescProposition", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 23, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_DescProposition")
		End If
		Exit Function
	End If
	
	v_TypeProposition = xVar(gnd_SDSPM, "Prop_TypeProposition", "")
	If xVar(gnd_SDSPM, "Prop_NoRepresentant", "") = "" And (v_TypeProposition = "0" Or v_TypeProposition = "1") Then
'	If xVar(gnd_SDSPM, "Prop_NoRepresentant", "") = "" And xVar(gnd_SDSPM, "Prop_Origine", "") &lt;&gt; "SICl" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 192, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GoToField("Prop_NoRepresentant")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") = "" Then
		If xVar(gnd_SDSPM, "Prop_ClientNom", "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 193, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
				Call gnuid_SDSPN.GotoField("Prop_ClientNom")
			End If
			Exit Function
		End If
	End If
	If xVar(gnd_SDSPM, "Prop_Langue", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 200, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_Langue")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Prop_ClientAdresse1", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 095, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_ClientAdresse1")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Prop_ClientVille", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 194, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_ClientVille")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Prop_ClientPays", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 19, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_ClientPays")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Prop_ClientProvince", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 21, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_ClientProvince")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Prop_ClientCodePostal", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 196, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_ClientCodePostal")
		End If
		Exit Function
	End If
	
%REM Requ 38157 - Ne pas afficher le titre. Garder le code
	If xVar(gnd_SDSPM, "Prop_ContactTitre", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 190, "", Lcase(xGDK_xMessage("SDSPP", 8, "", ""))), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_ContactTitre")
		End If
		Exit Function
	End If
	%END REM
	
	If xVar(gnd_SDSPM, "Prop_ContactNom", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 84, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_ContactNom")
		End If
		Exit Function
	End If

	If xVar(gnd_SDSPM, "Prop_Origine", "") &lt;&gt; "SF" Then ' Requ 60545
		If xVarElem(gnd_SDSPM, "Prop_ContactFonction", 0,"") = "" Then
			If p_AfficherErreur Then
				MessageBox xGDK_xMessage("SI", 169, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
				Call gnuid_SDSPN.GotoField("Prop_ContactFonction")
			End If
			Exit Function
		End If
	End If
	
	If xVar(gnd_SDSPM, "Prop_ContactCourriel", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 197, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_ContactCourriel")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Prop_Devise", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 17, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_Devise")
		End If
		Exit Function
	End If
	
	%REM
	' Nouvelle proposition
	If xVar(gnd_SDSPM, "Prop_NoProposition", "") = "" Then
		
		If xVar(gnd_SDSPM, "Prop_TypeProposition", "") &lt;&gt; "2" Then
			
			If Not(xVar(gnd_SDSPM, "Prop_TypeProposition", "") = "1" And xVar(gnd_SDSPM, "Prop_ClientSDSWIN", "") &lt;&gt; "" And _
			xVar(gnd_SDSPM, "Prop_ClientMerlin", "") &lt;&gt; "") Then
				
				If xVar(gnd_SDSPM, "Prop_SitePrincipal", "") = "" Then
					If p_AfficherErreur Then
						
						If xVar(gnd_SDSPM, "Prop_ClientSDSWIN", "") &lt;&gt; "" Or _
						xVar(gnd_SDSPM, "Prop_ClientMerlin", "") &lt;&gt; "" Then
							Messagebox xGDK_xMessage("SDSPP", 90, "", _
							xVar(gnd_SDSPM, "Prop_ClientNomInterne", xVar(gnd_SDSPM, "Prop_ClientNom",""))), 16, xGDK_xMessage("SI", 0, "", "")
						Else
							Messagebox xGDK_xMessage("SDSPP", 80, "", _
							xVar(gnd_SDSPM, "Prop_ClientNomInterne", xVar(gnd_SDSPM, "Prop_ClientNom",""))), 16, xGDK_xMessage("SI", 0, "", "")
						End If
						
						Call gnuid_SDSPN.GotoField("Prop_SitePrincipal")
					End If
					Exit Function
				End If
				
				
			End If
			
			
		End If
		
	End If
	%END REM
	
	If xVar(gnd_SDSPM, "PNav_PlanRequis", 0) = 1 Then
		s = xVar(gnd_SDSPM, "PNav_PlanPowerPoint", "")
		If s = "" Then
			If p_AfficherErreur Then
				' 10 = Le plan PowerPoint est obligatoire
				Messagebox xGDK_xMessage("SI", 190, "", xGDK_xMessage("SDSPP", 10, "", "")), 16, xGDK_xMessage("SI", 0, "", "")
			End If
			Exit Function
		End If
		
		If s &lt;&gt; "" Then
			If Lcase(Right(s, 4)) &lt;&gt; ".ppt" And Lcase(Right(s, 5)) &lt;&gt; ".pptx"Then
				If p_AfficherErreur Then
					' 11 - Le fichier n'est pas un document PowerPoint
					Messagebox xGDK_xMessage("SDSPP", 11, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
					Call gnuid_SDSPN.GotoField("PNav_PlanPowerPoint")
				End If
				Exit Function
			End If
		End If
		
		If Dir$(s) = "" Then
			If p_AfficherErreur Then
				' 199 - Fichier inexistant
				Messagebox xGDK_xMessage("SI", 199, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
				Call gnuid_SDSPN.GotoField("PNav_PlanPowerPoint")
			End If
			Exit Function
		End If
	End If
	
	FPNav_DocumentValide = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_majContactKLSF"><lotusscript>Sub FPNav_majContactKLSF( p_contactID As String, p_contacts As Variant, pnd_PNav As NotesDocument ) 
	
	Dim a_Fonctions As Variant
	Dim v_Maj As Boolean
	Dim v_Pos As Variant
	Dim i As Integer
	
	Dim nd_Tabl_FR_SICoSf As NotesDocument
	Dim nd_Tabl_EN_SICoSf As NotesDocument
	Dim a_Tabl_Valeurs_SICoSf As Variant
	Dim a_Tabl_DescFR_SICoSf As Variant
	Dim a_Tabl_DescEN_SICoSf As Variant
	Dim a_Tabl_Tri_SICoSf As Variant
	
	On Error GoTo GererErreur	
	
	Set nd_Tabl_FR_SICoSf = xGDK_xndTabl("Cont_FonctionsSDSFR", True)
	Set nd_Tabl_EN_SICoSf = xGDK_xndTabl("Cont_FonctionsSDSEN", True)
	a_Tabl_Valeurs_SICoSf = xVarArray(nd_Tabl_FR_SICoSf, "Tabl_Valeurs")
	a_Tabl_DescFR_SICoSf = xVarArray(nd_Tabl_FR_SICoSf, "Tabl_Descriptions")
	a_Tabl_DescEN_SICoSf = xVarArray(nd_Tabl_EN_SICoSf, "Tabl_Descriptions")
	a_Tabl_Tri_SICoSf = xVarArray(nd_Tabl_FR_SICoSf, "Tabl_Complement3")	
	
	If p_contactID &lt;&gt; "" Then
		pnd_PNav.Prop_NoContactSF = p_contacts(p_contactID).Contenu("Id")
		pnd_PNav.Prop_ContactNom = p_contacts(p_contactID).Contenu("Name")
		
		a_Fonctions = Split(p_contacts(p_contactID).Contenu("SERTI_Role__c"), ";")		
		v_Maj = SIIx_MajItem(pnd_PNav, "Prop_ContactFonction", a_Fonctions, False) Or v_Maj
		If a_Fonctions(0) &lt;&gt; "" Then
			ReDim a_Fonctions_DescFR(UBound(a_Fonctions)) As String
			ReDim a_Fonctions_DescEN(UBound(a_Fonctions)) As String
			For i = LBound(a_Fonctions) To UBound(a_Fonctions)
				v_Pos = ArrayGetIndex(a_Tabl_Valeurs_SICoSf, a_Fonctions(i))
				If IsNull(v_Pos) Then
					a_Fonctions_DescFR(i) = "?"
					a_Fonctions_DescEN(i) = "?"
				Else
					a_Fonctions_DescFR(i) = a_Tabl_DescFR_SICoSf(v_Pos)
					a_Fonctions_DescEN(i) = a_Tabl_DescEN_SICoSf(v_Pos)
				End If
			Next
			v_Maj = SIIx_MajItem(pnd_PNav, "Prop_ContactFonctionFR", a_Fonctions_DescFR, False) Or v_Maj
			v_Maj = SIIx_MajItem(pnd_PNav, "Prop_ContactFonctionEN", a_Fonctions_DescEN, False) Or v_Maj
		Else
			v_Maj = SIIx_MajItem(pnd_PNav, "Prop_ContactFonctionFR", "", False) Or v_Maj
			v_Maj = SIIx_MajItem(pnd_PNav, "Prop_ContactFonctionEN", "", False) Or v_Maj
		End If
		
		pnd_PNav.Prop_ContactTitre = p_contacts(p_contactID).Contenu("Salutation")
		pnd_PNav.Prop_ContactTelephone = p_contacts(p_contactID).Contenu("Phone")
		pnd_PNav.Prop_ContactCellulaire = p_contacts(p_contactID).Contenu("MobilePhone")			
		pnd_PNav.Prop_ContactCourriel = p_contacts(p_contactID).Contenu("Email")		
		
		pnd_PNav.PNav_MajContact = 0 			'?? ****
		pnd_PNav.PNav_MajNomContact = 0	'?? ****
	End If	
	
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_hsAnnuler"><lotusscript>Sub FPNav_hsAnnuler
	On Error GoTo GererErreur
	
	gnd_SDSPM.SaveOptions = "0"
	Call gnuid_SDSPN.Close
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_QuerySave"><lotusscript>Sub FPNav_QuerySave(pnuid_Source As Notesuidocument, p_Continue As Variant)
	On Error Goto GererErreur
	
	' Sauvegarder l'étape courante
	p_Continue = FPNav_SauvegarderDocument(g_AfficherErreurs_FPNav)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_MajInfoSiteClient"><lotusscript>Sub FPNav_MajInfoSiteClient(p_Origine As String, pnd_PNav As NotesDocument)
	On Error Goto GererErreur
	
	Dim nd_Proj As NotesDocument
	Dim nd_Clie As NotesDocument
	Dim nd_Site As NotesDocument
	Dim nv_Site21 As NotesView
	
	Dim v_CleClient As String
	Dim v_MajSite As Boolean
	Dim v_MajSite_ClientNomInterne As Boolean
	
	' Initialisations
	
	v_MajSite = False
	
	If p_Origine = "SF" Then
		' Aller chercher l'info dans Salesforce
'		nd_Site.Site_ClientNoFmt= "XX"		'***************************************************
'		nd_Site.Site_ClientNomInterne = "XX"		'***************************************************
		Exit Sub
	End If
	
	Set nd_Proj = xPJ_xndProj(p_Origine, xVar(pnd_PNav, "Prop_NoProjet", ""), True)
	If Not nd_Proj Is Nothing Then
		Set nd_Clie = xPJ_xndClie(p_Origine, xVar(nd_Proj, "Clie_NoClient", ""), True)
		v_CleClient = xVar(nd_Clie, "CleClient", "")
	End If
	
	' Trouver le site qui est le même que le client
	Call xnd("", xVar(gnd_Prop_SDSPM, "Prop_NoProposition", ""), False, gndb_SDSPM, "V_Site21", nv_Site21, nd_Site)
	If xVar(nd_Site, "Site_OrigineCle", "") = v_CleClient Then
		v_MajSite = True
	End If
	
	' Maj adresse site client
	If Not nd_Site Is Nothing And v_MajSite Then
		
		If p_Origine = "SICl" Then
			
			If xVar(pnd_PNav, "PNav_MajNomClient ", "") = 1 Then
				nd_Site.Site_ClientNoFmt= xVar(nd_Clie, "Clie_ClientNoFmt", "")
				v_MajSite_ClientNomInterne = SDSPM_MajItem(nd_Site, "Site_ClientNomInterne", xVar(nd_Clie, "Clie_ClientNomInterne", ""))
				nd_Site.Site_ClientNom = xVar(nd_Clie, "Clie_ClientNomEntreprise", "")
			End If
		Else
			If xVar(pnd_PNav, "PNav_MajNomClient ", "") = 1 Then
				
				nd_Site.Site_ClientNoFmt= xVar(nd_Clie, "Clie_NoClientFmt", "")				
				
				If xVar(nd_Clie, "Clie_NoClientFmt", "") &lt;&gt; "" Then
					nd_Site.Site_ClientNomInterne = xVar(nd_Clie, "Clie_ClientNomInterne", "")
				Else
					nd_Site.Site_ClientNomInterne = xVar(nd_Clie, "Clie_Nom", "")
				End If
				
				
				
				
			End If
			
		End If
		
		If xVar(pnd_PNav, "PNav_MajAdresse", "") = 1 Then
			Call FPNav_MajAdresseSiteClient(nd_Clie, nd_Site, p_Origine)
		End If
		
		Call nd_Site.Save(True, False)
		
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Prop_NoProposition", ""), False)
	Exit Sub
	
End Sub

</lotusscript></code><code event="FPNav_acGenererCommande"><lotusscript>Sub FPNav_acGenererCommande
	On Error GoTo GererErreur
	
	Call SDSPUI_acGenererCommande(gnd_Prop_SDSPM)
	
	Call gnuid_SDSPM.Refreshhideformulas
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsMajContactClient"><lotusscript>Sub FPNav_hsMajContactClient
	On Error GoTo GererErreur
	
	If Not FPNav_MajContactClient Then
		Exit Sub
	End If
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPM.Refresh
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
	
End Sub



</lotusscript></code><code event="FPNav_InitialiserContactClient"><lotusscript>Sub FPNav_InitialiserContactClient(pnd_PNav As NotesDocument, p_Cache As Boolean)
	On Error GoTo GererErreur
	
	Dim nd_ContactPJ As NotesDocument	
	Dim v_MajContact As Integer
	Dim v_MajNomContact As Integer
	Dim v_Origine As String
	Dim v_NoContact As String
	Dim v_NoOpportunite As String
	Dim v_NoClientFmt As String
	
	v_Origine = xVar(pnd_PNav, "Prop_Origine", "")
	If v_Origine = "SF" And xVarProf("Prof_DesactiverSalesforceAPI", "") = "1" Then
		Exit Sub
	End If
	
	v_MajContact = 0
	v_MajNomContact = 0
	
	v_NoContact = xVar(pnd_PNav, "Prop_NoContact", xVar(pnd_PNav, "Prop_NoContactSF", ""))
	If v_NoContact = "" Then
		Exit Sub
	End If
	
	If v_Origine = "SF" Then
		v_NoOpportunite = xVar(pnd_PNav, "Prop_NoOpportuniteSF" , "")
		v_NoClientFmt = xVar(pnd_PNav, "Prop_ClientNoFmt" , "")
		
		' Extraire l'opportunité de Salesforce
		g_Resultat_FSFPP = FPNav_ExtraireOpportunite(v_NoOpportunite, v_NoClientFmt)
		If g_Resultat_FSFPP &lt; 0 Then
			Exit Sub
		Else
			
			' Extraire les contacts
			Call gcl_SessionSLSf_FSFPP.Objects("Account").ExtraireEnfants("Contacts", "")
			
			If gcl_SessionSLSf_FSFPP.Objects("Account").NbEnfants("Contacts") &gt; 0 Then
				Call FPNav_ExtraireSignataire( gcl_SessionSLSf_FSFPP.Objects("Account").Enfants("Contacts") , pnd_PNav  ) 			
			End If		
			
		End If		
	Else
		
		If v_Origine &lt;&gt; "SICl" Then
			Set nd_ContactPJ = xPJ_xndCont(v_Origine, v_NoContact, False)

		Else
			If pnd_PNav.Parentdatabase.Server &lt;&gt; "" Then
				Select Case xSICl_xVarClie(xVar(pnd_PNav, "Prop_ClientNoFmt", ""), "Clie_ClientCategorie", "", True)
				Case "60"
					v_Origine = "PJSDS"
				Case "62"
					v_Origine = "PJUSA"
				Case Else
					v_Origine = "PJDIV"
			End Select
				
				Set nd_ContactPJ = xPJ_xndCont(v_Origine, v_NoContact, False)
				
			Else
				Exit Sub
			End If
			
		End If
		
		If nd_ContactPJ Is Nothing Then
			Exit Sub
		End If
		
		pnd_PNav.Cont_Nom = xVar(nd_ContactPJ, "Cont_Contact", "")
		pnd_PNav.Cont_Titre = xVar(nd_ContactPJ, "Cont_Titre", "")
		pnd_PNav.Cont_Fonction = xVar(nd_ContactPJ, "Cont_Fonction", "")
		pnd_PNav.Cont_FonctionFR = xVar(nd_ContactPJ, "Cont_FonctionFR", "")
		pnd_PNav.Cont_FonctionEN = xVar(nd_ContactPJ, "Cont_FonctionEN", "")
		pnd_PNav.Cont_Telephone = xVar(nd_ContactPJ, "Cont_TelephoneFmt", "")
		pnd_PNav.Cont_Cellulaire = xVar(nd_ContactPJ, "Cont_Cellulaire", "")
		pnd_PNav.Cont_Courriel = xVar(nd_ContactPJ, "Cont_Courriel", "")
	End If
	
	If (xVar(pnd_PNav, "Cont_Nom", "") = "" And xVar(pnd_PNav, "Prop_ContactNom", "") &lt;&gt; xVar(pnd_PNav, "Cont_Nom", "")) Then
		v_MajNomContact = 1
	End If
	
	' Validations
	If xVar(pnd_PNav, "Prop_ContactNom", "") &lt;&gt; xVar(pnd_PNav, "Cont_Nom", "") _
	Or xVarImplode(pnd_PNav, "Prop_ContactFonction", ";") &lt;&gt; xVarImplode(pnd_PNav, "Cont_Fonction", ";") _
	Or xVarImplode(pnd_PNav, "Prop_ContactFonction" &amp; xLangue, ";") &lt;&gt; xVarImplode(pnd_PNav, "Cont_Fonction"  &amp; xLangue, ";") _
	Or xVar(pnd_PNav, "Prop_ContactTelephone", "") &lt;&gt; xVar(pnd_PNav, "Cont_Telephone", "") _
	Or xVar(pnd_PNav, "Prop_ContactCellulaire", "") &lt;&gt; xVar(pnd_PNav, "Cont_Cellulaire", "") _
	Or xVar(pnd_PNav, "Prop_ContactCourriel", "") &lt;&gt; xVar(pnd_PNav, "Cont_Courriel", "") Then
		v_MajContact = 1
	End If
	
	pnd_PNav.PNav_MajContact = v_MajContact
	pnd_PNav.PNav_MajNomContact = v_MajNomContact
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_SelectionnerContact_PJ_GCli"><lotusscript>Sub FPNav_SelectionnerContact_PJ_GCli (p_Origine As String)
	' ---------------------------------------------------------------------------------
	' Le script sélectionne le contact dans Projeto, même si la proposition a été créée
	' dans SI Clients
	' ---------------------------------------------------------------------------------
	
	On Error GoTo GererErreur
	
	Dim nd_Cont As NotesDocument
	Dim nd_Clie As NotesDocument
	
	Dim v_Origine As String	
	Dim v_CleClient As String
	Dim v_ClientNoFmt As String	
	Dim v_NomGroupeClient As String

	If p_Origine = "SF" Then
		Exit Sub
	End If
	
	' Initialisations
	If p_Origine &lt;&gt; "SICl" Then
		v_Origine = p_Origine
	Else
		Select Case xSICl_xVarClie(xVar(gnd_SDSPM, "Prop_ClientNoFmt", ""), "Clie_ClientCategorie", "", True)
		Case "60"
			v_Origine = "PJSDS"
		Case "62"
			v_Origine = "PJUSA"
		Case Else
			v_Origine = "PJDIV"
	End Select
	End If

	Call xPJ_Initialisations(v_Origine)
	
	v_ClientNoFmt = xVar(gnd_SDSPM, "Prop_ClientNoFmt", "")	
	
	If p_Origine &lt;&gt; "SICl" Then
		
		
		Set nd_Clie = FPNav_ndClient_PJ(p_Origine)	
		
		If nd_Clie Is Nothing Then
			' 4 - Le document de référence (client ou projet) est introuvable.
			'MessageBox xGDK_xMessage("SDSPP", 4, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Sub
		End If
		
		v_CleClient = xvar (nd_Clie, "CleClient", "") 
		v_NomGroupeClient = xVar(nd_Clie, "Clie_NomGroupeClient", "")			
		Set nd_Cont = SIPJ_ndSelectionnerContact_Onglets (v_Origine, v_CleClient, v_NomGroupeClient) 'Req# 55273
		
		
	Else ' Si la proposition a été créée dans SI Clients, sélectionner le contact dans Projeto
		
		Set nd_Clie = xPJ_xndClieSI (v_Origine, v_ClientNoFmt, True) ' Cherche le client dans V_Clie3 de Projeto
		
		If nd_Clie Is Nothing Then
			' 4 - Le document de référence (client ou projet) est introuvable.
			MessageBox xGDK_xMessage("SDSPP", 4, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Sub
		End If 
		
		v_CleClient = xvar (nd_Clie, "CleClient", "") 				
		v_NomGroupeClient = xVar(nd_Clie, "Clie_NomGroupeClient", "")
		Set nd_Cont = SIPJ_ndSelectionnerContact_Onglets (v_Origine, v_CleClient, v_NomGroupeClient) 'Req# 55273			
		
	End If
	
	
	If Not (nd_Cont Is Nothing) Then
		
		' Valider le contact sélectionné
		'Permettre de sélectionner un contact non signataire lorsque l'utilisateur a le rôle [TousSignataires] ou [Admin] ?
		If Not FPNav_DocumentValide_Contact(nd_Cont, v_Origine) Then
			Exit Sub
		End If
		
		gnd_SDSPM.Prop_NoContact = xVar(nd_Cont, "Cont_NoContact", "")
		gnd_SDSPM.Prop_ContactNom = xVar(nd_Cont, "Cont_Contact", "")
		gnd_SDSPM.Prop_ContactTitre = xVar(nd_Cont, "Cont_Titre", "")
		gnd_SDSPM.Prop_ContactFonction = xVar(nd_Cont, "Cont_Fonction", "")
		gnd_SDSPM.Prop_ContactFonctionFR = xVar(nd_Cont, "Cont_FonctionFR", "")
		gnd_SDSPM.Prop_ContactFonctionEN = xVar(nd_Cont, "Cont_FonctionEN", "")
		gnd_SDSPM.Prop_ContactTelephone = xVar(nd_Cont, "Cont_TelephoneFmt", "")
		gnd_SDSPM.Prop_ContactCellulaire = xVar(nd_Cont, "Cont_Cellulaire", "")
		gnd_SDSPM.Prop_ContactCourriel = xVar(nd_Cont, "Cont_Courriel", "")
		
		gnd_SDSPM.Cont_Nom = xVar(nd_Cont, "Cont_Contact", "")
		gnd_SDSPM.Cont_Titre = xVar(nd_Cont, "Cont_Titre", "")
		gnd_SDSPM.Cont_Fonction = xVar(nd_Cont, "Cont_Fonction", "")
		gnd_SDSPM.Cont_FonctionFR = xVar(nd_Cont, "Cont_FonctionFR", "")
		gnd_SDSPM.Cont_FonctionEN = xVar(nd_Cont, "Cont_FonctionEN", "")
		gnd_SDSPM.Cont_Telephone = xVar(nd_Cont, "Cont_TelephoneFmt", "") 'xVar(nd_Clie, "Clie_Telephone", xVar(nd_Clie, "Clie_Telephone2", "")))
		gnd_SDSPM.Cont_Cellulaire = xVar(nd_Cont, "Cont_Cellulaire", "")
		gnd_SDSPM.Cont_Courriel = xVar(nd_Cont, "Cont_Courriel", "")
		
		gnd_SDSPM.PNav_MajContact = 0
		gnd_SDSPM.PNav_MajNomContact = 0
		
		Call gnuid_SDSPM.Refresh
		
	End If
	
	Call gns_SIPJ.SetEnvironmentVar ("PJ_ContactUNID", "")  'Req# 55273
	
	Exit Sub
	
GererErreur:
	'Reset gns_SIPJ.SetEnvironmentVar ("PJ_ContactUNID", "0")
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_InitialiserContactCCClient_SF"><lotusscript>Sub FPNav_InitialiserContactCCClient_SF(pnd_PNav As NotesDocument)
	On Error GoTo GererErreur
	
	
	Dim a_NomClientContacts As Variant
	Dim a_NoClientContacts As Variant
	Dim a_NoContacts As Variant
	Dim a_NomContacts As Variant
	Dim a_CourrielContacts As Variant	
	Dim i As Integer
	Dim v_NoContact As String

	Dim v_MajContactCC As Integer
	Dim v_AccountSF As SLSf_clObject
	Dim v_ListContacts As Variant
	Dim v_Resultat As Integer
	Dim v_NoClientFmt As String
	Dim v_NoOpportuniteSF As String
	
	If xVarProf("Prof_DesactiverSalesforceAPI", "") = "1" Then
		Exit Sub
	End If
	
	v_NoClientFmt = xVar(gnd_SDSPM, "Prop_ClientNoFmt" , "")
	v_NoOpportuniteSF = xVar(gnd_SDSPM, "Prop_NoOpportuniteSF" , "")
	
	' Extraire l'opportunité de Salesforce
	g_Resultat_FSFPP = FPNav_ExtraireOpportunite(v_NoOpportuniteSF, v_NoClientFmt)

	If g_Resultat_FSFPP &lt; 0 Then
		Exit Sub
	Else
		If Not gcl_SessionSLSf_FSFPP.Objects("Account") Is Nothing Then				
			Set v_AccountSF = gcl_SessionSLSf_FSFPP.Objects("Account")
		Else
			Exit Sub
		End if
		
	End If
	
	Call v_AccountSF.ExtraireEnfants("Contacts", "")
	v_Resultat = v_AccountSF.NbEnfants("Contacts")
	If v_Resultat &gt; 0 Then			
		v_ListContacts = v_AccountSF.Enfants("Contacts")
		
		' Initialisations
		v_MajContactCC = 0
		
		a_NoContacts = xVarArray(pnd_PNav, "Prop_NoContactsCCDsg")	
		
		If Not IsArray(a_NoContacts) Then
			Exit Sub
		End If
		
		ReDim a_NomClientContacts(UBound(a_NoContacts))
		ReDim a_NoClientContacts(UBound(a_NoContacts))
		ReDim a_NomContacts(UBound(a_NoContacts))
		ReDim a_CourrielContacts(UBound(a_NoContacts))
		
		For i = 0 To UBound(a_NoContacts)
			
			v_NoContact = a_NoContacts(i)
			If IsElement(v_ListContacts(v_NoContact)) Then
				a_NomClientContacts(i) = v_AccountSF.ExtraireValeur("Name", "- - -")
				a_NoClientContacts(i) = v_AccountSF.ExtraireValeur("Id", "- - -")
				a_NomContacts(i) = v_ListContacts(v_NoContact).ExtraireValeur("Name", "- - -")
				a_CourrielContacts(i) = v_ListContacts(v_NoContact).ExtraireValeur("Email","- - -")										
			End If
		Next
		
		pnd_PNav.Cont_NomClientContactsCCDsg = a_NomClientContacts
		pnd_PNav.Cont_NoClientContactsCCDsg = a_NoClientContacts
		pnd_PNav.Cont_ContactNomsCCDsg = a_NomContacts
		pnd_PNav.Cont_ContactCourrielsCCDsg = a_CourrielContacts
		
		If xVarImplode(pnd_PNav, "Prop_NoClientContactsCCDsg", ";") &lt;&gt; xVarImplode(pnd_PNav, "Cont_NoClientContactsCCDsg", ";") _
		Or xVarImplode(pnd_PNav, "Prop_NomClientContactsCCDsg", ";") &lt;&gt; xVarImplode(pnd_PNav, "Cont_NomClientContactsCCDsg", ";") _
		Or xVarImplode(pnd_PNav, "Prop_ContactNomsCCDsg", ";") &lt;&gt; xVarImplode(pnd_PNav, "Cont_ContactNomsCCDsg", ";") _
		Or xVarImplode(pnd_PNav, "Prop_ContactCourrielsCCDsg", ";") &lt;&gt; xVarImplode(pnd_PNav, "Cont_ContactCourrielsCCDsg", ";") Then
			v_MajContactCC = 1
		End If
	End if
	
	pnd_PNav.PNav_MajContactCC = v_MajContactCC
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_hsSelectionnerContactCCManuel"><lotusscript>Sub FPNav_hsSelectionnerContactCCManuel(p_TypeSelection As String)
	On Error GoTo GererErreur
	
	Dim a_PropContactNomsManCC As Variant
	Dim a_PropContactCourrielsManCC As Variant
	Dim a_ClesContact As Variant
	Dim a As Variant	
	Dim nd_DB As NotesDocument
	Dim v_NomContact As String
	Dim v_CourrielContact As String
	Dim i As Integer	
	
	' Initialisations
	Call SDSPM_Initialisations
	
	
	If p_TypeSelection = "DB" Then
		Set nd_DB = New NotesDocument(gndb_SDSPM)
		
		If Not gnuiws_SDSPM.DialogBox("DB_CCour", True, True, False, False, False, False, _
		xGDK_xMessage("SDSPP", 175, "", ""), nd_DB, True, False, False) Then
			Exit sub
		End If
		
		v_NomContact = xVar(nd_DB, "DB_Nom", "")	
		v_CourrielContact = xVar(nd_DB, "DB_Courriel", "")
		
	%REM
					
		'Validation du Nom Contact	#57932		
		a = Evaluate(|@Explode("| &amp; v_NomContact &amp; |"; " ")|)
		
		If UBound(a) = 0 Then
			'Invalid Contact name / Nom du contact est invalide
			MessageBox xGDK_xMessage("SDSPP", 195 ,xLangue, v_NomContact), 16, xGDK_xMessage("SI", 1, xLangue, "")
			
			Exit Sub
		End if 	
	%END REM
	End if
	
	
	a_PropContactNomsManCC = xVarArray(gnd_SDSPM,"Prop_ContactNomsManCCDsg")
	a_PropContactCourrielsManCC = xVarArray(gnd_SDSPM,"Prop_ContactCourrielsManCCDsg")
	
	If IsArray(a_PropContactNomsManCC) Then
		
		If IsNull(ArrayGetIndex(a_PropContactNomsManCC, v_NomContact)) Then				
			a_PropContactNomsManCC = ArrayAppend(a_PropContactNomsManCC, v_NomContact)
			a_PropContactCourrielsManCC = ArrayAppend(a_PropContactCourrielsManCC, v_CourrielContact)			
		End If
		
		ReDim a_ClesContact(UBound(a_PropContactNomsManCC))
		
		'a_PropContactManCC = FullTrim(ArrayUnique(ArrayAppend(a_PropContactManCC, v_Courriel)))
	Else
		ReDim a_PropContactNomsManCC(0)
		ReDim a_PropContactCourrielsManCC(0)
		
		ReDim a_ClesContact(0)
		
		a_PropContactNomsManCC(0) = v_NomContact
		a_PropContactCourrielsManCC(0)= v_CourrielContact
	End If
	
	For i = 0 To UBound(a_PropContactNomsManCC)
		a_ClesContact(i) = a_PropContactNomsManCC(i) &amp; "~" &amp; a_PropContactCourrielsManCC(i)
	Next
	
	Call TrierArray(a_ClesContact)
	
	For i = 0 To UBound(a_ClesContact)
		a_PropContactNomsManCC(i) = StrToken(a_ClesContact(i), "~",1)
		a_PropContactCourrielsManCC(i) = StrToken(a_ClesContact(i), "~",2)			
	Next
	
	Call gnd_SDSPM.ReplaceItemValue("Prop_ContactNomsManCCDsg", a_PropContactNomsManCC)
	Call gnd_SDSPM.ReplaceItemValue("Prop_ContactCourrielsManCCDsg", a_PropContactCourrielsManCC)
	
	'Call gnd_SDSPM.ReplaceItemValue("Prop_ContactCourrielsManCCDsg", a_PropContactManCC)		
	Call gnuid_SDSPM.Refresh
	
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acImprimerPropositionSommaire"><lotusscript>Sub FPNav_acImprimerPropositionSommaire
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	g_AfficherErreurs_FPNav = True
	On Error 4411 Goto FinSub
	Call gnuid_SDSPM.Save
	
	Call SDSPM_acImprimerPropositionSommaire
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsMajNoClient"><lotusscript>Sub FPNav_hsMajNoClient
	On Error GoTo GererErreur
	
	Dim nd_CliePJ As NotesDocument
	Dim nd_SICl As NotesDocument
	
	Dim v_NoProposition As String
	Dim v_UserName As String
	Dim v_NoClientFmt As String
	
	Dim ws_Proposition As Cl_proposition
	
	' Initialisations
	v_NoProposition = xVar(gnd_SDSPM, "Prop_NoProposition", "")
	v_UserName = gns_SDSPM.UserName
	
	' Sélectionner un client
	' ----------------------
	Set nd_CliePJ = SIPJ_ndSelectionnerClient(xVar(gnd_Prop_SDSPM, "Prop_Origine", ""), xGDK_xMessage("SI", 79, "",""), True)
	
	If Not (nd_CliePJ Is Nothing) Then
		
		v_NoClientFmt = xVar(nd_CliePJ,"Clie_NoClientFmt","")
		Set nd_SICl = xSICl_xndClie(v_NoClientFmt, False)
		
		If Not nd_SICl Is Nothing Then
			
			Set ws_Proposition = New Cl_proposition
			If ws_Proposition.Majnoclientpropositionsdsp3(v_NoProposition, v_NoClientFmt, v_UserName) Then
				gnd_SDSPM.SaveOptions = "0"
				Call gnuid_SDSPN.Close
				Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
			End If
			
		End If
		
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_IniTypePropositionDisp"><lotusscript>Sub FPNav_IniTypePropositionDisp(pnd_PNav As NotesDocument)
	On Error GoTo GererErreur
	
	Dim v_NoProjet As String
	Dim nv As NotesView
	Dim nd_Suivant As NotesDocument
	Dim nd As NotesDocument
	Dim nd_CliePJ As NotesDocument
	Dim v_Ajouter As Boolean
	Dim ni_Disponibilite As NotesItem
	Dim v_TypeProposition As String
	Dim v_Origine As String
	Dim v_DescDefautProposition As String
	Dim v_ClientNoFmt As String
	Dim v_NomGroupeClient As String
	Dim ni_CleTypeProposition As NotesItem
	Dim ni_DescTypeProposition As NotesItem
	Dim ni_DescDefautProposition As NotesItem
	Dim v_TypePropositionSF As String	
	
	v_NoProjet = xVar(pnd_PNav, "Prop_NoProjet", "")			
	v_Origine = xVar(pnd_PNav, "Prop_Origine", "")
	v_TypePropositionSF = xVar(pnd_PNav, "Prop_TypeProposition", "")
	
	Call xSDSBB_Initialisations
	
	Set nv = gndb_xSDSBB.GetView("V_TpPp20")
	Set nd_Suivant = nv.GetFirstDocument
	Do Until nd_Suivant Is Nothing
		Set nd = nd_Suivant
		Set nd_Suivant = nv.GetNextDocument(nd_Suivant)
		v_Ajouter = True
		
		Set ni_Disponibilite = nd.GetFirstItem("TpPp_Disponibilite")
		
		If v_Origine &lt;&gt; "SF" Then
			If ni_Disponibilite.Contains("PJ") And v_NoProjet = "" And xVar(pnd_PNav, "Prop_Origine", "") &lt;&gt; "SICl" Then
				v_Ajouter = False
			End If
		Else
			pnd_PNav.Prop_TypePropositionDescFR = xSDSBB_xVarTpPp(v_TypePropositionSF, "TpPp_DescTypePropositionFR", "", True)
			pnd_PNav.Prop_TypePropositionDescEN = xSDSBB_xVarTpPp(v_TypePropositionSF, "TpPp_DescTypePropositionEN", "", True)
		End If
		
		If v_Ajouter Then
			
			v_TypeProposition = xVar(nd, "TpPp_CleTypeProposition", "")
			v_DescDefautProposition = xSDSBB_xVarTpPp(v_TypeProposition,"TpPp_DescDefautProposition" &amp; xLangue, _
			xVar(pnd_PNav, "Prop_DescProposition", ""), True)
			
			'Remplacer signet "[NomGroupe]"					
			If InStr(v_DescDefautProposition, "[NomGroupe]") &gt; 0 Then	
				
				' Selectionnez le doc de client           
				If v_ClientNoFmt &lt;&gt; "" Then
					Set nd_CliePJ = xPJ_xndClieSI(v_Origine, v_ClientNoFmt, True)	
				End If
				
				If nd_CliePJ Is Nothing Then
					Set nd_CliePJ = xPJ_xndClie(v_Origine, xVar(pnd_PNav, "Prop_ClientCleSitePrinc", ""), True)					
				End If
				
				v_NomGroupeClient = xVar(nd_CliePJ, "Clie_NomGroupeClient", "")
				
				If v_NomGroupeClient &lt;&gt; "" Then
					v_DescDefautProposition = Replace(v_DescDefautProposition, "[NomGroupe]", v_NomGroupeClient)
				Else
					v_DescDefautProposition = xSDSBB_xVarTpPp(v_TypeProposition,"TpPp_DescTypeProposition" &amp; xLangue, _
					"", True)
				End If
				
			End If			
			
			If ni_CleTypeProposition Is Nothing Then
				
				Call pnd_PNav.ReplaceItemValue("TpPp_CleTypeProposition_1", v_TypeProposition)
				Set ni_CleTypeProposition = pnd_PNav.GetFirstItem("TpPp_CleTypeProposition_1")
				Call pnd_PNav.ReplaceItemValue("TpPp_DescTypeProposition_1", _
				xSDSBB_xVarTpPp(v_TypeProposition, "TpPp_DescTypeProposition" &amp; xLangue, "", True))
				Set ni_DescTypeProposition = pnd_PNav.GetFirstItem("TpPp_DescTypeProposition_1")
				
				Call pnd_PNav.ReplaceItemValue("TpPp_DescDefautProposition_1",v_DescDefautProposition)
				Set ni_DescDefautProposition = pnd_PNav.GetFirstItem("TpPp_DescDefautProposition_1")
				
			Else
				Call ni_CleTypeProposition.AppendToTextList(v_TypeProposition)
				Call ni_DescTypeProposition.AppendToTextList(xSDSBB_xVarTpPp(v_TypeProposition, _
				"TpPp_DescTypeProposition" &amp; xLangue, "", True))
				
				Call ni_DescDefautProposition.AppendToTextList(v_DescDefautProposition)
			End If
			
			
		End If
		
	Loop
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acImprimerProposition"><lotusscript>Sub FPNav_acImprimerProposition
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	g_AfficherErreurs_FPNav = True
	On Error 4411 Goto FinSub
	Call gnuid_SDSPM.Save
	
	Call SDSPM_acImprimerProposition
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsRetirerContactCCManuel"><lotusscript>Sub FPNav_hsRetirerContactCCManuel
	On Error GoTo GererErreur
	
	Dim nuiws As New NotesUIWorkspace
	
	Dim a_PropContactNomsManCC As Variant
	Dim a_PropContactCourrielsManCC As Variant
	Dim a_ChoixContacts As Variant
	Dim v_Choix As Variant
	Dim v_PosChoix As Variant
	Dim i As Integer
	
	a_PropContactNomsManCC = xVarArray(gnd_SDSPM,"Prop_ContactNomsManCCDsg")
	a_PropContactCourrielsManCC = xVarArray(gnd_SDSPM,"Prop_ContactCourrielsManCCDsg")
	
	ReDim a_ChoixContacts(UBound(a_PropContactNomsManCC))
	
	For i = 0 To UBound(a_PropContactNomsManCC)
		a_ChoixContacts(i) = a_PropContactNomsManCC(i) &amp; "    " &amp; "    &lt;" &amp; a_PropContactCourrielsManCC(i) &amp; "&gt;"
	Next
	
	' Demander l'utilisateur de choisir le candidat à retirer
	v_Choix = nuiws.Prompt (PROMPT_OKCANCELLIST, xGDK_xMessage("SI", 198, "", ""),xGDK_xMessage("SI", 71, "", ""), "", a_ChoixContacts)
	
	If IsEmpty(v_Choix) Then
		Exit Sub
	End If
	
	v_PosChoix = ArrayGetIndex(a_ChoixContacts, v_Choix)
	
	If Not IsNull(v_PosChoix) Then
		a_PropContactNomsManCC(v_PosChoix) = ""		
		a_PropContactNomsManCC = RetirerArray(a_PropContactNomsManCC, "")
		a_PropContactCourrielsManCC(v_PosChoix)= ""
		a_PropContactCourrielsManCC = RetirerArray(a_PropContactCourrielsManCC, "")				
	End If
	
	Call gnd_SDSPM.ReplaceItemValue("Prop_ContactNomsManCCDsg", a_PropContactNomsManCC)
	Call gnd_SDSPM.ReplaceItemValue("Prop_ContactCourrielsManCCDsg",  a_PropContactCourrielsManCC)	
	
	Call gnuid_SDSPM.Refresh	
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsMajContactCCClient"><lotusscript>Sub FPNav_hsMajContactCCClient
	On Error GoTo GererErreur
	
	If Not FPNav_MajContactCCClient Then
		Exit Sub
	End If
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPM.Refresh
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_SauvegarderDocument"><lotusscript>Function FPNav_SauvegarderDocument(p_ValiderDocument As Variant) As Boolean
	On Error GoTo GererErreur
	
	Dim v_NoOptionCourante As String
	Dim v_NoOptionMax As String
	Dim v_AfficherErreur As Boolean
	Dim v_DocumentValide As Boolean
	Dim v_ClientNoFmt As String
	Dim nd_Clie As NotesDocument
	Dim ndc_Sites As NotesDocumentCollection
	Dim ndc_Prod As NotesDocumentCollection
	Dim nv_Prod20 As NotesView
	Dim v_RepresentantPrec As String
	Dim v_Statut As String
	Dim v_StatutDesc As String
	Dim v_MajSecurite As Boolean
	Dim v_Origine As String
	
	FPNav_SauvegarderDocument = False
	If xVar(gnd_SDSPM, "PNav_EditMode", False) = False Then
		FPNav_SauvegarderDocument = True	' Permet de passer à l'écran suivant
		Exit Function
	End If
	
	' Calculer les champs automatiques
	On Error 4412 GoTo FinSub
	Call gnuid_SDSPN.Refresh
	On Error 4412 GoTo GererErreur
	
	' Valider le document courant
	v_NoOptionCourante = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "0.00")
	v_NoOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionMax", "0.00")
	If p_ValiderDocument = "" Then
		v_DocumentValide = FPNav_DocumentValide(CInt(v_NoOptionCourante &lt; v_NoOptionMax))
	Else
		v_DocumentValide = FPNav_DocumentValide(CInt(p_ValiderDocument))
	End If
	If v_DocumentValide = False Then
		If p_ValiderDocument = True Then
			Call gnuid_SDSPN.Refresh
			Exit Function
		End If
	End If
	
	v_Origine = xVar(gnd_SDSPM, "Prop_Origine", "")
	' Nouvelle proposition
	If xVar(gnd_SDSPM, "Prop_NoProposition", "") = "" Then
		' Sélectionner le client de facturation
		If v_Origine &lt;&gt; "SF" Then 
			If Not FPNav_ndClientOrigine(gnd_SDSPM, nd_Clie, v_Origine, True) Then
				Exit Function
			End If
		End If
		
		' Créer la proposition
		If Not FPNav_CreerProposition(nd_Clie) Then
			Exit Function
		End If
		
		gnd_SDSPM.PNav_Titre = Trim("C" &amp; CStr(xVar(gnd_Prop_SDSPM, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(gnd_Prop_SDSPM, "Prop_ClientNomInterne", xVar(gnd_Prop_SDSPM, "Prop_ClientNom", "")))
		gnd_SDSPM.Titre = Trim(xVar(gnd_SDSPM, "PNav_Titre", "") &amp; " - " &amp; xVar(gnd_SDSPM, "PNav_MenuDesc000", ""))
		
		'Call gnd_Prop_SDSPM.Save (True, False)
		FPNav_SauvegarderDocument = True
		Exit Function
	End If
	
	' Extraire la proposition
	If Not SDSPM_InitProp("") Then
		Exit Function
	End If
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientCleSitePrinc", "") Or FPNav_SauvegarderDocument
	'FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientCleInitial", "") Or FPNav_SauvegarderDocument ' ne change jamais
	
	' Mettre à jour la proposition
	
	gnd_Prop_SDSPM.Description = xVar(gnd_SDSPM, "Prop_ClientNomInterne", "")
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DescProposition", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoEquipe", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomEquipe", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoRepresentant", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomRepresentant", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_IdRepresentant", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoDirecteur", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomDirecteur", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_IdDirecteur", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoDirNational", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomDirNational", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_IdDirNational", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoDirMondial", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomDirMondial", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_IdDirMondial", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_CommissionsRepresentant", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_CommissionsDirecteur", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_CommissionsDirNational", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_CommissionsDirMondial", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DeviseRepresentant", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DeviseDirecteur", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DeviseDirNational", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DeviseDirMondial", "") Or FPNav_SauvegarderDocument
	
	v_MajSecurite = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NePasPartager", "")
	FPNav_SauvegarderDocument = v_MajSecurite Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoOpportuniteSF", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientNoSF", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoContactSF", "") Or FPNav_SauvegarderDocument	
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientNoFmt", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientNom", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomClientModifie", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomClientListe", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientNomInterne", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomInterneListe", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomInterneModifie", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientNomLegal", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomLegalListe", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomLegalModifie", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientAdresse1", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientAdresse2", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientVille", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientProvince", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientPays", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientCodePostal", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientTelephone", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientTelephone2", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientTelecopieur", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_Langue", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientSDSWIN", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientMelin", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoContact", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactNom", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactFonction", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactFonctionFR", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactFonctionEN", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactTitre", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactTelephone", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactCellulaire", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactCourriel", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoContactsCCDsg", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactNomsCCDsg", "") Or FPNav_SauvegarderDocument	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoClientContactsCCDsg", "") Or FPNav_SauvegarderDocument	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactCourrielsCCDsg", "") Or FPNav_SauvegarderDocument	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomClientContactsCCDsg", "") Or FPNav_SauvegarderDocument	
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactNomsManCCDsg", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ContactCourrielsManCCDsg", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoRepresentantCCOSSg", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NomRepresentantCCOSSg", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_CourrielRepresentantCCOSSg", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_OrigineSiegeSocial", "") Or FPNav_SauvegarderDocument	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientNoFmtSiegeSocialSF", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientNoFmtSiegeSocial", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientNom1SiegeSocial", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientNom2SiegeSocial", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_ClientNomIntSiegeSocial", "") Or FPNav_SauvegarderDocument
	
	'FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_TauxContrat", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NbSites", 0) Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_NoSites", "") Or FPNav_SauvegarderDocument
	
	If g_NoRep_FPNav &lt;&gt; xVar(gnd_Prop_SDSPM, "Prop_NoRepresentant", "") Then
		
		' Représentant précédent
		v_RepresentantPrec = xSIRR_xVarRepr(CStr(g_NoRep_FPNav), "Repr_NomRepresentant", "", True)
		
		' Modifier les accès (sécurité)
		' -----------------------------
		Call SDSPP_AssignerSecurite(gnd_Prop_SDSPM, False)
		v_MajSecurite = False
		
		' Mettre à jour l'historique de la proposition
		' --------------------------------------------
		v_Statut = xVar(gnd_SDSPM, "Prop_Statut" , "")
		v_StatutDesc = xDescTabl(v_Statut, "Prop_Statut_" &amp; xSIRR_xVarRepr(xVar(gnd_SDSPM, "Prop_NoRepresentant", ""), "Repr_Langue", "FR", True), True)
		v_RepresentantPrec = xSIRR_xVarRepr(g_NoRep_FPNav, "Repr_NomRepresentant", "", True)
		
		If SIHi_Ajouter(gnd_Prop_SDSPM, v_Statut &amp; "-" &amp; v_StatutDesc, "*Action : " &amp; _
		"Représentant remplaçé  /  Sales rep. replaced (" &amp; v_RepresentantPrec &amp; ")", "", False) Then
			
			' Mettre à jour l'historique de la proposition
			' --------------------------------------------
			Call SIHi_BatirHistorique(gnd_Prop_SDSPM)
			
			g_NoRep_FPNav = xVar(gnd_Prop_SDSPM, "Prop_NoRepresentant", "")
		End If
		
	End If
	
	If xVar(gnd_SDSPM, "Prop_ClientNomLegal", "") &lt;&gt; xVar(gnd_SDSPM, "Clie_NomLegal", "") Then
		gnd_SDSPM.PNav_MajNomClient = 1
	Else
		If xVar(gnd_SDSPM, "Prop_ClientNomLegal", "") = xVar(gnd_SDSPM, "Prop_NomLegalListe", "") Then
			gnd_SDSPM.PNav_MajNomClient = 0
			gnd_SDSPM.Prop_NomLegalModifie = "0"
		End If
	End If
	
	%REM
	If xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") &lt;&gt; "" Then
		gnd_SDSPM.Prop_ClientNomInterne = xVar(gnd_SDSPM, "Clie_ClientNomInterne", "")
	Else
		gnd_SDSPM.Prop_ClientNom = xVar(gnd_SDSPM, "Clie_ClientNom", "")
	End If
	%END REM
	
	If xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") &lt;&gt; "" Then
		REM If xSDSP3_xVarSite(xVarElem(gnd_Prop_SDSPM, "Prop_NoSites", 0 , ""), "Site_ClientNomInterne","", True) &lt;&gt; xVar(gnd_SDSPM, "Clie_ClientNomInterne", "") Then
		If xVar(gnd_SDSPM, "Prop_ClientNomInterne", "") &lt;&gt; xVar(gnd_SDSPM, "Clie_ClientNomInterne", "") Then
			gnd_SDSPM.PNav_MajNomClient = 1
		Else
			If xVar(gnd_SDSPM, "Prop_ClientNomInterne", "") = xVar(gnd_SDSPM, "Prop_NomInterneListe", "") Then
				gnd_SDSPM.PNav_MajNomClient = 0
			End If
		End If
		If xVar(gnd_SDSPM, "Prop_ClientNomInterne", "") = xVar(gnd_SDSPM, "Prop_NomInterneListe", "") Then
			gnd_SDSPM.Prop_NomInterneModifie = "0"
		End If
		
		If xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") &lt;&gt; xVar(gnd_SDSPM, "Clie_NoClientFmt", "") Then
			gnd_SDSPM.PNav_MajNomClient = 1
		Else
			gnd_SDSPM.PNav_MajNomClient = 0
			
		End If
		
	Else
		If xVar(gnd_SDSPM, "Prop_ClientNom", "") &lt;&gt; xVar(gnd_SDSPM, "Clie_ClientNom", "") Then
			gnd_SDSPM.PNav_MajNomClient = 1
		Else
			If xVar(gnd_SDSPM, "Prop_ClientNom", "") = xVar(gnd_SDSPM, "Prop_NomClientListe", "") Then
				gnd_SDSPM.PNav_MajNomClient = 0
				gnd_SDSPM.Prop_NomClientModifie = "0"
			End If
		End If
	End If
	
	If v_MajSecurite Then
		Call SDSPP_AssignerSecurite(gnd_Prop_SDSPM, False)
	End If
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "PNav_MenuOptionMax", "") Or FPNav_SauvegarderDocument
	
	If FPNav_SauvegarderDocument Then
		gnd_Prop_SDSPM.HistoDM = Now
		gnd_Prop_SDSPM.HistoUM = gns_SDSPM.UserName
		Call gnd_Prop_SDSPM.Save(True, False)
	End If
	
	Call gnuid_SDSPM.Refresh
	
	FPNav_SauvegarderDocument = True
	
FinSub:
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function


</lotusscript></code><code event="FPNav_hsSelectionnerContact"><lotusscript>Sub FPNav_hsSelectionnerContact
	On Error GoTo GererErreur
	
	Dim v_Origine As String
	Dim v_ClientNoSF As String
	
	v_Origine = xVar(gnd_SDSPM, "Prop_Origine", "")
	v_ClientNoSF = xVar(gnd_SDSPM, "Prop_ClientNoSF", "")
	'If v_Origine = "SF" And xVarProf("Prof_DesactiverSalesforceAPI", "") &lt;&gt; "1" Then	
	If v_ClientNoSF &lt;&gt; "" And xVarProf("Prof_DesactiverSalesforceAPI", "") &lt;&gt; "1" Then
		Call FPNav_hsSelectionnerContactKLSF
	Else
		Call FPNav_SelectionnerContact_SICo
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_hsNomLegalModifiable"><lotusscript>Function FPNav_hsNomLegalModifiable
	On Error GoTo GererErreur
	
	Call gnd_SDSPM.ReplaceItemValue( "Prop_NomLegalModifie", "1")
	
	Call gnd_SDSPM.ReplaceItemValue( "Prop_NomLegalListe", xVar(gnd_SDSPM, "Prop_ClientNomLegal", ""))
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPM.Refresh
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_hsSelectionnerContactGroupeClient"><lotusscript>Sub FPNav_hsSelectionnerContactGroupeClient
	On Error GoTo GererErreur
	

	Call FPNav_SelectionnerContactGroupeClient_SF()
	
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub



</lotusscript></code><code event="FPNav_PostOpen"><lotusscript>Sub FPNav_PostOpen(pnuid_Source As Notesuidocument)
	On Error Goto GererErreur
	
	Dim nrti As NotesRichTextItem
	
	' Initialisations
	Call SDSPN_Initialisations	' Navigation dans les menus
	Call SDSPM_Initialisations	' Masque
	
	' Calculer la longueur du champ Prop_DescDetaillee (RichText) à l'affichage, et le contenu du texte 
	If gnd_SDSPM.HasItem("Prop_DescDetaillee") Then
		Set nrti = gnd_SDSPM.GetFirstItem("Prop_DescDetaillee")
		g_LongueurRT_FPNav = nrti.Valuelength
		g_TexteRT_FPNav = nrti.text
	Else
		g_LongueurRT_FPNav = 0
		g_TexteRT_FPNav = ""
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsOuvrirBonCommande_x"><lotusscript>Sub FPNav_hsOuvrirBonCommande_x
	On Error GoTo GererErreur
	
	Dim nd_BCom As NotesDocument
	Dim ndc_BCom As NotesDocumentCollection
	Dim nuid As NotesUIDocument
	Dim nv_BCom As NotesView	
	Dim v_Query As String		
	Dim v_Cle As String
	
	'Initialisations
	Call xSIBDC2_Initialisations
	
	v_Cle = xVar(gnd_SDSPM, "Prop_NoProposition", 0)
	
	' Sélectionner le bon de commande
	' -------------------------------	
	Set ndc_BCom = xSIBDC2_xndcBCom(v_Cle)
	
	If ndc_BCom.count = 0 Then			
		Exit Sub
	ElseIf  ndc_BCom.count = 1 Then
		
		Set nd_BCom = ndc_BCom.getfirstDocument
		
	ElseIf ndc_BCom.count &gt; 1 Then
		
		'si count plus que 1 afficher prompt
		Set nv_BCom = gndb_xSIBDC2.GetView("V_BCom20")	
		
		v_Query = |FIELD BCom_OrigineCle CONTAINS "| &amp; v_Cle &amp; |"|
		Set nd_BCom = SISe_ndSelectionnerDocument(v_Query, "", SISe_NOPROMPT, nv_BCom,|BCom_NoBonCommandeFmt + 
	"  /  " + BCom_ClientNoFmt + " - " + @if(BCom_SaisirAdresse = "L";BCom_LivrNom1;BCom_ClientNomInterne)|, xGDK_xMessage("SDSPP", 181, "", ""), "", False)
		' 181: Sélectionnez un bon de commande dans la liste ci-dessous.	End If
	End if
	
	If nd_BCom Is Nothing Then
		Exit Sub
	End If
	
	' Ouvrir le document
	' ------------------
	Set nuid = gnuiws_SDSPN.EditDocument( False , nd_BCom)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsNomInterneNonModifiable"><lotusscript>Function FPNav_hsNomInterneNonModifiable
	On Error GoTo GererErreur
	
	Dim nd_Proj As NotesDocument
	Dim nd_Clie As NotesDocument
	
	Dim v_Origine As String
	
	Call gnd_SDSPM.ReplaceItemValue( "Prop_NomInterneModifie", "0")
	
	v_Origine = xVar(gnd_SDSPM, "Prop_Origine", "")
	If v_Origine = "SF" Then
		Exit Function
	End If
	
	If v_Origine &lt;&gt; "SICl" Then
		Set nd_Proj = xPJ_xndProj(v_Origine, xVar(gnd_SDSPM, "Prop_NoProjet", ""), True)
		
		If Not nd_Proj Is Nothing Then
			Set nd_Clie = xPJ_xndClie(v_Origine, xVar(nd_Proj, "Clie_NoClient", ""), True)
		End If
	Else
		Set nd_Clie = xSICl_xndClie(xVar(gnd_SDSPM, "Prop_ClientNoFmt", ""), False)
	End If
	
	If Not nd_Clie Is Nothing Then
		
		Call gnd_SDSPM.ReplaceItemValue( "Prop_ClientNomInterne", xVar(nd_Clie, "Clie_ClientNomInterne", ""))
		
		If xVar(gnd_SDSPM, "Prop_ClientNomLegal", "") = xVar(gnd_SDSPM, "Clie_NomLegal", "") Then
			Call gnd_SDSPM.ReplaceItemValue( "PNav_MajNomClient", 0)
		Else
			Call gnd_SDSPM.ReplaceItemValue( "PNav_MajNomClient", 1)
		End If
		
		Call gnuid_SDSPM.RefreshHideFormulas
		Call gnuid_SDSPM.Refresh
		
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acWorkflow"><lotusscript>Sub FPNav_acWorkflow(p_Statut As String)
	On Error GoTo GererErreur
	
	If SDSPM_acWorkflow(p_Statut) Then
		
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		Call gnuiws_SDSPM.ViewRefresh
		
		' Ouvrir le masque	
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		
		gnd_SDSPM.PNav_Titre =  Trim("C" &amp; CStr(xVar(gnd_Prop_SDSPM, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(gnd_Prop_SDSPM, "Prop_ClientNomInterne", xVar(gnd_Prop_SDSPM, "Prop_ClientNom", "")))
		gnd_SDSPM.Titre =  Trim(xVar(gnd_SDSPM, "PNav_Titre", "") &amp; " - " &amp; xVar(gnd_SDSPM, "PNav_MenuDesc000", ""))
		
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbProposition", xVar(gnd_Prop_SDSPM, "Prop_NbProposition", 0))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionFmt", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionFmt", ""))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionPrefixe", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionPrefixe", ""))		
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
		
		Call gnuid_SDSPN.Refresh
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsNomInterneModifiable"><lotusscript>Function FPNav_hsNomInterneModifiable
	On Error GoTo GererErreur
	
	Call gnd_SDSPM.ReplaceItemValue( "Prop_NomInterneModifie", "1")
	
	Call gnd_SDSPM.ReplaceItemValue( "Prop_NomInterneListe", xVar(gnd_SDSPM, "Prop_ClientNomInterne", ""))
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPM.Refresh
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_SelectionnerContactGroupeClient_SF"><lotusscript>Sub FPNav_SelectionnerContactGroupeClient_SF()
	' ---------------------------------------------------------------------------------
	' Le script perment de sélectionner les contacts du groupe client dans Projeto
	' ---------------------------------------------------------------------------------
	On Error GoTo GererErreur	
	
	Dim v_NoOpportunite As String
	Dim v_Resultat As Integer
	Dim v_AccountId As String
	Dim v_ContenuesContacts As Variant
	
	Dim v_contactID As String
	Dim v_ListContacts As Variant
	Dim v_AccountSF As SLSf_clObject
	Dim v_Choix As Variant
	
	Dim a_ClesContacts As Variant
	Dim a_ChoixContacts As Variant
	Dim a_TriCles As Variant
	Dim a_TriChoix As Variant

	Dim v_contactsCount As Long
	Dim v_PosChoix As Long
	
	Dim v_idChoix As String
	Dim v_ConnectID As String
	Dim v_NoOpportuniteSF As String
	Dim v_LigneChoixContact As String
	Dim v_ContactTitle As String
	
	Dim v_ContactItems As String
	Dim v_ContactOwn As String
	Dim v_ContactSign As String
	Dim v_ContactEmail As String
	
	Dim v_ID As String
	Dim a_Cles() As String
	Dim a_Choix() As String
	Dim v_Count As Long	

	Dim a_PropNoContacts As Variant
	Dim a_PropNoClientsContacts As Variant
	Dim a_PropContactNoms As Variant
	Dim a_PropContactCourriels As Variant
	Dim a_PropContactSansCourriel As Variant
	Dim a_PropNomClientContacts As Variant
	
	Dim v_ClientNoFmt As String
	Dim v_NoContact As String
	Dim v_NoClientContact As String
	Dim v_NomContact As String
	Dim v_CourrielContact As String
	Dim v_NomClientContact As String
	Dim i As Integer 
	Dim v_NoClientFmt As String	
	
	
	' Initialisations
	Call SISe_Initialisations
	
	v_NoOpportunite = xVar(gnd_SDSPM, "Prop_NoOpportuniteSF" , "")
	v_NoClientFmt = xVar(gnd_SDSPM, "Prop_ClientNoFmt" , "")
	
	' Extraire l'opportunité de Salesforce
	g_Resultat_FSFPP = FPNav_ExtraireOpportunite(v_NoOpportunite, v_NoClientFmt)
	

	If g_Resultat_FSFPP &lt; 0 Then
		Exit Sub
	Else
		Set v_AccountSF = gcl_SessionSLSf_FSFPP.Objects("Account")
		' Extraire les contacts
		Call gcl_SessionSLSf_FSFPP.Objects("Account").ExtraireEnfants("Contacts", "")
		
		v_Resultat = gcl_SessionSLSf_FSFPP.Objects("Account").NbEnfants("Contacts")
		If v_Resultat &gt; 0 Then
			v_contactsCount = 0
			ReDim a_ChoixContacts(v_Resultat-1)
			ReDim a_ClesContacts(v_Resultat-1)
			ReDim a_TriChoix(v_Resultat-1)
			ReDim a_TriCles(v_Resultat-1)	
			
			ReDim a_PropContactSansCourriel(v_Resultat -1)
			i = 0
			
			v_ListContacts = gcl_SessionSLSf_FSFPP.Objects("Account").Enfants("Contacts")

			ForAll contact In v_ListContacts
				v_ContactItems = ""
				v_contactID = contact.Contenu("Id")							
				a_ClesContacts(v_contactsCount)  = contact.Contenu("Id")					
				
				v_LigneChoixContact =  contact.ExtraireValeur("Name", "") 
				a_TriChoix(v_contactsCount)  = v_LigneChoixContact
				a_TriCles(v_contactsCount)  = v_LigneChoixContact
				
				v_ContactTitle = contact.ExtraireValeur("Title", "")
				If v_ContactTitle &lt;&gt; "" Then
					v_LigneChoixContact = v_LigneChoixContact &amp;  ", " &amp; v_ContactTitle
				End If	
				
				v_ContactOwn = contact.ExtraireValeur("Owner__c", "0")
				If v_ContactOwn = "True" Then
					If v_ContactItems = "" Then
						v_ContactItems = v_ContactItems &amp; "OWN" 
					End If							
				End If							
				
				v_ContactSign = contact.ExtraireValeur("Authorised_Signatory__c", "0")
				If v_ContactSign = "True" Then
					If v_ContactItems = "" Then
						v_ContactItems = v_ContactItems &amp; "SIGN" 
					Else
						v_ContactItems = v_ContactItems &amp; "+SIGN" 
					End If						
				End If	
				
				v_ContactEmail = contact.ExtraireValeur("Email", "")
				If v_ContactEmail &lt;&gt; "" Then							
					If v_ContactItems = "" Then
						v_ContactItems = v_ContactItems &amp; "EMAIL" 
					Else
						v_ContactItems = v_ContactItems &amp; "+EMAIL" 
					End If		
				End If
				
				If v_ContactItems &lt;&gt; "" Then
					v_ContactItems = " (" &amp; v_ContactItems &amp; ")"
				End If
				
				v_LigneChoixContact = v_LigneChoixContact &amp; v_ContactItems
				a_ChoixContacts(v_contactsCount)  = v_LigneChoixContact
				
				v_contactsCount = v_contactsCount +1							
			End ForAll					
			
			Call Trier2Arrays(a_TriCles, a_ClesContacts)
			Call Trier2Arrays(a_TriChoix, a_ChoixContacts)	

			v_Choix = gnuiws_SDSPM.Prompt (PROMPT_OKCANCELLISTMULT, xGDK_xMessage("SI", 198, "", ""),xGDK_xMessage("SI", 86, "", ""), "", a_ChoixContacts)					
			
			If IsEmpty(v_Choix) Then
				Exit Sub
			End If
			
			a_PropNoClientsContacts = xVarArray(gnd_SDSPM,"Prop_NoClientContactsCCDsg")
			a_PropNoContacts = xVarArray(gnd_SDSPM,"Prop_NoContactsCCDsg")
			a_PropContactNoms = xVarArray(gnd_SDSPM,"Prop_ContactNomsCCDsg")
			a_PropContactCourriels = xVarArray(gnd_SDSPM,"Prop_ContactCourrielsCCDsg")
			a_PropNomClientContacts = xVarArray(gnd_SDSPM,"Prop_NomClientContactsCCDsg")
			
			ForAll idChoix In v_Choix
				
				v_PosChoix = ArrayGetIndex(a_ChoixContacts, idChoix)
				v_idChoix = a_ClesContacts(v_PosChoix)

				v_NomContact = v_ListContacts(v_idChoix).ExtraireValeur("Name", "")
				v_CourrielContact = v_ListContacts(v_idChoix).ExtraireValeur("Email","")				
				
				If v_CourrielContact &lt;&gt; "" Then
					
					v_NoContact = v_ListContacts(v_idChoix).ExtraireValeur("Id", "")	
					v_NomClientContact = v_AccountSF.ExtraireValeur("Name", "")
					v_NoClientContact = v_AccountSF.ExtraireValeur("Id", "- - -")				
					
					If IsArray(a_PropNoContacts) Then
						If IsNull(ArrayGetIndex(a_PropNoContacts, v_NoContact)) Then
							a_PropNoContacts = ArrayAppend(a_PropNoContacts,v_NoContact)
							a_PropContactNoms = ArrayAppend(a_PropContactNoms,v_NomContact)
							a_PropContactCourriels = ArrayAppend(a_PropContactCourriels,v_CourrielContact)
							a_PropNoClientsContacts = ArrayAppend(a_PropNoClientsContacts, v_NoClientContact)	
							a_PropNomClientContacts = ArrayAppend(a_PropNomClientContacts, v_NomClientContact) 				
						End If
					Else
						ReDim a_PropNoContacts(0)
						ReDim a_PropContactNoms(0)
						ReDim a_PropContactCourriels(0)
						ReDim a_PropNoClientsContacts(0)
						ReDim a_PropNomClientContacts(0)
						
						a_PropNoContacts(0) = v_NoContact
						a_PropContactNoms(0)= v_NomContact
						a_PropContactCourriels(0) = v_CourrielContact
						a_PropNoClientsContacts(0) = v_NoClientContact 
						a_PropNomClientContacts(0) = v_NomClientContact
					End If
					
				Else
					a_PropContactSansCourriel(i) = v_NomContact
					i = i + 1
				End If
				
			End ForAll
			
		End If		
		
	End If	
	
	a_PropContactSansCourriel = FullTrim(a_PropContactSansCourriel)
	
	If IsArray(a_PropNoContacts) Then
		
		ReDim a_ClesContact(UBound(a_PropNoContacts))
		
		For i = 0 To UBound(a_PropNoContacts)
			a_ClesContact(i) = a_PropNomClientContacts(i) &amp; "~" &amp; a_PropContactNoms(i)&amp; "~" &amp; a_PropContactCourriels(i)&amp; "~" &amp; a_PropNoContacts(i)&amp; "~" &amp; a_PropNoClientsContacts(i)
		Next
		
		Call TrierArray(a_ClesContact)					
		
		For i = 0 To UBound(a_ClesContact)							
			a_PropNomClientContacts(i) = StrToken(a_ClesContact(i), "~",1)
			a_PropContactNoms(i) = StrToken(a_ClesContact(i), "~",2)
			a_PropContactCourriels(i) = StrToken(a_ClesContact(i), "~",3)				
			a_PropNoContacts(i) = StrToken(a_ClesContact(i), "~",4)
			a_PropNoClientsContacts(i) = StrToken(a_ClesContact(i), "~",5)
		Next
		
		Call gnd_SDSPM.ReplaceItemValue("Prop_NoContactsCCDsg", a_PropNoContacts)
		Call gnd_SDSPM.ReplaceItemValue("Prop_NoClientContactsCCDsg", a_PropNoClientsContacts)
		Call gnd_SDSPM.ReplaceItemValue("Prop_ContactNomsCCDsg", a_PropContactNoms)
		Call gnd_SDSPM.ReplaceItemValue("Prop_ContactCourrielsCCDsg", a_PropContactCourriels)
		Call gnd_SDSPM.ReplaceItemValue("Prop_NomClientContactsCCDsg", a_PropNomClientContacts)
		
	End If		
	
	Call FPNav_InitialiserContactCCClient_SF(gnd_SDSPM)		
	Call gnuid_SDSPM.Refresh			
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_acPartagerProposition"><lotusscript>Sub FPNav_acPartagerProposition(p_Partager As String)
	On Error Goto GererErreur
	
	gnd_SDSPM.Prop_NePasPartager = p_Partager
	
	Call gnuid_SDSPM.Refresh
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_hsRetirerContactGroupeClient"><lotusscript>Sub FPNav_hsRetirerContactGroupeClient
	On Error GoTo GererErreur
	
	Dim nuiws As New NotesUIWorkspace
	Dim v_Choix As Variant
	Dim v_PosChoix As Variant
	Dim a_ChoixContacts As Variant
	
	Dim a_PropNoClientsContactsCCDsg As Variant
	Dim a_PropNoContactsCCDsg As Variant	
	Dim a_PropContactNomsCCDsg As Variant
	Dim a_PropContactCourrielsCCDsg As Variant
	Dim a_PropNomClientContactsCCDsg As Variant
	
	Dim a_ContNoClientsContactsCCDsg As Variant	
	Dim a_ContContactNomsCCDsg As Variant
	Dim a_ContContactCourrielsCCDsg As Variant
	Dim a_ContNomClientContactsCCDsg As Variant
	
	Dim i As Integer
	
	a_PropNoClientsContactsCCDsg = xVarArray(gnd_SDSPM,"Prop_NoClientContactsCCDsg")
	a_PropNoContactsCCDsg = xVarArray(gnd_SDSPM,"Prop_NoContactsCCDsg")
	a_PropContactNomsCCDsg = xVarArray(gnd_SDSPM,"Prop_ContactNomsCCDsg")
	a_PropContactCourrielsCCDsg = xVarArray(gnd_SDSPM,"Prop_ContactCourrielsCCDsg")
	a_PropNomClientContactsCCDsg = xVarArray(gnd_SDSPM,"Prop_NomClientContactsCCDsg")
	
	a_ContNoClientsContactsCCDsg = xVarArray(gnd_SDSPM,"Cont_NoClientContactsCCDsg")	
	a_ContContactNomsCCDsg = xVarArray(gnd_SDSPM,"Cont_ContactNomsCCDsg")
	a_ContContactCourrielsCCDsg = xVarArray(gnd_SDSPM,"Cont_ContactCourrielsCCDsg")
	a_ContNomClientContactsCCDsg = xVarArray(gnd_SDSPM,"Cont_NomClientContactsCCDsg")
	
	ReDim a_ChoixContacts(UBound(a_PropNoClientsContactsCCDsg))
	
	For i = 0 To UBound(a_PropNoClientsContactsCCDsg)
		a_ChoixContacts(i) = a_PropNomClientContactsCCDsg(i) &amp; "    " &amp; a_PropContactNomsCCDsg(i) &amp; "    &lt;" &amp; a_PropContactCourrielsCCDsg(i) &amp; "&gt;"
	Next
	
	' Demander l'utilisateur de choisir le candidat à retirer
	v_Choix = nuiws.Prompt (PROMPT_OKCANCELLIST, xGDK_xMessage("SI", 198, "", ""),xGDK_xMessage("SI", 71, "", ""), "", a_ChoixContacts)
	
	If IsEmpty(v_Choix) Then
		Exit Sub
	End If
	
	v_PosChoix = ArrayGetIndex(a_ChoixContacts, v_Choix)
	
	If Not IsNull(v_PosChoix) Then
		a_PropNoClientsContactsCCDsg(v_PosChoix) = ""		
		a_PropNoClientsContactsCCDsg = RetirerArray(a_PropNoClientsContactsCCDsg, "")
		a_PropNoContactsCCDsg(v_PosChoix)= ""
		a_PropNoContactsCCDsg = RetirerArray(a_PropNoContactsCCDsg, "")
		a_PropContactNomsCCDsg(v_PosChoix)= ""
		a_PropContactNomsCCDsg = RetirerArray(a_PropContactNomsCCDsg, "")
		a_PropContactCourrielsCCDsg(v_PosChoix) = ""
		a_PropContactCourrielsCCDsg = RetirerArray(a_PropContactCourrielsCCDsg, "")
		a_PropNomClientContactsCCDsg(v_PosChoix) = ""
		a_PropNomClientContactsCCDsg = RetirerArray(a_PropNomClientContactsCCDsg, "")	
		
		a_ContNoClientsContactsCCDsg(v_PosChoix) = ""		
		a_ContNoClientsContactsCCDsg = RetirerArray(a_ContNoClientsContactsCCDsg, "")
		'a_ContNoContactsCCDsg(v_PosChoix)= ""
		'a_ContNoContactsCCDsg = RetirerArray(a_ContNoContactsCCDsg, "")
		a_ContContactNomsCCDsg(v_PosChoix)= ""
		a_ContContactNomsCCDsg = RetirerArray(a_ContContactNomsCCDsg, "")
		a_ContContactCourrielsCCDsg(v_PosChoix) = ""
		a_ContContactCourrielsCCDsg = RetirerArray(a_ContContactCourrielsCCDsg, "")
		a_ContNomClientContactsCCDsg(v_PosChoix) = ""
		a_ContNomClientContactsCCDsg = RetirerArray(a_ContNomClientContactsCCDsg, "")
		
	End If
	
	Call gnd_SDSPM.ReplaceItemValue("Prop_NoContactsCCDsg", a_PropNoContactsCCDsg)
	Call gnd_SDSPM.ReplaceItemValue("Prop_ContactNomsCCDsg",  a_PropContactNomsCCDsg)
	Call gnd_SDSPM.ReplaceItemValue("Prop_ContactCourrielsCCDsg",  a_PropContactCourrielsCCDsg)
	Call gnd_SDSPM.ReplaceItemValue("Prop_NoClientContactsCCDsg",  a_PropNoClientsContactsCCDsg)
	Call gnd_SDSPM.ReplaceItemValue("Prop_NomClientContactsCCDsg", a_PropNomClientContactsCCDsg)
	
	'Call gnd_SDSPM.ReplaceItemValue("Cont_NoContactsCCDsg", a_ContNoContactsCCDsg)
	Call gnd_SDSPM.ReplaceItemValue("Cont_ContactNomsCCDsg",  a_ContContactNomsCCDsg)
	Call gnd_SDSPM.ReplaceItemValue("Cont_ContactCourrielsCCDsg",  a_ContContactCourrielsCCDsg)
	Call gnd_SDSPM.ReplaceItemValue("Cont_NoClientContactsCCDsg",  a_ContNoClientsContactsCCDsg)
	Call gnd_SDSPM.ReplaceItemValue("Cont_NomClientContactsCCDsg", a_ContNomClientContactsCCDsg)
	
	
	If xVarImplode(gnd_SDSPM, "Prop_NoClientContactsCCDsg", ";") = xVarImplode(gnd_SDSPM, "Cont_NoClientContactsCCDsg", ";") _
	And xVarImplode(gnd_SDSPM, "Prop_NomClientContactsCCDsg", ";") = xVarImplode(gnd_SDSPM, "Cont_NomClientContactsCCDsg", ";") _
	And xVarImplode(gnd_SDSPM, "Prop_ContactNomsCCDsg", ";") = xVarImplode(gnd_SDSPM, "Cont_ContactNomsCCDsg", ";") _
	And xVarImplode(gnd_SDSPM, "Prop_ContactCourrielsCCDsg", ";") = xVarImplode(gnd_SDSPM, "Cont_ContactCourrielsCCDsg", ";") Then
		gnd_SDSPM.PNav_MajContactCC = 0
	End If
	
	
	Call gnuid_SDSPM.Refresh	
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsAfficherClient"><lotusscript>Sub FPNav_hsAfficherClient
	On Error GoTo GererErreur
	
	Dim v_Origine As String
	Dim nd As NotesDocument

	v_Origine= xVar(gnd_SDSPM, "Prop_Origine", "")
	If v_Origine &lt;&gt; "SF" Then
		If FPNav_ndClientOrigine(gnd_SDSPM, nd, v_Origine, True) Then
			Call gnuiws_SDSPM.EditDocument(False, nd)
		End If
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_MajAdresseSiteClient"><lotusscript>Sub FPNav_MajAdresseSiteClient(pnd_Clie As NotesDocument, pnd_Site As NotesDocument, p_Origine As String)
	On Error Goto GererErreur
	
	If p_Origine = "SICl" Then
		pnd_Site.Site_ClientAdresse1 = xVar(pnd_Clie, "Clie_ClientAdresse1", "")
		pnd_Site.Site_ClientAdresse2 = xVar(pnd_Clie, "Clie_ClientAdresse2", "")
		pnd_Site.Site_ClientVille = xVar(pnd_Clie, "Clie_ClientVille", "")
		pnd_Site.Site_ClientProvince = xVar(pnd_Clie, "Clie_ClientProvince", "")
		pnd_Site.Site_ClientPays = xVar(pnd_Clie, "Clie_ClientPays", "")
		pnd_Site.Site_ClientCodePostal = xVar(pnd_Clie, "Clie_ClientCodePostal", "")
	ElseIf p_Origine &lt;&gt; "SF" Then
		pnd_Site.Site_ClientAdresse1 = xVar(pnd_Clie, "Clie_Adresse1", "")
		pnd_Site.Site_ClientAdresse2 = xVar(pnd_Clie, "Clie_Adresse2", "")
		pnd_Site.Site_ClientVille = xVar(pnd_Clie, "Clie_Ville", "")
		pnd_Site.Site_ClientProvince = xVar(pnd_Clie, "Clie_Province", "")
		pnd_Site.Site_ClientPays = xVar(pnd_Clie, "Clie_Pays", "")
		pnd_Site.Site_ClientCodePostal = xVar(pnd_Clie, "Clie_CodePostal", "")
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Prop_NoProposition", ""), False)
	Exit Sub
End Sub

