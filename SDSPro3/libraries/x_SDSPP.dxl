utique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_SDSP" ou "SDSP" est 
'		l'identifiant de la base de documents.
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "SDSP" par l'identifiant de la base de documents.  
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "Prop" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xSDSPP As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_SDSPP As NotesDocument
Dim gnvTabl_xSDSPP As Notesview
Dim gndTabl_xSDSPP As Notesdocument
Dim gnv_Prop_xSDSPP As Notesview				' La vue d'ou est extrait le document
Dim gnd_Prop_xSDSPP As Notesdocument	' Le document qui contient les informations recherchées
Dim gnv_Site_xSDSPP As Notesview				' La vue d'ou est extrait le document
Dim gnd_Site_xSDSPP As Notesdocument	' Le document qui contient les informations recherchées
Dim gnv_Site21_xSDSPP As Notesview				' La vue d'ou est extrait le document
Dim gnv_MOpt_xSDSPP As Notesview					' La vue d'ou est extrait le document
Dim gnd_MOpt_xSDSPP As Notesdocument			' Le document qui contient les informations recherchées

' Section 3 - Les constantes à définir
Const gc_NomBD_xSDSPP = "SDSPP"			' Inscrire le nom de la base de documents, tel que déclaré dans le GDK.
Const gc_NomVueProp_xSDSPP = "V_Prop20"				' Le nom de la vue de recherche
Const gc_NomItemCleProp_xSDSPP = "Prop_NoProposition"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueSite_xSDSPP = "V_Site20"				' Le nom de la vue de recherche
Const gc_NomItemCleSite_xSDSPP = "Site_NoSite"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueSite21_xSDSPP = "V_Site21"				' Le nom de la vue de recherche
Const gc_NomItemMOpt_xSDSPP = "MOpt_Code"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueMOpt_xSDSPP = "V_MOpt20"		' Le nom de la vue de recherche

</lotusscript></code><code event="xSDSPP_xndSite"><lotusscript>Function xSDSPP_xndSite(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type apSiterié.
	
	' Initialisation des variables globales
	Call xSDSPP_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleSite_xSDSPP, p_Cle, p_Cache, gndb_xSDSPP, gc_NomVueSite_xSDSPP, gnv_Site_xSDSPP, gnd_Site_xSDSPP)
	
	' Retourne le document défini en variable globale
	Set xSDSPP_xndSite = gnd_Site_xSDSPP
End Function

</lotusscript></code><code event="xSDSPP_xVarProp"><lotusscript>Function xSDSPP_xVarProp(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	xSDSPP_xVarProp = xVar(xSDSPP_xndProp(p_Cle, p_Cache), p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSDSPP_xIcnTabl"><lotusscript>Function xSDSPP_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xSDSPP_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xSDSPP_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xSDSPP_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xSDSPP_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xSDSPP_xIcnTabl = v_Icones(0)
			Else
				xSDSPP_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSPP_xVarMOpt"><lotusscript>Function xSDSPP_xVarMOpt(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	' p_Cle = CodeMenu
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	xSDSPP_xVarMOpt = xVar(xSDSPP_xndMOpt(p_Cle, p_Cache), p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSDSPP_xDescTabl"><lotusscript>Function xSDSPP_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSDSPP_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSDSPP_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSDSPP_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSDSPP_xDescTabl = v_Descriptions(i)
					End If
				End If
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSDSPP_xDescTabl = v_Descriptions(0)
			Else
				xSDSPP_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSPP_xVarSite"><lotusscript>Function xSDSPP_xVarSite(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	xSDSPP_xVarSite = xVar(xSDSPP_xndSite(p_Cle, p_Cache), p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSDSPP_xndTabl"><lotusscript>Function xSDSPP_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call  xSDSPP_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xSDSPP, "V_Tabl20", gnvTabl_xSDSPP, gndTabl_xSDSPP)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xSDSPP_xndTabl = gndTabl_xSDSPP
End Function

</lotusscript></code><code event="xSDSPP_xComplTabl"><lotusscript>Function xSDSPP_xComplTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_NoComplement As String, _
Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSDSPP_xComplTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs =  xSDSPP_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions =  xSDSPP_xVarTabl(p_Table, "Tabl_Complement" &amp; p_NoComplement, "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSDSPP_xComplTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSDSPP_xComplTabl = v_Descriptions(0)
			Else
				xSDSPP_xComplTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSPP_xndcSite"><lotusscript>Function xSDSPP_xndcSite(Byval p_Cle As Variant) As NotesdocumentCollection
	' Cette fonction retourne une collection de documents du type approprié.
	
	' Initialisation des variables globales
	Call xSDSPP_Initialisations
	Call xnv(gndb_xSDSPP, "V_Site21", gnv_Site21_xSDSPP)
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Set xSDSPP_xndcSite = gnv_Site21_xSDSPP.GetAllDocumentsByKey(p_Cle, True)
End Function

</lotusscript></code><code event="xSDSPP_Initialisations"><lotusscript>Sub xSDSPP_Initialisations
	' Initialisation des variables globales
	If gndb_xSDSPP Is Nothing Then
		Set gndb_xSDSPP = xGDK_xndbNDB(gc_NomBD_xSDSPP)
	End If
End Sub

</lotusscript></code><code event="xSDSPP_xVarTabl"><lotusscript>Function xSDSPP_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	xSDSPP_xVarTabl = xVar(xSDSPP_xndTabl(pCle, pCache), pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xSDSPP_xndProp"><lotusscript>Function xSDSPP_xndProp(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSDSPP_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleProp_xSDSPP, p_Cle, p_Cache, gndb_xSDSPP, gc_NomVueProp_xSDSPP, gnv_Prop_xSDSPP, gnd_Prop_xSDSPP)
	
	' Retourne le document défini en variable globale
	Set xSDSPP_xndProp = gnd_Prop_xSDSPP
End Function

</lotusscript></code><code event="xSDSPP_xVarProf"><lotusscript>Function xSDSPP_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil.
	
	Call xSDSPP_Initialisations
	If gnd_Prof_SDSPP Is Nothing Then
		Set gnd_Prof_SDSPP = gndb_xSDSPP.GetProfileDocument("F_Prof")
	End If
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	xSDSPP_xVarProf = xVar(gnd_Prof_SDSPP, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSDSPP_xndMOpt"><lotusscript>Function xSDSPP_xndMOpt(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	' p_Cle = MOpt_Code
	
	' Initialisation des variables globales
	Call xSDSPP_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemMOpt_xSDSPP, p_Cle, p_Cache, gndb_xSDSPP, gc_NomVueMOpt_xSDSPP, gnv_MOpt_xSDSPP, gnd_MOpt_xSDSPP)
	
	' Retourne le document défini en variable globale
	Set xSDSPP_xndMOpt = gnd_MOpt_xSDSPP
End Function</lotusscript></code>
