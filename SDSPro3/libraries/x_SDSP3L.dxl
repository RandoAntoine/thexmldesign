ue/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_SDSP3L" ou "SDSP3L" est 
'		l'identifiant de la base de documents.
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "SDSP3L" par l'identifiant de la base de documents.  
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "Prod" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xSDSP3L As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_SDSP3L As NotesDocument
Dim gnvTabl_xSDSP3L As Notesview
Dim gndTabl_xSDSP3L As Notesdocument
Dim gnv_Prod_xSDSP3L As Notesview					' La vue d'ou est extrait le document
Dim gnd_Prod_xSDSP3L As Notesdocument			' Le document qui contient les informations recherchées

' Section 3 - Les constantes à définir
Const gc_NomBD_xSDSP3L = "SDSP3L"		' Inscrire le nom usuel de la base de documents
																' de recherche, tel que déclaré dans le GDK.
Const gc_NomItemCleProd_xSDSP3L = "CleProduit"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueProd_xSDSP3L = "V_Prod20"		' Le nom de la vue de recherche

</lotusscript></code><code event="xSDSP3L_xDescTabl"><lotusscript>Function xSDSP3L_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSDSP3L_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSDSP3L_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSDSP3L_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSDSP3L_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSDSP3L_xDescTabl = v_Descriptions(0)
			Else
				xSDSP3L_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSP3L_xIcnTabl"><lotusscript>Function xSDSP3L_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xSDSP3L_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xSDSP3L_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xSDSP3L_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xSDSP3L_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xSDSP3L_xIcnTabl = v_Icones(0)
			Else
				xSDSP3L_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSP3L_xndTabl"><lotusscript>Function xSDSP3L_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xSDSP3L_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xSDSP3L, "V_Tabl20", gnvTabl_xSDSP3L, gndTabl_xSDSP3L)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xSDSP3L_xndTabl = gndTabl_xSDSP3L
End Function

</lotusscript></code><code event="xSDSP3L_xndProd"><lotusscript>Function xSDSP3L_xndProd(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSDSP3L_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleProd_xSDSP3L, p_Cle, p_Cache, gndb_xSDSP3L, gc_NomVueProd_xSDSP3L, gnv_Prod_xSDSP3L, gnd_Prod_xSDSP3L)
	
	' Retourne le document défini en variable globale
	Set xSDSP3L_xndProd = gnd_Prod_xSDSP3L
End Function

</lotusscript></code><code event="xSDSP3L_xVarTabl"><lotusscript>Function xSDSP3L_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	Set nd = xSDSP3L_xndTabl(pCle, pCache)
	xSDSP3L_xVarTabl = xVar(nd, pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xSDSP3L_xVarProd"><lotusscript>Function xSDSP3L_xVarProd(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSDSP3L_xndProd(p_Cle, p_Cache)
	xSDSP3L_xVarProd = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSDSP3L_xVarProf"><lotusscript>Function xSDSP3L_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xSDSP3L_Initialisations
	
	' Extraire le document de profil
	If gnd_Prof_SDSP3L Is Nothing Then
		Set gnd_Prof_SDSP3L = gndb_xSDSP3L.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_SDSP3L Is Nothing Then
		xSDSP3L_xVarProf = p_ValeurNulle
	Else
		xSDSP3L_xVarProf = xVar(gnd_Prof_SDSP3L, p_NomVar, p_ValeurNulle)		
	End If
End Function

</lotusscript></code><code event="xSDSP3L_Initialisations"><lotusscript>Sub xSDSP3L_Initialisations
	' Initialisation des variables globales
	If gndb_xSDSP3L Is Nothing Then
		Set gndb_xSDSP3L = xGDK_xndbNDB(gc_NomBD_xSDSP3L)
	End If
End Sub

</lotusscript></code><code event="xSDSP3L_xValeurExisteTabl"><lotusscript>Function xSDSP3L_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xSDSP3L_xValeurExisteTabl = False
	
	If Not (xSDSP3L_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gndTabl_xSDSP3L.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xSDSP3L_xValeurExisteTabl = True
		End If
	End If	
End Function</lotusscript></code>
<item name="$POID"><datetime>20250319T073638,33-05</datetime></item></scriptlibrary>

