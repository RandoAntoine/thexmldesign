</lotusscript></code><code event="xSDSCS_xVarCSFa"><lotusscript>Function xSDSCS_xVarCSFa(ByVal p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
ByVal p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSDSCS_xndCSFa(p_Cle, p_Cache)
	xSDSCS_xVarCSFa = xVar(nd, p_NomVar, p_ValeurNulle)
End Function


</lotusscript></code><code event="xSDSCS_xVarCSCo"><lotusscript>Function xSDSCS_xVarCSCo(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
