	' Retourne le document défini en variable globale
	Set xSDSCS_xndCSPr_ClientCle = gnd_CSPr36_xSDSCS
End Function

</lotusscript></code><code event="xSDSCS_xndCSFi_Commande"><lotusscript>Function xSDSCS_xndCSFi_Commande(ByVal p_Cle As Variant, ByVal p_Cache As Integer) As NotesDocument	
	' Cette fonction retourne le contrat de service actif du client.
	
