</lotusscript></code><code event="xSDSCS_Initialisations"><lotusscript>Sub xSDSCS_Initialisations
	' Initialisation des variables globales
	If gndb_xSDSCS Is Nothing Then
		Set gndb_xSDSCS = xGDK_xndbNDB(gc_NomBD_xSDSCS)
	End If
End Sub

</lotusscript></code><code event="xSDSCS_xndTabl"><lotusscript>Function xSDSCS_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xSDSCS_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xSDSCS, "V_Tabl20", gnvTabl_xSDSCS, gndTabl_xSDSCS)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xSDSCS_xndTabl = gndTabl_xSDSCS
End Function

</lotusscript></code><code event="xSDSCS_xVarCSPr_ClientCle"><lotusscript>Function xSDSCS_xVarCSPr_ClientCle(ByVal p_NoClientFmt As String, ByVal p_CleProduit As String, ByVal p_NomVar As String, ByVal p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSDSCS_xndCSPr_ClientCle(p_NoClientFmt, p_CleProduit)
	xSDSCS_xVarCSPr_ClientCle = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSDSCS_xVarTabl"><lotusscript>Function xSDSCS_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	Set nd = xSDSCS_xndTabl(pCle, pCache)
	xSDSCS_xVarTabl = xVar(nd, pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xSDSCS_xValeurExisteTabl"><lotusscript>Function xSDSCS_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xSDSCS_xValeurExisteTabl = False
	
	If Not (xSDSCS_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gndTabl_xSDSCS.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xSDSCS_xValeurExisteTabl = True
		End If
	End If	
End Function

</lotusscript></code><code event="xSDSCS_xVarCSPr"><lotusscript>Function xSDSCS_xVarCSPr(ByVal p_NoContratFmt As String, ByVal p_NoProduitSeq As Integer, ByVal p_NomVar As String, ByVal p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSDSCS_xndCSPr(p_NoContratFmt, p_NoProduitSeq)
	xSDSCS_xVarCSPr = xVar(nd, p_NomVar, p_ValeurNulle)
End Function
</lotusscript></code>
