<updatedby><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_SDSCS" ou "SDSCS" est 
'		l'identifiant de la base de documents.
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "SDSCS" par l'identifiant de la base de documents.  
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "CSCo" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xSDSCS As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_SDSCS As NotesDocument
Dim gnvTabl_xSDSCS As Notesview
Dim gndTabl_xSDSCS As Notesdocument
Dim gnv_CSCo_xSDSCS As Notesview					' La vue d'ou est extrait le document
Dim gnd_CSCo_xSDSCS As Notesdocument			' Le document qui contient les informations recherchées
Dim gnv_CSCo_Client_xSDSCS As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSCo_Client_xSDSCS As NotesDocument			' Le document qui contient les informations recherchées

Dim gnv_CSFi_xSDSCS As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSFi_xSDSCS As NotesDocument			' Le document qui contient les informations recherchées

Dim gnv_CSFi_Commande_xSDSCS As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSFi_Commande_xSDSCS As NotesDocument			' Le document qui contient les informations recherchées

Dim gnv_CSFi_Client_xSDSCS As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSFi_Client_xSDSCS As NotesDocument			' Le document qui contient les informations recherchées

Dim gnv_CSFi_Contrat_xSDSCS As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSFi_Contrat_xSDSCS As NotesDocument			' Le document qui contient les informations recherchées

Dim gnv_CSFa_xSDSCS As Notesview					' La vue d'ou est extrait le document
Dim gnd_CSFa_xSDSCS As Notesdocument			' Le document qui contient les informations recherchées
Dim gnv_CSPr_xSDSCS As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSPr_xSDSCS As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_CSPr30_xSDSCS As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSPr30_xSDSCS As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_CSPr36_xSDSCS As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSPr36_xSDSCS As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_CSPr27_xSDSCS As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSPr27_xSDSCS As NotesDocument			' Le document qui contient les informations recherchées

' Section 3 - Les constantes à définir
Const gc_NomBD_xSDSCS = "SDSCS"		' Inscrire le nom usuel de la base de documents
																' de recherche, tel que déclaré dans le GDK.
Const gc_NomItemCleCSCo_xSDSCS = "CSCo_NoContratFmt"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueCSCo_xSDSCS = "V_CSCo20"		' Le nom de la vue de recherche
Const gc_NomItemCleCSCo_Client_xSDSCS = "CSCo_ClientNoFmt"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueCSCo_Client_xSDSCS = "V_CSCo12"		' Le nom de la vue de recherche
Const gc_NomItemCleCSFi_Client_xSDSCS = "CSFi_NoClientFmt"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueCSFi_Client_xSDSCS = "V_CSFi21"		' Le nom de la vue de recherche
Const gc_NomItemCleCSFi_Commande_xSDSCS = "CSFi_NoFacture"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueCSFi_Commande_xSDSCS = "V_CSFi23"		' Le nom de la vue de recherche
Const gc_NomItemCleCSFi_Contrat_xSDSCS = "CSFi_NoContrat"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueCSFi_Contrat_xSDSCS = "V_CSFi22"		' Le nom de la vue de recherche
Const gc_NomItemCleCSFi_xSDSCS = "CSFi_NoFinancement"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueCSFi_xSDSCS = "V_CSFi20"		' Le nom de la vue de recherche
Const gc_NomItemCleCSFa_xSDSCS = "CSFa_NoContrat"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueCSFa_xSDSCS = "V_CSFa20"		' Le nom de la vue de recherche
Const gc_NomVueCSPr_xSDSCS = "V_CSPr20"		' Le nom de la vue de recherche
Const gc_NomVueCSPr30_xSDSCS = "V_CSPr30"		' Le nom de la vue de recherche
Const gc_NomVueCSPr36_xSDSCS = "V_CSPr36"		' Le nom de la vue de recherche
Const gc_NomVueCSPr27_xSDSCS = "V_CSPr27"		' Le nom de la vue de recherche

</lotusscript></code><code event="xSDSCS_xndCSPr_CleClient"><lotusscript>Function xSDSCS_xndCSPr_CleClient(ByVal p_NoClientFmt As String, ByVal p_CleProduit As String) As NotesDocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSDSCS_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("", p_CleProduit + ";" + p_NoClientFmt  , False, gndb_xSDSCS, gc_NomVueCSPr27_xSDSCS, gnv_CSPr27_xSDSCS, gnd_CSPr27_xSDSCS)
	
	' Retourne le document défini en variable globale
	Set xSDSCS_xndCSPr_CleClient = gnd_CSPr27_xSDSCS
End Function

</lotusscript></code><code event="xSDSCS_xVarProf"><lotusscript>Function xSDSCS_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xSDSCS_Initialisations
	
	' Extraire le document de profil
	If gnd_Prof_SDSCS Is Nothing Then
		Set gnd_Prof_SDSCS = gndb_xSDSCS.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_SDSCS Is Nothing Then
		xSDSCS_xVarProf = p_ValeurNulle
	Else
		xSDSCS_xVarProf = xVar(gnd_Prof_SDSCS, p_NomVar, p_ValeurNulle)		
	End If
End Function

</lotusscript></code><code event="xSDSCS_xndCSCo"><lotusscript>Function xSDSCS_xndCSCo(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSDSCS_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleCSCo_xSDSCS, p_Cle, p_Cache, gndb_xSDSCS, gc_NomVueCSCo_xSDSCS, gnv_CSCo_xSDSCS, gnd_CSCo_xSDSCS)
	
	' Retourne le document défini en variable globale
	Set xSDSCS_xndCSCo = gnd_CSCo_xSDSCS
End Function

</lotusscript></code><code event="xSDSCS_xDescTabl"><lotusscript>Function xSDSCS_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSDSCS_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSDSCS_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSDSCS_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSDSCS_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSDSCS_xDescTabl = v_Descriptions(0)
			Else
				xSDSCS_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSCS_xndCSCo_Client"><lotusscript>Function xSDSCS_xndCSCo_Client(ByVal p_Cle As Variant, ByVal p_Cache As Integer) As NotesDocument	
	' Cette fonction retourne le contrat de service actif du client.
	
	' Initialisation des variables globales
	Call xSDSCS_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleCSCo_Client_xSDSCS, p_Cle, p_Cache, gndb_xSDSCS, gc_NomVueCSCo_Client_xSDSCS, _
	gnv_CSCo_Client_xSDSCS, gnd_CSCo_Client_xSDSCS)
	
	' Retourne le document défini en variable globale
	Set xSDSCS_xndCSCo_Client = gnd_CSCo_Client_xSDSCS
End Function

</lotusscript></code><code event="xSDSCS_xIcnTabl"><lotusscript>Function xSDSCS_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xSDSCS_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xSDSCS_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xSDSCS_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xSDSCS_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xSDSCS_xIcnTabl = v_Icones(0)
			Else
				xSDSCS_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSCS_xndCSPr_Cle"><lotusscript>Function xSDSCS_xndCSPr_Cle(ByVal p_NoContratFmt As String, ByVal p_CleProduit As String) As NotesDocument	
	' Cette fonction retourne un document du type approprié.
	
	Dim v_Cle(1) As String
	
	' Initialisation des variables globales
	Call xSDSCS_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	v_Cle(0) = p_NoContratFmt
	v_Cle(1) = p_CleProduit
	Call xnd("", v_Cle, False, gndb_xSDSCS, gc_NomVueCSPr30_xSDSCS, gnv_CSPr30_xSDSCS, gnd_CSPr30_xSDSCS)
	
	' Retourne le document défini en variable globale
	Set xSDSCS_xndCSPr_Cle = gnd_CSPr30_xSDSCS
End Function

</lotusscript></code><code event="xSDSCS_xndCSPr_ClientCle"><lotusscript>Function xSDSCS_xndCSPr_ClientCle(ByVal p_NoClientFmt As String, ByVal p_CleProduit As String) As NotesDocument	
