</lotusscript></code><code event="xSIEm_xndSite_Empl"><lotusscript>Function xSIEm_xndSite_Empl(Byval p_Cle As Integer, Byval p_Cache As Integer) As NotesDocument
	' Cette fonction retourne le site associé à un emplacement
	
	Dim nd As NotesDocument
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	Set xSIEm_xndSite_Empl = Nothing
	
	If gnv_Site_xSIEm Is Nothing Then
		Set gnv_Site_xSIEm = gndb_xSIEm.GetView("V_Site20")
	End If
	Set nd = gnv_Site_xSIEm.GetFirstDocument
	Do Until nd Is Nothing
		If xVar(nd, "Site_EmplacementDefaut", "") = "1" Then
			Set xSIEm_xndSite_Empl = nd
		Elseif p_Cle &gt;= xVar(nd, "Site_EmplacementDe", 0) And p_Cle &lt;= xVar(nd, "Site_EmplacementA", 0) Then
			Set xSIEm_xndSite_Empl = nd
			Exit Function
		End If
		
		Set nd = gnv_Site_xSIEm.GetNextDocument(nd)
	Loop
End Function

</lotusscript></code><code event="xSIEm_xVarSite"><lotusscript>Function xSIEm_xVarSite(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIEm_xndSite(p_Cle, p_Cache)
	xSIEm_xVarSite = xVar(nd, p_NomVar, p_ValeurNulle)
End Function</lotusscript></code>
