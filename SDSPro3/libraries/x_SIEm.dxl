	Call xnd(gc_NomItemCleEmpl_xSIEm, Clng(p_Cle), p_Cache, gndb_xSIEm, gc_NomVueEmpl_xSIEm, gnv_Empl_xSIEm, gnd_Empl_xSIEm)
	
