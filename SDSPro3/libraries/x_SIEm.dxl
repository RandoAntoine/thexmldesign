	Call xnd(gc_NomItemCleID_xSIEm, Lcase(p_Cle), p_Cache, gndb_xSIEm, gc_NomVueEmplID_xSIEm, gnv_Empl_xSIEm, gnd_Empl_xSIEm)
	
