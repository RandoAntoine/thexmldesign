me><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_AAAA" ou "AAAA" est 
'		l'identifiant de la base de documents.
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "AAAA" par l'identifiant de la base de documents.
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "BBBB" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xSIEm As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_xSIEm As NotesDocument
Dim gnv_Tabl_xSIEm As NotesView
Dim gnd_Tabl_xSIEm As NotesDocument
Dim gnv_Empl_xSIEm As NotesView				' La vue d'ou est extrait le document
Dim gnd_Empl_xSIEm As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_Depa_xSIEm As NotesView				' La vue d'ou est extrait le document (Departements)
Dim gnd_Depa_xSIEm As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_SDep_xSIEm As NotesView				' La vue d'ou est extrait le document (Sous-departements)
Dim gnd_SDep_xSIEm As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_Grou_xSIEm As NotesView				' La vue d'ou est extrait le document (Groupes)
Dim gnd_Grou_xSIEm As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_Site_xSIEm As NotesView				' La vue d'ou est extrait le document (Sites)
Dim gnd_Site_xSIEm As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_Fili_xSIEm As NotesView
Dim gnd_Fili_xSIEm As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_HDsp_xSIEm As NotesView
Dim gnd_HDsp_xSIEm As NotesDocument			' Le document qui contient les informations recherchées

' Section 3 - Les constantes à définir
Const gc_NomBD_xSIEm = "SIEm"				' Inscrire le nom usuel de la base de documents de recherche, tel que déclaré dans le GDK.
Const gc_NomVueEmpl_xSIEm = "V_Empl20"				' Le nom de la vue de recherche
Const gc_NomItemCleEmpl_xSIEm = "Empl_NoEmploye"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueEmplID_xSIEm = "V_Empl23"				' Le nom de la vue de recherche
Const gc_NomItemCleID_xSIEm = "Empl_NotesId"			' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueEmplNom_xSIEm = "V_Empl24"				' Le nom de la vue de recherche
Const gc_NomItemCleNom_xSIEm = "Empl_NomEmploye"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueDepa_xSIEm = "V_Depa20"				' Le nom de la vue de recherche
Const gc_NomItemCleDepa_xSIEm = "Depa_NoDepartement"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueSDep_xSIEm = "V_SDep20"				' Le nom de la vue de recherche
Const gc_NomItemCleSDep_xSIEm = "SDep_NoSousDepartement"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueGrou_xSIEm = "V_Grou20"				' Le nom de la vue de recherche
Const gc_NomItemCleGrou_xSIEm = "Grou_NomGroupe"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueSite_xSIEm = "V_Site20"				' Le nom de la vue de recherche
Const gc_NomItemCleSite_xSIEm = "Site_NoSite"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueFili_xSIEm = "V_Fili20"
Const gc_NomItemCleFili_xSIEm = "Fili_NoFiliale"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueHDsp_xSIEm = "V_HDsp20"

</lotusscript></code><code event="xSIEm_xndSDep"><lotusscript>Function xSIEm_xndSDep(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleSDep_xSIEm, p_Cle, p_Cache, gndb_xSIEm, gc_NomVueSDep_xSIEm, gnv_SDep_xSIEm, gnd_SDep_xSIEm)
	
	' Retourne le document défini en variable globale
	Set xSIEm_xndSDep = gnd_SDep_xSIEm
End Function

</lotusscript></code><code event="xSIEm_xVarFili"><lotusscript>Function xSIEm_xVarFili(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIEm_xndFili(p_Cle, p_Cache)
	xSIEm_xVarFili = xVar(nd, p_NomVar, p_ValeurNulle)
End Function


</lotusscript></code><code event="xSIEm_xVarEmpl_Id"><lotusscript>Function xSIEm_xVarEmpl_Id(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIEm_xndEmpl_Id(p_Cle, p_Cache)
	xSIEm_xVarEmpl_Id = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSIEm_xComplTabl"><lotusscript>Function xSIEm_xComplTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_NoComplement As String, _
Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSIEm_xComplTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSIEm_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSIEm_xVarTabl(p_Table, "Tabl_Complement" &amp; p_NoComplement, "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSIEm_xComplTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSIEm_xComplTabl = v_Descriptions(0)
			Else
				xSIEm_xComplTabl = v_Descriptions
			End If
		End If
	End If
End Function


</lotusscript></code><code event="xSIEm_xVarHDsp"><lotusscript>Function xSIEm_xVarHDsp(Byval p_NoEmploye As Long, Byval p_TypeHeuresDisponibles As String, Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIEm_xndHDsp(p_NoEmploye, p_TypeHeuresDisponibles)
	xSIEm_xVarHDsp = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSIEm_xndGrou"><lotusscript>Function xSIEm_xndGrou(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	
	' Changer le Cle en numerique!
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleGrou_xSIEm, Clng(p_Cle), p_Cache, gndb_xSIEm, gc_NomVueGrou_xSIEm, gnv_Grou_xSIEm, _
	gnd_Grou_xSIEm)
	
	' Retourne le document défini en variable globale
	Set xSIEm_xndGrou = gnd_Grou_xSIEm
End Function

</lotusscript></code><code event="xSIEm_xVarDepa"><lotusscript>Function xSIEm_xVarDepa(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIEm_xndDepa(p_Cle, p_Cache)
	xSIEm_xVarDepa = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSIEm_xValeurExisteTabl"><lotusscript>Function xSIEm_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xSIEm_xValeurExisteTabl = False
	
	If Not (xSIEm_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gnd_Tabl_xSIEm.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xSIEm_xValeurExisteTabl = True
		End If
	End If	
End Function

</lotusscript></code><code event="xSIEm_xVarEmpl_Nom"><lotusscript>Function xSIEm_xVarEmpl_Nom(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIEm_xndEmpl_Nom(p_Cle, p_Cache)
	xSIEm_xVarEmpl_Nom = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSIEm_xVarSDep"><lotusscript>Function xSIEm_xVarSDep(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIEm_xndSDep(p_Cle, p_Cache)
	xSIEm_xVarSDep = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSIEm_xndEmpl_Sup"><lotusscript>Function xSIEm_xndEmpl_Sup(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument
	' Cette fonction retourne un document du superviseur de l'employé
	
	' Extraire le document de l'employé
	Call xSIEm_xndEmpl(p_Cle, p_Cache)
	
	' Extraire le document du superviseur
	Call xSIEm_xndEmpl(xVar(gnd_Empl_xSIEm, "Empl_NoSuperviseur", 0), p_Cache)
	
	' Retourne le document défini en variable globale
	Set xSIEm_xndEmpl_Sup = gnd_Empl_xSIEm
End Function

</lotusscript></code><code event="xSIEm_xndcSup_Empl"><lotusscript>Function xSIEm_xndcSup_Empl(Byval p_Cle As Variant, Byval p_TypeEmpl As String) As NotesDocumentCollection
	' Cette fonction retourne les employés liés à un groupe
	Dim nv As NotesView
	Dim v_aliasVue As String
	Dim v_cle As Integer
	
	
	Select Case p_TypeEmpl
	Case 60 , 70 :
		v_aliasVue="v_Empl34"
		
	Case 50, 40  :
		v_aliasVue="v_Empl35"
			'p_Cle="C"
		
	Case Else    : 
		v_aliasVue="v_Empl14"
		p_Cle=Clng(p_Cle)
		
	End Select
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	Set nv = gndb_xSIEm.GetView(v_aliasVue)
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set xSIEm_xndcSup_Empl = nv.GetAllDocumentsByKey(p_Cle, True)
End Function


</lotusscript></code><code event="xSIEm_xndFili"><lotusscript>Function xSIEm_xndFili(Byval p_Cle As Variant, Byval p_Cache As Integer) As NotesDocument
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	
	' Changer le Cle en numerique!
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleFili_xSIEm, Clng(p_Cle), p_Cache, gndb_xSIEm, gc_NomVueFili_xSIEm, gnv_Fili_xSIEm, gnd_Fili_xSIEm)
	
	' Retourne le document défini en variable globale
	Set xSIEm_xndFili = gnd_Fili_xSIEm
End Function

</lotusscript></code><code event="xSIEm_xndEmpl_Nom"><lotusscript>Function xSIEm_xndEmpl_Nom(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument
