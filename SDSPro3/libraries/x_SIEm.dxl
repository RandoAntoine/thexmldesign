	Call xnd(gc_NomItemCleNom_xSIEm, p_Cle, p_Cache, gndb_xSIEm, gc_NomVueEmplNom_xSIEm, gnv_Empl_xSIEm, gnd_Empl_xSIEm)
	
	' Retourne le document défini en variable globale
	Set xSIEm_xndEmpl_Nom = gnd_Empl_xSIEm
End Function

</lotusscript></code><code event="xSIEm_xIcnTabl"><lotusscript>Function xSIEm_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xSIEm_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xSIEm_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xSIEm_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xSIEm_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xSIEm_xIcnTabl = v_Icones(0)
			Else
				xSIEm_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSIEm_xndTabl"><lotusscript>Function xSIEm_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xSIEm, "V_Tabl20", gnv_Tabl_xSIEm, gnd_Tabl_xSIEm)
	' Paramètres:	1	String.  Le nom du champs servant de clé dans le document recherché.
	'				2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'				3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'					au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'					déjà en mémoire. ** Ne pas modifier **
	'				4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'					** Déclarée dans les variables globales **
	'				5	String.  Le nom de la vue de recherche.
	'				6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'				7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'					contient True, le document envoyé sera retourné.
	'					** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xSIEm_xndTabl = gnd_Tabl_xSIEm
End Function

</lotusscript></code><code event="xSIEm_Initialisation"><lotusscript>Sub xSIEm_Initialisation
	' Initialisation des variables globales
	If gndb_xSIEm Is Nothing Then
		Set gndb_xSIEm = xGDK_xndbNDB(gc_NomBD_xSIEm)
	End If
End Sub

</lotusscript></code><code event="xSIEm_xndHDsp"><lotusscript>Function xSIEm_xndHDsp(Byval p_NoEmploye As Long, Byval p_TypeHeuresDisponibles As String) As Notesdocument
	' Cette fonction retourne un document du type approprié.
	
	Dim a_Cle(1) As Variant
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	
	a_Cle(0) = p_NoEmploye
	a_Cle(1) = p_TypeHeuresDisponibles
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("", a_Cle, False, gndb_xSIEm, gc_NomVueHDsp_xSIEm, gnv_HDsp_xSIEm, gnd_HDsp_xSIEm)
	
	' Retourne le document défini en variable globale
	Set xSIEm_xndHDsp = gnd_HDsp_xSIEm
End Function

</lotusscript></code><code event="xSIEm_xDescTabl"><lotusscript>Function xSIEm_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSIEm_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSIEm_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSIEm_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSIEm_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSIEm_xDescTabl = v_Descriptions(0)
			Else
				xSIEm_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSIEm_xVarEmpl"><lotusscript>Function xSIEm_xVarEmpl(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	If Isnumeric(p_Cle) Then
		Set nd = xSIEm_xndEmpl(Clng(p_Cle), p_Cache)
		xSIEm_xVarEmpl = xVar(nd, p_NomVar, p_ValeurNulle)
	End If
	
End Function

</lotusscript></code><code event="xSIEm_xVarSite_Empl"><lotusscript>Function xSIEm_xVarSite_Empl(Byval p_Cle As Integer, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'un site selon un emplacement
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIEm_xndSite_Empl(p_Cle, p_Cache)
	xSIEm_xVarSite_Empl = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSIEm_xndDepa"><lotusscript>Function xSIEm_xndDepa(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	
	' Changer le Cle en numerique!
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleDepa_xSIEm, Clng(p_Cle), p_Cache, gndb_xSIEm, gc_NomVueDepa_xSIEm, gnv_Depa_xSIEm, gnd_Depa_xSIEm)
	
	' Retourne le document défini en variable globale
	Set xSIEm_xndDepa = gnd_Depa_xSIEm
End Function

</lotusscript></code><code event="xSIEm_xndcGrou_Empl"><lotusscript>Function xSIEm_xndcGrou_Empl(Byval p_Cle As Variant) As NotesDocumentCollection
	' Cette fonction retourne les employés liés à un groupe
	Dim nv As NotesView
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	Set nv = gndb_xSIEm.GetView("v_Empl13")
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set xSIEm_xndcGrou_Empl = nv.GetAllDocumentsByKey(p_Cle, True)
End Function

</lotusscript></code><code event="xSIEm_xVarProf"><lotusscript>Function xSIEm_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	
	' Extraire le document de profil
	If gnd_Prof_xSIEm Is Nothing Then
		Set gnd_Prof_xSIEm = gndb_xSIEm.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_xSIEm Is Nothing Then
		xSIEm_xVarProf = p_ValeurNulle
	Else
		xSIEm_xVarProf = xVar(gnd_Prof_xSIEm, p_NomVar, p_ValeurNulle)
	End If
End Function

</lotusscript></code><code event="xSIEm_xndSite"><lotusscript>Function xSIEm_xndSite(Byval p_Cle As Variant, Byval p_Cache As Integer) As NotesDocument
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIEm_Initialisation
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleSite_xSIEm, p_Cle, p_Cache, gndb_xSIEm, gc_NomVueSite_xSIEm, gnv_Site_xSIEm, gnd_Site_xSIEm)
	
	' Retourne le document défini en variable globale
	Set xSIEm_xndSite = gnd_Site_xSIEm
End Function

</lotusscript></code><code event="xSIEm_xVarTabl"><lotusscript>Function xSIEm_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	Set nd = xSIEm_xndTabl(pCle, pCache)
	xSIEm_xVarTabl = xVar(nd, pNomVar, pValeurNulle)
	'	Paramètres:	1	Notesdocument.  Le document contenant la valeur recherchée.
	'					** Appel de la fonction d'extraction du document **
	'				2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'				3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'					recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xSIEm_xVarGrou"><lotusscript>Function xSIEm_xVarGrou(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
