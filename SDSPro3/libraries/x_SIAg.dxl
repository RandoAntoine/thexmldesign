lin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_SIAg" ou "SIAg" est 
'		l'identifiant de la base de documents (GDK).
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "SIAg" par l'identifiant de la base de documents.  
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "Trav" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xSIAg As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_SIAg As NotesDocument
Dim gnvTabl_xSIAg As Notesview
Dim gndTabl_xSIAg As Notesdocument
Dim gnv_Trav_xSIAg As Notesview					' La vue d'ou est extrait le document
Dim gnd_Trav_xSIAg As Notesdocument			' Le document qui contient les informations recherchées

' Section 3 - Les constantes à définir
Const gc_NomBD_xSIAg = "SIAg"		' Inscrire le nom usuel de la base de documents
																' de recherche, tel que déclaré dans le GDK.
Const gc_NomItemCleTrav_xSIAg = "Trav_NoTravail"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueTrav_xSIAg = "V_Trav20"		' Le nom de la vue de recherche

</lotusscript></code><code event="xSIAg_Initialisations"><lotusscript>Sub xSIAg_Initialisations
	' Initialisation des variables globales
	If gndb_xSIAg Is Nothing Then
		Set gndb_xSIAg = xGDK_xndbNDB(gc_NomBD_xSIAg)
	End If
End Sub

</lotusscript></code><code event="xSIAg_xValeurExisteTabl"><lotusscript>Function xSIAg_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xSIAg_xValeurExisteTabl = False
	
	If Not (xSIAg_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gndTabl_xSIAg.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xSIAg_xValeurExisteTabl = True
		End If
	End If	
End Function

</lotusscript></code><code event="xSIAg_xndTrav"><lotusscript>Function xSIAg_xndTrav(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIAg_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleTrav_xSIAg, p_Cle, p_Cache, gndb_xSIAg, gc_NomVueTrav_xSIAg, gnv_Trav_xSIAg, gnd_Trav_xSIAg)
	
	' Retourne le document défini en variable globale
	Set xSIAg_xndTrav = gnd_Trav_xSIAg
End Function

</lotusscript></code><code event="xSIAg_xDescTabl"><lotusscript>Function xSIAg_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSIAg_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSIAg_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSIAg_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSIAg_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSIAg_xDescTabl = v_Descriptions(0)
			Else
				xSIAg_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSIAg_xVarTabl"><lotusscript>Function xSIAg_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	Set nd = xSIAg_xndTabl(pCle, pCache)
	xSIAg_xVarTabl = xVar(nd, pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xSIAg_xVarProf"><lotusscript>Function xSIAg_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xSIAg_Initialisations
	
	' Extraire le document de profil
	If gnd_Prof_SIAg Is Nothing Then
		Set gnd_Prof_SIAg = gndb_xSIAg.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_SIAg Is Nothing Then
		xSIAg_xVarProf = p_ValeurNulle
	Else
		xSIAg_xVarProf = xVar(gnd_Prof_SIAg, p_NomVar, p_ValeurNulle)		
	End If
End Function

</lotusscript></code><code event="xSIAg_xIcnTabl"><lotusscript>Function xSIAg_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xSIAg_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xSIAg_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xSIAg_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xSIAg_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xSIAg_xIcnTabl = v_Icones(0)
			Else
				xSIAg_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSIAg_xndTabl"><lotusscript>Function xSIAg_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xSIAg_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xSIAg, "V_Tabl20", gnvTabl_xSIAg, gndTabl_xSIAg)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xSIAg_xndTabl = gndTabl_xSIAg
End Function

</lotusscript></code><code event="xSIAg_xVarTrav"><lotusscript>Function xSIAg_xVarTrav(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIAg_xndTrav(p_Cle, p_Cache)
	xSIAg_xVarTrav = xVar(nd, p_NomVar, p_ValeurNulle)
End Function</lotusscript></code>
