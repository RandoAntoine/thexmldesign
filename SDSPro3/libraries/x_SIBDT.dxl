<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'


</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub xBTra_Initialisation
Dim gndb_xSIBDT As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_xSIBDT As NotesDocument
Dim gnvTabl_xSIBDT As Notesview
Dim gndTabl_xSIBDT As NotesDocument
Dim gnv_xSIBDT As Notesview					' La vue d'ou est extrait le document
Dim gnd_xSIBDT As Notesdocument				' Le document qui contient les informations recherchées

' Section 3 - Les constantes à définir
Const gc_NomBD_xSIBDT = "SIBDT"							' Inscrire le nom usuel de la base de documents
														' de recherche, tel que déclaré dans le GDK.
Const gc_NomItemCleBTra_xSIBDT = "BTra_CleBonTravail"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVue_xSIBDT = "V_BTra20"					' Le nom de la vue de recherche

</lotusscript></code><code event="xSIBDT_xVarTabl"><lotusscript>Function xSIBDT_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	Set nd = xSIBDT_xndTabl(pCle, pCache)
	xSIBDT_xVarTabl = xVar(nd, pNomVar, pValeurNulle)
	
End Function

</lotusscript></code><code event="xSIBDT_xVarProf"><lotusscript>Function xSIBDT_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xSIBDT_Initialisations
	
	' Extraire le document de profil
	If gnd_Prof_xSIBDT Is Nothing Then
		Set gnd_Prof_xSIBDT = gndb_xSIBDT.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_xSIBDT Is Nothing Then
		xSIBDT_xVarProf = p_ValeurNulle
	Else
		xSIBDT_xVarProf = xVar(gnd_Prof_xSIBDT, p_NomVar, p_ValeurNulle)
	End If
End Function

</lotusscript></code><code event="xSIBDT_xValeurExisteTabl"><lotusscript>Function xSIBDT_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xSIBDT_xValeurExisteTabl = False
	
	If Not (xSIBDT_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gndTabl_xSIBDT.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xSIBDT_xValeurExisteTabl = True
		End If
	End If
End Function

</lotusscript></code><code event="xSIBDT_xndBT"><lotusscript>Function xSIBDT_xndBT(Byval p_Cle As Variant, Byval p_Cache As Integer) As NotesDocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIBDT_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomBD_xSIBDT, p_Cle, p_Cache, gndb_xSIBDT, gc_NomVue_xSIBDT, gnv_xSIBDT, gnd_xSIBDT)
	
	' Retourne le document défini en variable globale
	Set xSIBDT_xndBT = gnd_xSIBDT
End Function

</lotusscript></code><code event="xSIBDT_xDescTabl"><lotusscript>Function xSIBDT_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSIBDT_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSIBDT_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSIBDT_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSIBDT_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSIBDT_xDescTabl = v_Descriptions(0)
			Else
				xSIBDT_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSIBDT_xndTabl"><lotusscript>Function xSIBDT_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xSIBDT_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xSIBDT, "V_Tabl20", gnvTabl_xSIBDT, gndTabl_xSIBDT)
	
	' Retourne le document défini en variable globale
	Set xSIBDT_xndTabl = gndTabl_xSIBDT
End Function

</lotusscript></code><code event="xSIBDT_xVarBTra"><lotusscript>Function xSIBDT_xVarBTra(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIBDT_xndBTra(p_Cle, p_Cache)
	xSIBDT_xVarBTra = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSIBDT_xIcnTabl"><lotusscript>Function xSIBDT_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xSIBDT_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xSIBDT_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xSIBDT_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xSIBDT_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xSIBDT_xIcnTabl = v_Icones(0)
			Else
				xSIBDT_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSIBDT_Initialisations"><lotusscript>Sub xSIBDT_Initialisations
	' Initialisation des variables globales
	If gndb_xSIBDT Is Nothing Then
		Set gndb_xSIBDT = xGDK_xndbNDB(gc_NomBD_xSIBDT)
	End If
End Sub

</lotusscript></code><code event="xSIBDT_xndBTra"><lotusscript>Function xSIBDT_xndBTra(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIBDT_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleBTra_xSIBDT, p_Cle, p_Cache, gndb_xSIBDT, gc_NomVue_xSIBDT, gnv_xSIBDT, gnd_xSIBDT)
	
	' Retourne le document défini en variable globale
	Set xSIBDT_xndBTra = gnd_xSIBDT
End Function
</lotusscript></code><code event="xSIBDT_xndcBTra"><lotusscript>Function xSIBDT_xndcBTra(Byval p_Cle As Variant) As NotesDocumentCollection
	' Cette fonction retourne les employés liés à un groupe
	Dim nv As NotesView
	
	' Initialisation des variables globales
	Call xSIBDT_Initialisations
	Set nv = gndb_xSIBDT.GetView("v_BTra21")
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set xSIBDT_xndcBTra = nv.GetAllDocumentsByKey(p_Cle, True)
End Function</lotusscript></code>
