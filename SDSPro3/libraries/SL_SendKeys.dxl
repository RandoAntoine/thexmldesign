Private Const VK_SCROLL = &amp;H91     ' Scroll lock

Private Const VK_ESCAPE = &amp;H1B     ' Escape

Private Const VK_SPACE = &amp;H20      ' Space
Private Const VK_PRIOR = &amp;H21      ' Page Up
Private Const VK_NEXT = &amp;H22       ' Page Down
Private Const VK_END = &amp;H23' // End
Private Const VK_HOME = &amp;H24       ' Home
Private Const VK_LEFT = &amp;H25       ' Left arrow
Private Const VK_UP = &amp;H26 ' // Up arrow
Private Const VK_RIGHT = &amp;H27      ' Right arrow
Private Const VK_DOWN = &amp;H28       ' Down arrow
Private Const VK_SELECT = &amp;H29     ' Select??
Private Const VK_PRINT = &amp;H2A      ' Print Screen
Private Const VK_EXECUTE = &amp;H2B    ' Execute??


Private Const VK_SNAPSHOT = &amp;H2C   ' Snapshot??
Private Const VK_INSERT = &amp;H2D     ' Insert
Private Const VK_DELETE = &amp;H2E     ' Delete
Private Const VK_HELP = &amp;H2F       ' Help

Private Const VK_NUMPAD0 = &amp;H60
Private Const VK_NUMPAD1 = &amp;H61
Private Const VK_NUMPAD2 = &amp;H62
Private Const VK_NUMPAD3 = &amp;H63
Private Const VK_NUMPAD4 = &amp;H64
Private Const VK_NUMPAD5 = &amp;H65
Private Const VK_NUMPAD6 = &amp;H66
Private Const VK_NUMPAD7 = &amp;H67
Private Const VK_NUMPAD8 = &amp;H68
Private Const VK_NUMPAD9 = &amp;H69
Private Const VK_MULTIPLY = &amp;H6A
Private Const VK_ADD = &amp;H6B
Private Const VK_SEPARATOR = &amp;H6C
Private Const VK_SUBTRACT = &amp;H6D
Private Const VK_DECIMAL = &amp;H6E
Private Const VK_DIVIDE = &amp;H6F

' // Function Keys
Private Const VK_F1 = &amp;H70
Private Const VK_F2 = &amp;H71
Private Const VK_F3 = &amp;H72
Private Const VK_F4 = &amp;H73
Private Const VK_F5 = &amp;H74
Private Const VK_F6 = &amp;H75
Private Const VK_F7 = &amp;H76
Private Const VK_F8 = &amp;H77
Private Const VK_F9 = &amp;H78
Private Const VK_F10 = &amp;H79
Private Const VK_F11 = &amp;H7A
Private Const VK_F12 = &amp;H7B
Private Const VK_F13 = &amp;H7C
Private Const VK_F14 = &amp;H7D
Private Const VK_F15 = &amp;H7E
Private Const VK_F16 = &amp;H7F
Private Const VK_F17 = &amp;H80
Private Const VK_F18 = &amp;H81
Private Const VK_F19 = &amp;H82
Private Const VK_F20 = &amp;H83
Private Const VK_F21 = &amp;H84
Private Const VK_F22 = &amp;H85
Private Const VK_F23 = &amp;H86
Private Const VK_F24 = &amp;H87
Private intShiftOn As Integer
Private intControlOn As Integer
Private intAltOn As Integer

Declare Sub keybd_event Lib "user32" (Byval bVk As Any, Byval bScan As Any, Byval dwFlags As Long,_
Byval dwExtraInfo As Long)

Declare Function OemKeyScan Lib "user32" (Byval wOemChar As Integer) As Long

Declare Function CharToOem Lib "user32" Alias "CharToOemA" (Byval lpszSrc As String,_
Byval lpszDst As String) As Long

Declare Function VkKeyScan Lib "user32" Alias "VkKeyScanA" (Byval cChar As Any) As Integer

Declare Function MapVirtualKey Lib "user32" Alias "MapVirtualKeyA" (Byval wCode As Long,_
Byval wMapType As Long) As Long

Declare Sub DoSleep Lib "kernel32" (Byval dwMilliseconds As Long)

Declare Function FindExecutable Lib "shell32.dll" Alias "FindExecutableA"  (Byval lpFile As String,_
Byval lpDirectory As String, Byval lpResult As String) As Long

</lotusscript></code><code event="PushShiftKey"><lotusscript>Sub PushShiftKey(Byval strChar As String)
%REM
////////////////////////////////////////////////////////////////////////////////////////////////////
TITLE:				sub PushShiftKey
PURPOSE:			Routine to handle key presses whcih include the "SHIFT" key
CREATED:			Paul Carter, February 1998
PARAMETERS:	strChar - key being pressed
CALLED BY:		subs PushKeys, PushFNKey
CALLS:				sub PushAKey, API functions
MODIFIED:			Ben Poole - 04 Oct 2001 - code cleaned up w/more narrative too
NOTES:				Uses Win32 API calls
////////////////////////////////////////////////////////////////////////////////////////////////////
%ENDREM
	Dim intVKScan As Integer
	
	If Not intShiftOn Then
' // Turn shift on
		intVKScan = MapVirtualKey(VK_SHIFT, 0)
		keybd_event VK_SHIFT, intVKScan, 0, 0
	End If
	
' // Push key
	PushAKey strChar
	
	If Not intShiftOn Then
' // Turn shift off
		intVKScan = MapVirtualKey(VK_SHIFT, 0)
		keybd_event VK_SHIFT, intVKScan, KEYEVENTF_KEYUP, 0
	End If
End Sub



</lotusscript></code><code event="PushAKey"><lotusscript>Sub PushAKey(Byval strChar As String)
%REM
////////////////////////////////////////////////////////////////////////////////////////////////////
TITLE:				sub PushAKey
PURPOSE:			Traps the character being pressed via an API call
CREATED:			Paul Carter, February 1998
PARAMETERS:	strChar - character being pressed
CALLED BY:		subs PushKeys &amp; PushShiftKey
CALLS:				sub PressKey, API functions
MODIFIED:			Ben Poole - 04 Oct 2001 - code cleaned up w/more narrative too
NOTES:				Uses Win32 API calls
////////////////////////////////////////////////////////////////////////////////////////////////////
%ENDREM
	Dim intVirtualKey As Integer
	Dim intScan As Integer
	Dim strOEMChar As String
	
' // Get the virtual key code for this character
	intVirtualKey = VkKeyScan(Asc(strChar)) And &amp;HFF
	
	strOEMChar = "  " ' // 2 character buffer
	CharToOem strChar, strOEMChar
	
' // Get the keyboard scan code for this key
	intScan = OemKeyScan(Asc(strOEMChar)) And &amp;HFF
	
' // Press the key
	PressKey intVirtualKey, intScan
End Sub

</lotusscript></code><code event="PressKey"><lotusscript>Sub PressKey(Byval varVk As Variant, Byval varScan As Variant)
%REM
////////////////////////////////////////////////////////////////////////////////////////////////////
TITLE:				sub PressKey
PURPOSE:			Picks up keys being pressed
CREATED:			Paul Carter, February 1998
PARAMETERS:	varVK - the virtual key code of the key being pressed
						varScan - the keyboard scan code of the key being pressed
CALLED BY:		sub PushAKey
CALLS:				API functions
MODIFIED:			Ben Poole - 04 Oct 2001 - code cleaned up w/more narrative too
NOTES:				Uses Win32 API calls
////////////////////////////////////////////////////////////////////////////////////////////////////
%ENDREM
	keybd_event varVk, varScan, 0, 0
	keybd_event varVk, varScan, KEYEVENTF_KEYUP, 0
End Sub

</lotusscript></code><code event="PushFNKey"><lotusscript>Sub PushFNKey(strKeyCode As String)
%REM
////////////////////////////////////////////////////////////////////////////////////////////////////
TITLE:				sub PushFNKey
PURPOSE:			Routine to handle function key presses - e.g. when shift or CTRL are required
CREATED:			Paul Carter, February 1998
PARAMETERS:	strKeyCode - 
CALLED BY:		sub PushKeys when " { " is encountered which is SendKeys parlance denotes a function
						key like ALT, SHIFT or CTRL
CALLS:				
MODIFIED:			Ben Poole - 04 Oct 2001 - code cleaned up w/more narrative too
NOTES:				Uses Win32 API calls
////////////////////////////////////////////////////////////////////////////////////////////////////
%ENDREM
	Dim intScanKey As Integer
	Dim lngNumberOfPushes As Long
	Dim lngCtr As Integer
	Dim strFunctionKey As String
	Dim strOriginalCode As String
	
	On Error Goto lblPushFNKey_Errs
	
' // Work out which function key to push and how many times
	If Instr(strKeyCode, " ") &gt; 0 Then
' // We're doing this multiple times
' // Find the rightmost space, because we want to allow people to
' // output multiple words with spaces in them. e.g. "{Seven times 7}"
		lngCtr = Len(strKeyCode)
		Do While lngCtr &gt; 1 And Mid$(strKeyCode, lngCtr, 1) &lt;&gt; " "
			lngCtr = lngCtr - 1
		Loop
		strOriginalCode = Left$(strKeyCode, lngCtr - 1)
		strFunctionKey = Ucase(strOriginalCode)
' // This may fail if not a number, in which case lngNumberOfPushes will be 1
		lngNumberOfPushes = Cint(Right$(strKeyCode, Len(strKeyCode) - lngCtr))
	Else
' // Once only
		lngNumberOfPushes = 1
		strFunctionKey = Ucase(strKeyCode)
		strOriginalCode = strKeyCode
	End If
	
' // Function Keys
' // BTW, if you're reading my code, I do the for-next loop in each case rather
' // than outside the select because I figured it might be faster to do one Select
' // and the for-next loop n-times than do both the for-next and the Select &gt;n-times.
	Select Case strFunctionKey
	Case "BACKSPACE", "BS", "BKSP"
' // Backspace
		intScanKey = MapVirtualKey(VK_BACK, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_BACK, intScanKey
		Next lngCtr
	Case "BELL"
' // Bell = ^G
		intScanKey = MapVirtualKey(VK_BELL, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_BELL, intScanKey
		Next lngCtr
	Case "BREAK"
' // Break = ^C
		intScanKey = MapVirtualKey(VK_BREAK, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_BREAK, intScanKey
		Next lngCtr
	Case "CAPSLOCK", "CAPS"
' // Capslock
		intScanKey = MapVirtualKey(VK_CAPITAL, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_CAPITAL, intScanKey
		Next lngCtr
	Case "DELETE", "DEL"
' // Delete
		intScanKey = MapVirtualKey(VK_DELETE, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_DELETE, intScanKey
		Next lngCtr
	Case "DOWN"
' // Down Arrow
		intScanKey = MapVirtualKey(VK_DOWN, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_DOWN, intScanKey
		Next lngCtr
	Case "END"
' // End
		intScanKey = MapVirtualKey(VK_END, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_END, intScanKey
		Next lngCtr
	Case "ENTER", "RETURN"
' // Enter = ^M
		intScanKey = MapVirtualKey(VK_RETURN, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_RETURN, intScanKey
		Next lngCtr
	Case "ESCAPE", "ESC"
' // Escape = ^[
		intScanKey = MapVirtualKey(VK_ESCAPE, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_ESCAPE, intScanKey
		Next lngCtr
	Case "FORMFEED", "FF"
' // Form feed = ^L
		intScanKey = MapVirtualKey(VK_CLEAR, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_CLEAR, intScanKey
		Next lngCtr
	Case "HELP"
' // Help
		intScanKey = MapVirtualKey(VK_HELP, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_HELP, intScanKey
		Next lngCtr
	Case "HOME"
' // Home
		intScanKey = MapVirtualKey(VK_HOME, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_HOME, intScanKey
		Next lngCtr
	Case "INSERT", "INS"
' // Insert
		intScanKey = MapVirtualKey(VK_INSERT, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_INSERT, intScanKey
		Next lngCtr
	Case "LEFT"
' // Left Arrow
		intScanKey = MapVirtualKey(VK_LEFT, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_LEFT, intScanKey
		Next lngCtr
	Case "LINEFEED", "LF"
' // Linefeed = ^J
		intScanKey = MapVirtualKey(VK_LINEFEED, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_LINEFEED, intScanKey
		Next lngCtr
	Case "NEWLINE", "NL"
' // New line = Carriage return &amp; Line Feed = ^M^J
		For lngCtr = 1 To lngNumberOfPushes
			intScanKey = MapVirtualKey(VK_RETURN, 0)
			PressKey VK_RETURN, intScanKey
			intScanKey = MapVirtualKey(VK_LINEFEED, 0)
			PressKey VK_LINEFEED, intScanKey
		Next lngCtr
	Case "NUMLOCK"
' // Numeric Lock
		intScanKey = MapVirtualKey(VK_NUMLOCK, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMLOCK, intScanKey
		Next lngCtr
	Case "PGDN", "PAGEDOWN", "NEXT"
' // Page Down
		intScanKey = MapVirtualKey(VK_NEXT, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NEXT, intScanKey
		Next lngCtr
	Case "PGUP", "PAGEUP", "PRIOR"
' // Page Up
		intScanKey = MapVirtualKey(VK_PRIOR, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_PRIOR, intScanKey
		Next lngCtr
	Case "PRINTSCREEN", "PRTSC"
' // Print Screen
		intScanKey = MapVirtualKey(VK_PRINT, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_PRINT, intScanKey
		Next lngCtr
	Case "RIGHT"
' // Right Arrow
		intScanKey = MapVirtualKey(VK_RIGHT, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_RIGHT, intScanKey
		Next lngCtr
	Case "SCROLLLOCK", "SCRLK"
' // Scroll lock
		intScanKey = MapVirtualKey(VK_SCROLL, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_SCROLL, intScanKey
		Next lngCtr
	Case "TAB"
' // Tab = ^I
		intScanKey = MapVirtualKey(VK_TAB, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_TAB, intScanKey
		Next lngCtr
	Case "UP"
' // Up Arrow
		intScanKey = MapVirtualKey(VK_UP, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_UP, intScanKey
		Next lngCtr
	Case "SLEEP"
' // We sleep for a few seconds
		DoSleep lngNumberOfPushes * 1000
	Case "F1"
' // F1
		intScanKey = MapVirtualKey(VK_F1, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F1, intScanKey
		Next lngCtr
	Case "F2"
' // F2
		intScanKey = MapVirtualKey(VK_F2, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F2, intScanKey
		Next lngCtr
	Case "F3"
' // F3
		intScanKey = MapVirtualKey(VK_F3, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F3, intScanKey
		Next lngCtr
	Case "F4"
' // F4
		intScanKey = MapVirtualKey(VK_F4, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F4, intScanKey
		Next lngCtr
	Case "F5"
' // F5
		intScanKey = MapVirtualKey(VK_F5, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F5, intScanKey
		Next lngCtr
	Case "F6"
' // F6
		intScanKey = MapVirtualKey(VK_F6, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F6, intScanKey
		Next lngCtr
	Case "F7"
' // F7
		intScanKey = MapVirtualKey(VK_F7, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F7, intScanKey
		Next lngCtr
	Case "F8"
' // F8
		intScanKey = MapVirtualKey(VK_F8, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F8, intScanKey
		Next lngCtr
	Case "F9"
' // F9
		intScanKey = MapVirtualKey(VK_F9, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F9, intScanKey
		Next lngCtr
	Case "F10"
' // F10
		intScanKey = MapVirtualKey(VK_F10, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F10, intScanKey
		Next lngCtr
	Case "F11"
' // F11
		intScanKey = MapVirtualKey(VK_F11, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F11, intScanKey
		Next lngCtr
	Case "F12"
' // F12
		intScanKey = MapVirtualKey(VK_F12, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F12, intScanKey
		Next lngCtr
	Case "F13"
' // F13
		intScanKey = MapVirtualKey(VK_F13, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F13, intScanKey
		Next lngCtr
	Case "F14"
' // F14
		intScanKey = MapVirtualKey(VK_F14, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F14, intScanKey
		Next lngCtr
	Case "F15"
' // F15
		intScanKey = MapVirtualKey(VK_F15, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F15, intScanKey
		Next lngCtr
	Case "F16"
' // F16
		intScanKey = MapVirtualKey(VK_F16, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F16, intScanKey
		Next lngCtr
	Case "F17"
' // F17
		intScanKey = MapVirtualKey(VK_F17, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F17, intScanKey
		Next lngCtr
	Case "F18"
' // F18
		intScanKey = MapVirtualKey(VK_F18, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F18, intScanKey
		Next lngCtr
	Case "F19"
' // F19
		intScanKey = MapVirtualKey(VK_F19, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F19, intScanKey
		Next lngCtr
	Case "F20"
' // F20
		intScanKey = MapVirtualKey(VK_F20, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F20, intScanKey
		Next lngCtr
	Case "F21"
' // F21
		intScanKey = MapVirtualKey(VK_F21, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F21, intScanKey
		Next lngCtr
	Case "F22"
' // F22
		intScanKey = MapVirtualKey(VK_F22, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F22, intScanKey
		Next lngCtr
	Case "F23"
' // F23
		intScanKey = MapVirtualKey(VK_F23, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F23, intScanKey
		Next lngCtr
	Case "F24"
' // F24
		intScanKey = MapVirtualKey(VK_F24, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_F24, intScanKey
		Next lngCtr
	Case "NUMPAD0"
' // Numeric Keypad 0
		intScanKey = MapVirtualKey(VK_NUMPAD0, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMPAD0, intScanKey
		Next lngCtr
	Case "NUMPAD1"
' // Numeric Keypad 1
		intScanKey = MapVirtualKey(VK_NUMPAD1, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMPAD1, intScanKey
		Next lngCtr
	Case "NUMPAD2"
' // Numeric Keypad 2
		intScanKey = MapVirtualKey(VK_NUMPAD2, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMPAD2, intScanKey
		Next lngCtr
	Case "NUMPAD3"
' // Numeric Keypad 3
		intScanKey = MapVirtualKey(VK_NUMPAD3, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMPAD3, intScanKey
		Next lngCtr
	Case "NUMPAD4"
' // Numeric Keypad 4
		intScanKey = MapVirtualKey(VK_NUMPAD4, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMPAD4, intScanKey
		Next lngCtr
	Case "NUMPAD5"
' // Numeric Keypad 5
		intScanKey = MapVirtualKey(VK_NUMPAD5, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMPAD5, intScanKey
		Next lngCtr
	Case "NUMPAD6"
' // Numeric Keypad 6
		intScanKey = MapVirtualKey(VK_NUMPAD6, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMPAD6, intScanKey
		Next lngCtr
	Case "NUMPAD7"
' // Numeric Keypad 7
		intScanKey = MapVirtualKey(VK_NUMPAD7, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMPAD7, intScanKey
		Next lngCtr
	Case "NUMPAD8"
' // Numeric Keypad 8
		intScanKey = MapVirtualKey(VK_NUMPAD8, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMPAD8, intScanKey
		Next lngCtr
	Case "NUMPAD9"
' // Numeric Keypad 9
		intScanKey = MapVirtualKey(VK_NUMPAD9, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_NUMPAD9, intScanKey
		Next lngCtr
	Case "NUMPADMULTIPLY", "NUMPAD*"
' // Numeric Keypad Multiply
		intScanKey = MapVirtualKey(VK_MULTIPLY, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_MULTIPLY, intScanKey
		Next lngCtr
	Case "NUMPADADD", "NUMPAD+"
' // Numeric Keypad +
		intScanKey = MapVirtualKey(VK_ADD, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_ADD, intScanKey
		Next lngCtr
	Case "NUMPADSUBTRACT", "NUMPAD-"
' // Numeric Keypad -
		intScanKey = MapVirtualKey(VK_SUBTRACT, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_SUBTRACT, intScanKey
		Next lngCtr
	Case "NUMPADDECIMAL", "NUMPAD."
' // Numeric Keypad .
		intScanKey = MapVirtualKey(VK_DECIMAL, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_DECIMAL, intScanKey
		Next lngCtr
	Case "NUMPADDIVIDE", "NUMPAD/"
' // Numeric Keypad /
		intScanKey = MapVirtualKey(VK_DIVIDE, 0)
		For lngCtr = 1 To lngNumberOfPushes
			PressKey VK_DIVIDE, intScanKey
		Next lngCtr
		
		Case "~", "!", "@", "#", "$", "%", "^", "&amp;", "*", "(", ")", "_", "+","|", "{", "}",_
	"""", ":", "?", "&gt;", "&lt;"
' // Shifted keys
		For lngCtr = 1 To lngNumberOfPushes
			PushShiftKey strOriginalCode
		Next lngCtr
		
	Case Else
' // Ordinary keys
		For lngCtr = 1 To lngNumberOfPushes
			PushKeys strOriginalCode
		Next lngCtr
	End Select
	Exit Sub
	
lblPushFNKey_Errs:
' // Should only occur when the number of pushes isn't an integer
	lngNumberOfPushes = 1
	Resume Next
End Sub

</lotusscript></code><code event="PushKeys"><lotusscript>Sub PushKeys(Byval strSource As String)
%REM
////////////////////////////////////////////////////////////////////////////////////////////////////
TITLE:				sub PushKeys
PURPOSE:			Main routine which takes input and calls sub-routines to put together SendKeys
CREATED:			Paul Carter, February 1998
PARAMETERS:	strSource - text representing the key(s) we want to press
CALLED BY:		Whatever routine requires SendKeys
CALLS:				subs PushFNKey, PushAKey, PushShiftKey, API functions
MODIFIED:			Ben Poole - 04 Oct 2001 - code cleaned up w/more narrative too
NOTES:				Uses Win32 API calls
////////////////////////////////////////////////////////////////////////////////////////////////////
%ENDREM
	Dim lngCtr As Long
	Dim intVKScan As Integer
	Dim strSubString As String
	Dim intBracketCount As Integer
	Dim strOpenBracket As String
	Dim strCloseBracket As String
	Dim strTempChar As String
	
	intShiftOn = False
	intControlOn = False
	intAltOn = False
	
' // Add a space to solve Mid$ problems. We won't process it.
	strSource = strSource + " "
	lngCtr = 1
	Do While lngCtr &lt;= Len(strSource) - 1
		
		Select Case Mid$(strSource, lngCtr, 1)
		Case "+"
' // Shift key pressed
			strOpenBracket = Mid$(strSource, lngCtr + 1, 1)
			If strOpenBracket = "(" Or strOpenBracket = "{" Then
				Select Case strOpenBracket
				Case "("
					strCloseBracket = ")"
				Case "{"
					strCloseBracket = "}"
				End Select
				
				lngCtr = lngCtr + 1
				strSubString = ""
				intBracketCount = 1
				Do While lngCtr &lt;= Len(strSource) And intBracketCount &lt;&gt; 0
					lngCtr = lngCtr + 1
					strTempChar = Mid$(strSource, lngCtr, 1)
					If strTempChar &lt;&gt; strCloseBracket Then
						strSubString = strSubString + Mid$(strSource, lngCtr, 1)
					Else
						intBracketCount = intBracketCount - 1
					End If
					If strTempChar = strOpenBracket Then intBracketCount = intBracketCount + 1
				Loop
				
				If Not intShiftOn Then
' // Turn shift on
					intVKScan = MapVirtualKey(VK_SHIFT, 0)
					keybd_event VK_SHIFT, intVKScan, 0, 0
					intShiftOn = True
				End If
				
' // Push the keys
				Select Case strOpenBracket
				Case "("
					PushKeys strSubString
				Case "{"
					PushFNKey strSubString
				End Select
				
' // Turn shift off
				intVKScan = MapVirtualKey(VK_SHIFT, 0)
				keybd_event VK_SHIFT, intVKScan, KEYEVENTF_KEYUP, 0
				intShiftOn = False
			Else
' // The next key is shifted
				lngCtr = lngCtr + 1
				PushShiftKey Mid$(strSource, lngCtr, 1)
			End If
			
		Case "^"
' // Control key pressed
			strOpenBracket = Mid$(strSource, lngCtr + 1, 1)
			If strOpenBracket = "(" Or strOpenBracket = "{" Then
				Select Case strOpenBracket
				Case "("
					strCloseBracket = ")"
				Case "{"
					strCloseBracket = "}"
				End Select
				
				lngCtr = lngCtr + 1
				strSubString = ""
				intBracketCount = 1
				Do While lngCtr &lt;= Len(strSource) And intBracketCount &lt;&gt; 0
					lngCtr = lngCtr + 1
					strTempChar = Mid$(strSource, lngCtr, 1)
					If strTempChar &lt;&gt; strCloseBracket Then
						strSubString = strSubString + Mid$(strSource, lngCtr, 1)
					Else
						intBracketCount = intBracketCount - 1
					End If
					If strTempChar = strOpenBracket Then intBracketCount = intBracketCount + 1
				Loop
				
				If Not intControlOn Then
' // Turn control on
					intVKScan = MapVirtualKey(VK_CONTROL, 0)
					keybd_event VK_CONTROL, intVKScan, 0, 0
					intControlOn = True
				End If
				
' // Push the keys
				Select Case strOpenBracket
				Case "("
					PushKeys strSubString
				Case "{"
					PushFNKey strSubString
				End Select
				
' // Turn control off
				intVKScan = MapVirtualKey(VK_CONTROL, 0)
				keybd_event VK_CONTROL, intVKScan, KEYEVENTF_KEYUP, 0
				intControlOn = False
			Else
' // The next key is controlled
				lngCtr = lngCtr + 1
				If Not intControlOn Then
					intVKScan = MapVirtualKey(VK_CONTROL, 0)
					keybd_event VK_CONTROL, intVKScan, 0, 0
				End If
				PushAKey Mid$(strSource, lngCtr, 1)
				intVKScan = MapVirtualKey(VK_CONTROL, 0)
				keybd_event VK_CONTROL, intVKScan, KEYEVENTF_KEYUP, 0
			End If
			
		Case "%"
' // Alt key pressed
			strOpenBracket = Mid$(strSource, lngCtr + 1, 1)
			If strOpenBracket = "(" Or strOpenBracket = "{" Then
				Select Case strOpenBracket
				Case "("
					strCloseBracket = ")"
				Case "{"
					strCloseBracket = "}"
				End Select
				
				lngCtr = lngCtr + 1
				strSubString = ""
				intBracketCount = 1
				Do While lngCtr &lt;= Len(strSource) And intBracketCount &lt;&gt; 0
					lngCtr = lngCtr + 1
					strTempChar = Mid$(strSource, lngCtr, 1)
					If strTempChar &lt;&gt; strCloseBracket Then
						strSubString = strSubString + Mid$(strSource, lngCtr, 1)
					Else
						intBracketCount = intBracketCount - 1
					End If
					If strTempChar = strOpenBracket Then intBracketCount = intBracketCount + 1
				Loop
				
				If Not intAltOn Then
    ' // Turn Alt on
					intVKScan = MapVirtualKey(VK_MENU, 0)
					keybd_event VK_MENU, intVKScan, 0, 0
					intAltOn = True
				End If
				
  ' // Push the keys
				Select Case strOpenBracket
				Case "("
					PushKeys strSubString
				Case "{"
					PushFNKey strSubString
				End Select
				
  ' // Turn alt off
				intVKScan = MapVirtualKey(VK_MENU, 0)
				keybd_event VK_MENU, intVKScan, KEYEVENTF_KEYUP, 0
				intAltOn = False
			Else
  ' // The next key is Alted
				lngCtr = lngCtr + 1
				If Not intAltOn Then
					intVKScan = MapVirtualKey(VK_MENU, 0)
					keybd_event VK_MENU, intVKScan, 0, 0
				End If
				PushAKey Mid$(strSource, lngCtr, 1)
				intVKScan = MapVirtualKey(VK_MENU, 0)
				keybd_event VK_MENU, intVKScan, KEYEVENTF_KEYUP, 0
			End If
			
		Case "{"
' // Function keys
			lngCtr = lngCtr + 1
			strSubString = ""
			Do While lngCtr &lt; Len(strSource) And Mid$(strSource, lngCtr, 1) &lt;&gt; "}"
				strSubString = strSubString + Mid$(strSource, lngCtr, 1)
				lngCtr = lngCtr + 1
			Loop
			If Mid$(strSource, lngCtr, 1) = "}" And Mid$(strSource, lngCtr + 1, 1) = "}" Then
' // Right brace
				PushShiftKey "}"
				lngCtr = lngCtr + 1
			Else
				PushFNKey strSubString
			End If
			
		Case "A" To "Z", "!", "@", "#", "$", "&amp;", "*", "(", ")", "_", "|", """", ":", "?", "&gt;", "&lt;"
' // Shifted keys
			PushShiftKey Mid$(strSource, lngCtr, 1)
			
		Case "~"
' // The enter key
			PushFNKey "ENTER"
			
		Case Else
			PushAKey Mid$(strSource, lngCtr, 1)
			
		End Select
		
		lngCtr = lngCtr + 1
	Loop
	
	If intShiftOn Then
' // Turn shift off if need be
		intVKScan = MapVirtualKey(VK_SHIFT, 0)
		keybd_event VK_SHIFT, intVKScan, KEYEVENTF_KEYUP, 0
	End If
	If intControlOn Then
' // Turn control off if need be
		intVKScan = MapVirtualKey(VK_CONTROL, 0)
		keybd_event VK_CONTROL, intVKScan, KEYEVENTF_KEYUP, 0
	End If
	If intAltOn Then
' // Turn alt off if need be
		intVKScan = MapVirtualKey(VK_MENU, 0)
		keybd_event VK_MENU, intVKScan, KEYEVENTF_KEYUP, 0
	End If
End Sub</lotusscript></code>
