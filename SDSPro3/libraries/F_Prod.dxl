</lotusscript></code><code event="FProd_QueryRecalc"><lotusscript>Sub FProd_QueryRecalc(puid_Source As NotesUIDocument)

	On Error GoTo GererErreur
	
	' Initialisations
	Call FProd_Initialisations
	
	If xVarImplode(gnuid_FProd.Document, g_NomItem_FProd, "") &lt;&gt; g_ValeurItem_FProd Then
		
		If g_NomItem_FProd = "Prod_FraisEntretienMensuels" Then
			Call gnd_FProd.ReplaceItemValue("Prod_FraisEntretienAnnuels", (SItN_Round(xVar(gnd_FProd, g_NomItem_FProd, 0), 2) * 12))
			
		ElseIf g_NomItem_FProd = "Prod_FraisEntretienAnnuels" Then
			If xVar(gnd_FProd,"Prod_FraisEntretienMensuelsModifie", "") = "0" Then					
				Call gnd_FProd.ReplaceItemValue("Prod_FraisEntretienMensuels", ( xVar(gnd_FProd, g_NomItem_FProd, 0) / 12))
				
			elseif xVar(gnd_FProd,"Prod_FraisEntretienMensuelsModifie", "") = "1" And xVar(gnd_FProd,"Prod_FraisEntretienModifie", "") = "1" Then		
				Call gnd_FProd.ReplaceItemValue("Prod_FraisEntretienAnnuels", (SItN_Round(xVar(gnd_FProd, "Prod_FraisEntretienMensuels", 0), 2) * 12))				
			End If
		End If	
		
		g_ValeurItem_FProd = xVarImplode(gnuid_FProd.Document, g_NomItem_FProd, "")					
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, GetThreadInfo(1), "", False)
	Exit Sub
End Sub</lotusscript></code>
