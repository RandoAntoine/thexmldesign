</lotusscript></code><code event="FProd_hsFraisEntretienMensNonModifiable"><lotusscript>Function FProd_hsFraisEntretienMensNonModifiable
	' ----------------------------------------------------------------------
	' Le script permet au directeur de modifier les frais d'entretien Mensuel
	' ----------------------------------------------------------------------
	On Error GoTo GererErreur
	
	' Initialisations
	Call FProd_Initialisations
	
	' Rendre le prix non modifiable
	Call gnd_FProd.ReplaceItemValue( "Prod_FraisEntretienMensuelsModifie", "0")
	
	' Recalculer les prix et les coûts sans faire une sauvegarde du doc.
	If Not SDSPX_RecalculerPrix(gnd_Prop, gnd_FProd, False, False, False, 0, gnd_Log) Then
		MessageBox xGDK_xMessage("SDSP", 15, "", xVar(gnd_FProd, "Prod_CodeProduit", "")), 16, xGDK_xMessage("SI", 1, "", "")
		gnd_FProd.Prod_Statut = "E"
	Else
		gnd_FProd.Prod_Statut = ""
	End If
	
	
	Call gnuid_FProd.RefreshHideFormulas
	On Error 4412 Resume Next
	Call gnuid_FProd.Refresh
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="FProd_Entering"><lotusscript>Sub FProd_Entering
	On Error Goto GererErreur
	
	Dim nuiws As NotesUIWorkspace
	
	Call FProd_Initialisations
	
	If gnuid_FProd Is Nothing Then
		Set nuiws = New Notesuiworkspace
		Set gnuid_FProd = nuiws.CurrentDocument
		Call gnuid_FProd.Refresh
	End If
	
	g_NomItem_FProd = gnuid_FProd.CurrentField
	g_ValeurItem_FProd = xVarImplode(gnuid_FProd.Document, g_NomItem_FProd, "")
	
	Call gnuiws_FProd.CurrentDocument.Selectall
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, Getthreadinfo(1), "", False)
	Exit Sub
End Sub

