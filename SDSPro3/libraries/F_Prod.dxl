=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mourad Zellouf/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SDSP_Produit"
Use "x_SDSP3L"



</lotusscript></code><code event="declarations"><lotusscript>' Déclarations globales
' ----------------------------------
Dim gnuiws_FProd As NotesUIWorkspace
Dim gnuid_FProd As NotesUIDocument

Dim gns_FProd As Notessession
Dim gndb_FProd As Notesdatabase
Dim gnd_FProd As NotesDocument

Dim gnd_Prop As NotesDocument
Dim gnd_Site As NotesDocument
Dim gnd_Log As NotesDocument


' Entering/Exiting
Dim g_NomItem_FProd As String
Dim g_ValeurItem_FProd As String
Dim g_MajNbUtilisateurs_FProp As Boolean

' Liste des champs modifiable
Dim gl_NomItems_FProd List As Variant

Dim g_Quantite As Integer

' Traitement des erreurs
' -----------------------------------
Const gc_TypeElement_FProd = "SL"
Const gc_Element_FProd = "F_Prod"

</lotusscript></code><code event="FProd_QuerySave"><lotusscript>Sub FProd_QuerySave(pnuid_Source As Notesuidocument, p_Continue As Variant)
	On Error Goto GererErreur
	
	Dim v_NbUtilisateursCalcule As Long
	
	' Initialisations
	p_Continue = False
	
	Call FProd_Initialisations
	
	v_NbUtilisateursCalcule = xVar(gnd_FProd, "Prod_NbUtilisateursCalcule", 0)
	
	If g_Quantite &lt;&gt; xVar(gnd_FProd, "Prod_Quantite", 0) Then
		' Maj quatité dépendants et composants
		Call SDSPX_ModifierComposantsDependants(gnd_Prop, gnd_Site, gnd_FProd, "C")
		Call SDSPX_ModifierComposantsDependants(gnd_Prop, gnd_Site, gnd_FProd, "D")
		
		'Req#58184
		If xVar(gnd_FProd, "Prod_Quantite", 0) &lt;&gt; xVar(gnd_FProd, "Prod_QuantiteListe", 0) Then
			Call gnd_FProd.ReplaceItemValue( "Prod_QuantiteModifiee", "1")
		Else
			Call gnd_FProd.ReplaceItemValue( "Prod_QuantiteModifiee", "0")
		End If	
		
	End If
	
	
	g_MajNbUtilisateurs_FProp = False
	If gl_NomItems_FProd("Prod_NbUtilisateursCalcule") &lt;&gt; v_NbUtilisateursCalcule Then
		' Recalculer les prix et les coûts sans faire une sauvegarde du doc.
		If Not SDSPX_RecalculerPrix(gnd_Prop, gnd_FProd, False, False, False, v_NbUtilisateursCalcule, gnd_Log) Then
			Messagebox xGDK_xMessage("SDSP", 15, "", xVar(gnd_FProd, "Prod_CodeProduit", "")), 16, xGDK_xMessage("SI", 1, "", "")
			gnd_FProd.Prod_Statut = "E"
		Else
			gnd_FProd.Prod_Statut = ""
			g_MajNbUtilisateurs_FProp = True
		End If
	End If
	
	' Maj historique
	gnd_FProd.HistoDM = Now
	gnd_FProd.HistoUM = gns_FProd.UserName
	
	' Maj historique de la proposition
	gnd_Prop.HistoDP = Now
	gnd_Prop.HistoUP = gns_FProd.UserName
	Call gnd_Prop.Save(True, False)
	
	On Error 4412 Resume Next
	Call pnuid_Source.Refresh
	'Call pnuid_Source.RefreshHideFormulas
	
	p_Continue = True
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, Getthreadinfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FProd_hsPrixNonModifiable"><lotusscript>Function FProd_hsPrixNonModifiable
	' -------------------------------------------------
	' Le script permet au directeur de modifier le prix
	' -------------------------------------------------
	On Error Goto GererErreur
	
	' Initialisations
	Call FProd_Initialisations
	
	' Rendre le prix non modifiable
	Call gnd_FProd.ReplaceItemValue( "Prod_PrixModifie", "0")
	
	' Recalculer les prix et les coûts sans faire une sauvegarde du doc.
	If Not SDSPX_RecalculerPrix(gnd_Prop, gnd_FProd, False, False, False, 0, gnd_Log) Then
		Messagebox xGDK_xMessage("SDSP", 15, "", xVar(gnd_FProd, "Prod_CodeProduit", "")), 16, xGDK_xMessage("SI", 1, "", "")
		gnd_FProd.Prod_Statut = "E"
	Else
		gnd_FProd.Prod_Statut = ""
	End If
	
	Call gnuid_FProd.RefreshHideFormulas
	On Error 4412 Resume Next
	Call gnuid_FProd.Refresh
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="FProd_Exiting"><lotusscript>Sub FProd_Exiting
	On Error Goto GererErreur
	
	Dim v_Quantite As Variant
	Dim v_FractionQuantite As Variant	
	
	Call FProd_Initialisations
	
	If g_NomItem_FProd &lt;&gt; "" Then
		
		If xVarImplode(gnuid_FProd.Document, g_NomItem_FProd, "") &lt;&gt; g_ValeurItem_FProd Then
			
			Select Case g_NomItem_FProd
				
			Case  "Prod_FraisEntretienMensuels"					
				Call gnd_FProd.ReplaceItemValue("Prod_FraisEntretienAnnuels", (SItN_Round(xVar(gnd_FProd, g_NomItem_FProd, 0), 2) * 12))
				Call gnuid_FProd.Refresh
				
			Case  "Prod_FraisEntretienAnnuels"	
				If xVar(gnd_FProd,"Prod_FraisEntretienMensuelsModifie", "") &lt;&gt; "1" Then					
					Call gnd_FProd.ReplaceItemValue("Prod_FraisEntretienMensuels", ( xVar(gnd_FProd, g_NomItem_FProd, 0) / 12))
				ElseIf xVar(gnd_FProd,"Prod_FraisEntretienMensuelsModifie", "") = "1" And xVar(gnd_FProd,"Prod_FraisEntretienModifie", "") = "1" Then		
					Call gnd_FProd.ReplaceItemValue("Prod_FraisEntretienAnnuels", (xVar(gnd_FProd, "Prod_FraisEntretienMensuels", 0) * 12))				
				End If
				Call gnuid_FProd.Refresh
				
			Case "Prod_Quantite"
				v_Quantite = xVar(gnd_FProd, g_NomItem_FProd, "")
				
				If v_Quantite &lt;&gt; "" Then					
					v_FractionQuantite = Fraction(CDbl(v_Quantite))
					
					If Len(v_FractionQuantite) = 2 Then
						If Right(v_FractionQuantite,1) = 5 Then
							Call gnd_FProd.ReplaceItemValue("Prod_Quantite",v_Quantite)
						Else
							Call gnd_FProd.ReplaceItemValue("Prod_Quantite",SItN_Round(v_Quantite, 0))
						End If
					Else
						Call gnd_FProd.ReplaceItemValue("Prod_Quantite",SItN_Round(v_Quantite, 0))
					End If
				End If
				
				On Error 4412 GoTo formatnum
				Call gnuid_FProd.Refresh
				
		End Select
			
			g_NomItem_FProd = gnuid_FProd.CurrentField
			g_ValeurItem_FProd = xVarImplode(gnuid_FProd.Document, g_NomItem_FProd, "")
			
		End If
		
		'g_NomItem_FProd = ""
		'g_NomItem_FProd = gnuid_FProd.CurrentField
		'g_ValeurItem_FProd = xVarImplode(gnuid_FProd.Document, g_NomItem_FProd, "")
	End If
	
	Exit Sub
	
formatnum:
	Call gnuid_FProd.FieldSetText("Prod_Quantite", Cstr(SItN_cdbl(gnuid_FProd.FieldgetText(g_NomItem_FProd))))
	Call gnuid_FProd.Refresh
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, Getthreadinfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FProd_hsFraisEntretienModifiable"><lotusscript>Function FProd_hsFraisEntretienModifiable
	' -------------------------------------------------
	' Le script permet au directeur de modifier le cout
	' -------------------------------------------------
	On Error Goto GererErreur
	
	' Initialisations
	Call FProd_Initialisations
	
	' Rendre le prix modifiable
	Call gnd_FProd.ReplaceItemValue( "Prod_FraisEntretienModifie", "1")
	Call gnd_FProd.ReplaceItemValue( "Prod_FraisEntretienListe", xVar(gnd_FProd, "Prod_FraisEntretienAnnuels", 0))
	
	Call gnuid_FProd.RefreshHideFormulas
	On Error 4412 Resume Next
	Call gnuid_FProd.Refresh
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="FProd_hsCoutModifiable"><lotusscript>Function FProd_hsCoutModifiable
	' -------------------------------------------------
	' Le script permet au directeur de modifier le cout
	' -------------------------------------------------
	On Error Goto GererErreur
	
	' Initialisations
	Call FProd_Initialisations
	
	' Rendre le prix modifiable
	Call gnd_FProd.ReplaceItemValue( "Prod_CoutModifie", "1")
	Call gnd_FProd.ReplaceItemValue( "Prod_CoutListe", xVar(gnd_FProd, "Prod_CoutUnitaire", 0))
	
	Call gnuid_FProd.RefreshHideFormulas
	On Error 4412 Resume Next
	Call gnuid_FProd.Refresh
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="FProd_PostOpen"><lotusscript>Sub FProd_PostOpen(puid_Source As NotesUIDocument)
	On Error Goto GererErreur
	
	' Initialisations
	Call FProd_Initialisations
	
	g_Quantite = xVar(puid_Source.Document, "Prod_Quantite", 0)	
	
	
	gl_NomItems_FProd("Prod_Quantite") = xVar(puid_Source.Document, "Prod_Quantite", 0)
	gl_NomItems_FProd("Prod_PrixUnitaire") = xVar(puid_Source.Document, "Prod_PrixUnitaire", 0)
	gl_NomItems_FProd("Prod_CoutUnitaire") = xVar(puid_Source.Document, "Prod_CoutUnitaire", 0)
	gl_NomItems_FProd("Prod_NbUtilisateursCalcule") = xVar(puid_Source.Document, "Prod_NbUtilisateursCalcule", 0)
	gl_NomItems_FProd("Prod_FraisEntretienAnnuels") = xVar(puid_Source.Document, "Prod_FraisEntretienAnnuels", 0)
	gl_NomItems_FProd("Prod_FraisEntretienMensuels") = xVar(puid_Source.Document, "Prod_FraisEntretienMensuels", 0)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, Getthreadinfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FProd_hsPrixModifiable"><lotusscript>Function FProd_hsPrixModifiable
	' -------------------------------------------------
	' Le script permet au directeur de modifier le prix
