End Function

</lotusscript></code><code event="FProd_hsAfficherPrix"><lotusscript>Sub FProd_hsAfficherPrix
	On Error GoTo GererErreur
	
	Dim nd_Prod_SDSBB As NotesDocument
	Dim v_CleProduit As String
	Dim v_CleProduitAH As String
	Dim ndc_Prix_SDSBB As NotesDocumentCollection
	
	' Initialisations
	Call FProd_Initialisations
	
	v_CleProduit = XVar(gnd_FProd, "Prod_CleProduit","")
	
	Set nd_Prod_SDSBB = xSDSBB_xndProd(v_CleProduit, True)
	
	If nd_Prod_SDSBB Is Nothing Then
		Exit Sub
	End If
	
	v_CleProduitAH = xVar(nd_Prod_SDSBB, "Prod_CleProduitAH", "")
	
	Set nd_Prod_SDSBB = xSDSBB_xndProd(v_CleProduitAH, True)
	
	If nd_Prod_SDSBB Is Nothing Then
		Exit Sub
	End If
	
	Set ndc_Prix_SDSBB = gnuiws_FProd.Picklistcollection(PICKLIST_CUSTOM, False, _
	xGDK_xVarNDB("SDSBB", "NDB_Serveur", "", True), xGDK_xVarNDB("SDSBB", "NDB_Fichier", "", True), _
	"V_Prix22", xGDK_xMessage("SDSPP", 165, "", ""), xGDK_xMessage("SDSPP", 166, "", xVar(nd_Prod_SDSBB, "Prod_CodeProduit", "")) , v_CleProduitAH)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FProd_Initialisations"><lotusscript>Sub FProd_Initialisations
	If gns_FProd Is Nothing Then
		Set gnuiws_FProd = New NotesUIWorkspace
		Set gnuid_FProd = gnuiws_FProd.Currentdocument
		
		Set gns_FProd= New Notessession
		Set gndb_FProd= gns_FProd.Currentdatabase
		
		Set gnd_FProd = gnuid_FProd.Document
		
		Set gnd_Prop = xSDSP3_xndProp(xVar(gnd_FProd, "Prod_NoProposition", "") , True)
		Set gnd_Site =  xSDSP3_xndSite(xVar(gnd_FProd, "Prod_NoSite", "") , True)
		
		Set gnd_Log = New NotesDocument(gndb_FProd)
		
	End If
End Sub



</lotusscript></code><code event="FProd_PostSave"><lotusscript>Function FProd_PostSave(p_Source As NotesUIDocument) As Boolean
	On Error Goto GererErreur
	
	Dim nd_Log As NotesDocument
	Dim v_NbUtilisateursCalcule As Long
	
	
	FProd_PostSave = False
	
	' Initialisations
	Call FProd_Initialisations
	Call SDSPX_Initialisations
	
	' Recalculerle prix des dépendants en fonction du nb d'utilisateurs
	If g_MajNbUtilisateurs_FProp Then
		v_NbUtilisateursCalcule = xVar(gnd_FProd, "Prod_NbUtilisateursCalcule", 0)
		Call SDSPX_RecalculerPrixDependants(gnd_Prop, gnd_FProd, True, False, True, v_NbUtilisateursCalcule, gnd_Log)
	End If
	
	If g_Quantite &lt;&gt; xVar(gnd_FProd, "Prod_Quantite", 0)	 Then
		g_Quantite = xVar(gnd_FProd, "Prod_Quantite", 0)
	End If
	
	If xVarProf("Prof_LogProduits", "") = "1" Then
		Forall ValeurItem In gl_NomItems_FProd	
			If xVar(gnd_FProd, Listtag(ValeurItem), 0) &lt;&gt; ValeurItem Then
				
				If nd_Log Is Nothing Then
					Set nd_Log  = New NotesDocument(gndb_SDSPX)
				End If
				
				Call nd_Log.ReplaceItemValue("Prec_" &amp; Strright(Listtag(ValeurItem), "_"), ValeurItem)
				Call nd_Log.ReplaceItemValue(Listtag(ValeurItem), xVar(gnd_FProd, Listtag(ValeurItem), 0) )
				nd_Log.Prod_EnvoyerLog = "1"
				
				gl_NomItems_FProd(Listtag(ValeurItem)) = xVar(gnd_FProd, Listtag(ValeurItem), 0)
				
			End If
		End Forall
		
		
	' Envoyer le log
		If xVar(nd_Log, "Prod_EnvoyerLog", "") = "1" Then
			Call SDSPX_EnvoyerLog(gnd_Prop, gnd_FProd, nd_Log, SIGE_FormatterNomFonction(Getthreadinfo(1)))
		End If
	End If
	
	FProd_PostSave = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FProd, gc_Element_FProd, Getthreadinfo(1), "", False)
End Function

</lotusscript></code><code event="FProd_hsCoutNonModifiable"><lotusscript>Function FProd_hsCoutNonModifiable
