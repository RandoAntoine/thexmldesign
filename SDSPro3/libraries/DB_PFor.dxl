que</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Explicit
Use "SI_Google"
'
'	Les fonctions définies dans cette bibliothèque de script permettent la gestion de tous les
'	opérations reliés au formulaire Table | F_Tabl.
'

</lotusscript></code><code event="declarations"><lotusscript>Dim gns_DB As NotesSession
Dim gndb_DB As NotesDatabase
Dim gnuiws_DB As NotesUIWorkspace

' Traitement des erreurs
Const gc_TypeElement_DB = "SL"
Const gc_Element_DB = "DB_PFor"

</lotusscript></code><code event="DB_Querysave"><lotusscript>Function DB_Querysave(pnuid_Source As Notesuidocument) As Boolean
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	
	DB_Querysave = False
	
	Call DB_Initialisations
	Set nd = pnuid_Source.Document
	
	If xVar(nd, "Calc_VoitureDistance", 0) = 0 Then
		Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
		Call pnuid_Source.GotoField("Calc_VoitureDistance0")
		Exit Function
	End If
	
	If xVar(nd, "Calc_VoitureHeures", 0) = 0 Then
		Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
		Call pnuid_Source.GotoField("Calc_VoitureHeures0")
		Exit Function
	End If
	
	If xVar(nd, "Calc_AvionCout", 0) = 0 Then
		Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
		Call pnuid_Source.GotoField("Calc_AvionCout0")
		Exit Function
	End If
	
	If xVar(nd, "Calc_AvionHeures", 0) = 0 Then
		Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
		Call pnuid_Source.GotoField("Calc_AvionHeures0")
		Exit Function
	End If
	
	If xVar(nd, "Calc_VoitureLocation", 0) = 0 Then
		Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
		Call pnuid_Source.GotoField("Calc_VoitureLocation0")
		Exit Function
	End If
	
	If xVar(nd, "Calc_HotelCout", 0) = 0 Then
		Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
		Call pnuid_Source.GotoField("Calc_HotelCout0")
		Exit Function
	End If
	
	If xVar(nd, "Calc_RepasCout", 0) = 0 Then
		Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
		Call pnuid_Source.GotoField("Calc_RepasCout0")
		Exit Function
	End If
	
	DB_Querysave = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_DB, gc_Element_DB, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="DB_Initialisations"><lotusscript>Sub DB_Initialisations
	If gns_DB Is Nothing Then
		Set gns_DB = New NotesSession
		Set gndb_DB = gns_DB.CurrentDatabase
		Set gnuiws_DB = New NotesUIWorkspace
	End If
End Sub

</lotusscript></code><code event="DB_hsRecalculerDistance"><lotusscript>Sub DB_hsRecalculerDistance
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	Dim v_Latitude As Double
	Dim v_Longitude As Double
	Dim v_VoitureDistance As Double
	Dim v_VoitureHeures As Long
	Dim d As Double
	
	Call DB_Initialisations
	Set nd = gnuiws_DB.CurrentDocument.Document
	
	v_Latitude = xVar(nd, "Calc_Latitude", 0)
	v_Longitude = xVar(nd, "Calc_Longitude", 0)
	If v_Latitude &lt;&gt; 0 Then
		Call SIGg_Distance("", Replace(Cstr(v_Latitude), ",", ".") &amp; "," &amp; Replace(Cstr(v_Longitude) , ",", "."), v_VoitureDistance, v_VoitureHeures, xGDK_xVarProf("Prof_CleGoogleAPI", ""))
		nd.Calc_VoitureDistance = Round(v_VoitureDistance, 2)
		d = v_VoitureHeures \ 3600
		v_VoitureHeures = v_VoitureHeures - (d * 3600)
		If v_VoitureHeures &gt; 1800 Then
			nd.Calc_VoitureHeures = d + 1
		Else
			nd.Calc_VoitureHeures = d + .5
			
		End If
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_DB, gc_Element_DB, GetThreadInfo(1), "", False)
	Exit Sub
End Sub</lotusscript></code>
