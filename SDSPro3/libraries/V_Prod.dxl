<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "SI_GestionErreurs"
Use "x_SDSP3"

</lotusscript></code><code event="declarations"><lotusscript>Dim gns_VProd As notesSession
Dim gndb_VProd As NotesDatabase

Dim gnuiws_VProd As notesuiworkspace

' Traitement des erreurs
Const gc_TypeElement_VProd = "SL"
Const gc_Element_VProd = "V_Prod"

</lotusscript></code><code event="VProd_Initialisations"><lotusscript>Sub VProd_Initialisations
	If gns_VProd Is Nothing Then
		Set gns_VProd = New notesSession
		Set gndb_VProd = gns_VProd.CurrentDatabase
		
		Set gnuiws_VProd = New notesuiworkspace
	End If
End Sub

</lotusscript></code><code event="VProd_acQueryOpenDocument"><lotusscript>Sub VProd_acQueryOpenDocument(pnuid_Source As Notesuiview, p_Continue As Variant)
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	Dim nd_Prop As NotesDocument
	Dim v_Statut As String
	
	' Initialisations
	p_Continue = False
	Call VProd_Initialisations
	Set nd = pnuid_Source.Documents.GetFirstDocument
	
	Set nd_Prop = xSDSP3_xndProp(xVar(nd, "Prod_NoProposition", ""), True)
	v_Statut = xVar(nd_Prop, "Prop_Statut", "10")
	If Left(v_Statut, 1) &lt; "5" And xVar(nd, "Prod_NoContratFmt_CS", "") = "" Then
		Call gnuiws_VProd.EditDocument(True, nd)
	Else
		Call gnuiws_VProd.EditDocument(False, nd, True)
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_VProd, gc_Element_VProd, Getthreadinfo(1), "", False)
	Exit Sub
End Sub</lotusscript></code>
