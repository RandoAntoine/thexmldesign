<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_GestionErreurs"

</lotusscript></code><code event="declarations"><lotusscript>Dim gns_DBPDep As NotesSession
Dim gndb_DBPDep As NotesDatabase
Dim gnuiws_DBPDep As NotesUIWorkspace

' Traitement des erreurs
Const gc_TypeElement_DBPDep = "SL"
Const gc_Element_DBPDep = "DB_PDep"

</lotusscript></code><code event="DBPDep_Queryclose"><lotusscript>Function DBPDep_Queryclose(p_Source As NotesUIDocument) As Boolean
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	Set nd = p_Source.Document
	Dim i As Integer
	Dim v_ValeurItem As String
	
	' Initialisations
	DBPDep_Queryclose = False
	
	If p_Source.DialogBoxCanceled = False Then
		
		For i = 1 To 20
			v_ValeurItem = xVar(nd, "DB_Quantite" &amp; Cstr(i), "")
			If  v_ValeurItem &lt;&gt; "" Then
				If Not Isnumeric(v_ValeurItem) Then
					Messagebox xGDK_xMessage("SI", 12, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
					Exit Function
				End If
			End If
			
		Next
	End If
	
	
	DBPDep_Queryclose = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_DBPDep, gc_Element_DBPDep, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="DBPDep_Initialisations"><lotusscript>Sub DBPDep_Initialisations
	On Error Goto GererErreur
	
	If gns_DBPDep Is Nothing Then
		Set gns_DBPDep = New NotesSession
		Set gndb_DBPDep = gns_DBPDep.CurrentDatabase
		Set gnuiws_DBPDep = New NotesUIWorkspace
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_DBPDep, gc_Element_DBPDep, GetThreadInfo(1), "", False)
	Exit Sub
End Sub</lotusscript></code>
