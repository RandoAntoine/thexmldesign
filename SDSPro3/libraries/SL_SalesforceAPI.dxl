Function SLSf_GetBearerToken(ByVal p_URL As String, ByVal p_ClientId As String, ByVal p_ClientSecret As String, ByVal p_Username As String, ByVal p_Password As String, _
	ByVal p_UserSecret As String, p_ReponseJSON As String) As Integer
	' Permet de récupérer le jeton d'identification
	On Error GoTo GererErreur
	
	Dim objHttp As Variant
	Dim v_Data As String
	Dim v_ReponseHTTP As String
	Dim v_CodeErreur As Integer

	SLSf_GetBearerToken = 0
	
	v_Data = |grant_type=password&amp;client_id=| &amp; p_ClientId &amp; |&amp;client_secret=| &amp; p_ClientSecret &amp; |&amp;username=| &amp; p_Username &amp; |&amp;password=| &amp; p_Password &amp; p_UserSecret
	If g_LogAPI_SLSf = 1 Then
	End If
	
	' --- instantiate an MSXML XMLHTTP object
	'	Set objHttp = CreateObject("Microsoft.XMLHTTP")
	Set objHttp = CreateObject("MSXML2.ServerXMLHTTP")

	' --- open a new GET request and set the Content-type header 
	objHttp.open "POST", p_url, False
	objHttp.setRequestHeader "Content-type", "application/x-www-form-urlencoded"
	objHttp.send v_Data
	v_ReponseHTTP = objHTTP.Status
	p_ReponseJSON = objHttp.responseText
	Set objHttp = Nothing
	
	If CInt(v_ReponseHTTP) &lt; 300 Then
		SLSf_GetBearerToken = 1
	Else
		SLSf_GetBearerToken = -282
		v_CodeErreur = 1
		Call SIGE_EnregistrerErreurManuelle(gc_TypeElement_SLSf, gc_Element_SLSf,  GetThreadInfo(1), 0, v_ReponseHTTP, "URL = " &amp; p_URL &amp; Chr(13) &amp; p_ReponseJSON) 
	End If
	
	If g_LogAPI_SLSf = 1 Or (g_LogAPI_SLSf = 2 And v_CodeErreur = 1) Then
		Call SIGe_AjouterLog("--SLSf_GetBearerToken-----------------------------------------------------------------------------------------------", 0, 0, False)
		Call SIGe_AjouterLog("URL = POST " &amp; p_URL, 0, 0, False)
		'Call SIGe_AjouterLog("Data  = " &amp; v_Data, 0, 0, False)
		Call SIGe_AjouterLog("Réponse " &amp; v_ReponseHTTP, 0, 0, False)
		Call SIGe_AjouterLog(p_ReponseJSON, v_CodeErreur, 0, False)
		Call SIGe_AjouterLog("--------------------------------------------------------------------------------------------------------------------", 0, 0, False)
	End If
	Exit Function
	
GererErreur:
	SLSf_GetBearerToken = -24
	Set objHttp = Nothing
	Call SIGE_TraiterErreur(gc_TypeElement_SLSf, gc_Element_SLSf, GetThreadInfo(1), p_URL, False)
