</lotusscript></code><code event="FPNav_acOuvrirBonTravail"><lotusscript>Sub FPNav_acOuvrirBonTravail
	On Error GoTo GererErreur
	
	Dim nd_BTra As NotesDocument
	Dim ndc_BTra As NotesDocumentCollection
	Dim nuid As NotesUIDocument
	Dim nv_BTra As NotesView	
	Dim v_NoProp As String
	Dim a_NoBCSites As Variant	
	Dim v_NbPropositionFmt As String
	
	'Initialisations
	Call xSIBDT_Initialisations
	
	Set nv_BTra = gndb_xSIBDT.GetView("v_BTra73")
	Call nv_BTra.Refresh
	
	
	'Verifier si Bon de commande existe	
	v_NoProp = xVar(gnd_SDSPM, "Prop_NoProposition", "")	
	a_NoBCSites = Evaluate(|@DbLookup("" : "NoCache"; ""; "V_Site21"; "| &amp; v_NoProp &amp; |"; 10;[FailSilent])|)
	
	If IsArray(a_NoBCSites) Then		
		
		v_NbPropositionFmt = xVar(gnd_SDSPM, "Prop_NbPropositionFmt", "")
		Set ndc_BTra = nv_BTra.GetAllDocumentsByKey(v_NbPropositionFmt, True)
		
		If ndc_Btra.Count = 0 Then
			MessageBox xGDK_xMessage("SI", 70, "", ""), 16, xGDK_xMessage("SI", 1, "", "")				
			Exit Sub
			
		ElseIf ndc_BTra.count = 1 Then
			
			Set nd_BTra = ndc_BTra.getfirstDocument
			
		Else 
			' Sélectionner un bon de travail
			Set nd_Btra = SISe_ndPickList(nv_BTra, xGDK_xMessage("SIBDT", 40, "", ""), v_NbPropositionFmt)				
			
		End If
		
		' Ouvrir le bon de travail		
		If Not nd_Btra Is Nothing Then
			Set nuid = gnuiws_SDSPN.EditDocument( False , nd_Btra)	
		End If		
		
		
	Else

		MessageBox xGDK_xMessage("SI", 70, "", ""), 16, xGDK_xMessage("SI", 1, "", "")				
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_SauvegarderDocument"><lotusscript>Function FPNav_SauvegarderDocument(p_ValiderDocument As Variant) As Boolean
	On Error GoTo GererErreur
	
	Dim v_NoOptionCourante As String
	Dim v_NoOptionMax As String
	Dim v_DocumentValide As Boolean
	Dim v_MajNotesContrat As Boolean
	
	If xVar(gnd_SDSPM, "PNav_EditMode", False) Then
		FPNav_SauvegarderDocument = False
	Else
		FPNav_SauvegarderDocument = True
		Exit Function
	End If
	
	' Calculer les champs automatiques
	On Error 4412 GoTo FinSub
	Call gnuid_SDSPN.Refresh
	On Error 4412 GoTo GererErreur
	
	' Valider le document courant
	v_NoOptionCourante = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "0.00")
	v_NoOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionMax", "0.00")
	If p_ValiderDocument = "" Then
		v_DocumentValide = FPNav_DocumentValide(CInt(v_NoOptionCourante &lt; v_NoOptionMax))
	Else
		v_DocumentValide = FPNav_DocumentValide(CInt(p_ValiderDocument))
	End If
	If v_DocumentValide = False Then
		If p_ValiderDocument = True Then
			Call gnuid_SDSPN.RefreshHideFormulas
			Exit Function
		End If
		
		gnd_SDSPM.PNav_MenuOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "")
	End If
	
	' Extraire la proposition
	If Not SDSPM_InitProp("") Then
		Exit Function
	End If
	
	' Mettre à jour la proposition
	
	v_MajNotesContrat = SDSPM_MajItem(gnd_Prop_SDSPM, "Prop_NotesContrat", "")
	FPNav_SauvegarderDocument = v_MajNotesContrat Or FPNav_SauvegarderDocument	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DescProposition", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "PNav_MenuOptionMax", "") Or FPNav_SauvegarderDocument
		
	If v_MajNotesContrat Then		
		If  xVar(gnd_SDSPM, "Prop_NotesContrat", "") = "" Then			
			Call gnd_SDSPM.ReplaceItemValue("PNav_MenuHide" &amp; xVar(gnd_SDSPM, "PNav_MenuItemCourant", ""), "2")			
		Else
			Call gnd_SDSPM.ReplaceItemValue("PNav_MenuHide" &amp; xVar(gnd_SDSPM, "PNav_MenuItemCourant", ""), "3")			
		End If
		'Mettre à jour le document de navigation
		'Call SDSPN_MajSitesNav(gnd_SDSPM)
		'Call SDSPN_ConstruireMenu(gnd_SDSPM)
		Call gnuid_SDSPN.Refresh
	End If
		
	If FPNav_SauvegarderDocument Then
		gnd_Prop_SDSPM.HistoDM = Now
		gnd_Prop_SDSPM.HistoUM = gns_SDSPM.UserName
		Call gnd_Prop_SDSPM.Save(True, False)
	End If
	
	FPNav_SauvegarderDocument = True
FinSub:	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acCreerBonDeCommande"><lotusscript>Sub FPNav_acCreerBonDeCommande
