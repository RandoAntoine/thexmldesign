</lotusscript></code><code event="FPNAv_ndSelectionnerParagraphe"><lotusscript>Function FPNAv_ndSelectionnerParagraphe As NotesDocument
' ------------------------------------------------------------------------------
' Le script permet de sélectionner un paragraphe type (défini dans SDS Base II).
' ------------------------------------------------------------------------------
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	Dim ndc As NotesDocumentCollection
	Dim nv_Para21 As NotesView
	
	' Initialisations
	Set FPNAv_ndSelectionnerParagraphe = Nothing
	
	Call xSDSBB_Initialisations
	
	If gnuiws_FPNAv Is Nothing Then
		Set gnuiws_FPNav = New NotesUIWorkspace
	End If
	
	' Vérifier qu'il existe des paragraphes types
	Set nv_Para21 = gndb_xSDSBB.Getview("V_Para21")
	Call nv_Para21.Refresh
	Set nd = nv_Para21.Getfirstdocument
	If nd Is Nothing Then
		MessageBox xGDK_xMessage("SDSPP", 119, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		' 119: Aucun paragraphe type trouvé dans SDS Base II.
		'   1: Opération annulée
		Exit Function
	End If
	
	' Sélectionner un paragraphe type
	Set ndc = gnuiws_FPNav.Picklistcollection(PICKLIST_CUSTOM, False, gndb_xSDSBB.Server, gndb_xSDSBB.Filepath, _
	"V_Para21", "Paragraphes", "Sélectionner un paragraphe")
	
	If ndc.Count &gt; 0 Then
		Set FPNAv_ndSelectionnerParagraphe = ndc.GetFirstDocument
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), "", False)
	Exit Function
End Function

