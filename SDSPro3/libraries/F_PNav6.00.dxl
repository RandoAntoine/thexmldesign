</lotusscript></code><code event="FPNav_Initialisations"><lotusscript>Sub FPNav_Initialisations
	If gns_FPNav Is Nothing Then
		Set gns_FPNav = New NotesSession
		Set gndb_FPNav = gns_FPNav.CurrentDatabase
		
		Set gnuiws_FPNav = New NotesUIWorkspace
		Set gnuid_FPNav = gnuiws_FPNav.CurrentDocument
	End If
End Sub

</lotusscript></code><code event="FPNav_acWorkflow"><lotusscript>Sub FPNav_acWorkflow(p_Statut As String)
	On Error GoTo GererErreur
		
	If SDSPM_acWorkflow(p_Statut) Then
		
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		Call gnuiws_SDSPM.ViewRefresh
		
		' Ouvrir le masque	
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		
		gnd_SDSPM.PNav_Titre =  Trim("C" &amp; CStr(xVar(gnd_Prop_SDSPM, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(gnd_Prop_SDSPM, "Prop_ClientNomInterne", xVar(gnd_Prop_SDSPM, "Prop_ClientNom", "")))
		gnd_SDSPM.Titre =  Trim(xVar(gnd_SDSPM, "PNav_Titre", "") &amp; " - " &amp; xVar(gnd_SDSPM, "PNav_MenuDesc000", ""))
				
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbProposition", xVar(gnd_Prop_SDSPM, "Prop_NbProposition", 0))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionFmt", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionFmt", ""))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionPrefixe", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionPrefixe", ""))		
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
		
		Call gnuid_SDSPN.Refresh
	End If
		
	Exit Sub
		
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acSignerProposition"><lotusscript>Sub FPNav_acSignerProposition
	On Error Goto GererErreur
	
	If SDSPUI_acSignerProposition(gnd_Prop_SDSPM, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		
		Call gnuiws_SDSPM.ViewRefresh
		
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acRecalculerCouts"><lotusscript>Sub FPNav_acRecalculerCouts
' -------------------------------------------------
' Le script permet au directeur de modifier le prix
