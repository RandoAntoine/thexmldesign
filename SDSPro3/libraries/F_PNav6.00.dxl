i/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>' Serveurs
Option Public
Option Declare
Use "wsc_SDSP3"
Use "SDSP_MasquePNav"
Use "SDSP_Navigation"
Use "SL_ClipBoard"

</lotusscript></code><code event="declarations"><lotusscript>' Déclarations globales
' ---------------------
Dim gns_FPNav As NotesSession
Dim gndb_FPNav As NotesDatabase

Dim gnuiws_FPNav As NotesUIWorkspace
Dim gnuid_FPNav As NotesUIDocument

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_FPNav = "SL"
Const gc_Element_FPNav = "F_PNav6.00"



</lotusscript></code><code event="FPNav_AjouterParagraphe"><lotusscript>Sub FPNav_AjouterParagraphe(pnuid As NotesUIDocument)
' ------------------------------------------------------------------------------
' Le script ajoute un paragraphe (défini dans Paragraphes types de SDS Bases II)
'  là où se trouve le curseur
'
' Paramètre:
' 	p_nuid :	Document courant
' ------------------------------------------------------------------------------
	
	On Error Goto GererErreur
	
	Dim nd_Paragraphe As NotesDocument
	Dim nd As NotesDocument
	
	' Vérifier que le curseur est placé dans un champ qui peut recevoir un paragraphe
	If pnuid.CurrentField = "Prop_NotesContrat" Then
		' Sélectionner le paragraphe
		Set nd_Paragraphe = FPNav_ndSelectionnerParagraphe
	Else
		Messagebox xGDK_xMessage("SDSPP", 118, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		' 118: Impossible d'ajouter un paragraphe à ce champ.
		'   1: Opération annulée
		Exit Sub
	End If
	
	' Insérer le paragraphe
	If Not (nd_Paragraphe Is Nothing) Then
		Call pnuid.InsertText(xVar(nd_Paragraphe, "Para_Paragraphe", ""))
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentValide"><lotusscript>Function FPNav_DocumentValide(p_AfficherErreur As Boolean) As Boolean
	On Error Goto GererErreur
	
	FPNav_DocumentValide = False
	
	If xVar(gnd_SDSPM, "Prop_DescProposition", "") = "" Then
		If p_AfficherErreur Then
			MessageBox xGDK_xMessage("SI", 23, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_DescProposition")
		End If
		Exit Function
	End If
	
	FPNav_DocumentValide = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acImage"><lotusscript>Sub FPNav_acImage
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument("") Then
		Exit Sub
	End If
	
	Call SDSPM_acImage(gnd_Prop_SDSPM)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_hsAnnuler"><lotusscript>Sub FPNav_hsAnnuler
	On Error Goto GererErreur
	
	gnd_SDSPM.SaveOptions = "0"
	Call gnuid_SDSPN.Close
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_QuerySave"><lotusscript>Sub FPNav_QuerySave(pnuid_Source As Notesuidocument, p_Continue As Variant)
	On Error Goto GererErreur
	
	' Sauvegarder l'étape courante
	p_Continue = FPNav_SauvegarderDocument("")
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acGenererCommande"><lotusscript>Sub FPNav_acGenererCommande
	On Error GoTo GererErreur
	
	Call SDSPUI_acGenererCommande(gnd_Prop_SDSPM)
	
	Call gnuid_SDSPM.Refreshhideformulas
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsCopierItemContrat"><lotusscript>Sub FPNav_hsCopierItemContrat (p_NomItem As String)
	' Le script permet de copier le champ Prop_DescProposition dans le clipboard de windows
	
	On Error GoTo GererErreur
	
	Dim v_ValeurItem As String
	Dim v_noMsg As Integer
	
	Select Case p_NomItem
		Case "Prop_DescProposition"  'Description
			v_noMsg = 187		
		Case "Prop_NotesContrat"  'Contract Notes
			v_noMsg = 189		
	End Select
	
		
	v_ValeurItem = xVar(gnd_SDSPM, p_NomItem, "")
	

	If v_ValeurItem &lt;&gt; "" Then
		Call SLCl_AssignerTexteClipBoard(v_ValeurItem)
		MessageBox xGDK_xMessage("SDSPP", v_noMsg + 1, "", v_ValeurItem), 64, xGDK_xMessage("SI", 10, xLangue, "")
	Else
		MessageBox xGDK_xMessage("SDSPP", v_noMsg , "", v_ValeurItem), 64, xGDK_xMessage("SI", 10, xLangue, "")
	End If
	
	Exit Sub
	
	
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), "", False)
	Exit Sub
End Sub


