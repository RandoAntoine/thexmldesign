</lotusscript></code><code event="FPNav_SauvegarderDocument"><lotusscript>Function FPNav_SauvegarderDocument(p_ValiderDocument As Variant) As Boolean
	On Error GoTo GererErreur
	
	Dim v_NoOptionCourante As String
	Dim v_NoOptionMax As String
	Dim v_DocumentValide As Boolean
	Dim v_UserName As String
	
	
	v_UserName = gns_SDSPM.UserName
	
	If xVar(gnd_SDSPM, "PNav_EditMode", False) Then
		FPNav_SauvegarderDocument = False
	Else
		FPNav_SauvegarderDocument = True
		Exit Function
	End If
	
	' Valider le document courant
	v_NoOptionCourante = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "0.00")
	v_NoOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionMax", "0.00")
	If p_ValiderDocument = "" Then
		v_DocumentValide = FPNav_DocumentValide(CInt(v_NoOptionCourante &lt; v_NoOptionMax))
	Else
		v_DocumentValide = FPNav_DocumentValide(CInt(p_ValiderDocument))
	End If
	If v_DocumentValide = False Then
		If p_ValiderDocument = True Then
			Call gnuid_SDSPN.RefreshHideFormulas
			Exit Function
		End If
		
		gnd_SDSPM.PNav_MenuOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "")
	End If
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DescProposition", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "Prop_NomGroupeClient", xVar(gnd_SDSPM, "Prop_NomGroupeClient", ""))
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "Prop_VersionSDS", xVar(gnd_SDSPM, "Prop_VersionSDS", "")) Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "Prop_VersionOS", xVar(gnd_SDSPM, "Prop_VersionOS", "")) Or FPNav_SauvegarderDocument
			
	If FPNav_SauvegarderDocument Then
		gnd_Prop_SDSPM.HistoDM = Now
		gnd_Prop_SDSPM.HistoUM = v_UserName
		Call gnd_Prop_SDSPM.Save(True, False)		
	End If
	
	' Calculer les champs automatiques
	On Error 4412 GoTo FinSub
	Call gnuid_SDSPN.Refresh
	On Error 4412 GoTo GererErreur
	
	FPNav_SauvegarderDocument = True
FinSub:
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_hsAfficherPropositions"><lotusscript>Sub FPNav_hsAfficherPropositions
	On Error GoTo GererErreur
	
	Dim nd As NotesDocument
	Dim v_ClientNoFmt As String
	

	' Construire le document d'affichage
	Set nd = New NotesDocument(gndb_SDSPM)
	
	nd.Form = "F_PrCl"
	'v_ClientNoFmt = xVar(gnd_SDSPM, "Clie_NoClientFmt", "") 
	v_ClientNoFmt = xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") 
	nd.PrCl_NoProposition = xVar(gnd_SDSPM, "Prop_NoProposition", "") 
	nd.PrCl_ClientNoFmt = v_ClientNoFmt
				
	If v_ClientNoFmt &lt;&gt; "" Then 
		
		nd.PrCl_ClientNomInterne = xVar(gnd_SDSPM, "Prop_ClientNomInterne", "")
		nd.PrCl_ClientNom = xVar(gnd_SDSPM, "Prop_ClientNom", "") 
		
		Call gnuiws_SDSPM.EditDocument(False, nd, True, "")
		
		
	Else
		' Il n'existe aucune autre proposition pour le client.
		'Le Site n'est pas assigné a un client existant". MZE #62955	
		MessageBox xGDK_xMessage("SDSPP", 202, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
	End If
	
	
	Exit Sub
	
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SDSPM, gc_Element_SDSPM, GetThreadInfo(1), "", False)		
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acVerifierProduits"><lotusscript>Sub FPNav_acVerifierProduits
	'--------------------------------------------------------------------------------------------------------------------
	'	Ce script compare, pour chaque produit de la proposition, la commission avec SDS Base II.
	'	La commission du produit est mise à jour si différente.
	'--------------------------------------------------------------------------------------------------------------------
	On Error GoTo GererErreur
	
	If SDSPX_VerifierProduits(gnd_Prop_SDSPM, True) Then
		Call gnuid_SDSPM.Refresh
	End If
	
	Print "Vérification des produits disponibles terminée"

FinSub:	
	Exit Sub 

GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub


