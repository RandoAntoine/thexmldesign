GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_ndClientOrigine"><lotusscript>Function FPNav_ndClientOrigine(pnd_PNav As NotesDocument, pnd As NotesDocument, p_Origine As String, p_Cache As Boolean) As Boolean
	On Error GoTo GererErreur
	
	Dim nd_Proj As NotesDocument
	Dim v_ClientNoFmt As String
	
	FPNav_ndClientOrigine = False
	Set pnd = Nothing
	
	If p_Origine = "SICl" Then
		v_ClientNoFmt = xVar(pnd_PNav, "Prop_ClientNoFmt", "")
		
		' Extraire le document SI Clients
		Set pnd = xSICl_xndClie(v_ClientNoFmt, False)
		
		If pnd Is Nothing Then
			MessageBox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If
	ElseIf p_Origine = "SF" Then
		
	Else
		
		v_ClientNoFmt = xVar(pnd_PNav, "Prop_ClientNoFmt","")
		If v_ClientNoFmt &lt;&gt; "" Then
			Set pnd = xPJ_xndClieSI(p_Origine, v_ClientNoFmt, p_Cache)
			If pnd Is Nothing Then
				MessageBox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
				Exit Function
			End If
		Else
			' Selectionnez le doc de client
			Set pnd = xPJ_xndClie(p_Origine, xVar(pnd_PNav, "Prop_ClientCleSitePrinc", ""), p_Cache)
			
			If pnd Is Nothing Then ' utiliser par InitialiserAdresseClient
				Set nd_Proj = xPJ_xndProj(p_Origine, xVar(pnd_PNav, "Prop_NoProjet", ""), True)
				If nd_Proj Is Nothing Then
					' Le document de référence (client ou projet) est introuvable.
					MessageBox xGDK_xMessage("SDSPP", 4, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
					Exit Function
				End If
				Set pnd = xPJ_xndClie(p_Origine, xVar(nd_Proj, "Clie_NoClient", ""), p_Cache)
			End If
			
		End If
		
	End If
	
	FPNav_ndClientOrigine = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Function
End Function


</lotusscript></code><code event="FPNav_acPayerProposition"><lotusscript>Sub FPNav_acPayerProposition
	On Error GoTo GererErreur
	
	If SDSPUI_acPayerProposition(gnd_Prop_SDSPM, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		
		Call gnuiws_SDSPM.ViewRefresh
		
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acReouvrirProposition"><lotusscript>Sub FPNav_acReouvrirProposition
	On Error GoTo GererErreur
	
	If SDSPUI_acReOuvrirProposition(gnd_Prop_SDSPM, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		
		Call gnuiws_SDSPM.ViewRefresh
		
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acAnnuler"><lotusscript>Sub FPNav_acAnnuler
	On Error GoTo GererErreur
	
	gnd_SDSPM.SaveOptions = "0"
	Call gnuid_SDSPN.Close
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub



</lotusscript></code><code event="FPNav_acImporterCSAnnuel"><lotusscript>Sub FPNav_acImporterCSAnnuel(p_SelectionnerClient As Boolean)
	' p_SelectionnerClient : 	True = Demander à l'utilisateur le client à importer.
	'							False - Importe le CS du client de la PP.
	On Error GoTo GererErreur
		
	If SDSPM_acImporterContratsService(p_SelectionnerClient) Then	
			
		' Mettre à jour le document courant
		Call FPNav_DocumentExistant(gnd_SDSPM)		
		Call gnuid_SDSPM.RefreshHideFormulas	
					
	End If
		
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub



</lotusscript></code><code event="FPNav_QueryOpen"><lotusscript>Sub FPNav_QueryOpen(pnuid_Source As NotesUIDocument, p_Mode As Integer, p_Isnewdoc As Variant, _
p_Continue As Variant)
	On Error GoTo GererErreur
	
	Dim nd_PNav As NotesDocument
	
	' Initialisations
	p_Continue = False
	If p_Mode &lt;&gt; 1 Then
		Exit Sub
	End If
	
	Set nd_PNav = pnuid_Source.Document
	
	' Initialiser les champs du document de navigation
	If FPNav_DocumentExistant(nd_PNav) Then
		p_Continue = True
	End If
	
	' Effacer les champs RT des autres écrans
	If nd_PNav.Hasitem("Prop_DescDetaillee") Then
		Call nd_PNav.RemoveItem("Prop_DescDetaillee")
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentExistant"><lotusscript>Function FPNav_DocumentExistant(pnd_PNav As NotesDocument) As Boolean
	On Error GoTo GererErreur
	
	FPNav_DocumentExistant = False
	
	' Extraire la proposition
	If Not SDSPM_InitProp(xVar(pnd_PNav, "Prop_NoProposition", "")) Then
		Exit Function
	End If
	
	' Extraire le site
	If Not SDSPM_InitSite(pnd_PNav) Then
		Exit Function
	End If
	
	pnd_PNav.Prop_Statut = xVar(gnd_Prop_SDSPM, "Prop_Statut", "10")
	Call pnd_PNav.ReplaceItemValue("Prop_StatutDesc" &amp; xLangue, _
	xVar(gnd_Prop_SDSPM, "Prop_StatutDesc" &amp; xLangue, ""))
	
	' Mettre à jour l'entête du site
	pnd_PNav.Site_ClientNomInterne = xVar(gnd_Site_SDSPM, "Site_ClientNomInterne", "")
	pnd_PNav.Site_BanniereDesc = xVar(gnd_Site_SDSPM, "Site_BanniereDesc", "")
	
	' Mettre à jour le document de navigation
	pnd_PNav.Prop_PropositionImprimee = xVar(gnd_Prop_SDSPM, "Prop_PropositionImprimee", "")	
	
	pnd_PNav.Prop_ClientNoFmt = xVar(gnd_Prop_SDSPM, "Prop_ClientNoFmt", "")
			
	pnd_PNav.Prop_NomGroupeClient = xVar(gnd_Prop_SDSPM, "Prop_NomGroupeClient", "")
	pnd_PNav.Prop_VersionSDS = xVar(gnd_Prop_SDSPM, "Prop_VersionSDS", "")
	pnd_PNav.Prop_VersionOS = xVar(gnd_Prop_SDSPM, "Prop_VersionOS", "")
	
	pnd_PNav.Site_NoContratFmt_CS = xVar(gnd_Site_SDSPM, "Site_NoContratFmt_CS", "")
	pnd_PNav.Site_ClientNoFmt = xVar(gnd_Site_SDSPM, "Site_ClientNoFmt", "")	
	pnd_PNav.Prop_NotesContrat = xVar(gnd_Prop_SDSPM, "Prop_NotesContrat", "")
	
	Call FPNav_InitialiserInfoClient(pnd_PNav, False)
	
	FPNav_DocumentExistant = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Function
End Function</lotusscript></code>
