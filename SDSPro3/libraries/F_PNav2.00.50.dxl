</lotusscript></code><code event="FPNav_hsAjouterProduit"><lotusscript>Sub FPNav_hsAjouterProduit(p_Classe As String)
	On Error GoTo GererErreur
	
	Dim nv As NotesView
	Dim nd As NotesDocument
	Dim ndc_Produits As NotesDocumentCollection
	Dim nd_DB As NotesDocument
	Dim nd_Prod As NotesDocument
	
	Dim v_VerifierBanniere As Boolean
	Dim v_Quantite As Long
	Dim a_ProduitsNonValide As Variant
	Dim v_AfficherErreur As Boolean
	
	' Initialisations
	Call xSDSBB_Initialisations
	
	v_AfficherErreur = True
	
	Select Case p_Classe
	Case "EQ" :
		Set nv = gndb_xSDSBB.GetView("v_Prod24")
	Case "LG" :
		Set nv = gndb_xSDSBB.GetView("v_Prod26")
	Case "SV" :
		Set nv = gndb_xSDSBB.GetView("v_Prod25")
	End Select
	
	' Ne pas vérifier bannière pour client existant, conversion ou changement propriétaire
	If xVar(gnd_Prop_SDSPM, "Prop_TypeProposition", "") &gt;= "2" Then
		v_VerifierBanniere = False
	Else
		v_VerifierBanniere = True
	End If
	
	If p_Classe = "LG" Then
		
		' Si logiciel, permettre de sélectionner plusieurs
		Set ndc_Produits = SISe_ndcSelectionnerDocuments("", "", SISe_PROMPT, nv, |Prod_DescProduit| &amp; xLangue &amp; _
		| + " (" + Prod_CodeProduit + ")"|, xGDK_xMessage("SDSPP", 27, "", ""), "", "1", 10, True)
		
		If ndc_Produits.Count = 0 Then
			Exit Sub
		End If
		
		Call SDSPM_SelectionnerProduitsManuel(ndc_Produits, v_VerifierBanniere, a_ProduitsNonValide)
		
		If Isarray(a_ProduitsNonValide) Then
			a_ProduitsNonValide = Fulltrim(a_ProduitsNonValide)
			If a_ProduitsNonValide(0) &lt;&gt; "" Then
				Messagebox xGDK_xMessage("SDSPP", 38, "", Chr(13) &amp; Chr(13) &amp; (Implode(Fulltrim(a_ProduitsNonValide), Chr(13)))), 16, xGDK_xMessage("SI", 1, "", "")
			End If
		End If
		
	Else
		
		' Si pas un logiciel demander la quantité et départment si c'est un équipement.
		' Sélectionner le produit à ajouter
		Set nd = SISe_ndSelectionnerDocument("", "", SISe_PROMPT, nv, |Prod_DescProduit| &amp; xLangue &amp; _
		| + " (" + Prod_CodeProduit + ")"|, xGDK_xMessage("SDSPP", 27, "", ""), "", True)
		If nd Is Nothing Then
			Exit Sub
		End If
		
		' Demander la quantité à ajouter
		Set nd_DB = New NotesDocument(gndb_SDSPM)
		nd_DB.DB_Continue = "1"
		nd_DB.Prod_CleProduit = xVar(nd, "Prod_CleProduit", "")
		
		If gnuiws_SDSPN.Dialogbox("DB_Prod", True, True, True, False, False, False, _
		xGDK_xMessage("SDSPP", 28, "", ""), nd_DB, True, True, False) Then
			If xVar(nd_DB, "DB_Continue", "") &lt;&gt; "1" Then
				Exit Sub
			End If
		Else
			Exit Sub
		End If
		
		v_Quantite = xVar(nd_DB, "Prod_Quantite", 1)
		
	End If
	
	' Ajouter le(s) produits chosi
	' ----------------------------
	If p_Classe &lt;&gt; "LG"  Then
		
		' Créer le produit
		Set nd_Prod = SDSPX_AjouterProduit(gnd_Prop_SDSPM, gnd_Site_SDSPM, nd, v_Quantite, "", _
		"", xVar(nd_DB, "Prod_Departement", ""), "", "", v_AfficherErreur, v_VerifierBanniere, gnd_Site_SDSPM)
		
		If nd_Prod Is Nothing Then
			If v_AfficherErreur Then
			Messagebox xGDK_xMessage("SDSPP", 38, "", Chr(13) &amp; Chr(13) &amp; xVar(nd_DB, "Prod_DescProduit" &amp; xLangue, "")), 16, xGDK_xMessage("SI", 1, "", "")
			End if
		End If
		
	Else
	%REM
		Set nd_Suivant = ndc_Produits.GetFirstDocument
		
		Do Until nd_Suivant Is Nothing
			Set nd = nd_Suivant
			Set nd_Suivant = ndc_Produits.Getnextdocument(nd_Suivant)
			
			' Créer le produit
			Set nd_Prod = SDSPX_AjouterProduit(gnd_Prop_SDSPM, gnd_Site_SDSPM, nd, v_Quantite, "", _
			"", "", "", "", True, v_VerifierBanniere, gnd_Site_SDSPM)
			
			If Not (nd_Prod Is Nothing) Then
				If xVarContient(nd_Prod, "Prod_ClasseProduit", "LG") And xVar(gnd_Prop_SDSPM, "Prop_Statut", "0") &lt; "50" Then
					If SDSPX_RecalculerPrix(gnd_Prop_SDSPM, nd_Prod, True, False, True) Then
						Call nd_Prod.Save(True, False)
					End If
				End If
			End If
			
		Loop
	%END REM
	End If
	
	' Calculer les champs automatiques
	On Error 4412 GoTo FinSub
	Call gnuid_SDSPN.Refresh
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

