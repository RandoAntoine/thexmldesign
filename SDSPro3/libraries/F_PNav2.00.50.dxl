ue</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>' Site \ Produits
Option Public
Option Declare
Use "wsc_SDSP3"
Use "SDSP_MasquePNav"
Use "SDSP_Navigation"

</lotusscript></code><code event="declarations"><lotusscript>' Déclarations globales
' ---------------------


' Traitement des erreurs
' ----------------------
Const gc_TypeElement_FPNav = "SL"
Const gc_Element_FPNav = "F_PNav2.00.50"


</lotusscript></code><code event="FPNav_MajInfoClient"><lotusscript>Function FPNav_MajInfoClient As Boolean
	On Error GoTo GererErreur
	
	Dim v_NomGroupeClient As String
	Dim v_VersionSDS As String
	Dim v_VersionOS As String
	
	FPNav_MajInfoClient = False
	
	v_NomGroupeClient = xVar(gnd_SDSPM, "Clie_NomGroupeClient", "")
	v_VersionSDS = xVar(gnd_SDSPM, "Clie_VersionSDS", "")
	v_VersionOS = xVar(gnd_SDSPM, "Clie_VersionOS", "")
	
	' Validation
%REM  à valider si on oblique que les infos dans Projeto soient remplies
	If v_NomGroupeClient = "" Or v_VersionSDS = "" Or v_VersionOS = "" Then
		' Les informations du client dans Projeto sont incomplètes
		MessageBox xGDK_xMessage("SDSPP", 137, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
%END REM
	
	gnd_SDSPM.Prop_NomGroupeClient = v_NomGroupeClient
	gnd_SDSPM.Prop_VersionSDS = v_VersionSDS
	gnd_SDSPM.Prop_VersionOS = v_VersionOS
	
	gnd_SDSPM.PNav_MajNomClient = 0
	
	FPNav_MajInfoClient = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_DocumentValide"><lotusscript>Function FPNav_DocumentValide(p_AfficherErreur As Boolean) As Boolean
	On Error GoTo GererErreur
		
	FPNav_DocumentValide = False
			
	If xVar(gnd_SDSPM, "Prop_DescProposition", "") = "" Then
		If p_AfficherErreur Then
			MessageBox xGDK_xMessage("SI", 23, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_DescProposition")
		End If
		Exit Function
	End If
				
	FPNav_DocumentValide = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_InitialiserInfoClient"><lotusscript>Sub FPNav_InitialiserInfoClient(pnd_PNav As NotesDocument, p_Cache As Boolean)
	On Error GoTo GererErreur
	
	Dim nd As NotesDocument
	Dim nd_GClie As NotesDocument
	Dim nd_SICf As NotesDocument
	
	Dim v_MajClient As Integer
	Dim v_Origine As String
	Dim v_Serveur As String
	Dim v_SICf_SDSOS As Variant
	
	v_MajClient = 0
	
	v_Origine = xVar(pnd_PNav, "Prop_Origine", "")
	v_Serveur = pnd_PNav.Parentdatabase.Server
	
	If v_Serveur = "" Then
		'Local
		If v_Origine &lt;&gt; "SICl" Then
			If FPNav_ndClientOrigine(pnd_PNav, nd, v_Origine, p_Cache) Then
				pnd_PNav.Clie_NomGroupeClient = xVar(nd, "Clie_NomGroupeClient", "")
				pnd_PNav.Clie_VersionSDS = xVar(nd, "Clie_VersionSDS", "")
				pnd_PNav.Clie_VersionOS = xVar(nd, "Clie_SDSVersionOS", "")
			End If
		End If
		
	Else
		'Serveur
		If Not FPNav_ndClientOrigine(pnd_PNav, nd, v_Origine, p_Cache) Then
			Exit Sub
		End If
		If v_Origine = "SICl" Then
			Set nd_GClie = xSICl_xndGCli(xVar(nd, "Clie_ClientNo1", 0), True)
			pnd_PNav.Clie_NomGroupeClient = xVar(nd_GClie, "GCli_NomGroupe", "")
			
			' Clie_VersionSDS
			Set nd_SICf = xSICf_xndSDS(xVar(nd, "Clie_ClientNoFmt", ""), True)
			pnd_PNav.Clie_VersionSDS = xVar(nd_SICf, "SDS_VersionSDS", "")
			
			' Clie_VersionOS
			v_SICf_SDSOS = Evaluate(|
Plateforme := @IfError(@DbLookup( "" : "NoCache"; ""; "V_Serv20"; SDS_NoConfigurationServeur; 6); "");
VersionOS := @IfError(@DbLookup( "" : "NoCache"; ""; "V_Serv20"; SDS_NoConfigurationServeur; 4); "");
VersionsIBMi := @IfError(@DbLookup( "" ; @Subset(@DbName; 1) : "SI_GDK.nsf"; "V_Tabl20";  "Serv_OS_" + Plateforme; 4); "");
Descriptions := @IfError(@DbLookup( "" ; @Subset(@DbName; 1) : "SI_GDK.nsf"; "V_Tabl20";  "Serv_OS_" + Plateforme; 5); "");
@If(@IsNull(Descriptions); VersionOS; @Replace(VersionOS; VersionsIBMi; Descriptions))|, nd_SICf)
			pnd_PNav.Clie_VersionOS = v_SICf_SDSOS(0)
			
		Else ' v_Origine &lt;&gt; "SICl"
			
			pnd_PNav.Clie_NomGroupeClient = xVar(nd, "Clie_NomGroupeClient", "")
			pnd_PNav.Clie_VersionSDS = xVar(nd, "Clie_VersionSDS", "")
			pnd_PNav.Clie_VersionOS = xVar(nd, "Clie_SDSVersionOS", "")
		End If
		
		If xVar(pnd_PNav, "Prop_NomGroupeClient", "") &lt;&gt; xVar(pnd_PNav, "Clie_NomGroupeClient", "") Or _
		xVar(pnd_PNav, "Prop_VersionSDS", "") &lt;&gt; xVar(pnd_PNav, "Clie_VersionSDS", "") Or _
		xVar(pnd_PNav, "Prop_VersionOS", "") &lt;&gt; xVar(pnd_PNav, "Clie_VersionOS", "") Then
			v_MajClient = 1
		End If
		
	End If
	
	pnd_PNav.PNav_MajClient = v_MajClient
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acImage"><lotusscript>Sub FPNav_acImage
	On Error GoTo GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument("") Then
		Exit Sub
	End If
	
	Call SDSPM_acImage(gnd_Prop_SDSPM)
	
	Exit Sub
	
GererErreur:
