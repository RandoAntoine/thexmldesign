<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "SI_GestionErreurs"

</lotusscript></code><code event="declarations"><lotusscript>' Traitement des erreurs
Const gc_TypeElement_VDocu = "SL"
Const gc_Element_VDocu = "V_Inte"

%REM
Declare Function ShellExecute Lib "shell32.dll" Alias "ShellExecuteA" (Byval hwnd As Long, Byval lpOperation As String, Byval lpFile As String, Byval lpParameters As String, Byval lpDirectory As String, Byval nShowCmd As Long) As Long

Const SW_HIDE = 0
Const SW_SHOWNORMAL = 1
Const SW_NORMAL = 1
Const SW_SHOWMINIMIZED = 2
Const SW_SHOWMAXIMIZED = 3
Const SW_MAXIMIZE = 3
Const SW_SHOWNOACTIVATE = 4
Const SW_SHOW = 5
Const SW_MINIMIZE = 6
Const SW_SHOWMINNOACTIVE = 7
Const SW_SHOWNA = 8
Const SW_RESTORE = 9
Const SW_SHOWDEFAULT = 10
Const SW_MAX = 10
%END REM

</lotusscript></code><code event="VDocu_Queryopendocument"><lotusscript>Function VDocu_Queryopendocument(pnuiv_Source As NotesUIview) As Boolean
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	Dim v_Lien As String
	
	Set nd = pnuiv_Source.Documents.GetFirstDocument
	
	' Image
	If xVar(nd,"Form", "") = "F_PrIM" Then
		VDocu_Queryopendocument = True
		Exit Function
	End If
	
	Select Case xVar(nd, "Docu_Format", "")
	Case "0" :					' Lien
		VDocu_Queryopendocument = False
		v_Lien = xVar(nd, "Docu_Lien", "")
		Call ShellExecute(0&amp;, "open", v_Lien, Null, Strleftback(v_Lien, "\"), SW_SHOWDEFAULT)
	Case "2" :					' URL
		VDocu_Queryopendocument = False
		v_Lien = xVar(nd, "Docu_Lien", "")
		Call ShellExecute(0&amp;, "open", v_Lien, Null, Strleftback(v_Lien, "\"), SW_SHOWDEFAULT)
	Case Else :				' Document attaché
		VDocu_Queryopendocument = True
	End Select
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_VDocu, gc_Element_VDocu, GetThreadInfo(1), "", False)
	Exit Function
End Function</lotusscript></code>
