>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_SIBDC2" ou "SIBDC2" est 
'		l'identifiant de la base de documents.
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "SIBDC2" par l'identifiant de la base de documents.  
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "BCom" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.


</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xSIBDC2 As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_SIBDC2 As NotesDocument
Dim gnvTabl_xSIBDC2 As Notesview
Dim gndTabl_xSIBDC2 As Notesdocument
Dim gnv_BCom_xSIBDC2 As Notesview					' La vue d'ou est extrait le document
Dim gnd_BCom_xSIBDC2 As Notesdocument			' Le document qui contient les informations recherchées

' Section 3 - Les constantes à définir
Const gc_NomBD_xSIBDC2 = "SIBDC2"		' Inscrire le nom usuel de la base de documents
																' de recherche, tel que déclaré dans le GDK.
Const gc_NomItemCleBCom_xSIBDC2 = "BCom_NoBonCommandeFMT"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomItemCleBComSeq_xSIBDC2 = "BCom_NoBonCommande"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomItemCleBComOrig_xSIBDC2 = "BCom_Origine"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueBCom_xSIBDC2 = "V_BCom20"		' Le nom de la vue de recherche
Const gc_NomVueBComSeq_xSIBDC2 = "V_BCom24"		' Le nom de la vue de recherche
Const gc_NomVueBComOrig_xSIBDC2 = "V_BCom25"		' Le nom de la vue de recherche

</lotusscript></code><code event="xSIBDC2_xVarProf"><lotusscript>Function xSIBDC2_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xSIBDC2_Initialisations
	
	' Extraire le document de profil
	If gnd_Prof_SIBDC2 Is Nothing Then
		Set gnd_Prof_SIBDC2 = gndb_xSIBDC2.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_SIBDC2 Is Nothing Then
		xSIBDC2_xVarProf = p_ValeurNulle
	Else
		xSIBDC2_xVarProf = xVar(gnd_Prof_SIBDC2, p_NomVar, p_ValeurNulle)
	End If
End Function

</lotusscript></code><code event="xSIBDC2_Initialisations"><lotusscript>Sub xSIBDC2_Initialisations
	' Initialisation des variables globales
	If gndb_xSIBDC2 Is Nothing Then
		Set gndb_xSIBDC2 = xGDK_xndbNDB(gc_NomBD_xSIBDC2)
	End If
End Sub

</lotusscript></code><code event="xSIBDC2_xComplTabl"><lotusscript>Function xSIBDC2_xComplTabl(ByVal p_Cle As String, ByVal p_Table As String, ByVal p_NoComplement As String, _
ByVal p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSIBDC2_xComplTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSIBDC2_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSIBDC2_xVarTabl(p_Table, "Tabl_Complement" &amp; p_NoComplement, "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If IsArray(v_Valeurs) Then
		For i = LBound(v_Valeurs) To UBound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If IsArray(v_Descriptions) Then
					If i &gt;= LBound(v_Descriptions) And i &lt;= UBound(v_Descriptions) Then
						xSIBDC2_xComplTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If IsArray(v_Descriptions) Then
				xSIBDC2_xComplTabl = v_Descriptions(0)
			Else
				xSIBDC2_xComplTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSIBDC2_xndBComOrig"><lotusscript>Function xSIBDC2_xndBComOrig(ByVal p_Cle As Variant, ByVal p_Cache As Integer) As NotesDocument
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIBDC2_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleBComOrig_xSIBDC2, p_Cle, p_Cache, gndb_xSIBDC2, gc_NomVueBComOrig_xSIBDC2, gnv_BCom_xSIBDC2, gnd_BCom_xSIBDC2)
	
	' Retourne le document défini en variable globale
	Set xSIBDC2_xndBComOrig = gnd_BCom_xSIBDC2
End Function

</lotusscript></code><code event="xSIBDC2_xndcBCom"><lotusscript>Function xSIBDC2_xndcBCom(ByVal p_Cle As Variant) As NotesDocumentCollection
	' Cette fonction retourne une collection de documents du type approprié.
	
	' Initialisation des variables globales
	Call xSIBDC2_Initialisations
	
	Call xnv(gndb_xSIBDC2, gc_NomVueBComOrig_xSIBDC2, gnv_BCom_xSIBDC2)
		
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Set xSIBDC2_xndcBCom = gnv_BCom_xSIBDC2.GetAllDocumentsByKey(p_Cle, True)
	
End Function


</lotusscript></code><code event="xSIBDC2_xVarTabl"><lotusscript>Function xSIBDC2_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	Set nd = xSIBDC2_xndTabl(pCle, pCache)
	xSIBDC2_xVarTabl = xVar(nd, pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function



</lotusscript></code><code event="xSIBDC2_xVarBCom"><lotusscript>Function xSIBDC2_xVarBCom(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIBDC2_xndBCom(p_Cle, p_Cache)
	xSIBDC2_xVarBCom = xVar(nd, p_NomVar, p_ValeurNulle)
End Function



</lotusscript></code><code event="xSIBDC2_xVarBComOrig"><lotusscript>Function xSIBDC2_xVarBComOrig(ByVal p_Cle As Variant, ByVal p_NomVar As String, ByVal p_ValeurNulle As Variant, _
ByVal p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIBDC2_xndBComOrig(p_Cle, p_Cache)
	xSIBDC2_xVarBComOrig = xVar(nd, p_NomVar, p_ValeurNulle)
	
End Function


</lotusscript></code><code event="xSIBDC2_xDescTabl"><lotusscript>Function xSIBDC2_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSIBDC2_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSIBDC2_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSIBDC2_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSIBDC2_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSIBDC2_xDescTabl = v_Descriptions(0)
			Else
				xSIBDC2_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSIBDC2_xndBComNSeq"><lotusscript>Function xSIBDC2_xndBComNSeq(ByVal p_Cle As Variant, ByVal p_Cache As Integer) As NotesDocument
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIBDC2_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleBComSeq_xSIBDC2, p_Cle, p_Cache, gndb_xSIBDC2, gc_NomVueBComSeq_xSIBDC2, gnv_BCom_xSIBDC2, gnd_BCom_xSIBDC2)
	
	' Retourne le document défini en variable globale
	Set xSIBDC2_xndBComNSeq = gnd_BCom_xSIBDC2
End Function

</lotusscript></code><code event="xSIBDC2_xValeurExisteTabl"><lotusscript>Function xSIBDC2_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xSIBDC2_xValeurExisteTabl = False
	
	If Not (xSIBDC2_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gndTabl_xSIBDC2.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xSIBDC2_xValeurExisteTabl = True
		End If
	End If	
End Function

</lotusscript></code><code event="xSIBDC2_xIcnTabl"><lotusscript>Function xSIBDC2_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xSIBDC2_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xSIBDC2_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xSIBDC2_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xSIBDC2_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xSIBDC2_xIcnTabl = v_Icones(0)
			Else
				xSIBDC2_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSIBDC2_xndTabl"><lotusscript>Function xSIBDC2_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xSIBDC2_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xSIBDC2, "V_Tabl20", gnvTabl_xSIBDC2, gndTabl_xSIBDC2)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xSIBDC2_xndTabl = gndTabl_xSIBDC2
End Function

</lotusscript></code><code event="xSIBDC2_xndBCom"><lotusscript>Function xSIBDC2_xndBCom(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSIBDC2_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleBCom_xSIBDC2, p_Cle, p_Cache, gndb_xSIBDC2, gc_NomVueBCom_xSIBDC2, gnv_BCom_xSIBDC2, gnd_BCom_xSIBDC2)
	
	' Retourne le document défini en variable globale
	Set xSIBDC2_xndBCom = gnd_BCom_xSIBDC2
End Function

</lotusscript></code><code event="xSIBDC2_xVarBComNSeq"><lotusscript>Function xSIBDC2_xVarBComNSeq(ByVal p_Cle As Variant, ByVal p_NomVar As String, ByVal p_ValeurNulle As Variant, _
	ByVal p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSIBDC2_xndBComNSeq(p_Cle, p_Cache)
	xSIBDC2_xVarBComNSeq = xVar(nd, p_NomVar, p_ValeurNulle)
	
End Function</lotusscript></code>
