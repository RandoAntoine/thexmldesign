<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_AAAA" ou "AAAA" est 
'		l'identifiant de la base de documents.
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "AAAA" par l'identifiant de la base de documents.  
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "Clie" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.

</lotusscript></code><code event="declarations"><lotusscript>Dim v_NomBD_xPJ As String					' Nom usuel de la base de documents de recherche, tel que déclaré dans le GDK.

' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xPJ As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_PJ As NotesDocument
Dim gnv_Tabl_xPJ As Notesview
Dim gnd_Tabl_xPJ As Notesdocument
Dim gnv_Clie_xPJ As Notesview					' La vue d'ou est extrait le document
Dim gnd_Clie_xPJ As Notesdocument			' Le document qui contient les informations recherchées
Dim gnv_ClieSI_xPJ As NotesView					' La vue d'ou est extrait le document
Dim gnd_ClieSI_xPJ As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_Cont_xPJ As Notesview					' La vue d'ou est extrait le document
Dim gnd_Cont_xPJ As Notesdocument			' Le document qui contient les informations recherchées
Dim gnv_Proj_xPJ As Notesview					' La vue d'ou est extrait le document
Dim gnd_Proj_xPJ As Notesdocument			' Le document qui contient les informations recherchées
Dim gnv_Grou_xPJ As Notesview					' La vue d'ou est extrait le document
Dim gnd_Grou_xPJ As Notesdocument			' Le document qui contient les informations recherchées

' Section 3 - Les constantes à définir
Const gc_NomItemCleClie_xPJ = "Clie_NoClient"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueClie_xPJ = "V_Clie1"		' Le nom de la vue de recherche
Const gc_NomItemCleClieSI_xPJ = "Clie_NoClientFmt"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueClieSI_xPJ = "V_Clie3"		' Le nom de la vue de recherche
Const gc_NomItemCleCont_xPJ = "Cont_NoContact"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueCont_xPJ = "V_Cont1"		' Le nom de la vue de recherche
Const gc_NomItemCleProj_xPJ = "Proj_NoProjet"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueProj_xPJ = "V_Proj1"		' Le nom de la vue de recherche
Const gc_NomItemCleGrou_xPJ =  "Grou_Code"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueGrou_xPJ = "V_Grou20"		' Le nom de la vue de recherche

</lotusscript></code><code event="terminate"><lotusscript>Sub Terminate
	
End Sub


</lotusscript></code><code event="xPJ_xIcnTabl"><lotusscript>Function xPJ_xIcnTabl(p_NomDB As String, Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xPJ_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xPJ_xVarTabl(p_NomDB, p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xPJ_xVarTabl(p_NomDB, p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xPJ_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xPJ_xIcnTabl = v_Icones(0)
			Else
				xPJ_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xPJ_xVarClie"><lotusscript>Function xPJ_xVarClie(p_NomDB As String, Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xPJ_xndClie(p_NomDB, p_Cle, p_Cache)
	xPJ_xVarClie = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xPJ_xndClie"><lotusscript>Function xPJ_xndClie(p_NomDB As String, Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xPJ_Initialisations(p_NomDB)
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleClie_xPJ, p_Cle, p_Cache, gndb_xPJ, gc_NomVueClie_xPJ, gnv_Clie_xPJ, gnd_Clie_xPJ)
	
	' Retourne le document défini en variable globale
	Set xPJ_xndClie = gnd_Clie_xPJ
End Function

</lotusscript></code><code event="xPJ_xVarGrou"><lotusscript>Function xPJ_xVarGrou(p_NomDB As String, Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xPJ_xndGrou(p_NomDB, p_Cle, p_Cache)
	xPJ_xVarGrou = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xPJ_xVarCont"><lotusscript>Function xPJ_xVarCont(p_NomDB As String, Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xPJ_xndCont(p_NomDB, p_Cle, p_Cache)
	xPJ_xVarCont = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xPJ_xndGrou"><lotusscript>Function xPJ_xndGrou(p_NomDB As String, Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xPJ_Initialisations(p_NomDB)
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleGrou_xPJ, p_Cle, p_Cache, gndb_xPJ, gc_NomVueGrou_xPJ, gnv_Grou_xPJ, gnd_Grou_xPJ)
	
	' Retourne le document défini en variable globale
	Set xPJ_xndGrou = gnd_Grou_xPJ
	
End Function

</lotusscript></code><code event="xPJ_xDescTabl"><lotusscript>Function xPJ_xDescTabl(p_NomDB As String, Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xPJ_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xPJ_xVarTabl(p_NomDB, p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xPJ_xVarTabl(p_NomDB, p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xPJ_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xPJ_xDescTabl = v_Descriptions(0)
			Else
				xPJ_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xPJ_xVarTabl"><lotusscript>Function xPJ_xVarTabl(p_NomDB As String, Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	Set nd = xPJ_xndTabl(p_NomDB, pCle, pCache)
	xPJ_xVarTabl = xVar(nd, pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xPJ_xndCont"><lotusscript>Function xPJ_xndCont(p_NomDB As String, Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xPJ_Initialisations(p_NomDB)
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleCont_xPJ, p_Cle, p_Cache, gndb_xPJ, gc_NomVueCont_xPJ, gnv_Cont_xPJ, gnd_Cont_xPJ)
	
	' Retourne le document défini en variable globale
	Set xPJ_xndCont = gnd_Cont_xPJ
End Function

</lotusscript></code><code event="xPJ_xVarClieSI"><lotusscript>Function xPJ_xVarClieSI(p_NomDB As String, Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
