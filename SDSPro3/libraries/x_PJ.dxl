	Set nd = xPJ_xndClieSI(p_NomDB, p_Cle, p_Cache)
	xPJ_xVarClieSI = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xPJ_xndTabl"><lotusscript>Function xPJ_xndTabl(p_NomDB As String, Byval pCle As Variant, Byval pCache As Integer) As NotesDocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xPJ_Initialisations(p_NomDB)
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xPJ, "V_Tabl20", gnv_Tabl_xPJ, gnd_Tabl_xPJ)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xPJ_xndTabl = gnd_Tabl_xPJ
End Function

</lotusscript></code><code event="xPJ_xVarProj"><lotusscript>Function xPJ_xVarProj(p_NomDB As String, Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xPJ_xndProj(p_NomDB, p_Cle, p_Cache)
	xPJ_xVarProj = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xPJ_xndClieSI"><lotusscript>Function xPJ_xndClieSI(p_NomDB As String, Byval p_Cle As Variant, Byval p_Cache As Integer) As NotesDocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xPJ_Initialisations(p_NomDB)
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleClieSI_xPJ, p_Cle, p_Cache, gndb_xPJ, gc_NomVueClieSI_xPJ, gnv_ClieSI_xPJ, gnd_ClieSI_xPJ)
	
	' Retourne le document défini en variable globale
	Set xPJ_xndClieSI = gnd_ClieSI_xPJ
End Function

</lotusscript></code><code event="xPJ_xndProj"><lotusscript>Function xPJ_xndProj(p_NomDB As String, Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xPJ_Initialisations(p_NomDB)
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleProj_xPJ, p_Cle, p_Cache, gndb_xPJ, gc_NomVueProj_xPJ, gnv_Proj_xPJ, gnd_Proj_xPJ)
	
	' Retourne le document défini en variable globale
	Set xPJ_xndProj = gnd_Proj_xPJ
End Function

</lotusscript></code><code event="xPJ_Initialisations"><lotusscript>Sub xPJ_Initialisations(p_NomDB As String)
	' Initialisation des variables globales
	If gndb_xPJ Is Nothing Or p_NomDB &lt;&gt; v_NomBD_xPJ Then
		Set gndb_xPJ = xGDK_xndbNDB(p_NomDB)
		v_NomBD_xPJ = p_NomDB
	End If
End Sub</lotusscript></code>
