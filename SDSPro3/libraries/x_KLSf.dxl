<updatedby><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_KLSf" ou "KLSf" est 
'		l'identifiant de la base de documents (GDK).
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "KLSf" par l'identifiant de la base de documents.  
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "PSfAPI" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.
'	5.	Vérifier le nom de la vue et la clé du Type de document dans les déclarations.

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xKLSf As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_KLSf As NotesDocument
Dim gnvTabl_xKLSf As Notesview
Dim gndTabl_xKLSf As Notesdocument
Dim gnv_PSfAPI_xKLSf As Notesview					' La vue d'ou est extrait le document
Dim gnd_PSfAPI_xKLSf As Notesdocument				' Le document qui contient les informations recherchées

' Section 3 - Les constantes à définir
Const gc_NomBD_xKLSf = "KLSf"						' Inscrire le nom usuel de la base de documents
														' de recherche, tel que déclaré dans le GDK.
Const gc_NomItemClePSfAPI_xKLSf = "PSfAPI_NomProfil"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVuePSfAPI_xKLSf = "V_PSfAPI20"			' Le nom de la vue de recherche

</lotusscript></code><code event="xKLSf_xVarProf"><lotusscript>Function xKLSf_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xKLSf_Initialisations
	
	' Extraire le document de profil
	If gnd_Prof_KLSf Is Nothing Then
		Set gnd_Prof_KLSf = gndb_xKLSf.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_KLSf Is Nothing Then
		xKLSf_xVarProf = p_ValeurNulle
	Else
		xKLSf_xVarProf = xVar(gnd_Prof_KLSf, p_NomVar, p_ValeurNulle)		
	End If
End Function

</lotusscript></code><code event="xKLSf_xVarPSfAPI"><lotusscript>Function xKLSf_xVarPSfAPI(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xKLSf_xndPSfAPI(p_Cle, p_Cache)
	xKLSf_xVarPSfAPI = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xKLSf_xVarTabl"><lotusscript>Function xKLSf_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	Set nd = xKLSf_xndTabl(pCle, pCache)
	xKLSf_xVarTabl = xVar(nd, pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xKLSf_xDescTabl"><lotusscript>Function xKLSf_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xKLSf_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xKLSf_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xKLSf_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xKLSf_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xKLSf_xDescTabl = v_Descriptions(0)
			Else
				xKLSf_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xKLSf_Initialisations"><lotusscript>Sub xKLSf_Initialisations
	' Initialisation des variables globales
	If gndb_xKLSf Is Nothing Then
		Set gndb_xKLSf = xGDK_xndbNDB(gc_NomBD_xKLSf)
	End If
End Sub

</lotusscript></code><code event="xKLSf_xnv"><lotusscript>Function xKLSf_xnv(p_NomVue As String) As NotesView
	' Cette fonction retourne la vue recherchée
	
	Dim nv As NotesView
	
	' Initialisation des variables globales
	Call xKLSf_Initialisations
	
	Call xnv(gndb_xKLSf, p_NomVue, nv)
	If nv Is Nothing Then
		Set xKLSf_xnv = Nothing
	Else
		Set xKLSf_xnv = nv
	End If
End Function

</lotusscript></code><code event="xKLSf_xndPSfAPI"><lotusscript>Function xKLSf_xndPSfAPI(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xKLSf_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemClePSfAPI_xKLSf, p_Cle, p_Cache, gndb_xKLSf, gc_NomVuePSfAPI_xKLSf, gnv_PSfAPI_xKLSf, gnd_PSfAPI_xKLSf)
	
	' Retourne le document défini en variable globale
	Set xKLSf_xndPSfAPI = gnd_PSfAPI_xKLSf
End Function

</lotusscript></code><code event="xKLSf_xComplTabl"><lotusscript>Function xKLSf_xComplTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_NoComplement As String, _
Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xKLSf_xComplTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xKLSf_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xKLSf_xVarTabl(p_Table, "Tabl_Complement" &amp; p_NoComplement, "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xKLSf_xComplTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xKLSf_xComplTabl = v_Descriptions(0)
			Else
				xKLSf_xComplTabl = v_Descriptions
			End If
		End If
	End If
End Function


</lotusscript></code><code event="xKLSf_xndTabl"><lotusscript>Function xKLSf_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xKLSf_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xKLSf, "V_Tabl20", gnvTabl_xKLSf, gndTabl_xKLSf)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xKLSf_xndTabl = gndTabl_xKLSf
End Function

</lotusscript></code><code event="xKLSf_xValeurExisteTabl"><lotusscript>Function xKLSf_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xKLSf_xValeurExisteTabl = False
	
	If Not (xKLSf_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gndTabl_xKLSf.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xKLSf_xValeurExisteTabl = True
		End If
	End If	
End Function

</lotusscript></code><code event="xKLSf_xIcnTabl"><lotusscript>Function xKLSf_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xKLSf_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xKLSf_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xKLSf_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xKLSf_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xKLSf_xIcnTabl = v_Icones(0)
			Else
				xKLSf_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function</lotusscript></code>
<item name="$POID"><datetime>20250319T073636,92-05</datetime></item></scriptlibrary>

