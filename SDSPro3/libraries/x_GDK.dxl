<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Explicit
Use "SI_Extractions"
'
'	Les fonctions définies dans cette bibliothèque de script permettent d'extraire de l'information de la base de
'	documents SI_GDK.
'
'	Fonctions disponibles
'
'	================
'	xndNDB
'	================
'	Extraire un document de type F_NDB (Notes database).
'	Syntaxe:				flag = xndNDB( Cle , Cache )
'	Paramètres:			Cle				String.  Le nom usuel de la base de documents pour laquelle on veut
'												extraire le document de type NDB.
'							Cache			Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il
'												correspond au document recherché.  Si vous indiquez False, le
'												document est relu même s'il est déjà en mémoire.
'	Valeur retournée:	Notesdocument.  Le document recherché.  Retourne Nothing si aucun document n'est
'												trouvé pour la clé spécifiée.
'
'	================
'	xVarNDB
'	================
'	Extrait la valeur d'un document de type F_NDB (Notes database).
'	Syntaxe:				flag = xVarNDB( Cle , NomVar , ValeurNulle , Cache )
'	Paramètres:			Cle				String.  Le nom usuel de la base de documents pour laquelle on veut
'												extraire le document de type NDB.
'							NomVar			String.  Le nom de la variable contenant la valeur recherchée.
'							ValeurNulle		Variant.  La valeur à retourner si la variable recherchée n'existe pas
'												dans le document recherché.
'							Cache			Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il
'												correspond au document recherché.  Si vous indiquez False, le
'												document est relu même s'il est déjà en mémoire.
'	Valeur retournée:	La valeur de la variable recherchée.  Si la variable recherchée n'existe pas dans le
'							document, retourne la valeur du paramètre ValeurNulle.
'
'	================
'	xndbNDB
'	================
'	Extrait une base de documents Notes.
'	Syntaxe:				flag = xVarNDB( Cle  )
'	Paramètres:			Cle				String.  Le nom usuel de la base de documents qu'on veut obtenir.
'	Valeur retournée:	Notesdatabase.  La base de documents identifiée par la clé dans le GDK.  Si la base de
'												documents n'existe pas, retourne une base de documents fermée 
'												(propriété IsOpen = False).
'
'	================
'	xndTabl
'	================
'	Extraire un document de type F_Tabl (Table).
'	Syntaxe:				flag = xndTabl( Cle , Cache )
'	Paramètres:			Cle				String.  Le nom de la table à extraire.
'							Cache			Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il
'												correspond au document recherché.  Si vous indiquez False, le
'												document est relu même s'il est déjà en mémoire.
'	Valeur retournée:	Notesdocument.  Le document recherché.  Retourne Nothing si aucun document n'est
'												trouvé pour la clé spécifiée.
'
'	================
'	xVarTabl
'	================
'	Extrait la valeur d'un document de type F_Tabl (Table).
'	Syntaxe:				flag = xVarTabl( Cle , NomVar , ValeurNulle , Cache )
'	Paramètres:			Cle				String.  Le nom de la table à extraire.
''							NomVar			String.  Le nom de la variable contenant la valeur recherchée.
'							ValeurNulle		Variant.  La valeur à retourner si la variable recherchée n'existe pas
'												dans le document recherché.
'							Cache			Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il
'												correspond au document recherché.  Si vous indiquez False, le
'												document est relu même s'il est déjà en mémoire.
'	Valeur retournée:	La valeur de la variable recherchée.  Si la variable recherchée n'existe pas dans le
'							document, retourne la valeur du paramètre ValeurNulle.
'

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_XXX
'	- La session (gns_XXX) sera déclarée une seule fois pour le script library.
'	- La base de documents (gndbZZZ_XXX) d'où provient le document recherché.
Dim gns_xGDK As Notessession
Dim gndbGDK_xGDK As Notesdatabase
Dim gndbGDKServeur_xGDK As Notesdatabase
Dim gnd_Prof_GDK As NotesDocument

' Section 2 - Définition des valeurs conservées dans la cache
' 	Répéter pour chaque type de document
'	- La vue (gnvYYY_XXX) d'ou est extrait le document
'	- Le document (gndYYY_XXX) qui contient les informations recherchées

'	Base de documents
Dim gnvNDB1_xGDK As NotesView
Dim gnvNDB23_xGDK As NotesView
Dim gndNDB_xGDK As NotesDocument

'	Compteurs
Dim gnvComp_xGDK As NotesView
Dim gndComp_xGDK As NotesDocument

'	Tables
Dim gnvTabl_xGDK As NotesView
Dim gndTabl_xGDK As NotesDocument

'  Messages
Dim gnv_xGDK As NotesView
Dim gnd_xGDK As NotesDocument

' Bannières SDS
Dim gnvBann_xGDK As NotesView
Dim gndBann_xGDK As NotesDocument

' Medias
Dim gnvTypM_xGDK As NotesView
Dim gndTypM_xGDK As NotesDocument

' Application
Dim gnvAApp_xGDK As NotesView
Dim gndAApp_xGDK As NotesDocument

' Aide
Dim gnvSIAi_xGDK As NotesView
Dim gndSIAi_xGDK As NotesDocument

' Mot de passe
Dim gnvPass_xGDK As NotesView
Dim gndPass_xGDK As NotesDocument

' Table des abbréviations:
'	XXX = Abbréviation trouvée dans le nom du script library courant
'	YYY = Identifiant du type d'information (2e partie de l'alias d'un masque)
'	ZZZ = Identifiant de la base de documents (abbréviation)

Declare Function ShellExecute Lib "shell32.dll" Alias "ShellExecuteA" (Byval hwnd As Long, Byval lpOperation As String, Byval lpFile As String, Byval lpParameters As String, Byval lpDirectory As String, Byval nShowCmd As Long) As Long

Const SW_HIDE = 0
Const SW_SHOWNORMAL = 1
Const SW_NORMAL = 1
Const SW_SHOWMINIMIZED = 2
Const SW_SHOWMAXIMIZED = 3
Const SW_MAXIMIZE = 3
Const SW_SHOWNOACTIVATE = 4
Const SW_SHOW = 5
Const SW_MINIMIZE = 6
Const SW_SHOWMINNOACTIVE = 7
Const SW_SHOWNA = 8
Const SW_RESTORE = 9
Const SW_SHOWDEFAULT = 10
Const SW_MAX = 10

</lotusscript></code><code event="xGDK_xndTabl"><lotusscript>Function xGDK_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As NotesDocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xGDK_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndbGDK_xGDK, "V_Tabl20", gnvTabl_xGDK, gndTabl_xGDK)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xGDK_xndTabl = gndTabl_xGDK
End Function

</lotusscript></code><code event="xGDK_xndNDB"><lotusscript>Function xGDK_xndNDB(Byval pCle As Variant, Byval pCache As Integer) As NotesDocument
	' Cette fonction retourne un document de type F_NDB.
	
	' Initialisation des variables globales
	Call xGDK_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("NDB_NomUsuel", pCle, pCache, gndbGDK_xGDK, "V_NDB20", gnvNDB1_xGDK, gndNDB_xGDK)
	'	Paramètres:	1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xGDK_xndNDB = gndNDB_xGDK
End Function

</lotusscript></code><code event="xGDK_xndbNDB"><lotusscript>Function xGDK_xndbNDB(Byval pCle As Variant) As NotesDatabase
	' Cette fonction retourne une base de documents.
	
	Dim ndb As NotesDatabase
	
	' Initialisation des variables globales
	Set xGDK_xndbNDB = Nothing
	Call xGDK_Initialisations
	
	' Retourne la base de documents
	Set ndb = gns_xGDK.Getdatabase(xGDK_xVarNDB(pCle, "NDB_Serveur", "", False), xGDK_xVarNDB(pCle, "NDB_Fichier", "", True), False)
	If Not ndb Is Nothing Then
		If ndb.Isopen Then
			Set xGDK_xndbNDB = ndb
		Else
			Set xGDK_xndbNDB = Nothing
		End If
	End If
End Function

</lotusscript></code><code event="xGDK_xExtraireAApp"><lotusscript>Function xGDK_xExtraireAApp(Byval pCle As Variant, Byval pCache As Integer, p_CheminAcces As String, p_Executer As Boolean) As Boolean
	' Cette fonction retourne un document de type F_NDB.
	On Error 75 Resume Next 'Path/File Error  ===&gt; fichier "locké" au niveau du kill
	
	Dim nd_AApp As NotesDocument
	Dim nrti As NotesRichTextItem
	Dim aneo As Variant
	Dim neo As NotesEmbeddedObject
	Dim v_Dossier As String
	Dim i As Integer
	
	xGDK_xExtraireAApp = False
	
	' Extraire le document de l'application
	Set nd_AApp = xGDK_xndAApp(pCle, pCache)
	If nd_AApp Is Nothing Then
		Exit Function
	End If
	
	Set nrti = nd_AApp.GetFirstItem("AApp_Executable")
	If Not Isarray(nrti.Embeddedobjects) Then
		Exit Function
	End If
	aneo = nrti.EmbeddedObjects
	Set neo = aneo(Lbound(aneo))
	
	' Créer le dossier temporaire (au besoin)
	If p_CheminAcces = "" Then
		v_Dossier = Environ("Temp") &amp; "\AApp"
		p_CheminAcces = v_Dossier &amp; "\" &amp; neo.Source
	Elseif Instr(p_CheminAcces, "\") &gt; 0 Then
		v_Dossier = Strleftback(p_CheminAcces, "\")
	Else
		v_Dossier = Environ("Temp") &amp; "\AApp"
		p_CheminAcces = v_Dossier &amp; "\" &amp; p_CheminAcces
	End If
	Mkdir v_Dossier
	
	' Extraire l'application
	Kill p_CheminAcces
	Call neo.Extractfile(p_CheminAcces)
	xGDK_xExtraireAApp = True
	
	' Executer le fichier
	If p_Executer Then
		If Lcase(Strrightback(p_CheminAcces, ".")) = "exe" Then
			i = Shell(p_CheminAcces, 1)
		Else
			Call ShellExecute(0&amp;, "open", p_CheminAcces, Null, Strleftback(p_CheminAcces, "\"), SW_SHOWDEFAULT)
		End If
	End If
End Function

</lotusscript></code><code event="xGDK_xndbGDK"><lotusscript>Function xGDK_xndbGDK As NotesDatabase
	' Cette fonction retourne la base de documents GDK.
	
	Call xGDK_Initialisations
	Set xGDK_xndbGDK = gndbGDK_xGDK
End Function

</lotusscript></code><code event="xGDK_xVarNDB_Acc"><lotusscript>Function xGDK_xVarNDB_Acc(ByVal p_Serveur As String, ByVal p_Fichier As String, ByVal pNomVar As String, ByVal pValeurNulle As Variant, _
ByVal pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_NDB.
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	xGDK_xVarNDB_Acc = xVar(xGDK_xndNDB_Acc(p_Serveur, p_Fichier, pCache), pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xGDK_xndNDB_Acc"><lotusscript>Function xGDK_xndNDB_Acc(ByVal p_Serveur As String, ByVal p_Fichier As String, ByVal pCache As Integer) As NotesDocument
	' Cette fonction retourne un document de type F_NDB en fonction du chemin d'accès.
	
	Dim v_Cle As String
	
	' Initialisation des variables globales
	Call xGDK_Initialisations
	
	v_Cle = LCase(p_Serveur &amp; ";" &amp; p_Fichier)
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("", v_Cle, pCache, gndbGDK_xGDK, "V_NDB23", gnvNDB23_xGDK, gndNDB_xGDK)
	'	Paramètres:	1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xGDK_xndNDB_Acc = gndNDB_xGDK
End Function

</lotusscript></code><code event="xGDK_xDescTabl"><lotusscript>Function xGDK_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xGDK_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xGDK_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xGDK_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xGDK_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xGDK_xDescTabl = v_Descriptions(0)
			Else
				xGDK_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xGDK_xndTypM"><lotusscript>Function  xGDK_xndTypM(Byval pCle As Variant, Byval pCache As Integer) As NotesDocument
