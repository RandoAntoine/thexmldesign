</lotusscript></code><code event="xGDK_xVarProf"><lotusscript>Function xGDK_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	On Error Goto GererErreur
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	xGDK_xVarProf = p_ValeurNulle
	Call xGDK_Initialisations
	
	' Extraire le document de profil
	If gnd_Prof_GDK Is Nothing Then
		Set gnd_Prof_GDK = gndbGDK_xGDK.Getprofiledocument("F_Prof")
	End If
	
	If Not (gnd_Prof_GDK Is Nothing) Then
		xGDK_xVarProf = xVar(gnd_Prof_GDK, p_NomVar, p_ValeurNulle)
	End If
	Exit Function
	
GererErreur:
	Print "Erreur x_GDK. " &amp; Getthreadinfo(1) &amp; " ligne " &amp; Erl &amp; " - " Error$ &amp; " (" &amp; Cstr(Err) &amp; ")"
	Exit Function
End Function

</lotusscript></code><code event="xGDK_TypeNDBCourante"><lotusscript>Function xGDK_TypeNDBCourante As String
	' Cette fonction retourne le type de la base de documents courante
	' P = Production, L = Local, T = Tests
	On Error Goto GererErreur
	
	Dim a_DossiersTests As Variant
	Dim v_Dossier As String
	Dim v_LongDossier As Integer
	Dim i As Integer
	
	xGDK_TypeNDBCourante = "T"
	Call xGDK_Initialisations
	
	If Not (gndbGDK_xGDK Is Nothing) Then
		If gndbGDK_xGDK.Server = "" Or Lcase(gndbGDK_xGDK.Server) = "local" Then
			xGDK_TypeNDBCourante = "L"
		Elseif Instr(Lcase(gndbGDK_xGDK.Server), "zulu") &gt; 0 Then
			Exit Function
		Else
			a_DossiersTests = xGDK_xVarProf("Prof_DossiersTests", "")
			If Not Isarray(a_DossiersTests) Then
				If a_DossiersTests = "" Then
					xGDK_TypeNDBCourante = "P"
					Exit Function
				Elseif a_DossiersTests = "*" Then
					Exit Function
				End If
				a_DossiersTests = Evaluate(|"| &amp; a_DossiersTests &amp; |"|)
			End If
			v_Dossier = Lcase(gndbGDK_xGDK.Filepath)
			If Right(v_Dossier, 1) &lt;&gt; "\" Then
				v_Dossier = v_Dossier &amp; "\"
			End If
			v_LongDossier = Len(v_Dossier)
			For i = Lbound(a_DossiersTests) To Ubound(a_DossiersTests)
				If Len(a_DossiersTests(i)) &gt; v_LongDossier Then
					If Left(Lcase(a_DossiersTests(i)), v_LongDossier) = v_Dossier Then
						Exit Function
					End If
				End If 
			Next
			xGDK_TypeNDBCourante = "P"
		End If
	End If
	Exit Function
	
GererErreur:
	Print "Erreur x_GDK. " &amp; Getthreadinfo(1) &amp; " ligne " &amp; Erl &amp; " - " Error$ &amp; " (" &amp; Cstr(Err) &amp; ")"
	Exit Function
End Function

</lotusscript></code><code event="xGDK_xVarTypM"><lotusscript>Function xGDK_xVarTypM(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Medi.
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	xGDK_xVarTypM = xVar(xGDK_xndTypM(pCle, pCache), pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xGDK_xRemplacerParametres"><lotusscript>Function xGDK_xRemplacerParametres(Byval p_Message As String, p_Parametres As Variant) As String
	Dim v_Pos As Long
	Dim v_Message1 As String
	Dim v_Message2 As String
	Dim v_Message3 As String
	Dim v_NoParm As String
	
	v_Pos = Instr(p_Message, "&amp;")
	If v_Pos = 0 Then
		xGDK_xRemplacerParametres = p_Message
		Exit Function
	End If
	
	' Extraire la chaine à gauche de la valeur à insérer
	v_Message1 = Left(p_Message, v_Pos - 1)
	
	' Extraire le numéro du paramètre à insérer
	If v_Pos &lt; Len(p_Message) Then
		v_NoParm = Mid(p_Message, v_Pos + 1, 1)
		If Instr("0123456789", v_NoParm) = 0 Then
			v_NoParm = "0"
		Else
			v_Pos = v_Pos + 1
		End If
	Else
		v_NoParm = "0"
	End If
	
	' Extraire le paramètre à insérer
	v_Message2 = ""
	If Isarray(p_Parametres) Then
		If v_NoParm &lt;= Ubound(p_Parametres) Then
			v_Message2 = p_Parametres(Cint(v_NoParm))
		End If
	Elseif v_NoParm = "0" Then
		v_Message2 = p_Parametres
	End If
	
	' Extraire la chaine à droite de la valeur à insérer
	If v_Pos &lt; Len(p_Message) Then
		v_Message3 = xGDK_xRemplacerParametres(Right(p_Message, Len(p_Message) - v_Pos), p_Parametres)
	Else
		v_Message3 = ""
	End If
	
	' Construire le message
	xGDK_xRemplacerParametres = v_Message1 &amp; v_Message2 &amp; v_Message3
End Function

</lotusscript></code><code event="xGDK_xFormulaNDB"><lotusscript>Function xGDK_xFormulaNDB(Byval pCle As Variant) As String	
	' Cette fonction retourne le serveur et le chamin d'accès utilisé par les formules
	' @DbLookup et @DbColumn
	
	Dim ndb As NotesDatabase
	
	' Extraire la base de documents
	Set ndb = xGDK_xndbNDB(pCle) 
	
	If Not (ndb Is Nothing) Then
		xGDK_xFormulaNDB = |"| &amp; ndb.Server &amp; |":"| &amp; Replace(ndb.FilePath,"\","\\") &amp; |"|
	End If
End Function

</lotusscript></code><code event="xGDK_xIcnTabl"><lotusscript>Function xGDK_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xGDK_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xGDK_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xGDK_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xGDK_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xGDK_xIcnTabl = v_Icones(0)
			Else
				xGDK_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xGDK_xndPass"><lotusscript>Function  xGDK_xndPass(ByVal pCle As Variant, ByVal pCache As Integer) As NotesDocument
	' Cette fonction retourne un document de type F_Medi.
	
	' Initialisation des variables globales
	Call xGDK_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Pass_Code", pCle, pCache, gndbGDK_xGDK, "V_Pass20", gnvPass_xGDK, gndPass_xGDK)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xGDK_xndPass = gndPass_xGDK
End Function

</lotusscript></code><code event="xGDK_xValeurExisteTabl"><lotusscript>Function xGDK_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xGDK_xValeurExisteTabl = False
	
	If Not (xGDK_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gndTabl_xGDK.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xGDK_xValeurExisteTabl = True
		End If
	End If	
End Function

</lotusscript></code><code event="xGDK_xMessage"><lotusscript>Function xGDK_xMessage(Byval p_NomDocument As String, Byval p_NoMessage As Integer, _
Byval p_Langue As String, p_Parametres As Variant) As String
	Dim v_Langue As Variant
	Dim v_Message As String
	Dim ni_Messages As NotesItem
	Dim va As Variant
	Dim v_Pos As Long
	Dim v_Suivant As String
	Dim v_NoParm As Integer
	
	Const c_MessageVide = "SIMs_MessageVide"
	
	Call xGDK_Initialisations
	xGDK_xMessage = ""
	If p_NoMessage &lt; 0 Or gndbGDK_xGDK Is Nothing Then
		Exit Function
	End If
	' Initialiser le document de messages si pas passé en paramètre
	If p_NomDocument = "" Then
		p_NomDocument = "SI"
	End If
	' Initialiser la langue si pas passée en paramètre
	If p_Langue = "" Then
		p_Langue = "FR"
		v_Langue = Evaluate("@UpperCase(@Left(@LanguagePreference([Content]); 2))")
		If Isarray(v_Langue) Then
			If v_Langue(0) = "EN" Then
				p_Langue = v_Langue(0)
			End If
		End If
	End If
	
	' Extraire le document des messages
	' ---------------------------------
	If xVar(gnd_xGDK, "SIMs_Nom", "") &lt;&gt; p_NomDocument Then
		If gnv_xGDK Is Nothing Then
			Set gnv_xGDK = gndbGDK_xGDK.Getview("V_SIMs20")
		End If
		Set gnd_xGDK = gnv_xGDK.GetDocumentbykey(p_NomDocument)
		If gnd_xGDK Is Nothing Then
			Exit Function
		End If
	End If
	
	' Extraire le message d'une langue autre que Français
	' ---------------------------------------------------
	If p_Langue &lt;&gt; "FR" Then
		Set ni_Messages = gnd_xGDK.GetFirstItem("SIMs_Messages" &amp; p_Langue)
		If Not (ni_Messages Is Nothing) Then
			va = ni_Messages.Values
			If Ubound(va) &gt;= p_NoMessage Then
				If va(p_NoMessage) &lt;&gt; c_MessageVide Then
					v_Message = va(p_NoMessage)
				End If
			End If
		End If
	End If
	
	' Extraire le message Français
	' ----------------------------
	If v_Message = "" Then
		Set ni_Messages = gnd_xGDK.GetFirstItem("SIMs_MessagesFR")
		If Not (ni_Messages Is Nothing) Then
			va = ni_Messages.Values
			If Ubound(va) &gt;= p_NoMessage Then
				If va(p_NoMessage) &lt;&gt; c_MessageVide Then
					v_Message = va(p_NoMessage)
				End If
			End If
		End If
	End If
	
	' Effectuer les substitutions
	' ---------------------------
	If v_Message &lt;&gt; "" Then
		xGDK_xMessage = xGDK_xRemplacerParametres(v_Message, p_Parametres)
	End If
End Function

</lotusscript></code><code event="xGDK_xCompTabl"><lotusscript>Function xGDK_xCompTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_NoComp As String, Byval p_Cache As Integer) As String
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xGDK_xCompTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xGDK_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xGDK_xVarTabl(p_Table, "Tabl_Complement" &amp; p_NoComp, "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xGDK_xCompTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xGDK_xCompTabl = v_Descriptions(0)
			Else
				xGDK_xCompTabl = v_Descriptions
			End If
		End If
	End If
End Function

