</lotusscript></code><code event="xGDK_Initialisations"><lotusscript>Sub xGDK_Initialisations
	Dim ndb As NotesDatabase
	
	' Initialisation des variables globales
	If gns_xGDK Is Nothing Then
		Set gns_xGDK = New Notessession
		Set gndbGDK_xGDK = Nothing
		Set ndb = gns_xGDK.Getdatabase(gns_xGDK.Currentdatabase.Server, "SI_GDK.nsf", False)
		If Not ndb Is Nothing Then
			If ndb.Isopen Then
				Set gndbGDK_xGDK = ndb
			End If
		End If
	End If
End Sub

</lotusscript></code><code event="xGDK_xVarNDB"><lotusscript>Function xGDK_xVarNDB(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
