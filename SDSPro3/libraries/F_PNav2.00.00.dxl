nt Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "wsc_SDSP3"
Use "SDSP_MasquePNav"
Use "SDSP_Navigation"
Use "SI_Google"
Use "SL_Clipboard"
Use "x_SIBDC2"

</lotusscript></code><code event="declarations"><lotusscript>' Déclarations globales
' ---------------------
Dim g_Site_Banniere As Variant

Dim gcl_SessionSLSf_FSFPP As SLSf_clSession
Dim g_Resultat_FSFPP As Integer

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_FPNav = "SL"
Const gc_Element_FPNav = "F_PNav2.00.00"



</lotusscript></code><code event="FPNav_acRafraichirInfoClient"><lotusscript>Sub FPNav_acRafraichirInfoClient
	On Error Goto GererErreur
	
	Call FPNav_InitialiserAdresseClient(gnd_SDSPM, False)
	Call gnuid_SDSPM.Refresh
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_MajAdresseClient"><lotusscript>Sub FPNav_MajAdresseClient
	On Error Goto GererErreur
	
	gnd_Prop_SDSPM.Prop_ClientAdresse1 = xVar(gnd_SDSPM, "Site_ClientAdresse1", "")
	gnd_Prop_SDSPM.Prop_ClientAdresse2 = xVar(gnd_SDSPM, "Site_ClientAdresse2", "")
	gnd_Prop_SDSPM.Prop_ClientVille = xVar(gnd_SDSPM, "Site_ClientVille", "")
	gnd_Prop_SDSPM.Prop_ClientProvince = xVar(gnd_SDSPM, "Site_ClientProvince", "")
	gnd_Prop_SDSPM.Prop_ClientPays = xVar(gnd_SDSPM, "Site_ClientPays", "")
	gnd_Prop_SDSPM.Prop_ClientCodePostal = xVar(gnd_SDSPM, "Site_ClientCodePostal", "")
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_DocumentValide_Coordonnees"><lotusscript>Function FPNav_DocumentValide_Coordonnees(p_AfficherErreur As Boolean) As Boolean
	On Error Goto GererErreur
	
	Dim v_AdresseGoogle As String
	Dim v_Latitude As Double
	Dim v_Longitude As Double
	Dim s As String
	
	FPNav_DocumentValide_Coordonnees = False
	
	' Coordonnées Google
	v_AdresseGoogle = SIGg_AdresseGoogle(xVar(gnd_SDSPM, "Site_ClientAdresse1", ""), xVar(gnd_SDSPM, "Site_ClientAdresse2", ""), _
	xVar(gnd_SDSPM, "Site_ClientVille", ""), xVar(gnd_SDSPM, "Site_ClientProvince", ""), _
	xVar(gnd_SDSPM, "Site_ClientCodePostal", ""))
	s = SIGg_CoordonneesGeo(v_AdresseGoogle, v_Latitude, v_Longitude,xGDK_xVarProf("Prof_CleGoogleAPI", ""))
	If s = "" Then
		gnd_SDSPM.Site_ClientLatitude = v_Latitude
		gnd_SDSPM.Site_ClientLongitude = v_Longitude
	Else
		gnd_SDSPM.Site_ClientLatitude = 0
		gnd_SDSPM.Site_ClientLongitude = 0
		
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 207, "", s), 48, xGDK_xMessage("SI", 0, "", "")
'			Call gnuid_SDSPN.GotoField("Site_ClientAdresse1")
		End If
		Exit Function
	End If
	
	FPNav_DocumentValide_Coordonnees = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_DocumentValide_Adresse"><lotusscript>Function FPNav_DocumentValide_Adresse(p_AfficherErreur As Boolean) As Boolean
	On Error Goto GererErreur
	
	FPNav_DocumentValide_Adresse = False
	
	If xVar(gnd_SDSPM, "Site_ClientAdresse1", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 195, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Site_ClientAdresse1")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_ClientVille", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 194, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Site_ClientVille")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_ClientProvince", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 21, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Site_ClientProvince")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_ClientPays", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 19, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Site_ClientPays")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_ClientCodePostal", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 196, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Site_ClientCodePostal")
		End If
		Exit Function
	End If
	
	FPNav_DocumentValide_Adresse = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_DocumentValide"><lotusscript>Function FPNav_DocumentValide(p_AfficherErreur As Boolean) As Boolean
	On Error Goto GererErreur
	
	Dim a_Plateforme As Variant
	
	FPNav_DocumentValide = False
	
	If xVar(gnd_SDSPM, "Prop_DescProposition", "") = "" Then
		If p_AfficherErreur Then
			MessageBox xGDK_xMessage("SI", 23, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
			Call gnuid_SDSPN.GotoField("Prop_DescProposition")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_ClientNomInterne", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 193, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (2)"
			Call gnuid_SDSPN.GotoField("Site_ClientNomInterne")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "PNav_BanniereRequise", 0) = 1 Then
		If Not Isarray(xVararray(gnd_SDSPM, "Site_Banniere")) Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (3)"
				Call gnuid_SDSPN.GotoField("Site_Banniere")
			End If
			Exit Function
		End If
	End If
	
	a_Plateforme = xVarArray(gnd_SDSPM, "Site_Plateforme")
	
	If xVar(gnd_Prop_SDSPM, "Prop_TypeProposition", "0") &lt;= "1" Then
		
		If Isarray(a_Plateforme) Then
			If a_Plateforme(0) = "" Then
				If p_AfficherErreur Then
					Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (4)"
					Call gnuid_SDSPN.GotoField("Site_Plateforme")
				End If
				Exit Function
			End If
		Else
			If a_Plateforme = "" Then
				If p_AfficherErreur Then
					Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (5)"
					Call gnuid_SDSPN.GotoField("Site_Plateforme")
				End If
				Exit Function
			End If
		End If
		
		
	End If
	
	If Not FPNav_DocumentValide_Adresse(p_AfficherErreur) Then
		Exit Function
	End If
	
	FPNav_DocumentValide = True
	
	' Coordonnées Google
	If Not FPNav_DocumentValide_Coordonnees(False) Then
		Exit Function
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

