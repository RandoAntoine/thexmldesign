</lotusscript></code><code event="FPNav_ExtraireOpportunite"><lotusscript>'===================================================================================================================================================
Function FPNav_ExtraireOpportunite(p_NoOpportunite As String, p_NoClientFmt As String) As Integer
	'---------------------------------------------------------------------	
	' Extraire l'opportunité et le compte de Salesforce
	'---------------------------------------------------------------------
	On Error GoTo GererErreur
	
	Dim v_NomProfilSalesforceAPI As String
	Dim v_AccountId As String
	
	FPNav_ExtraireOpportunite = 0
	
	Set gcl_SessionSLSf_FSFPP = New SLSf_clSession
	
	v_NomProfilSalesforceAPI = SDSPSf_NomProfilSalesforceAPI
	Set gcl_SessionSLSf_FSFPP.ConnexionAPI = New SLSf_clConnexionAPI(v_NomProfilSalesforceAPI)
	If gcl_SessionSLSf_FSFPP.ConnexionAPI.Resultat &lt; 0 Then
		FPNav_ExtraireOpportunite = gcl_SessionSLSf_FSFPP.ConnexionAPI.Resultat
		Exit Function
	End If
	
	Set gcl_SessionSLSf_FSFPP.Objects("Account") = Nothing
	
	If p_NoOpportunite = "" Then 
		If p_NoClientFmt &lt;&gt; "" Then 	
			Set gcl_SessionSLSf_FSFPP.Objects("Account") = New SLSf_clObject(gcl_SessionSLSf_FSFPP.ConnexionAPI, "Account", "SERTI_ID__c/" + p_NoClientFmt )
			If gcl_SessionSLSf_FSFPP.Objects("Account").Resultat = 1 Then				
				FPNav_ExtraireOpportunite = gcl_SessionSLSf_FSFPP.Objects("Account").Resultat
				Exit Function
			End If
		End If
	Else
		Set gcl_SessionSLSf_FSFPP.Objects("Opportunity") = New SLSf_clObject(gcl_SessionSLSf_FSFPP.ConnexionAPI, "Opportunity", p_NoOpportunite)
		
		If gcl_SessionSLSf_FSFPP.Objects("Opportunity").Resultat &lt; 0 Then
			MessageBox xGDK_xMessage("SDSPP", 196, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			FPNav_ExtraireOpportunite = gcl_SessionSLSf_FSFPP.Objects("Opportunity").Resultat						
			Exit Function
		End If
		
		v_AccountId = gcl_SessionSLSf_FSFPP.Objects("Opportunity").ExtraireValeur("AccountId", "")
		Set gcl_SessionSLSf_FSFPP.Objects("Account") = New SLSf_clObject(gcl_SessionSLSf_FSFPP.ConnexionAPI, "Account", v_AccountId)
		If gcl_SessionSLSf_FSFPP.Objects("Account").Resultat = 1 Then				
			FPNav_ExtraireOpportunite = gcl_SessionSLSf_FSFPP.Objects("Account").Resultat
			Exit Function
		End If
	End If
	
	FPNav_ExtraireOpportunite = 1
	Exit Function
	
GererErreur:
	FPNav_ExtraireOpportunite = -9
	Call SIGE_TraiterErreur(gc_TypeElement_SLSf, gc_Element_SLSf, GetThreadInfo(1), "", False)
	Exit Function
End Function


</lotusscript></code><code event="FPNav_acDupliquerProposition"><lotusscript>Sub FPNav_acDupliquerProposition
	On Error GoTo GererErreur
	
	Dim ndb As NotesDatabase
	Dim nd_Duplicata As NotesDocument
	Dim nd_DB As NotesDocument
	
	Dim v_UserName As String
	Dim v_Description As Variant
	Dim v_ID As String
	Dim v_DB_ID As String
	Dim v_EditMode As String
	Dim v_Commentaire As String
	Dim v_DBRecalcTous As Boolean
	Dim v_RecalcListe As Boolean
	
	On Error 4411 GoTo FinSub
	Call gnuid_SDSPM.Save
	
	' Demander la nouvelle description à l'utilisateur
	v_Description = gnuiws_SDSPM.Prompt(PROMPT_OKCANCELEDIT, _
	xGDK_xMessage("SDSPP", 46, "", ""), xGDK_xMessage("SDSPP", 47, "", ""), CStr(Today()))
	If v_Description = "" Then
		Exit Sub
	Else
		If v_Description = xVar(gnd_SDSPM,"Prop_DescProposition","") Then
			MessageBox xGDK_xMessage("SDSPP", 48, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		End If
	End If
	
	Set nd_DB = New NotesDocument(gndb_SDSPM)
	nd_DB.Form = "DB_SIHi"	
	nd_DB.SIHi_Obligatoire = True	' Image "&gt;" pour Commentaire obligatoire
	
	If Not gnuiws_SDSPN.DialogBox("DB_SIHi", True, True, False, False, False, False, _
	xGDK_xMessage("SI", 49, "", ""), nd_DB, True, False, False) Then
		Exit Sub
	End If
	
	v_Commentaire = xVar(nd_DB, "SIHi_Commentaire", "")
	v_UserName = gns_SDSPM.UserName
	v_EditMode = xVar(gnd_SDSPM, "PNav_EditMode", "")
	
	Call SDSPDp_DupliquerProposition(gnd_Prop_SDSPM,CStr(v_Description), nd_Duplicata, nd_DB, v_UserName)
	
	If Not nd_Duplicata Is Nothing Then
		Call SDSPM_acRecalculerCouts(nd_Duplicata, False, False)
		
		' Fermer la proposition
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPM.Close
		Call gnuiws_SDSPM.ViewRefresh
	Else
		Call gnuid_SDSPM.Refresh
	End If
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

	

</lotusscript></code><code event="FPNav_hsMajAdresseClient"><lotusscript>Sub FPNav_hsMajAdresseClient
	On Error Goto GererErreur
	
	Dim nd_ClientOrigineProposition As NotesDocument
	
	' Validations
	If Not FPNav_MajAdresseSiteClient Then
		Exit Sub
	End If
	
	' Si le site et la proposition sont le même client maj le client de la proposition
	If FPNav_ndClientOriginePropositon(gnd_Prop_SDSPM, nd_ClientOrigineProposition, "", True) Then
		If xVar(gnd_SDSPM, "Prop_Origine", "") = "SICl" Then	' La proposition a été créée dans SI Clients
			If xVar(gnd_SDSPM, "Site_OrigineCle", "") = xVar(nd_ClientOrigineProposition, "Clie_ClientNoFmt", "") Then
				Call FPNav_MajAdresseClient
			End If
		Else	' La proposition a été créée dans Projeto
			If xVar(gnd_SDSPM, "Site_OrigineCle", "") = xVar(nd_ClientOrigineProposition, "CleClient", "") Then
				Call FPNav_MajAdresseClient
			End If
		End If
	End If
	
	gnd_SDSPM.PNav_MajAdresse = 0
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub




</lotusscript></code><code event="FPNav_acImprimerProposition"><lotusscript>Sub FPNav_acImprimerProposition
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument(True) Then
		Exit Sub
	End If
	
	Call SDSPM_acImprimerProposition
	
	Exit Sub
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acOuvrirBonTravail"><lotusscript>Sub FPNav_acOuvrirBonTravail
	On Error GoTo GererErreur
	
	Dim nd_BTra As NotesDocument
	Dim ndc_BTra As NotesDocumentCollection
	Dim nuid As NotesUIDocument
	Dim nv_BTra As NotesView	
	Dim v_NoProp As String
	Dim a_NoBCSites As Variant	
	Dim v_NbPropositionFmt As String
	
	'Initialisations
	Call xSIBDT_Initialisations
	
	Set nv_BTra = gndb_xSIBDT.GetView("v_BTra73")
	Call nv_BTra.Refresh
	
	
	'Verifier si Bon de commande existe	
	v_NoProp = xVar(gnd_SDSPM, "Prop_NoProposition", "")	
	a_NoBCSites = Evaluate(|@DbLookup("" : "NoCache"; ""; "V_Site21"; "| &amp; v_NoProp &amp; |"; 10;[FailSilent])|)
	
	If IsArray(a_NoBCSites) Then		
		
		v_NbPropositionFmt = xVar(gnd_SDSPM, "Prop_NbPropositionFmt", "")
		Set ndc_BTra = nv_BTra.GetAllDocumentsByKey(v_NbPropositionFmt, True)
		
		If ndc_Btra.Count = 0 Then
			MessageBox xGDK_xMessage("SI", 70, "", ""), 16, xGDK_xMessage("SI", 1, "", "")				
			Exit Sub
			
		ElseIf ndc_BTra.count = 1 Then
			
			Set nd_BTra = ndc_BTra.getfirstDocument
			
		Else 
			' Sélectionner un bon de travail
			Set nd_Btra = SISe_ndPickList(nv_BTra, xGDK_xMessage("SIBDT", 40, "", ""), v_NbPropositionFmt)				
			
		End If
		
		' Ouvrir le bon de travail		
		If Not nd_Btra Is Nothing Then
			Set nuid = gnuiws_SDSPN.EditDocument( False , nd_Btra)	
		End If		
		
		
	Else

		MessageBox xGDK_xMessage("SI", 70, "", ""), 16, xGDK_xMessage("SI", 1, "", "")				
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_SauvegarderDocument"><lotusscript>Function FPNav_SauvegarderDocument(p_ValiderDocument As Variant) As Boolean
	On Error Goto GererErreur
	
	Dim nd_Clie As NotesDocument
	Dim nd_Proj As NotesDocument
	Dim ndc_Produits As NotesDocumentCollection
	
	Dim v_DocumentValide As Boolean
	Dim v_GeoMaj As Boolean
	Dim v_MajClient As Boolean
	Dim v_MajNomClient As Boolean
	Dim v_MajProp As Boolean
	Dim v_NoOptionCourante As String
	Dim v_NoOptionMax As String
	Dim v_Origine As String
	
	
	If xVar(gnd_SDSPM, "PNav_EditMode", False) Then
		FPNav_SauvegarderDocument = False
	Else
		FPNav_SauvegarderDocument = True
		Exit Function
	End If
	
	' Calculer les champs automatiques
	On Error 4412 Goto FinSub
	Call gnuid_SDSPN.Refresh
	On Error 4412 Goto GererErreur
	
	' Valider le document courant
	v_NoOptionCourante = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "0.00")
	v_NoOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionMax", "0.00")
	If p_ValiderDocument = "" Then
		v_DocumentValide = FPNav_DocumentValide(Cint(v_NoOptionCourante &lt; v_NoOptionMax))
	Else
		v_DocumentValide = FPNav_DocumentValide(Cint(p_ValiderDocument))
	End If
	If v_DocumentValide = False Then
		If p_ValiderDocument = True Then
			Call gnuid_SDSPN.RefreshHideFormulas
			Exit Function
		End If
		
		gnd_SDSPM.PNav_MenuOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "")
	End If
	
	' Extraire la proposition
	If Not SDSPM_InitProp("") Then
		Exit Function
	End If
	
	' Extraire le site
	If Not SDSPM_InitSite(Nothing) Then
		Exit Function
	End If
	
	' Mettre à jour le site
	gnd_Site_SDSPM.Description = xVar(gnd_SDSPM, "Site_ClientNomInterne", "")
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_OrigineCle", "")
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ClientNoFmt", "") Or FPNav_SauvegarderDocument
	v_MajNomClient = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ClientNomInterne", "")
	FPNav_SauvegarderDocument = v_MajNomClient Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Site_SDSPM, "Site_NomSiteModifie", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Site_SDSPM, "Site_NomSiteListe", "") Or FPNav_SauvegarderDocument	
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_Banniere", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_BanniereDesc", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_Plateforme", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ProvenanceProspect", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ProvenanceProspectPrecision", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ClientAdresse1", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ClientAdresse2", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ClientVille", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ClientProvince", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ClientPays", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ClientCodePostal", "") Or FPNav_SauvegarderDocument
	v_GeoMaj = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ClientLatitude", "")
	v_GeoMaj = SDSPM_MajItem(gnd_Site_SDSPM, "Site_ClientLongitude", "") Or v_GeoMaj
	FPNav_SauvegarderDocument = v_GeoMaj Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_Notes", "") Or FPNav_SauvegarderDocument
	
		
	If FPNav_SauvegarderDocument Then
		gnd_Site_SDSPM.HistoDM = Now
		gnd_Site_SDSPM.HistoUM = gns_SDSPM.UserName
		Call gnd_Site_SDSPM.Save(True, False)
	End If
	
	' Maj produits automatiques livre de prix et interfaces manufacturier
	If Isarray(xVarArray(gnd_Site_SDSPM,"Site_Banniere")) Then
		If xVarImplode(gnd_Site_SDSPM,"Site_Banniere",";") &lt;&gt; Implode(g_Site_Banniere,";") Then
			Call FPNav_MajProduitsBanniere
		End If
	End If
		
	' Mettre à jour la proposition	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "PNav_MenuOptionMax", "")
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "PNav_MaxSiteOuvert", "") Or FPNav_SauvegarderDocument
	
	If xVarElem(gnd_Prop_SDSPM, "Prop_NoSites", 0, 0) = 0 Then
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Prop_SDSPM, "Prop_NoSites", xVar(gnd_Site_SDSPM, "Site_NoSite", "")) Or FPNav_SauvegarderDocument
	End If
	
	If FPNav_SauvegarderDocument Then
		gnd_Prop_SDSPM.HistoDM = Now
		gnd_Prop_SDSPM.HistoUM = gns_SDSPM.UserName
		Call gnd_Prop_SDSPM.Save(True, False)
	End If
	
	If v_MajNomClient Then
		'Mettre à jour le document de navigation
		Set ndc_Produits = SDSPS_ndcProduits(Cstr(xVar(gnd_Site_SDSPM, "Site_NoProposition", "") + ";" + xVar(gnd_Site_SDSPM, "Site_NoSite", "")))
		If ndc_Produits.Count &gt; 0 Then
			Call ndc_Produits.Stampall("Prod_NomSite", xVar(gnd_Site_SDSPM, "Site_ClientNomInterne",""))
		End If
		
	End If
	
	' Mise a jour Projeto
	v_Origine = xVar(gnd_Prop_SDSPM, "Prop_Origine", "")
	
	Set nd_Clie = xPJ_xndClie(v_Origine, xVar(gnd_Site_SDSPM, "Site_OrigineCle", ""), True)
	
	If 	v_Origine &lt;&gt; "SICl" Then
		If Not nd_Clie Is Nothing Then
			If xVar(gnd_Site_SDSPM, "Site_OrigineCle", "") = xVar(nd_Clie, "CleClient", "") Then
				If xVarImplode(gnd_Site_SDSPM,"Site_Banniere",";") &lt;&gt; xVarImplode(nd_Clie,"Clie_Banniere",";") Then
					nd_Clie.Clie_Banniere = xVarArray(gnd_Site_SDSPM,"Site_Banniere")
					nd_Clie.Clie_BanniereDesc = xVarArray(gnd_Site_SDSPM,"Site_BanniereDesc")
					v_MajClient = True
				End If
				
				If xVarImplode(gnd_Site_SDSPM,"Site_Plateforme",";") &lt;&gt; xVarImplode(nd_Clie,"Clie_Plateformes",";") Then
					nd_Clie.Clie_Plateformes = xVarArray(gnd_Site_SDSPM,"Site_Plateforme")
					v_MajClient = True
				End If
			End If
		End If
	End If
	
	If v_MajClient Then
		' Historique
		nd_Clie.HistoDM = Now
		nd_Clie.HistoUM = gns_SDSPM.UserName
		Call nd_Clie.Save(True, False)
	End If
	
	REM If xVar(gnd_SDSPM, "Prop_ClientNoFmt", "") &lt;&gt; "" Then
	If xVar(gnd_SDSPM, "Site_ClientNoFmt", "") &lt;&gt; "" Then
		
		If xVar(gnd_SDSPM, "Site_ClientNomInterne", "") &lt;&gt; xVar(gnd_SDSPM, "Clie_ClientNomInterne", "") Then
			gnd_SDSPM.PNav_MajNomClient = 1
		Else
			If xVar(gnd_SDSPM, "Site_ClientNomInterne", "") = xVar(gnd_SDSPM, "Site_NomSiteListe", "") Then
				gnd_SDSPM.PNav_MajNomClient = 0
			End If
		End If
		
		If xVar(gnd_SDSPM, "Site_ClientNomInterne", "") = xVar(gnd_SDSPM, "Clie_ClientNomInterne", "") Then
			gnd_SDSPM.Site_NomSiteModifie = "0"
		End If
		
	Else
	
		If xVar(gnd_SDSPM, "Site_ClientNomInterne", "") &lt;&gt; xVar(gnd_SDSPM, "Clie_ClientNom", "") Then
			gnd_SDSPM.PNav_MajNomClient = 1
		Else
			If xVar(gnd_SDSPM, "Site_ClientNomInterne", "") = xVar(gnd_SDSPM, "Site_NomSiteListe", "") Then
				gnd_SDSPM.PNav_MajNomClient = 0
			End If
		End If
		
		If xVar(gnd_SDSPM, "Site_ClientNomInterne", "") = xVar(gnd_SDSPM, "Clie_ClientNom", "") Then
			gnd_SDSPM.Site_NomSiteModifie = "0"
		End If
		
	End If
	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DescProposition", "") Or FPNav_SauvegarderDocument
	
	If FPNav_SauvegarderDocument Then
		gnd_Prop_SDSPM.HistoDM = Now
		gnd_Prop_SDSPM.HistoUM = gns_SDSPM.UserName
		Call gnd_Prop_SDSPM.Save(True, False)
	End if
	
	FPNav_SauvegarderDocument = True
FinSub:
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acCreerBonDeCommande"><lotusscript>Sub FPNav_acCreerBonDeCommande
	On Error Goto GererErreur
	
	Dim v_NoSite As String
	
	v_NoSite = xVar(gnd_Site_SDSPM, "Site_NoSite", "")
			
	If Not SDSPUI_acCreerBonDeCommande(gnd_Prop_SDSPM, v_NoSite, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
		Exit Sub
	Else
		gnd_Site_SDSPM.Site_NoBonCommandeFmtSIBDC = xSDSP3_xVarSite(v_NoSite, "Site_NoBonCommandeFmtSIBDC", 0, False)
	End If
	
	' Mettre à jour le document courant
	Call FPNav_DocumentExistant(gnd_SDSPM)
	Call gnuid_SDSPN.Refresh	
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_MajProduitsBanniere"><lotusscript>Sub FPNav_MajProduitsBanniere
	On Error Goto GererErreur
	
	Dim a_Bannieres As Variant
	Dim v_MajSite As Boolean
	Dim a_NoSites As Variant
	Dim v_Cle As String
	Dim a_CleProduits As variant
		
	a_Bannieres = xVarArray(gnd_Site_SDSPM,"Site_Banniere")
	
	If Not Isarray(g_Site_Banniere) Then
		g_Site_Banniere = Split(g_Site_Banniere, ";")
	End If	
				
	ForAll banniere In g_Site_Banniere
		If IsNull(ArrayGetIndex(a_Bannieres,banniere)) Then
			Call SDSPM_SupprimerProduitsBanniere("LG", banniere, Evaluate(|"Site_AjouterSDS" : "Site_D2_SDSRDV" : "Site_D1_Chrome" : "Site_D2_FormulairesInspOEM"|))
			Call SDSPM_SupprimerProduitsBanniere("EQ", banniere, Evaluate(|"Site_AjouterSDS" : "Site_D2_SDSRDV" : "Site_D1_Chrome" : "Site_D2_FormulairesInspOEM"|))
			End If
	End ForAll
	
	Call SDSPM_MajProduitsBanniere("","LG",a_Bannieres, Evaluate(|"Site_AjouterSDS"|))
	Call SDSPM_MajProduitsBanniere("","EQ",a_Bannieres, Evaluate(|"Site_AjouterSDS"|))
		
	v_Cle = xVar(gnd_Prop_SDSPM, "Prop_NoProposition", "") &amp; ";" &amp; xVar(gnd_Site_SDSPM, "Site_NoSite", "") &amp; ";" &amp; "Site_D2_SDSRDV"
	a_CleProduits = Evaluate(|@IfError(@DbLookup("" : "NoCache"; ""; "V_Prod40"; "| &amp; v_Cle &amp; |"; 2); "")|)
	
	If a_CleProduits(0) = "" Then
		v_MajSite = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Site_D2_AucunSDSRDV", "1") Or v_MajSite
	End If		
		
	If Not SDSPM_ProduitsBanniereDispo(a_Bannieres, "Site_D1_Chrome") Then		
		v_MajSite = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Site_D1_AucunChrome", "1") Or v_MajSite
		v_MajSite = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Site_D1_Chrome", "") Or v_MajSite
	Else				
		v_MajSite = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D1_AucunChrome", "") Or v_MajSite
		
		If xVar(gnd_Site_SDSPM, "Site_D1_Chrome", "") = "" And xVar(gnd_Site_SDSPM, "Site_D1_Ventes", "") &lt;&gt; "" Then
			a_NoSites = xVarArray(gnd_Prop_SDSPM, "Prop_NoSites")
			If xVar(gnd_Site_SDSPM, "Site_NoSite", "") = a_NoSites(xVar(gnd_SDSPM, "PNav_DernierSiteOuvert", 0) -1) Then
				gnd_SDSPM.PNav_MenuOptionMax = "2." &amp; Format(xVar(gnd_SDSPM, "PNav_DernierSiteOuvert", 0) -1, "00") &amp; ".02"
				Call SDSPN_MajSitesNav(gnd_SDSPM)
				Call SDSPN_ConstruireMenu(gnd_SDSPM)
				Call gnuid_SDSPN.Refresh
			End If
		End If
		
	End If
	
	If v_MajSite Then
		Call gnd_Site_SDSPM.Save(True, False)
	End If
	
	' ré-initialise la variable globale
	g_Site_Banniere = a_Bannieres
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
	
End Sub

</lotusscript></code><code event="FPNav_hsFermer"><lotusscript>Sub FPNav_hsFermer
	On Error Goto GererErreur
	
	' Sauvegarder l'étape courante
	If FPNav_SauvegarderDocument("") Then
		' Fermer le masque courant
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_PostOpen"><lotusscript>Sub FPNav_PostOpen(pnuid_Source As Notesuidocument)
	On Error Goto GererErreur
	
	' Initialisations
	Call SDSPN_Initialisations
	Call SDSPM_Initialisations
	
	'If xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; 1 Then
	'	Call gnuid_SDSPM.Refresh
	'End If
	If pnuid_Source.Editmode Then
		On Error 4412 Resume Next
		Call pnuid_Source.Refresh
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsCarteGoogle"><lotusscript>Sub FPNav_hsCarteGoogle
	On Error Goto GererErreur
	
	Dim a_NomClient(0) As String
	Dim a_Icone(0) As Variant
	Dim a_Latitude(0) As Double
	Dim a_Longitude(0) As Double
	Dim v_Resultat As Integer
	Dim v_Url As String
	
	If Not FPNav_DocumentValide_Adresse(True) Then
		Exit Sub
	End If
	
	If Not FPNav_DocumentValide_Coordonnees(True) Then
		Exit Sub
	End If
	
	a_NomClient(0) = xVar(gnd_SDSPM, "Site_ClientNomInterne", "")
	a_Icone(0) = ""
	a_Latitude(0) = xVar(gnd_SDSPM, "Site_ClientLatitude", 0)
	a_Longitude(0) = xVar(gnd_SDSPM, "Site_ClientLongitude", 0)
	v_Resultat = SIGg_GenererCarteGoogle(a_NomClient, a_Icone, a_Latitude, a_Longitude, gndb_SDSPM.Title, xGDK_xVarProf("Prof_CleGoogleAPI", ""), v_URL)
			
	If v_Resultat = -1 Then
		' Aucun document sélectionné.
		Messagebox xGDK_xMessage("SI", 2, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
	Else
		If v_Resultat &gt; 0 Then
			Messagebox xGDK_xMessage("SI", 188, "", ""), 64, xGDK_xMessage("SI", 98, "", Cstr(v_Resultat))
		End If		
		Call gnuiws_SDSPN.URLOpen(xGDK_xVarProf("Prof_Web_URLServeur", "http://dominohttp.serti.com") &amp; v_Url, True)		
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsNomInterneNonModifiable"><lotusscript>Function FPNav_hsNomInterneNonModifiable
	On Error GoTo GererErreur
	
	Call gnd_SDSPM.ReplaceItemValue( "Site_NomSiteModifie", "0")
	Call gnd_SDSPM.ReplaceItemValue( "Site_ClientNomInterne", xVar(gnd_SDSPM, "Site_NomSiteListe", ""))
	
	If xVar(gnd_SDSPM, "Site_ClientNoFmt", "") &lt;&gt; "" Then
		If xVar(gnd_SDSPM, "Site_ClientNomInterne", "") = xVar(gnd_SDSPM, "Clie_ClientNomInterne", "") Then
			Call gnd_SDSPM.ReplaceItemValue( "PNav_MajNomClient", 0)
		Else
			Call gnd_SDSPM.ReplaceItemValue( "PNav_MajNomClient", 1)
		End If
	Else
		If xVar(gnd_SDSPM, "Site_ClientNomInterne", "") &lt;&gt; xVar(gnd_SDSPM, "Clie_ClientNom", "") Then
			Call gnd_SDSPM.ReplaceItemValue( "PNav_MajNomClient", 1)
		Else
			Call gnd_SDSPM.ReplaceItemValue( "PNav_MajNomClient", 0)
		End If		
	End If
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPM.Refresh
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_hsNomInterneModifiable"><lotusscript>Function FPNav_hsNomInterneModifiable
	On Error Goto GererErreur
	
	
	Call gnd_SDSPM.ReplaceItemValue( "Site_NomSiteModifie", "1")
	Call gnd_SDSPM.ReplaceItemValue( "Site_NomSiteListe", xVar(gnd_SDSPM, "Site_ClientNomInterne", ""))
	
	Call gnuid_SDSPM.RefreshHideFormulas
	Call gnuid_SDSPM.Refresh
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acWorkflow"><lotusscript>Sub FPNav_acWorkflow(p_Statut As String)
	On Error GoTo GererErreur
		
	If SDSPM_acWorkflow(p_Statut) Then
		
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		Call gnuiws_SDSPM.ViewRefresh
		
		' Ouvrir le masque	
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		
		gnd_SDSPM.PNav_Titre =  Trim("C" &amp; CStr(xVar(gnd_Prop_SDSPM, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(gnd_Prop_SDSPM, "Prop_ClientNomInterne", xVar(gnd_Prop_SDSPM, "Prop_ClientNom", "")))
		gnd_SDSPM.Titre =  Trim(xVar(gnd_SDSPM, "PNav_Titre", "") &amp; " - " &amp; xVar(gnd_SDSPM, "PNav_MenuDesc000", ""))
				
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbProposition", xVar(gnd_Prop_SDSPM, "Prop_NbProposition", 0))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionFmt", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionFmt", ""))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionPrefixe", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionPrefixe", ""))		
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
		
		Call gnuid_SDSPN.Refresh	
	End If
		
	Exit Sub
		
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_InitialiserAdresseClient"><lotusscript>Sub FPNav_InitialiserAdresseClient(pnd_PNav As NotesDocument, p_Cache As Boolean)
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	
	Dim v_MajAdresse As Integer
	Dim v_MajNomClient As Integer
	Dim v_Origine As String
	Dim v_Serveur As String
	Dim v_ClientNoFmt As String
	
	Dim cl_Account As SLSf_clObject
	Dim v_Resultat As Integer	
	Dim v_NoOpportunite As String	
	
	v_MajAdresse = 0
	v_MajNomClient = 0
	v_Origine = xVar(pnd_PNav, "Prop_Origine", "")
	v_Serveur = pnd_PNav.Parentdatabase.Server
	If v_Serveur = "" Then
		If v_Origine &lt;&gt; "SICl" Then
			If FPNav_ndClientOrigine(pnd_PNav, nd, v_Origine, p_Cache) Then
				pnd_PNav.Clie_ClientNom = xVar(nd, "Clie_Nom", "")
				pnd_PNav.Clie_ClientNomInterne = xVar(nd, "Clie_ClientNomInterne", "")
				pnd_PNav.Clie_ClientAdresse1 = xVar(nd, "Clie_Adresse1", "")
				pnd_PNav.Clie_ClientAdresse2 = xVar(nd, "Clie_Adresse2", "")
				pnd_PNav.Clie_ClientVille = xVar(nd, "Clie_Ville", "")
				pnd_PNav.Clie_ClientProvince = xVar(nd, "Clie_Province", "")
				pnd_PNav.Clie_ClientPays = xVar(nd, "Clie_Pays", "")
				pnd_PNav.Clie_ClientCodePostal = xVar(nd, "Clie_CodePostal", "")
			End If
		End If
	Else


		If v_Origine = "SF" Then

			v_NoOpportunite = xVar(pnd_PNav, "Prop_NoOpportuniteSF" , "")

			' Extraire l'opportunité de Salesforce
			g_Resultat_FSFPP = FPNav_ExtraireOpportunite(v_NoOpportunite,"")
			If g_Resultat_FSFPP &lt; 0 Then
				Exit Sub
			Else
				Set cl_Account = gcl_SessionSLSf_FSFPP.Objects("Account")
			End If
			
			v_ClientNoFmt = cl_Account.ExtraireValeur("SERTI_ID__c", "")
			pnd_PNav.Clie_NoClientFmt = v_ClientNoFmt
			'pnd_PNav.Clie_NomLegal = cl_Account.ExtraireValeur("SERTI_Legal_Name__c", "")
			pnd_PNav.Clie_ClientNom = cl_Account.ExtraireValeur("Name", "")
			pnd_PNav.Clie_ClientNomInterne = xSICl_xVarClie(v_ClientNoFmt, "Clie_ClientNomInterne", "", True)
			
			pnd_PNav.Clie_ClientAdresse1 = cl_Account.ExtraireValeur("BillingStreet", "")
			pnd_PNav.Clie_ClientAdresse2 =  xVar(pnd_PNav, "Prop_ClientAdresse2" , "")
			pnd_PNav.Clie_ClientVille = cl_Account.ExtraireValeur("BillingCity", "")
			pnd_PNav.Clie_ClientProvince = cl_Account.ExtraireValeur("BillingStateCode", "")
			pnd_PNav.Clie_ClientPays = cl_Account.ExtraireValeur("BillingCountryCode", "")
			pnd_PNav.Clie_ClientCodePostal = cl_Account.ExtraireValeur("BillingPostalCode", "")
			
		Else

			If FPNav_ndClientOrigine(pnd_PNav, nd, v_Origine, p_Cache) Then
				If v_Origine = "SICl" Then
					'pnd_PNav.Clie_ClientNoFmt = xVar(nd, "Clie_ClientNoFmt", "")
					pnd_PNav.Clie_ClientNomInterne = xVar(nd, "Clie_ClientNomInterne", "")
					pnd_PNav.Clie_ClientNom = xVar(nd, "Clie_ClientNomEntreprise", "")
					pnd_PNav.Clie_ClientAdresse1 = xVar(nd, "Clie_ClientAdresse1", "")
					pnd_PNav.Clie_ClientAdresse2 = xVar(nd, "Clie_ClientAdresse2", "")
					pnd_PNav.Clie_ClientVille = xVar(nd, "Clie_ClientVille", "")
					pnd_PNav.Clie_ClientProvince = xVar(nd, "Clie_ClientProvince", "")
					pnd_PNav.Clie_ClientPays = xVar(nd, "Clie_ClientPays", "")
					pnd_PNav.Clie_ClientCodePostal = xVar(nd, "Clie_ClientCodePostal", "")
				Else
					pnd_PNav.Clie_NoClientFmt = xVar(nd, "Clie_NoClientFmt", "")
					pnd_PNav.Clie_ClientNom = xVar(nd, "Clie_Nom", "")
					pnd_PNav.Clie_ClientNomInterne = xVar(nd, "Clie_ClientNomInterne", "")
					pnd_PNav.Clie_ClientAdresse1 = xVar(nd, "Clie_Adresse1", "")
					pnd_PNav.Clie_ClientAdresse2 = xVar(nd, "Clie_Adresse2", "")
					pnd_PNav.Clie_ClientVille = xVar(nd, "Clie_Ville", "")
					pnd_PNav.Clie_ClientProvince = xVar(nd, "Clie_Province", "")
					pnd_PNav.Clie_ClientPays = xVar(nd, "Clie_Pays", "")
					pnd_PNav.Clie_ClientCodePostal = xVar(nd, "Clie_CodePostal", "")
				End If
			End If
		End If
		
	End If ' v_Serveur = ""
	
	' Validations
	If xVar(pnd_PNav, "Site_ClientAdresse1", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientAdresse1", "") _
	Or xVar(pnd_PNav, "Site_ClientAdresse2", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientAdresse2", "") _
	Or xVar(pnd_PNav, "Site_ClientVille", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientVille", "") _
	Or xVar(pnd_PNav, "Site_ClientProvince", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientProvince", "") _
	Or xVar(pnd_PNav, "Site_ClientPays", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientPays", "") _
	Or xVar(pnd_PNav, "Site_ClientCodePostal", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientCodePostal", "") Then
		v_MajAdresse = 1
	End If
	
	REM If xVar(pnd_PNav, "Prop_ClientNoFmt", "") &lt;&gt; "" Then
	If xVar(pnd_PNav, "Site_ClientNoFmt", "") &lt;&gt; "" Then
		If xVar(pnd_PNav, "Site_ClientNomInterne", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientNomInterne", "") Then
			v_MajNomClient = 1
		End If
	Else
		If xVar(pnd_PNav, "Site_ClientNomInterne", "") &lt;&gt; xVar(pnd_PNav, "Clie_ClientNom", "") Then
			v_MajNomClient = 1
		End If
	End If

	
	pnd_PNav.PNav_MajAdresse = v_MajAdresse
	pnd_PNav.PNav_MajNomClient = v_MajNomClient
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsMajNoClientSite"><lotusscript>Sub FPNav_hsMajNoClientSite
	On Error GoTo GererErreur
	
	Dim nd_CliePJ As NotesDocument
	Dim nd_SICl As NotesDocument
	Dim nd_Site As NotesDocument
	Dim v_NoClientFmt As String	
	Dim v_UserName As String
	Dim v_NoSite As String
	
	Dim ws_Proposition As Cl_proposition
	
	v_UserName = gns_SDSPM.UserName
	v_NoSite = xVar(gnd_Site_SDSPM, "Site_NoSite", "")
	
	' Sélectionner un client
	' ----------------------
	Set nd_CliePJ = SIPJ_ndSelectionnerClient(xVar(gnd_Prop_SDSPM, "Prop_Origine", ""), xGDK_xMessage("SI", 79, "",""), True)
	
	If Not (nd_CliePJ Is Nothing) Then	
		
		v_NoClientFmt = xVar(nd_CliePJ,"Clie_NoClientFmt","")
		Set nd_SICl = xSICl_xndClie(v_NoClientFmt, False)
		
		If Not nd_SICl Is Nothing Then		
			
			Set ws_Proposition = New Cl_proposition
			
			If ws_Proposition.Majnoclientsitesdsp3(v_NoSite, v_NoClientFmt, v_UserName) Then	
				gnd_SDSPM.SaveOptions = "0"
				Call gnuid_SDSPN.Close
				Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)	
			End If		
						
		End If
		
	End If
		
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsMajInfoClient"><lotusscript>Sub FPNav_hsMajInfoClient
	
	On Error Goto GererErreur
	
	Dim nd_ClientOrigineProposition As NotesDocument
	Dim v_Origine As String
	Dim v_NomClient As String
	Dim v_MajSite_ClientNomInterne As Boolean
	Dim ndc_Produits As NotesDocumentCollection
	
	
	v_Origine = xVar(gnd_SDSPM, "Prop_Origine", "")
	
	' Validations
	If Not FPNav_MajAdresseSiteClient Then
		Exit Sub
	End If
	
	' Maj	
	
	If xVar(gnd_SDSPM, "Site_ClientNoFmt", "") &lt;&gt; "" Then
		v_NomClient = xVar(gnd_SDSPM, "Clie_ClientNomInterne", "")
	Else
		v_NomClient = xVar(gnd_SDSPM, "Clie_ClientNom", "")
	End If
	
	v_MajSite_ClientNomInterne = SDSPM_MajItemValeur(gnd_SDSPM, "Site_ClientNomInterne", v_NomClient)
	
	gnd_SDSPM.Site_ClientNoFmt = xVar(gnd_SDSPM, "Clie_NoClientFmt", "")
	
	gnd_SDSPM.PNav_Titre = Trim("C" &amp; _
	Cstr(xVar(gnd_SDSPM, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(gnd_SDSPM, "Prop_ClientNomInterne", xVar(gnd_SDSPM, "Prop_ClientNom", "")))
	gnd_SDSPM.Titre = Trim(xVar(gnd_SDSPM, "PNav_Titre", "") &amp; " - " &amp; xVar(gnd_SDSPM, "PNav_MenuDesc000", ""))
	
	' Si le site et la proposition sont le même client maj le client de la proposition
	If FPNav_ndClientOriginePropositon(gnd_Prop_SDSPM, nd_ClientOrigineProposition, "", True) Then
		If v_Origine = "SICl" Then	' Si la proposition a été créée dans SI Clients
			If xVar(gnd_SDSPM, "Site_OrigineCle", "") = xVar(nd_ClientOrigineProposition, "Clie_ClientNoFmt", "") Then
				gnd_Prop_SDSPM.Prop_ClientNoFmt = xVar(gnd_Site_SDSPM, "Site_ClientNoFmt", "")
				gnd_Prop_SDSPM.Prop_ClientNomInterne = xVar(gnd_Site_SDSPM, "Site_ClientNomInterne", "")
				Call FPNav_MajAdresseClient
			End If
		Elseif xVar(gnd_SDSPM, "Site_OrigineCle", "") = xVar(nd_ClientOrigineProposition, "CleClient", "") Then	' Si créée dans Projeto
			gnd_Prop_SDSPM.Prop_ClientNom = xVar(gnd_SDSPM, "Site_ClientNomInterne", "")
			Call FPNav_MajAdresseClient
		End If
				
	End If
	
	' Maj nom site des produits
	If v_MajSite_ClientNomInterne Then
		Set ndc_Produits = SDSPS_ndcProduits(Cstr(xVar(gnd_Site_SDSPM, "Site_NoProposition", "") + ";" + xVar(gnd_Site_SDSPM, "Site_NoSite", "")))
		If ndc_Produits.Count &gt; 0 Then
			Call ndc_Produits.Stampall("Prod_NomSite", xVar(gnd_SDSPM, "Site_ClientNomInterne",""))
		End If
	End If
	
	gnd_SDSPM.PNav_MajNomClient = 0
	gnd_SDSPM.PNav_MajAdresse = 0
	
	If xVar(gnd_SDSPM, "Site_NomSiteListe","") = v_NomClient Then
		gnd_SDSPM.Site_NomSiteModifie = "0"
	End If
	
	
	Call gnuid_SDSPM.Refresh
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsAfficherClient"><lotusscript>Sub FPNav_hsAfficherClient
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	
	If FPNav_ndClientOrigine(gnd_SDSPM, nd, "", True) Then
		Call gnuiws_SDSPM.EditDocument(False, nd)
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_MajAdresseSiteClient"><lotusscript>Function FPNav_MajAdresseSiteClient As Boolean
	On Error Goto GererErreur
	
	FPNav_MajAdresseSiteClient = False
	
	' Validations
	If xVar(gnd_SDSPM, "Clie_ClientAdresse1", "") = "" Or xVar(gnd_SDSPM, "Clie_ClientVille", "") = "" _
	Or xVar(gnd_SDSPM, "Clie_ClientProvince", "") = "" Or xVar(gnd_SDSPM, "Clie_ClientPays", "") = "" _
	Or xVar(gnd_SDSPM, "Clie_ClientCodePostal", "") = "" Then
		Messagebox xGDK_xMessage("SDSPP", 39, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Clie_ClientProvince", "") &lt;&gt; xVar(gnd_SDSPM, "Site_ClientProvince", "") _
	Or xVar(gnd_SDSPM, "Clie_ClientPays", "") &lt;&gt; xVar(gnd_SDSPM, "Site_ClientPays", "") Then
		Messagebox xGDK_xMessage("SDSPP", 40, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	gnd_SDSPM.Site_ClientAdresse1 = xVar(gnd_SDSPM, "Clie_ClientAdresse1", "")
	gnd_SDSPM.Site_ClientAdresse2 = xVar(gnd_SDSPM, "Clie_ClientAdresse2", "")
	gnd_SDSPM.Site_ClientVille = xVar(gnd_SDSPM, "Clie_ClientVille", "")
	gnd_SDSPM.Site_ClientProvince = xVar(gnd_SDSPM, "Clie_ClientProvince", "")
	gnd_SDSPM.Site_ClientPays = xVar(gnd_SDSPM, "Clie_ClientPays", "")
	gnd_SDSPM.Site_ClientCodePostal = xVar(gnd_SDSPM, "Clie_ClientCodePostal", "")
	
	FPNav_MajAdresseSiteClient = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function


</lotusscript></code><code event="FPNav_acSignerProposition"><lotusscript>Sub FPNav_acSignerProposition
	On Error GoTo GererErreur
	
	If SDSPUI_acSignerProposition(gnd_Prop_SDSPM, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		
		Call gnuiws_SDSPM.ViewRefresh
		
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acRecalculerCouts"><lotusscript>Sub FPNav_acRecalculerCouts
	' -------------------------------------------------
	' Le script permet au directeur de modifier le prix
	' -------------------------------------------------
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument("") Then
		Exit Sub
	End If
	
	Call SDSPM_acRecalculerCouts(gnd_Prop_SDSPM, False, False)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsOuvrirMasque"><lotusscript>Sub FPNav_hsOuvrirMasque(p_NoItem As String)
	On Error Goto GererErreur
	
	Dim v_MenuItemCourant As String
	Dim v_ValiderDocument As Boolean
	Dim a_MenuItems As Variant
	Dim v_NoItem As String
	Dim i As Variant
	
	v_MenuItemCourant = xVar(gnd_SDSPM, "PNav_MenuItemCourant", "")
	a_MenuItems = xVarArray(gnd_SDSPM, "PNav_MenuItems")
	
	v_ValiderDocument = False
	
	' Si clique sur menu item qui est lui même, ne rien faire
	If v_MenuItemCourant = p_NoItem Then
		Exit Sub
	End If
	
	If p_NoItem = "**" Then
		v_NoItem = xVar(gnd_SDSPM, "PNav_MenuOptionMax", "")
		If a_MenuItems(Cint(v_MenuItemCourant)) = v_NoItem Then
			Exit Sub
		End If	
		i = Arraygetindex(a_MenuItems, xVar(gnd_SDSPM, "PNav_MenuOptionMax", "0.00"))
		If Not Isnull(i) Then
			v_NoItem = Cstr(i)
		End If
		
	Else
		v_NoItem = p_NoItem
	End If
	
	If Not Isnull(i) Then
		v_ValiderDocument = (xVar(gnd_SDSPM, "PNav_MenuProc" &amp; v_MenuItemCourant, "") = "1" And Cint(v_NoItem) &gt; Cint(v_MenuItemCourant))
	End If
	
	' Sauvegarder le document courante
	If FPNav_SauvegarderDocument(v_ValiderDocument) Then
		
		' Construire le menu
		If Not Isnull(i) Then
			If (xVar(gnd_SDSPM, "PNav_MenuProc" &amp; v_MenuItemCourant, "") = "1" And Cint(v_NoItem) &lt; Cint(v_MenuItemCourant)) Then
				Call SDSPN_ConstruireMenu(gnd_SDSPM)
				Call gnuid_SDSPM.Refresh
			End If
		Else
			Call SDSPN_ConstruireMenu(gnd_SDSPM)
			Call gnuid_SDSPM.Refresh
		End If
		
		' Ouvrir le masque suivant
		Call SDSPN_OuvrirMasqueMenu(p_NoItem)
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acCopierAdresse"><lotusscript>Sub FPNav_acCopierAdresse
	' Le script permet de copier l'adresse du client dans le clipboard de windows
	On Error Goto GererErreur
	
	Dim v_Adresse As String
	Dim v_NomClient As String
	
	v_NomClient = Ucase(xEvaluate(|@If(!@IsNull(Site_ClientNomInterne);Site_ClientNomInterne;Site_ClientNom)|, gnd_SDSPM))
	v_Adresse = xEvaluate(|@Implode("| &amp; v_NomClient &amp; |" : @Trim(Site_ClientAdresse1: Site_ClientAdresse2): Site_ClientVille : Site_ClientProvince_1 : Site_ClientPays_1 : Site_ClientCodePostal;@NewLine)|, gnd_SDSPM)
	
	If Not SLCl_AssignerTexteClipBoard(v_Adresse) Then
		Messagebox xGDK_xMessage("SDSPP", 60, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
	Else
		Messagebox xGDK_xMessage("SDSPP", 61, "", v_NomClient), 64, xGDK_xMessage("SI", 10, "", "")
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsPrecedent"><lotusscript>Sub FPNav_hsPrecedent
	On Error Goto GererErreur
	
	Dim a_MenuItems As Variant
	Dim i As Variant
	
	' Sauvegarder le document courante
	If FPNav_SauvegarderDocument(False) Then
		
		' Si document valide = false
		a_MenuItems = xVarArray(gnd_SDSPM, "PNav_MenuItems")
		
		' Validation
		If Not Isarray(a_MenuItems) Then
			Messagebox "Erreur de navigation (P1)", 16, "Opération annulée"
			Exit Sub
		End If
		i = Cint(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000"))
		If Isnull(i) Then
			Messagebox "Erreur de navigation (P2)", 16, "Opération annulée"
			Exit Sub
		Elseif i = 0 Then
			Messagebox "Erreur de navigation (P3)", 16, "Opération annulée"
			Exit Sub
		End If
		
		Call SDSPN_ConstruireMenu(gnd_SDSPM)
		
		' Ouvrir le masque précédent
		Call SDSPN_OuvrirMasquePrecedent
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_ndClientOrigine"><lotusscript>Function FPNav_ndClientOrigine(pnd_PNav As NotesDocument, pnd As NotesDocument, p_Origine As String, p_Cache As Boolean) As Boolean
	On Error Goto GererErreur
	
	Dim v_ClientNoFmt As String
	Dim v_OrigineCle As String
	
	FPNav_ndClientOrigine = False
	Set pnd = Nothing
	p_Origine = xVar(pnd_PNav, "Prop_Origine", "")
	
	If p_Origine = "SICl" Then
		v_ClientNoFmt = xVar(pnd_PNav, "Prop_ClientNoFmt", "")
		' Extraire le document SI Clients
		Set pnd = xSICl_xndClie(v_ClientNoFmt, False)		
		If pnd Is Nothing Then
			Messagebox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If
	ElseIf p_Origine = "SF" Then

	Else
		v_OrigineCle = xVar(pnd_PNav, "Site_OrigineCle", "")
		v_ClientNoFmt = xVar(pnd_PNav, "Site_ClientNoFmt","")
		
		' Selectionnez le doc de client           
		If v_ClientNoFmt &lt;&gt; "" Then
			Set pnd = xPJ_xndClieSI(p_Origine, v_ClientNoFmt, p_Cache)	
			If pnd Is Nothing Then
				MessageBox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
				Exit Function
			End If		
		Else	
			' Selectionnez le doc de client	
			Set pnd = xPJ_xndClie(p_Origine, v_OrigineCle, p_Cache)
			If pnd Is Nothing Then
				Messagebox xGDK_xMessage("SI", 78, "", v_OrigineCle), 16, xGDK_xMessage("SI", 1, "", "")
				Exit Function
			End If
		End if
	End If
	
	FPNav_ndClientOrigine = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acOuvrirBonCommande"><lotusscript>Sub FPNav_acOuvrirBonCommande
	On Error GoTo GererErreur
	
	Dim nd_BCom As NotesDocument
	Dim ndc_BCom As NotesDocumentCollection	
	Dim nd_Suivant As NotesDocument
	Dim nuid As NotesUIDocument
	Dim nv_BCom As NotesView	
	Dim v_Query As String		
	Dim v_Cle As String
	Dim v_CleSite As String
	
	'Initialisations
	Call xSIBDC2_Initialisations
	
	v_Cle = xVar(gnd_SDSPM, "Prop_NoProposition", 0)
	v_CleSite = xVar(gnd_SDSPM, "Site_NoBonCommandeFmtSIBDC", 0)
	
	' Sélectionner le bon de commande
	' -------------------------------	
	Set ndc_BCom = xSIBDC2_xndcBCom(v_Cle)
	
	If ndc_BCom.count = 0 Then		
		MessageBox xGDK_xMessage("SI", 70, "", ""), 16, xGDK_xMessage("SI", 1, "", "")		
		Exit Sub
		
	ElseIf  ndc_BCom.count = 1 Then
		
		Set nd_BCom = ndc_BCom.getfirstDocument
		
	ElseIf ndc_BCom.count &gt; 1 Then
		
		Set nd_Suivant = ndc_BCom.Getfirstdocument
		
		Do Until nd_Suivant Is Nothing
			Set nd_BCom = nd_Suivant
			
			If xVar(nd_BCom, "BCom_NoBonCommandeFmt", "") = v_CleSite Then
				Exit Do
			End If
			
			Set nd_Suivant = ndc_BCom.Getnextdocument(nd_Suivant)
		Loop
		
	End If
	
	If nd_BCom Is Nothing Then
		Exit Sub
	End If
	
	' Ouvrir le document
	' ------------------
	If xVar(nd_BCom, "BCom_NoBonCommandeFmt", "") = v_CleSite Then
		Set nuid = gnuiws_SDSPN.EditDocument( False , nd_BCom)
	End If
	
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

