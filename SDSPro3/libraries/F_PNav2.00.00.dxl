</lotusscript></code><code event="FPNav_QueryOpen"><lotusscript>Sub FPNav_QueryOpen(pnuid_Source As Notesuidocument, p_Mode As Integer, p_Isnewdoc As Variant, _
p_Continue As Variant)
	On Error Goto GererErreur
	
	Dim nd_PNav As NotesDocument
	Dim a_MenuItems As Variant
	
	' Initialisations
	p_Continue = False
	If p_Mode &lt;&gt; 1 Then
		Exit Sub
	End If
	
	Set nd_PNav = pnuid_Source.Document
	
	' Maj le menu
	If Not SDSPN_ConstruireMenu(nd_PNav) Then
		p_Continue = False
	End If
	
	a_MenuItems = xVarArray(nd_PNav, "PNav_MenuItems")
	nd_PNav.PNav_MenuItemCourant = Format(Arraygetindex(a_MenuItems, _
	xVar(nd_PNav, "PNav_MenuOptionCourante", "")), "000")
	
	' Initialiser les champs du document de navigation
	If FPNav_DocumentExistant(nd_PNav) Then
		p_Continue = True
	End If
	
	'Effacer les champs RT des autres écrans
	If nd_PNav.Hasitem("Prop_DescDetaillee") Then
		Call nd_PNav.Removeitem("Prop_DescDetaillee")
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentExistant"><lotusscript>Function FPNav_DocumentExistant(pnd_PNav As NotesDocument) As Boolean
	
	On Error GoTo GererErreur
	
	FPNav_DocumentExistant = False
	
	' Extraire la proposition
	If Not SDSPM_InitProp(xVar(pnd_PNav, "Prop_NoProposition", "")) Then
		Exit Function
	End If
	
	' Extraire le site
	If Not SDSPM_InitSite(pnd_PNav) Then
		Exit Function
	End If
	
	g_Site_Banniere = xVarArray(gnd_Site_SDSPM,"Site_Banniere")
	
	If Not IsArray(g_Site_Banniere) Then
		g_Site_Banniere = Split(g_Site_Banniere, ";")
	End If
	
	pnd_PNav.Prop_Statut = xVar(gnd_Prop_SDSPM, "Prop_Statut", "10")
	Call pnd_PNav.ReplaceItemValue("Prop_StatutDesc" &amp; xLangue, _
	xVar(gnd_Prop_SDSPM, "Prop_StatutDesc" &amp; xLangue, ""))
	
	' Mettre à jour le document de navigation
	pnd_PNav.Site_OrigineCle = xVar(gnd_Site_SDSPM, "Site_OrigineCle", "")
	
	pnd_PNav.Site_ClientNoFmt = xVar(gnd_Site_SDSPM, "Site_ClientNoFmt", "")
	pnd_PNav.Site_ClientNomInterne = xVar(gnd_Site_SDSPM, "Site_ClientNomInterne", "")
	pnd_PNav.Site_ClientNom = xVar(gnd_Site_SDSPM, "Site_ClientNom", "")
	
	pnd_PNav.Site_NomSiteModifie = xVar(gnd_Site_SDSPM, "Site_NomSiteModifie", "0")
	pnd_PNav.Site_NomSiteListe = xVar(gnd_Site_SDSPM, "Site_NomSiteListe", "")
	
	pnd_PNav.Prop_NoOpportuniteSF = xVar(gnd_Prop_SDSPM, "Prop_NoOpportuniteSF", "")
	pnd_PNav.Prop_ClientNoSF = xVar(gnd_Prop_SDSPM, "Prop_ClientNoSF", "")
	pnd_PNav.Prop_NoContactSF = xVar(gnd_Prop_SDSPM, "Prop_NoContactSF", "")
	
	pnd_PNav.Site_Banniere = xVar(gnd_Site_SDSPM, "Site_Banniere", "")
	pnd_PNav.Site_BanniereDesc = xVar(gnd_Site_SDSPM, "Site_BanniereDesc", "")
	pnd_PNav.Site_Plateforme = xVar(gnd_Site_SDSPM, "Site_Plateforme", "")
	pnd_PNav.Site_ProvenanceProspect = xVar(gnd_Site_SDSPM, "Site_ProvenanceProspect", "")
	pnd_PNav.Site_ProvenanceProspectPrecision = xVar(gnd_Site_SDSPM, "Site_ProvenanceProspectPrecision", "")
	pnd_PNav.Site_ClientAdresse1 = xVar(gnd_Site_SDSPM, "Site_ClientAdresse1", "")
	pnd_PNav.Site_ClientAdresse2 = xVar(gnd_Site_SDSPM, "Site_ClientAdresse2", "")
	pnd_PNav.Site_ClientVille = xVar(gnd_Site_SDSPM, "Site_ClientVille", "")
	pnd_PNav.Site_ClientProvince = xVar(gnd_Site_SDSPM, "Site_ClientProvince", "")
	pnd_PNav.Site_ClientPays = xVar(gnd_Site_SDSPM, "Site_ClientPays", "")
	pnd_PNav.Site_ClientCodePostal = xVar(gnd_Site_SDSPM, "Site_ClientCodePostal", "")
	pnd_PNav.Site_ClientLatitude = xVar(gnd_Site_SDSPM, "Site_ClientLatitude", 0)
	pnd_PNav.Site_ClientLongitude = xVar(gnd_Site_SDSPM, "Site_ClientLongitude", 0)
	
	pnd_PNav.Site_NoBonCommandeFmtSIBDC = xVar(gnd_Site_SDSPM, "Site_NoBonCommandeFmtSIBDC", "")
	pnd_PNav.Site_Notes = xVar(gnd_Site_SDSPM, "Site_Notes", "")
	
	
	pnd_PNav.Prop_PropositionImprimee = xVar(gnd_Prop_SDSPM, "Prop_PropositionImprimee", "")
	pnd_PNav.Prop_NoSites = xVar(gnd_Prop_SDSPM, "Prop_NoSites", "")
	
	pnd_PNav.Prop_NotesContrat = xVar(gnd_Prop_SDSPM, "Prop_NotesContrat", "")
	
	Call FPNav_InitialiserAdresseClient(pnd_PNav, False)
	
	FPNav_DocumentExistant = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Function
	
	
End Function


</lotusscript></code><code event="FPNav_ndClientOriginePropositon"><lotusscript>Function FPNav_ndClientOriginePropositon(pnd_Prop As NotesDocument, pnd As NotesDocument, p_Origine As String, p_Cache As Boolean) As Boolean
	On Error Goto GererErreur
	
	Dim v_ClientNoFmt As String
	Dim nd_Proj As NotesDocument
	
	FPNav_ndClientOriginePropositon = False
	Set pnd = Nothing
	p_Origine = xVar(pnd_Prop, "Prop_Origine", "")
	
	If p_Origine = "SICl" Then		
		v_ClientNoFmt = xVar(pnd_Prop, "Prop_ClientNoFmt", "")
		' Extraire le document SI Clients
		Set pnd = xSICl_xndClie(v_ClientNoFmt, False)
		If pnd Is Nothing Then
			Messagebox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If
	ElseIf p_Origine = "SF" Then

	Else		
		Set nd_Proj = xPJ_xndProj(p_Origine, xVar(pnd_Prop, "Prop_NoProjet", ""), True)
		If nd_Proj Is Nothing Then
		' Le document de référence (client ou projet) est introuvable.
			Messagebox xGDK_xMessage("SDSPP", 4, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If		
		' Selectionnez le doc de client
		Set pnd = xPJ_xndClie(p_Origine, xVar(nd_Proj, "Clie_NoClient", ""), p_Cache) 
		If pnd Is Nothing Then
			Messagebox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If
	End If
	
	FPNav_ndClientOriginePropositon = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(pnd_Prop, "Cle", ""), False)
	Exit Function
End Function</lotusscript></code>
