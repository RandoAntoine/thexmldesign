<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_GestionErreurs"
Use "x_SICl"
Use "x_PJ"

</lotusscript></code><code event="declarations"><lotusscript>' Traitement des erreurs
' -----------------------------------
Const gc_TypeElement_FPrCl = "SL"
Const gc_Element_FPrCl = "F_PrCl"

' Déclarations globales
' ----------------------------------
Dim gnuiws_FPrCl As NotesUIWorkspace
Dim gnuid_FPrCl As NotesUIDocument
Dim gnd_FPrCl As NotesDocument

Dim gns_FPrCl As NotesSession
Dim gndb_FPrCl As NotesDatabase






</lotusscript></code><code event="FPrCl_Initialisations"><lotusscript>Sub FPrCl_Initialisations
	If gns_FPrCl Is Nothing Then
		Set gns_FPrCl = New NotesSession
		Set gndb_FPrCl = gns_FPrCl.Currentdatabase		
		Set gnuiws_FPrCl = New NotesUIWorkspace
	End If
	
	If gnuiws_FPrCl Is Nothing Then
		Set gnuiws_FPrCl = New NotesUIWorkspace
		Set gnuid_FPrCl = gnuiws_FPrCl.CurrentDocument
		Set gnd_FPrCl = gnuid_FPrCl.Document
	End If
End Sub

</lotusscript></code><code event="FPrCl_hsAfficherClient"><lotusscript>Sub FPrCl_hsAfficherClient
	On Error GoTo GererErreur
	
	Dim v_ClientNoFmt As String
	Dim nd As NotesDocument
	Dim nd_ClieSICl As NotesDocument
	
	Set gnuiws_FPrCl = Nothing
	
	Call FPrCl_Initialisations
	
	Set nd = gnuiws_FPrCl.Currentdocument.Document
	
	v_ClientNoFmt = xVar(nd, "PrCl_ClientNoFmt", "")
	
	Set nd_ClieSICl = xSICl_xndClie(v_ClientNoFmt, False)

	If not nd_ClieSICl Is Nothing Then
	Call gnuiws_FPrCl.EditDocument(False, nd_ClieSICl)
	Else
		MessageBox xGDK_xMessage("SI", 78, "", v_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
		Exit sub
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPrCl, gc_Element_FPrCl, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code>
