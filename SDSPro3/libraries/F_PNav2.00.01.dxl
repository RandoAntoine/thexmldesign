</lotusscript></code><code event="FPNav_acDupliquerProposition"><lotusscript>Sub FPNav_acDupliquerProposition
	On Error GoTo GererErreur
	
	Dim ndb As NotesDatabase
	Dim nd_Duplicata As NotesDocument
	Dim nd_DB As NotesDocument
	
	Dim v_UserName As String
	Dim v_Description As Variant
	Dim v_ID As String
	Dim v_DB_ID As String
	Dim v_EditMode As String
	Dim v_Commentaire As String
	Dim v_DBRecalcTous As Boolean
	Dim v_RecalcListe As Boolean
	
	On Error 4411 GoTo FinSub
	Call gnuid_SDSPM.Save
	
	' Demander la nouvelle description à l'utilisateur
	v_Description = gnuiws_SDSPM.Prompt(PROMPT_OKCANCELEDIT, _
	xGDK_xMessage("SDSPP", 46, "", ""), xGDK_xMessage("SDSPP", 47, "", ""), CStr(Today()))
	If v_Description = "" Then
		Exit Sub
	Else
		If v_Description = xVar(gnd_SDSPM,"Prop_DescProposition","") Then
			MessageBox xGDK_xMessage("SDSPP", 48, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		End If
	End If
	
	Set nd_DB = New NotesDocument(gndb_SDSPM)
	nd_DB.Form = "DB_SIHi"	
	nd_DB.SIHi_Obligatoire = True	' Image "&gt;" pour Commentaire obligatoire
	
	If Not gnuiws_SDSPN.DialogBox("DB_SIHi", True, True, False, False, False, False, _
	xGDK_xMessage("SI", 49, "", ""), nd_DB, True, False, False) Then
		Exit Sub
	End If
	
	v_Commentaire = xVar(nd_DB, "SIHi_Commentaire", "")
	v_UserName = gns_SDSPM.UserName
	v_EditMode = xVar(gnd_SDSPM, "PNav_EditMode", "")
	
	Call SDSPDp_DupliquerProposition(gnd_Prop_SDSPM,CStr(v_Description), nd_Duplicata, nd_DB, v_UserName)
	
	If Not nd_Duplicata Is Nothing Then
		Call SDSPM_acRecalculerCouts(nd_Duplicata, False, False)
		
		' Fermer la proposition
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPM.Close
		Call gnuiws_SDSPM.ViewRefresh
	Else
		Call gnuid_SDSPM.Refresh
	End If
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

	

