>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>' Site \ Comptabilité
Option Public
Option Declare
Use "wsc_SDSP3"
Use "SDSP_MasquePNav"
Use "SDSP_Navigation"

</lotusscript></code><code event="declarations"><lotusscript>' Déclarations globales
' ---------------------
Const gc_SectionPaie = 6

Dim g_Site_D0_StatsOnline_FPNav As String
Dim g_Site_D0_MontageElectronique_FPNav As String
Dim g_Site_D0_ModuleMessagerieSDS_FPNav As String
Dim g_Site_D0_Location_FPNav As String
Dim g_Site_D0_ModuleSDSDrive_FPNav
Dim g_Site_D6_Section_FPNav As String

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_FPNav = "SL"
Const gc_Element_FPNav = "F_PNav2.00.01"

</lotusscript></code><code event="FPNav_PostOpen"><lotusscript>Sub FPNav_PostOpen(pnuid_Source As Notesuidocument)
	On Error Goto GererErreur
	
	' Initialisations
	Call SDSPN_Initialisations
	Call SDSPM_Initialisations
	
	If pnuid_Source.Editmode Then
		On Error 4412 Resume Next
		Call pnuid_Source.Refresh
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsFermer"><lotusscript>Sub FPNav_hsFermer
	On Error Goto GererErreur
	
	' Sauvegarder l'étape courante
	If FPNav_SauvegarderDocument("") Then
		' Fermer le masque courant
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentValide"><lotusscript>Function FPNav_DocumentValide(p_AfficherErreur As Boolean) As Boolean
	On Error Goto GererErreur
	
	Dim a_CleProduitsNonDisponible As Variant
	
	FPNav_DocumentValide = False
	
	If xVar(gnd_SDSPM, "Prop_DescProposition", "") = "" Then
		If p_AfficherErreur Then
			MessageBox xGDK_xMessage("SI", 23, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
			Call gnuid_SDSPN.GotoField("Prop_DescProposition")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_D0_NbUtilisateurs", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (2)"
			Call gnuid_SDSPN.GotoField("Site_D0_NbUtilisateurs")
		End If
		Exit Function
	End If
	If xVarElem(gnd_SDSPM, "Site_D0_Imprimantes", 0, "") = "" And _
	xVar(gnd_SDSPM, "Site_D0_AucuneImprimante", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (3)"
'			Call gnuid_SDSPN.GotoField("Site_D0_Imprimantes")
		End If
		Exit Function
	End If
	If Not SDSPM_ValiderProduitsDepartement("0", "EQ.15", "Site_D0_Imprimantes", a_CleProduitsNonDisponible) Then
		If p_AfficherErreur Then
			Call SDSPM_AfficherProduitsNonDispo(a_CleProduitsNonDisponible)
			'Messagebox xGDK_xMessage("SDSPP", 15, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (3)"
'			Call gnuid_SDSPN.GotoField("Site_D0_Imprimantes")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_D0_NbPC", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (4)"
			Call gnuid_SDSPN.GotoField("Site_D0_NbPC")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_D0_NbEcrans", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (5)"
			Call gnuid_SDSPN.GotoField("Site_D0_NbEcrans")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_D6_Section", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (6)"
'			Call gnuid_SDSPN.GotoField("Site_D6_Section")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_D6_Section", "") = "1" And  xVar(gnd_SDSPM, "Site_D0_NbEmployesPaie", 0) &lt;= 0	 Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (7)"
			Call gnuid_SDSPN.GotoField("Site_D0_NbEmployesPaie")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_D0_Location", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (8)"
'			Call gnuid_SDSPN.GotoField("Site_D0_Location")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_D0_Location", "") = "1" And  xVar(gnd_SDSPM, "Site_D0_NbVehicules", 0) &lt;= 0	 Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (9)"
			Call gnuid_SDSPN.GotoField("Site_D0_NbVehicules")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_D0_StatsOnline", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (10)"
'			Call gnuid_SDSPN.GotoField("Site_D0_StatsOnline")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_D0_MontageElectronique", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (11)"
'			Call gnuid_SDSPN.GotoField("Site_D0_MontageElectronique")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_D0_ModuleSDSDrive", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (12)"
'			Call gnuid_SDSPN.GotoField("Site_D0_ModuleSDSDrive")
		End If
		Exit Function		
	End If
	If xVar(gnd_SDSPM, "Site_D0_ModuleMessagerieSDS", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (13)"
'			Call gnuid_SDSPN.GotoField("Site_D0_ModuleMessagerieSDS")
		End If
		Exit Function
	End If
	
	FPNav_DocumentValide = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acWorkflow"><lotusscript>Sub FPNav_acWorkflow(p_Statut As String)
	On Error GoTo GererErreur
		
	If SDSPM_acWorkflow(p_Statut) Then
		
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		Call gnuiws_SDSPM.ViewRefresh
		
		' Ouvrir le masque	
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		
		gnd_SDSPM.PNav_Titre =  Trim("C" &amp; CStr(xVar(gnd_Prop_SDSPM, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(gnd_Prop_SDSPM, "Prop_ClientNomInterne", xVar(gnd_Prop_SDSPM, "Prop_ClientNom", "")))
		gnd_SDSPM.Titre =  Trim(xVar(gnd_SDSPM, "PNav_Titre", "") &amp; " - " &amp; xVar(gnd_SDSPM, "PNav_MenuDesc000", ""))
				
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbProposition", xVar(gnd_Prop_SDSPM, "Prop_NbProposition", 0))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionFmt", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionFmt", ""))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionPrefixe", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionPrefixe", ""))		
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
		
		Call gnuid_SDSPN.Refresh
	End If
		
	Exit Sub
		
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acImage"><lotusscript>Sub FPNav_acImage
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument("") Then
		Exit Sub
	End If
	
	Call SDSPM_acImage(gnd_Prop_SDSPM)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

