</lotusscript></code><code event="FPNav_QueryOpen"><lotusscript>Sub FPNav_QueryOpen(pnuid_Source As Notesuidocument, p_Mode As Integer, p_Isnewdoc As Variant, _
p_Continue As Variant)
	On Error Goto GererErreur
	
	Dim nd_PNav As NotesDocument
	
	' Initialisations
	p_Continue = False
	If p_Mode &lt;&gt; 1 Then
		Exit Sub
	End If
	
	Set nd_PNav = pnuid_Source.Document
	
	' Initialiser les champs du document de navigation
	If FPNav_DocumentExistant(nd_PNav) Then
		p_Continue = True
	End If
	
	' Effacer les champs RT des autres écrans
	If nd_PNav.Hasitem("Prop_DescDetaillee") Then
		Call nd_PNav.Removeitem("Prop_DescDetaillee")
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentExistant"><lotusscript>Function FPNav_DocumentExistant(pnd_PNav As NotesDocument) As Boolean
	On Error Goto GererErreur
	
	FPNav_DocumentExistant = False
	
	' Extraire la proposition
	If Not SDSPM_InitProp(xVar(pnd_PNav, "Prop_NoProposition", "")) Then
		Exit Function
	End If
	
	' Extraire le site
	If Not SDSPM_InitSite(pnd_PNav) Then
		Exit Function
	End If
	
	g_Site_D0_StatsOnline_FPNav = xVar(gnd_Site_SDSPM, "Site_D0_StatsOnline", "")	
	g_Site_D0_MontageElectronique_FPNav = xVar(gnd_Site_SDSPM, "Site_D0_MontageElectronique", "")
	g_Site_D0_ModuleMessagerieSDS_FPNav = xVar(gnd_Site_SDSPM, "Site_D0_ModuleMessagerieSDS", "")
	g_Site_D0_Location_FPNav = xVar(gnd_Site_SDSPM, "Site_D0_Location", "")
	g_Site_D0_ModuleSDSDrive_FPNav = xVar(gnd_Site_SDSPM, "Site_D0_ModuleSDSDrive", "")
	g_Site_D6_Section_FPNav = xVar(gnd_Site_SDSPM, "Site_D6_Section", "")
	
	
	pnd_PNav.Prop_Statut = xVar(gnd_Prop_SDSPM, "Prop_Statut", "10")
	Call pnd_PNav.ReplaceItemValue("Prop_StatutDesc" &amp; xLangue, _
	xVar(gnd_Prop_SDSPM, "Prop_StatutDesc" &amp; xLangue, ""))
	
	' Mettre à jour l'entête du site
	pnd_PNav.Site_ClientNomInterne = xVar(gnd_Site_SDSPM, "Site_ClientNomInterne", "")
	pnd_PNav.Site_Banniere = xVar(gnd_Site_SDSPM, "Site_Banniere", "")
	pnd_PNav.Site_BanniereDesc = xVar(gnd_Site_SDSPM, "Site_BanniereDesc", "")
	
	' Mettre à jour l'information requise
	pnd_PNav.Site_D0_Section = xVar(gnd_Site_SDSPM, "Site_D0_Section", "")
	pnd_PNav.Site_D0_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D0_NbUtilisateurs", "")
	pnd_PNav.Site_D1_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D1_NbUtilisateurs", 0)
	pnd_PNav.Site_D2_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D2_NbUtilisateurs", 0)
	pnd_PNav.Site_D4_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D4_NbUtilisateurs", 0)
	pnd_PNav.Site_D5_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D5_NbUtilisateurs", 0)
	
	' Mettre à jour le document de navigation
	Call SDSPM_InitProduitsProgramme(pnd_PNav, "Site_D0_Imprimantes", "", "")
	pnd_PNav.Site_D0_AucuneImprimante = xVar(gnd_Site_SDSPM, "Site_D0_AucuneImprimante", "")
	pnd_PNav.Site_D0_NbPC = xVar(gnd_Site_SDSPM, "Site_D0_NbPC", "")
	pnd_PNav.Site_D0_NbEcrans = xVar(gnd_Site_SDSPM, "Site_D0_NbEcrans", "")
	
	pnd_PNav.Site_D6_Section = xVar(gnd_Site_SDSPM, "Site_D6_Section", "")
	pnd_PNav.Site_D0_NbEmployesPaie = xVar(gnd_Site_SDSPM, "Site_D0_NbEmployesPaie", "")
	pnd_PNav.Site_D0_Location = xVar(gnd_Site_SDSPM, "Site_D0_Location", "")
	pnd_PNav.Site_D0_NbVehicules = xVar(gnd_Site_SDSPM, "Site_D0_NbVehicules", "")
	pnd_PNav.Site_D0_StatsOnline = xVar(gnd_Site_SDSPM, "Site_D0_StatsOnline", "")
	pnd_PNav.Site_D0_MontageElectronique = xVar(gnd_Site_SDSPM, "Site_D0_MontageElectronique", "")
	pnd_PNav.Site_D0_ModuleSDSDrive = xVar(gnd_Site_SDSPM, "Site_D0_ModuleSDSDrive", "")	
	pnd_PNav.Site_D0_ModuleMessagerieSDS = xVar(gnd_Site_SDSPM, "Site_D0_ModuleMessagerieSDS", "")
	
	pnd_PNav.Prop_PropositionImprimee = xVar(gnd_Prop_SDSPM, "Prop_PropositionImprimee", "")
	
	' Initialise pour payroll 
	pnd_PNav.Calc_WEB =  xVar(gnd_Site_SDSPM, "Calc_WEB", "")
	pnd_PNav.Calc_CAR =  xVar(gnd_Site_SDSPM, "Calc_CAR", "")
	pnd_PNav.Calc_PLANE=  xVar(gnd_Site_SDSPM, "Calc_PLANE", "")
	pnd_PNav.Calc_HOTEL =  xVar(gnd_Site_SDSPM, "Calc_HOTEL", "")
	pnd_PNav.Calc_MEAL =  xVar(gnd_Site_SDSPM, "Calc_MEAL", "")
	pnd_PNav.Calc_KM =  xVar(gnd_Site_SDSPM, "Calc_KM", "")
	pnd_PNav.Calc_TRAIN=  xVar(gnd_Site_SDSPM, "Calc_TRAIN", "")
	pnd_PNav.Calc_ROAD=  xVar(gnd_Site_SDSPM, "Calc_ROAD", "")
	
	pnd_PNav.Prop_NotesContrat = xVar(gnd_Prop_SDSPM, "Prop_NotesContrat", "")
	
	FPNav_DocumentExistant = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_SauvegarderDocument"><lotusscript>Function FPNav_SauvegarderDocument(p_ValiderDocument As Variant) As Boolean
	On Error Goto GererErreur
	
	Dim v_NoOptionCourante As String
	Dim v_NoOptionMax As String
	Dim v_DocumentValide As Boolean
	Dim v_MajProp As Boolean
	Dim v_MajNbUtilisateurs As Boolean
	Dim v_MajNbPaie As Boolean
	Dim v_MajModuleMessagerieSDS As Boolean
	Dim nv_Prod25 As NotesView
	Dim ndc_Produits As NotesDocumentCollection
	Dim nd_Prod As NotesDocument
	Dim nd_Suivant As NotesDocument
	Dim v_MajProd As Boolean
	Dim v_MajProd_ON As Boolean
	Dim a_Calc(7) As String
	Dim i As Integer
	Dim v_NbInstallateurs As Variant
	Dim v_NbJours As Integer
	Dim v_NbJoursInstall As Double
	Dim v_NbVoitures As Integer
	Dim v_CleProduit As Variant
	Dim nv_Prod40 As NotesView
	Dim nd_Prod40 As NotesDocument
	Dim nd_Log As NOtesDocument
	Dim v_UserName As String
	
	If xVar(gnd_SDSPM, "PNav_EditMode", False) Then
		FPNav_SauvegarderDocument = False
	Else
		FPNav_SauvegarderDocument = True
		Exit Function
	End If
	
	' Calculer les champs automatiques
	On Error 4412 Goto FinSub
	Call gnuid_SDSPN.Refresh
	On Error 4412 Goto GererErreur
	
	' Initialisations
	Set nv_Prod25 = gndb_SDSPM.GetView("v_Prod25")
	
	a_Calc(0) = "Calc_CAR"
	a_Calc(1) = "Calc_PLANE"
	a_Calc(2) = "Calc_HOTEL"
	a_Calc(3) = "Calc_KM"
	a_Calc(4) = "Calc_MEAL"
	a_Calc(5) = "Calc_TRAIN"
	a_Calc(6) = "Calc_ROAD"
	a_Calc(7) = "Calc_WEB"
	
	' Valider le document courant
	v_NoOptionCourante = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "0.00")
	v_NoOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionMax", "0.00")
	If p_ValiderDocument = "" Then
		v_DocumentValide = FPNav_DocumentValide(CInt(v_NoOptionCourante &lt; v_NoOptionMax))
	Else
		v_DocumentValide = FPNav_DocumentValide(CInt(p_ValiderDocument))
	End If
	If v_DocumentValide = False Then
		If p_ValiderDocument = True Then
			Call gnuid_SDSPN.RefreshHideFormulas
			Exit Function
		End If
		
		gnd_SDSPM.PNav_MenuOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "")
	End If
	
	' Extraire la proposition
	If Not SDSPM_InitProp("") Then
		Exit Function
	End If
	
	' Extraire le site
	If Not SDSPM_InitSite(Nothing) Then
		Exit Function
	End If
	
	If xVarProf("Prof_LogProduits", "") = "1" Then
		Set nd_Log = New NotesDocument(gndb_SDSPM)
	End If
	
	' Mettre à jour le site	
	v_MajNbUtilisateurs = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_NbUtilisateurs", "")
	FPNav_SauvegarderDocument = v_MajNbUtilisateurs Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_Section", "") Or FPNav_SauvegarderDocument
	v_UserName = gns_SDSPM.UserName
	If xVar(gnd_SDSPM, "Site_D0_AucuneImprimante", "") = "1" Then
		Call SDSPM_SupprimerProduitsDepartement("Site_D0_Imprimantes", "")
	End If
	
	' Si pas de payroll, initialise quantié à zero.
	If xVar(gnd_SDSPM, "Site_D6_Section", "") = "0" And g_Site_D6_Section_FPNav = "1" Then
		v_MajNbUtilisateurs = True
		
		' Maj items pour ré-initialser valeurs de formation payroll
		gnd_SDSPM.Site_D0_NbEmployesPaie = 0
		FPNav_SauvegarderDocument = SIIx_MajItem(gnd_Site_SDSPM, "Site_D0_NbEmployesPaie", 0, False) Or FPNav_SauvegarderDocument
		
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_NbInstallateurs" &amp; CStr(gc_SectionPaie),CInt(xComplTabl("NBI" &amp; CStr(gc_SectionPaie), "Form_ValDefaut", "1", True))) Or FPNav_SauvegarderDocument
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_NbjoursPaie" &amp; CStr(gc_SectionPaie),CInt(xComplTabl("NBJPAIE" &amp; CStr(gc_SectionPaie), "Form_ValDefaut", "1", True))) Or FPNav_SauvegarderDocument
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_NbJours" &amp; CStr(gc_SectionPaie),CInt(xComplTabl("NBJ" &amp; CStr(gc_SectionPaie), "Form_ValDefaut", "1", True))) Or FPNav_SauvegarderDocument
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_NbVoitures" &amp; CStr(gc_SectionPaie),CInt(xComplTabl("NBV" &amp; CStr(gc_SectionPaie), "Form_ValDefaut", "1", True))) Or FPNav_SauvegarderDocument
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_SurPlace" &amp; CStr(gc_SectionPaie), "") Or FPNav_SauvegarderDocument
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_Selection" &amp; CStr(gc_SectionPaie), "") Or FPNav_SauvegarderDocument
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_NbSessions" &amp; CStr(gc_SectionPaie),CInt(xComplTabl("NBS" &amp; CStr(gc_SectionPaie), "Form_ValDefaut", "1", True))) Or FPNav_SauvegarderDocument
		
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_CARExtra" &amp; CStr(gc_SectionPaie), "") Or FPNav_SauvegarderDocument
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_HOTELExtra" &amp; CStr(gc_SectionPaie), "") Or FPNav_SauvegarderDocument
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_KMExtra" &amp; CStr(gc_SectionPaie), "") Or FPNav_SauvegarderDocument
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_ROADExtra" &amp; CStr(gc_SectionPaie), "") Or FPNav_SauvegarderDocument
		FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Site_SDSPM, "Calc_MEALExtra" &amp; CStr(gc_SectionPaie), "") Or FPNav_SauvegarderDocument
		
		' Sélectionner les produits paie
		Set ndc_Produits = xndc(xVar(gnd_Site_SDSPM, "Site_NoSite", "") + ";" + "SV.31", gndb_SDSPM , "V_Prod25", nv_Prod25)
		
		Set nd_Suivant = ndc_Produits.GetFirstDocument
		Do Until nd_Suivant Is Nothing
			Set nd_Prod = nd_Suivant
			Set nd_Suivant = ndc_Produits.GetNextDocument(nd_Suivant)
			
			If xVar(nd_Prod, "Prod_Quantite", 0) &gt; 0 Then
				v_MajProd = SIIx_MajItem(nd_Prod, "Prod_Quantite", 0, False) Or v_MajProd
				v_MajProd = SIIx_MajItem(nd_Prod, "Prod_PrixTotal", SItN_RoundUp((xVar(nd_Prod, "Prod_Quantite", 0) * xVar(nd_Prod, "Prod_PrixUnitaire", 0))), False) Or v_MajProd
				v_MajProd = SIIx_MajItem(nd_Prod, "Prod_CoutTotal", (xVar(nd_Prod, "Prod_Quantite", 0) * xVar(nd_Prod, "Prod_CoutUnitaire", 0)), False) Or v_MajProd
				v_MajProd = SIIx_MajItem(nd_Prod, "Prod_Profit", (xVar(nd_Prod, "Prod_PrixTotal", 0) - xVar(nd_Prod, "Prod_CoutTotal", 0)), False) Or v_MajProd
			End If
			
			If v_MajProd Then
				nd_Prod.HistoDM = Now
				nd_Prod.HistoUM = v_UserName
				Call nd_Prod.Save(True, False)
			End If
			
		Loop
		
	ElseIf xVar(gnd_SDSPM, "Site_D6_Section", "") = "1" And g_Site_D6_Section_FPNav = "0" Then
	
		' ré-initialise produits payroll (6) avec valeurs par défault de formations	
		v_NbInstallateurs = xVar(gnd_Site_SDSPM, "Calc_NbInstallateurs" &amp; CStr(gc_SectionPaie), xComplTabl("NBI" &amp; CStr(gc_SectionPaie), "Form_ValDefaut", "1", True))
		v_NbJours = xVar(gnd_Site_SDSPM, "Calc_NbJours" &amp; CStr(gc_SectionPaie), xComplTabl("NBJ" &amp; CStr(gc_SectionPaie), "Form_ValDefaut", "1", True))
		
		If v_NbJours &gt; 0 And v_NbInstallateurs &gt; 0 Then
			v_NbJoursInstall = (v_NbInstallateurs * v_NbJours)
			v_NbVoitures = xVar(gnd_Site_SDSPM, "Calc_NbVoitures" &amp; CStr(gc_SectionPaie), xComplTabl("NBV" &amp; CStr(gc_SectionPaie), "Form_ValDefaut", "1", True))
		End If
		
		
		For i = 0 To UBound(a_Calc)
			
			Select Case a_Calc(i)
			
			Case "Calc_CAR"
				If IsArray(xVarArray(gnd_Site_SDSPM, a_Calc(i))) Then
					Call SDSPM_MajProduitsProgramme("", a_Calc(i) &amp; CStr(gc_SectionPaie), "", (v_NbVoitures * v_NbJours) ,0, "", "")
				End If
			Case "Calc_PLANE"
				If IsArray(xVarArray(gnd_Site_SDSPM, a_Calc(i))) Then
					Call SDSPM_MajProduitsProgramme("", a_Calc(i) &amp; CStr(gc_SectionPaie), "", v_NbInstallateurs ,0, "", "")
				End If
			Case "Calc_HOTEL"
				If IsArray(xVarArray(gnd_Site_SDSPM, a_Calc(i))) Then
					Call SDSPM_MajProduitsProgramme("", a_Calc(i) &amp; CStr(gc_SectionPaie), "", v_NbJoursInstall ,0, "", "")
				End If
			Case "Calc_KM" '
				If IsArray(xVarArray(gnd_Site_SDSPM, a_Calc(i))) Then
					Call SDSPM_MajProduitsProgramme("", a_Calc(i) &amp; CStr(gc_SectionPaie), "", 0 ,0, "", "")
				End If
			Case "Calc_MEAL"
				If IsArray(xVarArray(gnd_Site_SDSPM, a_Calc(i))) Then
					Call SDSPM_MajProduitsProgramme("", a_Calc(i) &amp; CStr(gc_SectionPaie), "", v_NbJoursInstall ,0, "", "")
				End If
			Case "Calc_TRAIN"
				If IsArray(xVarArray(gnd_Site_SDSPM, a_Calc(i))) Then
					Call SDSPM_MajProduitsProgramme("", a_Calc(i) &amp; CStr(gc_SectionPaie), "", v_NbJoursInstall ,0, "", "")
				End If
			Case "Calc_ROAD"
				If IsArray(xVarArray(gnd_Site_SDSPM, a_Calc(i))) Then
					Call SDSPM_MajProduitsProgramme("", a_Calc(i) &amp; CStr(gc_SectionPaie), "", ((xVar(gnd_Site_SDSPM, "Calc_AvionHeures", "") * 2) * v_NbInstallateurs) ,0, "", "")
				End If
			Case "Calc_WEB"
				If IsArray(xVarArray(gnd_Site_SDSPM, a_Calc(i))) Then
					Call SDSPM_MajProduitsProgramme("", a_Calc(i) &amp; CStr(gc_SectionPaie), "", Cint(xComplTabl("NBS" &amp; Cstr(gc_SectionPaie), "Form_ValDefaut", "1", True)) ,0, "", "")
				End If
				
			End Select
			
		Next
		
	End If
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_AucuneImprimante", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_NbPC", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_Qte("0", "Site_D0_NbPC", "")
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_NbEcrans", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_Qte("0", "Site_D0_NbEcrans", "")
	
	v_MajNbPaie = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_NbEmployesPaie", "")
	FPNav_SauvegarderDocument = v_MajNbPaie Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_Qte("0", "Site_D0_NbEmployesPaie", "")
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D6_Section", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_ON("", "Site_D6_Section", 0, "")
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_Location", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_ON("", "Site_D0_Location", 0, "")
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_NbVehicules", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_StatsOnline", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_ON("", "Site_D0_StatsOnline", 0, "")
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_MontageElectronique", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_ON("", "Site_D0_MontageElectronique", 0, "")
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_ModuleSDSDrive", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_ON("", "Site_D0_ModuleSDSDrive", 0, "")
	
	' Mettre à jour le site
		
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_CapaciteModuleSDSDrive", "") Or FPNav_SauvegarderDocument
	v_MajModuleMessagerieSDS = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D0_ModuleMessagerieSDS", "")
	FPNav_SauvegarderDocument = v_MajModuleMessagerieSDS Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_ON("", "Site_D0_ModuleMessagerieSDS", 0, "")
	
	If FPNav_SauvegarderDocument Then
		gnd_Site_SDSPM.HistoDM = Now
		gnd_Site_SDSPM.HistoUM = v_UserName
		Call gnd_Site_SDSPM.Save(True, False)
	End If
	
	If g_Site_D0_StatsOnline_FPNav = "0" And xVar(gnd_Site_SDSPM, "Site_D0_StatsOnline", "") = "1" Then
		v_MajProd_ON = True
	ElseIf g_Site_D0_MontageElectronique_FPNav = "0" And xVar(gnd_Site_SDSPM, "Site_D0_MontageElectronique", "") = "1" Then
		v_MajProd_ON = True
	ElseIf g_Site_D0_ModuleMessagerieSDS_FPNav = "0" And xVar(gnd_Site_SDSPM, "Site_D0_ModuleMessagerieSDS", "") = "1" Then
		v_MajProd_ON = True
	ElseIf g_Site_D0_Location_FPNav = "0" And xVar(gnd_Site_SDSPM, "Site_D0_Location", "") = "1" Then
		v_MajProd_ON = True
	ElseIf g_Site_D0_ModuleSDSDrive_FPNav = "0" And xVar(gnd_Site_SDSPM, "Site_D0_ModuleSDSDrive", "") = "1" Then
		v_MajProd_ON = True
	ElseIf g_Site_D6_Section_FPNav = "0" And xVar(gnd_Site_SDSPM, "Site_D6_Section", "") = "1" Then
		v_MajProd_ON = True
	End If
	
	If v_MajNbUtilisateurs Or v_MajNbPaie Or v_MajProd_ON Then
		If xVar(gnd_Prop_SDSPM, "Prop_Statut", "0") &lt; "50" Then
			' Recalculer escompte si nombre d'utilisateurs changé
			Call SDSPX_CalculerPrixEscompteLG(gnd_Prop_SDSPM, v_UserName)
		End If
		
		Call SDSPX_RecalculerNbUtilisateursLicense(gnd_Prop_SDSPM, gnd_Site_SDSPM)
	Elseif v_MajModuleMessagerieSDS Then
		Call SDSPX_RecalculerNbUtilisateursLicense(gnd_Prop_SDSPM, gnd_Site_SDSPM)
	End If
	
	
	' Mettre à jour la proposition
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DescProposition", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "PNav_MenuOptionMax", "") Or FPNav_SauvegarderDocument
	
	If FPNav_SauvegarderDocument Then
		gnd_Prop_SDSPM.HistoDM = Now
		gnd_Prop_SDSPM.HistoUM = v_UserName
		Call gnd_Prop_SDSPM.Save(True, False)
		
		g_Site_D0_StatsOnline_FPNav = xVar(gnd_Site_SDSPM, "Site_D0_StatsOnline", "")
		g_Site_D0_MontageElectronique_FPNav = xVar(gnd_Site_SDSPM, "Site_D0_MontageElectronique", "")
		g_Site_D0_ModuleMessagerieSDS_FPNav = xVar(gnd_Site_SDSPM, "Site_D0_ModuleMessagerieSDS", "")
		g_Site_D0_Location_FPNav = xVar(gnd_Site_SDSPM, "Site_D0_Location", "")
		g_Site_D0_ModuleSDSDrive_FPNav = xVar(gnd_Site_SDSPM, "Site_D0_ModuleSDSDrive", "")
		g_Site_D6_Section_FPNav = xVar(gnd_Site_SDSPM, "Site_D6_Section", "")
	End If
	
	FPNav_SauvegarderDocument = True
FinSub:
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function</lotusscript></code>
