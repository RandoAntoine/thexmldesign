</lotusscript></code><code event="SIPJ_OuvrirContact"><lotusscript>Sub SIPJ_OuvrirContact(p_NomDB As String, p_NoContact As String)
	'------------------------------------------------------------------------------------------------------------------------------	
	' permet d'ouvir le document contact de projeto
	'------------------------------------------------------------------------------------------------------------------------------	
	On Error GoTo GererErreur
	On Error 4060 GoTo ErreurAccess
	
	Dim nd_PJ As NotesDocument
	Dim nuiws As New NotesUIWorkspace
	
	Dim nd_Cont As NotesDocument
	
	'Initialisations
	Call SIPJ_Initialisations(p_NomDB)
	Call xPJ_Initialisations(p_NomDB)
	
	' Validation
	If Not SIPJ_PeutOuvrirClient(p_NomDB, gns_SIPJ.UserName) Then 
		Exit Sub
	End If
	
	If Not gndb_xPJ Is Nothing Then
		
		Set nd_Cont = xPJ_xndCont(p_NomDB, p_NoContact, True)
		
		If Not nd_Cont Is Nothing Then
			Call nuiws.Editdocument(False, nd_Cont, False)
			Exit Sub
		Else
			MessageBox xGDK_xMessage("SIPJ", 14, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		End If	
	End If
	
	Exit Sub
	
ErreurAccess:
	MessageBox xGDK_xMessage("SI", 183, "",  gndb_xPJ.Title), 16, xGDK_xMessage("SI", 1, "", "")
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, GetThreadInfo(1), "", False)	
	Exit Sub
End Sub


</lotusscript></code><code event="SIPJ_AjusterDateDebutSemaine"><lotusscript>Sub SIPJ_AjusterDateDebutSemaine(p_Date As Variant)
	'--------Req# 54796
	'Ajustement de la date de Laison
	
	On Error GoTo GererErreur
	
	Dim v_jourSemaine As Integer
	Dim v_Ajustement As Integer
	
	
	v_jourSemaine = Weekday (p_Date (0))
	
	
	If v_jourSemaine = gc_DebutSemaine Then
		v_Ajustement = 0
		
	ElseIf  v_jourSemaine &gt; gc_DebutSemaine Then
		
		v_Ajustement = gc_DebutSemaine - v_jourSemaine
	Else
		v_Ajustement = gc_DebutSemaine - v_jourSemaine - 7
	End If				
	
	
	Call SItD_AjusterDate(p_Date (0), CLng(v_Ajustement), "W")
	

	Exit Sub
	
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, GetThreadInfo(1), "", False)
	Exit Sub
	
	
End Sub

</lotusscript></code><code event="SIPJ_OuvirClient"><lotusscript>Sub SIPJ_OuvirClient(p_NomDB As String, p_ClientNoFmt As String)
	'------------------------------------------------------------------------------------------------------------------------------	
	' Permet d'ouvir le document Projeto du client
	'------------------------------------------------------------------------------------------------------------------------------	
	On Error Goto GererErreur
	On Error 4060 Goto ErreurAccess
	
	Dim nd_PJ As NotesDocument
	Dim nuiws As New NotesUIWorkspace
	
	Set nd_PJ = xPJ_xndClieSI(p_NomDB, p_ClientNoFmt, False)
	If nd_PJ Is Nothing Then
		Messagebox xGDK_xMessage("SI", 78, "", p_ClientNoFmt), 16, xGDK_xMessage("SI", 1, "", "")
	Else
		Call nuiws.EditDocument(False,nd_PJ)
	End If		
	
	Exit Sub
	
ErreurAccess:
	Messagebox xGDK_xMessage("SI", 183, "",  gndb_xPJ.Title), 16, xGDK_xMessage("SI", 1, "", "")
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, Getthreadinfo(1), "", False)	
	Exit Sub
End Sub

</lotusscript></code><code event="SIPJ_AssignerEtape"><lotusscript>Function SIPJ_AssignerEtape(p_NomDB As String, pnd_Proj As NotesDocument, p_Etape As String) As Boolean
	'================================================================================	
	'	Fonction qui gére tout les calculs et les modifications relatifs à l'étape sélectionnée
	'================================================================================	
	On Error Goto GererErreur	
	
	Dim v_EtapeNum As Integer
	Dim v_DescEtapeFR As String
	Dim v_DescEtapeEN As String
	Dim a_Evolution As Variant
	Dim a_EvolutionFR As Variant
	Dim a_EvolutionEN As Variant
	Dim ni As NotesItem
	Dim v_Ponderation As Double
	' Initialisations
	SIPJ_AssignerEtape = False
	
	' Initialisations
	If Not SIPJ_Initialisations(p_NomDB) Then
		Exit Function
	End If
	
	' Vérification de l'étape sélectionnée
	'--------------------------------------------------------
	If p_Etape &lt;&gt; xVar(pnd_Proj, "Proj_DerniereEtape", "") Then
		v_EtapeNum = Cint(p_Etape)
		v_DescEtapeFR = xPJ_xDescTabl(p_NomDB, p_Etape, "ÉtapesFR", True)
		v_DescEtapeEN = xPJ_xDescTabl(p_NomDB, p_Etape, "ÉtapesEN", True)
		
		'Changement d'étape
		pnd_Proj.Proj_Etape = p_Etape
		pnd_Proj.Proj_DerniereEtape = p_Etape
		pnd_Proj.Proj_DerniereEtapeFR = v_DescEtapeFR
		pnd_Proj.Proj_DerniereEtapeEN = v_DescEtapeEN
		pnd_Proj.Proj_Pourcent = v_EtapeNum
		
		'Évolution du projet
		a_Evolution = xVarArray(pnd_Proj, "Proj_Status_Choix")
		a_EvolutionFR = xVarArray(pnd_Proj, "Proj_Status_ChoixFR")
		a_EvolutionEN = xVarArray(pnd_Proj, "Proj_Status_ChoixEN")
		
		Call pnd_Proj.ReplaceItemValue("Proj_Status_Choix", p_Etape)
		Call pnd_Proj.ReplaceItemValue("Proj_Status_ChoixFR", v_DescEtapeFR)
		Call pnd_Proj.ReplaceItemValue("Proj_Status_ChoixEN", v_DescEtapeEN)
		If Isarray(a_Evolution) Then
			Set ni = pnd_Proj.GetFirstItem("Proj_Status_Choix")
			Call ni.AppendToTextList(a_Evolution)
			If Isarray(a_EvolutionFR) Then
				Set ni = pnd_Proj.GetFirstItem("Proj_Status_ChoixFR")
				Call ni.AppendToTextList(a_EvolutionFR)
			End If
			If Isarray(a_EvolutionEN) Then
				Set ni = pnd_Proj.GetFirstItem("Proj_Status_ChoixEN")
				Call ni.AppendToTextList(a_EvolutionEN)
			End If
		End If
		
		'Calcul des montants pondérés
		If v_EtapeNum &lt; 50 Then
			v_Ponderation = 0
		Elseif v_EtapeNum &lt; 75 Then
			v_Ponderation = .25
		Elseif v_EtapeNum &lt; 90 Then
			v_Ponderation = .5
		Elseif v_EtapeNum &lt; 100 Then
			v_Ponderation = .75
		Else
			v_Ponderation = 1
		End If
		
		pnd_Proj.Proj_TotalPond = xVar(pnd_Proj, "Proj_Total", 0) * v_Ponderation
		pnd_Proj.Proj_ProfitPond = xVar(pnd_Proj, "Proj_Montant_4", 0) * v_Ponderation
		
		SIPJ_AssignerEtape = True
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, Getthreadinfo(1), "", False)
	Exit Function	
End Function

</lotusscript></code><code event="SIPJ_ndcSelectionnerContact"><lotusscript>Function SIPJ_ndcSelectionnerContact(p_NomDB As String, p_NoClient As String) As NotesDocumentCollection
	%REM
------------------------------------------------------------------------------------------------------------------------------	
	Ouvrir le contact dans SI Contacts.
	Paramètres:	p_NomDB			String.  Le nom / alias de la base de documents Projeto.
				p_ClientNo	String.  La clé de client duquel il faut 
	sélectionner le(s) contact(s).
	Valeur retournée:	NotesdocumentCollection.  Les contact sélectionnés.
------------------------------------------------------------------------------------------------------------------------------	
	%ENDREM
	On Error GoTo GererErreur
	
	Dim ndc As NotesDocumentCollection
	Dim ndc_decideur As NotesDocumentCollection
	
	Set SIPJ_ndcSelectionnerContact = Nothing
	
	' Initialisations
	If Not SIPJ_Initialisations(p_NomDB) Then
		Exit Function
	End If
	
	If gnv_Cont11_SIPJ Is Nothing Then
		Set gnv_Cont11_SIPJ = gndb_xPJ.Getview("V_Cont11")
	End If
	Call gnv_Cont11_SIPJ.Refresh
	
	Set ndc = SISe_ndcPickList(gnv_Cont11_SIPJ, xGDK_xMessage("SI", 198, "", ""), p_NoClient)
	
	'------------------------------------------------
	
	Set SIPJ_ndcSelectionnerContact = ndc
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SIPJ_ndSelectionnerContactGroupe"><lotusscript>Function SIPJ_ndSelectionnerContactGroupe(p_NomDB As String, pnd_CliePJ As NotesDocument) As NotesDocument
	On Error GoTo GererErreur
	
	Dim nd As NotesDocument
	
	'Dim v_ClientNoFmt As String
	Dim v_NomGoupeClient As String
	
	
	' Initialisations
	If Not SIPJ_Initialisations(p_NomDB) Then
		Exit Function
	End If
	
	Call SISe_Initialisations
	
	If gnv_Cont14_SIPJ Is Nothing Then
		Set gnv_Cont14_SIPJ = gndb_xPJ.Getview("V_Cont14")
	End If
	Call gnv_Cont14_SIPJ.Refresh
	
	'v_ClientNoFmt = xVar(pnd_CliePJ, "Clie_NoClientFmt", "")
	v_NomGoupeClient = xVar(pnd_CliePJ, "Clie_NomGroupeClient", "")
	
	'If v_ClientNoFmt &lt;&gt; "" And v_NomGoupeClient &lt;&gt; "" Then	
	If v_NomGoupeClient &lt;&gt; "" Then		
		Set nd = SISe_ndPickList(gnv_Cont14_SIPJ, xGDK_xMessage("SI", 198, "", ""), v_NomGoupeClient)	
	End If
	
	Set SIPJ_ndSelectionnerContactGroupe = nd

	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SIPJ_ndSelectionnerContact_Onglets"><lotusscript>Function SIPJ_ndSelectionnerContact_Onglets(p_NomDB As String, p_NoClient As String, p_NomGroupeClient As String) As NotesDocument
	%REM
------------------------------------------------------------------------------------------------------------------------------	
	Ouvrir le contact dans SI Contacts.
	Paramètres:	p_NomDB			String.  Le nom / alias de la base de documents Projeto.
				p_NoClient	String.  La cle de client duquel il faut 
	sélectionner un contact.
	Valeur retournée:	Notesdocument.  Le contact sélectionné.
------------------------------------------------------------------------------------------------------------------------------	
	%ENDREM
	On Error GoTo GererErreur
	
	Dim nuiws As New Notesuiworkspace
	Dim nd As NotesDocument
	Dim nd_Box As NotesDocument
	
	Dim v_UNIDCont As String
	
	Set SIPJ_ndSelectionnerContact_Onglets = Nothing
	
	' Initialisations
	If Not SIPJ_Initialisations(p_NomDB) Then
		Exit Function 
	End If
	
	'EV refresh
	If gnv_Cont14_SIPJ Is Nothing Then
		Set gnv_Cont14_SIPJ = gndb_xPJ.Getview("V_Cont14")
	End If
	Call gnv_Cont14_SIPJ.Refresh
	
	If gnv_Cont11_SIPJ Is Nothing Then
		Set gnv_Cont11_SIPJ = gndb_xPJ.Getview("V_Cont11")
	End If
	Call gnv_Cont11_SIPJ.Refresh
	
	
	Set nd_Box = New NotesDocument(gndb_xPJ) 
	nd_Box.Form = "Temp"
	nd_Box.Clie_NoClientFmt = CStr(p_NoClient)	
	nd_Box.Clie_NomGroupeClient = p_NomGroupeClient	
	'nd_Box.DB_Origine = p_NomDB	
	
	
	' Sortir le DialogBox avec EVs selon p_NomDB'		
	
	If nuiws.DialogBox("DB_Cont" &amp; p_NomDB, True,True,False,False,True,False, xGDK_xMessage("SI", 198, "", ""), nd_Box,True,False,True) = False Then
		Exit Function
	End If
	
	v_UNIDCont = gns_SIPJ.GetEnvironmentString ("PJ_ContactUNID")
	
	'Print "v_UNIDCont " &amp; v_UNIDCont
	
	
	If v_UNIDCont &lt;&gt; "0" And v_UNIDCont &lt;&gt; "" Then		
		Set nd = gndb_xPJ.GetDocumentByID (v_UNIDCont )		
		Set SIPJ_ndSelectionnerContact_Onglets = nd
	End If
	
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code>
