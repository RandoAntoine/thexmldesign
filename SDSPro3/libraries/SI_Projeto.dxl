GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SIPJ_AjouterNote"><lotusscript>Function SIPJ_AjouterNote(p_NomDB As String, pnd_Parent As notesdocument, p_Type As String, p_Description As String, p_Date As Variant, _
	p_Utilisateur As String) As Boolean
	%REM
------------------------------------------------------------------------------------------------------------------------------	
Le script permet de créer une note dans la base de documents du document parent
	Paramètres:
		pnd_Parent	 NotesDocument.  Obligatoire. Le document parent. La note est créer dans la base de documents du document parent.                               
		p_Type			 String.  Le type de note (Interne ou Externe).  Initialisé à Interne si null.
		p_Description String.  Obligatoire. La description sommaire du note.
		p_Date			  Variant.  La date pour l'historique. Initialisé à Now si null.
		p_Utilisateur	  String.  Le ID du représantant pour l'historique. Initialisé à NotesSession.Username si null.
	------------------------------------------------------------------------------------------------------------------------------	
	%END REM
	On Error Goto GererErreur
	
	Dim nd_Note As NotesDocument	
	Dim v_Date As Variant
	
	' Validations
	SIPJ_AjouterNote = False
	If pnd_Parent Is Nothing Or p_Description = "" Then
		Exit Function
	End If
	
	' Initialisations		
	Call SIPJ_Initialisations(p_NomDB)
	
	' Créer le nouveau document
	Set nd_Note = New NotesDocument(pnd_Parent.ParentDatabase)
	nd_Note.Form = "F_Note"
	
	' Copier l'information du parent
	Call SIPJ_CreerLiaison(pnd_Parent, nd_Note)
	
	' Ajouter l'information spécifique	
	nd_Note.Note_Desc = p_Description 
	nd_Note.Description = p_Description 
	If Len(p_Type) = 0 Then
		nd_Note.Note_Type = "Interne"
	Else
		nd_Note.Note_Type = p_Type
	End If
	If Len(p_Date) = 0 Then
		nd_Note.HistoDC = Now
	Else
		nd_Note.HistoDC = p_Date
	End If
	If Len(p_Utilisateur) = 0 Then
		nd_Note.HistoUC =  gns_SIPJ.Username
	Else
		nd_Note.HistoUC = p_Utilisateur
	End If
	
	'	Call SIIx_AssignerDate(nd_Note, "Liai_Date", xVar(nd_Note, "HistoDC", nd_Note.Created))

	'--------Req# 54796
	
	v_Date =  Evaluate(|@If(!@IsNull(HistoDC); HistoDC; @Created)|, nd_Note)	
	Call SIPJ_AjusterDateDebutSemaine(v_Date)
	
	Call SIIx_AssignerDate(nd_Note, "Liai_Date", v_Date(0))
	
	
	' Sauvegarder le document
	Call nd_Note.MakeResponse(pnd_Parent)
	Call nd_Note.Save(True, False)
	
	SIPJ_AjouterNote = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SIPJ_ndcSelectionnerContactGroupe"><lotusscript>Function SIPJ_ndcSelectionnerContactGroupe(p_NomDB As String, pnd_CliePJ As NotesDocument) As NotesDocumentCollection
	On Error GoTo GererErreur
	
	Dim ndc As NotesDocumentCollection
	
	'Dim v_ClientNoFmt As String
	Dim v_NomGoupeClient As String
	
	
	' Initialisations
	If Not SIPJ_Initialisations(p_NomDB) Then
		Exit Function
	End If
	
	Call SISe_Initialisations
	
	If gnv_Cont14_SIPJ Is Nothing Then
		Set gnv_Cont14_SIPJ = gndb_xPJ.Getview("V_Cont14")
	End If
	Call gnv_Cont14_SIPJ.Refresh
	
	'v_ClientNoFmt = xVar(pnd_CliePJ, "Clie_NoClientFmt", "")
	v_NomGoupeClient = xVar(pnd_CliePJ, "Clie_NomGroupeClient", "")
	
	Set ndc = gndb_xPJ.CreateDocumentCollection()	
	
	'If v_ClientNoFmt &lt;&gt; "" And v_NomGoupeClient &lt;&gt; "" Then
	If v_NomGoupeClient &lt;&gt; "" Then
		Set ndc = SISe_ndcPickList(gnv_Cont14_SIPJ, xGDK_xMessage("SI", 198, "", ""), v_NomGoupeClient)		
	End If
	
	Set SIPJ_ndcSelectionnerContactGroupe = ndc

	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, GetThreadInfo(1), "", False)
	Exit Function
End Function

