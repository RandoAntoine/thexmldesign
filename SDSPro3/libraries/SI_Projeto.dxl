</lotusscript></code><code event="declarations"><lotusscript>' ----------------------------------
Dim gns_SIPJ As Notessession
Dim gndb_SIPJ As Notesdatabase
Dim g_NomDB_SIPJ As String

Dim gnv_Clie_SIPJ As NotesView
Dim gnv_Cont11_SIPJ As NotesView   'tous les contacts du clients
Dim gnv_Cont12_SIPJ As NotesView  'décideurs du client seulement
Dim gnv_Cont14_SIPJ As NotesView ' tous les contact duquel le client est membre d'un groupe

Dim ga_ItemsRecherche_SIPJ As Variant

Const gc_DebutSemaine = 2  'Lundi

' Traitement des erreurs
' -----------------------------------
Const gc_TypeElement_SIPJ = "SL"
Const gc_Element_SIPJ = "SI_Projeto"


</lotusscript></code><code event="SIPJ_Initialisations"><lotusscript>Function SIPJ_Initialisations(p_NomDB As String) As Boolean
	SIPJ_Initialisations = False
	
	If gns_SIPJ Is Nothing Or p_NomDB &lt;&gt; g_NomDB_SiPJ Then
		Set gns_SIPJ = New Notessession	
		Set gndb_SIPJ = gns_SIPJ.Currentdatabase
		
		' Extraire la base de documents Projeto
		' -------------------------------------------------------
		Call xPJ_Initialisations(p_NomDB)
		If gndb_xPJ Is Nothing Then			
			' 48 - La base de documents &amp; est introuvable.
			Messagebox xGDK_xMessage("SI", 48, "", p_NomDB), 16, xGDK_xMessage("SI", 1, "", "")			
			Exit Function
		Elseif Not gndb_xPJ.IsOpen Then
			' 48 - La base de documents &amp; est introuvable.
			Messagebox xGDK_xMessage("SI", 48, "", p_NomDB), 16, xGDK_xMessage("SI", 1, "", "")
			Exit Function
		End If
		
		g_NomDB_SIPJ = p_NomDB
	End If	
	
	' Initialisation du tableau des items du client
	ga_ItemsRecherche_SIPJ = Evaluate({"Clie_Nom" : "Clie_Division"})
	
	SIPJ_Initialisations = True
End Function

</lotusscript></code><code event="SIPJ_PeutOuvrirClient"><lotusscript>Function SIPJ_PeutOuvrirClient(p_NomDB As String, p_NomUtilisateur As String) As Boolean
	'----------------------------------------------------------------------------------
	' Le script permet de valider si l'utilisateur peut ouvrir le client
	'----------------------------------------------------------------------------------
	On Error GoTo GererErreur
	On Error 4060 GoTo ErreurAccess
	
	Dim v_PJRoles As Variant
	Dim v_PJAcces As Integer
	
	'Initialisations
	Call xPJ_Initialisations(p_NomDB)	
	SIPJ_PeutOuvrirClient = True

	'Vérifie si peut ouvir le client
	v_PJRoles = gndb_xPJ.QueryAccessRoles(p_NomUtilisateur)	
	v_PJAcces = gndb_xPJ.QueryAccess(p_NomUtilisateur)	
	
	If IsArray(v_PJRoles) Then
		ForAll role In v_PJRoles 
			If role = "[SRS]" Then
				If  v_PJAcces &lt; 3 Then 'Auteur
					MessageBox xGDK_xMessage("SI", 183, "", p_NomDB), 16, xGDK_xMessage("SI", 1, "", "")
					' 183: Vous n'avez pas access à la base de documents &amp;
					SIPJ_PeutOuvrirClient = False
					Exit Function
				End If	
			End If
		End ForAll
	End If
	
	Exit Function
	
ErreurAccess:
	MessageBox xGDK_xMessage("SI", 183, "",  gndb_xPJ.Title), 16, xGDK_xMessage("SI", 1, "", "")
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, GetThreadInfo(1), "", False)	
	Exit Function
End Function


</lotusscript></code><code event="SIPJ_NomDB"><lotusscript>Function SIPJ_NomDB(p_Departement As String) As String
	On Error GoTo GererErreur
	
	Select Case p_Departement
		Case "60"
			SIPJ_NomDB = "PJSDS"
		Case "62"
			SIPJ_NomDB = "PJUSA"   
		Case Else
			SIPJ_NomDB = "PJDIV"
	End Select
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, GetThreadInfo(1), p_Departement, False)
	Exit Function
End Function

</lotusscript></code><code event="SIPJ_ndSelectionnerClient"><lotusscript>Function SIPJ_ndSelectionnerClient(p_NomDB As String, p_Titre As String, p_RechApprox As Boolean) As Notesdocument
	'------------------------------------------------------------------------------------------------------------------------------	
	' Le script permet de sélectionner un client.
	'------------------------------------------------------------------------------------------------------------------------------	
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	
	Set SIPJ_ndSelectionnerClient = Nothing
	
	' Initialisations
	If Not SIPJ_Initialisations(p_NomDB) Then
		Exit Function
	End If
	
	If gnv_Clie_SIPJ Is Nothing Then
		Set gnv_Clie_SIPJ = gndb_xPJ.Getview("V_Clie10")
	End If
	
	' Sélectionner un client
	' -------------------------------
	Set nd = SISe_ndSelectionnerDocument("", ga_ItemsRecherche_SIPJ, SISe_PROMPT, gnv_Clie_SIPJ, _
	|Clie_Nom + @If(@IsNull(Clie_Division); ""; " " + Clie_Division) + @If(@IsNull(Clie_ClientNomInterne); ""; " (" + Clie_ClientNomInterne + ")") + @If(Clie_Inactif = "1";| &amp; |+" - | &amp; xGDK_xMessage("SI", 214, "", "") &amp;  |"| &amp; |; "")| , _
	p_Titre, "", p_RechApprox)
	
	If xVar(nd, "Clie_Inactif", "") = "1" Then
		Messagebox xGDK_xMessage("SI", 210, "", xVar(nd, "Clie_Nom" ,"")), 16, xGDK_xMessage("SI", 1, "", "")
		Exit Function
	End If
	
	Set SIPJ_ndSelectionnerClient = nd
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SiPJ, gc_Element_SIPJ, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SIPJ_ndSelectionnerTousContacts"><lotusscript>Function SIPJ_ndSelectionnerTousContacts(p_NomDB As String) As NotesDocument
	'------------------------------------------------------------------------------------------------------------------------------	
	' Permet de sélectionner un document contact de Projeto
	'	Le nom du contact est saisi dans une boîte de dialogue
	'------------------------------------------------------------------------------------------------------------------------------	
	On Error GoTo GererErreur
	
	Dim nd_Contacts As NotesDocument
	Dim ndc_Cont As NotesDocumentCollection
	Dim nuiws As New NotesUIWorkspace
	Dim nv_Contacts As NotesView
	Dim a_ItemsRecherche As Variant
	
	'Initialisations
	Call SIPJ_Initialisations(p_NomDB)
	Call xPJ_Initialisations(p_NomDB)
	
	Set nv_Contacts =  gndb_xPJ.GetView("V_Cont21") ' Vue des contacts actifs
	
	Set SIPJ_ndSelectionnerTousContacts = Nothing
	
	'Vérifie si l'utilisateur peut ouvir le client
	If Not  SIPJ_PeutOuvrirClient(p_NomDB, gns_SIPJ.UserName)	Then
		Exit Function
	End If
	
	a_ItemsRecherche = Evaluate({"Cont_Contact"})	
	
	Set nd_Contacts = SISe_ndSelectionnerDocument("", a_ItemsRecherche,SISe_PROMPT, _
	nv_Contacts, |@If(@IsNull(Cont_Prenom); Cont_Nom ; Cont_Prenom + " " + Cont_Nom) + 
	 "  /  " + Clie_Nom + @if(@isnull(Clie_Division); ""; " - " + Clie_Division)|, xGDK_xMessage("SI", 86, "", ""),"", False)
	' 86: Sélectionnez un contact dans la liste ci-dessous.
	
	' Si pas de contact choisi, annuler le sélection
	If Not nd_Contacts Is Nothing Then
		Set  SIPJ_ndSelectionnerTousContacts = nd_Contacts
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, GetThreadInfo(1), "", False)	
	Exit Function
End Function


</lotusscript></code><code event="SIPJ_CreerLiaison"><lotusscript>Sub SIPJ_CreerLiaison(pnd_Parent As notesdocument, pnd_Note As notesdocument)
	On Error Goto GererErreur
	
	Dim ni As NotesItem
	pnd_Note.Clie_NoClient = xVar(pnd_Parent, "Clie_NoClient", "")
	pnd_Note.Cont_NoContact = xVar(pnd_Parent, "Cont_NoContact", "")
	pnd_Note.Proj_NoProjet = xVar(pnd_Parent, "Proj_NoProjet", "")
	pnd_Note.Requ_NoRequ = xVar(pnd_Parent, "Requ_NoRequ", "")
	pnd_Note.CleClient = xVar(pnd_Parent, "CleClient", "")
	pnd_Note.CleContact = xVar(pnd_Parent, "CleContact", "")
	pnd_Note.CleProjet = xVar(pnd_Parent, "CleProjet", "")
	pnd_Note.CleRequisition = xVar(pnd_Parent, "CleRequisition", "")
	
	pnd_Note.Clie_Nom = xVar(pnd_Parent, "Clie_Nom", "")
	pnd_Note.Clie_Division = xVar(pnd_Parent, "Clie_Division", "")
	pnd_Note.Cont_Contact = xVar(pnd_Parent, "Cont_Contact ", "")
	pnd_Note.Proj_Somm = xVar(pnd_Parent, "Proj_Somm", "")
	pnd_Note.Requ_NoRequisition = xVar(pnd_Parent, "Requ_NoRequisition", "")
	pnd_Note.Requ_Description = xVar(pnd_Parent, "Requ_Description", "")
	
	
	
	Set ni = New NotesItem(pnd_Note, "Lecteurs", xVarArray(pnd_Parent, "Lecteurs"), READERS)
	Set ni = New NotesItem(pnd_Note, "Auteurs", xVarArray(pnd_Parent, "Auteurs"), AUTHORS)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, Getthreadinfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="SIPJ_ndSelectionnerContact"><lotusscript>Function SIPJ_ndSelectionnerContact(p_NomDB As String, p_NoClient As String) As NotesDocument
	%REM
	Remplacée par SIPJ_ndSelectionnerContact_Onglets Req#55273
------------------------------------------------------------------------------------------------------------------------------	
	Ouvrir le contact dans SI Contacts.
	Paramètres:	p_NomDB			String.  Le nom / alias de la base de documents Projeto.
				p_NoClient	String.  La cle de client duquel il faut 
	sélectionner un contact.
	Valeur retournée:	Notesdocument.  Le contact sélectionné.
------------------------------------------------------------------------------------------------------------------------------	
	%ENDREM
	On Error GoTo GererErreur
	
	Dim nd As NotesDocument
	Dim ndc_decideur As NotesDocumentCollection
	
	Set SIPJ_ndSelectionnerContact = Nothing
	
	' Initialisations
	If Not SIPJ_Initialisations(p_NomDB) Then
		Exit Function
	End If
	
	
	'---- Req: 39088 (mise a jour)
	'-----afficher tous les contacts (et les decideurs) ---- 
	
	If gnv_Cont11_SIPJ Is Nothing Then
		Set gnv_Cont11_SIPJ = gndb_xPJ.Getview("V_Cont11")
	End If
	Call gnv_Cont11_SIPJ.Refresh
	
	Set nd = SISe_ndPickList(gnv_Cont11_SIPJ, xGDK_xMessage("SI", 198, "", ""), p_NoClient)
	
	'------------------------------------------------
	
	Set SIPJ_ndSelectionnerContact = nd
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SIPJ, gc_Element_SIPJ, GetThreadInfo(1), "", False)
	Exit Function
End Function



</lotusscript></code><code event="SIPJ_ndSelectionnerTous"><lotusscript>Function SIPJ_ndSelectionnerTous(p_NomDB As String, p_Titre As String, p_RechApprox As Boolean) As NotesDocument
	'------------------------------------------------------------------------------------------------------------------------------	
	' Le script permet de sélectionner un client ou prospect.
	'------------------------------------------------------------------------------------------------------------------------------	
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
