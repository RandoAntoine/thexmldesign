</lotusscript></code><code event="xSICf_xVarProf"><lotusscript>Function xSICf_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xSICf_Initialisation
	
	' Extraire le document de profil
	If gnd_Prof_SICf Is Nothing Then
		Set gnd_Prof_SICf = gndb_xSICf.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_SICf Is Nothing Then
		xSICf_xVarProf = p_ValeurNulle
	Else
		xSICf_xVarProf = xVar(gnd_Prof_SICf, p_NomVar, p_ValeurNulle)		
	End If
End Function

