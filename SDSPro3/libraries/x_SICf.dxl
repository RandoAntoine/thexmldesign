</lotusscript></code><code event="xSICf_xndEqui_NoSerie"><lotusscript>Function xSICf_xndEqui_NoSerie(Byval p_Cle As Variant, Byval p_NoCategorie As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	Dim ndc As NotesDocumentCollection
	Dim nd As NotesDocument
	
	Set xSICf_xndEqui_NoSerie = Nothing
	If p_Cle = "" Then
		Exit Function
	End If
	
	' Initialisation des variables globales
	Call xSICf_Initialisation
	If gnv_Equi25_xSICf Is Nothing Then
		Set gnv_Equi25_xSICf = gndb_xSICf.GetView("V_Equi25")
		Call gnv_Equi25_xSICf.Refresh
	End If
	
	Set ndc = gnv_Equi25_xSICf.GetAllDocumentsByKey(p_Cle, True)
	Set nd = ndc.GetFirstDocument
	Do Until nd Is Nothing
		If p_NoCategorie = 0 Or xVar(nd, "Equi_NoCategorie", 0) = p_NoCategorie Then
			Set xSICf_xndEqui_NoSerie = nd
			Exit Function
		End If
		
		Set nd = ndc.GetNextDocument(nd)
	Loop
End Function

