</lotusscript></code><code event="xSICf_xValeurExisteTabl"><lotusscript>Function xSICf_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xSICf_xValeurExisteTabl = False
	
	If Not (xSICf_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gndTabl_xSICf.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xSICf_xValeurExisteTabl = True
		End If
	End If	
End Function

