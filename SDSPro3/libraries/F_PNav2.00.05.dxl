<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>
' Site \ Formation
Option Public
Option Declare
Use "wsc_SDSP3"
Use "SDSP_MasquePNav"
Use "SDSP_Navigation"
Use "SI_Google"

</lotusscript></code><code event="declarations"><lotusscript>' Déclarations globales
' ---------------------
Dim gni_SectionsValides_FPNav As NotesItem
Const gc_NbSections_FPNav = 9
Const gc_SectionPaie = 6
Dim g_SectionCourante_FPNav As String

' Entering/Exiting
Dim g_NomItem_FPNav As String
Dim g_ValeurItem_FPNav As String

' 0 - Paramètres
Dim g_ParametresFormation_FPNav As Boolean
Dim g_TauxHoraireDep_FPNav As Double
Dim g_VoitureDistance_FPNav As Double
Dim g_VoitureHeures_FPNav As Double
Dim g_VoitureTauxKm_FPNav As Double
Dim g_AvionCout_FPNav As Double
Dim g_AvionHeures_FPNav As Double
Dim g_VoitureLocation_FPNav As Double
Dim g_HotelCout_FPNav As Double
Dim g_RepasCout_FPNav As Double
Dim g_StationnementCout_FPNav As Double

Dim ga_CAR_FPNav(1 To gc_NbSections_FPNav) As Double
Dim ga_HOTEL_FPNav(1 To gc_NbSections_FPNav) As Double
Dim ga_KM_FPNav(1 To gc_NbSections_FPNav) As Double
Dim ga_MEAL_FPNav(1 To gc_NbSections_FPNav) As Double
Dim ga_PLANE_FPNav(1 To gc_NbSections_FPNav) As Double
Dim ga_ROAD_FPNav(1 To gc_NbSections_FPNav) As Double
Dim ga_TRAIN_FPNav(1 To gc_NbSections_FPNav) As Double
Dim ga_WEB_FPNav(1 To gc_NbSections_FPNav) As Double
Dim ga_PARK_FPNav(1 To gc_NbSections_FPNav) As Double

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_FPNav = "SL"
Const gc_Element_FPNav = "F_PNav2.00.05"


</lotusscript></code><code event="FPNav_Entering"><lotusscript>Sub FPNav_Entering
	On Error Goto GererErreur
	
	Dim nuiws As NotesUIWorkspace
	
	If gnuid_SDSPN Is Nothing Then
		Set nuiws = New Notesuiworkspace
		Set gnuid_SDSPN = nuiws.CurrentDocument
		Call gnuid_SDSPN.Refresh
	End If
	
	g_NomItem_FPNav = gnuid_SDSPN.CurrentField
	g_ValeurItem_FPNav = xVarImplode(gnuid_SDSPN.Document, g_NomItem_FPNav, "")
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsSurSite"><lotusscript>Sub FPNav_hsSurSite
	On Error Goto GererErreur
	
	If xVar(gnd_SDSPM, "Calc_SurPlace", "") = "1" Then
		Call gnd_SDSPM.ReplaceItemValue("Calc_SurPlace", "")
	Else
		Call gnd_SDSPM.ReplaceItemValue("Calc_SurPlace", "1")
	End If
	Call gnd_SDSPM.ReplaceItemValue("Calc_Selection", "")
	
	
	If xVar(gnd_SDSPM, "PNav_EditMode", "") = 1 Then
		
	' Sauvegarder les valeurs de la section courante
		Call FPNav_SauvegarderSectionUI
		
		If FPNav_SectionValide(gnd_SDSPM, g_SectionCourante_FPNav, False) Then
			If gni_SectionsValides_FPNav.Values(0) = "" Then
				gni_SectionsValides_FPNav.Values = g_SectionCourante_FPNav
			Elseif Not gni_SectionsValides_FPNav.Contains(g_SectionCourante_FPNav) Then
				Call gni_SectionsValides_FPNav.AppendToTextList(g_SectionCourante_FPNav)
			End If
		Else
			If gni_SectionsValides_FPNav.Contains(g_SectionCourante_FPNav) Then
				gni_SectionsValides_FPNav.Values = RetirerArray(gni_SectionsValides_FPNav.Values, g_SectionCourante_FPNav)
			End If
		End If
		
	End If
	
	Call gnuid_SDSPN.Refresh
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
	
End Sub

</lotusscript></code><code event="FPNav_DocumentValide"><lotusscript>Function FPNav_DocumentValide(p_AfficherErreur As Boolean) As Boolean
	On Error Goto GererErreur
	
	Dim v_AfficherErreur As Boolean
	Dim v_SectionCouranteErreur As Boolean
	Dim v_Erreur As Boolean
	Dim v_SectionErreur As String
	Dim i As Integer
	
	FPNav_DocumentValide = False
	v_AfficherErreur = p_AfficherErreur
	
	If xVar(gnd_SDSPM, "Prop_DescProposition", "") = "" Then
		If p_AfficherErreur Then
			MessageBox xGDK_xMessage("SI", 23, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
			Call gnuid_SDSPN.GotoField("Prop_DescProposition")
		End If
		Exit Function
	End If
	
	' Valider les paramètres de formation
	If Not g_ParametresFormation_FPNav Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SDSPP", 30, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (2)"
		End If
		Exit Function
	End If
	
	' Valider la section courante
	FPNav_DocumentValide = True
	v_SectionCouranteErreur = Not FPNav_SectionValide(gnd_SDSPM, g_SectionCourante_FPNav, v_AfficherErreur)
	If v_SectionCouranteErreur Then
		v_SectionErreur = g_SectionCourante_FPNav
		v_AfficherErreur = False
	End If
	
	' Sections
	gni_SectionsValides_FPNav.Values = ""
	For i = 1 To gc_NbSections_FPNav
		If i = Cint(g_SectionCourante_FPNav) Then
			v_Erreur = v_SectionCouranteErreur
		Else
			v_Erreur = Not FPNav_SectionValide(gnd_SDSPM, Cstr(i), v_AfficherErreur)
		End If
		
		If v_Erreur Then
			If v_SectionErreur = "" Then
				v_SectionErreur = Cstr(i)
				v_AfficherErreur = False
			End If
			FPNav_DocumentValide = False
		Else
			Call gni_SectionsValides_FPNav.Appendtotextlist(Cstr(i))
		End If
	Next
	
	Print v_SectionErreur
	If FPNav_DocumentValide = False And p_AfficherErreur And v_SectionErreur &lt;&gt; g_SectionCourante_FPNav Then
		g_SectionCourante_FPNav = v_SectionErreur
		Call gnd_SDSPM.ReplaceItemValue("PNav_OngletCourant2.00.05", v_SectionErreur)
		Call FPNav_InitialiserSectionUI(gnd_SDSPM)
		Call gnuid_SDSPN.Refresh
	End If
	
	Exit Function
	
GererErreur:
	FPNav_DocumentValide = False
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acImage"><lotusscript>Sub FPNav_acImage
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument("") Then
		Exit Sub
	End If
	
	Call SDSPM_acImage(gnd_Prop_SDSPM)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_hsAnnuler"><lotusscript>Sub FPNav_hsAnnuler
	On Error Goto GererErreur
	
	gnd_SDSPM.SaveOptions = "0"
	Call gnuid_SDSPN.Close
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_QuerySave"><lotusscript>Sub FPNav_QuerySave(pnuid_Source As Notesuidocument, p_Continue As Variant)
	On Error Goto GererErreur
	
	' Sauvegarder l'étape courante
	p_Continue = FPNav_SauvegarderDocument("")
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acGenererCommande"><lotusscript>Sub FPNav_acGenererCommande
	On Error GoTo GererErreur
	
	Call SDSPUI_acGenererCommande(gnd_Prop_SDSPM)
	
	Call gnuid_SDSPM.Refreshhideformulas
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsOuvrirSection"><lotusscript>Sub FPNav_hsOuvrirSection(p_Section As String)
	On Error Goto GererErreur
	
	' Valider les paramètres de formation
	If Not g_ParametresFormation_FPNav Then
		Messagebox xGDK_xMessage("SDSPP", 30, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
		Exit Sub
	End If
	
	' Calculer les champs automatiques
	On Error 4412 Goto FinSub
	Call gnuid_SDSPN.Refresh
	On Error 4412 Goto GererErreur
	
	' Valider la section courante
	If xVar(gnd_SDSPM, "PNav_EditMode", "") = 1 Then
		
	' Sauvegarder les valeurs de la section courante
		Call FPNav_SauvegarderSectionUI
		
		If FPNav_SectionValide(gnd_SDSPM, g_SectionCourante_FPNav, False) Then
			If gni_SectionsValides_FPNav.Values(0) = "" Then
				gni_SectionsValides_FPNav.Values = g_SectionCourante_FPNav
			Elseif Not gni_SectionsValides_FPNav.Contains(g_SectionCourante_FPNav) Then
				Call gni_SectionsValides_FPNav.AppendToTextList(g_SectionCourante_FPNav)
			End If
		Else
			If gni_SectionsValides_FPNav.Contains(g_SectionCourante_FPNav) Then
				gni_SectionsValides_FPNav.Values = RetirerArray(gni_SectionsValides_FPNav.Values, g_SectionCourante_FPNav)
			End If
		End If
	End If
	
	
	' Charger les valeurs de la nouvelle section
	g_SectionCourante_FPNav = p_Section
	Call gnd_SDSPM.ReplaceItemValue("PNav_OngletCourant2.00.05", p_Section)
	Call FPNav_InitialiserSectionUI(gnd_SDSPM)
	Call gnuid_SDSPN.Refresh
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_SectionValide"><lotusscript>Function FPNav_SectionValide(pnd_PNav As NotesDocument, p_Section As String, p_AfficherErreur As Boolean) As Boolean
	On Error Goto GererErreur
	
	FPNav_SectionValide = False
	
	Call FPNav_RecalculerSection(pnd_PNav, p_Section, True)
	
	If xVar(pnd_PNav, "Calc_NbInstallateurs" &amp; p_Section, "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (0)"
			Call gnuid_SDSPN.GotoField("Calc_NbInstallateurs" &amp; p_Section)
		End If
		Exit Function
	End If
	
	If p_Section = Cstr(gc_SectionPaie) And xVar(gnd_Site_SDSPM,"Site_D6_Section", "") &lt;&gt; "1" Then
		FPNav_SectionValide = True
		Exit Function
	End If
	
	If xVar(pnd_PNav, "Calc_NbInstallateurs" &amp; p_Section, "") &gt; "0" Then
		If xVar(pnd_PNav, "Calc_NbJours" &amp; p_Section, "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
				Call gnuid_SDSPN.GotoField("Calc_NbInstallateurs" &amp; p_Section)
			End If
			Exit Function
		End If
		If xVar(pnd_PNav, "Calc_NbVoitures" &amp; p_Section, "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (2)"
				Call gnuid_SDSPN.GotoField("Calc_NbVoitures" &amp; p_Section)
			End If
			Exit Function
		End If
		If xVar(pnd_PNav, "Calc_Selection" &amp; p_Section, "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (3)"
				Call gnuid_SDSPN.GotoField("Calc_Selection" &amp; p_Section)
			End If
			Exit Function
		End If
	End If
	
	If xVar(pnd_PNav, "Calc_NbSessions" &amp; p_Section, "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (4)"
			Call gnuid_SDSPN.GotoField("Calc_NbSessions" &amp; p_Section)
		End If
		Exit Function
	End If
	
	If p_Section = "6" And xVar(gnd_Site_SDSPM,"Site_D6_Section", "") = "1" Then
		If xVar(pnd_PNav, "Calc_NbJoursPaie" &amp; p_Section, "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (5)"
				Call gnuid_SDSPN.GotoField("Calc_NbJoursPaie" &amp; p_Section)
			End If
			Exit Function
		End If
	End If
	
	FPNav_SectionValide = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_hsSuivant"><lotusscript>Sub FPNav_hsSuivant
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If FPNav_SauvegarderDocument(True) Then
		' Ouvrir le masque suivant
		Call SDSPN_OuvrirMasqueSuivant
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub



</lotusscript></code><code event="FPNav_SauvegarderSection"><lotusscript>Function FPNav_SauvegarderSection(p_Section As String) As Boolean
	On Error Goto GererErreur
	
	' Mettre à jour le site
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_NbInstallateurs" &amp; p_Section, "")
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_NbJoursPaie" &amp; p_Section, "") Or FPNav_SauvegarderSection
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_NbJours" &amp; p_Section, "") Or FPNav_SauvegarderSection
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_NbVoitures" &amp; p_Section, "") Or FPNav_SauvegarderSection
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_SurPlace" &amp; p_Section, "") Or FPNav_SauvegarderSection
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_Selection" &amp; p_Section, "") Or FPNav_SauvegarderSection
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_NbSessions" &amp; p_Section, "") Or FPNav_SauvegarderSection
	
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_CARExtra" &amp; p_Section, "") Or FPNav_SauvegarderSection
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_HOTELExtra" &amp; p_Section, "") Or FPNav_SauvegarderSection
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_MEALExtra" &amp; p_Section, "") Or FPNav_SauvegarderSection
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_ROADExtra" &amp; p_Section, "") Or FPNav_SauvegarderSection
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_KMExtra" &amp; p_Section, "") Or FPNav_SauvegarderSection
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_PARKExtra" &amp; p_Section, "") Or FPNav_SauvegarderSection
	
	
	FPNav_SauvegarderSection = SDSPM_MajItem(gnd_Site_SDSPM, "Calc_Notes" &amp; p_Section, "") Or FPNav_SauvegarderSection	
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acImprimerPropositionSommaire"><lotusscript>Sub FPNav_acImprimerPropositionSommaire
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument(True) Then
		Exit Sub
	End If
	
	Call SDSPM_acImprimerPropositionSommaire
	
	Exit Sub
	
GererErreur:
