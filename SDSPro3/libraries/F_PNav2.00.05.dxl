</lotusscript></code><code event="FPNav_QueryOpen"><lotusscript>Sub FPNav_QueryOpen(pnuid_Source As Notesuidocument, p_Mode As Integer, p_Isnewdoc As Variant, _
p_Continue As Variant)
	On Error Goto GererErreur
	
	Dim nd_PNav As NotesDocument
	
	' Initialisations
	p_Continue = False
	If p_Mode &lt;&gt; 1 Then
		Exit Sub
	End If
	
	Set nd_PNav = pnuid_Source.Document
	
	' Initialiser les champs du document de navigation
	If FPNav_DocumentExistant(nd_PNav) Then
		p_Continue = True
	End If
	
	' Effacer les champs RT des autres écrans
	If nd_PNav.Hasitem("Prop_DescDetaillee") Then
		Call nd_PNav.Removeitem("Prop_DescDetaillee")
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentExistant"><lotusscript>Function FPNav_DocumentExistant(pnd_PNav As NotesDocument) As Boolean
	On Error Goto GererErreur
	
	Dim i As Integer
	
	FPNav_DocumentExistant = False
	
	' Extraire la proposition
	If Not SDSPM_InitProp(xVar(pnd_PNav, "Prop_NoProposition", "")) Then
		Exit Function
	End If
	
	' Extraire le site
	If Not SDSPM_InitSite(pnd_PNav) Then
		Exit Function
	End If
		
	pnd_PNav.Prop_Statut = xVar(gnd_Prop_SDSPM, "Prop_Statut", "10")
	Call pnd_PNav.ReplaceItemValue("Prop_StatutDesc" &amp; xLangue, _
	xVar(gnd_Prop_SDSPM, "Prop_StatutDesc" &amp; xLangue, ""))
	
	' Mettre à jour l'entête du site
	pnd_PNav.Site_ClientNomInterne = xVar(gnd_Site_SDSPM, "Site_ClientNomInterne", "")
	pnd_PNav.Site_Banniere = xVar(gnd_Site_SDSPM, "Site_Banniere", "")
	pnd_PNav.Site_BanniereDesc = xVar(gnd_Site_SDSPM, "Site_BanniereDesc", "")
	pnd_PNav.Site_ClientLatitude = xVar(gnd_Site_SDSPM, "Site_ClientLatitude", 0)
	pnd_PNav.Site_ClientLongitude = xVar(gnd_Site_SDSPM, "Site_ClientLongitude", 0)
	
	' Mettre à jour l'information requise
	pnd_PNav.Site_D0_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D0_NbUtilisateurs", 0)
	pnd_PNav.Site_D6_Section = xVar(gnd_Site_SDSPM, "Site_D6_Section", "")
	pnd_PNav.Site_D0_NbEmployesPaie = xVar(gnd_Site_SDSPM, "Site_D0_NbEmployesPaie", 0)
	pnd_PNav.Site_D1_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D1_NbUtilisateurs", 0)
	pnd_PNav.Site_D2_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D2_NbUtilisateurs", 0)
	pnd_PNav.Site_D3_NbTechniciens = xVar(gnd_Site_SDSPM, "Site_D3_NbTechniciens", 0)
	pnd_PNav.Site_D4_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D4_NbUtilisateurs", 0)
	pnd_PNav.Site_D4_NbTechniciens = xVar(gnd_Site_SDSPM, "Site_D4_NbTechniciens", 0)
	pnd_PNav.Site_D5_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D5_NbUtilisateurs", 0)
	
	' Mettre à jour le document de navigation
	' 0 - Paramètres
	Call FPNav_InitialiserParametre(pnd_PNav, "Calc_TauxHoraireDep", g_TauxHoraireDep_FPNav)
	Call FPNav_InitialiserParametre(pnd_PNav, "Calc_VoitureDistance", g_VoitureDistance_FPNav)
	Call FPNav_InitialiserParametre(pnd_PNav, "Calc_VoitureHeures", g_VoitureHeures_FPNav)
	Call FPNav_InitialiserParametre(pnd_PNav, "Calc_VoitureTauxKm", g_VoitureTauxKm_FPNav)
	Call FPNav_InitialiserParametre(pnd_PNav, "Calc_AvionCout", g_AvionCout_FPNav)
	Call FPNav_InitialiserParametre(pnd_PNav, "Calc_AvionHeures", g_AvionHeures_FPNav)
	Call FPNav_InitialiserParametre(pnd_PNav, "Calc_VoitureLocation", g_VoitureLocation_FPNav)
	Call FPNav_InitialiserParametre(pnd_PNav, "Calc_HotelCout", g_HotelCout_FPNav)
	Call FPNav_InitialiserParametre(pnd_PNav, "Calc_RepasCout", g_RepasCout_FPNav)
	Call FPNav_InitialiserParametre(pnd_PNav, "Calc_StationnementCout", g_StationnementCout_FPNav)
	g_ParametresFormation_FPNav = g_VoitureDistance_FPNav &gt; 0 And g_VoitureHeures_FPNav &gt; 0 And _
	g_AvionCout_FPNav &gt; 0 And g_AvionHeures_FPNav &gt; 0 And g_VoitureLocation_FPNav &gt; 0 And _
	g_HotelCout_FPNav &gt; 0 And g_RepasCout_FPNav &gt; 0 And g_StationnementCout_FPNav &gt; 0
	
	' Sections 1 à 9
	pnd_PNav.Calc_SectionsValides = ""
	Set gni_SectionsValides_FPNav = pnd_PNav.GetFirstItem("Calc_SectionsValides")
	For i = 1 To gc_NbSections_FPNav
		Call FPNav_InitialiserSection(pnd_PNav, Cstr(i), i = gc_NbSections_FPNav)
		If FPNav_SectionValide(pnd_PNav, Cstr(i), False) Then
			Call gni_SectionsValides_FPNav.Appendtotextlist(Cstr(i))
		End If
	Next
	
	' Toujours ouvir la première section
	Call pnd_PNav.ReplaceItemValue("PNav_OngletCourant2.00.05", "1")
	g_SectionCourante_FPNav = xVar(pnd_PNav, "PNav_OngletCourant2.00.05", "1")
	
	Call FPNav_InitialiserSectionUI(pnd_PNav)
	
	' Valeur défaut
	
	' Paie
	If xVar(pnd_PNav, "Calc_NbSessions" &amp; Cstr(gc_SectionPaie), "") = "" And xVar(pnd_PNav, "Site_D6_Section", "") = "1" Then
		' Initialise valeurs défaut à zéro si client existant , Conversion serveur hébergé ou Changement propriétaire
		If xVar(gnd_Prop_SDSPM, "Prop_TypeProposition", "") &gt;= "2" Then	
			Call pnd_PNav.ReplaceItemValue("Calc_NbSessions" &amp; Cstr(gc_SectionPaie), 0)
		Else
			Call pnd_PNav.ReplaceItemValue("Calc_NbSessions" &amp; Cstr(gc_SectionPaie), xComplTabl("NBS" &amp; Cstr(gc_SectionPaie), "Form_ValDefaut", "1", True))
		End If
	End If
	
	' Proposition
	pnd_PNav.Prop_PropositionImprimee = xVar(gnd_Prop_SDSPM, "Prop_PropositionImprimee", "")
	pnd_PNav.Prop_NotesContrat = xVar(gnd_Prop_SDSPM, "Prop_NotesContrat", "")
	
	FPNav_DocumentExistant = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Function
End Function</lotusscript></code>
