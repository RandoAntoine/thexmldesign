</lotusscript></code><code event="FPNav_QueryOpen"><lotusscript>Sub FPNav_QueryOpen(pnuid_Source As Notesuidocument, p_Mode As Integer, p_Isnewdoc As Variant, _
p_Continue As Variant)
	On Error Goto GererErreur
	
	Dim nd_PNav As NotesDocument
	
	' Initialisations
	p_Continue = False
	If p_Mode &lt;&gt; 1 Then
		Exit Sub
	End If
	
	Set nd_PNav = pnuid_Source.Document
	
	' Initialiser les champs du document de navigation
	If FPNav_DocumentExistant(nd_PNav) Then
		p_Continue = True
	End If	
	
	' Effacer les champs RT des autres écrans
	If nd_PNav.Hasitem("Prop_DescDetaillee") Then
		Call nd_PNav.Removeitem("Prop_DescDetaillee")
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentExistant"><lotusscript>Function FPNav_DocumentExistant(pnd_PNav As NotesDocument) As Boolean
	On Error Goto GererErreur
	
	Dim a_MenuItems As Variant
	
	FPNav_DocumentExistant = False
	
	' Extraire la proposition
	If Not SDSPM_InitProp(xVar(pnd_PNav, "Prop_NoProposition", "")) Then
		Exit Function
	End If
	
	pnd_PNav.Prop_Statut = xVar(gnd_Prop_SDSPM, "Prop_Statut", "10")	
	Call pnd_PNav.ReplaceItemValue("Prop_StatutDesc" &amp; xLangue, _
	xVar(gnd_Prop_SDSPM, "Prop_StatutDesc" &amp; xLangue, ""))
	
	' Mettre à jour le document de navigation
	
	pnd_PNav.Prop_CommissionsRepresentant = xVar(gnd_Prop_SDSPM, "Prop_CommissionsRepresentant", "")
	pnd_PNav.Prop_CommissionsDirecteur = xVar(gnd_Prop_SDSPM, "Prop_CommissionsDirecteur", "")
	pnd_PNav.Prop_EscompteMontant = xVar(gnd_Prop_SDSPM, "Prop_EscompteMontant", 0)
	pnd_PNav.Prop_EscompteCorporatif = xVar(gnd_Prop_SDSPM, "Prop_EscompteCorporatif", 0)	
	pnd_PNav.Prop_PropositionImprimee = xVar(gnd_Prop_SDSPM, "Prop_PropositionImprimee", "")
	pnd_PNav.Prop_NoSites = xVar(gnd_Prop_SDSPM, "Prop_NoSites", "")
	pnd_PNav.Prop_EscompteMensualite = xVar(gnd_Prop_SDSPM, "Prop_EscompteMensualite", 0)
	pnd_PNav.Prop_PrePayeZero =  xVar(gnd_Prop_SDSPM, "Prop_PrePayeZero", "")
	pnd_PNav.Prop_ContratDuree = xVar(gnd_Prop_SDSPM, "Prop_ContratDuree", "1")  'Requête  46535
	pnd_PNav.Prop_ContratDureeDescEN = xSDSBB_xDescTabl(xVar(gnd_Prop_SDSPM, "Prop_ContratDuree", "1"), "Prop_ContDuree_EN", True)
	pnd_PNav.Prop_ContratDureeDescFR = xSDSBB_xDescTabl(xVar(gnd_Prop_SDSPM, "Prop_ContratDuree", "1"), "Prop_ContDuree_FR", True)	
	
	pnd_PNav.Prop_TauxContrat = xVar(gnd_Prop_SDSPM, "Prop_TauxContrat", "5") 	
	pnd_PNav.Prop_NotesContrat = xVar(gnd_Prop_SDSPM, "Prop_NotesContrat", "")
	
	a_MenuItems = xVarArray(pnd_PNav, "PNav_MenuItems")	
	' Si menu item contrat n'existe pas
	If Isnull(Arraygetindex(a_MenuItems, "6.00")) Then
		pnd_PNav.PNav_MenuOptionMax = "9"
	End If
	
	FPNav_DocumentExistant = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Function
End Function</lotusscript></code>
