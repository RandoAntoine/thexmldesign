<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "wsc_SDSP3"
Use "SDSP_MasquePNav"
Use "SDSP_Navigation"
Use "x_SDSBB"

</lotusscript></code><code event="declarations"><lotusscript>
' Traitement des erreurs
' -------------------------------
Const gc_TypeElement_FPNav = "SL"
Const gc_Element_FPNav = "F_PNav8.01"


</lotusscript></code><code event="FPNav_DocumentValide"><lotusscript>Function FPNav_DocumentValide(p_AfficherErreur As Boolean) As Boolean
	On Error Goto GererErreur
	
	FPNav_DocumentValide = False
	
	If xVar(gnd_SDSPM, "Prop_DescProposition", "") = "" Then
		If p_AfficherErreur Then
			MessageBox xGDK_xMessage("SI", 23, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call gnuid_SDSPN.GotoField("Prop_DescProposition")
		End If
		Exit Function
	End If
	
	FPNav_DocumentValide = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acImage"><lotusscript>Sub FPNav_acImage
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument(False) Then
		Exit Sub
	End If
	
	Call SDSPM_acImage(gnd_Prop_SDSPM)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub


</lotusscript></code><code event="FPNav_hsAnnuler"><lotusscript>Sub FPNav_hsAnnuler
	On Error Goto GererErreur
	
	gnd_SDSPM.SaveOptions = "0"
	Call gnuid_SDSPN.Close
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_QuerySave"><lotusscript>Sub FPNav_QuerySave(pnuid_Source As Notesuidocument, p_Continue As Variant)
	On Error Goto GererErreur
	
	' Sauvegarder l'étape courante
	p_Continue = FPNav_SauvegarderDocument(True)
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acGenererCommande"><lotusscript>Sub FPNav_acGenererCommande
	On Error GoTo GererErreur
	
	Call SDSPUI_acGenererCommande(gnd_Prop_SDSPM)
	
	Call gnuid_SDSPM.Refreshhideformulas
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsSuivant"><lotusscript>Sub FPNav_hsSuivant
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If FPNav_SauvegarderDocument(True) Then
		' Ouvrir le masque suivant
		Call SDSPN_OuvrirMasqueSuivant
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acImprimerPropositionSommaire"><lotusscript>Sub FPNav_acImprimerPropositionSommaire
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument(True) Then
		Exit Sub
	End If
	
	Call SDSPM_acImprimerPropositionSommaire
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acDupliquerProposition"><lotusscript>Sub FPNav_acDupliquerProposition
	On Error GoTo GererErreur
	
	Dim ndb As NotesDatabase
	Dim nd_Duplicata As NotesDocument
	Dim nd_DB As NotesDocument
	
	Dim v_UserName As String
	Dim v_Description As Variant
	Dim v_ID As String
	Dim v_DB_ID As String
	Dim v_EditMode As String
	Dim v_Commentaire As String
	Dim v_DBRecalcTous As Boolean
	Dim v_RecalcListe As Boolean
	
	On Error 4411 GoTo FinSub
	Call gnuid_SDSPM.Save
	
	' Demander la nouvelle description à l'utilisateur
	v_Description = gnuiws_SDSPM.Prompt(PROMPT_OKCANCELEDIT, _
	xGDK_xMessage("SDSPP", 46, "", ""), xGDK_xMessage("SDSPP", 47, "", ""), CStr(Today()))
	If v_Description = "" Then
		Exit Sub
	Else
		If v_Description = xVar(gnd_SDSPM,"Prop_DescProposition","") Then
			MessageBox xGDK_xMessage("SDSPP", 48, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		End If
	End If
	
	Set nd_DB = New NotesDocument(gndb_SDSPM)
	nd_DB.Form = "DB_SIHi"	
	nd_DB.SIHi_Obligatoire = True	' Image "&gt;" pour Commentaire obligatoire
	
	If Not gnuiws_SDSPN.DialogBox("DB_SIHi", True, True, False, False, False, False, _
	xGDK_xMessage("SI", 49, "", ""), nd_DB, True, False, False) Then
		Exit Sub
	End If
	
	v_Commentaire = xVar(nd_DB, "SIHi_Commentaire", "")
	v_UserName = gns_SDSPM.UserName
	v_EditMode = xVar(gnd_SDSPM, "PNav_EditMode", "")
	
	Call SDSPDp_DupliquerProposition(gnd_Prop_SDSPM,CStr(v_Description), nd_Duplicata, nd_DB, v_UserName)
	
	If Not nd_Duplicata Is Nothing Then
		Call SDSPM_acRecalculerCouts(nd_Duplicata, False, False)
		
		' Fermer la proposition
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPM.Close
		Call gnuiws_SDSPM.ViewRefresh
	Else
		Call gnuid_SDSPM.Refresh
	End If
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

	

</lotusscript></code><code event="FPNav_acImprimerProposition"><lotusscript>Sub FPNav_acImprimerProposition
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument(True) Then
		Exit Sub
	End If
	
	Call SDSPM_acImprimerProposition
	
	Exit Sub
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_SauvegarderDocument"><lotusscript>Function FPNav_SauvegarderDocument(p_ValiderDocument As Boolean) As Boolean
	On Error Goto GererErreur
	
	Dim v_MajProp As Boolean
	Dim v_DureeContrat As String
	Dim v_DureeDescEN As String
	Dim v_DureeDescFR As String
	
	If xVar(gnd_SDSPM, "PNav_EditMode", False) Then
		FPNav_SauvegarderDocument = False
	Else
		FPNav_SauvegarderDocument = True
		Exit Function
	End If
	
	' Calculer les champs automatiques
	On Error 4412 Goto FinSub
	Call gnuid_SDSPN.Refresh
	On Error 4412 Goto GererErreur
	
	' Valider le document courant
	If p_ValiderDocument Then
		If Not FPNav_DocumentValide(True) Then
			Call gnuid_SDSPN.RefreshHideFormulas
			Exit Function
		End If		
	End If
	
	' Extraire la proposition
	If Not SDSPM_InitProp("") Then
		Exit Function
	End If
	
	' Mettre à jour la proposition	
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DescProposition", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "Prop_EscompteMontant", 0) Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "Prop_EscompteCorporatif", 0) Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "Prop_EscompteMensualite", 0) Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "Prop_ContratDuree", "1") Or FPNav_SauvegarderDocument
	
	'FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Prop_SDSPM, "Prop_TauxContrat", xVar(gnd_SDSPM, "Prop_TauxContrat", "5")) Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "Prop_TauxContrat", "5") Or FPNav_SauvegarderDocument
	
	v_DureeContrat = xVar(gnd_SDSPM, "Prop_ContratDuree", "1")		
	v_DureeDescEN = xSDSBB_xDescTabl(v_DureeContrat, "Prop_ContDuree_EN", True)
	v_DureeDescFR = xSDSBB_xDescTabl(v_DureeContrat, "Prop_ContDuree_FR", True)
	
	FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Prop_SDSPM, "Prop_ContratDureeDescEN", v_DureeDescEN)Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItemValeur(gnd_Prop_SDSPM, "Prop_ContratDureeDescFR", v_DureeDescFR)Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "Prop_PrePayeZero", "") Or FPNav_SauvegarderDocument  'Requête 46535 
	
		
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "PNav_MenuOptionMax", "") Or FPNav_SauvegarderDocument
	
	If FPNav_SauvegarderDocument Then
		gnd_Prop_SDSPM.HistoDM = Now
		gnd_Prop_SDSPM.HistoUM = gns_SDSPM.UserName
		Call gnd_Prop_SDSPM.Save(True, False)
	End If
	
	FPNav_SauvegarderDocument = True
FinSub:	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_hsFermer"><lotusscript>Sub FPNav_hsFermer
	On Error Goto GererErreur
	
	' Sauvegarder l'étape courante
	If FPNav_SauvegarderDocument(True) Then
		' Fermer le masque courant
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub



</lotusscript></code><code event="FPNav_RecalculerMensualites"><lotusscript>Sub FPNav_RecalculerMensualites
	On Error Goto GererErreur
	
	Dim a_PeriodeA() As Long
	Dim a_MensualitesEQ() As Double
	Dim a_MensualitesLG() As Double
	Dim a_MensualitesEN() As Double
	Dim a_MensualitesFN() As Double
	Dim a_MensualitesPP() As Double
	Dim a_Periodes() As String
	
	
	' Calculer les mensualités
	' ----------------------------------
	Call SDSI_CalculerMensualites(gnd_SDSPM,  a_PeriodeA, a_MensualitesEQ, a_MensualitesLG, _
	a_MensualitesEN, a_MensualitesFN, a_MensualitesPP, a_Periodes)
	
	' Initialiser les variables d'affichage
	' ----------------------------------------------
	Call gnd_SDSPM.Replaceitemvalue("Prop_Periodes", a_Periodes)	
	gnd_SDSPM.Prop_MensualitesEQ = a_MensualitesEQ
	gnd_SDSPM.Prop_MensualitesLG = a_MensualitesLG
	gnd_SDSPM.Prop_MensualitesEN = a_MensualitesEN
	gnd_SDSPM.Prop_MensualitesFN = a_MensualitesFN
	gnd_SDSPM.Prop_MensualitesPR = a_MensualitesPP
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_PostOpen"><lotusscript>Sub FPNav_PostOpen(pnuid_Source As Notesuidocument)
	On Error Goto GererErreur
	
	' Initialisations
	Call SDSPN_Initialisations
	Call SDSPM_Initialisations
	
	Call FPNav_RecalculerMensualites
	
	' Calculer les totaux par département
	Call FPNav_CalculerTotauxUtilisateurs(gnd_SDSPM)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acWorkflow"><lotusscript>Sub FPNav_acWorkflow(p_Statut As String)
	On Error GoTo GererErreur
		
	If SDSPM_acWorkflow(p_Statut) Then
		
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		Call gnuiws_SDSPM.ViewRefresh
		
		' Ouvrir le masque	
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		
		gnd_SDSPM.PNav_Titre =  Trim("C" &amp; CStr(xVar(gnd_Prop_SDSPM, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(gnd_Prop_SDSPM, "Prop_ClientNomInterne", xVar(gnd_Prop_SDSPM, "Prop_ClientNom", "")))
		gnd_SDSPM.Titre =  Trim(xVar(gnd_SDSPM, "PNav_Titre", "") &amp; " - " &amp; xVar(gnd_SDSPM, "PNav_MenuDesc000", ""))
				
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbProposition", xVar(gnd_Prop_SDSPM, "Prop_NbProposition", 0))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionFmt", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionFmt", ""))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionPrefixe", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionPrefixe", ""))		
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
		
		Call gnuid_SDSPN.Refresh
	End If
		
	Exit Sub
		
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acSignerProposition"><lotusscript>Sub FPNav_acSignerProposition
	On Error GoTo GererErreur
	
	If SDSPUI_acSignerProposition(gnd_Prop_SDSPM, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
