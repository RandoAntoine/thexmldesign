<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_GestionErreurs"

</lotusscript></code><code event="declarations"><lotusscript>Dim gns_DBPMan As NotesSession
Dim gndb_DBPMan As NotesDatabase
Dim gnuiws_DBPMan As NotesUIWorkspace

' Traitement des erreurs
Const gc_TypeElement_DBPMan = "SL"
Const gc_Element_DBPMan = "DB_PMan"

</lotusscript></code><code event="DBPMan_Initialisations"><lotusscript>Sub DBPMan_Initialisations
	On Error Goto GererErreur
	
	If gns_DBPMan Is Nothing Then
		Set gns_DBPMan = New NotesSession
		Set gndb_DBPMan = gns_DBPMan.CurrentDatabase
		Set gnuiws_DBPMan = New NotesUIWorkspace
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_DBPMan, gc_Element_DBPMan, GetThreadInfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="DBPMan_Queryclose"><lotusscript>Function DBPMan_Queryclose(p_Source As NotesUIDocument) As Boolean
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	Dim i As Integer
	Dim v_ValeurItem As String
	Dim a_NbUtilisateursObligatoire As Variant
	Dim a_QuantiteModifiable As Variant
	
	' Initialisations
	DBPMan_Queryclose = False
	
	Set nd = p_Source.document
	
	If p_Source.DialogBoxCanceled = False Then
		
		a_NbUtilisateursObligatoire = xVarArray(nd, "DB_NbUtilisateursObligatoire")
		a_QuantiteModifiable = xVarArray(nd, "DB_QuantiteModifiable")
		
		' Valider Nb utilisateurs obligatoire
		'------------------------------------
		If Isarray(a_NbUtilisateursObligatoire) Then
			
			For i = 0 To Ubound(a_NbUtilisateursObligatoire)
				
				v_ValeurItem = xVar(nd, "DB_NbUtilisateurs" &amp; Cstr(i +1), "")
				
				If a_NbUtilisateursObligatoire(i) = "1" And xVar(nd, "DB_Code" &amp; Cstr(i + 1), "") &lt;&gt; "" Then
					
				' Valider si champ vide
					If v_ValeurItem = "" Then
						Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
						Exit Function
						
				' Valider si valeur numérique
					Elseif Not Isnumeric(v_ValeurItem) Then
						Messagebox xGDK_xMessage("SI", 12, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
						Exit Function
						
					Else
				' Valider si valeur &gt; 0
						If v_ValeurItem &lt; 1 Then
							Messagebox xGDK_xMessage("SI", 16, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
							Exit Function
						End If
						
					End If
					
				End If
				
			Next
			
		End If
		
		' Valider quantité modificable
		' ----------------------------
		If Isarray(a_QuantiteModifiable) Then
			
			For i = 0 To Ubound(a_QuantiteModifiable)
				
				v_ValeurItem = xVar(nd, "DB_QT" &amp; Cstr(i +1), "")
				
				If a_QuantiteModifiable(i) = "1" And xVar(nd, "DB_Code" &amp; Cstr(i +1), "") &lt;&gt; "" Then
					
				' Valider si champ vide
					If v_ValeurItem = "" Then
						Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
						Exit Function
						
				' Valider si valeur numérique
					Elseif Not Isnumeric(v_ValeurItem) Then
						Messagebox xGDK_xMessage("SI", 12, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
						Exit Function
						
					Else
				' Valider si valeur &gt; 0
						If v_ValeurItem &lt; 1 Then
							Messagebox xGDK_xMessage("SI", 16, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
							Exit Function
						End If
					End If
					
				End If
				
			Next
			
		End If
		
	End If
	
	DBPMan_Queryclose = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_DBPMan, gc_Element_DBPMan, GetThreadInfo(1), "", False)
	Exit Function
End Function</lotusscript></code>
