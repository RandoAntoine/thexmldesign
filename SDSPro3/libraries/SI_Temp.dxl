<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_GestionErreurs"
Use "x_GDK"

</lotusscript></code><code event="declarations"><lotusscript>Dim gns_SITp As NotesSession
Dim gndb_Temp_SITp As NotesDatabase

' Traitement des erreurs
' -----------------------------------
Const gc_TypeElement_SITp = "SL"
Const gc_Element_SITp = "SI_Temp"

</lotusscript></code><code event="SITp_ndTemp"><lotusscript>Function SITp_ndTemp(p_Description As String) As NotesDocument
	' Fonction permettant de créer un nouveau document temporaire
	On Error Goto GererErreur
	
	Set SITp_ndTemp = Nothing
	
	If SITp_Initialisations then
		Set SITp_ndTemp = New NotesDocument(gndb_Temp_SITp)
		SITp_ndTemp.Cle = Evaluate(|@Unique|)
		SITp_ndTemp.Description = p_Description
		SITp_ndTemp.HistoDC = Now
		SITp_ndTemp.HistoUC = gns_SITp.UserName
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SITp, gc_Element_SITp, Getthreadinfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="SITp_Initialisations"><lotusscript>Function SITp_Initialisations As Boolean
	On Error GoTo GererErreur
	
	SITp_Initialisations = False
	
	If gns_SITp Is Nothing Then
		Set gns_SITp = New NotesSession
		Set gndb_Temp_SITp = xGDK_xndbNDB("SITp")
	End If
	
	If Not (gndb_Temp_SITp Is Nothing) Then
		SITp_Initialisations = gndb_Temp_SITp.IsOpen
	End If
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SITp, gc_Element_SITp, GetThreadInfo(1), "", False)
	Exit Function
End function</lotusscript></code>
