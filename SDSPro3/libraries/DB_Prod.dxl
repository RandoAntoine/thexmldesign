<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Explicit
Use "SDSP_Navigation"
'
'	Les fonctions définies dans cette bibliothèque de script permettent la gestion de tous les
'	opérations reliés au formulaire Table | F_Tabl.
'

</lotusscript></code><code event="declarations"><lotusscript>Dim gns_DB As NotesSession
Dim gndb_DB As NotesDatabase
Dim gnuiws_DB As NotesUIWorkspace

' Traitement des erreurs
Const gc_TypeElement_DB = "SL"
Const gc_Element_DB = "DB_PFor"

</lotusscript></code><code event="DB_Querysave"><lotusscript>Function DB_Querysave(pnuid_Source As Notesuidocument) As Boolean
	On Error Goto GererErreur
	
	Dim nd As Notesdocument
	
	DB_Querysave = False
	
	Call DB_Initialisations
	Set nd = pnuid_Source.Document
	
	If xVar(nd, "Prod_ClasseProduit", "") = "EQ" Then
		If xVar(nd, "Prod_Departement", "") = "" Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
			Call pnuid_Source.GotoField("Prod_Departement")
			Exit Function
		End If
	End If
	
	If xVar(nd, "Prod_Quantite", 0) = 0 Then
		Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "")
		Call pnuid_Source.GotoField("Prod_Quantite")
		Exit Function
	End If
	
	DB_Querysave = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_DB, gc_Element_DB, GetThreadInfo(1), "", False)
	Exit Function
End Function

</lotusscript></code><code event="DB_Initialisations"><lotusscript>Sub DB_Initialisations
	If gns_DB Is Nothing Then
		Set gns_DB = New NotesSession
		Set gndb_DB = gns_DB.CurrentDatabase
		Set gnuiws_DB = New NotesUIWorkspace
	End If
End Sub</lotusscript></code>
