<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_GestionErreurs"

</lotusscript></code><code event="declarations"><lotusscript>Dim gns_DBRCou As NotesSession
Dim gndb_DBRCou As NotesDatabase
Dim gnuiws_DBRCou As NotesUIWorkspace

' Traitement des erreurs
Const gc_TypeElement_DBRCou = "SL"
Const gc_Element_DBRCou = "DB_RCou"

</lotusscript></code><code event="DBRCou_Initialisations"><lotusscript>Sub DBRCou_Initialisations
	On Error Goto GererErreur
	
	If gns_DBRCou Is Nothing Then
		Set gns_DBRCou = New NotesSession
		Set gndb_DBRCou = gns_DBRCou.CurrentDatabase
		Set gnuiws_DBRCou = New NotesUIWorkspace
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_DBRCou, gc_Element_DBRCou, Getthreadinfo(1), "", False)
	Exit Sub
End Sub

</lotusscript></code><code event="DBRCou_Queryclose"><lotusscript>Function DBRCou_Queryclose(p_Source As NotesUIDocument) As Boolean
	On Error Goto GererErreur
	
	Dim nd As NotesDocument
	Set nd = p_Source.document
	
	' Initialisations
	DBRCou_Queryclose = False
	
	If p_Source.DialogBoxCanceled = True Then
		If xVar(nd, "DB_RecalcTous", "") = "" And  xVar(nd, "DB_ChoixObligatoire", 0) = -1 Then
			Exit Function
		End If
	End If
	
	DBRCou_Queryclose = True
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_DBRCou, gc_Element_DBRCou, Getthreadinfo(1), "", False)
	Exit Function
End Function</lotusscript></code>
