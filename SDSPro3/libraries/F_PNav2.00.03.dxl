			Call gnuid_SDSPN.GotoField("Site_D3_NbEcrans")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_D4_Section", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (16)"
			'	Call gnuid_SDSPN.GotoField("Site_D4_Section")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_D4_Section", "") = "1" Then
		
		If xVar(gnd_SDSPM, "Site_D4_NbUtilisateurs", "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (17)"
				Call gnuid_SDSPN.GotoField("Site_D4_NbUtilisateurs")
			End If
			Exit Function
		End If
		If xVar(gnd_SDSPM, "Site_D4_NbTechniciens", "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (18)"
				Call gnuid_SDSPN.GotoField("Site_D4_NbTechniciens")
			End If
			Exit Function
		End If
		
		If xVar(gnd_SDSPM, "Site_D4_NbTechniciens", 0) &gt; 0 Then
			If xVar(gnd_SDSPM, "Site_D4_DistanceService", "") = "" Then
				If p_AfficherErreur Then
					Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (19)"
					Call gnuid_SDSPN.GotoField("Site_D4_DistanceService")
				End If
				Exit Function
			End If
		End If
		If xVar(gnd_SDSPM, "Site_D4_Section", "") = "1" And xVar(gnd_SDSPM, "Site_D4_DistanceService", -1) &lt; 0 Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (20)"
				Call gnuid_SDSPN.GotoField("Site_D4_DistanceService")
			End If
			Exit Function
		End If
		If xVar(gnd_SDSPM, "Site_D4_ImprimantesService", "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (21)"
			End If
			Exit Function
		Elseif xVar(gnd_SDSPM, "Site_D4_ImprimantesService", "") = "1" Then
			gnd_SDSPM.Site_D4_AucuneImprimante = "1"
		End If
		If xVarElem(gnd_SDSPM, "Site_D4_Imprimantes", 0, "") = "" And _
		xVar(gnd_SDSPM, "Site_D4_AucuneImprimante", "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (22)"
			End If
			Exit Function
		End If
		If xVar(gnd_SDSPM, "Site_D4_NbPC", "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (23)"
				Call gnuid_SDSPN.GotoField("Site_D4_NbPC")
			End If
			Exit Function
		End If
		If xVar(gnd_SDSPM, "Site_D4_NbEcrans", "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (24)"
				Call gnuid_SDSPN.GotoField("Site_D4_NbEcrans")
			End If
			Exit Function
		End If
		
		
				
	End If
	
	FPNav_DocumentValide = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_acImage"><lotusscript>Sub FPNav_acImage
