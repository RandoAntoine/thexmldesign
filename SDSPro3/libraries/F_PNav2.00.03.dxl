	If xVar(gnd_SDSPM, "Site_D3_NbPC", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (14)"
