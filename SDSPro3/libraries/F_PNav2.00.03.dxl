<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "wsc_SDSP3"
Use "SDSP_MasquePNav"
Use "SDSP_Navigation"

</lotusscript></code><code event="declarations"><lotusscript>' Déclarations globales
' ---------------------
Dim g_Site_D2_FormulairesInspectionSV_FPNav As String
Dim g_Site_D3_ControleAtelier_FPNav As String
Dim g_Site_D4_Section_FPNav As String
Dim g_Site_D4_ImprimantesService_FPNav As String
Dim g_Site_D2_AucunSDSRDV_FPNav As String

' Traitement des erreurs
' ----------------------
Const gc_TypeElement_FPNav = "SL"
Const gc_Element_FPNav = "F_PNav2.00.03"


</lotusscript></code><code event="FPNav_ConstruireFormuleRech"><lotusscript>Function FPNav_ConstruireFormuleRech(p_NomItemValeurs As String, p_NomItemRecherche As String, p_RechercheItemVide As Boolean, p_Formule As String) As String
	
	On Error Goto GererErreur
	
	Dim v_Formule As String
	Dim ni As NotesItem
	
	Set ni = xni(gnd_SDSPM, p_NomItemValeurs, "")
	
	If Isarray(ni.Values) Then
		Forall p In ni.Values
			If p &lt;&gt; "" Then
				v_Formule = v_Formule &amp; "FIELD " &amp; p_NomItemRecherche &amp; " contains (" &amp; p &amp; ") OR "
			End If
		End Forall
		
		If p_RechercheItemVide Then
			v_Formule = "(" &amp; v_Formule &amp; " Not [" &amp; p_NomItemRecherche &amp;"] is present) OR"
		End If
		
		v_Formule = Left$(v_Formule , Len(v_Formule ) - 3)
	End If
	
	If v_Formule &lt;&gt; "" Then
		If p_Formule = "" Then
			FPNav_ConstruireFormuleRech = v_Formule
		Else
			FPNav_ConstruireFormuleRech = p_Formule &amp; " AND " &amp; v_Formule
		End If
		v_Formule = ""
	End If
	
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
	
End Function

</lotusscript></code><code event="FPNav_DocumentValide"><lotusscript>Function FPNav_DocumentValide(p_AfficherErreur As Boolean) As Boolean
	On Error Goto GererErreur
	
	FPNav_DocumentValide = False
	
	If xVar(gnd_SDSPM, "Prop_DescProposition", "") = "" Then
		If p_AfficherErreur Then
			MessageBox xGDK_xMessage("SI", 23, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (1)"
			Call gnuid_SDSPN.GotoField("Prop_DescProposition")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_D2_NbUtilisateurs", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (2)"
			Call gnuid_SDSPN.GotoField("Site_D2_NbUtilisateurs")
		End If
		Exit Function
	End If
	
	If xVarElem(gnd_SDSPM, "Site_D2_Imprimantes", 0, "") = "" And _
	xVar(gnd_SDSPM, "Site_D2_AucuneImprimante", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (3)"
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_D2_NbPC", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (4)"
			Call gnuid_SDSPN.GotoField("Site_D2_NbPC")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_D2_NbEcrans", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (5)"
			Call gnuid_SDSPN.GotoField("Site_D2_NbEcrans")
		End If
		Exit Function
	End If
	
	If xVarElem(gnd_SDSPM, "Site_D2_SDSRDV", 0, "") = "" And _
	xVar(gnd_SDSPM, "Site_D2_AucunSDSRDV", "") = "" Then
		If p_AfficherErreur Then
			MessageBox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (6)"
		End If
		Exit Function
	End If
	
	If xVarElem(gnd_SDSPM, "Site_D2_EntretienRecommande", 0, "") = "" And _
	xVar(gnd_SDSPM, "Site_D2_AucunEntretienRecommande", "") = "" Then
		If p_AfficherErreur Then
			MessageBox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (25)"			
		End If
		Exit Function
	End If
	
	If xVarElem(gnd_SDSPM, "Site_D2_InterfaceEstimation", 0, "") = "" And _
	xVar(gnd_SDSPM, "Site_D2_AucunInterfaceEstimation", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (7)"
			'Call gnuid_SDSPN.GotoField("Site_D2_InterfaceEstimation")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_D2_FormulairesInspectionSV", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (8)"
			Call gnuid_SDSPN.GotoField("Site_D2_FormulairesInspectionSV")
		End If
		Exit Function
	End If
	
	If xVar(gnd_SDSPM, "Site_D2_FormulairesInspectionSV", "") = "1" Then
		If xVarElem(gnd_SDSPM, "Site_D2_FormulairesInspOEM", 0, "") = "" And xVar(gnd_SDSPM, "Site_D2_AucunFormulaireInspOEM", "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (9)"
			'	Call gnuid_SDSPN.GotoField("Site_D3_Imprimantes")
			End If
			Exit Function
		End If
	End If
	
	If xVar(gnd_SDSPM, "Site_D2_FormulairesInspectionSV", "") = "1" Then
		If xVar(gnd_SDSPM, "Site_D2_NbPages", "") = "" Then
			If p_AfficherErreur Then
				Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (10)"
				Call gnuid_SDSPN.GotoField("Site_D2_NbPages")
			End If
			Exit Function
		End If
	End If
	
	If xVar(gnd_SDSPM, "Site_D3_NbTechniciens", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (11)"
			Call gnuid_SDSPN.GotoField("Site_D3_NbTechniciens")
		End If
		Exit Function
	End If
	If xVar(gnd_SDSPM, "Site_D3_ControleAtelier", "") = "" Then
		If p_AfficherErreur Then
			Messagebox xGDK_xMessage("SI", 201, "", ""), 16, xGDK_xMessage("SI", 0, "", "") &amp; " (12)"
			'	Call gnuid_SDSPN.GotoField("Site_D3_ControleAtelier")
		End If
		Exit Function
