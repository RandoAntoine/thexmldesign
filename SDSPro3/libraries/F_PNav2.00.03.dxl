</lotusscript></code><code event="FPNav_QueryOpen"><lotusscript>Sub FPNav_QueryOpen(pnuid_Source As Notesuidocument, p_Mode As Integer, p_Isnewdoc As Variant, _
p_Continue As Variant)
	On Error Goto GererErreur
	
	Dim nd_PNav As NotesDocument
	
	' Initialisations
	p_Continue = False
	If p_Mode &lt;&gt; 1 Then
		Exit Sub
	End If
	
	Set nd_PNav = pnuid_Source.Document
	
	' Initialiser les champs du document de navigation
	If FPNav_DocumentExistant(nd_PNav) Then
		p_Continue = True
	End If	
	
	' Effacer les champs RT des autres écrans
	If nd_PNav.Hasitem("Prop_DescDetaillee") Then
		Call nd_PNav.Removeitem("Prop_DescDetaillee")
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_DocumentExistant"><lotusscript>Function FPNav_DocumentExistant(pnd_PNav As NotesDocument) As Boolean
	On Error Goto GererErreur
	
	FPNav_DocumentExistant = False
	
	' Extraire la proposition
	If Not SDSPM_InitProp(xVar(pnd_PNav, "Prop_NoProposition", "")) Then
		Exit Function
	End If
	
	' Extraire le site
	If Not SDSPM_InitSite(pnd_PNav) Then
		Exit Function
	End If
	
	g_Site_D2_FormulairesInspectionSV_FPNav = xVar(gnd_Site_SDSPM, "Site_D2_FormulairesInspectionSV", "")
	g_Site_D3_ControleAtelier_FPNav = xVar(gnd_Site_SDSPM, "Site_D3_ControleAtelier", "")
	g_Site_D4_Section_FPNav = xVar(gnd_Site_SDSPM, "Site_D4_Section", "")
	g_Site_D4_ImprimantesService_FPNav = xVar(gnd_Site_SDSPM, "Site_D4_ImprimantesService", "")
	g_Site_D2_AucunSDSRDV_FPNav = xVar(gnd_Site_SDSPM, "Site_D2_AucunSDSRDV", "")
		
	pnd_PNav.Prop_Statut = xVar(gnd_Prop_SDSPM, "Prop_Statut", "10")
	Call pnd_PNav.ReplaceItemValue("Prop_StatutDesc" &amp; xLangue, _
	xVar(gnd_Prop_SDSPM, "Prop_StatutDesc" &amp; xLangue, ""))
	
	' Mettre à jour ll'entête du site
	pnd_PNav.Site_ClientNomInterne = xVar(gnd_Site_SDSPM, "Site_ClientNomInterne", "")
	pnd_PNav.Site_Banniere = xVar(gnd_Site_SDSPM, "Site_Banniere", "")
	pnd_PNav.Site_BanniereDesc = xVar(gnd_Site_SDSPM, "Site_BanniereDesc", "")
	
	' Mettre à jour le document de navigation
	pnd_PNav.Site_D2_Section = xVar(gnd_Site_SDSPM, "Site_D2_Section", "")
	pnd_PNav.Site_D2_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D2_NbUtilisateurs", "")
	pnd_PNav.Site_D2_NbPages = xVar(gnd_Site_SDSPM, "Site_D2_NbPages", "")
	pnd_PNav.Site_D3_Section = xVar(gnd_Site_SDSPM, "Site_D3_Section", "")
	pnd_PNav.Site_D3_NbTechniciens = xVar(gnd_Site_SDSPM, "Site_D3_NbTechniciens", "")
	Call SDSPM_InitProduitsProgramme(pnd_PNav, "Site_D2_Imprimantes", "", "")
	pnd_PNav.Site_D2_AucuneImprimante = xVar(gnd_Site_SDSPM, "Site_D2_AucuneImprimante", "")
	pnd_PNav.Site_D2_NbPC = xVar(gnd_Site_SDSPM, "Site_D2_NbPC", "")
	pnd_PNav.Site_D2_NbEcrans = xVar(gnd_Site_SDSPM, "Site_D2_NbEcrans", "")
	
	Call SDSPM_InitProduitsProgramme(pnd_PNav, "Site_D2_SDSRDV", "", "")
	pnd_PNav.Site_D2_AucunSDSRDV = xVar(gnd_Site_SDSPM, "Site_D2_AucunSDSRDV", "")
	
	Call SDSPM_InitProduitsProgramme(pnd_PNav, "Site_D2_FormulairesInspOEM", "", "LG.70")
	pnd_PNav.Site_D2_AucunFormulaireInspOEM = xVar(gnd_Site_SDSPM, "Site_D2_AucunFormulaireInspOEM", "")
	
	Call SDSPM_InitProduitsProgramme(pnd_PNav, "Site_D3_Imprimantes", "", "")
	pnd_PNav.Site_D3_AucuneImprimante = xVar(gnd_Site_SDSPM, "Site_D3_AucuneImprimante", "")
	pnd_PNav.Site_D3_ControleAtelier = xVar(gnd_Site_SDSPM, "Site_D3_ControleAtelier", "")
	pnd_PNav.Site_D3_NbPC = xVar(gnd_Site_SDSPM, "Site_D3_NbPC", "")
	pnd_PNav.Site_D3_NbEcrans = xVar(gnd_Site_SDSPM, "Site_D3_NbEcrans", "")
	
	Call SDSPM_InitProduitsProgramme(pnd_PNav, "Site_D2_EntretienRecommande", "", "")
	pnd_PNav.Site_D2_AucunEntretienRecommande = xVar(gnd_Site_SDSPM, "Site_D2_AucunEntretienRecommande", "")
	
	Call SDSPM_InitProduitsProgramme(pnd_PNav, "Site_D2_InterfaceEstimation", "", "")
	pnd_PNav.Site_D2_AucunInterfaceEstimation = xVar(gnd_Site_SDSPM, "Site_D2_AucunInterfaceEstimation", "")
	
	pnd_PNav.Site_D2_FormulairesInspectionSV = xVar(gnd_Site_SDSPM, "Site_D2_FormulairesInspectionSV", "")
	pnd_PNav.Site_D4_Section = xVar(gnd_Site_SDSPM, "Site_D4_Section", "")
	
	pnd_PNav.Site_D4_NbUtilisateurs = xVar(gnd_Site_SDSPM, "Site_D4_NbUtilisateurs", "")
	pnd_PNav.Site_D4_NbTechniciens = xVar(gnd_Site_SDSPM, "Site_D4_NbTechniciens", "")
	pnd_PNav.Site_D4_DistanceService = xVar(gnd_Site_SDSPM, "Site_D4_DistanceService", "")
	pnd_PNav.Site_D4_ImprimantesService = xVar(gnd_Site_SDSPM, "Site_D4_ImprimantesService", "")
	Call SDSPM_InitProduitsProgramme(pnd_PNav, "Site_D4_Imprimantes", "", "")
	pnd_PNav.Site_D4_AucuneImprimante = xVar(gnd_Site_SDSPM, "Site_D4_AucuneImprimante", "")
	pnd_PNav.Site_D4_NbPC = xVar(gnd_Site_SDSPM, "Site_D4_NbPC", "")
	pnd_PNav.Site_D4_NbEcrans = xVar(gnd_Site_SDSPM, "Site_D4_NbEcrans", "")
	
	pnd_PNav.Prop_PropositionImprimee = xVar(gnd_Prop_SDSPM, "Prop_PropositionImprimee", "")
	pnd_PNav.Prop_NotesContrat = xVar(gnd_Prop_SDSPM, "Prop_NotesContrat", "")
	FPNav_DocumentExistant = True
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(pnd_PNav, "Cle", ""), False)
	Exit Function
End Function</lotusscript></code>
