</lotusscript></code><code event="FPNav_acDupliquerProposition"><lotusscript>Sub FPNav_acDupliquerProposition
	On Error GoTo GererErreur
	
	Dim ndb As NotesDatabase
	Dim nd_Duplicata As NotesDocument
	Dim nd_DB As NotesDocument
	
	Dim v_UserName As String
	Dim v_Description As Variant
	Dim v_ID As String
	Dim v_DB_ID As String
	Dim v_EditMode As String
	Dim v_Commentaire As String
	Dim v_DBRecalcTous As Boolean
	Dim v_RecalcListe As Boolean
	
	On Error 4411 GoTo FinSub
	Call gnuid_SDSPM.Save
	
	' Demander la nouvelle description à l'utilisateur
	v_Description = gnuiws_SDSPM.Prompt(PROMPT_OKCANCELEDIT, _
	xGDK_xMessage("SDSPP", 46, "", ""), xGDK_xMessage("SDSPP", 47, "", ""), CStr(Today()))
	If v_Description = "" Then
		Exit Sub
	Else
		If v_Description = xVar(gnd_SDSPM,"Prop_DescProposition","") Then
			MessageBox xGDK_xMessage("SDSPP", 48, "", ""), 16, xGDK_xMessage("SI", 1, "", "")
		End If
	End If
	
	Set nd_DB = New NotesDocument(gndb_SDSPM)
	nd_DB.Form = "DB_SIHi"	
	nd_DB.SIHi_Obligatoire = True	' Image "&gt;" pour Commentaire obligatoire
	
	If Not gnuiws_SDSPN.DialogBox("DB_SIHi", True, True, False, False, False, False, _
	xGDK_xMessage("SI", 49, "", ""), nd_DB, True, False, False) Then
		Exit Sub
	End If
	
	v_Commentaire = xVar(nd_DB, "SIHi_Commentaire", "")
	v_UserName = gns_SDSPM.UserName
	v_EditMode = xVar(gnd_SDSPM, "PNav_EditMode", "")
	
	Call SDSPDp_DupliquerProposition(gnd_Prop_SDSPM,CStr(v_Description), nd_Duplicata, nd_DB, v_UserName)
	
	If Not nd_Duplicata Is Nothing Then
		Call SDSPM_acRecalculerCouts(nd_Duplicata, False, False)
		
		' Fermer la proposition
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPM.Close
		Call gnuiws_SDSPM.ViewRefresh
	Else
		Call gnuid_SDSPM.Refresh
	End If
	
FinSub:
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

	

</lotusscript></code><code event="FPNav_acImprimerProposition"><lotusscript>Sub FPNav_acImprimerProposition
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument(True) Then
		Exit Sub
	End If
	
	Call SDSPM_acImprimerProposition
	
	Exit Sub
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_SauvegarderDocument"><lotusscript>Function FPNav_SauvegarderDocument(p_ValiderDocument As Variant) As Boolean
	On Error Goto GererErreur
	
	Dim v_NoOptionCourante As String
	Dim v_NoOptionMax As String
	Dim v_DocumentValide As Boolean
	Dim v_MajProp As Boolean
	Dim v_MajNbUtilisateursSDS As Boolean
	Dim v_MajNbUtilisateursTech As Boolean
	Dim v_MajNbUtilisateursBody As Boolean
	Dim v_MajControleAtelier As Boolean
	Dim v_MajProd_ON As Boolean
	Dim v_MajProdAjoute As Boolean
	Dim v_UserName As String
	
	If xVar(gnd_SDSPM, "PNav_EditMode", False) Then
		FPNav_SauvegarderDocument = False
	Else
		FPNav_SauvegarderDocument = True
		Exit Function
	End If
	
	' Calculer les champs automatiques
	On Error 4412 Goto FinSub
	Call gnuid_SDSPN.Refresh
	On Error 4412 Goto GererErreur
	
	' Valider le document courant
	v_NoOptionCourante = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "0.00")
	v_NoOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionMax", "0.00")
	If p_ValiderDocument = "" Then
		v_DocumentValide = FPNav_DocumentValide(Cint(v_NoOptionCourante &lt; v_NoOptionMax))
	Else
		v_DocumentValide = FPNav_DocumentValide(Cint(p_ValiderDocument))
	End If
	If v_DocumentValide = False Then
		If p_ValiderDocument = True Then
			Call gnuid_SDSPN.RefreshHideFormulas
			Exit Function
		End If
		
		gnd_SDSPM.PNav_MenuOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "")
	End If
	
	' Extraire la proposition
	If Not SDSPM_InitProp("") Then
		Exit Function
	End If
	
	' Extraire le site
	If Not SDSPM_InitSite(Nothing) Then
		Exit Function
	End If
	
	' Mettre à jour le site
	v_UserName = gns_SDSPM.UserName
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_Section", "") Or FPNav_SauvegarderDocument
	
	v_MajNbUtilisateursSDS = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_NbUtilisateurs", "")
	FPNav_SauvegarderDocument = v_MajNbUtilisateursSDS Or FPNav_SauvegarderDocument	
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_NbPages", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_Qte("2", "Site_D2_NbPages","")
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D3_Section", "") Or FPNav_SauvegarderDocument
	
	v_MajNbUtilisateursTech = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D3_NbTechniciens", "") Or SDSPM_MajItem(gnd_Site_SDSPM, "Site_D4_NbTechniciens", "")
	FPNav_SauvegarderDocument = v_MajNbUtilisateursTech Or FPNav_SauvegarderDocument
	
	If xVar(gnd_SDSPM, "Site_D2_AucuneImprimante", "") = "1" Then
		Call SDSPM_SupprimerProduitsDepartement("Site_D2_Imprimantes","")
	End If
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_AucuneImprimante", "") Or FPNav_SauvegarderDocument
	
	If xVar(gnd_SDSPM, "Site_D2_AucunFormulaireInspOEM", "") = "1" Then
		Call SDSPM_SupprimerProduitsDepartement("Site_D2_FormulairesInspOEM","")
	End If
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_AucunFormulaireInspOEM", "") Or FPNav_SauvegarderDocument
	
	If xVar(gnd_SDSPM, "Site_D3_AucuneImprimante", "") = "1" Then
		Call SDSPM_SupprimerProduitsDepartement("Site_D3_Imprimantes","")
	End If
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D3_AucuneImprimante", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_NbPC", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_Qte("2", "Site_D2_NbPC","")
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D3_NbPC", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_Qte("3", "Site_D3_NbPC","")
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_NbEcrans", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_Qte("2", "Site_D2_NbEcrans","")
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D3_NbEcrans", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_Qte("3", "Site_D3_NbEcrans","")
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_SDSRDV", "") Or FPNav_SauvegarderDocument
	If xVar(gnd_SDSPM, "Site_D2_AucunSDSRDV", "") = "1" Then
		Call SDSPM_SupprimerProduitsDepartement("Site_D2_SDSRDV", "")
	End If
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_AucunSDSRDV", "") Or FPNav_SauvegarderDocument
	
	
	v_MajControleAtelier = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D3_ControleAtelier", "")
	FPNav_SauvegarderDocument = v_MajControleAtelier Or FPNav_SauvegarderDocument
	
	Call SDSPM_MajProduitsProgramme_ON("", "Site_D3_ControleAtelier", 0,"")
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_AucunEntretienRecommande", "") Or FPNav_SauvegarderDocument	
		
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_EntretienRecommande", "") Or FPNav_SauvegarderDocument
	If xVar(gnd_SDSPM, "Site_D2_AucunEntretienRecommande", "") = "1" Then
		Call SDSPM_SupprimerProduitsDepartement("Site_D2_EntretienRecommande", "")
	End If
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_AucunEntretienRecommande", "") Or FPNav_SauvegarderDocument
	
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_AucunInterfaceEstimation", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_InterfaceEstimation", "") Or FPNav_SauvegarderDocument
	'Call SDSPM_MajProduitsProgramme_ON("", "Site_D2_InterfaceEstimation", 0,"")
	If xVar(gnd_SDSPM, "Site_D2_AucunInterfaceEstimation", "") = "1" Then
		Call SDSPM_SupprimerProduitsDepartement("Site_D2_InterfaceEstimation","")
	End If
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_AucunInterfaceEstimation", "") Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D2_FormulairesInspectionSV", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_ON("", "Site_D2_FormulairesInspectionSV", 0,"")
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D4_Section", "") Or FPNav_SauvegarderDocument
	
	If xVar(gnd_SDSPM, "Site_D2_FormulairesInspectionSV", "") &lt;&gt; "1" Then
		gnd_SDSPM.Site_D2_AucunFormulaireInspOEM = ""
		Call SDSPM_SupprimerProduitsDepartement("Site_D2_FormulairesInspOEM","")
	End If
	
	If xVar(gnd_SDSPM, "Site_D4_Section", "") &lt;&gt; "1" Then
		gnd_SDSPM.Site_D4_NbUtilisateurs = ""
		gnd_SDSPM.Site_D4_NbTechniciens = ""
		gnd_SDSPM.Site_D4_DistanceService = ""
		gnd_SDSPM.Site_D4_ImprimantesService = ""
		gnd_SDSPM.Site_D4_AucuneImprimante = ""
		Call SDSPM_SupprimerProduitsDepartement("Site_D4_Imprimantes","")
		gnd_SDSPM.Site_D4_NbPC = ""
		gnd_SDSPM.Site_D4_NbEcrans = ""
	End If
	
	v_MajNbUtilisateursBody = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D4_NbUtilisateurs", "")
	FPNav_SauvegarderDocument = v_MajNbUtilisateursBody Or FPNav_SauvegarderDocument
	
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D4_NbTechniciens", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D4_DistanceService", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D4_ImprimantesService", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D4_AucuneImprimante", "") Or FPNav_SauvegarderDocument
	
	If xVar(gnd_SDSPM, "Site_D4_ImprimantesService", "") = "1" _
	Or xVar(gnd_SDSPM, "Site_D4_AucuneImprimante", "") = "1" Then
		Call SDSPM_SupprimerProduitsDepartement("Site_D4_Imprimantes","")
	End If
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D4_NbPC", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_Qte("4", "Site_D4_NbPC","")
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Site_SDSPM, "Site_D4_NbEcrans", "") Or FPNav_SauvegarderDocument
	Call SDSPM_MajProduitsProgramme_Qte("4", "Site_D4_NbEcrans","")
	
	If FPNav_SauvegarderDocument Then
		gnd_Site_SDSPM.HistoDM = Now
		gnd_Site_SDSPM.HistoUM = v_UserName
		Call gnd_Site_SDSPM.Save(True, False)
	End If
	
	If g_Site_D2_FormulairesInspectionSV_FPNav = "0" And xVar(gnd_Site_SDSPM, "Site_D2_FormulairesInspectionSV", "") = "1" Then
		v_MajProd_ON = True
	ElseIf g_Site_D3_ControleAtelier_FPNav = "0" And xVar(gnd_Site_SDSPM, "Site_D3_ControleAtelier", "") = "1" Then
		v_MajProd_ON = True
	ElseIf g_Site_D4_Section_FPNav = "0" And xVar(gnd_Site_SDSPM, "Site_D4_Section", "") = "1" Then
		v_MajProd_ON = True
	ElseIf g_Site_D4_ImprimantesService_FPNav = "0" And xVar(gnd_Site_SDSPM, "Site_D4_ImprimantesService", "") = "1" Then
		v_MajProd_ON = True
	End If
	
	If g_Site_D2_AucunSDSRDV_FPNav = "1" And xVar(gnd_Site_SDSPM, "Site_D2_AucunSDSRDV", "") = "" Then
		v_MajProdAjoute = True
	End if
	
	' Recalculer escompte si nombre d'utilisateurs changé
	If v_MajNbUtilisateursSDS Or _
	v_MajNbUtilisateursTech Or _
	v_MajControleAtelier Or _
	v_MajNbUtilisateursBody Or _
	v_MajProd_ON Or _
	v_MajProdAjoute Then
		If xVar(gnd_Prop_SDSPM, "Prop_Statut", "0") &lt; "50" Then
			Call SDSPX_CalculerPrixEscompteLG(gnd_Prop_SDSPM, v_UserName)
		End If
		
		Call SDSPX_RecalculerNbUtilisateursLicense(gnd_Prop_SDSPM, gnd_Site_SDSPM)
		
	End If
	
	' Mettre à jour la proposition
	FPNav_SauvegarderDocument = SDSPm_MajItem(gnd_Prop_SDSPM, "Prop_DescProposition", "") Or FPNav_SauvegarderDocument
	FPNav_SauvegarderDocument = SDSPM_MajItem(gnd_Prop_SDSPM, "PNav_MenuOptionMax", "") Or FPNav_SauvegarderDocument
	
	If FPNav_SauvegarderDocument Then
		gnd_Prop_SDSPM.HistoDM = Now
		gnd_Prop_SDSPM.HistoUM = v_UserName
		Call gnd_Prop_SDSPM.Save(True, False)
		
		g_Site_D2_FormulairesInspectionSV_FPNav = xVar(gnd_Site_SDSPM, "Site_D2_FormulairesInspectionSV", "")
		g_Site_D3_ControleAtelier_FPNav = xVar(gnd_Site_SDSPM, "Site_D3_ControleAtelier", "")
		g_Site_D4_Section_FPNav = xVar(gnd_Site_SDSPM, "Site_D4_Section", "")
		g_Site_D4_ImprimantesService_FPNav = xVar(gnd_Site_SDSPM, "Site_D4_ImprimantesService", "")	
		g_Site_D2_AucunSDSRDV_FPNav = xVar(gnd_Site_SDSPM, "Site_D2_AucunSDSRDV", "")
	End If
	
	FPNav_SauvegarderDocument = True
FinSub:
	Exit Function
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Function
End Function

</lotusscript></code><code event="FPNav_PostOpen"><lotusscript>Sub FPNav_PostOpen(pnuid_Source As Notesuidocument)
	On Error Goto GererErreur
	
	' Initialisations
	Call SDSPN_Initialisations
	Call SDSPM_Initialisations
	
	If pnuid_Source.Editmode Then
		On Error 4412 Resume Next
		Call pnuid_Source.Refresh
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
	
End Sub

</lotusscript></code><code event="FPNav_hsFermer"><lotusscript>Sub FPNav_hsFermer
	On Error Goto GererErreur
	
	' Sauvegarder l'étape courante
	If FPNav_SauvegarderDocument("") Then
		' Fermer le masque courant
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acWorkflow"><lotusscript>Sub FPNav_acWorkflow(p_Statut As String)
	On Error GoTo GererErreur
		
	If SDSPM_acWorkflow(p_Statut) Then
		
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		Call gnuiws_SDSPM.ViewRefresh
		
		' Ouvrir le masque	
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		
		gnd_SDSPM.PNav_Titre =  Trim("C" &amp; CStr(xVar(gnd_Prop_SDSPM, "Prop_NbProposition", "- -")) &amp; " " &amp; xVar(gnd_Prop_SDSPM, "Prop_ClientNomInterne", xVar(gnd_Prop_SDSPM, "Prop_ClientNom", "")))
		gnd_SDSPM.Titre =  Trim(xVar(gnd_SDSPM, "PNav_Titre", "") &amp; " - " &amp; xVar(gnd_SDSPM, "PNav_MenuDesc000", ""))
				
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbProposition", xVar(gnd_Prop_SDSPM, "Prop_NbProposition", 0))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionFmt", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionFmt", ""))
		Call SDSPM_MajItemValeur(gnd_SDSPM, "Prop_NbPropositionPrefixe", xVar(gnd_Prop_SDSPM, "Prop_NbPropositionPrefixe", ""))		
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
		
		Call gnuid_SDSPN.Refresh
	End If
		
	Exit Sub
		
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acSignerProposition"><lotusscript>Sub FPNav_acSignerProposition
	On Error GoTo GererErreur
	
	If SDSPUI_acSignerProposition(gnd_Prop_SDSPM, xVar(gnd_SDSPM, "PNav_EditMode", "") &lt;&gt; "1") Then
		gnd_SDSPM.SaveOptions = "0"
		Call gnuid_SDSPN.Close
		
		Call gnuiws_SDSPM.ViewRefresh
		
		If SDSPWF_EditMode(gnd_Prop_SDSPM) Then
			gnd_SDSPM.PNav_EditMode = 1
		Else
			gnd_SDSPM.PNav_EditMode = 0
			gnd_SDSPM.SaveOptions = "0"
		End If
		Call SDSPN_OuvrirMasque(Format(CInt(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000")), "000"), False)
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, GetThreadInfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_acRecalculerCouts"><lotusscript>Sub FPNav_acRecalculerCouts
' -------------------------------------------------
' Le script permet au directeur de modifier le prix
' -------------------------------------------------
	On Error Goto GererErreur
	
	' Sauvegarder le document courante
	If Not FPNav_SauvegarderDocument("") Then
		Exit Sub
	End If
	
	Call SDSPM_acRecalculerCouts(gnd_Prop_SDSPM, False, False)
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsOuvrirMasque"><lotusscript>Sub FPNav_hsOuvrirMasque(p_NoItem As String)
	On Error Goto GererErreur
	
	Dim v_MenuItemCourant As String
	Dim v_ValiderDocument As Boolean
	Dim a_MenuItems As Variant
	Dim v_NoItem As String
	Dim i As Variant
	
	v_MenuItemCourant = xVar(gnd_SDSPM, "PNav_MenuItemCourant", "")
	a_MenuItems = xVarArray(gnd_SDSPM, "PNav_MenuItems")
	
	v_ValiderDocument = False
	
	' Si clique sur menu item qui est lui même, ne rien faire
	If v_MenuItemCourant = p_NoItem Then
		Exit Sub
	End If
	
	If p_NoItem = "**" Then
		v_NoItem = xVar(gnd_SDSPM, "PNav_MenuOptionMax", "")
		If a_MenuItems(Cint(v_MenuItemCourant)) = v_NoItem Then
			Exit Sub
		End If
		i = Arraygetindex(a_MenuItems, xVar(gnd_SDSPM, "PNav_MenuOptionMax", "0.00"))
		If Not Isnull(i) Then
			v_NoItem = Cstr(i)
		End If
		
	Else
		v_NoItem = p_NoItem
	End If
	
	If Not Isnull(i) Then
		v_ValiderDocument = (xVar(gnd_SDSPM, "PNav_MenuProc" &amp; v_MenuItemCourant, "") = "1" And Cint(v_NoItem) &gt; Cint(v_MenuItemCourant))
	End If
	
	' Sauvegarder le document courante
	If FPNav_SauvegarderDocument(v_ValiderDocument) Then
		
		' Construire le menu
		If Not Isnull(i) Then
			If (xVar(gnd_SDSPM, "PNav_MenuProc" &amp; v_MenuItemCourant, "") = "1" And Cint(v_NoItem) &lt; Cint(v_MenuItemCourant)) Then
				Call SDSPN_ConstruireMenu(gnd_SDSPM)
				Call gnuid_SDSPM.Refresh
			End If
		Else
			Call SDSPN_ConstruireMenu(gnd_SDSPM)
			Call gnuid_SDSPM.Refresh
		End If
		
		' Ouvrir le masque suivant
		Call SDSPN_OuvrirMasqueMenu(p_NoItem)
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

</lotusscript></code><code event="FPNav_hsPrecedent"><lotusscript>Sub FPNav_hsPrecedent
	On Error Goto GererErreur
	
	Dim a_MenuItems As Variant
	Dim i As Variant
	
	' Sauvegarder le document courante
	If FPNav_SauvegarderDocument(False) Then
		
		' Si document valide = false
		a_MenuItems = xVarArray(gnd_SDSPM, "PNav_MenuItems")
		
		' Validation
		If Not Isarray(a_MenuItems) Then
			Messagebox "Erreur de navigation (P1)", 16, "Opération annulée"
			Exit Sub
		End If
		i = Cint(xVar(gnd_SDSPM, "PNav_MenuItemCourant", "000"))
		If Isnull(i) Then
			Messagebox "Erreur de navigation (P2)", 16, "Opération annulée"
			Exit Sub
		Elseif i = 0 Then
			Messagebox "Erreur de navigation (P3)", 16, "Opération annulée"
			Exit Sub
		End If
		
		'gnd_SDSPM.PNav_MenuOptionMax = xVar(gnd_SDSPM, "PNav_MenuOptionCourante", "")
		Call SDSPN_ConstruireMenu(gnd_SDSPM)
		
		' Ouvrir le masque précédent
		Call SDSPN_OuvrirMasquePrecedent
	End If
	
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_FPNav, gc_Element_FPNav, Getthreadinfo(1), xVar(gnd_SDSPM, "Cle", ""), False)
	Exit Sub
End Sub

