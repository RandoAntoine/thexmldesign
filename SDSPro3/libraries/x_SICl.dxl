<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_SICl" ou "SICl" est 
'		l'identifiant de la base de documents.
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "SICl" par l'identifiant de la base de documents.  
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "Clie" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xSICl As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_SICl As NotesDocument
Dim gnv_Tabl_xSICl As Notesview
Dim gnd_Tabl_xSICl As Notesdocument
Dim gnv_Clie_xSICl As Notesview					' La vue d'ou est extrait le document
Dim gnd_Clie_xSICl As Notesdocument			' Le document qui contient les informations recherchées
Dim gnv_Clie23_xSICl As NotesView					' La vue d'ou est extrait le document
Dim gnd_GCli_xSICl As Notesdocument			' Le document qui contient les informations recherchées
Dim gnv_GCli20_xSICl As NotesView					' La vue d'ou est extrait le document

' Section 3 - Les constantes à définir
Const gc_NomBD_xSICl = "SICl"		' Inscrire le nom usuel de la base de documents
																' de recherche, tel que déclaré dans le GDK.
Const gc_NomItemCleClie_xSICl = "Clie_ClientNoFmt"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueClie_xSICl = "V_Clie20"		' Le nom de la vue de recherche
Const gc_NomItemCleGCli_xSICl = "GCli_NoGroupe"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueGCli20_xSICl = "V_GCli20"		' Le nom de la vue de recherche

</lotusscript></code><code event="xSICl_xVarProf"><lotusscript>Function xSICl_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xSICl_Initialisation
	
	' Extraire le document de profil
	If gnd_Prof_SICl Is Nothing Then
		Set gnd_Prof_SICl = gndb_xSICl.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_SICl Is Nothing Then
		xSICl_xVarProf = p_ValeurNulle
	Else
		xSICl_xVarProf = xVar(gnd_Prof_SICl, p_NomVar, p_ValeurNulle)		
	End If
End Function

</lotusscript></code><code event="xSICl_xValeurExisteTabl"><lotusscript>Function xSICl_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xSICl_xValeurExisteTabl = False
	
	If Not (xSICl_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gnd_Tabl_xSICl.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xSICl_xValeurExisteTabl = True
		End If
	End If	
End Function

</lotusscript></code><code event="xSICl_xDescTabl"><lotusscript>Function xSICl_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSICl_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSICl_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSICl_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSICl_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSICl_xDescTabl = v_Descriptions(0)
			Else
				xSICl_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSICl_xIcnTabl"><lotusscript>Function xSICl_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xSICl_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xSICl_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xSICl_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xSICl_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xSICl_xIcnTabl = v_Icones(0)
			Else
				xSICl_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSICl_xndClie"><lotusscript>Function xSICl_xndClie(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSICl_Initialisation
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleClie_xSICl, p_Cle, p_Cache, gndb_xSICl, gc_NomVueClie_xSICl, gnv_Clie_xSICl, gnd_Clie_xSICl)
	
	' Retourne le document défini en variable globale
	Set xSICl_xndClie = gnd_Clie_xSICl
End Function

</lotusscript></code><code event="xSICl_xVarClie"><lotusscript>Function xSICl_xVarClie(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSICl_xndClie(p_Cle, p_Cache)
	xSICl_xVarClie = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSICl_xndTabl"><lotusscript>Function xSICl_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xSICl_Initialisation
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xSICl, "V_Tabl20", gnv_Tabl_xSICl, gnd_Tabl_xSICl)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xSICl_xndTabl = gnd_Tabl_xSICl
End Function

</lotusscript></code><code event="xSICl_xVarTabl"><lotusscript>Function xSICl_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSICl_xndTabl(pCle, pCache)
	xSICl_xVarTabl = xVar(nd, pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xSICl_Initialisation"><lotusscript>Sub xSICl_Initialisation
	' Initialisation des variables globales
	If gndb_xSICl Is Nothing Then
		Set gndb_xSICl = xGDK_xndbNDB(gc_NomBD_xSICl)
	End If
End Sub

</lotusscript></code><code event="xSICl_xndClie_NoTel"><lotusscript>Function xSICl_xndClie_NoTel(Byval p_Cle As Variant) As NotesDocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSICl_Initialisation
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("", p_Cle, False, gndb_xSICl, gc_NomVueClie_xSICl, gnv_Clie_xSICl, gnd_Clie_xSICl)
	
	' Retourne le document défini en variable globale
	Set xSICl_xndClie_NoTel = gnd_Clie_xSICl
End Function
</lotusscript></code><code event="xSICl_xndGCli"><lotusscript>Function xSICl_xndGCli(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSICl_Initialisation
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleGCli_xSICl, Clng(p_Cle), p_Cache, gndb_xSICl, gc_NomVueGCli20_xSICl, gnv_GCli20_xSICl, gnd_GCli_xSICl)
	
	' Retourne le document défini en variable globale
	Set xSICl_xndGCli = gnd_GCli_xSICl
End Function

</lotusscript></code><code event="xSICl_xVarGCli"><lotusscript>Function xSICl_xVarGCli(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSICl_xndGCli(p_Cle, p_Cache)
	xSICl_xVarGCli = xVar(nd, p_NomVar, p_ValeurNulle)
End Function</lotusscript></code>
