<updatedby><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_SDSCSL" ou "SDSCSL" est 
'		l'identifiant de la base de documents (GDK).
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "AAAA" par l'identifiant de la base de documents.  
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "BBBB" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xSDSCSL As NotesDatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_SDSCSL As NotesDocument
Dim gnvTabl_xSDSCSL As NotesView
Dim gndTabl_xSDSCSL As NotesDocument
Dim gnv_CSCo_xSDSCSL As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSCo_xSDSCSL As NotesDocument			' Le document qui contient les informations recherchées
Dim gnv_CSCo_Client_xSDSCSL As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSCo_Client_xSDSCSL As NotesDocument			' Le document qui contient les informations recherchées

Dim gnv_CSPr21_xSDSCSL As NotesView
Dim gnv_CSPr30_xSDSCSL As NotesView					' La vue d'ou est extrait le document
Dim gnd_CSPr30_xSDSCSL As NotesDocument			' Le document qui contient les informations recherchées

'Dim gnv_CSLCo_Client_xSDSCSL As NotesView					' La vue d'ou est extrait le document
'Dim gnd_CSLCo_Client_xSDSCSL As NotesDocument			' Le document qui contient les informations recherchées
'Dim gnv_CSLFa_xSDSCSL As NotesView					' La vue d'ou est extrait le document
'Dim gnd_CSLFa_xSDSCSL As NotesDocument			' Le document qui contient les informations recherchées
'Dim gnv_CSLPr_xSDSCSL As NotesView					' La vue d'ou est extrait le document
'Dim gnd_CSLPr_xSDSCSL As NotesDocument			' Le document qui contient les informations recherchées


' Section 3 - Les constantes à définir
Const gc_NomBD_xSDSCSL = "SDSCSL"		' Inscrire le nom usuel de la base de documents
																' de recherche, tel que déclaré dans le GDK.
Const gc_NomItemCleCSCo_xSDSCSL = "CSCo_NoContratFmt"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueCSCo_xSDSCSL = "V_CSCo20"		' Le nom de la vue de recherche
Const gc_NomItemCleCSCo_Client_xSDSCSL = "CSCo_ClientNoFmt"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueCSCo_Client_xSDSCSL = "V_CSCo12"		' Le nom de la vue de recherche
Const gc_NomVueCSPr30_xSDSCSL = "V_CSPr30"		' Le nom de la vue de recherche

'Const gc_NomItemCleCSLCo_Client_xSDSCSL = "CSCo_ClientNoFmt"	' Le nom de l'item servant de clé (selon la vue de recherche)
'Const gc_NomVueCSLCo_Client_xSDSCSL = "V_CSCo12"		' Le nom de la vue de recherche
'Const gc_NomItemCleCSLFa_xSDSCSL = "CSFa_NoContrat"	' Le nom de l'item servant de clé (selon la vue de recherche)
'Const gc_NomVueCSLFa_xSDSCSL = "V_CSFa20"		' Le nom de la vue de recherche
'Const gc_NomVueCSLPr_xSDSCSL = "V_CSPr30"		' Le nom de la vue de recherche



</lotusscript></code><code event="xSDSCSL_xVarProf"><lotusscript>Function xSDSCSL_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xSDSCSL_Initialisations
	
	' Extraire le document de profil
	If gnd_Prof_SDSCSL Is Nothing Then
		Set gnd_Prof_SDSCSL = gndb_xSDSCSL.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_SDSCSL Is Nothing Then
		xSDSCSL_xVarProf = p_ValeurNulle
	Else
		xSDSCSL_xVarProf = xVar(gnd_Prof_SDSCSL, p_NomVar, p_ValeurNulle)		
	End If
End Function

</lotusscript></code><code event="xSDSCSL_xDescTabl"><lotusscript>Function xSDSCSL_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSDSCSL_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSDSCSL_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSDSCSL_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSDSCSL_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSDSCSL_xDescTabl = v_Descriptions(0)
			Else
				xSDSCSL_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSCSL_xndTabl"><lotusscript>Function xSDSCSL_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xSDSCSL_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xSDSCSL, "V_Tabl20", gnvTabl_xSDSCSL, gndTabl_xSDSCSL)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xSDSCSL_xndTabl = gndTabl_xSDSCSL
End Function


</lotusscript></code><code event="xSDSCSL_xndcCSPr"><lotusscript>Function xSDSCSL_xndcCSPr (ByVal p_NoClientFmt As Variant, p_CleProduit ) As NotesDocumentCollection
	' Cette fonction retourne une collection de documents du type approprié.
	' 
	
	Dim a_Cle(1) As String
	
	' Initialisation des variables globales	
	Call xSDSCSL_Initialisations
	
	Call xnv(gndb_xSDSCSL, "V_XXPr21", gnv_CSPr21_xSDSCSL)

	If p_CleProduit = "" then
	
		'Si nécéssaire, extraire le document qui contient la variable recherchée.
		Set xSDSCSL_xndcCSPr = gnv_CSPr21_xSDSCSL.GetAllDocumentsByKey(p_NoClientFmt, True)
		
	Else
		
		a_Cle(0) = p_NoClientFmt
		a_Cle(1) = p_CleProduit  
		
		Set xSDSCSL_xndcCSPr = gnv_CSPr21_xSDSCSL.GetAllDocumentsByKey(a_Cle, True)
		
	End If
	
End Function

</lotusscript></code><code event="xSDSCSL_xndCSCo"><lotusscript>Function xSDSCSL_xndCSCo(ByVal p_Cle As Variant, ByVal p_Cache As Integer) As NotesDocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSDSCSL_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleCSCo_xSDSCSL, p_Cle, p_Cache, gndb_xSDSCSL, gc_NomVueCSCo_xSDSCSL, gnv_CSCo_xSDSCSL, gnd_CSCo_xSDSCSL)
	
	' Retourne le document défini en variable globale
	Set xSDSCSL_xndCSCo = gnd_CSCo_xSDSCSL
End Function

</lotusscript></code><code event="xSDSCSL_xVarCSCo"><lotusscript>Function xSDSCSL_xVarCSCo(ByVal p_Cle As Variant, ByVal p_NomVar As String, ByVal p_ValeurNulle As Variant, _
ByVal p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSDSCSL_xndCSCo(p_Cle, p_Cache)
	xSDSCSL_xVarCSCo = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSDSCSL_xVarTabl"><lotusscript>Function xSDSCSL_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	Set nd = xSDSCSL_xndTabl(pCle, pCache)
	xSDSCSL_xVarTabl = xVar(nd, pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function


</lotusscript></code><code event="xSDSCSL_xValeurExisteTabl"><lotusscript>Function xSDSCSL_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xSDSCSL_xValeurExisteTabl = False
	
	If Not (xSDSCSL_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gndTabl_xSDSCSL.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xSDSCSL_xValeurExisteTabl = True
		End If
	End If	
End Function

</lotusscript></code><code event="xSDSCSL_xIcnTabl"><lotusscript>Function xSDSCSL_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xSDSCSL_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xSDSCSL_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xSDSCSL_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xSDSCSL_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xSDSCSL_xIcnTabl = v_Icones(0)
			Else
				xSDSCSL_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSCSL_Initialisations"><lotusscript>Sub xSDSCSL_Initialisations
	' Initialisation des variables globales
	If gndb_xSDSCSL Is Nothing Then
		Set gndb_xSDSCSL = xGDK_xndbNDB(gc_NomBD_xSDSCSL)
	End If
End Sub

</lotusscript></code><code event="xSDSCSL_xndcCSCo_Client"><lotusscript>Function xSDSCSL_xndcCSCo_Client(ByVal p_Cle As Variant) As NotesDocumentCollection
	' Cette fonction retourne une collection de documents du type approprié.
	
	' Initialisation des variables globales
	Call xSDSCSL_Initialisations
	
	' Retourne la collection
	Set xSDSCSL_xndcCSCo_Client = xndc(p_Cle, gndb_xSDSCSL, gc_NomVueCSCo_Client_xSDSCSL, gnv_CSCo_Client_xSDSCSL)
End Function


</lotusscript></code><code event="xSDSCSL_xndCSCo_Client"><lotusscript>Function xSDSCSL_xndCSCo_Client(ByVal p_Cle As Variant, ByVal p_Cache As Integer) As NotesDocument	
	' Cette fonction retourne le contrat de service actif du client.
	
	' Initialisation des variables globales
	Call xSDSCSL_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleCSCo_Client_xSDSCSL, p_Cle, p_Cache, gndb_xSDSCSL, gc_NomVueCSCo_Client_xSDSCSL, _
	gnv_CSCo_Client_xSDSCSL, gnd_CSCo_Client_xSDSCSL)
	
	' Retourne le document défini en variable globale
	Set xSDSCSL_xndCSCo_Client = gnd_CSCo_Client_xSDSCSL
End Function

</lotusscript></code><code event="xSDSCSL_xndCSPr_Cle"><lotusscript>Function xSDSCSL_xndCSPr_Cle(ByVal p_NoContratFmt As String, ByVal p_CleProduit As String) As NotesDocument	
	' Cette fonction retourne un document du type approprié.
	
	Dim v_Cle(1) As String
	
	' Initialisation des variables globales
	Call xSDSCSL_Initialisations
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	v_Cle(0) = p_NoContratFmt
	v_Cle(1) = p_CleProduit
	Call xnd("", v_Cle, False, gndb_xSDSCSL, gc_NomVueCSPr30_xSDSCSL, gnv_CSPr30_xSDSCSL, gnd_CSPr30_xSDSCSL)
	
	' Retourne le document défini en variable globale
	Set xSDSCSL_xndCSPr_Cle = gnd_CSPr30_xSDSCSL
End Function


</lotusscript></code><code event="xSDSCSL_xVarCSPr_Cle"><lotusscript>Function xSDSCSL_xVarCSPr_Cle(ByVal p_NoContratFmt As String, ByVal p_CleProduit As String, ByVal p_NomVar As String, ByVal p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSDSCSL_xndCSPr_Cle(p_NoContratFmt, p_CleProduit)
	xSDSCSL_xVarCSPr_Cle = xVar(nd, p_NomVar, p_ValeurNulle)
End Function
</lotusscript></code>
