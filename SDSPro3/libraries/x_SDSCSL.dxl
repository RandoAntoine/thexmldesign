<database xmlns="http://www.lotus.com/dxl" version="11.0" maintenanceversion="1.8" replicaid="85257E4600665675" path="CN=Kilo/O=Serti Informatique!!Interne\SDS\sds_propositions3.nsf" title="SDS Pro III" fromtemplate="TMP SDS Pro III 11.9b" allowstoredforms="false" multilingual="true" maintainunread="false" increasemaxfields="true" defaultlanguage="fr"><scriptlibrary name="x_SDSCSL" hide="v3 v4strict" designerversion="8.5.3" comment="1.2 SDS Contrats de service local">
<noteinfo noteid="555772" unid="F249A1F049161103852586B40011FBA8" sequence="87">
<created><datetime dst="true">20210410T231625,36-04</datetime></created>
<modified><datetime>20260105T014837,47-05</datetime></modified>
<revised><datetime>20250319T073637,81-05</datetime></revised>
<lastaccessed><datetime>20260105T014837,46-05</datetime></lastaccessed>
