Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Declare
Use "SI_Extractions"
Use "x_GDK"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire ne se trouvent pas dans la base de documents courante.  Il faut rechercher la base de documents
' à utiliser dans le GDK.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être "x_SDSC3" ou "SDSC3" est 
'		l'identifiant de la base de documents.
'	2.	Inscrire le nom usuel de la base de documents de recherche, le nom de l'item qui contient
'		la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de "SDSC3" par l'identifiant de la base de documents.  
'		Les subs seront automatiquement renommés.
'	4.	Remplacer toutes les occurences de "Prop" par l'identifiant du type de document.  
'		Les subs seront automatiquement renommés.

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xELrod
Dim gndb_xSDSC3 As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnd_Prof_SDSC3 As NotesDocument
Dim gnvTabl_xSDSC3 As Notesview
Dim gndTabl_xSDSC3 As NotesDocument
Dim gnv_Prop_xSDSC3 As NotesView				' La vue d'où est extrait le document
Dim gnd_Prop_xSDSC3 As NotesDocument			' Le document qui contient les informations recherchées


Dim gnv_Site_xSDSC3 As NotesView				' La vue d'où est extrait le document
Dim gnd_Site_xSDSC3 As NotesDocument

Dim gnv_Succ11_xSDSC3 As NotesView
Dim gnv_Prop20_xSDSC3 As NotesView


' Section 3 - Les constantes à définir
Const gc_NomBD_xSDSC3 = "SDSC3"			' Inscrire le nom de la base de documents, tel que déclaré dans le GDK.
Const gc_NomItemCleProp_xSDSC3 = "Prop_NoProposition"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVueProp_xSDSC3 = "V_Prop20"		' Le nom de la vue de recherche

Const gc_NomItemCleSite_xSDSC3 = "Site_NoSite"
Const gc_NomVueSite_xSDSC3 = "V_Site20"		' Le nom de la vue de recherche



</lotusscript></code><code event="xSDSC3_xValeurExisteTabl"><lotusscript>Function xSDSC3_xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xSDSC3_xValeurExisteTabl = False
	
	If Not (xSDSC3_xndTabl(p_Cle, True) Is Nothing) Then
		Set ni = gndTabl_xSDSC3.GetFirstItem("Tabl_Valeurs")
		If ni.Contains(p_Valeur) Then
			xSDSC3_xValeurExisteTabl = True
		End If
	End If	
End Function

</lotusscript></code><code event="xSDSC3_xndcSite"><lotusscript>Function xSDSC3_xndcSite(ByVal p_Cle As Variant) As NotesDocumentCollection
	' Cette fonction retourne une collection de documents du type approprié.
	
	' Initialisation des variables globales
	Call xSDSC3_Initialisation
	Call xnv(gndb_xSDSC3, "V_Succ11", gnv_Succ11_xSDSC3)
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Set xSDSC3_xndcSite = gnv_Succ11_xSDSC3.GetAllDocumentsByKey(p_Cle, True)
	
End Function

</lotusscript></code><code event="xSDSC3_xVarTabl"><lotusscript>Function xSDSC3_xVarTabl(Byval pCle As Variant, Byval pNomVar As String, Byval pValeurNulle As Variant, _
Byval pCache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document de type F_Tabl.
	
	' Extraire la variable recherchée du document retourné par la fonction xndYYY)
	xSDSC3_xVarTabl = xVar(xSDSC3_xndTabl(pCle, pCache), pNomVar, pValeurNulle)
	'	Paramètres:		1	Notesdocument.  Le document contenant la valeur recherchée.
	'							** Appel de la fonction d'extraction du document **
	'						2	String.  Le nom de la variable contenant la valeur recherchée.  ** Ne pas modifier **
	'						3	Variant.  La valeur à retourner si la variable recherchée n'existe pas dans le document
	'							recherché.  ** Ne pas modifier **
End Function

</lotusscript></code><code event="xSDSC3_xndSite"><lotusscript>Function xSDSC3_xndSite(ByVal p_Cle As Variant, ByVal p_Cache As Integer) As NotesDocument	
	' Cette fonction retourne un document du type apSiterié.
	
	' Initialisation des variables globales
	Call xSDSC3_Initialisation
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleSite_xSDSC3, p_Cle, p_Cache, gndb_xSDSC3, gc_NomVueSite_xSDSC3, gnv_Site_xSDSC3, gnd_Site_xSDSC3)
	
	' Retourne le document défini en variable globale
	Set xSDSC3_xndSite = gnd_Site_xSDSC3
	
End Function

</lotusscript></code><code event="xSDSC3_xDescTabl"><lotusscript>Function xSDSC3_xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSDSC3_xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSDSC3_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSDSC3_xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSDSC3_xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSDSC3_xDescTabl = v_Descriptions(0)
			Else
				xSDSC3_xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSC3_Initialisation"><lotusscript>Sub xSDSC3_Initialisation
	' Initialisation des variables globales
	If gndb_xSDSC3 Is Nothing Then
		Set gndb_xSDSC3 = xGDK_xndbNDB(gc_NomBD_xSDSC3)
	End If
End Sub

</lotusscript></code><code event="xSDSC3_xndProp"><lotusscript>Function xSDSC3_xndProp(ByVal p_Cle As Variant, ByVal p_Cache As Integer) As NotesDocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call xSDSC3_Initialisation
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCleProp_xSDSC3, p_Cle, p_Cache, gndb_xSDSC3, gc_NomVueProp_xSDSC3, gnv_Prop_xSDSC3, gnd_Prop_xSDSC3)
	
	' Retourne le document défini en variable globale
	Set xSDSC3_xndProp = gnd_Prop_xSDSC3
End Function

</lotusscript></code><code event="xSDSC3_xVarProp"><lotusscript>Function xSDSC3_xVarProp(ByVal p_Cle As Variant, ByVal p_NomVar As String, ByVal p_ValeurNulle As Variant, _
ByVal p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	Dim nd As NotesDocument
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	Set nd = xSDSC3_xndProp(p_Cle, p_Cache)
	xSDSC3_xVarProp = xVar(nd, p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="xSDSC3_xndTabl"><lotusscript>Function xSDSC3_xndTabl(Byval pCle As Variant, Byval pCache As Integer) As Notesdocument
	' Cette fonction retourne un document de type F_Tabl.
	
	' Initialisation des variables globales
	Call xSDSC3_Initialisation
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd("Tabl_Nom", pCle, pCache, gndb_xSDSC3, "V_Tabl20", gnvTabl_xSDSC3, gndTabl_xSDSC3)
	'	Paramètres:		1	String.  Le nom du champs servant de clé dans le document recherché.
	'						2	Variant.  La valeur de la clé recherchée. ** Ne pas modifier **
	'						3	Boolean.  Indiquer True pour réutiliser le document en mémoire lorsqu'il correspond
	'							au document recherché.  Si vous indiquez False, le document est relu même s'il est
	'							déjà en mémoire. ** Ne pas modifier **
	'						4	Notesdatabase. La base de documents dans laquelle le document sera recherché.
	'							** Déclarée dans les variables globales **
	'						5	String.  Le nom de la vue de recherche.
	'						6	Notesview.  La vue de recherche. ** Déclarée dans les variables globales **
	'							
	'						7	Notesdocument.  Le document recherché.  S'il est déjà en mémoire et que Cache
	'							contient True, le document envoyé sera retourné.
	'							** Déclarée dans les variables globales **
	
	' Retourne le document défini en variable globale
	Set xSDSC3_xndTabl = gndTabl_xSDSC3
End Function

</lotusscript></code><code event="xSDSC3_xIcnTabl"><lotusscript>Function xSDSC3_xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Integer	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xSDSC3_xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xSDSC3_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xSDSC3_xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xSDSC3_xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xSDSC3_xIcnTabl = v_Icones(0)
			Else
				xSDSC3_xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSC3_xndcProp"><lotusscript>Function xSDSC3_xndcProp(ByVal p_Cle As Variant) As NotesDocumentCollection
	' Cette fonction retourne une collection de documents du type approprié.
	
	' Initialisation des variables globales
	Call xSDSC3_Initialisation
	
	Call xnv(gndb_xSDSC3, "V_Prop20", gnv_Prop20_xSDSC3)

		
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Set xSDSC3_xndcProp = gnv_Prop20_xSDSC3.GetAllDocumentsByKey(p_Cle, True)
	
End Function</lotusscript></code>
