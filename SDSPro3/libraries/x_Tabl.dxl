ue/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Patrick Beauchamp/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Mark Knollin/OU=Reseautique/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Emmanuelle Beauchamp/OU=SDS/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name><name>CN=Patrick Juneau/O=Serti Informatique</name><name>CN=Developpement Serti/O=Serti Informatique</name></updatedby>
<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Explicit
Use "SI_Extractions"
'
' Cette bibliothèque de script permet d'extraire un document ou un item d'un document.  Les documents
' à extraire se trouvent dans la base de documents courante.
'
' Instructions
'	1.	Renommer le script library.  Le nouveau nom devrait être x_Tabl ou Tabl est le type de document.
'	2.	Inscrire le nom de l'item qui contient la clé et le nom de la vue de recherche dans la section (Declarations).
'	3.	Remplacer toutes les occurences de Tabl par l'identifiant du type de document.  Les subs seront 
'		automatiquement renommés.

</lotusscript></code><code event="declarations"><lotusscript>' Section 1 - Paramètres de la session - Définis dans le sub Initialisation_xTabl
Dim gns_xTabl As Notessession
Dim gndb_xTabl As Notesdatabase

' Section 2 - Définition des valeurs conservées dans la cache
Dim gnv_xTabl As Notesview				' La vue d'ou est extrait le document
Dim gnd_xTabl As Notesdocument		' Le document qui contient les informations recherchées

' Section 3 - Les constantes à définir
Const gc_NomItemCle_xTabl = "Tabl_Nom"	' Le nom de l'item servant de clé (selon la vue de recherche)
Const gc_NomVue_xTabl = "V_Tabl20"		' Le nom de la vue de recherche

</lotusscript></code><code event="xDescTabl"><lotusscript>Function xDescTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xDescTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xVarTabl(p_Table, "Tabl_Descriptions", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xDescTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xDescTabl = v_Descriptions(0)
			Else
				xDescTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xIcnTabl"><lotusscript>Function xIcnTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_Cache As Integer) As Variant	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Icones As Variant
	Dim i As Long
	
	xIcnTabl = 0
	
	' Extraire les valeurs et les Icones
	v_Valeurs = xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Icones = xVarTabl(p_Table, "Tabl_Icones", "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Icones) Then
					If i &gt;= Lbound(v_Icones) And i &lt;= Ubound(v_Icones) Then
						xIcnTabl = v_Icones(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Icones) Then
				xIcnTabl = v_Icones(0)
			Else
				xIcnTabl = v_Icones
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xndTabl"><lotusscript>Function xndTabl(Byval p_Cle As Variant, Byval p_Cache As Integer) As Notesdocument	
	' Cette fonction retourne un document du type approprié.
	
	' Initialisation des variables globales
	Call Initialisation_xTabl
	
	' Si nécéssaire, extraire le document qui contient la variable recherchée.
	Call xnd(gc_NomItemCle_xTabl, p_Cle, p_Cache, gndb_xTabl, gc_NomVue_xTabl, gnv_xTabl, gnd_xTabl)
	
	' Retourne le document défini en variable globale
	Set xndTabl = gnd_xTabl
End Function

</lotusscript></code><code event="xVarTabl"><lotusscript>Function xVarTabl(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
Byval p_Cache As Integer) As Variant
	' Cette fonction retourne la valeur d'une variable d'un document.
	
	' Extraire la variable recherchée du document retourné par la fonction xnd)
	xVarTabl = xVar(xndTabl(p_Cle, p_Cache), p_NomVar, p_ValeurNulle)
End Function

</lotusscript></code><code event="Initialisation_xTabl"><lotusscript>Sub Initialisation_xTabl
	' Initialisation des variables globales
	If gns_xTabl Is Nothing Then
		Set gns_xTabl = New Notessession
		Set gndb_xTabl = gns_xTabl.Currentdatabase
	End If
End Sub

</lotusscript></code><code event="xComplTabl"><lotusscript>Function xComplTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_NoComplement As String, _
Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xComplTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xVarTabl(p_Table, "Tabl_Complement" &amp; p_NoComplement, "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xComplTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xComplTabl = v_Descriptions(0)
			Else
				xComplTabl = v_Descriptions
			End If
		End If
	End If
End Function


</lotusscript></code><code event="xValeurExisteTabl"><lotusscript>Function xValeurExisteTabl(Byval p_Cle As Variant, p_Valeur As Variant, _
Byval p_Cache As Integer) As Integer
	Dim ni As NotesItem
	
	xValeurExisteTabl = False
	
	If Not (xndTabl(p_Cle, True) Is Nothing) Then
		If gnd_xTabl.HasItem("Tabl_Valeurs") Then
			Set ni = gnd_xTabl.GetFirstItem("Tabl_Valeurs")
			xValeurExisteTabl = ni.Contains(p_Valeur)
		End If	
	End If
End Function</lotusscript></code>
