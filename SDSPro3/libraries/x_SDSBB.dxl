</lotusscript></code><code event="xSDSBB_xTypMLProd"><lotusscript>Function xSDSBB_xTypMLProd(Byval p_Cle As Variant,Byval p_VersionSDS As String) As String
	'---------------------------------------------------------------------------------------------------------------------
	'Cette fonction permet d'extraire le type de média à utiliser pour le programme en question.
	'Parametres:  		p_Cle ---&gt; Nom du programme (logiciel) de SDS Base (LPDBMM)
	'							p_VersionSDS ----&gt; La version SDS utilisée chez le client (Provient de CSA)
	'Retourne le type de média qui correspond à la version SDS pour cette distribution 
	'pour ce programme
	'-----------------------------------------------------------------------------------------------------------------------
	
	Dim nd_Logiciel As NotesDocument
	Dim a_LProdVersion As Variant
	Dim a_LProdTypeMedia As Variant
	Dim i As Integer
	
	'Initialisation des variables globales
	Call xSDSBB_Initialisations
	xSDSBB_xTypMLProd = "Internet"
	
	'Extraire la liste des versions et les médias qui y correspondent
	Set nd_Logiciel = xSDSBB_xndProd_Code(p_Cle, True)
	a_LProdVersion = xVarArray(nd_Logiciel, "Prod_MediaVersions")
	a_LProdTypeMedia = xVarArray(nd_Logiciel, "Prod_MediaTypes")
	
	If Isarray(a_LProdVersion) And Isarray(a_LProdTypeMedia) Then
		If Ubound(a_LProdVersion) &lt;&gt; Ubound(a_LProdTypeMedia) Then
			Exit Function
		End If
		
		'Boucler jusqu'à ce qu'on ait trouvé l'emplacement de la version de SDS de notre client
		For i = Ubound(a_LProdVersion) To 0 Step -1
			If p_VersionSDS &gt;= a_LProdVersion(i) Then
				'Retourner le type de média qui correspond à la version SDS
				xSDSBB_xTypMLProd = a_LProdTypeMedia(i)	
				Exit Function
			End If
		Next
	End If
End Function

</lotusscript></code><code event="xSDSBB_xndcProd_Comp"><lotusscript>Function xSDSBB_xndcProd_Comp(Byval p_Cle As Variant) As NotesDocumentCollection
	' Cette fonction retourne une collection des composants d'un produit.
	' p_Cle = CleProduit
	
	' Initialisation des variables globales
	Call xSDSBB_Initialisations
	
	If gnv_Comp20_xSDSBB Is Nothing Then
		Set gnv_Comp20_xSDSBB = gndb_xSDSBB.GetView("V_Comp20")
		Call gnv_Comp20_xSDSBB.Refresh
	End If
	
	' Retourne le document défini en variable globale
	Set xSDSBB_xndcProd_Comp = gnv_Comp20_xSDSBB.GetAllDocumentsByKey(p_Cle &amp; ";", False)
End Function


