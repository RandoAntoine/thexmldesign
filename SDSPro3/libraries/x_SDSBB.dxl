</lotusscript></code><code event="xSDSBB_xComplTabl"><lotusscript>Function xSDSBB_xComplTabl(Byval p_Cle As String, Byval p_Table As String, Byval p_NoComplement As String, _
Byval p_Cache As Integer) As String	
	' Cette fonction retourne la description d'un élément d'une table.
	
	Dim v_Valeurs As Variant
	Dim v_Descriptions As Variant
	Dim i As Long
	
	xSDSBB_xComplTabl = ""
	
	' Extraire les valeurs et les descriptions
	v_Valeurs = xSDSBB_xVarTabl(p_Table, "Tabl_Valeurs", "", True)
	v_Descriptions = xSDSBB_xVarTabl(p_Table, "Tabl_Complement" &amp; p_NoComplement, "", True)
	
	' S'il n'y a plusieurs valeurs, rechercher la valeur recherchée
	If Isarray(v_Valeurs) Then
		For i = Lbound(v_Valeurs) To Ubound(v_Valeurs)
			If v_Valeurs(i) = p_Cle Then
				If Isarray(v_Descriptions) Then
					If i &gt;= Lbound(v_Descriptions) And i &lt;= Ubound(v_Descriptions) Then
						xSDSBB_xComplTabl = v_Descriptions(i)
					End If
				End If
				
				Exit For
			End If
		Next
		
	' S'il n'y a qu'une valeur, et qu'elle correspond à la valeur recherchée, retourner la description
	Else
		If v_Valeurs = p_Cle Then
			If Isarray(v_Descriptions) Then
				xSDSBB_xComplTabl = v_Descriptions(0)
			Else
				xSDSBB_xComplTabl = v_Descriptions
			End If
		End If
	End If
End Function

</lotusscript></code><code event="xSDSBB_xVarAssignation"><lotusscript>Function xSDSBB_xVarAssignation(ByVal p_Cle As Variant, ByVal p_NomVar As String, ByVal p_ValeurNulle As Variant, _
