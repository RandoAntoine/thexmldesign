</lotusscript></code><code event="xSDSBB_xVarProf"><lotusscript>Function xSDSBB_xVarProf(Byval p_NomVar As String, Byval p_ValeurNulle As Variant) As Variant
	' Cette fonction retourne la valeur d'une variable du profil de la base de documents.
	
	' Initialisation des variables globales
	Call xSDSBB_Initialisations
	
	' Extraire le document de profil
	If gnd_Prof_SDSBB Is Nothing Then
		Set gnd_Prof_SDSBB = gndb_xSDSBB.Getprofiledocument("F_Prof")
	End If
	
	If gnd_Prof_SDSBB Is Nothing Then
		xSDSBB_xVarProf = p_ValeurNulle
	Else
		xSDSBB_xVarProf = xVar(gnd_Prof_SDSBB, p_NomVar, p_ValeurNulle)		
	End If
End Function

</lotusscript></code><code event="xSDSBB_xVarCate"><lotusscript>Function xSDSBB_xVarCate(Byval p_Cle As Variant, Byval p_NomVar As String, Byval p_ValeurNulle As Variant, _
