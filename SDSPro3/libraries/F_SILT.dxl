<wassignedby><name>CN=Developpement Serti/O=Serti Informatique</name></wassignedby><code event="options"><lotusscript>Option Public
Option Explicit
Use "SI_GestionErreurs"

'	Les fonctions définies dans cette bibliothèque de script permettent la gestion de tous les
'	opérations reliés au formulaire Lettre type | F_SILT.


</lotusscript></code><code event="declarations"><lotusscript>
' Traitement des erreurs
Const gc_TypeElement_SILT = "SL"
Const gc_Element_SILT = "F_SILT"

</lotusscript></code><code event="Postsave_SILT"><lotusscript>Sub Postsave_SILT(pnuid_Source As Notesuidocument)
	On Error Goto GererErreur
	
	Dim nd As Notesdocument
	Dim nrti As Notesrichtextitem
	Dim neo As NotesEmbeddedObject
	Dim nd_Temp As Notesdocument
	
	Dim v_aneo As Variant							' Array of NotesEmbeddedObjects
	Dim v_NomsLettres As Variant				' Array of strings
	Dim i As Long
	
	Set nd = pnuid_Source.Document
	
	' Vérification de la présence de l'item contenant les lettres et qu'il y a des lettres dans l'item
	Set nrti = nd.Getfirstitem("SILT_Lettres")
	If nrti Is Nothing Then
		Messagebox xGDK_xMessage("SI", 27, "", ""), 48, xGDK_xMessage("SI", 3, "", "")
		Call pnuid_Source.GotoField("SILT_Lettres")
		Exit Sub
	Elseif nrti.Type &lt;&gt; RICHTEXT Then
		Messagebox xGDK_xMessage("SI", 27, "", ""), 48, xGDK_xMessage("SI", 3, "", "")
		Call pnuid_Source.GotoField("SILT_Lettres")
	Elseif Isarray(nrti.Embeddedobjects) = False Then
		Messagebox xGDK_xMessage("SI", 28, "", ""), 48, xGDK_xMessage("SI", 3, "", "")
		Call pnuid_Source.GotoField("SILT_Lettres")
		Exit Sub				
	End If
	
	' Vérification du nombre de lettres vs le nombre de langues sélectionnées
	v_aneo = nrti.EmbeddedObjects
	If Ubound(v_aneo) &lt;&gt; Ubound(nd.SILT_Langues) Then
		Messagebox xGDK_xMessage("SI", 29, "", ""), 48, xGDK_xMessage("SI", 3, "", "")
		Call pnuid_Source.GotoField("SILT_Lettres")
		Exit Sub
	End If
	
	' Vérification de la présence de toutes les lettres déclarées (s'il y a plusieurs langues seulement)
	If Isarray(xVar(nd, "SILT_Langues", "")) Then
		v_NomsLettres = xVar(nd, "SILT_NomsLettres", "")
		If Isarray(v_NomsLettres) Then
			For i = Lbound(v_NomsLettres) To Ubound(v_NomsLettres)
				Set neo = nrti.Getembeddedobject(v_NomsLettres(i))
				If neo Is Nothing Then
					Messagebox xGDK_xMessage("SI", 30, "", v_NomsLettres(i)), 48, _
					xGDK_xMessage("SI", 3, "", "")
					Call pnuid_Source.GotoField("SILT_Lettres")
					Exit Sub
				End If
			Next
		End If
	End If
	Exit Sub
	
GererErreur:
	Call SIGE_TraiterErreur(gc_TypeElement_SILT, gc_Element_SILT, Getthreadinfo(1), "", False)
	Exit Sub
End Sub</lotusscript></code>
